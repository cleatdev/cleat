  echo -e "    ${GREEN}shell${RESET}   ${DIM}[box]${RESET}      Open bash in the container"
  echo -e "    ${GREEN}login${RESET}   ${DIM}[box]${RESET}      Authenticate with Anthropic team account"
  echo -e "    ${GREEN}logs${RESET}    ${DIM}[box]${RESET}      Tail container logs"
  echo ""
  echo -e "  ${BOLD}INFO${RESET}"
  echo -e "    ${GREEN}status${RESET}             Show this project's boxes, auth & caps"
  echo -e "    ${GREEN}ps${RESET}                 List all Cleat containers (running & stopped)"
  echo -e "    ${GREEN}storage${RESET}            Show Docker disk usage ${DIM}(cleat vs shared vs other projects)${RESET}"
  echo -e "    ${GREEN}describe${RESET} ${DIM}[box] [text]${RESET}  Show or set a box's description"
  echo -e "    ${GREEN}session${RESET} ${DIM}[box]${RESET}        List, rename, delete or restore this box's Claude sessions"
  echo -e "    ${GREEN}account${RESET} ${DIM}[name] [box]${RESET} Switch this box between named Claude logins"
  echo -e "    ${GREEN}browser${RESET} ${DIM}origins${RESET}      Origins a box may ask your host to open"
  echo ""
  echo -e "  ${BOLD}SETUP${RESET}"
  echo -e "    ${GREEN}update${RESET}             Check for updates and install the latest version"
  echo -e "    ${GREEN}version${RESET}            Show current version"
  echo -e "    ${GREEN}install${RESET}            Symlink ${BOLD}cleat${RESET} to /usr/local/bin"
  echo -e "    ${GREEN}uninstall${RESET}          Remove symlinks"
  echo ""
  echo -e "  ${BOLD}FLAGS${RESET} ${DIM}(apply to start, run, resume, claude)${RESET}"
  echo -e "    ${GREEN}--cap${RESET} ${DIM}<name>${RESET}       Enable a capability for this session only"
  echo -e "    ${GREEN}--env${RESET} ${DIM}KEY=VALUE${RESET}    Pass environment variable to container"
  echo -e "    ${GREEN}--env${RESET} ${DIM}KEY${RESET}          Inherit from host environment"
  echo -e "    ${GREEN}--env-file${RESET} ${DIM}PATH${RESET}    Load env vars from file"
  echo -e "    ${GREEN}--desc${RESET} ${DIM}<text>${RESET}      Set a box description at start"
  echo ""
  echo -e "  ${BOLD}EXAMPLES${RESET}"
  echo -e "    ${DIM}cd ~/code/my-app && cleat start${RESET}           ${DIM}# first time (main box)${RESET}"
  echo -e "    ${DIM}cleat start az --desc \"cloud box\"${RESET}         ${DIM}# a separate az sandbox${RESET}"
  echo -e "    ${DIM}cleat config az --enable docker${RESET}           ${DIM}# per-box capabilities${RESET}"
  echo -e "    ${DIM}cleat resume dev${RESET}                          ${DIM}# resume the dev box${RESET}"
  echo -e "    ${DIM}cleat status${RESET}                              ${DIM}# list this project's boxes${RESET}"
  echo -e "    ${DIM}cleat --cap ssh --env GH_TOKEN start${RESET}      ${DIM}# one-off session${RESET}"
  echo ""
}

# ── Global flag parsing ────────────────────────────────────────────────────
# Extract --cap, --env, --env-file flags before dispatching to subcommands.
# Remaining args are returned in _REMAINING_ARGS.
parse_global_flags() {
  _CLI_CAPS=()
  _CLI_ENVS=()
  _CLI_ENV_FILES=()
  _CLI_TRUST_PROJECT=0
  _CLI_TRUST_SETUP=0
  _CLI_DESC_SET=0
  _REMAINING_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --trust-project)
        _CLI_TRUST_PROJECT=1
        shift
        ;;
      --trust-setup)
        _CLI_TRUST_SETUP=1
        shift
        ;;
      --fork)
        _FORK_REQUESTED=true
        shift
        continue
        ;;
      --cap)
        if [[ -z "${2:-}" ]]; then
          error "Missing capability name after --cap"
          exit 1
        fi
        # Validate against known capabilities
        local _cap_valid=false
        for _known in "${KNOWN_CAPS[@]}"; do
          [[ "$_known" == "$2" ]] && _cap_valid=true
        done
        if ! $_cap_valid; then
          error "Unknown capability: ${BOLD}$2${RESET}"
          echo -e "    ${DIM}Available: ${KNOWN_CAPS[*]}${RESET}"
          exit 1
        fi
        _CLI_CAPS+=("$2")
        shift 2
        ;;
      --env)
        if [[ -z "${2:-}" ]]; then
          error "Missing value after --env"
          exit 1
        fi
        # A bare `--env KEY` is INHERIT, and resolve_env_args reads it with
        # ${!KEY}. An indirect expansion on anything that is not a shell
        # identifier is a hard bash error ("MY-VAR: invalid variable name"),
        # which under strict mode killed the run with a raw trace and no
        # remedy, AFTER the image had already been pulled or built. Validated
        # here so it fails on the first line instead. KEY=VALUE is data and is
        # deliberately not restricted: only the name we are about to expand is.
        if [[ "$2" != *=* ]] && ! [[ "$2" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
          error "Invalid environment variable name: ${BOLD}$2${RESET}"
          echo -e "    ${DIM}A bare ${BOLD}--env NAME${RESET}${DIM} inherits from your shell, so NAME must be a valid variable name (letters, digits, underscore; not starting with a digit).${RESET}"
          echo -e "    ${DIM}To pass a literal value instead, use ${BOLD}--env NAME=VALUE${RESET}${DIM}.${RESET}"
          exit 1
        fi
        _CLI_ENVS+=("$2")
        shift 2
        ;;
      --env-file)
        if [[ -z "${2:-}" ]]; then
          error "Missing path after --env-file"
          exit 1
        fi
        _CLI_ENV_FILES+=("$2")
        shift 2
        ;;
      --desc)
        if [[ -z "${2:-}" ]]; then
          error "Missing text after --desc"
          exit 1
        fi
        _CLI_DESC="$2"
        _CLI_DESC_SET=1
        shift 2
        ;;
      *)
        _REMAINING_ARGS+=("$1")
        shift
        ;;
    esac
  done
}

# ── Main ────────────────────────────────────────────────────────────────────
main() {
  # Capture the original argv verbatim BEFORE flag parsing consumes it, so the
  # CLI self-update preflight can re-exec the new version with the same command.
  _CLEAT_ORIG_ARGV=("$@")

  # Defense-in-depth: always kill spinner and restore cursor on exit.
  # exec_claude sets its own trap (which calls _cleanup_spin internally).
  trap '_cleanup_spin' EXIT

  # Before anything reads a throttle or notice-memory file, move any left over
  # in the old in-tree location. Costs five stats on an already-migrated
  # install and never fails a launch.
  _migrate_state_files

  parse_global_flags "$@"
  set -- "${_REMAINING_ARGS[@]+"${_REMAINING_ARGS[@]}"}"

  local cmd="${1:-start}"
  shift 2>/dev/null || true

  # Interactive CLI self-update preflight: only for the session-launching
  # commands, and before any docker work: accepting re-execs the new version,
  # which then drives the entire run. The Docker pressure check (an amber, often
  # crucial resource warning) runs BEFORE the release highlight so it sits at the
  # top of the startup, above the editorial "New in …" note: act on the warning
  # first, read the news second. The positive "Docker tuned" confirmation runs
  # LAST, directly above the bring-up, so a well-sized VM gets a one-line nod that
  # sticks to "Image ready" (it's silent, and the warning shows instead, when the
  # VM is undersized). Finally, if any of those advisories flagged a genuine Docker
  # CONFIG error (undersized VM memory or default swap), _maybe_gate_on_docker_config
  # HOLDS the interactive launch on a keypress: the single deliberate block in the
  # startup path, so a misconfigured Docker can't "just blink" past unread.
  # `cleat fork start|run` IS a session launch: its own help calls it the same
  # command as `cleat start <box> --fork`, and it creates a box (and for start,
  # attaches Claude). It was reaching none of the preflights below, so with the
  # daemon stopped it skipped the autostart every other launch verb gets and
  # died on a raw Docker error instead. Branching on the SUBCOMMAND, not the
  # verb, is what keeps the promise in the second half of that comment: the
  # read-only fork subcommands (bare list, path, prune, refresh) must still
  # never boot a VM. The preflight args drop the subcommand so the idle sweep
  # sees the box name and not the literal word "start", which would make it
  # sweep the very box being launched.
  #
  # `sessions` is deliberately absent: it reads the host filesystem and must
  # keep working with Docker down, which is exactly when a user is most likely
  # to be reclaiming disk. Its destructive subcommands do their own _daemon_up
  # check and REFUSE rather than boot a VM, because a probe that cannot answer
  # must never be treated as "nothing is running".
  local _do_preflight=0
  local _preflight_args=("$@")
  case "$cmd" in
    start|resume|r|run|claude|shell|sh) _do_preflight=1 ;;
    fork)
      case "${1:-}" in
        start|run) _do_preflight=1; _preflight_args=("${@:2}") ;;
      esac ;;
  esac
  if [[ "$_do_preflight" -eq 1 ]]; then
    _maybe_prompt_cli_update
    # Surface a split-brain install (e.g. a brew keg next to a curl install)
    # before the daemon steps, which no-op or exit on a down Docker: a broken
    # Docker machine is exactly where the wrong-cleat confusion shows up.
    _maybe_warn_multiple_installs
    # Docker autopilot (concept/29): a down daemon is started for the user
    # (TTY-gated, bounded, remote-refusing) BEFORE the sweep/pressure/
    # announce preflights, which all no-op against a down daemon. Session
    # verbs only: stop/status/nuke must never boot a VM.
    _ensure_daemon
    _maybe_sweep_idle_boxes "${_preflight_args[@]+"${_preflight_args[@]}"}"
    _maybe_check_docker_pressure
    _maybe_show_release_highlight
    _maybe_announce_docker_ready
    # Last: if any advisory above flagged a genuine Docker CONFIG error, hold the
    # interactive launch on a keypress so it can't scroll by unread (concept/21).
    _maybe_gate_on_docker_config
  fi

  case "$cmd" in
    start)     _set_box "$@"; cmd_start ;;
    resume|r)  _set_box "$@"; cmd_resume ;;
    build)     cmd_build "$@" ;;
    rebuild)   cmd_rebuild "$@" ;;
    upgrade-claude) cmd_upgrade_claude "$@" ;;
    run)       _set_box "$@"; cmd_run ;;
    stop)      _set_box "$@"; cmd_stop ;;
    rm)        _set_box "$@"; cmd_rm ;;
    stop-all)  cmd_stop_all "$@" ;;
    shell|sh)  _set_box "$@"; cmd_shell ;;
    login)     _set_box "$@"; cmd_login ;;
    claude)    _set_box "$@"; cmd_claude ;;
    logs)      _set_box "$@"; cmd_logs ;;
    ps)        cmd_ps "$@" ;;
    storage)   cmd_storage "$@" ;;
    session|sessions|ses) cmd_sessions "$@" ;;
    account|accounts) cmd_account "$@" ;;
    browser) cmd_browser "$@" ;;
    status|st) cmd_status "$@" ;;
    config)    cmd_config "$@" ;;
    describe)  cmd_describe "$@" ;;
    kit)       cmd_kit "$@" ;;
    fork)      cmd_fork "$@" ;;
    setup)     cmd_setup "$@" ;;
    trust)     cmd_trust "$@" ;;
    untrust)   cmd_untrust "$@" ;;
    clean)     cmd_clean "$@" ;;
    prune)     cmd_prune "$@" ;;
    nuke)      cmd_nuke "$@" ;;
    update)    cmd_update "$@" ;;
    version|-v|--version) cmd_version ;;
    install)   cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      error "Unknown command: ${cmd}"
      cmd_help
      exit 1
      ;;
  esac
}

# Only run main when executed directly (not when sourced for testing)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
