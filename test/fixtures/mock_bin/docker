#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Docker stub (hardened).
#
# Default mode (backwards compat): records every call to $DOCKER_CALLS,
# returns canned responses for `ps`/`ps -a`/`images`/`inspect`, exits 0.
#
# Opt-in strict modes (enable via env vars):
#
#   DOCKER_STUB_STRICT=1
#     Validates `docker run -v SRC:DEST[:FLAGS]` arguments (and `docker create`):
#     - SRC must exist on the host filesystem
#     - DEST must be absolute
#     - Flags limited to ro/rw/z/Z/delegated/cached/consistent
#     - A named volume starting `cleat-gw-` must be live in this test (created
#       by `docker volume create`, not removed since). A real daemon
#       auto-creates a missing named volume empty, so an ordering bug would
#       otherwise pass unseen. Every other named volume is skipped.
#     Failure mode mimics real docker: exit 125, stderr "Error response from
#     daemon: invalid mount".
#
#   DOCKER_STUB_SIMULATE_VIRTIOFS=1
#     Simulates macOS Docker Desktop virtiofs restriction: when a bind
#     mount DEST path is *inside another bind mount's DEST*, the target
#     file must exist on the host (virtiofs can't create files at nested
#     bind-mount targets). This catches v0.6.5-class regressions.
#
# Responses (read from $DOCKER_MOCK_DIR):
#   ps_output     : for `docker ps --filter ...`
#   ps_a_output   : for `docker ps -a --filter ...`
#   images_output : for `docker images ...`
#   inspect_output: for `docker inspect ...`, one blob for every container and
#                   every --format, unless the inspect/ directory exists
#   inspect/<container-name>: per-container, per-format answers, one
#                   `<format><TAB><value>` record per line. The directory's
#                   presence opts the test in. See _stub_inspect.
#   volume_ls_output     : for `docker volume ls ...`
#   volume_inspect_output: for `docker volume inspect ...`, unless the
#                   volume_inspect/ directory exists, which answers per volume
#                   and per format exactly as inspect/ does per container
#   volumes       : state, not a response. The live named volumes of this test.
#
# Every call is appended to $DOCKER_CALLS (one call per line; multi-arg
# commands like `docker exec container bash -c 'foo'` are written on a
# single line via $* expansion).
#
# Exit code is controlled by $DOCKER_EXIT_CODE (default 0).
# Stderr is emitted if $DOCKER_STDERR is set.
#
# Per-subcommand exit overrides (for testing specific failure paths):
#   $DOCKER_TAG_EXIT_CODE    : `docker tag`    (default 0)
#   $DOCKER_PULL_EXIT_CODE   : `docker pull`   (default 1, no registry in tests)
#   $DOCKER_RUN_EXIT_CODE    : `docker run`    (default: falls through to 0)
#   $DOCKER_COMMIT_EXIT_CODE : `docker commit` (default 0)
#   $DOCKER_VOLUME_EXIT_CODE : `docker volume` (default: falls through)
#   $DOCKER_CP_EXIT_CODE     : `docker cp`     (default: falls through)
#   $DOCKER_CREATE_EXIT_CODE : `docker create` (default: falls through)
# ─────────────────────────────────────────────────────────────────────────────

# Record the call (always, for observability)
echo "docker $*" >> "${DOCKER_CALLS:-/dev/null}"

_mock() {
  local f="${DOCKER_MOCK_DIR:-}/$1"
  [[ -f "$f" ]] && cat "$f"
}

# ─── Strict validation helpers ─────────────────────────────────────────────
_stub_die() {
  local msg="$1"
  echo "Error response from daemon: $msg" >&2
  exit 125
}

# Parse a `-v SRC:DEST[:FLAGS]` spec and validate it.
# Returns 0 if valid, calls _stub_die if invalid.
_validate_mount_spec() {
  local spec="$1"
  # Named volumes (no leading /) are skipped, except a gateway socket volume,
  # which must be live in this test: created, and not removed since.
  if [[ "$spec" != /* ]]; then
    case "$spec" in
      cleat-gw-*)
        grep -Fxq -e "${spec%%:*}" "${DOCKER_MOCK_DIR:-}/volumes" 2>/dev/null \
          || _stub_die "named volume is not live in this test: ${spec%%:*}" ;;
    esac
    return 0
  fi

  # Split into SRC, DEST, FLAGS using parameter expansion.
  local src="${spec%%:*}"
  local rest="${spec#*:}"
  local dest flags
  if [[ "$rest" == *:* ]]; then
    dest="${rest%%:*}"
    flags="${rest#*:}"
  else
    dest="$rest"
    flags=""
  fi

  # SRC must exist on the host filesystem
  if [[ ! -e "$src" ]]; then
    _stub_die "invalid mount config for type \"bind\": bind source path does not exist: $src"
  fi

  # DEST must be absolute
  if [[ "$dest" != /* ]]; then
    _stub_die "invalid mount config: destination path must be absolute: $dest"
  fi

  # Flags must be a subset of the known set
  if [[ -n "$flags" ]]; then
    local IFS=','
    local f
    for f in $flags; do
      case "$f" in
        ro|rw|z|Z|delegated|cached|consistent) ;;
        *) _stub_die "invalid mount config: unknown flag '$f'" ;;
      esac
    done
  fi
}

# Virtiofs simulation: a bind mount DEST that's *inside* another bind mount
# must have its target path already exist on the host (relative to that
# parent bind mount's source). This reproduces the v0.6.5 failure mode:
# mounting an overlay file to /workspace/.claude/settings.json fails when
# the host path $project/.claude/settings.json doesn't exist.
#
# Takes an array of all bind specs and validates each one.
_validate_virtiofs_nested() {
  local -a mounts=("$@")
  local i j
  local n=${#mounts[@]}

  for ((i = 0; i < n; i++)); do
    local spec="${mounts[$i]}"
    [[ "$spec" == /* ]] || continue
    local src="${spec%%:*}"
    local rest="${spec#*:}"
    local dest="${rest%%:*}"

    # Only validate file (not directory) mounts whose dest is inside another
    # bind's dest. Directories are created freely on macOS; files are not.
    [[ -f "$src" ]] || continue

    for ((j = 0; j < n; j++)); do
      [[ "$i" != "$j" ]] || continue
      local parent="${mounts[$j]}"
      [[ "$parent" == /* ]] || continue
      local p_src="${parent%%:*}"
      local p_rest="${parent#*:}"
      local p_dest="${p_rest%%:*}"
      [[ -d "$p_src" ]] || continue

      # Is dest inside p_dest?
      if [[ "$dest" == "$p_dest"/* ]]; then
        # Compute the host path under the parent bind
        local suffix="${dest#"$p_dest"/}"
        local host_path="$p_src/$suffix"
        if [[ ! -e "$host_path" ]]; then
          _stub_die "error mounting \"$src\" to rootfs at \"$dest\": create mountpoint for $dest mount: mountpoint \"$host_path\" is outside of rootfs"
        fi
      fi
    done
  done
}

# Parse `docker run ...` args and apply validators.
_validate_docker_run() {
  local -a mounts=()
  shift  # drop 'run'
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v|--volume)
        shift
        [[ $# -gt 0 ]] || _stub_die "flag needs an argument: -v"
        if [[ "${DOCKER_STUB_STRICT:-}" == "1" ]]; then
          _validate_mount_spec "$1"
        fi
        mounts+=("$1")
        shift
        ;;
      -v=*|--volume=*)
        if [[ "${DOCKER_STUB_STRICT:-}" == "1" ]]; then
          _validate_mount_spec "${1#*=}"
        fi
        mounts+=("${1#*=}")
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  if [[ "${DOCKER_STUB_SIMULATE_VIRTIOFS:-}" == "1" && ${#mounts[@]} -gt 0 ]]; then
    _validate_virtiofs_nested "${mounts[@]}"
  fi
}

# `docker image inspect <ref>...` succeeds only if every ref appears in
# $DOCKER_MOCK_DIR/cached_images (one ref per line). Tests register cached
# refs via mock_docker_image_cached. Default state: file absent → all refs
# missing, exit 1 (mirrors real docker when image isn't on disk).
_handle_image_inspect() {
  local cached="${DOCKER_MOCK_DIR:-}/cached_images"
  local ref
  for ref in "$@"; do
    [[ "$ref" == --* ]] && continue
    if [[ ! -f "$cached" ]] || ! grep -Fxq "$ref" "$cached"; then
      echo "Error: No such image: $ref" >&2
      exit 1
    fi
  done
}

# Per-container, per-format inspect. Opt-in: the presence of the `inspect`
# DIRECTORY switches this arm over. Absent, the answer is byte-identical to
# the shipped stub and every shipped reader of the blob is untouched.
# Records that share a container and a format are a sequence: the Nth call
# answers the Nth record and the last one repeats. The cursor for each pair
# lives in inspect/.seq/<container>.<cksum of the format>.
# `docker volume inspect` reuses it over volume_inspect/, with the object
# noun in its errors: _STUB_INSPECT_DIR and _STUB_INSPECT_NOUN pick which.
_stub_inspect() {
  local fmt="" want_fmt=0 names="" rc=0 a tab ck seqf nl bsn bst
  local base="${_STUB_INSPECT_DIR:-${DOCKER_MOCK_DIR}/inspect}"
  local noun="${_STUB_INSPECT_NOUN:-container}"
  tab=$'\t'; nl=$'\n'; bsn='\n'; bst='\t'
  shift                       # drop the literal `inspect`
  for a in "$@"; do
    if [[ "$want_fmt" -eq 1 ]]; then fmt="$a"; want_fmt=0; continue; fi
    case "$a" in
      --format=*)   fmt="${a#--format=}" ;;
      --format|-f)  want_fmt=1 ;;
      -*)           _stub_die "unsupported docker inspect flag in fixture mode: $a" ;;
      '')           echo "Error: No such object: " >&2; rc=1 ;;
      *)            names="$names $a" ;;
    esac
  done
  if [[ -z "$names" && "$rc" -eq 0 ]]; then
    echo "\"docker inspect\" requires at least 1 argument." >&2
    exit 1
  fi
  [[ -n "$fmt" ]] || fmt="__raw__"
  ck="$(printf '%s' "$fmt" | cksum)"
  ck="${ck%% *}"
  for a in $names; do
    local f="$base/$a"
    if [[ ! -f "$f" ]]; then
      if [[ "$noun" == volume ]]; then
        echo "Error: No such volume: $a" >&2
      else
        echo "Error: No such object: $a" >&2
      fi
      rc=1
      continue
    fi
    local line found=0 key val ans="" i=0 n=0
    seqf="$base/.seq/$a.$ck"
    [[ -f "$seqf" ]] && read -r n < "$seqf"
    while IFS= read -r line || [[ -n "$line" ]]; do
      key="${line%%$tab*}"
      val="${line#*$tab}"
      [[ "$key" == "$fmt" ]] || continue
      ans="$val"; found=1
      [[ "$i" -ge "$n" ]] && break
      i=$((i + 1))
    done < "$f"
    if [[ "$found" -eq 0 ]]; then
      echo "Error: no fixture for $noun $a and format: $fmt" >&2
      rc=1
      continue
    fi
    mkdir -p "$base/.seq"
    echo $((n + 1)) > "$seqf"
    # `\n` and `\t` expand and nothing else, so a JSON value is written
    # verbatim and every bash answers alike (printf %b expands \u only from
    # bash 4.2, and turns \\ and \c into something no daemon prints).
    ans=${ans//"$bsn"/$nl}
    ans=${ans//"$bst"/$tab}
    printf '%s\n' "$ans"
  done
  exit "$rc"
}

# Named-volume state for the strict cleat-gw- check: one live name per line in
# $DOCKER_MOCK_DIR/volumes. A per-test file, because DOCKER_MOCK_DIR sits under
# the fresh mktemp -d every _common_setup makes.
_stub_volume_add() {
  local name=""
  shift 2                                # drop `volume create`
  # The name is the one argument that is not a flag or a flag's value, in any
  # position: Docker takes `volume create NAME --label k=v` as readily as the
  # name last, and a ledger that recorded a label value would refuse a live
  # volume.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name=*)                              name="${1#--name=}" ;;
      --name)                                shift; name="${1:-}" ;;
      -d|--driver|-l|--label|-o|--opt)       shift ;;
      -*)                                    ;;
      *)                                     name="$1" ;;
    esac
    [[ $# -gt 0 ]] && shift
  done
  [[ -n "$name" ]] && printf '%s\n' "$name" >> "${DOCKER_MOCK_DIR}/volumes"
}
_stub_volume_del() {
  local a f="${DOCKER_MOCK_DIR}/volumes"
  shift 2                                # drop `volume rm`
  [[ -f "$f" ]] || return 0
  for a in "$@"; do
    case "$a" in -*) continue ;; esac
    grep -Fxv -e "$a" "$f" > "$f.tmp" || true
    mv "$f.tmp" "$f"
  done
}

# ─── Subcommand dispatch ───────────────────────────────────────────────────
case "$1" in
  ps)
    # Token-bounded match for `-a` / `--all`. A naive `*"-a"*` substring
    # match falsely fires when the container name contains '-a' (e.g.
    # `cleat-project-a1b2c3d4`: ~1/16 of random hashes start with 'a'),
    # routing plain `docker ps` calls to ps_a_output and breaking the
    # is_running / container_exists distinction.
    case " $* " in
      *" -a "*|*" --all "*) _mock "ps_a_output" ;;
      *) _mock "ps_output" ;;
    esac
    ;;
  images)
    _mock "images_output"
    ;;
  inspect)
    # _stub_inspect always exits, so the blob is read only outside fixture mode.
    [[ -d "${DOCKER_MOCK_DIR:-}/inspect" ]] && _stub_inspect "$@"
    _mock "inspect_output"
    ;;
  top)
    # The container process table. Absent by default, which keeps the historic
    # behaviour (empty output, which _box_has_live_agent reads as "live").
    _mock "top_output"
    ;;
  exec)
    # DOCKER_STUB_EXEC_SCRIPT: run the named script with the FULL docker argv
    # (starting at `exec`) and this stub's stdin, print its stdout, and return
    # its exit code. This lets a test drive exec_claude's relaunch loop and the
    # login exec end to end without a real daemon. Absent, `docker exec` stays a
    # no-op that exits 0 (the historic behaviour), so nothing else changes.
    if [[ -n "${DOCKER_STUB_EXEC_SCRIPT:-}" ]]; then
      "$DOCKER_STUB_EXEC_SCRIPT" "$@"
      exit $?
    fi
    ;;
  run)
    # Validate bind mounts in strict / virtiofs modes. This must happen
    # BEFORE we emit DOCKER_STDERR / exit so the strict errors take priority.
    _validate_docker_run "$@"
    # Tests that need a `docker run` to fail (e.g. installer failure in
    # upgrade-claude) set DOCKER_RUN_EXIT_CODE.
    [[ -n "${DOCKER_RUN_EXIT_CODE:-}" ]] && exit "$DOCKER_RUN_EXIT_CODE"
    ;;
  create)
    # Validated exactly like `run`, so a create cannot slip a bad bind mount
    # past DOCKER_STUB_STRICT or DOCKER_STUB_SIMULATE_VIRTIOFS.
    _validate_docker_run "$@"
    [[ -n "${DOCKER_CREATE_EXIT_CODE:-}" ]] && exit "$DOCKER_CREATE_EXIT_CODE"
    ;;
  volume)
    # The volume ledger moves only on a call that succeeds, which is what a
    # failed create or rm leaves on a real daemon. No `exit` without an
    # override: the fallthrough still honours DOCKER_STDERR and DOCKER_EXIT_CODE.
    _vrc="${DOCKER_VOLUME_EXIT_CODE:-${DOCKER_EXIT_CODE:-0}}"
    case "${2:-}" in
      ls)      _mock "volume_ls_output" ;;
      inspect)
        # Per-volume answers when volume_inspect/ exists, as for containers.
        if [[ -d "${DOCKER_MOCK_DIR:-}/volume_inspect" ]]; then
          shift
          _STUB_INSPECT_DIR="$DOCKER_MOCK_DIR/volume_inspect" \
            _STUB_INSPECT_NOUN=volume _stub_inspect "$@"
        fi
        _mock "volume_inspect_output" ;;
      create)  [[ "$_vrc" -eq 0 ]] && _stub_volume_add "$@" ;;
      rm)      [[ "$_vrc" -eq 0 ]] && _stub_volume_del "$@" ;;
    esac
    [[ -n "${DOCKER_VOLUME_EXIT_CODE:-}" ]] && exit "$DOCKER_VOLUME_EXIT_CODE"
    ;;
  cp)
    # Three live call sites in bin/cleat. A test that sets only the global
    # DOCKER_EXIT_CODE still sees `docker cp` fail through the fallthrough.
    [[ -n "${DOCKER_CP_EXIT_CODE:-}" ]] && exit "$DOCKER_CP_EXIT_CODE"
    ;;
  image)
    # `docker image inspect <ref>` is the only image subcommand currently
    # used. Anything else (e.g. `docker image rm`) falls through to exit 0.
    [[ "${2:-}" == "inspect" ]] && _handle_image_inspect "${@:3}"
    ;;
  build|start|stop|rm|logs|rmi|builder)
    ;;
  commit)
    # Tests that need a commit to fail (e.g. upgrade-claude commit failure)
    # set DOCKER_COMMIT_EXIT_CODE.
    exit "${DOCKER_COMMIT_EXIT_CODE:-0}"
    ;;
  tag)
    # Tag normally succeeds. Tests that need to simulate a tag failure
    # (e.g. _do_pull's cache-hit hardening) can set DOCKER_TAG_EXIT_CODE=1.
    exit "${DOCKER_TAG_EXIT_CODE:-0}"
    ;;
  pull)
    # Pull fails by default (no registry in tests). Tests that need pull to
    # succeed can set DOCKER_PULL_EXIT_CODE=0.
    exit "${DOCKER_PULL_EXIT_CODE:-1}"
    ;;
esac

# Legacy: arbitrary stderr/exit injection for tests that need it
[[ -n "${DOCKER_STDERR:-}" ]] && echo "$DOCKER_STDERR" >&2

exit "${DOCKER_EXIT_CODE:-0}"
