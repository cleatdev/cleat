#!/usr/bin/env bash
set -euo pipefail

# ── Config ──────────────────────────────────────────────────────────────────
VERSION="1.3.1"
# Gates the on-start release highlight (_maybe_show_release_highlight): must
# equal VERSION to fire. Bump it to the new VERSION at each tag so the
# maintainer-curated highlight re-surfaces for that release; a mismatch shows
# nothing (fail-safe). The highlight COPY and its version label are editorial,
# set by hand below, not derived from VERSION (a big feature stays highlighted
# across several releases, labelled with the version it shipped in).
RELEASE_HIGHLIGHT_VERSION="1.3.1"
# How many launches after an upgrade the highlight is shown before going quiet.
# Bounded repetition aids feature discovery (people miss it the first time)
# without training the eye to skip the startup block, where drift/update/security
# notices also live. See concept/21-on-start-notices.md.
RELEASE_HIGHLIGHT_MAX_SHOWS=3
IMAGE_NAME="cleat"
REGISTRY_BASE="ghcr.io/cleatdev/cleat"
REGISTRY_IMAGE="${REGISTRY_BASE}:v${VERSION}"
REPO_URL="https://github.com/cleatdev/cleat"

# Image content identity, DELIBERATELY decoupled from VERSION.
#
# The on-start rebuild prompt used to fire whenever the image's baked CLI
# version was older than this CLI, so a version-only release (no change under
# docker/) still nagged every user to re-pull and recreate their container,
# discarding its writable layer for nothing. ~Two-thirds of recent releases
# were version-only. This integer tracks the IMAGE CONTENT instead.
#
# Bump _IMAGE_SPEC_VERSION by one (1 -> 2 -> 3 ...) whenever anything that lands
# in the built image changes: docker/Dockerfile, docker/entrypoint.sh,
# docker/clip, docker/clip-daemon, docker/open-bridge, docker/CLAUDE.md, or a
# pinned base. A CLI-only release leaves it untouched and no one is nagged.
# It is stamped onto the image as the sh.cleat.image-spec label (by _do_build,
# cmd_rebuild, and the publish CI) and read back by _maybe_prompt_image_rebuild,
# which prompts only when the local image's spec is OLDER than this value.
#
# A unit test (test/unit/image_spec.bats) hashes the build inputs and FAILS if
# they change without this being bumped, so it can never be silently forgotten.
# See concept/24-image-spec-versioning.md.
#
# Spec history (what each value shipped):
#   1  initial scheme; floating node:24-bookworm-slim base
#   2  base image pinned by digest (reproducible base; see docker/Dockerfile)
#   3  ENV BROWSER=open shim, so Claude Code 2.1.191+ opens login URLs through
#      the bridge instead of dropping to the code-paste flow
#   4  entrypoint chowns the shell rc files and ~/.config after the UID remap,
#      so a [setup] payload can put a toolchain on PATH. Without it every host
#      whose UID is not 1000 (i.e. every macOS host) hit EACCES on ~/.bashrc,
#      ~/.profile and mkdir ~/.config/*, which aborts the payload under bash -e
_IMAGE_SPEC_VERSION=4
# Anchor for classifying PRE-STAMPING images (built before sh.cleat.image-spec
# existed, so they carry no spec label): their content is inferred from the
# version they were built at. v0.16.3 was the LAST docker/ content change before
# stamping, so a label-less image built at or after it carries that pre-pin,
# floating-base content == spec 1; an older label-less image predates even that
# and is treated as spec 0. Both are then compared against _IMAGE_SPEC_VERSION,
# so on the release that introduces this scheme (spec 2, pinned base) a label-less
# spec-1 image is correctly offered the one-time refresh to the pinned base. This
# anchor never moves: every image built from the stamping release on carries an
# explicit label, so the inference path only ever sees genuinely pre-stamping
# images.
_IMAGE_SPEC_INTRO_VERSION="0.16.3"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# XDG-compliant config directory
CLEAT_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cleat"
CLEAT_GLOBAL_CONFIG="$CLEAT_CONFIG_DIR/config"
CLEAT_GLOBAL_ENV="$CLEAT_CONFIG_DIR/env"

# Per-container runtime state: the settings overlay, clipboard bridge, and hook
# event spool. Persistent (deliberately NOT under /tmp) so macOS file rotation
# and reboots can't delete a container's bind-mount sources out from under it and
# force a recreate (which would discard the container's writable layer, e.g. an
# ad-hoc `az` install). One dir per container:
#   $CLEAT_RUN_DIR/<cname>/{settings,clip,hooks,kit}
# settings and hooks are host-side state. clip and the kit masks ARE mounted in
# (kit/* read-only).
CLEAT_RUN_DIR="$CLEAT_CONFIG_DIR/run"
CLEAT_TRUST_FILE="$CLEAT_CONFIG_DIR/trust"
# Host-side per-box descriptions, keyed by container name. NOT Docker labels:
# labels are immutable, so editing one would force a recreate that wipes the
# writable layer (e.g. an `az login`). See concept/20-boxes.md.
CLEAT_BOXES_DIR="$CLEAT_CONFIG_DIR/boxes"
# Forked workspaces: one directory per fork box, a full copy of the project.
# Under $CLEAT_CONFIG_DIR so it is inside Docker's shared scope on macOS and
# normally on the same volume as the project, which is what lets APFS clone
# blocks copy-on-write instead of duplicating them.
CLEAT_FORKS_DIR="$CLEAT_CONFIG_DIR/forks"

# Host-side per-box kit selection, keyed by container name: one file per box
# holding the enabled kit's name. Same rationale as CLEAT_BOXES_DIR (not a
# Docker label: labels are immutable, editing one would force a recreate). A
# separate dir, not a suffixed file inside CLEAT_BOXES_DIR, so the description
# display globs never iterate a non-description file. See concept/34-kits.md.
CLEAT_KITS_DIR="$CLEAT_CONFIG_DIR/kits"

# Curated kit library (maintainer-authored, embedded as heredocs in _kit_emit;
# no cache, no network: the CLI release is the single source of truth). Order
# matters for display.
KNOWN_KITS=(plan-big-execute-small)
# Default model alias for kit agents (floats to the current Sonnet with the
# bundled Claude), and the cycle order the interactive picker offers.
_KIT_DEFAULT_MODEL="sonnet"
_KIT_MODEL_CHOICES=(sonnet haiku opus inherit)
# Fixed height of the kit picker's detail pane (kit description under the
# list). Fixed so the TUI redraw math stays constant per frame. Must hold
# the longest _kit_description folded at 60 columns.
_KIT_PANE_LINES=7

# Persistent per-project Claude global-state (.claude.json) store. Unlike
# $CLEAT_RUN_DIR (per-container, wiped on `cleat rm`/recreate), this is keyed by
# PROJECT and deliberately survives recreate so a project's trust/MCP approvals
# persist. One file per project: $CLEAT_PROJECTS_DIR/<project_session_key>/claude.json
CLEAT_PROJECTS_DIR="$CLEAT_CONFIG_DIR/projects"

# Known capabilities (order matters for display).
# Two behavioral categories. See _cap_category for the mapping:
#   mount   git, ssh, env, hooks, gh   auth/identity bind-mounts (no install)
#   sandbox docker                     mounts host docker socket (breaks isolation)
KNOWN_CAPS=(git ssh env hooks gh docker)

# Session-scoped state (populated by parse_global_flags / cmd_run / cmd_resume)
_CLI_CAPS=()
_RESOLVED_PROJECT=""
# The active box: a named per-project sandbox (see concept/20-boxes.md).
# Default "main" = the legacy suffix-less container. Set by the dispatch via
# _set_box for box-aware verbs; stays "main" for everything else.
_BOX="main"
_FORK_REQUESTED=false   # set by --fork; only read when a box is CREATED
_CLI_ENVS=()
_CLI_ENV_FILES=()
_CLI_TRUST_PROJECT=0
# Separate consent class from _CLI_TRUST_PROJECT: approving caps never
# approves [setup] provisioning and vice versa (concept/16).
_CLI_TRUST_SETUP=0
_CLI_DESC=""
_CLI_DESC_SET=0
# Original argv as `main` received it, used by the CLI self-update preflight to
# re-exec the freshly-installed version with the same command.
_CLEAT_ORIG_ARGV=()

# Caps display buckets (populated by _caps_bucket_active for _print_caps).
_CAPS_MOUNT=()
_CAPS_SANDBOX=()

# ── Colors & Formatting ────────────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
# Amber/orange for warnings, visually distinct from the neutral-yellow status
# markers. xterm-256 color 214 (~#ffaf00) approximates the site's warning orange
# rgb(245,158,11) and renders correctly everywhere 256-color is supported
# (Terminal.app, iTerm2, Linux terminals, VS Code), unlike 24-bit truecolor,
# which degrades to the default foreground on terminals that don't support it.
AMBER='\033[38;5;214m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
UNDERLINE='\033[4m'
RESET='\033[0m'

header() {
  echo ""
  echo -e "${BOLD}${CYAN}  ┌───────────────────────────────────────────┐${RESET}"
  echo -e "${BOLD}${CYAN}  │   Cleat                                   │${RESET}"
  echo -e "${BOLD}${CYAN}  │   Give the agent a cage, not your keys.   │${RESET}"
  echo -e "${BOLD}${CYAN}  │   Unattended, not unguarded.              │${RESET}"
  echo -e "${BOLD}${CYAN}  └───────────────────────────────────────────┘${RESET}"
  echo ""
}

info()    { echo -e "  ${BLUE}▸${RESET} $1"; }
success() { echo -e "  ${GREEN}✔ $1${RESET}"; }
warn()    { echo -e "  ${AMBER}!${RESET} $1"; }
# A sandbox-break warning: the whole line renders in the sandbox amber (marker
# AND message), so it reads as loud as the `docker` cap it warns about. Unlike
# generic warn(), which tints only the `!` marker and leaves the text default.
warn_sandbox() { echo -e "  ${AMBER}! $1${RESET}"; }
error()   { echo -e "  ${RED}✖${RESET} $1"; }

# Aligned interactive Y/n prompt that pairs with an info()/warn() headline.
# The headline owns the icon (▸/!); the question continues underneath it,
# indented to sit under the headline TEXT (4 spaces), not back at the margin.
# Reads one line into the named variable. TTY-gating is the caller's job.
#
# A `read` FAILURE (EOF: e.g. `cleat start </dev/null`, a wrapper that redirects
# stdin, a non-interactive pipe) yields "n", i.e. DECLINE, never an empty string.
# Callers treat empty as the [Y/n] default of yes, so without this a redirected
# stdin would silently auto-accept destructive actions (git checkout + re-exec,
# a rebuild) with no human input. Empty-as-yes only happens on a real Enter press.
# Usage: _ask_yn answer "Rebuild now? [Y/n] "
_ask_yn() {
  local _var="$1" _prompt="$2"
  echo -en "    ${_prompt}"
  local _reply=""
  read -r _reply || { printf -v "$_var" '%s' 'n'; return 0; }
  printf -v "$_var" '%s' "$_reply"
}

# Repo-controlled text (cap names, .cleat lines, section names) is rendered
# via echo -e (colors above are literal escape strings), so echo -e is
# load-bearing: raw control bytes AND backslash escapes in that text are
# both terminal-injection vectors once they reach it. Strip every control
# byte except tab (0x09) and newline (0x0a) and double backslashes so
# echo -e can't interpret anything attacker-supplied. The stripped set is
# C0 0x00-0x08 and 0x0b-0x1f (this INCLUDES carriage return 0x0d: a lone CR
# rewinds the cursor to column 0, so a preview line could overwrite itself
# and hide what actually runs), DEL 0x7f, and C1 0x80-0x9f. Sanitize at
# every render site for repo-controlled text.
_sanitize_repo_str() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013-\037\177\200-\237' | sed 's/\\/\\\\/g'
}

# ── Spinner ────────────────────────────────────────────────────────────────
_SPIN_PID=""

_is_tty() { [[ -t 1 ]]; }

# Stricter than _is_tty (which checks stdout alone): BOTH stdin and stdout must be
# a real terminal. Used only by the one place Cleat deliberately BLOCKS for a
# keypress (_maybe_gate_on_docker_config): a launch with no human to answer
# (cron, a pipe, `cleat start </dev/null`, CI) must never be held, so the gate
# needs stdin to be interactive too, not just stdout.
#
# The `-t 0` term is load-bearing and INTENTIONALLY distinct from _is_tty. Do NOT
# "simplify" this to `[[ -t 1 ]]`: dropping the stdin check would let a launch with
# a redirected stdin (stdout still a tty) hit the blocking `read`, the exact
# walk-away-pillar violation the gate exists to avoid. A ttyless test harness can't
# tell `[[ -t 0 && -t 1 ]]` from `[[ -t 1 ]]` (both false when stdout isn't a tty),
# so no unit test can catch that specific regression: this comment is the guard.
# A test + mutation DO catch the coarser "always interactive" regression.
_is_interactive() { [[ -t 0 && -t 1 ]]; }

_has_unicode() {
  local lang="${LANG:-}${LC_ALL:-}${LC_CTYPE:-}"
  [[ "$lang" == *UTF-8* ]] || [[ "$lang" == *utf8* ]]
}

# True when the terminal is known to render OSC 8 hyperlinks (and we're on a
# TTY). Deliberately a conservative allow-list: a miss just falls back to a bare
# clickable URL (see _hyperlink), so we never risk escape garbage on an unknown
# or old terminal, a multiplexer, or piped output. Covers the terminals the
# maintainer's audience actually uses; Apple Terminal is intentionally absent
# (it has no OSC 8 but autodetects bare URLs itself).
_supports_osc8() {
  _is_tty || return 1
  case "${TERM_PROGRAM:-}" in
    iTerm.app|vscode|WezTerm|ghostty|Hyper|Tabby|rio) return 0 ;;
  esac
  [[ -n "${KITTY_WINDOW_ID:-}" || -n "${WEZTERM_PANE:-}" || -n "${GHOSTTY_BIN_DIR:-}" ]] && return 0
  # GNOME VTE 0.50+ (VTE_VERSION ≥ 5000) added OSC 8 support.
  [[ "${VTE_VERSION:-}" =~ ^[0-9]+$ ]] && (( ${VTE_VERSION:-0} >= 5000 )) && return 0
  return 1
}

# Render a terminal hyperlink. In OSC-8-capable terminals (iTerm2, VS Code,
# WezTerm, Ghostty, kitty, GNOME/VTE…) the short TEXT becomes a clickable link to
# URL; elsewhere it degrades to the bare URL, which terminals like Apple Terminal
# autodetect and make clickable on their own (so it's always at least copyable).
# OSC 8 format:  ESC ] 8 ; ; URL  ST   TEXT   ESC ] 8 ; ; ST     (ST = ESC \).
# Prints with no trailing newline; callers add color/underline around it.
_hyperlink() {
  local url="$1" text="${2:-$1}"
  if _supports_osc8; then
    printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$text"
  else
    printf '%s' "$url"
  fi
}

spin() {
  local msg="$1"
  if ! _is_tty; then
    info "$msg"
    return
  fi
  # A second spin() before spin_stop would orphan the first frame loop and
  # interleave two \r-animations into garbage. Stop the old one first.
  [[ -n "${_SPIN_PID:-}" ]] && _cleanup_spin
  local frames
  if _has_unicode; then
    frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  else
    frames=('-' '\' '|' '/')
  fi
  command -v tput &>/dev/null && tput civis 2>/dev/null
  local _spin_parent=$$
  (
    trap 'exit 0' TERM INT
    local i=0
    while kill -0 "$_spin_parent" 2>/dev/null; do
      printf "\r  ${BLUE}%s${RESET} %s" "${frames[$i]}" "$msg"
      i=$(( (i + 1) % ${#frames[@]} ))
      sleep 0.08
    done
    # Parent died without spin_stop (SIGKILL, hard crash): erase the frame and
    # restore the cursor instead of overwriting the shell prompt every 80 ms
    # with the cursor left hidden. The old spinner was un-disownable spam.
    printf "\r\033[K"
    { command -v tput &>/dev/null && tput cnorm 2>/dev/null; } || true
  ) &
  _SPIN_PID=$!
  # NOT disowned: spin_stop's `wait` must synchronize with the loop's exit so
  # no final frame can print after the ✔/✖ line (wait on a disowned pid is a
  # no-op race).
}

spin_stop() {
  local code="$1" ok_msg="$2" fail_msg="${3:-$2}"
  if [[ -n "$_SPIN_PID" ]]; then
    kill "$_SPIN_PID" 2>/dev/null || true
    wait "$_SPIN_PID" 2>/dev/null || true
    _SPIN_PID=""
    { command -v tput &>/dev/null && tput cnorm 2>/dev/null; } || true
  fi
  if ! _is_tty; then
    [[ "$code" -eq 0 ]] && success "$ok_msg" || error "$fail_msg"
    return
  fi
  if [[ "$code" -eq 0 ]]; then
    printf "\r\033[K  ${GREEN}✔ %s${RESET}\n" "$ok_msg"
  else
    printf "\r\033[K  ${RED}✖${RESET} %s\n" "$fail_msg"
  fi
}

_cleanup_spin() {
  if [[ -n "${_SPIN_PID:-}" ]]; then
    kill "$_SPIN_PID" 2>/dev/null || true
    wait "$_SPIN_PID" 2>/dev/null || true
    _SPIN_PID=""
  fi
  { command -v tput &>/dev/null && tput cnorm 2>/dev/null; } || true
}

# Restore the host terminal after an interactive `docker exec`. The docker CLI
# only undoes the termios state it set itself; private modes enabled by the
# in-box TUI: alternate screen, mouse tracking, bracketed paste, hidden
# cursor: survive a hard crash (a SIGSEGV'd claude, fork lockup at the pids
# cap) and leave the terminal spraying escape garbage on every keystroke and
# mouse move until a manual `reset`. Every sequence here is a no-op on a
# terminal already in a clean state, so this is safe after normal exits too.
_restore_terminal() {
  _is_tty || return 0
  {
    stty sane
    printf '\033[?1049l\033[?2004l\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?25h\033[0m'
  } </dev/tty >/dev/tty 2>/dev/null || true
}

# ── Keypress reader for TUI ────────────────────────────────────────────────
_read_keypress() {
  local key
  IFS= read -rsn1 key 2>/dev/null || true
  if [[ "$key" == $'\e' ]]; then
    # Read the rest of the escape sequence in one call.
    # Arrow keys send \e[A/B/C/D. Read up to 2 chars with a timeout.
    # Only a BARE Escape (nothing follows) is ESC. Every unrecognized
    # sequence (PgUp \e[5~, F-keys, Home/End) must be OTHER: mapping the
    # unknown to ESC made any stray arrow or function key close the
    # pickers, because the TUI loops treat ESC as cancel.
    local seq=""
    IFS= read -rsn2 -t 1 seq 2>/dev/null || true
    case "$seq" in
      "[A") echo "UP" ;;
      "[B") echo "DOWN" ;;
      "[C") echo "RIGHT" ;;
      "[D") echo "LEFT" ;;
      "")   echo "ESC" ;;
      *)    echo "OTHER" ;;
    esac
  elif [[ "$key" == " " ]]; then
    echo "SPACE"
  elif [[ "$key" == "" ]]; then
    echo "ENTER"
  elif [[ "$key" == "q" || "$key" == "Q" ]]; then
    echo "QUIT"
  else
    echo "OTHER"
  fi
}

# Portable MD5: works on both Linux (md5sum) and macOS (md5 -q)
_md5() {
  if command -v md5sum &>/dev/null; then
    md5sum
  elif command -v md5 &>/dev/null; then
    md5 -q
  else
    cksum | awk '{print $1}'
  fi
}

# ── Project-scoped container naming ─────────────────────────────────────────
container_name_for() {
  local project_path="$1"
  local box="${2:-}"
  local dir_name hash suffix=""
  # A named (non-default) box folds in as a trailing -<box>. The default box
  # ("main" or empty) gets the legacy suffix-less name: zero migration for
  # existing containers (see concept/20-boxes.md). The 8-char hash is ALWAYS
  # preserved; only the human-readable dir segment is re-truncated to fit.
  if [[ -n "$box" && "$box" != "main" ]]; then
    suffix="-${box}"
  fi
  dir_name="$(basename "$project_path" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
  # Keep the full name under Docker's 63-char limit:
  #   "cleat-" (6) + dir + "-" (1) + hash8 (8) + suffix = 15 + dir + |suffix|.
  # Budget the remaining room (48 minus the suffix length) for dir_name.
  local max_dir=$(( 48 - ${#suffix} ))
  (( max_dir < 1 )) && max_dir=1
  dir_name="${dir_name:0:$max_dir}"
  # Remove trailing dash from truncation
  dir_name="${dir_name%-}"
  hash="$(echo -n "$project_path" | _md5 | head -c 8)"
  echo "cleat-${dir_name}-${hash}${suffix}"
}

# Validate a box name. Boxes are named, per-project sandboxes (see
# concept/20-boxes.md): 1–31 chars, must start with a lowercase alnum, and may
# contain lowercase alnum, dash, or underscore. The pattern is held in a
# variable and used UNQUOTED: bash 3.2 treats a quoted =~ RHS as a literal
# string, which would silently break matching.
_validate_box_name() {
  local box="$1"
  local _box_re='^[a-z0-9][a-z0-9_-]{0,30}$'
  [[ "$box" =~ $_box_re ]]
}

# Derive the per-project session key used for Claude session/history isolation
# and the per-project .claude.json store (see concept/19-claude-json-isolation.md
# and concept/20-boxes.md). The DEFAULT box ("main" or empty) returns the legacy
# <basename>-<hash8> key BYTE-IDENTICALLY: folding a suffix in for the default
# would orphan every existing user's session history on upgrade. A named box
# appends "-<box>" so two boxes over one workspace never share sessions.
_derive_project_session_key() {
  local project="$1"
  local box="${2:-}"
  local _basename _hash key
  _basename="$(basename "$project" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
  _hash="$(echo -n "$project" | _md5 | head -c 8)"
  key="${_basename}-${_hash}"
  if [[ -n "$box" && "$box" != "main" ]]; then
    key="${key}-${box}"
  fi
  echo "$key"
}

# Parse and validate the box positional for a box-aware verb (see
# concept/20-boxes.md). Sets the global _BOX; an empty arg → the default box
# "main". Prints an error and exits on an invalid name. Call from the dispatch
# DIRECTLY, not inside $(...), so the exit propagates to the whole process.
_set_box() {
  local box="${1:-}"
  # A box-aware verb takes exactly one [box] positional; reject stray args so a
  # typo like `cleat stop az dev` errors instead of silently acting on only az.
  if [[ $# -gt 1 ]]; then
    error "Unexpected argument: ${BOLD}${2}${RESET}"
    echo -e "    ${DIM}A box-aware command takes a single [box] name.${RESET}"
    exit 1
  fi
  if [[ -z "$box" ]]; then
    _BOX="main"
    return 0
  fi
  if ! _validate_box_name "$box"; then
    error "Invalid box name: ${BOLD}${box}${RESET}"
    echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars (e.g. ${BOLD}az${RESET}${DIM}, ${BOLD}dev${RESET}${DIM}).${RESET}"
    exit 1
  fi
  _BOX="$box"
}

resolve_project() {
  local project="${1:-$PWD}"
  if [[ -d "$project" ]]; then
    (cd "$project" && pwd)
  else
    echo "$project"
  fi
}

# ── Helpers ─────────────────────────────────────────────────────────────────
is_running() {
  docker ps --filter "name=^${1}$" --format '{{.Names}}' 2>/dev/null | grep -q "^${1}$"
}

container_exists() {
  docker ps -a --filter "name=^${1}$" --format '{{.Names}}' 2>/dev/null | grep -q "^${1}$"
}

image_exists() {
  docker images --format '{{.Repository}}' 2>/dev/null | grep -q "^${IMAGE_NAME}$"
}

# GOARCH of the docker daemon (arm64/amd64): the architecture containers
# actually run as. Read from the SERVER, not uname: with a remote DOCKER_HOST
# the local machine's arch is irrelevant. Empty when unreachable (callers
# must fail open).
_daemon_arch() {
  docker version --format '{{.Server.Arch}}' 2>/dev/null || true
}

# GOARCH of a local image, empty if unknown/absent.
_image_arch() {
  docker image inspect "$1" --format '{{.Architecture}}' 2>/dev/null || true
}

# True when the image's architecture matches the daemon's, i.e. its
# containers run natively. Unknown daemon or image arch fails OPEN (ok): an
# unreachable daemon or exotic setup must never force a rebuild loop. FALSE
# means the image would run under emulation: slow, and the documented
# trigger for node segfaults and garbled TTYs on Apple Silicon (Docker calls
# amd64-on-arm "best effort"). Callers treat such an image as missing and
# re-acquire a native one.
_image_arch_ok() {
  local image="${1:-$IMAGE_NAME}"
  local want have
  want="$(_daemon_arch)"
  [[ -n "$want" ]] || return 0
  have="$(_image_arch "$image")"
  [[ -n "$have" ]] || return 0
  [[ "$have" == "$want" ]]
}

# One-line explanation used by the acquisition gates when replacing an
# emulated image with a native one.
_warn_image_emulated() {
  warn "Local image is ${BOLD}$(_image_arch "$IMAGE_NAME")${RESET} but Docker runs ${BOLD}$(_daemon_arch)${RESET}. Emulated boxes are slow and crash-prone; fetching a native image"
}

require_running() {
  local cname="$1"
  if ! is_running "$cname"; then
    error "Container ${BOLD}${cname}${RESET} is not running."
    echo -e "    ${DIM}Start it with: cleat start${RESET}"
    exit 1
  fi
}

# ── Host connectivity ────────────────────────────────────────────────────
# Docker Desktop (macOS/Windows) provides host.docker.internal automatically.
# On Linux with Docker Engine, we need --add-host for it.
_is_docker_desktop() {
  # Read JUST the OperatingSystem field via --format, NOT `docker info | grep`.
  # The piped form is SIGPIPE-fragile under `set -o pipefail` (which the real
  # binary runs): when `grep -q` matches it exits immediately and closes the
  # pipe, `docker info` then dies of SIGPIPE (141) on its next write, and
  # pipefail reports the whole pipeline as FAILED even though it matched. Under
  # memory pressure `docker info` is slow and has lots still to write when grep
  # bails, so the race tips to "failed" exactly when the Docker-Desktop-only VM
  # advisory needs to fire: the on-start "give Docker more memory" steps then
  # silently vanished (observed v0.16.1). The format query has no pipe, no race,
  # and is cheaper (one field, not the whole info dump).
  local os
  os="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null)" || return 1
  [[ "$os" == *"Docker Desktop"* ]]
}

# True on macOS. macOS keeps Claude Code's OAuth login in the login Keychain,
# not in ~/.claude/.credentials.json, so the shared ~/.claude mount carries no
# token and a freshly-auth'd host still re-prompts inside the box. The seed
# helpers below bridge that gap. Overridable in tests.
_is_macos() {
  [[ "${OSTYPE:-}" == darwin* ]] || [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]
}

# Whether the daemon's memory pool is a VM: Docker Desktop on any OS, and every
# macOS backend (Desktop, OrbStack, and Colima all run the daemon in a Linux
# VM). A native or rootless Linux engine (and a WSL2 in-distro engine) draws
# from the host's own RAM: no VM exists, so the memory advisories must not
# call the pool one. macOS short-circuits without touching the daemon; the
# Linux branch costs one `docker info` field read. Overridable in tests.
_docker_pool_is_vm() {
  _is_macos && return 0
  _is_docker_desktop
}

# ── Docker autopilot (concept/29) ────────────────────────────────────────────
#
# A down daemon after a reboot is the single most common "Docker is friction"
# moment. On the session verbs, in an interactive terminal, cleat starts the
# user's own Docker (Docker Desktop / OrbStack / Colima on macOS, Docker
# Desktop or a rootless engine on Linux, the Windows-side Docker Desktop from
# WSL2), waits on a bounded poll, then continues the original command. Where
# it cannot start Docker safely (remote endpoints, a root-owned Linux engine)
# it prints the exact one-line command instead of guessing. One-shot: cleat
# launches the user's own Docker and adds no persistent process of its own.

# Is the docker CLI on PATH at all? Overridable in tests.
_docker_cli_present() {
  command -v docker > /dev/null 2>&1
}

# Daemon reachable? An EXIT-CODE gate, deliberately NOT a stderr string match:
# the "Cannot connect to the Docker daemon" text is version- and locale-
# dependent (Docker 29 says "failed to connect to the docker API").
# Overridable in tests.
_daemon_up() {
  docker info > /dev/null 2>&1
}

# The current context's daemon endpoint / name, both readable with NO live
# daemon (unlike _is_docker_desktop, which needs `docker info`). Empty when
# unreadable. Overridable in tests.
_docker_context_endpoint() {
  docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true
}

_docker_context_name() {
  docker context show 2>/dev/null || true
}

# True inside WSL2 (Docker Desktop for Windows integrates via WSL; the
# Windows-side app can be launched from here). Overridable in tests.
_is_wsl() {
  grep -qi microsoft /proc/version 2>/dev/null
}

# Where Docker Desktop for Windows lives, as seen from WSL (empty when
# absent). Overridable in tests.
_wsl_desktop_exe() {
  # Docker Desktop for Windows, as seen from WSL. Probe the default install
  # under any drvfs mount root (automount.root may not be /mnt, the system
  # drive may not be C:), so a non-C: or custom-mount install is still found.
  local exe root
  for root in /mnt/c /mnt/*; do
    exe="$root/Program Files/Docker/Docker/Docker Desktop.exe"
    if [[ -e "$exe" ]]; then
      printf '%s' "$exe"
      return 0
    fi
  done
}

# WSL interop is live (the kernel can exec Windows .exe binaries). When
# interop is disabled, the drvfs mount still shows Docker Desktop.exe but
# launching it fails, so gate wsl-desktop on this. Overridable in tests.
_wsl_interop_ok() {
  [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]] \
    || [[ -e /proc/sys/fs/binfmt_misc/WSLInterop-late ]]
}

# A macOS app bundle is installed, checking both the system and per-user
# (no-admin install) Applications dirs. Overridable in tests (Linux CI has
# no /Applications).
_app_bundle_present() {
  [[ -d "/Applications/$1.app" ]] || [[ -d "$HOME/Applications/$1.app" ]]
}

_colima_present() {
  command -v colima > /dev/null 2>&1
}

# Docker Desktop for Linux installs a per-user systemd unit; its presence is
# daemon-down-safe evidence. Overridable in tests.
_desktop_linux_unit_present() {
  local units
  units="$(systemctl --user list-unit-files docker-desktop.service 2>/dev/null)" || units=""
  [[ "$units" == *docker-desktop* ]]
}

# Evidence of an in-distro Docker engine (native Linux or inside a WSL
# distro), from daemon-down-safe signals: a system docker unit, a sysv/init
# script, or the dockerd binary. Used inside WSL to prefer the in-distro
# engine over the Windows-side Desktop (attaching to the wrong engine is
# worse than a slower start). Overridable in tests.
_distro_docker_present() {
  local units
  units="$(systemctl list-unit-files docker.service 2>/dev/null)" || units=""
  [[ "$units" == *docker.service* ]] && return 0
  [[ -e /etc/init.d/docker ]] && return 0
  command -v dockerd > /dev/null 2>&1
}

# Pick the launcher for a DOWN daemon, from daemon-down-safe evidence only:
# the docker context (the user's explicit choice), then app/unit presence.
# _is_docker_desktop() is useless here (it needs `docker info`). Prints one
# of: desktop-macos | orbstack | colima | colima:<profile> | wsl-desktop |
# wsl-none | desktop-linux | rootless-linux | engine-linux | none.
_autostart_pick() {
  local ctx endpoint p
  ctx="$(_docker_context_name)"
  endpoint="$(_docker_context_endpoint)"

  if _is_macos; then
    # A stale context (backend uninstalled) must not be trusted for a
    # backgrounded launcher (colima) whose spawn failure we can't catch, so
    # colima arms verify _colima_present and otherwise fall through to app
    # detection. colima names its context `colima` (default) or
    # `colima-<profile>`; a named profile MUST be plumbed through or a bare
    # `colima start` boots the wrong VM and the poll waits on a socket that
    # never comes up.
    case "$ctx" in
      orbstack) echo orbstack; return 0 ;;
      colima)   _colima_present && { echo colima; return 0; } ;;
      colima-*) _colima_present && { echo "colima:${ctx#colima-}"; return 0; } ;;
      desktop-linux) echo desktop-macos; return 0 ;;
    esac
    case "$endpoint" in
      *"/.orbstack/"*) echo orbstack; return 0 ;;
      *"/.colima/"*)
        if _colima_present; then
          p="${endpoint#*/.colima/}"; p="${p%%/*}"
          if [[ -n "$p" && "$p" != "default" ]]; then echo "colima:$p"; else echo colima; fi
          return 0
        fi
        ;;
    esac
    # No usable context: fall back to what's installed, Desktop first
    # (the overwhelmingly common install).
    if _app_bundle_present Docker; then
      echo desktop-macos
    elif _app_bundle_present OrbStack; then
      echo orbstack
    elif _colima_present; then
      echo colima
    else
      echo none
    fi
    return 0
  fi

  # Linux, native or inside a WSL distro. In-distro evidence wins FIRST, so a
  # docker-ce / rootless engine inside the distro is chosen over the
  # Windows-side Desktop (attaching a session to the wrong engine is worse
  # than a slower start).
  if [[ "$ctx" == "desktop-linux" ]] || _desktop_linux_unit_present; then
    echo desktop-linux
    return 0
  fi
  case "$ctx" in
    rootless) echo rootless-linux; return 0 ;;
  esac
  case "$endpoint" in
    *"/run/user/"*) echo rootless-linux; return 0 ;;
  esac
  # Rootless socket under a non-standard XDG_RUNTIME_DIR (not /run/user/<uid>).
  if [[ -n "${XDG_RUNTIME_DIR:-}" && -n "$endpoint" && "$endpoint" == *"${XDG_RUNTIME_DIR}"* ]]; then
    echo rootless-linux
    return 0
  fi

  if _is_wsl; then
    # No in-distro Desktop/rootless context above. Prefer an in-distro root
    # engine if there's evidence; otherwise launch the Windows-side Desktop,
    # but only when interop can actually exec it.
    if _distro_docker_present; then
      echo engine-linux
      return 0
    fi
    if _wsl_interop_ok && [[ -n "$(_wsl_desktop_exe)" ]]; then
      echo wsl-desktop
    else
      echo wsl-none
    fi
    return 0
  fi

  # Native Linux: a root-owned engine is the catch-all.
  echo engine-linux
}

# Human name for messages.
_autostart_label() {
  case "$1" in
    desktop-macos|desktop-linux) echo "Docker Desktop" ;;
    orbstack)             echo "OrbStack" ;;
    colima|colima:*)      echo "Colima" ;;
    wsl-desktop|wsl-none) echo "Docker Desktop (Windows)" ;;
    rootless-linux)       echo "rootless Docker" ;;
    *)                    echo "Docker" ;;
  esac
}

# The exact start command (or, for kinds that have no single command, a plain
# instruction) for when autopilot can't or won't launch. Callers must NOT glue
# this into a "start it with: <hint>" template unconditionally; use
# _autostart_hint_is_command to tell the two apart.
_autostart_hint() {
  case "$1" in
    desktop-macos)  echo "open -a Docker" ;;
    orbstack)       echo "open -a OrbStack" ;;
    colima)         echo "colima start" ;;
    colima:*)       echo "colima start -p ${1#colima:}" ;;
    wsl-desktop|wsl-none) echo "start Docker Desktop on Windows (enable WSL integration for this distro)" ;;
    desktop-linux)  echo "systemctl --user start docker-desktop" ;;
    rootless-linux)
      if command -v systemctl > /dev/null 2>&1; then
        echo "systemctl --user start docker"
      else
        echo "dockerd-rootless.sh (or your init's rootless docker service)"
      fi
      ;;
    engine-linux)
      if command -v systemctl > /dev/null 2>&1; then
        echo "sudo systemctl start docker"
      else
        echo "sudo service docker start"
      fi
      ;;
    *) echo "start Docker, then retry" ;;
  esac
}

# True when _autostart_hint returns a copy-pasteable command (vs a plain
# instruction), so callers phrase "start it with: X" vs a bare sentence.
_autostart_hint_is_command() {
  case "$1" in
    wsl-desktop|wsl-none|none) return 1 ;;
    *) return 0 ;;
  esac
}

# Launch the picked backend, one-shot, output suppressed. Blocking starters
# (colima, the Windows exe) go to a disowning subshell; `open` and systemctl
# return immediately on their own. Overridable in tests. Non-zero when the
# launch command itself failed to spawn (or the kind is not launchable).
_autostart_launch() {
  case "$1" in
    desktop-macos)  open -g -a Docker > /dev/null 2>&1 ;;
    orbstack)       open -g -a OrbStack > /dev/null 2>&1 ;;
    colima)         ( colima start > /dev/null 2>&1 & ) ;;
    colima:*)       ( colima start -p "${1#colima:}" > /dev/null 2>&1 & ) ;;
    wsl-desktop)    ( "$(_wsl_desktop_exe)" > /dev/null 2>&1 & ) ;;
    desktop-linux)  systemctl --user start docker-desktop > /dev/null 2>&1 ;;
    rootless-linux) systemctl --user start docker > /dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

# VM-backed backends show "the Docker VM"; a rootless/root host daemon has no
# VM, so the poll says "the Docker daemon" instead.
_autostart_poll_noun() {
  case "$1" in
    rootless-linux|engine-linux) echo "the Docker daemon" ;;
    *) echo "the Docker VM" ;;
  esac
}

# ── Docker install offer (the autopilot's missing-CLI branch) ───────────────
#
# Installing Docker is privileged and system-mutating, so unlike the launcher
# it is CONSENT-FIRST everywhere: the exact command is shown, the default is
# No, non-TTY never prompts (it prints the per-OS command and exits), and
# CLEAT_NO_AUTOSTART=1 suppresses the offer along with the rest of autopilot.
# macOS asks WHICH flavor because the choice is licensing as much as tech
# (Docker Desktop and OrbStack are paid for larger companies; Colima is open
# source); automation goes through Homebrew's official casks. Linux installs
# the engine via Docker's official convenience script, downloaded to a file
# first (never a blind curl-pipe-sh), then offers the docker-group add. WSL2
# installs the Windows-side Docker Desktop through winget when reachable.

# Seams, overridable in tests (which must never run a real installer).
_brew_present()   { command -v brew > /dev/null 2>&1; }
_winget_present() { command -v winget.exe > /dev/null 2>&1; }

# Run one visible install step: echo the exact command, then execute it
# attached to the terminal (sudo and brew may prompt). Overridable in tests
# (records instead of running).
_install_run() {
  echo -e "    ${DIM}\$ $*${RESET}"
  "$@"
}

# The per-OS one-line install command, for non-TTY and declined offers. Kept
# to a single copy-pasteable command that fits ~80 cols with its "Install it
# with: " prefix (the interactive menu is where the OrbStack/Colima
# alternatives live); the Linux get.docker.com line is inherently long but is
# one pasteable unit.
_docker_install_hint() {
  if _is_macos; then
    echo "brew install --cask docker"
  elif _is_wsl; then
    echo "winget.exe install -e --id Docker.DockerDesktop"
  else
    echo "curl -fsSL https://get.docker.com -o get-docker.sh && sudo sh get-docker.sh"
  fi
}

# Interactive install offer. Returns 0 when an install ran and the docker CLI
# is now present (the caller re-enters the autopilot flow), non-zero exit
# otherwise. TTY-only by contract (the caller gates).
_offer_docker_install() {
  if _is_macos; then
    if ! _brew_present; then
      echo -e "    ${DIM}Homebrew isn't installed, so cleat won't automate this. Official installers:${RESET}"
      echo -e "    ${DIM}Docker Desktop: https://docker.com/products/docker-desktop${RESET}"
      echo -e "    ${DIM}OrbStack:       https://orbstack.dev${RESET}"
      echo -e "    ${DIM}Colima:         https://github.com/abiosoft/colima${RESET}"
      exit 1
    fi
    echo ""
    echo -e "  Install Docker now? ${DIM}(via Homebrew)${RESET}"
    echo ""
    echo -e "    ${BOLD}1${RESET}) Docker Desktop  ${DIM}(the standard; free for personal use, paid for larger companies)${RESET}"
    echo -e "    ${BOLD}2${RESET}) OrbStack        ${DIM}(fast, mac-native; free for personal use, paid commercially)${RESET}"
    echo -e "    ${BOLD}3${RESET}) Colima          ${DIM}(open source, CLI-only, no GUI)${RESET}"
    echo -e "    ${BOLD}n${RESET}) no"
    echo ""
    local choice=""
    echo -en "    Choice [1/2/3/n] "
    read -r choice || choice=""
    case "$choice" in
      1) _install_run brew install --cask docker || { error "Install failed."; exit 1; } ;;
      2) _install_run brew install --cask orbstack || { error "Install failed."; exit 1; } ;;
      3) _install_run brew install docker colima || { error "Install failed."; exit 1; } ;;
      *)
        info "Skipped. Install later with: ${BOLD}$(_docker_install_hint)${RESET}"
        exit 1
        ;;
    esac
    return 0
  fi

  if _is_wsl; then
    if ! _winget_present; then
      echo -e "    ${DIM}Install Docker Desktop on Windows (docker.com/products/docker-desktop),${RESET}"
      echo -e "    ${DIM}enable WSL integration for this distro, then retry.${RESET}"
      exit 1
    fi
    echo ""
    local yn=""
    _ask_yn yn "Install Docker Desktop on Windows now (via winget)? [y/N] "
    if [[ "$yn" != [yY]* ]]; then
      info "Skipped. Install later with: ${BOLD}$(_docker_install_hint)${RESET}"
      exit 1
    fi
    _install_run winget.exe install -e --id Docker.DockerDesktop || { error "Install failed."; exit 1; }
    echo -e "    ${DIM}Start Docker Desktop on Windows and enable WSL integration for this distro.${RESET}"
    return 0
  fi

  # Linux: Docker's official convenience script, downloaded first so what
  # runs under sudo is a file you could have inspected, never a blind pipe.
  if ! command -v curl > /dev/null 2>&1 && ! command -v wget > /dev/null 2>&1; then
    error "Need curl or wget to fetch the Docker install script."
    echo -e "    ${DIM}Install one, or install Docker from your distro's packages.${RESET}"
    exit 1
  fi
  echo ""
  echo -e "  Install Docker Engine now? ${DIM}(Docker's official install script for mainstream distros, run with sudo)${RESET}"
  local yn=""
  _ask_yn yn "Download get.docker.com and run it? [y/N] "
  if [[ "$yn" != [yY]* ]]; then
    info "Skipped. Install later with: ${BOLD}$(_docker_install_hint)${RESET}"
    exit 1
  fi
  # Stage in a private 0700 dir created atomically by mktemp, NOT a predictable
  # $$-named file in world-writable /tmp: the download is then run under sudo,
  # so a pre-created/symlinked attacker-owned temp file would be a local root
  # TOCTOU (curl -o has no O_EXCL). mktemp -d makes the dir unguessable and
  # owned exclusively by us, so nothing can pre-plant or rewrite the script.
  local stage script
  stage="$(mktemp -d "${TMPDIR:-/tmp}/cleat-docker.XXXXXX")" || { error "Could not create a temp dir."; exit 1; }
  script="$stage/get-docker.sh"
  if command -v curl > /dev/null 2>&1; then
    if ! _install_run curl -fsSL https://get.docker.com -o "$script"; then
      rm -rf "$stage"; error "Download failed."; exit 1
    fi
  else
    if ! _install_run wget -qO "$script" https://get.docker.com; then
      rm -rf "$stage"; error "Download failed."; exit 1
    fi
  fi
  if ! _install_run sudo sh "$script"; then
    rm -rf "$stage"
    error "Install failed."
    exit 1
  fi
  rm -rf "$stage"
  # $USER can be unset under `su -c` or minimal PTYs; set -u would abort here.
  local u="${USER:-$(id -un 2>/dev/null)}"
  local gyn=""
  _ask_yn gyn "Add ${u} to the docker group (run docker without sudo)? [y/N] "
  if [[ "$gyn" == [yY]* ]]; then
    _install_run sudo usermod -aG docker "$u" || true
    success "Docker Engine installed."
    echo -e "    ${DIM}Log out and back in for the docker group to apply, then run ${BOLD}cleat${RESET}${DIM} again.${RESET}"
  else
    success "Docker Engine installed."
    echo -e "    ${DIM}Without the docker group you'll need sudo for docker. Run ${BOLD}cleat${RESET}${DIM} again to continue.${RESET}"
  fi
  # The fresh engine's socket isn't usable by this shell yet (group membership
  # applies at next login), so the session can't continue in the same breath.
  exit 1
}

# Ensure the daemon is reachable before a session verb. Remote endpoints are
# refused (launching a local app is wrong for them), the GUI pop is TTY-gated
# with a CLEAT_NO_AUTOSTART=1 opt-out (consistent with CLEAT_NO_IDLE_SWEEP /
# CLEAT_NO_UPDATE_CHECK), and the wait is a bounded foreground poll
# (CLEAT_AUTOSTART_TIMEOUT_SECS, default 90: a Docker Desktop cold boot is
# often 30-60s). Exits non-zero when Docker stays down; never loops forever.
_ensure_daemon() {
  if ! _docker_cli_present; then
    error "Docker isn't installed."
    if [[ "${CLEAT_NO_AUTOSTART:-}" == "1" ]] || ! _is_tty; then
      echo -e "    ${DIM}Install it with: ${BOLD}$(_docker_install_hint)${RESET}"
      exit 1
    fi
    # Consent-first install offer; on success the CLI exists now, so fall
    # through to the normal autopilot flow (down daemon → launch → poll).
    _offer_docker_install
    if ! _docker_cli_present; then
      if _is_wsl; then
        error "docker isn't on PATH yet."
        echo -e "    ${DIM}Start Docker Desktop on Windows, enable WSL integration for this distro, then retry.${RESET}"
      else
        error "docker still isn't on PATH ${DIM}(open a new terminal, then retry)${RESET}."
      fi
      exit 1
    fi
    success "Docker installed."
  fi

  _daemon_up && return 0

  # Remote endpoints: say where the daemon runs instead of popping a local
  # GUI. DOCKER_HOST wins over the context (docker's own precedence). Strip
  # control chars before display: the endpoint can carry terminal escapes
  # from a poisoned DOCKER_HOST or an imported context, and error() uses
  # echo -e which would render them raw.
  local endpoint="${DOCKER_HOST:-}"
  [[ -n "$endpoint" ]] || endpoint="$(_docker_context_endpoint)"
  local endpoint_show
  endpoint_show="$(printf '%s' "$endpoint" | tr -d '\000-\037')"
  case "$endpoint" in
    tcp://*|ssh://*|npipe://*|fd://*)
      error "Remote Docker daemon unreachable ${DIM}(${endpoint_show})${RESET}."
      echo -e "    ${DIM}Start it where it runs, then retry.${RESET}"
      exit 1
      ;;
  esac

  # Permission, not down: a local unix socket that EXISTS but isn't accessible
  # means the daemon is up and the user just isn't in the docker group. Saying
  # "start Docker" here would loop the user (worst case: right after cleat's own
  # installer told them to re-login). Only when the socket is a real, present,
  # inaccessible socket, so a genuinely-down daemon (no socket) still autostarts.
  case "$endpoint" in
    unix://*)
      local sock="${endpoint#unix://}"
      if [[ -S "$sock" && ! -w "$sock" ]]; then
        error "Docker is running, but you can't reach its socket ${DIM}(${sock})${RESET}."
        local u="${USER:-$(id -un 2>/dev/null)}"
        echo -e "    ${DIM}Add yourself to the docker group: ${BOLD}sudo usermod -aG docker ${u}${RESET}${DIM}, then log out and back in.${RESET}"
        exit 1
      fi
      ;;
  esac

  local kind
  kind="$(_autostart_pick)"

  # Kinds that cannot be safely auto-launched (root engine, remote-less WSL
  # with no interop, nothing recognized) message and exit; the rest launch.
  if [[ "${CLEAT_NO_AUTOSTART:-}" == "1" ]] || ! _is_tty \
     || [[ "$kind" == "engine-linux" || "$kind" == "none" || "$kind" == "wsl-none" ]]; then
    error "Docker isn't running."
    if _autostart_hint_is_command "$kind"; then
      echo -e "    ${DIM}Start it with: ${BOLD}$(_autostart_hint "$kind")${RESET}"
    else
      echo -e "    ${DIM}To fix: $(_autostart_hint "$kind").${RESET}"
    fi
    exit 1
  fi

  warn "Docker isn't running. Starting $(_autostart_label "$kind")..."
  if ! _autostart_launch "$kind"; then
    error "Could not launch $(_autostart_label "$kind")."
    echo -e "    ${DIM}Start it with: ${BOLD}$(_autostart_hint "$kind")${RESET}"
    exit 1
  fi

  # Bounded foreground poll with the _do_pull frame idiom (no background
  # watcher: a daemon poll has no natural terminator, so it needs an explicit
  # deadline and a non-zero exit, or a broken install hangs the CLI forever).
  local deadline="${CLEAT_AUTOSTART_TIMEOUT_SECS:-90}"
  if ! [[ "$deadline" =~ ^[0-9]+$ ]] || (( deadline < 1 )); then
    deadline=90
  fi
  local frames
  if _has_unicode; then
    frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  else
    frames=('-' '\' '|' '/')
  fi
  { command -v tput &>/dev/null && tput civis 2>/dev/null; } || true
  local poll_noun
  poll_noun="$(_autostart_poll_noun "$kind")"
  local start now elapsed=0 i=0
  start="$(date +%s)"
  while ! _daemon_up; do
    now="$(date +%s)"
    elapsed=$(( now - start ))
    if (( elapsed >= deadline )); then
      { command -v tput &>/dev/null && tput cnorm 2>/dev/null; } || true
      printf "\r\033[K"
      error "Docker did not come up in ${deadline}s. Open it manually, then retry."
      exit 1
    fi
    printf "\r\033[K  ${BLUE}%s${RESET} waiting for %s ${DIM}(%ss)${RESET}" "${frames[$i]}" "$poll_noun" "$elapsed"
    i=$(( (i + 1) % ${#frames[@]} ))
    sleep 0.5
  done
  { command -v tput &>/dev/null && tput cnorm 2>/dev/null; } || true
  printf "\r\033[K"
  success "Docker ready"
  return 0
}

# Read Claude Code's OAuth credential blob from the macOS login Keychain. Claude
# stores it as a generic-password under the service "Claude Code-credentials"
# (older builds: "Claude Code"); `-w` prints just the secret (the JSON blob).
# Prints the blob on stdout, nothing on failure. `security` may pop a one-time
# Keychain access dialog the first time. Once the user clicks "Always Allow"
# it's silent; a denied/headless read (errSecInteractionNotAllowed over SSH)
# simply fails and we fall through. Overridable in tests.
_macos_keychain_credentials() {
  command -v security &>/dev/null || return 1
  local svc blob
  for svc in "Claude Code-credentials" "Claude Code"; do
    blob="$(security find-generic-password -s "$svc" -w 2>/dev/null)" || continue
    [[ -n "$blob" ]] && { printf '%s' "$blob"; return 0; }
  done
  return 1
}

# Extract the OAuth token's expiry (epoch MILLISECONDS) from a Claude credentials
# blob on stdin; empty when absent or unparseable. Pure-bash grep (no jq dep),
# case-insensitive so it matches `expiresAt` whatever the wrapper key around it,
# same leading-zero-safe style as the swap reader. Claude stores expiresAt in ms;
# a missing, non-numeric, or seconds-scaled value just fails the validity compare
# in _seed_macos_credentials, which then keeps the existing file untouched (the
# safe path). Overridable indirectly via the blob the caller pipes in.
_oauth_expires_at() {
  local n
  n="$(grep -iEo '"expiresat"[[:space:]]*:[[:space:]]*[0-9]+' 2>/dev/null \
         | grep -Eo '[0-9]+' | tail -1 || true)"
  [[ "$n" =~ ^[0-9]+$ ]] && printf '%s' "$n"
  # Always succeed: the caller assigns this in `x="$(...)"`, and a non-zero exit
  # there trips the CLI's `set -e` (a missing/absent expiresAt is normal, not an
  # error). The empty stdout is the signal; the exit code must stay 0.
  return 0
}

# On macOS, materialize the Keychain-stored OAuth credential into
# ~/.claude/.credentials.json (the path Claude reads on Linux), so the box,
# which only sees the mounted ~/.claude dir, never the Keychain, starts
# authenticated instead of re-prompting. The blob is validated as a JSON object
# and written 0600. No-op off macOS or when the Keychain has nothing.
#
# When to (re)seed:
#   - File ABSENT/empty  -> seed (Linux hosts already have it; this never runs).
#   - File PRESENT       -> re-seed ONLY when its OAuth token has EXPIRED *and*
#                           the Keychain holds a fresher, still-valid one.
# The re-seed closes the host-re-login gap (concept/23 open item): a host
# re-login rotates the Keychain token and invalidates the file's now-stale
# refresh token, so a freshly-created box that has never refreshed reads a dead
# token from the shared file and drops to an interactive LOGIN. A still-valid
# file token is never touched (the box refreshes its own and may be fresher than
# the Keychain). Anything we can't parse (no expiresAt, non-numeric, seconds
# scale) falls through to "keep the file", so an unrecognized schema can never
# trigger a clobber. Sets _SEEDED_CREDS=1 on a write. _CLEAT_NOW_S overrides the
# clock for tests.
_SEEDED_CREDS=0
_seed_macos_credentials() {
  _is_macos || return 0
  local cred="${HOME}/.claude/.credentials.json"
  local blob=""
  if [[ -s "$cred" ]]; then
    local file_exp kc_exp now_ms
    file_exp="$(_oauth_expires_at < "$cred" 2>/dev/null)"
    [[ "$file_exp" =~ ^[0-9]+$ ]] || return 0          # unparseable file token -> keep
    now_ms=$(( ${_CLEAT_NOW_S:-$(date +%s)} * 1000 ))
    (( file_exp > now_ms )) && return 0                # file token still valid -> keep
    blob="$(_macos_keychain_credentials)" || return 0
    [[ -n "$blob" ]] || return 0
    kc_exp="$(printf '%s' "$blob" | _oauth_expires_at 2>/dev/null)"
    [[ "$kc_exp" =~ ^[0-9]+$ ]] || return 0            # unparseable keychain token -> keep
    # Only a Keychain token that is BOTH fresher than the file's AND not itself
    # expired earns the overwrite; otherwise keep what we have.
    (( kc_exp > file_exp && kc_exp > now_ms )) || return 0
  else
    blob="$(_macos_keychain_credentials)" || return 0
    [[ -n "$blob" ]] || return 0
  fi
  mkdir -p "${HOME}/.claude" 2>/dev/null || return 0
  local tmp="${cred}.tmp.$$"
  ( umask 077; printf '%s' "$blob" > "$tmp" ) 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
  # Never write a non-JSON-object (e.g. an error string) into the creds file.
  local ok=false
  if command -v jq &>/dev/null; then
    jq -e 'type=="object"' "$tmp" >/dev/null 2>&1 && ok=true
  else
    _looks_like_json_object "$tmp" && ok=true
  fi
  if $ok; then
    chmod 600 "$tmp" 2>/dev/null || true
    if mv -f "$tmp" "$cred" 2>/dev/null; then _SEEDED_CREDS=1; else rm -f "$tmp" 2>/dev/null; fi
  else
    rm -f "$tmp" 2>/dev/null
  fi
  return 0
}

_host_connectivity_args() {
  local args=()
  if ! _is_docker_desktop 2>/dev/null; then
    args+=(--add-host "host.docker.internal:host-gateway")
  fi
  echo "${args[@]+"${args[@]}"}"
}

# ── Capabilities: config file reading ──────────────────────────────────────
# Read capabilities from a config file. Returns newline-separated cap names.
# Config format: [caps] section header, then one cap name per line.
_read_caps_from_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local in_caps=false
  # `|| [[ -n "$line" ]]` so a final line with no trailing newline (common in
  # hand-edited .cleat/config files, e.g. `printf '[caps]\nenv'`) is still read;
  # without it `read` returns non-zero at EOF and the last capability is silently
  # dropped. Matches the env-file parser (_parse_env_file).
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip carriage return (CRLF from Windows editors)
    line="${line%$'\r'}"
    # Strip leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    # Skip empty lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue
    # Section header
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "[caps]" ]] && in_caps=true || in_caps=false
      continue
    fi
    if $in_caps; then
      echo "$line"
    fi
  done < "$file"
}

# Read [setup] provisioning lines from a config file. Exact structural
# mirror of _read_caps_from_file above, matching the literal "[setup]"
# header instead: same CRLF strip, whitespace trim, blank/# skip, and
# no-trailing-newline handling. ANY other `[...]` line turns the section
# off (INI hazard: a stray `[ -f x ]` test line reads as a header; docs say
# use `test`, and _warn_unknown_cleat_sections surfaces the mistake).
_read_setup_from_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local in_setup=false
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "[setup]" ]] && in_setup=true || in_setup=false
      continue
    fi
    if $in_setup; then
      echo "$line"
    fi
  done < "$file"
}

# Write capabilities to a config file. Preserves non-[caps] sections.
_write_caps_to_file() {
  local file="$1"
  shift
  local caps=("$@")

  mkdir -p "$(dirname "$file")"

  # If file exists, preserve everything outside [caps] section
  local preserved=""
  if [[ -f "$file" ]]; then
    local in_caps=false
    # `|| [[ -n "$line" ]]` so a project .cleat whose LAST section is hand-written
    # and ends WITHOUT a trailing newline (e.g. a final `[setup]` line) is not
    # silently dropped from `preserved`: without the guard `read` returns non-zero
    # at EOF and the last line is lost, corrupting a section this writer must keep
    # byte-for-byte. Matches _read_section_from_file / _write_kits_to_file / _write_resources_to_file.
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      if [[ "$line" == "[caps]" ]]; then
        in_caps=true
        continue
      fi
      if $in_caps; then
        # Skip lines in old [caps] section until next section or EOF
        if [[ "$line" == "["*"]" ]]; then
          in_caps=false
          preserved+="$line"$'\n'
        fi
        continue
      fi
      preserved+="$line"$'\n'
    done < "$file"
  fi

  # Write preserved content + new [caps] section
  {
    if [[ -n "$preserved" ]]; then
      printf '%s' "$preserved"
    fi
    if [[ ${#caps[@]} -gt 0 ]]; then
      echo "[caps]"
      for cap in "${caps[@]}"; do
        echo "$cap"
      done
    fi
  } > "$file"
}

# Write [resources] memory/cpus to a config file, preserving everything OUTSIDE
# [resources] (same shape as _write_caps_to_file / _write_kits_to_file). An empty
# value, or the picker sentinels "default"/"all", OMITS that key; when BOTH keys
# are unset no [resources] section is written at all, so an untouched config stays
# clean. Never touches [caps], [setup], or [kits]. The block uses explicit ifs
# (never `[[ ]] && echo`): a false test as the block's last list would make the
# `{ ...; } > file` compound return 1 and kill a strict-mode caller on the
# both-unset path (the exact bug the kits writer's comment records).
_write_resources_to_file() {
  local file="$1" memory="$2" cpus="$3"
  mkdir -p "$(dirname "$file")"

  # Sentinel -> empty (callers translate too; this is belt and suspenders so a
  # literal "default"/"all" can never leak into the file and get warned+ignored
  # by resolve_box_memory on every subsequent run).
  case "$memory" in default|all) memory="" ;; esac
  case "$cpus" in default|all) cpus="" ;; esac

  local preserved="" in_res=false line
  if [[ -f "$file" ]]; then
    # `|| [[ -n "$line" ]]` and the `\r` strip mirror the caps/kits writers: keep a
    # no-trailing-newline final section, and match a CRLF `[resources]\r` header so
    # the old section is REPLACED (not duplicated into two [resources] blocks).
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      if [[ "$line" == "[resources]" ]]; then
        in_res=true
        continue
      fi
      if $in_res; then
        if [[ "$line" == "["*"]" ]]; then
          in_res=false
          preserved+="$line"$'\n'
        fi
        continue
      fi
      preserved+="$line"$'\n'
    done < "$file"
  fi

  {
    if [[ -n "$preserved" ]]; then
      printf '%s' "$preserved"
    fi
    if [[ -n "$memory" || -n "$cpus" ]]; then
      echo "[resources]"
      if [[ -n "$memory" ]]; then
        echo "memory = $memory"
      fi
      if [[ -n "$cpus" ]]; then
        echo "cpus = $cpus"
      fi
    fi
  } > "$file"
}

# Resolve which project cap file applies to a box (see concept/20-boxes.md):
# a named box uses .cleat.<box> if present, ELSE falls back to .cleat. The
# default/"main" box always uses .cleat. REPLACE semantics: a box file fully
# replaces .cleat (it does NOT inherit), which is what enables least privilege:
# a box can declare FEWER caps than the project default.
_project_caps_file() {
  local project="$1" box="${2:-main}"
  if [[ "$box" != "main" && -f "$project/.cleat.$box" ]]; then
    echo "$project/.cleat.$box"
  else
    echo "$project/.cleat"
  fi
}

# Build the executable [setup] payload for (project, box): stdout is the
# exact byte stream that will run in the box. This framing (the "# cleat
# setup: begin/end script <path>" markers) is part of the hashed trust
# input (see _setup_payload_hash) and is FROZEN once shipped: changing it
# would silently invalidate every prior approval's byte-exactness.
# Empty stdout + rc 0 when there's no [setup] section (or no cap file).
# rc 1 (after a warn to stderr naming the bad directive) on an invalid
# `script <path>` line; the caller treats that as "skip setup, never abort
# the session", not a hard failure.
_build_setup_payload() {
  local project="$1" box="${2:-main}"
  local caps_file
  caps_file="$(_project_caps_file "$project" "$box")"
  [[ -f "$caps_file" ]] || return 0

  local line
  while IFS= read -r line; do
    case "$line" in
      "script "*)
        local path="${line#script }"
        # Trim surrounding whitespace, then one leading "./".
        path="${path#"${path%%[![:space:]]*}"}"
        path="${path%"${path##*[![:space:]]}"}"
        path="${path#./}"
        # Repo-controlled text rendered via warn()'s echo -e: sanitize the
        # display copy, keep the raw path for the actual file operations.
        local path_disp
        path_disp="$(_sanitize_repo_str "$path")"

        if [[ -z "$path" ]]; then
          warn "Project [setup] has an empty script path ${DIM}(script <path>)${RESET}" >&2
          return 1
        fi
        case "$path" in
          /*)
            warn "Project [setup] script path must be project-relative: ${BOLD}${path_disp}${RESET}" >&2
            return 1 ;;
        esac
        case "/$path/" in
          */../*)
            warn "Project [setup] script path may not contain '..': ${BOLD}${path_disp}${RESET}" >&2
            return 1 ;;
        esac

        local full="$project/$path"
        if [[ ! -f "$full" ]]; then
          warn "Project [setup] script not found: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        fi
        if [[ -L "$full" ]]; then
          warn "Project [setup] script may not be a symlink: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        fi

        local project_root parent_dir
        project_root="$(cd "$project" 2>/dev/null && pwd -P)" || {
          warn "Project [setup] script path could not be resolved: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        }
        parent_dir="$(cd "$(dirname "$full")" 2>/dev/null && pwd -P)" || {
          warn "Project [setup] script path could not be resolved: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        }
        case "$parent_dir/" in
          "$project_root/"*) ;;
          *)
            warn "Project [setup] script escapes the project directory: ${BOLD}${path_disp}${RESET}" >&2
            return 1 ;;
        esac

        echo "# cleat setup: begin script $path"
        cat "$full"
        printf '\n'
        echo "# cleat setup: end script $path"
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done < <(_read_setup_from_file "$caps_file")
}

# Same fallback shape for the env file: .cleat.<box>.env else .cleat.env, so
# an az box's cloud credentials are never visible to a dev box.
_project_env_file() {
  local project="$1" box="${2:-main}"
  if [[ "$box" != "main" && -f "$project/.cleat.$box.env" ]]; then
    echo "$project/.cleat.$box.env"
  else
    echo "$project/.cleat.env"
  fi
}

# ── Resources: per-box memory limit ──────────────────────────────────────────
# Read one key from a config file's [<section>] section. Lines are
# `key = value` (spaces optional). Same parsing hygiene as [caps]: CRLF-safe,
# comment- and whitespace-tolerant. Prints the value, or nothing when absent.
_read_section_from_file() {
  local file="$1" section="$2" key="$3"
  [[ -f "$file" ]] || return 0
  local in_section=false line k v
  # `|| [[ -n "$line" ]]` so a final line with no trailing newline (a hand-edited
  # `.cleat` ending in `memory = 8g`) is still read; without it `read` returns
  # non-zero at EOF and the configured value is silently dropped, falling back
  # to the default. Matches _read_caps_from_file and _parse_env_file.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "[$section]" ]] && in_section=true || in_section=false
      continue
    fi
    $in_section || continue
    [[ "$line" == *"="* ]] || continue
    k="${line%%=*}"
    v="${line#*=}"
    k="${k%"${k##*[![:space:]]}"}"
    v="${v#"${v%%[![:space:]]*}"}"
    if [[ "$k" == "$key" ]]; then
      echo "$v"
      return 0
    fi
  done < "$file"
}

# Back-compat wrapper: every existing [resources] call site keeps its shape.
_read_resource_from_file() {
  _read_section_from_file "$1" resources "$2"
}

# A docker memory value: positive integer with optional b/k/m/g suffix.
_valid_memory_value() {
  [[ "$1" =~ ^[0-9]+[bkmgBKMG]?$ ]] || return 1
  local n="${1%[bkmgBKMG]}"
  [[ -n "$n" ]] || return 1
  # Per-suffix digit caps keep the byte conversion inside 64-bit arithmetic.
  # An overflowed product WRAPS (possibly negative), slips past the 8g project
  # clamp comparison, and then aborts `docker run` with an opaque daemon error,
  # so e.g. "99999999999g" must be rejected here, not discovered by dockerd.
  case "$1" in
    *[gG]) [[ ${#n} -le 9 ]] || return 1 ;;
    *[mM]) [[ ${#n} -le 12 ]] || return 1 ;;
    *[kK]) [[ ${#n} -le 15 ]] || return 1 ;;
    *)     [[ ${#n} -le 18 ]] || return 1 ;;
  esac
  # Force base-10: a leading zero ("08g") is otherwise an octal parse error in
  # bash arithmetic, and all-zero spellings ("0", "00g") mean --memory 0,
  # which docker treats as UNLIMITED, a clamp bypass rather than a limit.
  (( 10#$n > 0 ))
}

# Convert a validated memory value to bytes (for clamping comparisons).
_mem_to_bytes() {
  local v="$1" n unit
  n="${v%[bkmgBKMG]}"
  unit="${v#"$n"}"
  n=$(( 10#$n ))   # strip leading zeros; bare $((08*…)) is an octal error
  case "$unit" in
    [gG]) echo $(( n * 1073741824 )) ;;
    [mM]) echo $(( n * 1048576 )) ;;
    [kK]) echo $(( n * 1024 )) ;;
    *)    echo "$n" ;;
  esac
}

# The Docker VM's total memory in bytes (empty when unknown). Split out so
# tests and the overload check can override/reuse it.
_docker_vm_memory() {
  docker info --format '{{.MemTotal}}' 2>/dev/null || true
}

# Round a byte count to the NEAREST whole GB. `docker info` reports the guest
# kernel's MemTotal, which is always a few hundred MB UNDER the Docker Desktop
# memory slider (the kernel reserves some at boot), so a 16 GB slider reports
# ~15.6 GiB. Flooring that prints a misleading "15 GB" AND, compared against an
# exact 16 GiB target, false-positives the undersized advisory on a VM that is
# in fact sized right. The slider moves in whole-GB steps and the reserve is
# under half a GB, so rounding to the nearest GB recovers the configured value:
# 15.6 → 16, while a genuine 15 GB slider (~14.6 GiB) still rounds to 15. Used
# for BOTH the displayed size and the threshold so the two can never contradict
# (no "shows 16 GB but warns it's too small"). Arg: $1 = bytes. Echoes whole GB
# (0 on missing/non-numeric input).
_vm_gb_rounded() {
  local b="${1:-0}"
  [[ "$b" =~ ^[0-9]+$ ]] || { echo 0; return; }
  # 10# forces base-10: a digit-only value can still carry a leading zero, which is
  # invalid octal and would abort the arithmetic under set -e (same guard the swap
  # reader uses). +0.5 GiB then floor = round-to-nearest.
  echo $(( (10#$b + 536870912) / 1073741824 ))
}

# The Docker Desktop settings file (empty when none is readable). `docker info`
# reports the VM's MemTotal but NOT its configured swap, so swap can only be read
# from Docker Desktop's own settings, which on macOS live under
# ~/Library/Group Containers/group.com.docker/. Newer Docker Desktop writes
# settings-store.json (PascalCase keys); older writes settings.json (camelCase).
# Try the newer one first. The base dir is overridable for tests.
_docker_desktop_settings_file() {
  local base="${_DD_SETTINGS_DIR:-$HOME/Library/Group Containers/group.com.docker}"
  local f
  for f in "$base/settings-store.json" "$base/settings.json"; do
    [[ -r "$f" ]] && { printf '%s' "$f"; return 0; }
  done
  return 0   # no file is the common case (non-Docker-Desktop, or a moved path):
             # return clean so a caller's `f="$(...)"` can never trip set -e.
}

# The Docker Desktop VM's configured SWAP size in bytes, empty when it can't be
# read. Scrapes "SwapMiB": <n> (case-insensitive, so it matches both the newer
# `SwapMiB` and the older `swapMiB`) from the settings file with a pure-bash grep
# (no jq dependency). Fail-soft is deliberate: a parse miss returns empty so the
# swap advisory NEVER fires on a guess, only on a value we definitely read. The
# raw value is overridable for tests via _DD_SWAP_BYTES.
_docker_vm_swap_bytes() {
  if [[ -n "${_DD_SWAP_BYTES:-}" ]]; then
    [[ "${_DD_SWAP_BYTES}" =~ ^[0-9]+$ ]] && printf '%s' "${_DD_SWAP_BYTES}"
    return 0
  fi
  local f mib
  f="$(_docker_desktop_settings_file)"
  [[ -n "$f" ]] || return 0
  # `|| true` keeps a no-match (grep exits 1) from tripping `set -e` inside the
  # assignment under pipefail; the regex guard below handles the empty result.
  mib="$(grep -iEo '"swapmib"[[:space:]]*:[[:space:]]*[0-9]+' "$f" 2>/dev/null \
           | grep -Eo '[0-9]+' | tail -1 || true)"
  [[ "$mib" =~ ^[0-9]+$ ]] || return 0
  # 10# forces base-10: a leading-zero value (a hand-edited "08"/"09") passes the
  # digit guard but is invalid octal, which under set -e aborts the arithmetic and
  # leaks an error to the user; "0001024" would silently misread as octal. Same
  # guard _mem_to_bytes uses. Fail-soft stays intact.
  printf '%s' "$(( 10#$mib * 1048576 ))"
}

# The Docker Desktop VM's CONFIGURED memory slider in whole GB, empty when it
# can't be read. `docker info` reports the guest kernel's MemTotal, which sits a
# few hundred MB to over a GiB UNDER the slider (the kernel reserves memory at
# boot and the reserve GROWS with VM size), so on a large VM round-to-nearest
# can't recover the slider: a 24 GB slider reads ~23.4 GiB and rounds to 23, and
# MemTotal alone can't even tell a 23 GB slider from a 24 GB one once the reserve
# is ~0.6 GiB. The true value lives only in Docker Desktop's settings: MemoryMiB
# (newer, PascalCase) or memoryMiB (older, camelCase). Docker Desktop labels
# these GiB as "GB", which is exactly what we print. Fail-soft: a parse miss
# returns empty so the caller falls back to MemTotal rounding (Linux, no Docker
# Desktop, a moved path). Rounds MiB -> GB through `_vm_gb_rounded` (the same
# round-to-nearest the fallback uses), so a non-1024-aligned MemoryMiB (a
# hand-edited or non-standard-default value) reports the slider the user set
# (7936 -> 8) instead of truncating it (7) and re-tripping the undersized nag.
# Whole-GB sliders stay exact (24576 -> 24). Overridable for tests via _DD_MEMORY_MIB.
_docker_vm_configured_gb() {
  if [[ -n "${_DD_MEMORY_MIB:-}" ]]; then
    # 10# forces base-10 (a hand-edited leading-zero value is invalid octal and
    # would abort the arithmetic under set -e), same guard the swap reader uses.
    [[ "${_DD_MEMORY_MIB}" =~ ^[0-9]+$ ]] && _vm_gb_rounded "$(( 10#${_DD_MEMORY_MIB} * 1048576 ))"
    return 0
  fi
  local f mib
  f="$(_docker_desktop_settings_file)"
  [[ -n "$f" ]] || return 0
  # `|| true` keeps a no-match (grep exits 1) from tripping `set -e` under
  # pipefail; the regex guard below handles the empty result. The leading-quote
  # anchor ("memorymib") never matches SwapMiB / DiskSizeMiB / *ReservationMiB.
  mib="$(grep -iEo '"memorymib"[[:space:]]*:[[:space:]]*[0-9]+' "$f" 2>/dev/null \
           | grep -Eo '[0-9]+' | tail -1 || true)"
  [[ "$mib" =~ ^[0-9]+$ ]] || return 0
  _vm_gb_rounded "$(( 10#$mib * 1048576 ))"
}

# The VM size to DISPLAY and to THRESHOLD against, in whole GB. Prefer the
# configured Docker Desktop slider (exact); fall back to rounding the kernel's
# MemTotal when the settings can't be read. Display AND every threshold must
# call THIS one helper so a "shows 24 GB but warns it's too small" contradiction
# is impossible by construction. Arg: $1 = MemTotal bytes (for the fallback).
_docker_vm_display_gb() {
  local cfg
  cfg="$(_docker_vm_configured_gb)"
  if [[ "$cfg" =~ ^[0-9]+$ ]] && (( cfg > 0 )); then
    printf '%s' "$cfg"
    return 0
  fi
  _vm_gb_rounded "${1:-0}"
}

# Total physical RAM of the HOST machine in BYTES, empty when unknown. Used to
# judge whether the Docker Desktop VM is sized sensibly *relative to the host*
# (concept/22: a VM of ~half the host RAM). macOS: `sysctl hw.memsize` (already
# bytes). Linux: read MemTotal (kB) from /proc/meminfo and scale in bash, NOT
# `awk '{print $2 * 1024}'`, which makes awk do float math and print scientific
# notation (e.g. `3.36e+10`) for real RAM sizes, failing the `^[0-9]+$` check
# every consumer uses (→ host RAM silently treated as unknown on Linux). The
# meminfo path is overridable for tests. Empty on any failure → callers fall
# back to the absolute floor.
_host_total_memory() {
  if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
    sysctl -n hw.memsize 2>/dev/null || true
  elif [[ -r "${_MEMINFO_FILE:-/proc/meminfo}" ]]; then
    local kb
    kb="$(awk '/^MemTotal:/ { print $2; exit }' "${_MEMINFO_FILE:-/proc/meminfo}" 2>/dev/null)"
    # Explicit if, not a tail `[[ ]] && echo`: a garbled MemTotal would make
    # that list rc 1, and a function ending on rc 1 kills the strict-mode
    # binary at the caller (the kit-writer class of bug).
    if [[ "$kb" =~ ^[0-9]+$ ]]; then
      echo $(( kb * 1024 ))
    fi
  fi
}

# Default per-box memory: a quarter of the Docker VM's memory, clamped to
# [4g, 8g]. A cgroup limit is a ceiling, not a reservation: a box only uses
# what it touches, so a bigger floor only bites when several boxes spike at
# once, which the on-start overload notice and undersized-VM advisory already
# warn about. The 2g floor that shipped in v0.16.0 was too tight for a single
# 1M-context Opus session: at 60% (the NODE_OPTIONS heap pin) that's a ~1.2g
# heap, which GC-thrashes and OOM-kills under a build/test. 4g lifts that to
# ~2.4g. Still far under the old fixed 8g that exceeded entire default VMs.
# Unknown VM size falls back to 2g: we can't gauge overcommit risk on a VM we
# can't size, so we stay conservative there rather than commit to the 4g floor.
_default_box_memory() {
  local vm_bytes
  vm_bytes="$(_docker_vm_memory)"
  if ! [[ "$vm_bytes" =~ ^[0-9]+$ ]] || (( vm_bytes == 0 )); then
    echo "2g"
    return
  fi
  local quarter_gb=$(( vm_bytes / 4 / 1073741824 ))
  if (( quarter_gb < 4 )); then
    echo "4g"
  elif (( quarter_gb > 8 )); then
    echo "8g"
  else
    echo "${quarter_gb}g"
  fi
}

# Resolve the per-box memory limit: project box config ([resources] memory in
# .cleat.<box>, else .cleat) > global config > VM-derived default. Invalid
# values fall through to the next source (a typo must not abort `docker run`
# with an opaque daemon error). PROJECT-supplied values are clamped to 8g,
# .cleat ships with the repo, and an untrusted project must not be able to
# re-introduce VM-wide overcommit; the user's own global config is not capped.
resolve_box_memory() {
  local project="$1" box="${2:-main}"
  local v

  v="$(_read_resource_from_file "$(_project_caps_file "$project" "$box")" memory)"
  if [[ -n "$v" ]]; then
    if _valid_memory_value "$v"; then
      if (( $(_mem_to_bytes "$v") > 8589934592 )); then
        echo "8g"
      else
        echo "$v"
      fi
      return 0
    fi
    warn "Ignoring invalid memory '$v' in project config ${DIM}(use e.g. 2g, 4096m)${RESET}" >&2
  fi

  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" memory)"
  if [[ -n "$v" ]]; then
    if _valid_memory_value "$v"; then
      echo "$v"
      return 0
    fi
    warn "Ignoring invalid memory '$v' in global config ${DIM}(use e.g. 2g, 4096m)${RESET}" >&2
  fi

  _default_box_memory
}

# A docker --cpus value: positive decimal (2, 1.5, 0.5). Length-capped so the
# clamp arithmetic below can't overflow; zero is rejected (docker reads 0 as
# "no limit", not a limit).
_valid_cpus_value() {
  [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  [[ ${#1} -le 7 ]] || return 1
  local digits="${1//./}"
  (( 10#$digits > 0 ))
}

# The daemon's core count (empty when unknown). Seam for tests + the clamp.
_daemon_ncpu() {
  docker info --format '{{.NCPU}}' 2>/dev/null || true
}

# Resolve the per-box CPU limit: project box config > global config > NO
# default. Memory gets a default ceiling because memory is held, not shared;
# CPU is work-conserving: an idle core costs nothing and the scheduler
# already balances competing boxes, so an unconfigured box keeps all cores.
# PROJECT-supplied values are clamped to the daemon's core count: --cpus
# above NCPU is a dockerd error, so an untrusted .cleat could otherwise abort
# `docker run` outright. The user's own global config is passed through
# (dockerd validates it against the actual machine).
resolve_box_cpus() {
  local project="$1" box="${2:-main}"
  local v ncpu

  v="$(_read_resource_from_file "$(_project_caps_file "$project" "$box")" cpus)"
  if [[ -n "$v" ]]; then
    if _valid_cpus_value "$v"; then
      ncpu="$(_daemon_ncpu)"
      if [[ "$ncpu" =~ ^[0-9]+$ ]] && (( ncpu > 0 )) && \
         awk -v v="$v" -v n="$ncpu" 'BEGIN { exit !(v > n) }'; then
        echo "$ncpu"
      else
        echo "$v"
      fi
      return 0
    fi
    warn "Ignoring invalid cpus '$v' in project config ${DIM}(use e.g. 2, 1.5)${RESET}" >&2
  fi

  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" cpus)"
  if [[ -n "$v" ]]; then
    if _valid_cpus_value "$v"; then
      echo "$v"
      return 0
    fi
    warn "Ignoring invalid cpus '$v' in global config ${DIM}(use e.g. 2, 1.5)${RESET}" >&2
  fi
}

# ── Configured resources, for the config fingerprint ONLY ────────────────────
# The fingerprint must reflect what the USER declared in config, never a value
# the CLI derives at runtime. resolve_box_memory falls back to a VM-derived
# default (_default_box_memory) and resolve_box_cpus clamps to the daemon's core
# count, so both MOVE when the Docker VM is resized or the CLI's own default
# formula changes between versions, even though the user touched nothing. Folding
# those into the fingerprint quietly reintroduced the very version/VM coupling the
# VERSION exclusion was meant to kill: a CLI upgrade or a memory-slider change
# would shift the hash and fire a false "config changed, recreate?" on an
# untouched box. These variants read config files ONLY (project box > project >
# global) and emit nothing when unset, so an unconfigured box hashes the same
# regardless of VM size or CLI version. Values are validated but NOT warned about
# here (the real resolvers warn during the actual run); an invalid value is
# ignored so a typo can't change the fingerprint either.
_configured_box_memory() {
  local project="$1" box="${2:-main}" v
  v="$(_read_resource_from_file "$(_project_caps_file "$project" "$box")" memory)"
  if [[ -n "$v" ]] && _valid_memory_value "$v"; then
    # Mirror resolve_box_memory's project clamp so the fingerprint matches the
    # ceiling the container would actually get (deterministic, not VM-dependent).
    if (( $(_mem_to_bytes "$v") > 8589934592 )); then echo "8g"; else echo "$v"; fi
    return 0
  fi
  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" memory)"
  if [[ -n "$v" ]] && _valid_memory_value "$v"; then
    echo "$v"
    return 0
  fi
  return 0
}

_configured_box_cpus() {
  local project="$1" box="${2:-main}" v
  v="$(_read_resource_from_file "$(_project_caps_file "$project" "$box")" cpus)"
  if [[ -n "$v" ]] && _valid_cpus_value "$v"; then
    echo "$v"
    return 0
  fi
  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" cpus)"
  if [[ -n "$v" ]] && _valid_cpus_value "$v"; then
    echo "$v"
    return 0
  fi
  return 0
}

# ── Box descriptions (host-side metadata) ────────────────────────────────────
# An optional one-line human description per box, keyed by container name so it
# survives stop/resume/recreate and is removed with the box. Text is always
# written with printf and printed as data, never eval'd. See
# concept/20-boxes.md for why this is a host-side file, not a Docker label.
_box_desc_file() {
  echo "$CLEAT_BOXES_DIR/$1"
}

_box_desc_read() {
  local f
  f="$(_box_desc_file "$1")"
  [[ -f "$f" ]] && cat "$f" || true
}

_box_desc_write() {
  local cname="$1" text="$2"
  # Collapse CR/LF so a description is always a single line (it renders as a
  # one-line sub-entry in status/ps; see concept/20-boxes.md).
  text="$(printf '%s' "$text" | tr '\r\n' '  ')"
  mkdir -p "$CLEAT_BOXES_DIR"
  printf '%s\n' "$text" > "$(_box_desc_file "$cname")"
}

_box_desc_remove() {
  rm -f "$(_box_desc_file "$1")" 2>/dev/null || true
}

# ── Kits ─────────────────────────────────────────────────────────────────────
#
# A kit is a maintainer-curated Claude Code pre-configuration (a CLAUDE.md
# policy fragment + custom subagents) enabled per box: `cleat kit <name>`.
# Inside the box, three read-only masks over the shared ~/.claude mount
# replace what Claude sees at ~/.claude/CLAUDE.md, ~/.claude/agents, and
# ~/.claude/commands with content generated host-side in
# $CLEAT_RUN_DIR/<cname>/kit/ on every create/start: the user's own config
# first, the kit merged on top (commands is always a plain pass-through copy;
# kits ship no commands). The kit content is never written to the host
# ~/.claude; native claude never sees the kit. Kits ship instructions and
# subagents only: no hooks, no settings, nothing that executes as a program.
# Full design: concept/34-kits.md.

_box_kit_file() {
  echo "$CLEAT_KITS_DIR/$1"
}

_box_kit_read() {
  local f
  f="$(_box_kit_file "$1")"
  [[ -f "$f" ]] && cat "$f" || true
}

_box_kit_write() {
  local cname="$1" kit="$2"
  mkdir -p "$CLEAT_KITS_DIR"
  printf '%s\n' "$kit" > "$(_box_kit_file "$cname")"
}

_box_kit_remove() {
  rm -f "$(_box_kit_file "$1")" 2>/dev/null || true
}

_kit_known() {
  local k
  for k in "${KNOWN_KITS[@]}"; do
    [[ "$k" == "$1" ]] && return 0
  done
  return 1
}

# Effective model for a kit agent role. Users can pin or swap the models kits
# use via a [kits] section in the GLOBAL config (trusted, user-authored):
#   [kits]
#   worker_model = claude-sonnet-5
#   scout_model  = haiku
# Read at every overlay generation, so a change lands next session with no
# recreate. Global-only by design: the value is written into agent YAML
# frontmatter, so it must never come from a project's untrusted .cleat.
# Values are sanitized to a bare model token (letters, digits, dot, dash,
# underscore); anything else falls back to the default alias, fail-safe
# (this is the frontmatter-injection guard, do not widen it). The planner has
# no knob: it is the session's main-loop model by definition.
_kit_agent_model() {
  local role="$1" default="$2" v
  v="$(_read_section_from_file "$CLEAT_GLOBAL_CONFIG" kits "${role}_model")"
  if [[ -n "$v" && "$v" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "$v"
  else
    echo "$default"
  fi
}

# In-box operational notes composed into EVERY box's ~/.claude/CLAUDE.md
# (vanilla and kitted) by _generate_kit_overlay. The same text is baked into
# the image at this path (docker/CLAUDE.md) since v0.1.0, but a bake below a
# bind mount is invisible: the host ~/.claude dir mount (and now the mask)
# always shadowed it, so no box ever saw these rules until the overlay
# started carrying them. MUST stay byte-identical to docker/CLAUDE.md (a
# guard test enforces it): the bake still covers any box without the mask.
_box_notes_claude_md() {
  cat << 'BOX_NOTES_EOF'
# Clipboard

This environment runs inside Docker with clipboard bridge forwarding.
`xclip`, `pbcopy`, `xsel`, and `clip` all work for COPYING text to the host clipboard.
The primary mechanism writes to a shared file that the host picks up automatically.
OSC 52 terminal escape sequences are used as a fallback when the bridge is unavailable.
Paste/read-back (`xclip -o`, `xsel -o`, `pbpaste`) is not supported. Do NOT try to verify clipboard contents after copying.
The copy succeeded if the command exits 0. Do not run a second command to check.
BOX_NOTES_EOF
}

# Stage-0 "concierge" provisioning notes, composed into EVERY box's
# ~/.claude/CLAUDE.md (vanilla and kitted) by _generate_kit_overlay, right
# after the box notes. Unlike _box_notes_claude_md, this fragment is
# CLI-generated only: it is deliberately not baked into docker/CLAUDE.md,
# which must stay byte-identical to _box_notes_claude_md per the guard test.
_provisioning_notes_claude_md() {
  cat << 'PROVISIONING_NOTES_EOF'
# Installing tools

You are inside a Cleat box (a Docker container). `sudo apt-get install <pkg>` works
(passwordless sudo) and installs persist across `cleat stop`/`cleat start`. They do
NOT survive a container recreate (config changes, image updates, `cleat rm`).
For tools this project always needs, add a `[setup]` section to the project's
`.cleat` file. Its lines are shell commands that run automatically once per
container, as the `coder` user inside the box, after every create or recreate.
The user reviews and approves them once; editing the section triggers a fresh
review, never a container recreate.

[setup]
sudo apt-get update
sudo apt-get install -y <pkg>

A line `script ./provision.sh` inlines that repo file's contents at that position.
Never suggest forking Cleat, editing its Dockerfile, or `cleat rebuild` to add
tools; `[setup]` is the supported path. There is no egress allowlist: the box has
full network access.
PROVISIONING_NOTES_EOF
}

# One-paragraph description for the library listing and the confirm screen.
# Deliberately mechanical claims only: planning runs on your session's model,
# execution bills at worker rates. Never add outcome/quality percentages here;
# the cookbook's benchmark numbers belong to its API harness, not this
# adaptation (concept/34).
_kit_description() {
  case "$1" in
    plan-big-execute-small)
      echo "Run your session on Fable 5: it plans and reviews while worker and scout subagents (Sonnet 5 by default) execute and explore, each in its own context window so the main session stays lean. Flagship judgment on the plan and every review, the mechanical bulk billed at the worker model's rate, so heavy work burns your rate limit far slower. Adapted from Anthropic's coordinator-pattern cookbook."
      ;;
  esac
}

# Post-enable nudge, per kit. The flagship pairing names Fable 5 as the
# planner, but the kit never touches the session model (concept/34): the
# user's knob is /model inside the session, so name it at the moment they
# are about to start one. Claude Code saves /model as the default for new
# sessions, so this is a one-time step, not a ritual.
# One dim provenance line for the confirm screen. The full URL is long, so
# it lives in `cleat kit show`; this line says where the pattern comes from
# and where to read it. Same claim discipline as _kit_description.
_kit_reference_line() {
  case "$1" in
    plan-big-execute-small)
      echo -e "  ${DIM}Pattern from Anthropic's cookbook: big models for planning,${RESET}"
      echo -e "  ${DIM}small models for execution. Link: cleat kit show $1${RESET}"
      ;;
  esac
}

_kit_post_enable_hint() {
  case "$1" in
    plan-big-execute-small)
      echo -e "    ${DIM}The planner is your session's model: pick Fable 5 with ${RESET}${BOLD}/model${RESET}${DIM} in-session (it sticks for new sessions).${RESET}"
      ;;
  esac
}

# The confirm screen's "what this kit adds" lines. Models shown are the
# EFFECTIVE ones (after [kits] overrides), so the screen never lies.
_kit_confirm_lines() {
  case "$1" in
    plan-big-execute-small)
      local _w _s
      _w="$(_kit_agent_model worker sonnet)"
      _s="$(_kit_agent_model scout sonnet)"
      echo -e "    ${DIM}agents${RESET}     worker (model: ${_w}), scout (model: ${_s}, read-only by contract)"
      echo -e "    ${DIM}CLAUDE.md${RESET}  a delegation policy section (appended, yours stays)"
      echo -e "    ${DIM}planner${RESET}    your session's model, not changed by the kit"
      ;;
  esac
}

# Emit a kit's files into <destdir>: CLAUDE.md (the policy fragment appended
# under the marked header by _generate_kit_overlay) and agents/kit-*.md. The
# heredocs here are the kit: `cleat kit show` prints from this function, and
# kits update in lockstep with CLI releases. Kit content deliberately makes no
# performance-number claims: the cookbook's benchmarks belong to its API
# harness, not this prompt-level adaptation (concept/34).
# The `name:` a Claude Code agent declares in its YAML frontmatter (this is
# what Claude dispatches by, NOT the filename). Prints empty when absent.
_agent_name() {
  local f="$1" line
  line="$(grep -m1 '^name:' "$f" 2>/dev/null)" || true
  line="${line#name:}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s' "$line"
}

_kit_emit() {
  local kit="$1" dest="$2"
  mkdir -p "$dest/agents"
  case "$kit" in
    plan-big-execute-small)
      cat > "$dest/CLAUDE.md" << 'KIT_EOF'
You are the planner in a plan-big / execute-small team.

- For any task with real mechanical editing (multi-file, or a sizable
  change within one file): write the plan first, then dispatch each
  self-contained chunk to the `worker` agent, one at a time. Dispatch,
  review, then dispatch the next. Never launch several workers in one
  message; parallel dispatch has scrambled briefs and clobbered files.
  A dispatch names the files, the exact change, the constraints, and
  the test to run; the worker executes, it does not re-derive context.
  Prefer fewer, larger chunks; every dispatch pays a fixed overhead.
- Review every worker result before dispatching the next dependent chunk.
  If a result is wrong or incomplete, dispatch a corrected chunk instead
  of fixing it yourself. If a dispatch fails with an error instead of a
  report, re-dispatch the same chunk unchanged; never absorb its work
  into the main loop. You own integration and the final review.
- Use the `scout` agent for all code exploration (call sites, structure,
  impact, the research behind a plan); never search in the main loop.
  Plan from scout's findings, not from memory: when a premise decides
  the plan's shape (a call-site list, an assumed behavior), have scout
  verify it before you dispatch workers.
  When the judgment is in the raw code itself (a subtle bug, a delicate
  refactor), have scout locate it, then read the located code yourself.
- `worker` and `scout` are the only subagents you dispatch. Built-in
  agents (Explore, Plan, general-purpose) run on expensive models; do
  not substitute them. If worker or scout is missing, tell the user the
  kit is broken instead of quietly working around it.
- The same routing applies inside workflows: pass agentType: 'scout' on
  exploration stages and agentType: 'worker' on implementation stages.
  An agent() call with no agentType runs on the expensive session model.
- Keep the main loop for: planning, judgment calls, reviewing diffs,
  integration, and talking to the user.
- Do not delegate trivial edits, even multi-file ones; just make them.
KIT_EOF
      # Frontmatter via an UNQUOTED heredoc so the effective (possibly
      # [kits]-overridden) model lands in it; bodies stay quoted. The model
      # value is sanitized by _kit_agent_model, never raw config text.
      # Frontmatter is strict YAML: an unquoted value (description) must
      # never contain colon-space or end in a colon, on any wrapped line.
      # Claude Code silently drops an agent whose frontmatter fails to
      # parse (the v1.2.0 scout bug: "all exploration: finding").
      local _worker_model _scout_model
      _worker_model="$(_kit_agent_model worker sonnet)"
      _scout_model="$(_kit_agent_model scout sonnet)"
      cat > "$dest/agents/kit-worker.md" << KIT_FM
---
name: worker
description: Implementation executor. Dispatch one precise, self-contained
  task with full context. It executes exactly that and reports back.
tools: Read, Edit, Write, Grep, Glob, Bash
model: ${_worker_model}
---
KIT_FM
      cat >> "$dest/agents/kit-worker.md" << 'KIT_EOF'

You execute exactly the task you are given, nothing more.

- Implement precisely what the dispatch describes. Do not expand scope,
  refactor adjacent code, or re-plan the approach.
- If the task is ambiguous or turns out to be impossible as specified,
  stop and report the blocker instead of improvising.
- Match the surrounding code style. Run the narrowest relevant test if
  one is named in the dispatch.
- Open the report with a status: done as dispatched, done with
  deviations (name them), partial (what remains), or blocked (why).
- Report back: what changed (files and line ranges), the diff when it
  is short (for a large change, per-file line ranges and one line per
  change; the planner reviews with git diff), test results distilled
  to pass or fail plus the failing cases, and anything the planner
  must know. Never paste full logs or files you only read.
KIT_EOF
      cat > "$dest/agents/kit-scout.md" << KIT_FM
---
name: scout
description: Read-only codebase scout. Use for all exploration. It finds
  call sites, maps structure, locates definitions, and sizes a change.
tools: Read, Grep, Glob, Bash
model: ${_scout_model}
---
KIT_FM
      cat >> "$dest/agents/kit-scout.md" << 'KIT_EOF'

You explore and report. You never modify anything.

- Answer the specific question asked: locations (file:line), shapes,
  call sites, blast radius.
- Read only what the question needs. Prefer excerpts over whole files.
- Bash is for read-only inspection (ls, git log, git grep) only.
- Report findings compactly: paths, line numbers, one-line conclusions.
- If you find nothing, say so: what you searched and what remains
  unknown. Never guess.
KIT_EOF
      ;;
  esac
}

# Does this container mount the kit overlay? Boxes created before the kit
# feature do not (bind mounts are baked at create); they gain the mounts on
# their next natural recreate, or explicitly via `cleat kit` which offers the
# rebuild. Unreadable inspect degrades to "no mounts", the safe answer for
# both callers (skip the regen / route the enable through the rebuild offer).
# DELIBERATELY keyed on CLAUDE.md alone, never on the full mask set: a box
# created before a LATER mask (skills, plugins) still has a live overlay that
# must keep tracking the user's content. Tightening this to "has every mask"
# would freeze those boxes' CLAUDE.md/agents/commands at whatever they last
# held. The missing-mask signal is _maybe_note_missing_kit_masks, not this.
_container_has_kit_mounts() {
  local dests
  dests="$(docker inspect "$1" --format '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null)" || return 1
  printf '%s\n' "$dests" | grep -qx '/home/coder/.claude/CLAUDE.md'
}

# Boxes created before the read-only ~/.claude masks existed (or before the
# skills and plugins masks landed) keep those host-level surfaces writable
# until recreated: bind mounts are baked at create, and the config fingerprint
# deliberately excludes mounts. Say so on every start until fixed, the same
# always-on treatment as the undersized-VM advisory: a silent protection gap
# is worse than a repeated note. Unreadable inspect stays silent, matching
# _container_has_kit_mounts (the box may be mid-recreate).
_maybe_note_missing_kit_masks() {
  local cname="$1"
  container_exists "$cname" || return 0
  local dests d
  dests="$(docker inspect "$cname" --format '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null)" || return 0
  for d in /home/coder/.claude/CLAUDE.md /home/coder/.claude/agents \
           /home/coder/.claude/commands /home/coder/.claude/skills \
           /home/coder/.claude/plugins; do
    if ! printf '%s\n' "$dests" | grep -qx "$d"; then
      info "This box predates the read-only ~/.claude masks. Recreate to enable them: ${BOLD}cleat rm && cleat${RESET}"
      return 0
    fi
  done
}

# VirtioFS rejects nested mounts whose target is missing inside the parent
# bind source; ensure every mask target exists on the host (inert for native
# claude: an empty CLAUDE.md and empty agents/commands/skills/plugins dirs are
# nothing to it). Modern Docker Desktop auto-creates a missing DIRECTORY
# target, but as root, which would leave an unwritable dir in the user's home
# on rootful Linux; creating them here keeps them owned by the user.
# A broken symlink at any target, or a regular file where a directory belongs,
# would make the touch/mkdir fail with a raw trace under strict mode (and if it
# reached Docker, an opaque rc=125 "not a directory" OCI error); refuse both
# with a clear remedy instead. We never delete a user's symlink, even a
# dangling one: it may point into a dotfiles repo not checked out yet.
_ensure_kit_mask_targets() {
  local _t
  for _t in "${HOME}/.claude/CLAUDE.md" "${HOME}/.claude/agents" \
            "${HOME}/.claude/commands" "${HOME}/.claude/skills" \
            "${HOME}/.claude/plugins"; do
    if [[ -L "$_t" && ! -e "$_t" ]]; then
      error "${_t/#${HOME}/~} is a broken symlink. Fix or remove it, then rerun."
      return 1
    fi
  done
  # The four dir targets must not be regular files. CLAUDE.md is excluded: it
  # is the one target that is supposed to be a file.
  for _t in "${HOME}/.claude/agents" "${HOME}/.claude/commands" \
            "${HOME}/.claude/skills" "${HOME}/.claude/plugins"; do
    if [[ -e "$_t" && ! -d "$_t" ]]; then
      error "${_t/#${HOME}/~} is not a directory. Move or remove it, then rerun."
      return 1
    fi
  done
  touch "${HOME}/.claude/CLAUDE.md"
  mkdir -p "${HOME}/.claude/agents" "${HOME}/.claude/commands" \
           "${HOME}/.claude/skills" "${HOME}/.claude/plugins"
  # Containment targets. Same VirtioFS rule: the nested mount's target must
  # exist inside the parent bind source. These are only mountpoints, and the
  # host content behind them is never mounted into the box.
  local _p
  for _p in $_CLAUDE_PRIVATE_DIRS; do
    [[ -L "${HOME}/.claude/$_p" && ! -e "${HOME}/.claude/$_p" ]] && continue
    mkdir -p "${HOME}/.claude/$_p" 2>/dev/null || true
  done
}

# (Re)generate the kit overlay content for a box: the three surfaces masked
# over ~/.claude inside the container. Called at create (cmd_run) and refreshed on
# every start/resume, mirroring the settings overlay. Merge semantics
# (concept/34): the user's real global CLAUDE.md comes FIRST byte-for-byte
# with the kit fragment appended under a marked header; the agents dir is a
# copy of the user's agents plus the kit's kit-*.md files (a same-named user
# file wins). Vanilla boxes (no kit) get a plain pass-through copy, so the
# mount shape is uniform and a kit change is never a recreate.
_generate_kit_overlay() {
  local cname="$1"
  local kit_dir="$CLEAT_RUN_DIR/${cname}/kit"
  local kit
  kit="$(_box_kit_read "$cname")"
  # An unknown selection (hand-edited file, or written by a different CLI
  # version) degrades to vanilla rather than failing the start.
  if [[ -n "$kit" ]] && ! _kit_known "$kit"; then
    kit=""
  fi

  # Self-heal wrong types from manual tampering: a directory where the file
  # goes (or vice versa) would fail the writes below under strict mode. -L is
  # in the dir checks on purpose: a SYMLINK at an overlay dir path is not
  # caught by -f, and the clear loop below would then delete files in the
  # link's target directory instead of in the overlay.
  [[ -d "$kit_dir/CLAUDE.md" ]] && rm -rf "$kit_dir/CLAUDE.md"
  [[ -L "$kit_dir/agents" || -f "$kit_dir/agents" ]] && rm -f "$kit_dir/agents"
  [[ -L "$kit_dir/commands" || -f "$kit_dir/commands" ]] && rm -f "$kit_dir/commands"
  [[ -L "$kit_dir/skills" || -f "$kit_dir/skills" ]] && rm -f "$kit_dir/skills"
  mkdir -p "$kit_dir/agents" "$kit_dir/commands" "$kit_dir/skills"

  # Rewrite IN PLACE (truncate the file, clear inside the dir; never rm the
  # sources themselves): all are bind-mounted, and a running container keeps
  # the original inodes, so in-place rewrites are what make a kit change
  # visible to the box's next session without a container restart.
  local _f
  # -e alone misses dangling symlinks (a symlinked host command whose target
  # moved), which would then linger in the overlay across every future regen;
  # -L catches them regardless of target state.
  for _f in "$kit_dir/agents"/*; do
    [[ -e "$_f" || -L "$_f" ]] || continue
    rm -rf "$_f"
  done
  for _f in "$kit_dir/commands"/* "$kit_dir/commands"/.[!.]*; do
    [[ -e "$_f" || -L "$_f" ]] || continue
    rm -rf "$_f"
  done
  # skills/: same both-globs shape as commands (skill bundles carry dotfiles,
  # and a hidden skill dir is a real shape). The rm is made NON-FATAL here and
  # the copy below normalizes modes: a skill dir can arrive from unzip, a git
  # archive or a marketplace install at 0500, which copies through as 0500 and
  # makes the NEXT regen's rm die EPERM. Under strict mode that raw
  # "Permission denied" would take the whole `cleat start` down.
  for _f in "$kit_dir/skills"/* "$kit_dir/skills"/.[!.]*; do
    [[ -e "$_f" || -L "$_f" ]] || continue
    rm -rf "$_f" 2>/dev/null || true
  done

  # CLAUDE.md: the user's real global memory first, byte-for-byte.
  if [[ -f "${HOME}/.claude/CLAUDE.md" ]]; then
    cat "${HOME}/.claude/CLAUDE.md" > "$kit_dir/CLAUDE.md"
  else
    : > "$kit_dir/CLAUDE.md"
  fi

  # Box notes second, under a marked header: operational guidance every box
  # needs (the clipboard-bridge rules). This is the only path that actually
  # reaches the box; see _box_notes_claude_md for why the image bake never
  # did. A kit section, if any, follows below.
  {
    echo ""
    echo "# ── Cleat box notes ──"
    echo ""
    _box_notes_claude_md
  } >> "$kit_dir/CLAUDE.md"

  # Provisioning notes third, under its own marked header: the stage-0
  # concierge guidance ([setup] section, apt-get persistence). CLI-generated
  # only, same reasoning as the box notes above; see _provisioning_notes_claude_md.
  {
    echo ""
    echo "# ── Cleat box provisioning ──"
    echo ""
    _provisioning_notes_claude_md
  } >> "$kit_dir/CLAUDE.md"

  # agents/: the user's own agents, as-is.
  if [[ -d "${HOME}/.claude/agents" ]]; then
    for _f in "${HOME}/.claude/agents"/*; do
      [[ -f "$_f" ]] || continue
      cp "$_f" "$kit_dir/agents/" 2>/dev/null || true
    done
  fi

  # commands/: a read-only PASS-THROUGH of the user's own slash commands
  # (recursive, so namespaced subdirs survive). Kits add no commands, so this
  # is a plain copy. Its purpose is the :ro mask: with it, a caged agent can
  # read the user's commands but cannot plant a NEW host-user-level command
  # that native host claude would run on invocation, closing the third
  # instruction surface after CLAUDE.md and agents. Project-level
  # /workspace/.claude/commands is unaffected (still writable in the repo).
  # -L dereferences: dotfile-repo users symlink their commands, and a copied
  # symlink would point at a host path that does not exist inside the box. A
  # dangling source link makes cp error on that entry and continue; the
  # swallow-and-continue matches the agents copy above.
  if [[ -d "${HOME}/.claude/commands" ]]; then
    cp -RL "${HOME}/.claude/commands/." "$kit_dir/commands/" 2>/dev/null || true
  fi

  # skills/: a read-only PASS-THROUGH of the user's own skills. Same purpose
  # as commands above, one degree stronger: ~/.claude/skills is an AUTO-LOAD
  # plugin source (Claude Code registers what it finds there as
  # <name>@skills-dir), so a planted skill needs no user action at all to be
  # discovered and invoked, and a skill root can carry hooks/, bin/ and
  # .mcp.json, not only a SKILL.md. Copied entry by entry ON PURPOSE, and the
  # recursive step drops -L: the TOP-LEVEL entry is still dereferenced
  # (dotfile-repo users symlink a whole skill dir, and a copied link would be
  # dead inside the box) while a symlink NESTED inside a skill is copied as a
  # symlink. A blanket cp -RL would dereference `myskill/keys -> ~/.ssh` and
  # materialize real host secrets inside the cage, the one thing the cage
  # exists to prevent. A nested link that points outside simply dangles in the
  # box.
  if [[ -d "${HOME}/.claude/skills" ]]; then
    local _sk _skb
    for _sk in "${HOME}/.claude/skills"/* "${HOME}/.claude/skills"/.[!.]*; do
      [[ -e "$_sk" ]] || continue
      _skb="${_sk##*/}"
      if [[ -d "$_sk" ]]; then
        mkdir -p "$kit_dir/skills/$_skb"
        cp -R "$_sk/." "$kit_dir/skills/$_skb/" 2>/dev/null || true
      else
        cp "$_sk" "$kit_dir/skills/$_skb" 2>/dev/null || true
      fi
    done
    # Normalize modes so the overlay is always owner-removable (see the clear
    # loop above). X, not x: only dirs and already-executable files get +x.
    chmod -R u+rwX "$kit_dir/skills" 2>/dev/null || true
  fi

  [[ -n "$kit" ]] || return 0

  # Collect the NAMES the user's agents declare (Claude dispatches by name,
  # not filename). A kit agent whose name a user agent already claims must be
  # skipped, or the box ends up with two agents named e.g. `worker` and the
  # kit's read-only guarantee dissolves into an ambiguous dispatch. "User
  # wins" is the documented contract; here it is enforced by name, not just
  # by the near-impossible filename collision.
  local _user_names=" " _n
  for _f in "$kit_dir/agents"/*; do
    [[ -f "$_f" ]] || continue
    _n="$(_agent_name "$_f")"
    [[ -n "$_n" ]] && _user_names="${_user_names}${_n} "
  done

  # Merge the kit on top: fragment appended under a marked header; agents
  # added without clobbering a same-FILENAME or same-NAME user agent (the
  # user wins; the collision is also warned about at enable time, where no
  # spinner owns the terminal).
  local stage="$kit_dir/.stage"
  rm -rf "$stage"
  _kit_emit "$kit" "$stage"
  {
    echo ""
    echo "# ── Cleat kit: $kit ──"
    echo ""
    cat "$stage/CLAUDE.md"
  } >> "$kit_dir/CLAUDE.md"
  local _base _kn
  for _f in "$stage/agents"/*; do
    [[ -f "$_f" ]] || continue
    _base="$(basename "$_f")"
    [[ -e "$kit_dir/agents/$_base" ]] && continue
    _kn="$(_agent_name "$_f")"
    [[ -n "$_kn" && "$_user_names" == *" $_kn "* ]] && continue
    cp "$_f" "$kit_dir/agents/$_base"
  done
  rm -rf "$stage"
}

# ── ~/.claude containment (concept/34 Follow-up 13) ─────────────────────────
#
# The base ~/.claude bind is read-write and carries auth, so everything not
# explicitly handled passes through to the HOST. That leaked far more than
# instructions. Measured on the maintainer's machine 2026-07-25: projects/ held
# 976 MB across 24 directories, one per project ever run under Claude Code, and
# file-history/ held 185 MB of versioned file snapshots with content from at
# least four unrelated projects. A caged agent could read all of it.
#
# Two different shapes are needed, and the distinction is the whole design:
#
#   * A :ro self-mask (what plugins uses) blocks WRITES but not READS. Measured:
#     with the host projects/ masked over itself :ro, a sibling project's
#     transcript was still fully readable. So :ro is useless against disclosure.
#   * A GENERATED replacement blocks both, because the host content is simply
#     never mounted. That is what these dirs get.
#
# Per-box private dirs: the box gets its own empty, writable copy. Nothing to
# read from other projects, nothing that outlives `cleat rm`. These hold
# cross-project data with no reason to be shared into a cage.
_CLAUDE_PRIVATE_DIRS="file-history paste-cache uploads backups shell-snapshots sessions tasks jobs"

# Build the per-box replacement content for the containment mounts. Same
# regeneration rail as the kit overlay (create/start/resume), so adding a
# session key is never a container recreate. Cheap: these are empty dirs, not
# copies, so there is no per-start IO proportional to the host's 1.1 GB.
_generate_home_overlay() {
  local cname="$1" project="$2" session_key="$3"
  local home_dir="$CLEAT_RUN_DIR/${cname}/home"
  local _d

  for _d in $_CLAUDE_PRIVATE_DIRS; do
    # Self-heal a wrong type (file or symlink where the dir goes), matching
    # _generate_kit_overlay. A symlink here would make the box write through
    # to whatever it points at.
    [[ -L "$home_dir/$_d" || -f "$home_dir/$_d" ]] && rm -f "$home_dir/$_d"
    mkdir -p "$home_dir/$_d"
  done

  # projects/: a generated parent holding ONLY this project's session keys as
  # empty mountpoints. Masked :ro so the agent cannot create a sibling key, with
  # the real session dir mounted read-write INSIDE it so --continue and --resume
  # keep working. Both keys are always created: '-workspace' is the normal CWD
  # encoding, and the host-path key is what Claude Code derives when the docker
  # cap moves the workdir (see the docker cap block). Creating the second
  # unconditionally costs an empty dir and keeps this independent of cap order.
  [[ -L "$home_dir/projects" || -f "$home_dir/projects" ]] && rm -f "$home_dir/projects"
  mkdir -p "$home_dir/projects/-workspace"
  mkdir -p "$home_dir/projects/${project//\//-}"
  # Drop stale keys from a previous project path so the box never sees a
  # mountpoint it no longer owns.
  local _k
  for _k in "$home_dir/projects"/*; do
    [[ -d "$_k" ]] || continue
    case "${_k##*/}" in
      -workspace|"${project//\//-}") ;;
      *) rmdir "$_k" 2>/dev/null || true ;;
    esac
  done
  : "$session_key"
}

# ── Forked workspaces (concept/31) ──────────────────────────────────────────
#
# A fork is not a new kind of thing: it is a BOX whose /workspace is its own
# copy of the project instead of the live tree. Everything else about the box
# (container name, session key, trust rows, caps, kits, description) still keys
# off the real project path, so nothing else in the CLI learns a new concept.
#
# A COPY, deliberately, not a git clone. A clone drags in the whole submodule /
# untracked-sibling / unpushed-SHA / git-identity problem class, and cannot
# serve a project with no git at all (the PoC A/B case). A copy just has the
# user's files: uncommitted work, untracked repos, gitignored build output.
# On APFS `cp -c` clones blocks copy-on-write, measured at 0.005s for 50 MB on
# the maintainer's machine, so "copy everything" is nearly free AND saves the
# caged agent an `npm install`.
_fork_dir() { printf '%s\n' "$CLEAT_FORKS_DIR/$1"; }

# Whether a box is a fork is recorded SEPARATELY from the copy itself, in the
# same per-box host state dir as the description. The copy's existence looks
# like a sufficient marker and is not: if the copy is deleted, a bind source
# vanishes, cmd_start recreates the box, and a marker-free cmd_run would
# silently re-mount the LIVE tree and print success. A box the user believes is
# caged to a disposable copy would then be editing the real repo. The marker
# makes that case REFUSE instead.
_fork_marker_file() { echo "$CLEAT_BOXES_DIR/$1.fork"; }
_box_is_fork()      { [[ -f "$(_fork_marker_file "$1")" ]]; }
_fork_mark()        { mkdir -p "$CLEAT_BOXES_DIR"; : > "$(_fork_marker_file "$1")"; }
_fork_unmark()      { rm -f "$(_fork_marker_file "$1")"; }

# Every value for a REPEATED key in a section, one per line. The existing
# _read_section_from_file returns the first match only, which is right for
# `memory = 8g` and wrong for `exclude = node_modules` repeated N times.
_read_section_all_from_file() {
  local file="$1" section="$2" key="$3"
  [[ -f "$file" ]] || return 0
  local in_section=false line k v
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "[$section]" ]] && in_section=true || in_section=false
      continue
    fi
    $in_section || continue
    [[ "$line" == *"="* ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    k="${k%"${k##*[![:space:]]}"}"
    v="${v#"${v%%[![:space:]]*}"}"
    v="${v%"${v##*[![:space:]]}"}"
    [[ "$k" == "$key" && -n "$v" ]] && printf '%s\n' "$v"
  done < "$file"
}

# cp flags, probed ONCE from the cp BINARY and never from `uname -s`. A macOS
# host with Homebrew coreutils on PATH has GNU cp under the plain name, and GNU
# cp rejects -c outright ("invalid option -- 'c'", exit 1, nothing copied), so
# an OS-keyed branch hard-fails the fork for exactly that profile. No pipeline
# in the probe: `cp --version | head -1` can hand cp a SIGPIPE, and pipefail
# then reports the pipeline failed even when the match succeeded.
_FORK_CP_PROBED=""
_FORK_CP_FLAGS=""
_fork_cp_flags() {
  if [[ -n "$_FORK_CP_PROBED" ]]; then printf '%s' "$_FORK_CP_FLAGS"; return 0; fi
  _FORK_CP_PROBED=1
  local _v _h _p
  _v="$(cp --version 2>/dev/null || true)"
  case "$_v" in
    *"GNU coreutils"*)
      _h="$(cp --help 2>/dev/null || true)"
      # --reflink=auto degrades silently to a byte copy on a non-CoW
      # filesystem. Never =always, which fails instead. -d keeps hardlinks
      # inside the tree shared, so a pnpm store does not multiply.
      case "$_h" in
        *--reflink*) _FORK_CP_FLAGS="-R -d --reflink=auto" ;;
        *)           _FORK_CP_FLAGS="-R -d" ;;
      esac
      ;;
    *)
      # BSD. -c clones each regular file and falls back internally on EXDEV or
      # ENOTSUP without changing the exit status, so no CoW retry is needed.
      # Probe acceptance of the flag rather than assuming it.
      _FORK_CP_FLAGS="-R"
      _p="$CLEAT_FORKS_DIR/.cpprobe.$$"
      rm -rf "$_p" 2>/dev/null || true
      if mkdir -p "$_p/s" "$_p/d" 2>/dev/null && : > "$_p/s/f" 2>/dev/null \
         && cp -Rc "$_p/s/." "$_p/d/" 2>/dev/null; then
        _FORK_CP_FLAGS="-Rc"
      fi
      rm -rf "$_p" 2>/dev/null || true
      ;;
  esac
  printf '%s' "$_FORK_CP_FLAGS"
}

# Recursive copy of a project tree into a fork workspace.
#
# Load-bearing, each measured:
#   * The source form is "$src/." into a freshly created "$dst/". `cp -R "$src"
#     "$dst"` looks equivalent and is not: when the PROJECT ROOT is itself a
#     symlink it copies the LINK, so the fork becomes an alias for the live
#     tree and the whole feature voids in silence. It also nests to
#     $dst/$(basename $src) whenever $dst survives, which a root-owned leftover
#     from the box's passwordless sudo can cause.
#   * Flags come from _fork_cp_flags, which probes the binary. See there.
#   * Plain -R copies symlinks AS symlinks on both BSD and GNU. That is the
#     security property: a project containing `sub/keys -> ~/.ssh` must NOT
#     have real key bytes materialised into the cage. Never add -L or -H.
#
# Copies into a temp dir inside CLEAT_FORKS_DIR and renames, so an interrupted
# copy never presents a half tree as a workspace, and takes a mkdir lock so two
# concurrent --fork runs cannot both rm -rf and copy into the same target.
_fork_copy_tree() {
  local src="$1" dst="$2" lock rc=0
  mkdir -p "$CLEAT_FORKS_DIR" || return 1
  # Never rm -rf outside the forks dir, whatever the caller passes.
  case "$dst" in
    "$CLEAT_FORKS_DIR"/?*) : ;;
    *) error "Refusing to write a fork outside ${CLEAT_FORKS_DIR/#${HOME}/~}"; return 1 ;;
  esac
  [[ -d "$src" ]] || { error "Fork source is not a directory: $src"; return 1; }
  lock="$CLEAT_FORKS_DIR/.lock.$(basename "$dst")"
  if ! mkdir "$lock" 2>/dev/null; then
    error "Another cleat is already copying this workspace."
    echo -e "    ${DIM}If nothing else is running, remove ${BOLD}${lock/#${HOME}/~}${RESET}${DIM} and retry.${RESET}"
    return 1
  fi
  _fork_copy_tree_locked "$src" "$dst" || rc=$?
  rmdir "$lock" 2>/dev/null || true
  return "$rc"
}

_fork_copy_tree_locked() {
  local src="$1" dst="$2" tmp cpflags rc=0
  tmp="$CLEAT_FORKS_DIR/.tmp.$$"
  rm -rf "$tmp" || return 1
  mkdir -p "$tmp" || return 1
  cpflags="$(_fork_cp_flags)"
  # shellcheck disable=SC2086
  cp $cpflags "$src/." "$tmp/" || rc=$?
  if [[ $rc -ne 0 ]]; then rm -rf "$tmp"; return "$rc"; fi
  rm -rf "$dst" || { rm -rf "$tmp"; return 1; }
  mv "$tmp" "$dst" || { rm -rf "$tmp"; return 1; }
  return 0
}

# Prune configured excludes AFTER the copy. cp has no --exclude, and rsync
# would lose clonefile on macOS, so copy-everything-then-prune keeps one code
# path and keeps CoW. Paths are refused if absolute or containing '..': an
# exclude must never be able to delete outside the fork.
_fork_prune_excludes() {
  local dst="$1" project="$2" e _root _parent _target
  _root="$(cd -P "$dst" 2>/dev/null && pwd -P)" || return 0
  while IFS= read -r e; do
    [[ -n "$e" ]] || continue
    # Cheap syntactic refusals first.
    case "$e" in
      /*|*..*) warn "Ignoring unsafe [fork] exclude: $e"; continue ;;
    esac
    # Then the one that actually matters. `rm -rf` follows every INTERMEDIATE
    # symlink component, and the copy deliberately preserves symlinks, so an
    # exclude that is neither absolute nor traversing can still reach outside
    # the fork: a project containing `docs -> ~/Documents` plus
    # `exclude = docs/thesis.txt` would delete the real host file. Resolve the
    # PHYSICAL parent and require it to sit inside the fork. cd -P plus pwd -P
    # is the portable resolver here: macOS has no realpath in the base system.
    _target="$dst/$e"
    _parent="$(cd -P "$(dirname "$_target")" 2>/dev/null && pwd -P)" || continue
    case "$_parent" in
      "$_root"|"$_root"/*) ;;
      *) warn "Ignoring [fork] exclude that resolves outside the fork: $e"; continue ;;
    esac
    # The leaf itself must not be a symlink either: removing it is fine, but
    # only the link, never through it.
    rm -rf "$_parent/$(basename "$_target")"
  done < <(_read_section_all_from_file "$project/.cleat" fork exclude)
}

# ── Workspace trust ─────────────────────────────────────────────────────────
#
# A project's .cleat file lives in the repo: it's untrusted input. Before
# applying any capabilities it declares, the user must explicitly trust the
# file. Approval is per-project, keyed by the project's absolute path, and
# re-prompted whenever the set of requested caps changes (hash mismatch).
#
# Global config (~/.config/cleat/config) and --cap CLI flags are always
# trusted: the user wrote those themselves.
#
# Full design: concept/16-workspace-trust.md.

# Canonicalize a cap list for hashing: sort, deduplicate, join with commas.
# Reads one cap per line from stdin, outputs a single canonical string.
_canonical_caps() {
  awk 'NF' | LC_ALL=C sort -u | paste -sd, -
}

# Hash the canonical cap list from a .cleat file. Prints empty when the
# file is missing or declares no caps (nothing to gate).
# Note: `_md5` passes stdin through `md5sum` on Linux, which appends
# "  -" (the filename of stdin). Strip that so the stored trust hash is
# purely hex, otherwise we write malformed tab-separated lines.
_hash_cleat_caps() {
  local path="$1"
  [[ -f "$path" ]] || return 0
  local caps
  caps="$(_read_caps_from_file "$path" | _canonical_caps)"
  [[ -z "$caps" ]] && return 0
  echo -n "$caps" | _md5 | awk '{print $1}'
}

# Hash a built [setup] payload (see _build_setup_payload) for trust
# comparison. Same _md5 note as _hash_cleat_caps above: strip md5sum's
# trailing "  -" filename artifact so the stored hash is purely hex.
_setup_payload_hash() {
  local payload="$1"
  printf '%s' "$payload" | _md5 | awk '{print $1}'
}

# Look up the stored trust hash for a (project, box). Empty on miss.
# The trust file is <path><TAB><box><TAB><hash>. Legacy two-column rows
# (<path><TAB><hash>) are read as the "main" box (see concept/20-boxes.md).
_trust_lookup() {
  local project="$1" box="${2:-main}"
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  awk -F'\t' -v p="$project" -v b="$box" '
    /^#/ { next }
    $1 != p { next }
    NF >= 3 { if ($2 == b) { print $3; exit } ; next }
    NF == 2 { if (b == "main") { print $2; exit } }
  ' "$CLEAT_TRUST_FILE" 2>/dev/null
}

# Look up the stored [setup] trust hash for a (project, box). Empty on
# miss. Unlike _trust_lookup, there is no legacy two-column case: setup
# trust only ever exists in a 4-column row (see _trust_record), since it
# shipped after the box-aware three-column format.
_trust_lookup_setup() {
  local project="$1" box="${2:-main}"
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  awk -F'\t' -v p="$project" -v b="$box" '
    /^#/ { next }
    $1 != p { next }
    NF >= 4 { if ($2 == b) { print $4; exit } }
  ' "$CLEAT_TRUST_FILE" 2>/dev/null
}

# Append/update a trust entry for a (project, box). Atomic via temp+rename.
# 0600 permissions. Refuses paths containing tab/newline/carriage-return.
# Recording the "main" box also supersedes any legacy two-column row.
# setup_hash is an optional 4th arg, a separate consent class from the caps
# hash (concept/16): when non-empty the row grows to four columns (path,
# box, caps hash or "-", setup hash); when empty/omitted the row is
# byte-identical to the pre-[setup] three-column format, so existing
# 3-arg callers and existing rows are untouched.
_trust_record() {
  # box is the optional 3rd arg so legacy 2-arg callers (project, hash) keep
  # working with box defaulting to "main".
  local project="$1" hash="$2" box="${3:-main}" setup_hash="${4:-}"
  case "$project" in
    *$'\t'*|*$'\n'*|*$'\r'*)
      error "Refusing to trust a project path containing control characters"
      return 1 ;;
  esac
  # A 3-column row needs a real caps hash (nothing else to record). A
  # 4-column row can carry setup trust alone, with "-" standing in for an
  # absent/untrusted caps hash (see printf below).
  if [[ -z "$setup_hash" ]]; then
    [[ -z "$hash" ]] && return 1
  fi
  mkdir -p "$(dirname "$CLEAT_TRUST_FILE")"
  local tmp="${CLEAT_TRUST_FILE}.tmp.$$"
  {
    echo "# Cleat project trust file (one entry per line)"
    echo "# <absolute-project-path><TAB><box><TAB><hash-of-canonical-caps>"
    echo "# Legacy two-column rows (<path><TAB><hash>) are read as the 'main' box."
    if [[ -f "$CLEAT_TRUST_FILE" ]]; then
      awk -F'\t' -v p="$project" -v b="$box" '
        /^#/ { next }
        NF < 2 { next }
        {
          if ($1 == p) {
            if (NF >= 3 && $2 == b) next
            if (NF == 2 && b == "main") next
          }
          print
        }
      ' "$CLEAT_TRUST_FILE"
    fi
    if [[ -n "$setup_hash" ]]; then
      printf '%s\t%s\t%s\t%s\n' "$project" "$box" "${hash:--}" "$setup_hash"
    else
      printf '%s\t%s\t%s\n' "$project" "$box" "$hash"
    fi
  } > "$tmp"
  chmod 0600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$CLEAT_TRUST_FILE"
}

# Remove a (project, box) trust entry. Silent no-op if not present. Removing
# the "main" box also clears any legacy two-column row for the path.
_trust_remove() {
  local project="$1" box="${2:-main}"
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  local tmp="${CLEAT_TRUST_FILE}.tmp.$$"
  {
    echo "# Cleat project trust file (one entry per line)"
    echo "# <absolute-project-path><TAB><box><TAB><hash-of-canonical-caps>"
    echo "# Legacy two-column rows (<path><TAB><hash>) are read as the 'main' box."
    awk -F'\t' -v p="$project" -v b="$box" '
      /^#/ { next }
      NF < 2 { next }
      {
        if ($1 == p) {
          if (NF >= 3 && $2 == b) next
          if (NF == 2 && b == "main") next
        }
        print
      }
    ' "$CLEAT_TRUST_FILE"
  } > "$tmp"
  chmod 0600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$CLEAT_TRUST_FILE"
}

# List all trusted (project, box) pairs as <path><TAB><box>, one per line.
# Legacy two-column rows surface as <path><TAB>main.
_trust_list() {
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  awk -F'\t' '
    /^#/ { next }
    NF >= 3 { print $1 "\t" $2; next }
    NF == 2 { print $1 "\t" "main" }
  ' "$CLEAT_TRUST_FILE" 2>/dev/null
}

# Is a project trusted at its current .cleat caps hash?
# Returns 0 when trusted, 1 when not (missing entry, stale hash, or no .cleat).
_is_project_trusted() {
  local project="$1"
  local box="${_BOX:-main}"
  local caps_file stored current
  caps_file="$(_project_caps_file "$project" "$box")"
  stored="$(_trust_lookup "$project" "$box")"
  [[ -z "$stored" ]] && return 1
  current="$(_hash_cleat_caps "$caps_file")"
  [[ -z "$current" ]] && return 1
  [[ "$stored" == "$current" ]]
}

# Show a trust prompt and read y/n. Returns 0 on approval.
# $1 = project path; $2..$N = capability names being requested.
# Must only be called when _is_tty is true.
_trust_prompt() {
  local project="$1"; shift
  local caps=("$@")

  # Detect if this is a re-prompt (stored hash exists but doesn't match).
  local is_reprompt=0
  [[ -n "$(_trust_lookup "$project" "${_BOX:-main}")" ]] && is_reprompt=1

  # Comma-joined cap names for the notice line; docker is amber because it
  # breaks the sandbox. Same aligned startup-prompt style (info + _ask_yn) as the
  # image-rebuild, Claude-update, and recreate prompts, not the old notice box.
  local cap _cap_safe _list=""
  for cap in "${caps[@]}"; do
    _cap_safe="$(_sanitize_repo_str "$cap")"
    if [[ "$cap" == "docker" ]]; then
      _list="${_list:+$_list, }${AMBER}${_cap_safe}${RESET}"
    else
      _list="${_list:+$_list, }${BOLD}${_cap_safe}${RESET}"
    fi
  done

  if [[ $is_reprompt -eq 1 ]]; then
    info "Project ${BOLD}.cleat${RESET} changed since you trusted it: it now grants ${_list} ${DIM}on your host${RESET}"
  else
    info "Project ${BOLD}.cleat${RESET} requests host access: ${_list} ${DIM}(beyond the sandbox)${RESET}"
  fi

  # Default-DENY ([y/N]): only an explicit yes grants the caps. Empty / EOF / no
  # all decline, so untrusted project input never auto-applies.
  local yn=""
  _ask_yn yn "Trust this project's .cleat? ${DIM}(applies its caps; approve once, undo with cleat untrust)${RESET} [y/N] "
  case "$yn" in
    [yY]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Show the [setup] consent prompt and read y/n. Returns 0 on approval.
# A separate consent class from _trust_prompt (concept/16): approving caps
# never approves this, and vice versa.
# $1 = project path, $2 = the built payload (for the preview), $3 = the
# number of declared [setup] entries (before script-directive expansion).
# Must only be called when _is_tty is true.
_setup_trust_prompt() {
  local project="$1" payload="$2" entry_count="$3"

  # Detect if this is a re-prompt (stored hash exists but doesn't match).
  local is_reprompt=0
  [[ -n "$(_trust_lookup_setup "$project" "${_BOX:-main}")" ]] && is_reprompt=1

  if [[ $is_reprompt -eq 1 ]]; then
    info "Project ${BOLD}.cleat${RESET} setup changed since you approved it: it runs ${BOLD}${entry_count} command(s)${RESET} ${DIM}in the box as coder${RESET}"
  else
    info "Project ${BOLD}.cleat${RESET} wants to run ${BOLD}${entry_count} command(s)${RESET} ${DIM}in the box as coder (full network access)${RESET}"
  fi

  # Preview: up to the first 15 payload lines, sanitized (repo-controlled
  # text rendered via echo -e, see _sanitize_repo_str), with a truncation
  # note when more remain.
  local total shown=0 line
  total="$(printf '%s\n' "$payload" | wc -l | tr -d ' ')"
  while IFS= read -r line && [[ $shown -lt 15 ]]; do
    shown=$((shown + 1))
    echo -e "      ${DIM}$(_sanitize_repo_str "$line")${RESET}"
  done <<< "$payload"
  if [[ $total -gt 15 ]]; then
    echo -e "      ${DIM}… (+$((total - 15)) more lines, see: cleat setup --show)${RESET}"
  fi

  # Default-DENY ([y/N]): only an explicit yes runs the commands. Empty /
  # EOF / no all decline, so untrusted project input never auto-runs.
  local yn=""
  _ask_yn yn "Run this project's setup commands? ${DIM}(runs once per container; approve once, undo with cleat untrust)${RESET} [y/N] "
  case "$yn" in
    [yY]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Session-scoped decision cache: avoid prompting twice per invocation when
# resolve_caps is called from multiple command paths in the same run.
_TRUST_SESSION_DECISION=""   # "", "approved", "rejected"
_TRUST_SESSION_PROJECT=""    # the project path we decided on
_TRUST_SESSION_BOX=""        # the box we decided on (per-box trust)

# Same idea for [setup] provisioning, a separate consent class (concept/16)
# so it gets its own session cache. The cached decision carries the hash it
# was approved at ("approved:<hash>"): a mid-process rewrite of [setup]
# between two resolve_caps calls must not ride an earlier approval of
# different content, so a stale hash is treated as no cached decision.
_SETUP_SESSION_DECISION=""   # "", "approved:<hash>", "rejected"
_SETUP_SESSION_PROJECT=""    # the project path we decided on
_SETUP_SESSION_BOX=""        # the box we decided on (per-box trust)

# Whether the active project declares a [setup] section (0/1) and whether
# it's currently trusted to run (0/1). Set by _resolve_setup_trust, which
# resets both to 0 on every call: resolve_caps can run for different
# projects within one process.
_SETUP_DECLARED=0
_SETUP_TRUSTED=0

# Exit code of the last _maybe_run_setup payload run (0 on success or any
# skip). Only the explicit `cleat setup` verb reads this, to propagate a real
# exit status; session callers ignore it.
_SETUP_LAST_RC=0

# Containers whose [setup] payload _maybe_run_setup has already attempted to
# run this process (pipe-delimited, bash 3.2-safe accumulator). Guards the
# recreate-funnel double-run where a failed payload leaves no marker; see
# _maybe_run_setup. Force runs (the `cleat setup` verb) ignore it.
_SETUP_ATTEMPTED=""

# Decide whether to apply a project's .cleat caps. Sets _TRUST_SESSION_* on
# first call for a given project. Returns 0 = apply, 1 = skip.
# $1 = project path (must have a .cleat with caps; caller's responsibility).
# $2 = "prompt" (default) or "readonly" to forbid interactive prompting.
_resolve_project_trust() {
  local project="$1"
  local mode="${2:-prompt}"
  local box="${_BOX:-main}"
  local caps_file
  caps_file="$(_project_caps_file "$project" "$box")"

  # Cached decision for this session/project/box
  if [[ -n "$_TRUST_SESSION_DECISION" && "$_TRUST_SESSION_PROJECT" == "$project" && "$_TRUST_SESSION_BOX" == "$box" ]]; then
    [[ "$_TRUST_SESSION_DECISION" == "approved" ]] && return 0 || return 1
  fi

  # Already approved at the current hash (per box)
  if _is_project_trusted "$project"; then
    _TRUST_SESSION_DECISION="approved"
    _TRUST_SESSION_PROJECT="$project"
    _TRUST_SESSION_BOX="$box"
    return 0
  fi

  # Explicit non-interactive opt-in
  if [[ "${CLEAT_TRUST_PROJECT:-}" == "1" || "${_CLI_TRUST_PROJECT:-0}" == "1" ]]; then
    local hash
    hash="$(_hash_cleat_caps "$caps_file")"
    # Preserve any existing [setup] trust (col4): approving caps never
    # creates setup trust, and passing through an empty lookup is exactly
    # that (a no-op 4th arg keeps the row 3-column, see _trust_record).
    _trust_record "$project" "$hash" "$box" "$(_trust_lookup_setup "$project" "$box")" || true
    _TRUST_SESSION_DECISION="approved"
    _TRUST_SESSION_PROJECT="$project"
    _TRUST_SESSION_BOX="$box"
    return 0
  fi

  # Read-only contexts never prompt (e.g. cleat status)
  [[ "$mode" == "readonly" ]] && return 1

  # Interactive prompt
  if _is_tty; then
    local -a req_caps=()
    local c
    while IFS= read -r c; do [[ -n "$c" ]] && req_caps+=("$c"); done < <(_read_caps_from_file "$caps_file")
    if _trust_prompt "$project" "${req_caps[@]}"; then
      local hash
      hash="$(_hash_cleat_caps "$caps_file")"
      # Preserve any existing [setup] trust (col4): see the opt-in branch
      # above, same reasoning.
      _trust_record "$project" "$hash" "$box" "$(_trust_lookup_setup "$project" "$box")" || true
      _TRUST_SESSION_DECISION="approved"
      _TRUST_SESSION_PROJECT="$project"
      _TRUST_SESSION_BOX="$box"
      return 0
    else
      warn "Project .cleat ignored, not trusted ${DIM}(global config still applied)${RESET}"
      _TRUST_SESSION_DECISION="rejected"
      _TRUST_SESSION_PROJECT="$project"
      _TRUST_SESSION_BOX="$box"
      return 1
    fi
  fi

  # Non-TTY, no explicit opt-in: default-deny with an informational warning
  warn "Project .cleat skipped in non-interactive mode ${DIM}(pass --trust-project or set CLEAT_TRUST_PROJECT=1 to approve)${RESET}"
  _TRUST_SESSION_DECISION="rejected"
  _TRUST_SESSION_PROJECT="$project"
  _TRUST_SESSION_BOX="$box"
  return 1
}

# Decide whether to run a project's [setup] provisioning. Sets
# _SETUP_DECLARED and _SETUP_TRUSTED (0/1). Never aborts resolve_caps:
# callers use `_resolve_setup_trust ... || true`. A separate consent class
# from _resolve_project_trust (concept/16): approving caps never approves
# setup, and vice versa.
# $1 = project path. $2 = "prompt" (default) or "readonly" to forbid
# interactive prompting (box is read from ${_BOX:-main}).
_resolve_setup_trust() {
  local project="$1"
  local mode="${2:-prompt}"
  local box="${_BOX:-main}"
  # resolve_caps can run for different projects within one process.
  _SETUP_DECLARED=0
  _SETUP_TRUSTED=0

  # Same no-project guard as the caps block in resolve_caps: an empty
  # project would otherwise resolve to a root-level /.cleat.
  [[ -n "$project" ]] || return 0

  local caps_file
  caps_file="$(_project_caps_file "$project" "$box")"
  [[ -f "$caps_file" ]] || return 0

  local payload
  if [[ "$mode" == "readonly" ]]; then
    # Read-only contexts (cleat status) stay fully silent, so swallow the
    # builder's diagnostic about a bad script directive too. cleat setup
    # --show re-surfaces the specific error loudly itself.
    if ! payload="$(_build_setup_payload "$project" "$box" 2>/dev/null)"; then
      return 0
    fi
  else
    # _build_setup_payload already warned about the specific bad directive.
    # A broken [setup] section skips provisioning loudly, it never aborts
    # the session.
    if ! payload="$(_build_setup_payload "$project" "$box")"; then
      return 0
    fi
  fi
  [[ -z "$payload" ]] && return 0
  _SETUP_DECLARED=1

  local hash
  hash="$(_setup_payload_hash "$payload")"

  # Already approved at the current hash (per box)
  local stored
  stored="$(_trust_lookup_setup "$project" "$box")"
  if [[ -n "$stored" && "$stored" == "$hash" ]]; then
    _SETUP_TRUSTED=1
    return 0
  fi

  # Cached decision for this session/project/box. Only honored when the
  # cached hash still matches the current one: a rewrite of [setup]
  # mid-process must not ride an earlier approval of different content.
  if [[ -n "$_SETUP_SESSION_DECISION" && "$_SETUP_SESSION_PROJECT" == "$project" && "$_SETUP_SESSION_BOX" == "$box" ]]; then
    case "$_SETUP_SESSION_DECISION" in
      "approved:$hash") _SETUP_TRUSTED=1; return 0 ;;
      rejected) return 0 ;;
    esac
  fi

  # Read-only contexts never prompt or warn (e.g. cleat status)
  [[ "$mode" == "readonly" ]] && return 0

  # Explicit non-interactive opt-in
  if [[ "${CLEAT_TRUST_SETUP:-}" == "1" || "${_CLI_TRUST_SETUP:-0}" == "1" ]]; then
    # Preserve the existing caps hash (never recompute it here: approving
    # setup never approves caps); "-" when there's none.
    _trust_record "$project" "$(_trust_lookup "$project" "$box")" "$box" "$hash" || true
    _SETUP_SESSION_DECISION="approved:$hash"
    _SETUP_SESSION_PROJECT="$project"
    _SETUP_SESSION_BOX="$box"
    _SETUP_TRUSTED=1
    return 0
  fi

  # Interactive prompt
  if _is_tty; then
    local entry_count
    entry_count="$(_read_setup_from_file "$caps_file" | wc -l | tr -d ' ')"
    if _setup_trust_prompt "$project" "$payload" "$entry_count"; then
      _trust_record "$project" "$(_trust_lookup "$project" "$box")" "$box" "$hash" || true
      _SETUP_SESSION_DECISION="approved:$hash"
      _SETUP_SESSION_PROJECT="$project"
      _SETUP_SESSION_BOX="$box"
      _SETUP_TRUSTED=1
      return 0
    else
      warn "Project [setup] skipped, not approved ${DIM}(box starts without provisioning; approve later with cleat setup)${RESET}"
      _SETUP_SESSION_DECISION="rejected"
      _SETUP_SESSION_PROJECT="$project"
      _SETUP_SESSION_BOX="$box"
      return 0
    fi
  fi

  # Non-TTY, no explicit opt-in: default-deny with an informational warning
  warn "Project [setup] skipped in non-interactive mode ${DIM}(set CLEAT_TRUST_SETUP=1 or pass --trust-setup to approve)${RESET}"
  _SETUP_SESSION_DECISION="rejected"
  _SETUP_SESSION_PROJECT="$project"
  _SETUP_SESSION_BOX="$box"
  return 0
}

# Guard: warn about each unhandled `[...]` section in a .cleat/global config
# at most once per file per process (no assoc arrays, bash 3.2: a
# pipe-delimited accumulator string).
_WARNED_SECTIONS_FILES=""

# Scan a config file for `[...]` section headers and warn about any this
# CLI version doesn't recognize, so a future or misspelled section degrades
# loudly instead of silently doing nothing (INI hazard, see
# _read_caps_from_file / _read_setup_from_file). scope = "project"
# (.cleat / .cleat.<box>: known sections are caps, resources, setup) or
# "global" (~/.config/cleat/config: known sections are caps, resources,
# kits). A section valid in the OTHER scope gets its own hint, so it reads
# as "wrong file" rather than "ignored".
_warn_unknown_cleat_sections() {
  local file="$1" scope="$2"
  [[ -f "$file" ]] || return 0
  case "$_WARNED_SECTIONS_FILES" in
    *"|$file|"*) return 0 ;;
  esac
  _WARNED_SECTIONS_FILES="${_WARNED_SECTIONS_FILES}|$file|"

  local base seen=""
  base="$(basename "$file")"
  local line name
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == "["*"]" ]] || continue
    name="${line#[}"; name="${name%]}"
    case "|$seen|" in *"|$name|"*) continue ;; esac
    seen="${seen:+$seen|}$name"
    case "$scope" in
      project)
        case "$name" in
          caps|resources|setup) continue ;;
          kits)
            warn "Section [kits] in .cleat is ignored ${DIM}(kit models are read from the global config only)${RESET}"
            continue ;;
        esac ;;
      global)
        case "$name" in
          caps|resources|kits) continue ;;
          setup)
            warn "Section [setup] in the global config is ignored ${DIM}([setup] is project-only, in .cleat)${RESET}"
            continue ;;
        esac ;;
    esac
    warn "Unknown section [$(_sanitize_repo_str "$name")] in ${base} ${DIM}(ignored)${RESET}"
  done < "$file"
  return 0
}

# Resolve active capabilities: global config + project config + CLI flags.
# Sets the global ACTIVE_CAPS array.
resolve_caps() {
  local project="${1:-}"
  local trust_mode="${2:-prompt}"
  local box="${_BOX:-main}"
  ACTIVE_CAPS=()

  # 1. Global config
  local global_caps
  global_caps="$(_read_caps_from_file "$CLEAT_GLOBAL_CONFIG")"
  [[ -f "$CLEAT_GLOBAL_CONFIG" ]] && _warn_unknown_cleat_sections "$CLEAT_GLOBAL_CONFIG" global || true

  # 2. Project config, gated by workspace trust. A .cleat file sitting in
  # the repo is untrusted input. Apply its caps only if the user has
  # approved this project (either a persistent trust record, a one-off
  # --trust-project flag, or an interactive "y" to the prompt).
  # The box's cap file REPLACES .cleat (no merge): .cleat.<box> if present,
  # else .cleat; main always uses .cleat. See concept/20-boxes.md.
  local project_caps=""
  if [[ -n "$project" ]]; then
    local caps_file
    caps_file="$(_project_caps_file "$project" "$box")"
    [[ -f "$caps_file" ]] && _warn_unknown_cleat_sections "$caps_file" project || true
    if [[ -f "$caps_file" ]]; then
      local _raw_project_caps
      _raw_project_caps="$(_read_caps_from_file "$caps_file")"
      if [[ -n "$_raw_project_caps" ]]; then
        if _resolve_project_trust "$project" "$trust_mode"; then
          project_caps="$_raw_project_caps"
        fi
      fi
    fi
  fi

  # [setup] provisioning trust is a separate consent class from caps trust
  # (concept/16); never let a bad/untrusted [setup] section abort resolve.
  _resolve_setup_trust "$project" "$trust_mode" || true

  # 3. Merge: global + project (union, deduplicated)
  local seen=""
  local cap
  while IFS= read -r cap; do
    [[ -z "$cap" ]] && continue
    case ",$seen," in
      *,"$cap",*) ;;
      *) seen="${seen:+$seen,}$cap"; ACTIVE_CAPS+=("$cap") ;;
    esac
  done <<< "${global_caps}${global_caps:+$'\n'}${project_caps}"

  # 4. Add CLI --cap flags (session-scoped additions)
  for cap in "${_CLI_CAPS[@]+"${_CLI_CAPS[@]}"}"; do
    case ",$seen," in
      *,"$cap",*) ;;
      *) seen="${seen:+$seen,}$cap"; ACTIVE_CAPS+=("$cap") ;;
    esac
  done
}

# Check if a specific capability is active
cap_is_active() {
  local target="$1"
  local cap
  for cap in "${ACTIVE_CAPS[@]+"${ACTIVE_CAPS[@]}"}"; do
    [[ "$cap" == "$target" ]] && return 0
  done
  return 1
}

# ── Capabilities: env file parsing ─────────────────────────────────────────
# Parse an env file and output KEY=VALUE lines (resolved).
# Bare KEY entries are resolved from the host environment.
_parse_env_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip carriage return (CRLF from Windows editors)
    line="${line%$'\r'}"
    # Strip leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    # Skip empty lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == *=* ]]; then
      # KEY=VALUE: validate key is non-empty
      local _key="${line%%=*}"
      [[ -z "$_key" ]] && continue
      echo "$line"
    else
      # Bare KEY: resolve from host environment
      # Validate variable name to prevent indirect expansion of invalid names
      if [[ ! "$line" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        continue
      fi
      local val="${!line:-}"
      if [[ -n "$val" ]]; then
        echo "${line}=${val}"
      fi
    fi
  done < "$file"
}

# Resolve all env vars to pass to the container.
# Returns an array of -e KEY=VALUE docker arguments via _RESOLVED_ENV_ARGS.
resolve_env_args() {
  local project="${1:-}"
  _RESOLVED_ENV_ARGS=()
  # Parallel arrays: _ek[i] holds the key, _ev[i] holds the value
  local _ek=() _ev=()
  local key val line i

  _env_set() {
    local k="$1" v="$2"
    # Replace existing or append
    for ((i=0; i<${#_ek[@]}; i++)); do
      if [[ "${_ek[$i]}" == "$k" ]]; then
        _ev[$i]="$v"
        return
      fi
    done
    _ek+=("$k")
    _ev+=("$v")
  }

  # 1. If env capability is active, read env files
  if cap_is_active env 2>/dev/null; then
    # Global env file
    if [[ -f "$CLEAT_GLOBAL_ENV" ]]; then
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        key="${line%%=*}"; val="${line#*=}"
        _env_set "$key" "$val"
      done < <(_parse_env_file "$CLEAT_GLOBAL_ENV")
    fi

    # Project env file, box-aware: .cleat.<box>.env else .cleat.env
    local _env_file
    _env_file="$(_project_env_file "$project" "${_BOX:-main}")"
    if [[ -n "$project" && -f "$_env_file" ]]; then
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        key="${line%%=*}"; val="${line#*=}"
        _env_set "$key" "$val"
      done < <(_parse_env_file "$_env_file")
    fi
  fi

  # 2. --env-file flags (always work, bypass capability gate)
  for file in "${_CLI_ENV_FILES[@]+"${_CLI_ENV_FILES[@]}"}"; do
    if [[ ! -f "$file" ]]; then
      error "Env file not found: $file"
      exit 1
    fi
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      key="${line%%=*}"; val="${line#*=}"
      _env_set "$key" "$val"
    done < <(_parse_env_file "$file")
  done

  # 3. --env flags (always work, bypass capability gate)
  for entry in "${_CLI_ENVS[@]+"${_CLI_ENVS[@]}"}"; do
    if [[ "$entry" == *=* ]]; then
      key="${entry%%=*}"; val="${entry#*=}"
      _env_set "$key" "$val"
    else
      # Bare key: resolve from host
      val="${!entry:-}"
      if [[ -n "$val" ]]; then
        _env_set "$entry" "$val"
      fi
    fi
  done

  # 4. Build -e arguments (sorted for deterministic fingerprinting)
  if [[ ${#_ek[@]} -gt 0 ]]; then
    while IFS= read -r key; do
      for ((i=0; i<${#_ek[@]}; i++)); do
        if [[ "${_ek[$i]}" == "$key" ]]; then
          _RESOLVED_ENV_ARGS+=(-e "${key}=${_ev[$i]}")
          break
        fi
      done
    done < <(printf '%s\n' "${_ek[@]}" | sort)
  fi

  unset -f _env_set
}

# Count env vars loaded from each source (for startup feedback)
_env_summary() {
  local project="${1:-}"
  local global_count=0
  local project_count=0

  if cap_is_active env 2>/dev/null; then
    if [[ -f "$CLEAT_GLOBAL_ENV" ]]; then
      global_count=$(_parse_env_file "$CLEAT_GLOBAL_ENV" | wc -l)
      global_count=$((global_count + 0))  # force integer
    fi
    local _env_file
    _env_file="$(_project_env_file "$project" "${_BOX:-main}")"
    if [[ -n "$project" && -f "$_env_file" ]]; then
      project_count=$(_parse_env_file "$_env_file" | wc -l)
      project_count=$((project_count + 0))
    fi
  fi

  if (( global_count + project_count > 0 )); then
    local msg="Env:"
    if (( global_count > 0 )); then
      msg+=" ${global_count} from ~/.config/cleat/env"
    fi
    if (( project_count > 0 )); then
      [[ "$msg" != "Env:" ]] && msg+=","
      msg+=" ${project_count} from $(basename "$_env_file")"
    fi
    info "$msg"
  fi
}

# ── Configuration drift detection ──────────────────────────────────────────
# Fingerprint storage-format version. Bump whenever the fingerprint INPUTS change
# (v0.16.4 dropped the VM-derived resource values). It is stored as a `v<N>:`
# prefix on the container's config-hash label, so a hash written under an OLDER
# format is recognisable as legacy: its bytes can't be recomputed here (we no
# longer know the old formula or the VM size at creation), so a mismatch against
# it can't be trusted to mean real drift. Legacy-format containers are therefore
# NOT nagged to recreate; they adopt the current format the next time they're
# recreated for a genuine reason. See _resolve_config_drift.
_CONFIG_FP_VERSION=2

# Compute a fingerprint from sorted caps + sorted env keys ONLY.
# Env VALUES are intentionally excluded: only structural changes (adding/removing
# keys or capabilities) trigger drift. Value changes don't require container
# recreation since env vars are passed at exec time, not baked into the container.
#
# The CLI VERSION is deliberately NOT part of the fingerprint. Folding it in made
# every release fire a false "caps or env keys differ" notice on existing
# containers whose only change was the version bump: a misleading message whose
# offered remedy (recreate the container from the *same* image) does nothing for a
# version change. Version drift is handled separately by _maybe_prompt_image_rebuild,
# which offers a real rebuild and only when the image is genuinely older.
#
# Same principle for resources (fixed v0.16.4): the fingerprint uses CONFIGURED
# memory/cpus (_configured_box_*), never the VM-derived default or the daemon
# clamp, both of which move when the VM is resized or the CLI's default formula
# changes between releases. Folding those in had quietly re-coupled the hash to
# VM size and CLI version, so a memory-slider tweak or a routine upgrade fired a
# false recreate prompt on a box the user never touched. The stored hash carries a
# format-version prefix (_CONFIG_FP_VERSION) so a future formula change is
# detectable rather than silently mistaken for real drift; see _resolve_config_drift.
compute_config_fingerprint() {
  local project="${1:-}"
  local fingerprint_input=""

  # Caps (sorted)
  fingerprint_input+="caps:"
  if [[ ${#ACTIVE_CAPS[@]} -gt 0 ]]; then
    fingerprint_input+="$(printf '%s\n' "${ACTIVE_CAPS[@]}" | sort | tr '\n' ',')"
  fi
  fingerprint_input+=$'\n'

  # Env keys (sorted HERE, values excluded). We sort inside this function rather
  # than trust the caller's arg order: resolve_env_args happens to emit keys
  # sorted today, but folding that assumption in means a different ordering (a
  # refactor, a new env source) would silently change the hash and fire a false
  # "caps or env keys differ" drift notice on an otherwise-unchanged setup.
  fingerprint_input+="env-keys:"
  if [[ ${#_RESOLVED_ENV_ARGS[@]} -gt 0 ]]; then
    local _ekeys=""
    for arg in "${_RESOLVED_ENV_ARGS[@]}"; do
      [[ "$arg" == -e ]] && continue
      _ekeys+="${arg%%=*}"$'\n'
    done
    fingerprint_input+="$(printf '%s' "$_ekeys" | sort | tr '\n' ',')"
  fi
  fingerprint_input+=$'\n'

  # Resources: only what the user DECLARED in config (_configured_box_*), so an
  # explicit `[resources] memory = 8g` still triggers a recreate (the ceiling is
  # baked at `docker run`, not changeable on a live container) while an
  # unconfigured box stays stable across VM resizes and CLI upgrades. Never the
  # VM-derived default or the daemon-clamped cpus: those move underfoot and were
  # the source of the v0.16.4 false-positive recreate.
  fingerprint_input+="resources:memory=$(_configured_box_memory "$project" "${_BOX:-main}")"
  fingerprint_input+=$'\n'
  fingerprint_input+="resources:cpus=$(_configured_box_cpus "$project" "${_BOX:-main}")"
  fingerprint_input+=$'\n'

  if command -v sha256sum &>/dev/null; then
    echo -n "$fingerprint_input" | sha256sum | head -c 16
  else
    echo -n "$fingerprint_input" | _md5 | head -c 16
  fi
}

# Read config hash stored on a container's Docker label
_container_config_hash() {
  local cname="$1"
  docker inspect "$cname" --format '{{index .Config.Labels "sh.cleat.config-hash"}}' 2>/dev/null || echo ""
}

# Read Cleat version stored on the Docker image label
_image_cleat_version() {
  docker inspect "$IMAGE_NAME" --format '{{index .Config.Labels "sh.cleat.version"}}' 2>/dev/null || echo ""
}

# Read the image-content spec stamped on the Docker image label. Empty for
# pre-stamping images (built before sh.cleat.image-spec existed) and for any
# image the daemon can't inspect. See _IMAGE_SPEC_VERSION.
_image_spec_version() {
  docker inspect "$IMAGE_NAME" --format '{{index .Config.Labels "sh.cleat.image-spec"}}' 2>/dev/null || echo ""
}

# True when version $1 is >= version $2 (dotted numeric, prerelease/build suffix
# stripped). Used to classify a pre-stamping image's content from the version it
# was built at. Pure integer field sort, bash 3.2 safe.
_version_ge() {
  local a="${1%%[-+]*}" b="${2%%[-+]*}"
  [[ "$a" == "$b" ]] && return 0
  local newest
  newest="$(printf '%s\n%s\n' "$a" "$b" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
  [[ "$newest" == "$a" ]]
}

# Read the Claude Code version bundled in the image. The `claude` launcher is a
# symlink into ~/.local/share/claude/versions/<v>, so the target's basename is
# the version. Prints the version string, or nothing if it can't be determined
# (e.g. layout changed, or no image). Spawns a throwaway container to resolve
# the symlink as it exists *inside* the image.
_image_claude_version() {
  local target v
  target="$(docker run --rm "$IMAGE_NAME" \
    bash -c 'readlink -f /home/coder/.local/bin/claude 2>/dev/null' 2>/dev/null)" || true
  case "$target" in
    */versions/*) v="${target##*/versions/}"; v="${v%%/*}" ;;
    *) v="" ;;
  esac
  printf '%s' "$v"
}

# Return success if the container's settings-overlay bind sources are all
# present and the right type. Return failure when the overlay dir is missing
# OR when any bind source within it is missing or has the wrong type.
#
# The overlay now lives under $CLEAT_RUN_DIR (persistent), not /tmp, so routine
# macOS /tmp rotation no longer invalidates it. This check now serves two roles:
#   1. Migration: a container created before the move has its overlay mounts
#      under /tmp, so the new-layout dir is absent → recreate to adopt the
#      persistent layout.
#   2. Defense: if the overlay dir or a file within it is missing (manual
#      deletion, partial state), recreate rather than mount a broken source.
# Why per-file, not just the dir: Docker auto-creates a missing bind source as a
# directory, which then fails to mount onto a file destination with an opaque
# OCI "not a directory" error.
_settings_overlay_intact() {
  local cname="$1"
  local overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  [[ -d "$overlay_dir" ]] || return 1

  local mounts src
  mounts="$(docker inspect "$cname" --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' 2>/dev/null)" || return 0
  [[ -n "$mounts" ]] || return 0
  while IFS= read -r src; do
    [[ -z "$src" ]] && continue
    case "$src" in
      "$overlay_dir"/* | "$CLEAT_PROJECTS_DIR"/*)
        # Overlay files and the persistent per-project .claude.json are bind
        # sources mounted onto file destinations. If one was deleted, Docker
        # would auto-create it as a directory and the start would fail with an
        # opaque OCI error; recreate instead.
        [[ -f "$src" ]] || return 1
        ;;
    esac
  done <<< "$mounts"
  return 0
}

# Return failure when any of the container's bind-mount sources no longer exist
# on the host. Bind sources are baked in at `docker run` (creation) and cannot
# be changed; `docker start` re-mounts the SAME recorded sources, and if one has
# vanished it aborts with an opaque OCI error:
#   error mounting "<src>" to rootfs at "<dst>" ... not a directory:
#   Are you trying to mount a directory onto a file (or vice-versa)?
#
# The classic trigger is the macOS SSH agent socket (the `ssh` cap). launchd
# regenerates its socket directory (…/com.apple.launchd.XXXX/Listeners) on every
# boot, so SSH_AUTH_SOCK rotates and the path baked into the container points at
# a directory that no longer exists: every `ssh`-cap box fails to restart after
# a reboot. Detect it here so the caller can recreate transparently (cheap: the
# container is disposable; auth, sessions, and the project all live in other
# mounts). Only `bind` mounts are checked: volumes/tmpfs have no host source to
# stat. Unreadable inspect (no daemon, gone container) → treat as present (0):
# the start path that follows surfaces the real error.
_container_bind_sources_present() {
  local cname="$1"
  local mounts line typ src
  mounts="$(docker inspect "$cname" \
    --format '{{range .Mounts}}{{.Type}}|{{.Source}}{{"\n"}}{{end}}' 2>/dev/null)" || return 0
  [[ -n "$mounts" ]] || return 0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    typ="${line%%|*}"
    src="${line#*|}"
    [[ "$typ" == "bind" ]] || continue
    [[ -n "$src" ]] || continue
    [[ -e "$src" ]] || return 1
  done <<< "$mounts"
  return 0
}

# Build a per-project ~/.claude.json for the container, isolated from the shared
# host file. Mounting the host ~/.claude.json directly (the old behavior) caused
# two problems, because every container runs at CWD /workspace and writes back
# to the same host file:
#   1. Corruption: concurrent/interrupted writes from parallel containers
#      truncate the file → Claude greets the user with "Configuration Error /
#      Unexpected EOF" on startup.
#   2. Cross-project bleed: all containers share projects["/workspace"], so
#      trust-dialog / MCP / allowedTools approvals leak between unrelated projects.
#
# Strategy (per-project, host-as-base): on each (re)create AND on each start of
# a stopped container (see _refresh_project_claude_json) take the host file
# WHOLE as the base, preserving Claude's global identity, onboarding, migration
# flags, and whatever schema the installed host version writes (no drift), then
# overlay this project's persisted projects["/workspace"] block on top. Global
# identity/onboarding keys fall back to the persisted copy when the host lacks
# them, so onboarding done inside a container on a fresh machine still sticks;
# when BOTH lack them they fall back to the newest sibling box that holds a
# login (_newest_sibling_identity), so a login done inside any box satisfies
# the login gate of every box built or started afterwards.
# The result is written ATOMICALLY (temp + mv) to a persistent, project-keyed
# file that the container mounts. The container never writes the host file, so
# the corruption race and the cross-project bleed are gone by construction.
#
# jq-free sanity check: does a file look like a JSON object? After stripping all
# whitespace it must be non-empty and start with `{` and end with `}`. This is a
# heuristic, not a parser: it can't catch interior damage, but it reliably
# catches the dominant corruption mode (a truncated write → Claude's "Unexpected
# EOF"), which never ends in `}`. Used only when jq is unavailable on the host.
_looks_like_json_object() {
  local content
  content="$(tr -d '[:space:]' < "$1" 2>/dev/null)" || return 1
  [[ -n "$content" && "${content:0:1}" == "{" && "${content: -1}" == "}" ]]
}

# Print the path of the newest sibling per-project claude.json that carries an
# oauthAccount, excluding $1 (the file being rebuilt). A login done INSIDE a
# box writes oauthAccount only into that box's mounted per-project file, and
# nothing ever writes the host ~/.claude.json (by design, see the strategy
# note above _build_project_claude_json), so this scan is how a login reaches
# every OTHER box that gets built or started afterwards: login once, every box.
# Prints nothing when no sibling has one. Requires jq (callers only use the
# result on the jq path). Fail-soft: any unreadable/corrupt sibling is skipped.
_newest_sibling_identity() {
  local exclude="$1" f best="" best_m=0 m
  command -v jq &>/dev/null || return 0
  for f in "$CLEAT_PROJECTS_DIR"/*/claude.json; do
    [[ -f "$f" ]] || continue
    [[ "$f" == "$exclude" ]] && continue
    jq -e '.oauthAccount? != null' "$f" >/dev/null 2>&1 || continue
    m="$(_path_mtime "$f")"
    if (( m > best_m )); then best_m=$m; best="$f"; fi
  done
  [[ -n "$best" ]] && printf '%s' "$best"
  return 0
}

# Args: $1 = output path (the mount source / persisted per-project file)
#       $2 = optional persisted-input path (defaults to $1; the attached-box
#            in-place refresh writes a TEMP output while reading the real file)
_build_project_claude_json() {
  local out="$1"
  local proj_src="${2:-$1}"
  mkdir -p "$(dirname "$out")"

  # Defensive: a stray directory at the output path (e.g. Docker auto-created a
  # missing bind source as a dir on a prior run) would make the atomic mv fail
  # and then break the file→file mount. Clear anything that isn't a regular file.
  [[ -e "$out" && ! -f "$out" ]] && rm -rf "$out"

  local host="${HOME}/.claude.json"
  local host_src="$host"

  # Corruption guard: never feed a broken host file into the build, and never
  # silently reset it to {}. "Broken" = not parseable JSON (the common case is a
  # truncated file → Claude's "Unexpected EOF") OR valid JSON that isn't an
  # object (a malformed shape that would crash the merge). Back the bad file up
  # and warn so the user can recover it; proceed from the persisted project copy
  # (onboarding preserved). The guard runs WITHOUT jq too: jq gives a precise
  # check, otherwise a pure-bash heuristic (must be {…}) catches truncation, the
  # dominant corruption mode, so a jq-less host can't propagate a corrupt file.
  local host_broken=false
  if [[ -f "$host" && -s "$host" ]]; then
    if command -v jq &>/dev/null; then
      jq -e 'type=="object"' "$host" >/dev/null 2>&1 || host_broken=true
    else
      _looks_like_json_object "$host" || host_broken=true
    fi
  fi
  if $host_broken; then
    cp "$host" "${host}.bak" 2>/dev/null || true
    warn "Host ${BOLD}~/.claude.json${RESET} is corrupt, backed up to ${BOLD}~/.claude.json.bak${RESET}."
    echo -e "    ${DIM}Container uses last-known project state; the host file is left untouched.${RESET}"
    host_src=""
  fi

  if command -v jq &>/dev/null; then
    local tmp="${out}.tmp.$$"
    local hf pf sf sib
    if [[ -n "$host_src" && -f "$host_src" && -s "$host_src" ]]; then hf="$host_src"; else hf=/dev/null; fi
    if [[ -f "$proj_src" && -s "$proj_src" ]]; then pf="$proj_src"; else pf=/dev/null; fi
    # Identity gained inside another box (its mounted per-project file is the
    # only place an in-box login lands) fills identity keys that BOTH the host
    # file and this project's own copy lack. Without it, a login done in box A
    # leaves every box built afterwards on the login screen, despite the fresh
    # shared ~/.claude/.credentials.json (the second half of the login gate).
    sf=/dev/null
    sib="$(_newest_sibling_identity "$out")"
    [[ -n "$sib" && -f "$sib" && -s "$sib" ]] && sf="$sib"
    # slurpfile reads each input fully before output is written, so reading $out
    # while writing $tmp is safe; mv makes the swap atomic.
    if jq -n --slurpfile h "$hf" --slurpfile p "$pf" --slurpfile s "$sf" '
        ($h[0] // {}) as $host |
        ($p[0] // {}) as $proj |
        ($s[0] // {}) as $sib |
        (($host.projects // {}) + ($proj.projects // {})) as $projects |
        # What a brand-new /workspace is born with INSIDE the cage. The sandbox
        # IS the trust boundary and cleat always launches claude with
        # --dangerously-skip-permissions, so pre-accepting folder trust, project
        # onboarding, and bypass mode for /workspace is correct, and it stops a
        # newer bundled Claude from re-running its first-run/onboarding flow (which
        # can surface as a login screen) in a fresh project that has no persisted
        # block. Defaults are on the LEFT of `+`, so any persisted/host /workspace
        # value wins per key (jq `+` is right-biased). Unknown future key names are
        # harmless extras; the real ones gate the prompts.
        ({hasTrustDialogAccepted:true, hasCompletedProjectOnboarding:true, bypassPermissionsModeAccepted:true}) as $wsdefaults |
        # Base is proj-then-host (host wins any shared top-level key, so there is
        # no schema drift from the installed host version), but a top-level key
        # present ONLY in this per-project copy SURVIVES. That matters because
        # this rebuild now re-runs on accumulated box state (stopped-box
        # start/resume and the running-box attach heal, not just first create),
        # and a host-only base would silently drop box-written top-level state
        # like a user-scoped mcpServers (claude mcp add -s user) on every start.
        # At first create $proj is {} so this is identical to a host-only base.
        # .projects and identity are still overlaid explicitly below, so their
        # precedence is unchanged.
        ($proj + $host)
        + { projects: ($projects + { "/workspace": ($wsdefaults + ($projects["/workspace"] // {})) }) }
        # Identity precedence: host wins, then the persisted copy of THIS
        # project, then the newest sibling box that holds a login (see
        # _newest_sibling_identity). jq // falls through per key on null.
        + ( ["oauthAccount","userID","lastOnboardingVersion"]
            | map({ (.): ($host[.] // $proj[.] // $sib[.]) })
            | add
            | with_entries(select(.value != null)) )
        # Onboarding is complete by construction inside the cage. This flag is
        # load-bearing: Claude 2.1.x gates its startup login/onboarding screen
        # on hasCompletedOnboarding ALONE (verified in the 2.1.202 binary; an
        # in-box /logout sets it false, which is what re-prompted every later
        # session), while oauthAccount above is identity/org metadata that some
        # Claude flows also treat as login state. A dead token surfaces as a
        # runtime "revoked, run /login" error instead.
        + { hasCompletedOnboarding: true }
        # The container always runs the native installer build (~/.local/bin/
        # claude → versions/), but this file is rebuilt from the host every run,
        # shadowing the installMethod the installer wrote at image-build time.
        # Without it, `claude doctor` warns "native installation but config
        # install method is unknown" and the updater logs install_failed. Force
        # it to match the real install so config agrees with the filesystem.
        + { installMethod: "native" }
      ' > "$tmp" 2>/dev/null; then
      mv -f "$tmp" "$out"
    else
      rm -f "$tmp" 2>/dev/null || true
      # jq failed unexpectedly: keep the persisted copy if present, else start clean.
      [[ -f "$out" && -s "$out" ]] || echo '{}' > "$out"
    fi
  else
    # No jq: best effort. Keep persisted copy, else seed from host, else empty.
    if [[ -f "$out" && -s "$out" ]]; then
      :
    elif [[ -n "$host_src" && -f "$host_src" && -s "$host_src" ]]; then
      cp "$host_src" "$out"
    else
      echo '{}' > "$out"
    fi
  fi
}

# Rebuild the per-project ~/.claude.json bind source for a STOPPED container,
# just before `docker start`. Bind sources are re-resolved at start and a
# stopped box has no writer, so this is the safe moment to fold in host-side
# changes and identity gained in other boxes since it stopped (the login-once
# -every-box guarantee; without this, only a full recreate would pick it up).
# Never call it for a RUNNING container: the mount pins the file's old inode
# (the atomic mv swaps inodes) and the container may be mid-write.
_refresh_project_claude_json() {
  local project="$1" box="$2"
  local key
  key="$(_derive_project_session_key "$project" "$box")"
  _build_project_claude_json "$CLEAT_PROJECTS_DIR/${key}/claude.json"
}

# The RUNNING-box counterpart, for session attach. The create/start rebuilds
# cannot run here: the bind mount pins the file's inode (the atomic temp+mv
# swap would detach it) and a live box may hold concurrent writers. But a
# running box carries exactly the poisoned state the rebuild exists to fix:
# an in-box /logout writes hasCompletedOnboarding:false into the live file.
# Claude 2.1.x gates its startup login/onboarding screen on that flag ALONE
# (verified in the binary), so every later session in the box re-prompts for
# login despite fresh shared credentials. The gate below therefore keys on
# hasCompletedOnboarding only: an already-onboarded box shows no login screen
# regardless of oauthAccount, so it short-circuits with no docker probe and no
# rewrite (this is what keeps an API-key box, which never has an oauthAccount,
# from running the pipeline on every single attach). oauthAccount is still
# injected from a sibling at create/start; a running box that is onboarded but
# identity-less simply doesn't need it to avoid the re-prompt.
#
# When it DOES heal (onboarding false) it goes through _build_project_claude_json,
# whose proj-then-host base preserves any box-written top-level state (e.g. a
# user-scoped mcpServers), then copies the temp over the SAME inode with a
# truncating cat (the bind mount pins the inode; an atomic mv would detach the
# container's view). It runs only past the liveness gate (docker top shows no
# claude/node; fail-safe: unknown counts as live), so no concurrent writer
# exists and the only reader (the claude this session is about to exec) starts
# after the write completes. Two simultaneous attaches can both heal; they
# write near-identical objects microseconds apart (last writer wins), a benign
# host-side race left deliberately unlocked.
_refresh_attached_claude_json() {
  local cname="$1" project="$2" box="$3"
  [[ -n "$project" ]] || return 0
  command -v jq &>/dev/null || return 0
  local key f
  key="$(_derive_project_session_key "$project" "$box")"
  f="$CLEAT_PROJECTS_DIR/${key}/claude.json"
  [[ -f "$f" && -s "$f" ]] || return 0
  # Cheap gate first: an onboarded box shows no login screen, nothing to fix,
  # no docker call. Only a logout-poisoned (or never-onboarded) box proceeds.
  jq -e '.hasCompletedOnboarding == true' "$f" >/dev/null 2>&1 && return 0
  _box_has_live_agent "$cname" && return 0
  local tmp="${f}.attach.$$"
  _build_project_claude_json "$tmp" "$f"
  # Refuse to copy anything that is not a healed object (a failed build leaves
  # {} or nothing): a truncating write must never make the file worse.
  if [[ -s "$tmp" ]] && jq -e '.hasCompletedOnboarding == true' "$tmp" >/dev/null 2>&1; then
    cat "$tmp" > "$f" 2>/dev/null || true
  fi
  rm -f "$tmp" 2>/dev/null
  return 0
}

# Print a notice box with dynamic width. Each argument is a line of plain text.
# Supports {BOLD}...{/BOLD} for bold spans within lines.
_notice_box() {
  local lines=("$@")
  local width=0
  local i line stripped

  # Find widest line
  for line in "${lines[@]}"; do
    stripped="${line//{BOLD\}/}"
    stripped="${stripped//{\/BOLD\}/}"
    local len=${#stripped}
    [[ $len -gt $width ]] && width=$len
  done

  # Draw box
  local border=""
  for (( i = 0; i < width + 4; i++ )); do border+="─"; done

  echo ""
  echo -e "  ${CYAN}┌${border}┐${RESET}"
  for line in "${lines[@]}"; do
    stripped="${line//{BOLD\}/}"
    stripped="${stripped//{\/BOLD\}/}"
    local pad=""
    for (( i = ${#stripped}; i < width; i++ )); do pad+=" "; done
    # Replace {BOLD}/{/BOLD} with actual escape codes
    local formatted="${line//\{BOLD\}/${BOLD}}"
    formatted="${formatted//\{\/BOLD\}/${RESET}}"
    echo -e "  ${CYAN}│${RESET}  ${formatted}${pad}  ${CYAN}│${RESET}"
  done
  echo -e "  ${CYAN}└${border}┘${RESET}"
  echo ""
}

# Resolve configuration drift between the current config and the existing
# container. Triggers: a changed capability (`cleat config --enable <cap>`), a
# changed env key, or a changed EXPLICITLY-configured resource limit
# ([resources] memory/cpus in .cleat). On TTY: prompt to recreate; on accept,
# stop+rm container and clean tmp dirs so the caller's existing "no container"
# path (cmd_run) recreates with the new config. On non-TTY or declined: print a
# warning and continue with the stale container.
#
# Only hashes written in the current storage format (the v<N>: prefix) are
# comparable. A legacy or unlabelled hash can't be recomputed (we no longer know
# the old formula or the VM size at creation), so a mismatch against it would be
# a guess: such containers are NOT nagged, and silently adopt the current format
# the next time they're recreated for a real reason. This is what makes a CLI
# upgrade that changes the fingerprint formula recreate-free.
_resolve_config_drift() {
  local cname="$1"
  local project="${2:-}"

  container_exists "$cname" || return 0

  local stored_hash current_hash
  stored_hash="$(_container_config_hash "$cname")"
  [[ "$stored_hash" == "v${_CONFIG_FP_VERSION}:"* ]] || return 0
  current_hash="v${_CONFIG_FP_VERSION}:$(compute_config_fingerprint "$project")"
  [[ "$stored_hash" == "$current_hash" ]] && return 0

  if _is_tty; then
    info "${BOLD}Config changed${RESET} since ${BOLD}${cname}${RESET} was created: its capabilities, environment, or resource limits differ from your current setup"
    local yn=""
    _ask_yn yn "Recreate ${BOLD}${cname}${RESET} now? [Y/n] "
    if [[ -z "$yn" || "$yn" == [yY]* ]]; then
      info "Recreating container..."
      if is_running "$cname"; then
        docker stop "$cname" > /dev/null 2>&1 || true
      fi
      docker rm -f "$cname" > /dev/null 2>&1 || true
      rm -rf "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
      success "Removed ${BOLD}${cname}${RESET}."
      return 0
    fi
    info "Skipped. Keeping existing container. Run ${BOLD}cleat rm && cleat${RESET} when ready."
    return 0
  fi

  info "${BOLD}Config changed${RESET} since ${BOLD}${cname}${RESET} was created. Recreate to apply: ${BOLD}cleat rm && cleat${RESET}"
}

# Image-content drift: the local image's baked content spec is OLDER than the
# spec this CLI ships, so it predates a real change under docker/ (entrypoint,
# clipboard/browser shims, the Dockerfile, a pinned base). Offer to refresh it
# as an interactive startup action, the same aligned Y/n prompt style (_ask_yn)
# as the other startup prompts. This is keyed to IMAGE CONTENT, not the CLI
# version: a version-only release leaves _IMAGE_SPEC_VERSION untouched and never
# nags. See concept/24-image-spec-versioning.md.
#
# Pre-stamping images (built before sh.cleat.image-spec existed) carry no spec
# label; their content is inferred from the version they were built at, so an
# image already at today's content stays silent and the cutover to this scheme
# forces no recreate. An image with neither label is left alone (fail open).
#
# On accept: acquire the current image, then drop this project's container so the
# normal start flow recreates it from the fresh image (the same mechanism
# _resolve_config_drift uses). Runs at most once per process, TTY-only, and only
# when the image content is strictly OLDER (never nags an equal-or-newer image).
_REBUILD_PROMPTED=0
_maybe_prompt_image_rebuild() {
  local cname="$1"
  _is_tty || return 0
  [[ "$_REBUILD_PROMPTED" == "1" ]] && return 0
  image_exists || return 0

  # Resolve the local image's content spec. Newer images carry an explicit
  # integer label; pre-stamping images infer it from their build version against
  # _IMAGE_SPEC_INTRO_VERSION (at/after intro == today's content == spec 1). An
  # image with no spec AND no version is exotic/hand-built: fail open, never nag.
  local stored_spec
  stored_spec="$(_image_spec_version)"
  if [[ -z "$stored_spec" ]]; then
    local image_version
    image_version="$(_image_cleat_version)"
    [[ -n "$image_version" ]] || return 0
    if _version_ge "$image_version" "$_IMAGE_SPEC_INTRO_VERSION"; then
      stored_spec=1
    else
      stored_spec=0
    fi
  fi
  # Guard a malformed label, then prompt only when the image content is strictly
  # older than what this CLI ships. Equal (current) or greater (a dev image
  # pulled ahead of the CLI) never nags. The 10# forces base 10 so a tampered
  # leading-zero label (e.g. 08) can't be misread as invalid octal and leak an
  # arithmetic error to stderr on the otherwise-silent start path.
  [[ "$stored_spec" =~ ^[0-9]+$ ]] || return 0
  (( 10#$stored_spec < 10#$_IMAGE_SPEC_VERSION )) || return 0
  _REBUILD_PROMPTED=1

  info "Cleat image is out of date: its setup predates this release ${DIM}(image content changed, not just the version)${RESET}"
  local yn=""
  _ask_yn yn "Refresh the image now? ${DIM}(downloads the prebuilt v${VERSION}, or builds it locally; recreates this project's container, discarding its writable layer)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    # Prefer pulling the released multi-arch image for THIS version: it ships
    # the exact tested setup and Claude build, and a download beats a ~2 min
    # local rebuild. Fall back to a local build only when the prebuilt image
    # isn't published (e.g. an unreleased dev VERSION). Same chain as cmd_run's
    # acquisition path, so an outdated image is refreshed the same way a missing
    # one is acquired. See concept/22 (multi-arch publish).
    _do_pull "$VERSION" || _do_build
    # Drop the existing container so the start flow recreates it from the fresh
    # image (its bind mounts and base layer are baked in at creation time).
    if container_exists "$cname"; then
      is_running "$cname" && docker stop "$cname" > /dev/null 2>&1 || true
      docker rm -f "$cname" > /dev/null 2>&1 || true
      rm -rf "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
    fi
  fi
}

# Reaper drift: containers created before Cleat passed --init have `su` as
# PID 1, which never reaps re-parented children. Orphans from agent subshells
# accumulate as zombies until the box hits its pids cap, fork() fails, and the
# session wedges mid-keystroke (`docker stop` also burns its full timeout,
# `su` doesn't forward SIGTERM either). Detect such boxes on start and offer a
# recreate, which picks up --init from the current creation flags. Same prompt
# family as _maybe_prompt_image_rebuild: TTY-only, once per process, fail-open.
_INIT_RECREATE_PROMPTED=0
_maybe_prompt_init_recreate() {
  local cname="$1"
  _is_tty || return 0
  [[ "$_INIT_RECREATE_PROMPTED" == "1" ]] && return 0
  container_exists "$cname" || return 0
  # {{json .HostConfig}} is version-portable: Init serializes as true / false /
  # null (very old daemons omit the key). Only an explicit true means a reaper
  # is present; an inspect failure stays silent: never block a start on it.
  local hostconfig
  hostconfig="$(docker inspect --format '{{json .HostConfig}}' "$cname" 2>/dev/null)" || return 0
  [[ -n "$hostconfig" ]] || return 0
  [[ "$hostconfig" == *'"Init":true'* ]] && return 0
  _INIT_RECREATE_PROMPTED=1

  info "Box ${BOLD}${cname}${RESET} predates the zombie reaper ${DIM}(long sessions can freeze at the pids cap)${RESET}"
  local yn=""
  _ask_yn yn "Recreate it now? ${DIM}(project files and Claude state survive; /tmp and apt installs don't)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    is_running "$cname" && { docker stop "$cname" > /dev/null 2>&1 || true; }
    docker rm -f "$cname" > /dev/null 2>&1 || true
    rm -rf "${CLEAT_RUN_DIR:?}/${cname}" 2>/dev/null || true
  fi
}

# ── First-run tip ──────────────────────────────────────────────────────────
_first_run_tip_file="$CLEAT_CONFIG_DIR/.tip-shown"

show_first_run_tip() {
  # Show tip if no config file and tip hasn't been shown
  if [[ ! -f "$CLEAT_GLOBAL_CONFIG" && ! -f "$_first_run_tip_file" ]]; then
    info "Tip: run ${BOLD}cleat config${RESET} to enable git access, env passthrough, and more"
    mkdir -p "$CLEAT_CONFIG_DIR"
    touch "$_first_run_tip_file"
  fi
}

# ── Startup output ─────────────────────────────────────────────────────────
#
# Caps display groups active caps by behavior: same UI on the landing page.
#   mount   green   git, ssh, env, hooks, gh    auth/identity, no install
#   sandbox amber   docker                      breaks isolation (host socket)
#
# When only one category has active caps the line collapses to the legacy
# single-line form (`Caps:    git, ssh`). With caps in two categories the
# renderer breaks them into a labeled block: the categorization itself
# teaches the user that the docker cap behaves differently.

# Map a single cap name to its display category. Stdout: mount|sandbox.
_cap_category() {
  case "$1" in
    docker) echo "sandbox" ;;
    *)      echo "mount" ;;
  esac
}

# Bucket ACTIVE_CAPS into _CAPS_MOUNT/_CAPS_SANDBOX globals.
_caps_bucket_active() {
  _CAPS_MOUNT=()
  _CAPS_SANDBOX=()
  local cap
  for cap in "${ACTIVE_CAPS[@]+"${ACTIVE_CAPS[@]}"}"; do
    case "$(_cap_category "$cap")" in
      sandbox) _CAPS_SANDBOX+=("$cap") ;;
      mount)   _CAPS_MOUNT+=("$cap") ;;
    esac
  done
}

# Render the active caps. Indent prefix, top-level label, single-line pad,
# and label color are parameters so the same renderer drives both the
# summary block (DIM label) and `cleat status` (BOLD label).
_print_caps() {
  local indent="${1:-  }"
  local label="${2:-Caps:}"
  local pad="${3:-      }"
  local label_color="${4:-$DIM}"

  [[ ${#ACTIVE_CAPS[@]} -eq 0 ]] && return 0
  _caps_bucket_active

  local cats=0
  [[ ${#_CAPS_MOUNT[@]}   -gt 0 ]] && cats=$((cats + 1))
  [[ ${#_CAPS_SANDBOX[@]} -gt 0 ]] && cats=$((cats + 1))

  if [[ $cats -le 1 ]]; then
    local color s
    if [[ ${#_CAPS_SANDBOX[@]} -gt 0 ]]; then
      color="$AMBER"; s="$(printf '%s, ' "${_CAPS_SANDBOX[@]}")"
    else
      color="$GREEN"; s="$(printf '%s, ' "${_CAPS_MOUNT[@]}")"
    fi
    s="${s%, }"
    s="$(_sanitize_repo_str "$s")"
    echo -e "${indent}${label_color}${label}${RESET}${pad}${color}${BOLD}${s}${RESET}"
    return 0
  fi

  echo -e "${indent}${label_color}${label}${RESET}"
  local s
  if [[ ${#_CAPS_MOUNT[@]} -gt 0 ]]; then
    s="$(printf '%s, ' "${_CAPS_MOUNT[@]}")"; s="${s%, }"
    s="$(_sanitize_repo_str "$s")"
    echo -e "${indent}  ${DIM}mount:${RESET}    ${GREEN}${BOLD}${s}${RESET}"
  fi
  if [[ ${#_CAPS_SANDBOX[@]} -gt 0 ]]; then
    s="$(printf '%s, ' "${_CAPS_SANDBOX[@]}")"; s="${s%, }"
    s="$(_sanitize_repo_str "$s")"
    echo -e "${indent}  ${DIM}sandbox:${RESET}  ${AMBER}${BOLD}${s}${RESET} ${DIM}(breaks isolation)${RESET}"
  fi
}

# Legacy entry point retained for tests and possible future inline use.
_print_startup_caps() {
  _print_caps "  " "Caps:" "      "
}

_print_summary_block() {
  local cname="$1"
  local project="${2:-}"
  echo ""
  echo -e "  ${DIM}Container:${RESET}  ${BLUE}${cname}${RESET}"
  if [[ -n "$project" ]]; then
    local _tilde='~'
    local display_path="${project/#$HOME/$_tilde}"
    # With the docker cap the container's workdir IS the host path (mounted at
    # its own path so $(pwd) and `docker run -v $(pwd)` resolve on the host
    # daemon; see the docker-cap mount block). Without it, the project lives at
    # /workspace. Show the truth for each case.
    if cap_is_active docker; then
      echo -e "  ${DIM}Project:${RESET}    ${display_path} ${DIM}(same path, sandboxed)${RESET}"
    else
      echo -e "  ${DIM}Project:${RESET}    ${display_path} ${DIM}→${RESET} /workspace"
    fi
  fi
  # A box's personality must never be invisible: show the enabled kit. The
  # selection file is hand-editable, so print its content as DATA (%s), never
  # through echo -e (same convention as cmd_describe).
  local _summary_kit
  _summary_kit="$(_box_kit_read "$cname")"
  if [[ -n "$_summary_kit" ]]; then
    printf '  %bKit:%b        %b%s%b\n' "$DIM" "$RESET" "$BLUE" "$_summary_kit" "$RESET"
  fi
  _print_caps "  " "Caps:" "       "
  _env_summary_inline "$project"
}

_env_summary_inline() {
  local project="${1:-}"
  local global_count=0
  local project_count=0
  local global_exists=false
  local project_exists=false

  if cap_is_active env 2>/dev/null; then
    if [[ -f "$CLEAT_GLOBAL_ENV" ]]; then
      global_exists=true
      global_count=$(_parse_env_file "$CLEAT_GLOBAL_ENV" | wc -l)
      global_count=$((global_count + 0))
    fi
    local _env_file
    _env_file="$(_project_env_file "$project" "${_BOX:-main}")"
    if [[ -n "$project" && -f "$_env_file" ]]; then
      project_exists=true
      project_count=$(_parse_env_file "$_env_file" | wc -l)
      project_count=$((project_count + 0))
    fi
  fi

  if $global_exists || $project_exists; then
    local msg=""
    if $global_exists; then
      msg+="${global_count} from ~/.config/cleat/env"
    fi
    if $project_exists; then
      [[ -n "$msg" ]] && msg+=", "
      msg+="${project_count} from $(basename "$_env_file")"
    fi
    echo -e "  ${DIM}Env:${RESET}        ${msg}"
  fi
}

# ── Clipboard bridge ──────────────────────────────────────────────────────
# DISABLE_AUTOUPDATER=1 turns off Claude Code's launch-time/background self-
# updater inside the container. Cleat owns Claude's version (it's baked into the
# image and updated via `cleat upgrade-claude`); an in-container self-update is
# ephemeral (reverts on recreate) AND has been observed to hang the TUI at launch
# on a freshly-(re)created container. Manual `claude update` / `claude doctor`
# still work. See docs.claude.com/en/setup#disable-auto-updates.
CLAUDE_ENV=(-e HOME=/home/coder -e DISABLE_AUTOUPDATER=1 -e PATH="/home/coder/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")

# TERM/COLORTERM are the two DELIBERATE host-templated entries: docker exec -t
# does not propagate the attached terminal's type, so without these the box's
# terminfo can mismatch the real terminal (wrong key sequences, degraded
# colors in iTerm2/Ghostty/tmux). Everything else from the host stays out,
# the exec_claude tests pin the exact key set.
CLAUDE_ENV+=(-e "TERM=${TERM:-xterm-256color}")
if [[ -n "${COLORTERM:-}" ]]; then
  CLAUDE_ENV+=(-e "COLORTERM=${COLORTERM}")
fi

# BROWSER must ride every exec, not just `docker run`: exec inherits the
# CONTAINER's Config.Env, frozen at create. A box created before v1.1.1 has no
# BROWSER there (and its image predates the ENV), so claude 2.1.191+ refuses to
# invoke any opener and login drops to the manual code-paste flow, silently,
# forever: the config fingerprint excludes cleat-injected env, so nothing ever
# nags a recreate. Injecting it here heals every existing box on its next
# session. The shim itself has shipped in the image since the bridge landed, so
# the target exists even in old boxes. CLAUDE_ENV precedes the user's [env]
# args on every exec line and docker's last -e wins, so a .cleat `BROWSER=`
# override still beats this, matching the create-time ordering. A one-shot
# `--env BROWSER=...` given only at create is overridden here on later
# sessions (exec -e beats the frozen Config.Env, as it already did for
# HOME/PATH/TERM); a lasting override belongs in the [env] config.
CLAUDE_ENV+=(-e "BROWSER=/usr/local/bin/open-bridge")

# IS_SANDBOX rides every exec only when the HOST user is root. Claude hard-
# refuses --dangerously-skip-permissions under uid 0 (its root/sudo guard,
# anthropics/claude-code#9184), and on a root-only host (a stock VPS image,
# `sudo cleat`) the entrypoint's uid remap makes coder uid 0, so every session
# died at launch with "Claude exited with code 1" right after a green
# bring-up. IS_SANDBOX=1 is upstream's own escape hatch for exactly this
# case, a sandboxed container (Anthropic's reference devcontainer sets it).
# Scoped to a root host so ordinary boxes keep an unchanged env, and injected
# at exec (not create) so existing root boxes heal on their next session.
if [[ "$(id -u)" == "0" ]]; then
  CLAUDE_ENV+=(-e "IS_SANDBOX=1")
fi

_host_clip_cmd() {
  if command -v pbcopy &>/dev/null; then echo pbcopy
  elif command -v xclip &>/dev/null; then echo "xclip -selection clipboard"
  elif command -v xsel &>/dev/null; then echo "xsel --clipboard"
  elif command -v wl-copy &>/dev/null; then echo wl-copy
  else echo ""
  fi
}

_clipboard_watcher() {
  local clip_dir="$1"
  local clip_cmd="$2"
  trap 'exit 0' TERM INT HUP
  # Same orphan story as _browser_watcher: a watcher whose cleat process died
  # without the cleanup trap (terminal closed, SIGKILL) must not keep writing
  # a dead session's box clipboard over the host clipboard. Checked at the
  # single copy choke point so all three watch modes are covered.
  local _cw_parent=$$

  # Remove any payload left over from an earlier session before advertising
  # readiness. A leftover means no watcher claimed it (teardown race, or a
  # crash that skipped cleanup); replaying it now would shove a dead
  # session's copy over whatever the user currently has on the host
  # clipboard (the stale-redelivery bug). Age-gated like the browser
  # bridge's startup sweep: concurrent watchers share this dir, and a FRESH
  # file is a live copy a sibling is about to claim, so only a file older
  # than several poll ticks is a true leftover. A NEGATIVE age (mtime ahead
  # of the clock after a backward clock step) also sweeps: failing toward
  # "never replay old bytes into the clipboard" is this bridge's safe
  # direction. _path_mtime returns 0 on failure, which reads as ancient and
  # still gets swept, so unreadable files fail safe too.
  local leftover_age
  if [ -f "$clip_dir/clipboard" ]; then
    leftover_age=$(( $(date +%s) - $(_path_mtime "$clip_dir/clipboard") ))
    if [ "$leftover_age" -gt 5 ] || [ "$leftover_age" -lt 0 ]; then
      rm -f "$clip_dir/clipboard" 2>/dev/null || true
    fi
  fi
  # Claims stranded by a watcher killed between rename and delivery are the
  # same kind of leftover: same age gate. A live claim is milliseconds old
  # and never matches.
  local stale_claim
  for stale_claim in "$clip_dir"/.claim.*; do
    [ -f "$stale_claim" ] || continue
    if [ $(( $(date +%s) - $(_path_mtime "$stale_claim") )) -gt 5 ]; then
      rm -f "$stale_claim" 2>/dev/null || true
    fi
  done

  touch "$clip_dir/.host-ready"

  # Consume-on-read, mirroring _browser_claim_url: atomically claim the
  # payload before piping it to the host clipboard, so a delivered copy no
  # longer exists on disk and can never be replayed by a later session's
  # watcher. When several watchers race (two sessions on one box), the
  # rename hands the payload to exactly one. Claiming also retires the old
  # mtime-second dedup, which silently swallowed a second copy written in
  # the same wall-clock second. The claim lives OUTSIDE the .clipboard.*
  # namespace on purpose: every session's exit sweeps .clipboard.* (the
  # shim's temp files) unconditionally, and a sibling exiting mid-delivery
  # must never delete this watcher's in-flight claim. Our own exit removes
  # .claim.$$.* and the startup sweep above catches claims stranded by a
  # crash.
  _do_copy() {
    kill -0 "$_cw_parent" 2>/dev/null || exit 0
    local claim="$clip_dir/.claim.$$.${RANDOM}"
    mv "$clip_dir/clipboard" "$claim" 2>/dev/null || return 0
    eval "$clip_cmd" < "$claim" 2>/dev/null || true
    rm -f "$claim" 2>/dev/null || true
  }

  if command -v inotifywait &>/dev/null; then
    while inotifywait -qq -e moved_to "$clip_dir" 2>/dev/null; do
      _do_copy
    done
    return
  fi

  if command -v fswatch &>/dev/null; then
    fswatch --event Updated --event Created -0 "$clip_dir" 2>/dev/null \
      | while IFS= read -r -d '' path; do
          case "$(basename "$path")" in clipboard) _do_copy ;; esac
        done
    return
  fi

  # Polling fallback. No mtime tracking: the payload only exists while a
  # copy is undelivered (the claim renames it away), so presence IS the
  # signal, and a pre-existing file can never masquerade as a fresh copy.
  while true; do
    kill -0 "$_cw_parent" 2>/dev/null || exit 0
    if [ -f "$clip_dir/clipboard" ]; then
      _do_copy
    fi
    sleep 1
  done
}

# ── Browser bridge ────────────────────────────────────────────────────────
# Watches for URLs written by the container's open-bridge shim and opens them
# on the host. Reuses the clipboard bridge dir ($CLEAT_RUN_DIR/<cname>/clip).

_host_open_cmd() {
  if command -v open &>/dev/null; then echo "open"
  elif command -v xdg-open &>/dev/null; then echo "xdg-open"
  else echo ""
  fi
}

# True when a URL is an OAuth authorization request: it carries a redirect_uri=
# query parameter. Claude Code logs in through two flows: the loopback flow
# (redirect_uri=http://localhost:PORT/callback, which the callback proxy
# completes hands-free) and the manual code-paste flow (redirect_uri on
# console.anthropic.com; the user pastes a code back into the terminal). BOTH
# must count as auth for _browser_should_open: an OAuth URL emitted
# programmatically through the container's open shim is never a terminal
# click, so deferring it like a plain link strands the login. Claude 2.1.x
# happens to hand its opener only the loopback URL today; this guards
# gh-auth-style flows and any future claude change that opens a non-loopback
# authorize URL. Only the loopback flow additionally earns a callback proxy;
# that stays keyed on _extract_callback_port below.
_is_auth_url() {
  case "$1" in
    *\?redirect_uri=*|*\&redirect_uri=*) return 0 ;;
  esac
  return 1
}

# Extracts the localhost port from a redirect_uri in an OAuth URL.
# Returns 0 and prints the port if found, returns 1 otherwise.
_extract_callback_port() {
  local url="$1"

  case "$url" in
    *redirect_uri=*) ;;
    *) return 1 ;;
  esac

  # Isolate the redirect_uri value
  local encoded="${url#*redirect_uri=}"
  encoded="${encoded%%&*}"
  encoded="${encoded%%#*}"

  # URL-decode (%XX → bytes)
  local decoded
  decoded=$(printf '%b' "${encoded//%/\\x}" 2>/dev/null) || return 1

  # Extract port from localhost:PORT or 127.0.0.1:PORT
  local port=""
  case "$decoded" in
    *localhost:*)  port="${decoded#*localhost:}" ;;
    *127.0.0.1:*) port="${decoded#*127.0.0.1:}" ;;
    *) return 1 ;;
  esac
  port="${port%%[^0-9]*}"

  [ -n "$port" ] && echo "$port" && return 0
  return 1
}

# TCP proxy: forwards one connection from host:PORT to container:PORT.
# Enables OAuth callbacks to reach Claude Code's HTTP server inside Docker.
# Uses socat on host if available, falls back to python3.
_auth_callback_proxy() {
  local port="$1"
  local cname="$2"
  local log_file="${3:-}"

  _proxy_log() { [ -n "$log_file" ] && echo "[proxy $(date +%H:%M:%S)] $*" >> "$log_file"; }

  trap 'exit 0' TERM INT HUP

  _proxy_log "starting: port=$port container=$cname"

  # Prefer socat on host → docker exec socat in container
  # Try IPv6 first (Node.js binds to ::1 when given "localhost"), fall back to IPv4
  # Use ignoreeof on the container side so stdin EOF doesn't kill the TCP read
  # Retry bind up to 30s if the port is temporarily busy
  if command -v socat &>/dev/null; then
    _proxy_log "using socat on host"
    local socat_rc=0 _attempt
    for _attempt in $(seq 1 30); do
      socat "TCP-LISTEN:${port},bind=127.0.0.1,reuseaddr" \
        "EXEC:sh -c 'docker exec -i ${cname} socat -,ignoreeof TCP6\\:localhost\\:${port} 2>/dev/null || docker exec -i ${cname} socat -,ignoreeof TCP\\:localhost\\:${port}'" \
        2>>"${log_file:-/dev/null}" && { socat_rc=0; break; } || socat_rc=$?
      [[ $socat_rc -eq 1 ]] || break
      [[ $_attempt -eq 1 ]] && _proxy_log "socat bind failed, retrying..."
      sleep 1
    done
    _proxy_log "socat exited with status $socat_rc"
    return
  fi

  # Fallback: python3 HTTP-aware proxy with retry
  if command -v python3 &>/dev/null; then
    _proxy_log "using python3 fallback"
    local py_rc=0
    python3 - "$port" "$cname" "$log_file" <<'PYEOF' || py_rc=$?
import socket, subprocess, sys, signal, os, time
log_file = sys.argv[3] if len(sys.argv) > 3 else None
def _log(msg):
    if log_file:
        try:
            with open(log_file, 'a') as f: f.write(f"[proxy-py {msg}]\n")
        except: pass
def _term(*_): os._exit(0)
signal.signal(signal.SIGTERM, _term)
signal.signal(signal.SIGINT, _term)
def _send_generic_success(conn):
    body = (b"<!doctype html><html><head><title>Authentication Successful</title>"
            b"<style>body{font-family:system-ui,-apple-system,sans-serif;max-width:32em;"
            b"margin:4em auto;padding:2em;text-align:center;color:#222}"
            b"h1{color:#22863a}</style></head><body>"
            b"<h1>Authentication Successful</h1>"
            b"<p>You can close this window and return to Claude Code.</p>"
            b"</body></html>")
    resp = (b"HTTP/1.1 200 OK\r\n"
            b"Content-Type: text/html; charset=utf-8\r\n"
            b"Content-Length: " + str(len(body)).encode() + b"\r\n"
            b"Connection: close\r\n\r\n" + body)
    try: conn.sendall(resp)
    except Exception: pass
port, cname = int(sys.argv[1]), sys.argv[2]
srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
if hasattr(socket, 'SO_REUSEPORT'):
    try: srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    except OSError: pass
# Retry bind: the port may be briefly held by another process
bound = False
for bind_attempt in range(30):
    try:
        srv.bind(('127.0.0.1', port))
        bound = True
        break
    except OSError as e:
        if bind_attempt == 0:
            _log(f"bind attempt 1 failed: {e}, retrying...")
        time.sleep(1)
if not bound:
    _log(f"bind failed after 30 attempts, giving up")
    sys.exit(0)
_log(f"listening on 127.0.0.1:{port}")
srv.listen(1)
srv.settimeout(300)
try:
    cli, addr = srv.accept()
    _log(f"accepted connection from {addr}")
    # Read the full HTTP request from the browser
    cli.settimeout(5)
    req_data = b""
    while True:
        try:
            chunk = cli.recv(4096)
            if not chunk: break
            req_data += chunk
            # HTTP request ends with \r\n\r\n (GET has no body)
            if b"\r\n\r\n" in req_data: break
        except socket.timeout: break
    _log(f"got {len(req_data)} bytes from browser")
    # Rewrite Connection: keep-alive → close so the container's server will
    # close the TCP connection after its response.
    req_data = req_data.replace(b"Connection: keep-alive", b"Connection: close      ")
    req_data = req_data.replace(b"connection: keep-alive", b"connection: close      ")
    # Forward to the container: try IPv6 first (Node.js binds to ::1), fall back to IPv4
    # Use `-,ignoreeof` so socat doesn't propagate stdin EOF to the TCP socket,
    # giving the container server time to write its response before closing.
    ok = False
    for proto in ['TCP6', 'TCP']:
        proc = subprocess.Popen(
            ['docker', 'exec', '-i', cname, 'socat', '-,ignoreeof', f'{proto}:localhost:{port}'],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            stdout, stderr = proc.communicate(input=req_data, timeout=30)
            errtxt = stderr.decode(errors='replace').strip() if stderr else ''
            if stdout:
                _log(f"forwarded OK via {proto}, got {len(stdout)} bytes back")
                cli.sendall(stdout)
                ok = True
                break
            if proc.returncode == 0:
                # Connection succeeded, request delivered, but no response bytes.
                _log(f"delivered via {proto} (empty response, assuming success)")
                _send_generic_success(cli)
                ok = True
                break
            if 'refused' in errtxt.lower():
                _log(f"{proto} connection refused, trying next")
                continue
            _log(f"{proto} failed rc={proc.returncode} stderr={errtxt}")
        except subprocess.TimeoutExpired:
            proc.kill()
            try: proc.wait(timeout=2)
            except subprocess.TimeoutExpired: pass
            _log(f"{proto} timed out, assuming code was delivered")
            _send_generic_success(cli)
            ok = True
            break
    if not ok:
        _log("forwarding failed on both IPv6 and IPv4")
        cli.sendall(b"HTTP/1.1 502 Bad Gateway\r\nContent-Type: text/html\r\n\r\n"
                    b"<h1>Cleat: callback forwarding failed</h1>"
                    b"<p>Could not reach Claude Code's auth server inside the container.</p>"
                    b"<p>Check <code>/tmp/cleat-clip/.proxy-log</code> for details.</p>")
    cli.close()
except socket.timeout:
    _log("timeout waiting for callback (300s)")
except Exception as e:
    _log(f"error: {e}")
finally: srv.close()
PYEOF
    _proxy_log "python3 proxy exited with status $py_rc"
    return
  fi

  _proxy_log "FAILED: neither socat nor python3 available on host"
}

# Atomically claim the URL pending in the bridge file. Prints the URL and returns
# 0 if THIS caller won the claim; returns 1 if there was nothing to claim. The
# rename is atomic, so when several watchers race on the same bridge file (e.g.
# an orphan left by a crashed/SIGKILL'd session plus the current one) exactly
# ONE wins per written URL. That makes a single in-container `open` open exactly
# one host tab instead of one-per-watcher (the duplicate-tab bug). Consuming the
# file also retires the old mtime-second dedup, which silently dropped a second
# URL written in the same wall-clock second.
_browser_claim_url() {
  local bridge_file="$1"
  [ -f "$bridge_file" ] || return 1
  local claim="${bridge_file}.opening.$$.${RANDOM}"
  mv "$bridge_file" "$claim" 2>/dev/null || return 1
  cat "$claim" 2>/dev/null || true
  rm -f "$claim" 2>/dev/null || true
  return 0
}

# Epoch mtime of a path, or 0 when it can't be read. GNU stat (-c) first, then
# BSD/macOS (-f).
_path_mtime() {
  local m
  # Trailing `|| echo ""` guarantees a zero exit (and empty output) when both
  # stats fail, so the binary's `set -e` can't trip on this assignment if the
  # marker is removed between the glob and the stat.
  m="$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo "")"
  case "$m" in ''|*[!0-9]*) m=0 ;; esac
  printf '%s' "$m"
}

# Same-URL debounce, shared across watchers via per-URL marker dirs in the clip
# dir. The atomic claim above makes each WRITE open exactly once, but one user
# action can produce SEVERAL writes: a TUI link click fires the open shim on both
# press and release, and tools retry. With a single watcher the 0.5s poll
# collapses rapid rewrites (the second write lands before the first is claimed);
# with overlapping watchers (a login alongside a session, two shells on one box,
# or an orphan from a crashed session) each watcher claims one write, so two
# writes become two tabs unless the debounce is shared.
#
# The debounce MUST be atomic. The earlier design read a `.last-open` stamp,
# decided "not seen", then wrote it: two watchers could both read "not seen"
# before either wrote, and both opened (the one-click-two-tabs bug that the
# atomic claim alone did not fix, seen with concurrent sessions). Here the
# test-and-set is a single `mkdir`: it succeeds for exactly ONE racer and fails
# with EEXIST for the rest, so only the winner opens, no matter how many watchers
# are live. The marker's own mtime (set atomically by mkdir, so there is no
# create-then-stamp gap a concurrent sweep could misread) is the clock; markers
# older than the window are swept on each claim, so the same URL opens again
# later and stale markers can't accumulate. Different URLs hash to different
# markers and never dedupe.
_BROWSER_DEBOUNCE_SECS=2
# Remove debounce markers older than the window. Fresh markers are load-bearing
# (a concurrent watcher's debounce), so ONLY expired ones go. Called on each
# claim and once at watcher start: a box whose last session never claims again
# would otherwise keep its final markers forever.
_browser_sweep_stale_markers() {
  local clip_dir="$1" now d
  now="$(date +%s)"
  for d in "$clip_dir"/.open.*; do
    [ -d "$d" ] || continue
    if [ $(( now - $(_path_mtime "$d") )) -gt "$_BROWSER_DEBOUNCE_SECS" ]; then
      rm -rf "$d" 2>/dev/null || true
    fi
  done
  return 0
}
_browser_recently_opened() {
  local clip_dir="$1" url="$2"
  local now hash lock
  now="$(date +%s)"
  # Sweep markers past the window (runs only when a URL was actually claimed, over
  # a handful of recent markers, so the cost is negligible).
  _browser_sweep_stale_markers "$clip_dir"
  # Filesystem-safe per-URL key. cksum is POSIX (present on macOS and Linux); a
  # collision would only over-dedupe two URLs fired within the same 2s, which
  # never happens in practice.
  hash="$(printf '%s' "$url" | cksum 2>/dev/null)"; hash="${hash// /_}"
  lock="$clip_dir/.open.$hash"
  if mkdir "$lock" 2>/dev/null; then
    return 1   # we won the atomic claim → open it
  fi
  return 0     # a fresh marker exists → another watcher already opened this URL
}

# Resolve the bridge open policy from CLEAT_BROWSER_BRIDGE. An unknown value
# falls back to the safe default rather than erroring, so a typo never wedges a
# session. Echoes one of: auto | always | off.
#   auto   (default): open auth/callback URLs always; defer PLAIN links to the
#                     host terminal when one is attached (it opens a clicked or
#                     autodetected URL itself), so the bridge never makes a
#                     duplicate tab. Off a terminal (piped) the bridge opens
#                     plain links too, since nothing else will.
#   always:           open every claimed http(s) URL (the pre-toggle behavior).
#   off:              never open a browser; the auth callback proxy still runs,
#                     and the claimed URL lands in the box's .proxy-log. The
#                     loopback URL is never printed by claude (2.1.191+ hands
#                     it only to $BROWSER), so the log is where to find it to
#                     open by hand; the printed code-paste flow needs no proxy.
_browser_bridge_mode() {
  case "${CLEAT_BROWSER_BRIDGE:-auto}" in
    always) printf 'always' ;;
    off)    printf 'off' ;;
    *)      printf 'auto' ;;
  esac
}

# Decide whether the bridge should open a claimed URL on the host. Pure (no I/O)
# so it is exhaustively unit-tested. Returns 0 to OPEN, 1 to DEFER.
# Args: $1 mode (auto|always|off), $2 host_opens_clicks (1 when an interactive
# host terminal is attached and will open the link itself), $3 is_auth (1 when
# the URL carries a localhost OAuth callback the user does not click).
_browser_should_open() {
  local mode="$1" host_opens_clicks="${2:-0}" is_auth="${3:-0}"
  case "$mode" in
    always) return 0 ;;
    off)    return 1 ;;
    *)  # auto
        [ "$is_auth" = 1 ] && return 0            # auth URL: the bridge owns it
        [ "$host_opens_clicks" = 1 ] && return 1  # plain link, terminal owns it
        return 0 ;;                               # plain link, no terminal: open
  esac
}

_browser_watcher() {
  local clip_dir="$1"
  local open_cmd="$2"
  local cname="${3:-}"
  local bridge_mode="${4:-auto}"
  local host_opens_clicks="${5:-0}"   # 1 when an interactive host terminal is attached
  local bridge_file="$clip_dir/.browser-open"
  local _proxy_pid=""
  # $$ is the spawning cleat process even inside this backgrounded function,
  # used below to reap orphans (see the liveness check in the loop).
  local _bw_parent=$$

  _bw_cleanup() {
    if [ -n "$_proxy_pid" ]; then
      kill "$_proxy_pid" 2>/dev/null || true
      wait "$_proxy_pid" 2>/dev/null || true
      _proxy_pid=""
    fi
  }
  trap '_bw_cleanup; exit 0' TERM INT HUP

  # Remove any URL left over from a previous session, and any debounce
  # markers that outlived their window (a box with no further claims never
  # sweeps them otherwise). Age-gated: concurrent watchers on one box are
  # supported (a login alongside a session, two shells), and a FRESH bridge
  # file is a live URL some sibling watcher is about to claim within one 0.5s
  # poll. The unconditional rm here swallowed it, stranding that login. Only a
  # file older than several polls is a true leftover. _path_mtime returns 0 on
  # failure, which reads as ancient and still gets swept, so this fails safe.
  if [ -f "$bridge_file" ] && [ $(( $(date +%s) - $(_path_mtime "$bridge_file") )) -gt 5 ]; then
    rm -f "$bridge_file"
  fi
  _browser_sweep_stale_markers "$clip_dir"
  while true; do
    # If the session's run dir was removed (cleat rm/clean/nuke), this watcher is
    # an orphan from a now-gone session: stop polling instead of spinning forever.
    [ -d "$clip_dir" ] || { _bw_cleanup; exit 0; }
    # If the cleat process that spawned this watcher is gone (terminal closed,
    # SIGKILL, anything that skips the cleanup trap), exit instead of polling
    # the box's clip dir forever. Leaked watchers are how one click became one
    # tab PER crashed session.
    kill -0 "$_bw_parent" 2>/dev/null || { _bw_cleanup; exit 0; }
    # Gate the claim's command-substitution behind a builtin `[ -f ]` so an IDLE
    # poll (no bridge file, the overwhelmingly common case) forks nothing but the
    # loop's `sleep`. Without the guard the `$(...)` forks a subshell every 0.5s
    # even when _browser_claim_url would immediately return 1, doubling this
    # watcher's idle fork rate and its contribution to host process pressure under
    # a heavy multi-agent run. Behavior is identical: _browser_claim_url also
    # returns 1 when the file is absent.
    local url=""
    if [ -f "$bridge_file" ] && url="$(_browser_claim_url "$bridge_file")"; then
      if _browser_recently_opened "$clip_dir" "$url"; then
        url=""   # duplicate of a just-opened URL; drop it
      fi
      if [[ "$url" == http://* ]] || [[ "$url" == https://* ]]; then
        local _is_auth=0 cb_port
        # Auth is ANY OAuth authorization URL, not just loopback ones: the
        # code-paste login flow has no localhost callback but must still open
        # (see _is_auth_url). The proxy below stays loopback-only.
        _is_auth_url "$url" && _is_auth=1
        # Start auth callback proxy if URL has a localhost redirect_uri. This
        # runs in every mode (off included): the proxy forwards the OAuth
        # callback into the box, so `cleat login` completes even when the user
        # opens the URL by hand.
        if [ -n "$cname" ]; then
          local proxy_log="$clip_dir/.proxy-log"
          cb_port=$(_extract_callback_port "$url" 2>/dev/null) && {
            _bw_cleanup  # kill any previous proxy
            echo "[browser-watcher $(date +%H:%M:%S)] extracted callback port=$cb_port from URL" >> "$proxy_log"
            _auth_callback_proxy "$cb_port" "$cname" "$proxy_log" &
            _proxy_pid=$!
            sleep 0.5  # let proxy bind before opening browser
          } || {
            echo "[browser-watcher $(date +%H:%M:%S)] no redirect_uri port found in URL" >> "$clip_dir/.proxy-log"
          }
        fi
        # Open on the host unless the policy defers to the terminal. A plain link
        # the user clicked is already opened by the host terminal itself; opening
        # it again here is the duplicate tab the maintainer reported. Auth URLs
        # and non-interactive sessions always open here (nothing else does).
        # Both outcomes are logged: a deferred URL is invisible otherwise, and
        # that silence is what made the code-paste login regression hard to
        # diagnose from the field.
        # Both lines carry the URL itself: the claim above consumed the bridge
        # file, so this log is the only place a deferred or off-mode URL still
        # exists. Claude 2.1.191+ hands the loopback authorize URL ONLY to
        # $BROWSER (never the terminal), so without the URL here an off-mode
        # loopback login would be unrecoverable by hand. Same trust domain as
        # the bridge file (the box's own run dir), so no new exposure.
        if _browser_should_open "$bridge_mode" "$host_opens_clicks" "$_is_auth"; then
          echo "[browser-watcher $(date +%H:%M:%S)] opening URL on host (mode=$bridge_mode auth=$_is_auth) url=$url" >> "$clip_dir/.proxy-log"
          $open_cmd "$url" >/dev/null 2>&1 || true
        else
          echo "[browser-watcher $(date +%H:%M:%S)] deferring URL to terminal (mode=$bridge_mode interactive=$host_opens_clicks auth=$_is_auth) url=$url" >> "$clip_dir/.proxy-log"
        fi
      fi
    fi
    sleep 0.5
  done
}

# ── Host-side hook bridge ─────────────────────────────────────────────────
# Tails forwarded events and executes the user's host-defined command hooks.
# The settings overlay replaces hook commands with an event forwarder inside
# the container; this bridge reads those events and runs the real commands.
_HOOK_BRIDGE_PID=""
_HOOK_BRIDGE_CHILDREN=()

_has_host_hooks() {
  local f
  for f in "${HOME}/.claude/settings.json" "${_RESOLVED_PROJECT:-.}/.claude/settings.json" "${_RESOLVED_PROJECT:-.}/.claude/settings.local.json"; do
    if [[ -s "$f" ]] && jq -e '.hooks // empty | length > 0' "$f" >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

_hook_bridge_watcher() {
  local hooks_file="$1"
  # Orphan guard, as in _browser_watcher: a bridge whose cleat process died
  # without the cleanup trap must not keep executing host hooks for a dead
  # session. $$ is the spawning cleat process even in this backgrounded call.
  local _hb_parent=$$
  # Collect all settings files that define hooks (global + project)
  local settings_files=()
  local f
  for f in "${HOME}/.claude/settings.json" "${_RESOLVED_PROJECT:-.}/.claude/settings.json" "${_RESOLVED_PROJECT:-.}/.claude/settings.local.json"; do
    [[ -s "$f" ]] && settings_files+=("$f")
  done
  # On exit: kill all child hook processes
  trap '_hook_bridge_cleanup; exit 0' TERM INT HUP
  trap '_hook_bridge_cleanup' EXIT

  # Wait for hooks file to appear
  local waited=0
  while [[ ! -f "$hooks_file" ]] && [[ $waited -lt 30 ]]; do
    kill -0 "$_hb_parent" 2>/dev/null || return 0
    sleep 1
    waited=$((waited + 1))
  done
  [[ -f "$hooks_file" ]] || return 0

  # Tail new lines and execute matching host hooks.
  # We track our byte offset to avoid wc -l / tail race conditions.
  # Start from the current end of the file to skip events from prior sessions.
  local byte_offset
  byte_offset=$(wc -c < "$hooks_file" 2>/dev/null || echo 0)
  byte_offset=$((byte_offset + 0))
  while true; do
    # Liveness BEFORE processing: an orphaned bridge must not run one last
    # batch of host hooks for a session whose cleat process is already gone.
    kill -0 "$_hb_parent" 2>/dev/null || { _hook_bridge_cleanup; exit 0; }
    local file_size
    file_size=$(wc -c < "$hooks_file" 2>/dev/null || echo 0)
    file_size=$((file_size + 0))

    if [[ $file_size -gt $byte_offset ]]; then
      # Reap finished children
      _hook_bridge_reap

      # Read new lines since last offset
      while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        _execute_host_hook_bg "$line" "${settings_files[@]}"
      done < <(tail -c +"$((byte_offset + 1))" "$hooks_file" 2>/dev/null)

      byte_offset=$file_size
    fi
    sleep 0.5
  done
}

# Reap finished child processes from the tracking array
_hook_bridge_reap() {
  local alive=()
  for pid in "${_HOOK_BRIDGE_CHILDREN[@]+"${_HOOK_BRIDGE_CHILDREN[@]}"}"; do
    if kill -0 "$pid" 2>/dev/null; then
      alive+=("$pid")
    else
      wait "$pid" 2>/dev/null || true
    fi
  done
  _HOOK_BRIDGE_CHILDREN=("${alive[@]+"${alive[@]}"}")
}

# Kill all tracked children.
# These run inside the bridge's process group (which is disowned from the parent).
# We kill them directly: no wait needed since they're in our own process tree.
_hook_bridge_cleanup() {
  for pid in "${_HOOK_BRIDGE_CHILDREN[@]+"${_HOOK_BRIDGE_CHILDREN[@]}"}"; do
    kill "$pid" 2>/dev/null || true
  done
  # Brief pause to let children exit, then reap
  sleep 0.1 2>/dev/null || true
  for pid in "${_HOOK_BRIDGE_CHILDREN[@]+"${_HOOK_BRIDGE_CHILDREN[@]}"}"; do
    wait "$pid" 2>/dev/null || true
  done
  _HOOK_BRIDGE_CHILDREN=()
}

# Execute a single event's host hooks in a tracked background subprocess.
_execute_host_hook_bg() {
  local event_json="$1"
  shift
  local settings_files=("$@")

  ( _execute_host_hooks "$event_json" "${settings_files[@]}" ) &
  _HOOK_BRIDGE_CHILDREN+=("$!")
}

_execute_host_hooks() {
  local event_json="$1"
  shift
  local settings_files=("$@")

  local event_name
  event_name="$(echo "$event_json" | jq -r '.hook_event_name // empty' 2>/dev/null)" || return 0
  [[ -n "$event_name" ]] || return 0

  # Get the tool name for matcher support
  local tool_name
  tool_name="$(echo "$event_json" | jq -r '.tool_name // empty' 2>/dev/null)" || true

  # Process hooks from all settings files (global + project)
  local settings
  for settings in "${settings_files[@]}"; do
    local hook_entries
    hook_entries="$(jq -c ".hooks.\"$event_name\" // [] | .[]" "$settings" 2>/dev/null)" || continue
    [[ -n "$hook_entries" ]] || continue

    while IFS= read -r entry; do
      [[ -n "$entry" ]] || continue

      # Check matcher (regex against tool_name for tool events)
      local matcher
      matcher="$(echo "$entry" | jq -r '.matcher // empty' 2>/dev/null)" || true
      if [[ -n "$matcher" && -n "$tool_name" ]]; then
        echo "$tool_name" | grep -qE "$matcher" 2>/dev/null || continue
      fi

      # Execute each command hook in the entry
      while IFS= read -r hook; do
        [[ -n "$hook" ]] || continue
        local cmd
        cmd="$(echo "$hook" | jq -r '.command // empty' 2>/dev/null)" || continue
        [[ -n "$cmd" ]] || continue

        # Execute on the host with event JSON on stdin.
        # Timeout after 30s to prevent hung hooks from blocking the bridge.
        if command -v timeout >/dev/null 2>&1; then
          echo "$event_json" | timeout 30 bash -c "$cmd" >/dev/null 2>&1 || true
        else
          echo "$event_json" | bash -c "$cmd" >/dev/null 2>&1 || true
        fi
      done < <(echo "$entry" | jq -c '.hooks // [] | .[] | select(.type == "command")' 2>/dev/null)
    done <<< "$hook_entries"
  done
}

# Block until the container's entrypoint has finished remapping the `coder`
# user from the image-baked UID to the host UID, before we exec a session into
# it. `docker exec` works the instant PID 1 exists, which can be BEFORE the
# entrypoint rewrites /etc/passwd. If we exec into that window, `runuser -u
# coder` resolves the STALE uid, so clip-daemon and claude run as the wrong
# user: claude can't write its host-owned config/auth (it hangs), and clip-daemon
# stamps its runtime files with the wrong owner, which later, correctly-mapped
# sessions can't clean from the sticky /tmp (the historical clip-EPERM storm).
# Best-effort gate: a running container's `id -u coder` is always numeric, so an
# empty/non-numeric reply means "can't determine" (broken exec) and we proceed
# rather than stall; a valid-but-mismatched uid means the remap is still in
# flight, so we keep polling (≤5s).
_wait_for_coder_remap() {
  local cname="$1" want got i=0
  want="$(id -u)"
  while [ "$i" -lt 50 ]; do
    got="$(docker exec "$cname" id -u coder 2>/dev/null)"
    case "$got" in
      ''|*[!0-9]*) return 0 ;;
    esac
    [ "$got" = "$want" ] && return 0
    i=$((i + 1))
    sleep 0.1
  done
  return 0
}

# Docker-capability session-start hardening (see concept/15-docker-capability.md).
# _heal_docker_sock: re-resolve the docker.sock owning GID and re-add coder to
# that group, AS ROOT, before each session exec. The entrypoint does this once
# at container start, but a Docker Desktop restart / daemon update can change the
# socket GID under a long-running (days-of-uptime) container, and a bare
# `docker exec` never re-runs the entrypoint, so `cleat`/`cleat shell` then fail
# with "permission denied /var/run/docker.sock". Inlined (not a baked image
# script) so it heals already-running containers without a rebuild; the following
# `runuser -u coder` re-runs initgroups and picks up the new group. Idempotent:
# groupmod re-points docker-host across GID changes instead of accreting groups.
_heal_docker_sock() {
  local cname="$1" _to=""
  command -v timeout >/dev/null 2>&1 && _to="timeout 10"
  $_to docker exec -u 0 "$cname" sh -c '
    [ -S /var/run/docker.sock ] || exit 0
    g=$(stat -c %g /var/run/docker.sock 2>/dev/null) || exit 0
    case "$g" in ""|*[!0-9]*) exit 0 ;; esac
    [ "$g" = "$(id -g coder)" ] && exit 0
    owner=$(getent group "$g" | cut -d: -f1)
    if [ -z "$owner" ]; then
      if getent group docker-host >/dev/null 2>&1; then groupmod -g "$g" docker-host 2>/dev/null || true
      else groupadd -g "$g" docker-host 2>/dev/null || true; fi
      owner=$(getent group "$g" | cut -d: -f1)
    fi
    [ -n "$owner" ] && usermod -aG "$owner" coder 2>/dev/null || true
  ' >/dev/null 2>&1 || true
}

# Ensure the docker cap can reach the daemon before a session. No-op unless the
# docker cap is active. Runs the per-exec GID self-heal, then probes as root: if
# even root can't reach the daemon, the socket bind is a stale inode (Docker
# replaced /var/run/docker.sock under the running container): no group fix can
# repair that in place, so guide the user to the re-bind recovery rather than
# silently failing. We do NOT auto-restart: a restart would kill any live
# session sharing this container.
_ensure_docker_access() {
  local cname="$1"
  cap_is_active docker 2>/dev/null || return 0
  _heal_docker_sock "$cname"
  local _to=""
  command -v timeout >/dev/null 2>&1 && _to="timeout 8"
  if ! $_to docker exec -u 0 "$cname" docker version >/dev/null 2>&1; then
    warn "Docker socket unreachable in this container ${DIM}(the daemon likely restarted)${RESET}"
    echo -e "    ${DIM}A stale socket bind can't be repaired in place. Recover with:${RESET}"
    echo -e "    ${BOLD}cleat stop && cleat resume${RESET}${DIM}  re-binds the socket; your session is preserved.${RESET}"
  fi
}

# Run a project's [setup] provisioning inside its box, once per container
# (see _build_setup_payload / concept/16). Never blocks a session: any skip
# or failure is a warn/info, and the function always returns 0. Sets
# _SETUP_LAST_RC (0 on success or any skip, the payload's own exit code on a
# failed run) so the explicit `cleat setup` verb can propagate a real exit
# status; every session caller (cmd_run/cmd_start/cmd_resume/cmd_claude)
# ignores it.
# $1 = container name, $2 = project path, $3 = box (default main), $4 =
# force (default 0; "1" bypasses the run-once marker, used only by the
# explicit `cleat setup` verb so the user can deliberately re-run).
_maybe_run_setup() {
  local cname="$1" project="$2" box="${3:-main}" force="${4:-0}"
  _SETUP_LAST_RC=0
  [[ "${_SETUP_DECLARED:-0}" == "1" ]] || return 0
  [[ "${_SETUP_TRUSTED:-0}" == "1" ]] || return 0  # resolve_caps already messaged any skip
  is_running "$cname" || return 0

  # A single invocation can reach this twice for one container: cmd_start's
  # stale-mount branch recreates via cmd_run (which runs setup) then falls
  # through to cmd_start's own post-start call. A success writes the marker
  # so the second call is a silent no-op, but a FAILED run leaves no marker,
  # so without this guard the failing payload would run and warn twice. The
  # explicit verb (force=1) always runs.
  if [[ "$force" != "1" ]]; then
    case "$_SETUP_ATTEMPTED" in
      *"|$cname|"*) return 0 ;;
    esac
  fi

  # TOCTOU close: rebuild the payload from disk right now and re-hash it, so
  # the bytes that run are byte-identical to what was approved, never a
  # rewrite an in-box agent made to /workspace/.cleat between approval (in
  # resolve_caps, earlier in this invocation) and this exec.
  local payload
  payload="$(_build_setup_payload "$project" "$box")" || {
    # _build_setup_payload already warned about the specific bad directive.
    warn "Project [setup] is invalid, skipped ${DIM}(run a cleat command again to review)${RESET}"
    return 0
  }
  [[ -z "$payload" ]] && return 0

  local hash stored
  hash="$(_setup_payload_hash "$payload")"
  stored="$(_trust_lookup_setup "$project" "$box")"
  [[ "$hash" == "$stored" ]] || {
    warn "Project [setup] changed since it was approved, skipped ${DIM}(run a cleat command again to review and approve)${RESET}"
    return 0
  }

  # Run-once marker, in-container. The explicit `cleat setup` verb (force=1)
  # bypasses this so the user can deliberately re-run.
  if [[ "$force" != "1" ]]; then
    local marker
    marker="$(docker exec "$cname" cat /home/coder/.cleat-setup-applied 2>/dev/null || true)"
    [[ "$marker" == "$hash" ]] && return 0
  fi

  _wait_for_coder_remap "$cname"
  _SETUP_ATTEMPTED="${_SETUP_ATTEMPTED}|$cname|"

  local caps_file count
  caps_file="$(_project_caps_file "$project" "$box")"
  count="$(_read_setup_from_file "$caps_file" | wc -l | tr -d ' ')"
  info "Running project setup ${DIM}(${count} command(s), [setup] in $(basename "$caps_file"))${RESET}"

  # Stage the payload into a file in the box, then run that file rather than
  # feeding it on stdin. Two reasons, both about correctness of the exit
  # code: (1) a setup command that itself reads stdin (ssh, apt without -y,
  # any `read`) would otherwise swallow the rest of the script off the same
  # pipe; (2) a large payload where the in-box bash exits before draining
  # the pipe would SIGPIPE the feeder, and pipefail would report that 141 as
  # the run's status even on success. The run exec omits -i so the script's
  # stdin is closed (EOF), decoupling command stdin from the script source.
  # `runuser -u coder` (not docker exec --user): see exec_claude's rationale
  # (--user skips initgroups(3), so supplementary groups never load).
  local runfile="/home/coder/.cleat-setup.run"
  docker exec "$cname" runuser -u coder -- rm -f "$runfile" >/dev/null 2>&1 || true
  printf '%s' "$payload" | docker exec -i "$cname" runuser -u coder -- tee "$runfile" >/dev/null 2>&1 || true
  local rc=0
  docker exec -e HOME=/home/coder -w /workspace "$cname" \
    runuser -u coder -- bash -e "$runfile" || rc=$?
  docker exec "$cname" runuser -u coder -- rm -f "$runfile" >/dev/null 2>&1 || true

  if [[ $rc -eq 0 ]]; then
    printf '%s\n' "$hash" | docker exec -i "$cname" runuser -u coder -- tee /home/coder/.cleat-setup-applied >/dev/null 2>&1 || true
    success "Setup applied ${DIM}(${count} command(s))${RESET}"
  else
    warn "Setup failed with exit code ${rc} ${DIM}(the box is up, provisioning did not finish)${RESET}"
    echo -e "    ${DIM}Fix .cleat or the box, then retry with: cleat setup${RESET}"
    _SETUP_LAST_RC="$rc"
  fi
  return 0
}

exec_claude() {
  local cname="$1"
  shift

  _CLIP_DIR="$CLEAT_RUN_DIR/${cname}/clip"
  _CLIP_WATCHER_PID=""
  _BROWSER_WATCHER_PID=""
  _HOOK_BRIDGE_PID=""
  mkdir -p "$_CLIP_DIR"
  # Stamp this box's run dir with an ATTACH timestamp for the idle sweep's grace
  # gate. The dir's own mtime would otherwise freeze at creation (writes go into
  # the clip/ subdir, not the dir itself), so the grace would measure age-since
  # -creation, not idle-since-detach. _cleanup_session re-stamps it on detach, so
  # `now - mtime(run dir)` is the true time since the session last had a host
  # process. Fail-soft.
  touch "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true

  # On macOS, bridge the host Keychain's OAuth token into the box before Claude
  # launches (the ~/.claude mount is live, so a write here is visible inside the
  # running container). No-op off macOS or once the box already has a token.
  _seed_macos_credentials

  # Heal a logged-out or identity-less ~/.claude.json in the RUNNING box before
  # Claude launches (in-place, liveness-gated; see _refresh_attached_claude_json).
  _refresh_attached_claude_json "$cname" "${_RESOLVED_PROJECT:-}" "${_BOX:-main}"

  _cleanup_session() {
    # Kill clipboard watcher
    if [ -n "${_CLIP_WATCHER_PID:-}" ]; then
      kill "$_CLIP_WATCHER_PID" 2>/dev/null || true
      # A TERM is deferred while the watcher sits blocked in its foreground
      # inotifywait/fswatch (bash runs traps only after the foreground
      # command returns), and the wait below cannot reap it (the watcher was
      # disowned at spawn, so wait returns at once). Without killing the
      # blocking child too, the watcher and its inotifywait outlive the
      # session as orphans that exit only on the next clipboard event, if
      # ever. Harmless in the polling fallback (the child is at worst a
      # sleep). No-op where pkill is absent.
      pkill -P "$_CLIP_WATCHER_PID" 2>/dev/null || true
      wait "$_CLIP_WATCHER_PID" 2>/dev/null || true
      _CLIP_WATCHER_PID=""
    fi
    # Kill browser watcher (and its callback proxy child)
    if [ -n "${_BROWSER_WATCHER_PID:-}" ]; then
      kill "$_BROWSER_WATCHER_PID" 2>/dev/null || true
      wait "$_BROWSER_WATCHER_PID" 2>/dev/null || true
      _BROWSER_WATCHER_PID=""
    fi
    # Kill hook bridge: its EXIT/TERM trap kills child hook processes
    if [ -n "${_HOOK_BRIDGE_PID:-}" ]; then
      kill "$_HOOK_BRIDGE_PID" 2>/dev/null || true
      wait "$_HOOK_BRIDGE_PID" 2>/dev/null || true
      _HOOK_BRIDGE_PID=""
    fi
    _cleanup_spin
    rm -f "${_CLIP_DIR:?}/.clipboard."*
    # Own claims only: another session's live claim in this shared dir must
    # survive our exit (see _do_copy's claim-name note).
    rm -f "${_CLIP_DIR:?}/.claim.$$."*
    rm -f "${_CLIP_DIR:?}/.browser-open"
    rm -f "$_CLIP_DIR/.watcher.$$"
    if ! ls "$_CLIP_DIR"/.watcher.* >/dev/null 2>&1; then
      rm -f "$_CLIP_DIR/.host-ready"
    fi
    # Re-stamp the run dir on detach so the idle sweep's grace measures time since
    # THIS session let go, not since the container was created (see the attach
    # touch above). Fail-soft.
    touch "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
  }

  # The per-box watcher log (target of the redirects below). Cap it on session
  # start and record the post-cap size, which is this session's read offset for
  # the end-of-session fork diagnostic.
  local _watcher_log="$_CLIP_DIR/.watcher-log" _watcher_log_off
  _watcher_log_off="$(_cap_watcher_log "$_watcher_log")"

  local clip_cmd
  clip_cmd="$(_host_clip_cmd)"
  if [ -n "$clip_cmd" ]; then
    touch "$_CLIP_DIR/.watcher.$$"
    # Redirect the watcher's own stdout+stderr to a per-box log, NOT the
    # terminal. Under heavy multi-agent load the host can hit its process cap,
    # and a backgrounded watcher that inherits the interactive terminal's fd 2
    # prints bash's own "fork: Resource temporarily unavailable" straight into
    # the Claude Code TUI, corrupting it. The watcher never has anything the
    # user should see (it drives pbcopy and marker files, never the terminal),
    # so a log keeps fork spew and any stray output off-screen but debuggable.
    # `.watcher-log` (hyphen) stays clear of the `.watcher.*` liveness glob.
    _clipboard_watcher "$_CLIP_DIR" "$clip_cmd" >>"$_CLIP_DIR/.watcher-log" 2>&1 &
    _CLIP_WATCHER_PID=$!
    disown "$_CLIP_WATCHER_PID" 2>/dev/null || true
  fi

  # Start browser watcher (always-on, like host connectivity). Pass whether an
  # interactive host terminal is attached: if so, it opens clicked links itself,
  # so the bridge defers plain links (no duplicate tab). See _browser_should_open.
  local open_cmd
  open_cmd="$(_host_open_cmd)"
  if [ -n "$open_cmd" ]; then
    local _bw_interactive=0
    _is_tty && _bw_interactive=1
    # Same terminal-safety redirect as the clipboard watcher: this loop opens
    # URLs (`$open_cmd ... >/dev/null 2>&1`) and logs to .proxy-log, so it never
    # needs the terminal, and a fork failure under load must not spew into the
    # TUI. Its callback-proxy child inherits these fds, so it is covered too.
    _browser_watcher "$_CLIP_DIR" "$open_cmd" "$cname" "$(_browser_bridge_mode)" "$_bw_interactive" >>"$_CLIP_DIR/.watcher-log" 2>&1 &
    _BROWSER_WATCHER_PID=$!
    disown "$_BROWSER_WATCHER_PID" 2>/dev/null || true
  fi

  # Start host-side hook bridge if user has hooks and hooks cap is active
  local hooks_file="$CLEAT_RUN_DIR/${cname}/hooks/events.jsonl"
  if cap_is_active hooks 2>/dev/null && _has_host_hooks 2>/dev/null; then
    # Terminal-safety redirect (see the clipboard watcher). The bridge runs hook
    # commands `>/dev/null 2>&1` and its `( _execute_host_hooks ) &` children
    # inherit these fds, so both the bridge and its children keep fork spew off
    # the TUI while staying debuggable in the log.
    _hook_bridge_watcher "$hooks_file" >>"$_CLIP_DIR/.watcher-log" 2>&1 &
    _HOOK_BRIDGE_PID=$!
    disown "$_HOOK_BRIDGE_PID" 2>/dev/null || true
  fi

  trap _cleanup_session EXIT INT TERM HUP

  # Don't launch the session until the UID remap has landed (see helper above).
  _wait_for_coder_remap "$cname"

  local rc=0
  _ensure_docker_access "$cname"
  # Use `runuser -u coder` rather than `docker exec --user coder` because the
  # latter sets UID/GID but skips initgroups(3), so supplementary groups from
  # /etc/group aren't loaded. This matters for the docker capability, where
  # the entrypoint adds coder to the host docker socket's owning group.
  # Pin node's heap to the box's real memory budget. Node sizes its default
  # heap ceiling from the cgroup limit, so before the limits were right-sized
  # it believed ~8g was available inside a 7.75g VM. 60% of the box limit
  # leaves headroom for non-heap memory (buffers, workers, the shell). A
  # user-supplied NODE_OPTIONS via env passthrough appears LATER on the exec
  # command line and wins: this is a default, not a straitjacket.
  local _heap_env=()
  local _mem_bytes _heap_mb
  _mem_bytes="$(docker inspect "$cname" --format '{{.HostConfig.Memory}}' 2>/dev/null)" || _mem_bytes=""
  if [[ "$_mem_bytes" =~ ^[0-9]+$ ]] && (( _mem_bytes > 0 )); then
    _heap_mb=$(( _mem_bytes * 60 / 100 / 1048576 ))
    (( _heap_mb > 0 )) && _heap_env=(-e "NODE_OPTIONS=--max-old-space-size=${_heap_mb}")
  fi

  # The inner script must exit with CLAUDE's status, not the clip-daemon
  # cleanup's: `wait` on the TERM-trapped daemon reports 0, which used to mask
  # a crashed claude (SIGSEGV=139, SIGABRT=134) as a clean session end, and
  # the rc==0 branch below then ERASED the crash message bash had just printed.
  # Host-side docker errors ('exec failed' during fork lockup, daemon resets)
  # go to a temp file and surface on failure instead of vanishing.
  local _exec_err="/tmp/cleat-exec-err.$$"
  docker exec -it "${CLAUDE_ENV[@]}" \
    "${_heap_env[@]+"${_heap_env[@]}"}" \
    "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" "$cname" \
    runuser -u coder -- bash -c '
      clip-daemon &
      _MY_CLIP_DAEMON=$!
      for i in 1 2 3 4 5; do [ -S "${CLEAT_CLIP_DIR:-/tmp/cleat-run-$(id -u)}/clip.sock" ] && break; sleep 0.1; done
      claude "$@"
      _CLAUDE_RC=$?
      kill "$_MY_CLIP_DAEMON" 2>/dev/null
      wait "$_MY_CLIP_DAEMON" 2>/dev/null
      exit "$_CLAUDE_RC"
    ' _ "$@" 2>"$_exec_err" || rc=$?

  _cleanup_session
  trap - EXIT INT TERM HUP
  _restore_terminal

  if [[ $rc -eq 0 ]]; then
    # Reclaim claude's leftover trailing line (cursor up, erase it), drop back
    # down, then clear the line success is about to write on. Without that final
    # \033[2K, success() prints from column 0 without erasing to end-of-line, so
    # stale bytes a heavily-used terminal left on that row survive past the
    # message (observed: a stray hash tail after "cleat resume"). TTY-gated so
    # no escapes ever reach a pipe.
    _is_tty && printf '\033[A\033[2K\r\n\033[2K'
    success "Session ended. Resume with: ${BOLD}cleat resume${RESET}"
  elif [[ $rc -ne 130 ]]; then
    warn "Claude exited with code $rc"
    [[ -s "$_exec_err" ]] && error "${DIM}$(cat "$_exec_err")${RESET}"
    _maybe_explain_oom "$cname" "$rc" "${_mem_bytes:-}"
  fi

  # If the host ran out of process slots this session (watcher logged fork
  # errors), explain it once. Placed AFTER the rc==0 reclaim: on success that
  # reclaim does `\033[A\033[2K` to erase claude's leftover line, and running
  # this first would put the advisory's last (most actionable) line directly
  # above the cursor, where the reclaim would wipe it. Independent of rc: the box
  # session usually SUCCEEDS while the host-side watchers are the ones that could
  # not fork.
  _maybe_explain_fork_exhaustion "$_watcher_log" "$_watcher_log_off"
  rm -f "$_exec_err"
}

# When a session dies from memory pressure, name it and say what to do: an
# unexplained exit-137/crash sends users hunting in the wrong place. Two
# signals: the box's cgroup OOM flag (State.OOMKilled, set when its own process
# tree is OOM-killed) or exit 137 (SIGKILL, the kernel OOM-killer's signature
# when it picks Claude itself). The classic trigger is a test runner: jest and
# vitest size their worker pool to the CPU count, and a box sees ALL host cores
# (CPU is unconfigured by default; concept/22), so a 2 GB box can spawn ~one
# node worker per core and blow its ceiling. There is no swap to absorb the
# spike (by design), so the spike is killed, not paged. This is guidance, not a
# fix: the user picks more memory, fewer workers, or a CPU cap. Fail-soft: an
# unreadable inspect just falls back to the exit-code signal.
_maybe_explain_oom() {
  local cname="$1" rc="$2" mem_bytes="${3:-}"
  local oomkilled=""
  oomkilled="$(docker inspect --format '{{.State.OOMKilled}}' "$cname" 2>/dev/null || true)"
  [[ "$oomkilled" == "true" || "$rc" == "137" ]] || return 0
  local mem_note=""
  if [[ "$mem_bytes" =~ ^[0-9]+$ ]] && (( mem_bytes > 0 )); then
    mem_note=" ${DIM}(box limit: $(( mem_bytes / 1073741824 )) GB)${RESET}"
  fi
  echo ""
  warn "${BOLD}Out of memory${RESET}. The box hit its memory ceiling${mem_note} and the kernel killed the process."
  echo -e "    ${DIM}Test runners are the usual cause: jest/vitest start one worker per CPU, and a box${RESET}"
  echo -e "    ${DIM}sees every host core. Pick one:${RESET}"
  echo -e "    ${DIM}•${RESET} More memory: add ${BOLD}[resources]${RESET} then ${BOLD}memory = 8g${RESET} to ${BOLD}.cleat${RESET} ${DIM}(or your global config)${RESET}"
  echo -e "    ${DIM}•${RESET} Fewer workers: ${BOLD}jest --maxWorkers=2${RESET}, ${BOLD}vitest --poolOptions.threads.maxThreads=2${RESET}"
  echo -e "    ${DIM}•${RESET} Cap CPU so runners self-limit: add ${BOLD}cpus = 2${RESET} under ${BOLD}[resources]${RESET}"
}

# During a heavy multi-agent run the HOST (not the box) can exhaust its per-user
# process table, and any host-side fork then fails with EAGAIN. Cleat's background
# watchers hit this and bash writes "fork: Resource temporarily unavailable" to
# the per-box watcher log (redirected off the terminal at the watcher spawns, so
# it no longer corrupts the Claude TUI). This surfaces ONE plain diagnostic when
# that happened THIS session, so the raw bash spam in the log gets a human
# explanation and a fix. It reads only the bytes written after `off` (this
# session's watcher output), so a stale error from a past session never
# re-triggers it. The failing fork is host-side (the box has its own pid pool and
# a working session), so this is guidance for the user's machine, not a box fix.
# Fail-soft: a missing log or `tail`/`grep` hiccup just prints nothing.
# Cap the per-box watcher log at ~1 MB and echo its post-cap byte size. Nothing
# else sweeps this log (it dodges the .watcher.* liveness glob by design), so
# without the cap a host fork storm, which appends many bash retry lines, could
# grow it unbounded across a long-lived box. The echoed size is the session's
# read offset so the end-of-session diagnostic scans only this session's slice.
# Fail-soft: a missing or unreadable log yields 0 (and no truncation).
_cap_watcher_log() {
  local log="$1" sz=0
  [ -f "$log" ] || { echo 0; return 0; }
  # `tr -d [:space:]` strips BSD wc's leading padding (macOS prints "      6",
  # not "6"): without it the ^[0-9]+$ guard below rejects the padded string and
  # forces sz=0, which on macOS would defeat BOTH the cap (never truncates) and
  # the offset (always 0 -> a stale prior-session fork error re-fires the
  # advisory every run). Same normalization the hook bridge already does.
  sz="$(wc -c < "$log" 2>/dev/null | tr -d '[:space:]' || echo 0)"
  [[ "$sz" =~ ^[0-9]+$ ]] || sz=0
  if (( sz > 1048576 )); then
    : > "$log" 2>/dev/null || true
    sz=0
  fi
  echo "$sz"
}

_maybe_explain_fork_exhaustion() {
  local log="$1" off="${2:-0}"
  [ -f "$log" ] || return 0
  tail -c "+$(( off + 1 ))" "$log" 2>/dev/null | grep -q "Resource temporarily unavailable" || return 0
  echo ""
  warn "${BOLD}Your machine ran low on process slots${RESET} during this session ${DIM}(a host limit, not the box)${RESET}."
  echo -e "    ${DIM}A large multi-agent run can spawn thousands of host processes and hit your per-user cap.${RESET}"
  echo -e "    ${DIM}The agent kept working. Only Cleat's background helpers logged the fork errors. To avoid it:${RESET}"
  echo -e "    ${DIM}•${RESET} Run fewer agents at once ${DIM}(dispatch subagents sequentially)${RESET}"
  echo -e "    ${DIM}•${RESET} Raise this shell's limit before launching: ${BOLD}ulimit -u 4096${RESET}"
  echo -e "    ${DIM}•${RESET} macOS per-user cap: ${BOLD}sudo sysctl kern.maxprocperuid=4096${RESET} ${DIM}(default is often ~2784)${RESET}"
}

# ── Update check (every 10 minutes) ─────────────────────────────────────────
UPDATE_CHECK_FILE="$REPO_DIR/.update_check"
# Records the last VERSION whose on-start release highlight was shown (one line).
# Absent or different from VERSION => the highlight shows once on the next launch.
LAST_SEEN_VERSION_FILE="$REPO_DIR/.last_seen_version"
UPDATE_CHECK_INTERVAL=600   # 10 minutes; a release cut minutes after a launch
                            # should surface on the next run, not up to a day
                            # later. The lookup is one `git ls-remote --tags`
                            # (refs only, no objects), so this cadence is cheap;
                            # the declined-version field still prevents re-nagging.

# Claude Code update check: separate cadence/cache from the cleat self-update
# check above. The channel defaults to `latest` to match `cleat upgrade-claude`
# (so the on-start prompt and the action it triggers agree); override with
# CLEAT_CLAUDE_CHANNEL (stable|latest|VERSION). Disable the whole on-start
# prompt with CLEAT_NO_CLAUDE_UPDATE_CHECK=1.
# Docker pressure check (bloat → prune offer; overload → notice), throttled
# like the update checks, but daily: image bloat grows by the day, not the
# minute, and the check costs a handful of docker calls.
PRESSURE_CHECK_FILE="$REPO_DIR/.pressure_check"
PRESSURE_CHECK_INTERVAL=86400
# Idle-session sweep: on every interactive start, stop OTHER cleat boxes that are
# provably safe to stop (detached, no agent running, idle past the grace window),
# so a day of closed-terminal boxes stops silently reserving Docker VM memory.
# Closing a terminal ends the foreground exec but leaves the container running;
# this reclaims those. Grace defaults to 30 min so a box you stepped away from
# and will resume in a minute is left alone. Override with CLEAT_IDLE_GRACE_MINS;
# disable the whole sweep with CLEAT_NO_IDLE_SWEEP=1. See concept/25.
_IDLE_SWEEP_GRACE_SECS=1800
# Docker Desktop resources advisory (the VM memory/swap/file-sharing tuning the
# `docker` CLI cannot change). A box and a worktree are the same thing here:
# each is one session with its own quarter-of-VM ceiling (4-8g). 16 GiB is a comfortable default
# (a handful of sessions can each spike near their ceiling at once and still fit),
# NOT a hard cap: ceilings aren't reservations, so you can run many more sessions
# than that, and only simultaneous genuinely-heavy memory work across them swaps
# the VM, which is rare and no different from Claude Code outside Docker. The
# target is capped at half the host's RAM (leave the rest for macOS + apps). The
# advisory fires when the VM is below the target; a generous VM never nags, and it
# recurs on the daily check while the VM stays small, then stops once fixed. Host
# RAM unknown → conservative 8 GiB floor (don't over-recommend a VM the machine
# may not be able to back). See _recommended_vm_gb. User-facing copy never names a
# session count (it would read as a limit that isn't real); it says "many".
_PRESSURE_TARGET_VM_GB=16                     # comfortable default VM, not a session cap
_PRESSURE_VM_ADVISORY_BYTES=8589934592        # 8 GiB fallback floor (host RAM unknown)
# Minimum healthy Docker VM swap. Memory can be sized right while swap is left at
# the Docker Desktop default (often 1 GB): too little overflow for a brief spike,
# so a session can freeze instead of paging out. Matches the "Swap ≥ 2 GB" target
# the fix steps already recommend. Keep this value and that copy in sync.
_SWAP_ADVISORY_BYTES=2147483648               # 2 GiB

# Set to 1 by an on-start notice (the Docker pressure block) once it has emitted
# its own trailing blank line, so the release highlight below it knows the gap
# is already open and won't double the blank. When it stays 0 (no notice
# printed, or a non-Docker-Desktop engine where the fix block is skipped), the
# highlight opens the gap itself, guaranteeing exactly one blank line above the
# "New in …" news no matter what preceded it. See _maybe_show_release_highlight.
_ONSTART_GAP_OPEN=0

# Set to 1 by the pressure check when it printed a VM warning (overload or
# undersized) this run, so the positive "Docker tuned" line stays silent and the
# two can never both appear (or contradict). See _maybe_announce_docker_ready.
_VM_ADVISORY_SHOWN=0

# Set to 1 by an on-start advisory ONLY when it surfaced a genuine Docker CONFIG
# error the user must go fix in Docker Desktop settings (an undersized VM memory
# slider, or swap left at the tiny default), never for the transient overload
# notice (which a `cleat stop` resolves without touching Docker's config). When
# set, _maybe_gate_on_docker_config holds the interactive launch for one keypress
# so the warning can't scroll by unread. _DOCKER_GATE_SUMMARY carries the one-line
# reason the gate re-states, so the stopped screen is self-contained. See
# concept/21 (the single documented exception to the "never block" startup rule).
_DOCKER_GATE_PENDING=0
_DOCKER_GATE_SUMMARY=""

CLAUDE_CHECK_FILE="$REPO_DIR/.claude_update_check"
CLAUDE_CHECK_INTERVAL=600   # 10 minutes; the lookup is a tiny GET; the only
                            # real per-check cost is one throwaway container to
                            # read the image's version, bounded to once/interval.
CLAUDE_RELEASES_URL="https://downloads.claude.ai/claude-code-releases"

latest_remote_tag() {
  git -C "$REPO_DIR" ls-remote --tags --refs origin 2>/dev/null \
    | awk '{print $2}' \
    | sed 's|refs/tags/v\{0,1\}||' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -t. -k1,1n -k2,2n -k3,3n \
    | tail -1
}

# Return success only when $REPO_DIR is a git work tree with NO uncommitted
# changes, i.e. a pristine release install onto which `git checkout v<tag>` is
# safe. A dirty tree is a developer/contributor checkout (the maintainer's daily
# state): there `git checkout` would fail on the very file that differs between
# tags (bin/cleat), so offering the auto-update would just nag "Update failed" on
# every launch. Skip it for them; `cleat update` stays available explicitly.
_repo_is_clean() {
  git -C "$REPO_DIR" diff --quiet 2>/dev/null \
    && git -C "$REPO_DIR" diff --cached --quiet 2>/dev/null
}

# Checkout the given release tag and invalidate the update caches. Does NOT pull
# the image or exit: the re-exec'd new CLI handles image/build itself. Returns
# nonzero on any git failure so the caller can continue on the current version.
# Separated from the prompt so tests can stub it.
_apply_cli_update() {
  local target="$1"
  [[ -d "$REPO_DIR/.git" ]] || return 1
  git -C "$REPO_DIR" fetch --tags --force --quiet 2>/dev/null || return 1
  git -C "$REPO_DIR" checkout "v${target}" --quiet 2>/dev/null || return 1
  # Re-check against the fresh checkout next launch (and re-evaluate the bundled
  # Claude Code, since the new release image ships its own).
  rm -f "$UPDATE_CHECK_FILE" "$CLAUDE_CHECK_FILE" 2>/dev/null || true
  return 0
}

# Re-exec the (now-updated) CLI with the ORIGINAL argv so the new version drives
# the rest of this run. CLEAT_SKIP_CLI_UPDATE stops the new process from
# re-prompting (belt-and-suspenders; the version check already wouldn't fire).
# Isolated so tests can override it: exec replaces the process and can't be run
# under bats.
_reexec_cli() {
  export CLEAT_SKIP_CLI_UPDATE=1
  # `exec` only returns if it FAILED (e.g. $0 no longer resolves). `execfail`
  # lets it return instead of the shell exiting, and `|| true` keeps `set -e`
  # from aborting, so a user who just opted into an update is never stranded
  # with no session. The fallback re-enters main in-process (old in-memory code,
  # but a working session); CLEAT_SKIP_CLI_UPDATE prevents a re-prompt loop.
  shopt -s execfail 2>/dev/null || true
  exec "$0" "${_CLEAT_ORIG_ARGV[@]+"${_CLEAT_ORIG_ARGV[@]}"}" || true
  warn "Could not restart automatically. Continuing in this session."
  main "${_CLEAT_ORIG_ARGV[@]+"${_CLEAT_ORIG_ARGV[@]}"}"
  exit $?
}

# Interactive CLI self-update preflight. TTY-only, throttled, opt-out-able. When
# a newer RELEASED Cleat is available, offer to update and re-exec as that
# version. Runs before any docker work so the new version drives the whole run.
# Declined / non-interactive / offline → silently continue on the current
# version. Disable entirely with CLEAT_NO_UPDATE_CHECK=1.
_maybe_prompt_cli_update() {
  _is_tty || return 0
  [[ "${CLEAT_SKIP_CLI_UPDATE:-}" == "1" ]] && return 0
  [[ "${CLEAT_NO_UPDATE_CHECK:-}" == "1" ]] && return 0
  [[ -d "$REPO_DIR/.git" ]] || return 0

  # Don't offer an auto-`git checkout` onto a developer's dirty tree: it would
  # fail every launch (see _repo_is_clean). They can still run `cleat update`.
  _repo_is_clean || return 0

  # Cache layout: "<timestamp> <latest-version> [declined-version]". Field 3 (if
  # present) is the version the user last declined; we don't re-nag for it.
  local now last_check=0 cached_version="" declined_version=""
  now=$(date +%s)
  if [[ -f "$UPDATE_CHECK_FILE" ]]; then
    last_check=$(awk 'NR==1 {print $1}' "$UPDATE_CHECK_FILE" 2>/dev/null || echo 0)
    cached_version=$(awk 'NR==1 {print $2}' "$UPDATE_CHECK_FILE" 2>/dev/null || echo "")
    declined_version=$(awk 'NR==1 {print $3}' "$UPDATE_CHECK_FILE" 2>/dev/null || echo "")
    [[ "$last_check" =~ ^[0-9]+$ ]] || last_check=0
  fi
  # Throttle the network lookup to once per interval; CLEAT_FORCE_UPDATE_CHECK
  # bypasses (tests). Within the window we reuse the cached version, so a known
  # newer release still prompts without hitting the network every start. Preserve
  # the recorded decline across the refresh.
  if [[ -n "${CLEAT_FORCE_UPDATE_CHECK:-}" ]] || (( now - last_check >= UPDATE_CHECK_INTERVAL )); then
    cached_version=$(latest_remote_tag || true)
    echo "$now $cached_version $declined_version" > "$UPDATE_CHECK_FILE" 2>/dev/null || true
  fi

  [[ -n "$cached_version" && "$cached_version" != "$VERSION" ]] || return 0
  # Already declined THIS exact version → stay quiet until an even newer one ships.
  [[ -n "$declined_version" && "$cached_version" == "$declined_version" ]] && return 0
  # Only prompt when the remote release is strictly newer: never nag to
  # downgrade (e.g. running a local prerelease ahead of the latest tag). Compare
  # on the numeric base, stripping any prerelease/build suffix, so the sort's
  # whole-line tiebreak can't mis-rank `X.Y.Z-rc1` against `X.Y.Z`.
  local base_cur="${VERSION%%[-+]*}" base_new="${cached_version%%[-+]*}"
  local newest
  newest=$(printf '%s\n%s\n' "$base_cur" "$base_new" \
    | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
  [[ "$newest" == "$base_new" && "$base_new" != "$base_cur" ]] || return 0

  echo ""
  info "Cleat update available: ${DIM}v${VERSION}${RESET} → ${BOLD}v${cached_version}${RESET}"
  local yn=""
  _ask_yn yn "Upgrade now? ${DIM}(re-runs as the new version)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    if _apply_cli_update "$cached_version"; then
      success "Updated to v${cached_version}"
      info "Restarting with the new version…"
      _reexec_cli
    else
      warn "Update failed. Continuing on v${VERSION}."
    fi
  else
    # Record the decline so we don't re-prompt for this version every launch.
    echo "$now $cached_version $cached_version" > "$UPDATE_CHECK_FILE" 2>/dev/null || true
  fi
}

# Non-blocking release highlight. On the first RELEASE_HIGHLIGHT_MAX_SHOWS
# interactive, session-launching runs after VERSION changes, print a short note
# about the release's flagship feature, then go quiet for that version. Bounded
# repetition (not once, not forever): people miss a one-time note, and a
# forever-repeating one trains the eye to skip the startup block where the
# actionable drift/update/security notices live. Purely local (no network →
# CI/offline-safe) and NEVER prompts: the update check is the only thing allowed
# to ask at startup. State is "<version> <shown_count>" in $LAST_SEEN_VERSION_FILE.
# The copy below is the maintainer's editorial "what's new" news: written by
# hand, NOT auto-generated, and its version label is the feature's introduction
# version (a big feature may stay highlighted across several releases). Leave it
# as-is unless you have new news to announce; bump RELEASE_HIGHLIGHT_VERSION at
# tag time to re-surface it. A version mismatch shows nothing: fail-safe.
_maybe_show_release_highlight() {
  _is_tty || return 0
  # Only fire for the exact version this copy was written for.
  [[ "$RELEASE_HIGHLIGHT_VERSION" == "$VERSION" ]] || return 0

  local last_seen="" shown=0
  if [[ -f "$LAST_SEEN_VERSION_FILE" ]]; then
    last_seen=$(awk 'NR==1 {print $1}' "$LAST_SEEN_VERSION_FILE" 2>/dev/null || echo "")
    shown=$(awk 'NR==1 {print $2+0}' "$LAST_SEEN_VERSION_FILE" 2>/dev/null || echo 0)
  fi
  # Already shown the cap for this version → stay quiet.
  [[ "$last_seen" == "$VERSION" && "$shown" -ge "$RELEASE_HIGHLIGHT_MAX_SHOWS" ]] && return 0

  # A fresh version resets the counter; the same version increments it.
  local next=1
  [[ "$last_seen" == "$VERSION" ]] && next=$(( shown + 1 ))

  # Record the bumped count BEFORE printing so a Ctrl-C or write race can never
  # under-count (which would over-show). Brace-wrap so a redirect-open failure's
  # own stderr is suppressed too (plain `echo ... 2>/dev/null` doesn't catch the
  # shell's "Permission denied"). If the bump can't be persisted (read-only
  # install dir, unwritable stale file), the read-back fails and we stay SILENT
  # rather than show forever: "fail to silence, never to a permanent nag."
  { echo "$VERSION $next" > "$LAST_SEEN_VERSION_FILE"; } 2>/dev/null || true
  local confirm=""
  [[ -f "$LAST_SEEN_VERSION_FILE" ]] && confirm=$(awk 'NR==1 {print $1" "($2+0)}' "$LAST_SEEN_VERSION_FILE" 2>/dev/null || echo "")
  [[ "$confirm" == "$VERSION $next" ]] || return 0

  # Exactly one blank line above the news, no matter what preceded it. An
  # on-start notice (the Docker pressure block) sets _ONSTART_GAP_OPEN once it
  # has printed its own trailing blank, then we don't double it. Otherwise
  # (nothing printed, or a non-Docker-Desktop engine where the fix block is
  # skipped) we open the gap ourselves, so "New in …" never sits flush against a
  # warning or the shell prompt. The earlier design leaned on the advisory's
  # trailing blank for this, which vanished whenever the advisory's fix block was
  # gated out, leaving the news crammed against the warn line (observed
  # v0.16.1). We still own our OWN trailing blank below, so the bring-up that
  # follows needs none.
  [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
  info "${BOLD}New in v1.2.0${RESET}. ${CYAN}Kits${RESET}: one command enables a tuned Claude team."
  echo -e "    ${DIM}Fable-grade planning, Sonnet-priced execution: ${RESET}${BOLD}cleat kit${RESET}"
  echo -e "    ${DIM}Per box, on top of your config, off in one command.${RESET}"
  # A clickable, version-anchored changelog link. The /changelog page IDs each
  # release `id="vX.Y.Z"` (changelog.astro), so #v1.2.0 deep-links to the 1.2.0
  # release; _hyperlink makes it a real OSC 8 link where supported (clean short
  # text), else a bare clickable URL. Blue + underline reads as a link either
  # way. Keep the anchor version in lockstep with the "New in vX.Y.Z" label above.
  # printf, not `echo -e`: _hyperlink emits real escape bytes, and piping those
  # back through `echo -e` would re-interpret the OSC 8 string-terminator's
  # trailing `\` against ${RESET}'s leading `\033`. %b expands the colour vars;
  # %s passes the already-rendered link through untouched.
  printf '    %bChangelog:%b %b%b%s%b\n' \
    "$DIM" "$RESET" "$BLUE" "$UNDERLINE" \
    "$(_hyperlink "https://cleat.sh/changelog#v1.2.0" "cleat.sh/changelog#v1.2.0")" "$RESET"
  # Trailing blank: the highlight owns its own separation from whatever follows
  # (the bring-up, or the "Docker tuned"/swap line that runs after it), so flag
  # the gap open. Without this, a post-upgrade start with a well-sized VM (pressure
  # check silent, so it never set the flag) doubled the blank: the highlight's
  # trailing blank PLUS the confirmation's own leading blank. Same convention the
  # pressure block follows.
  echo ""
  _ONSTART_GAP_OPEN=1
}

# Fetch the newest released Claude Code version for a channel from the public
# releases endpoint (the same one the official installer reads). Stdout: a bare
# version like `2.1.149`, or empty on any failure. Tests inject a value via
# CLEAT_FAKE_REMOTE_CLAUDE so they never hit the network.
_claude_remote_version() {
  local channel="${1:-latest}"
  if [[ -n "${CLEAT_FAKE_REMOTE_CLAUDE:-}" ]]; then
    printf '%s' "$CLEAT_FAKE_REMOTE_CLAUDE"
    return 0
  fi
  command -v curl >/dev/null 2>&1 || return 0
  local v
  v="$(curl -fsSL "$CLAUDE_RELEASES_URL/$channel" 2>/dev/null)" || return 0
  # Take only the first line and strip surrounding whitespace, then require a
  # clean, fully-anchored semver. This rejects HTML/error pages and stops any
  # trailing or multiline bytes (e.g. ANSI escapes from a compromised/MITM'd
  # endpoint) from reaching the terminal display or the cache file.
  v="$(printf '%s' "$v" | head -n1 | tr -d '[:space:]')"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$ ]] || return 0
  printf '%s' "$v"
}

# On an interactive `cleat` start, check at most once every 10 minutes whether a newer
# Claude Code than the one baked into the image is available, and if so offer
# to upgrade the image before starting. "Yes" runs the durable image-commit
# upgrade (NOT an in-container `claude update`, which would be ephemeral), then
# cmd_run continues and starts a fresh container from the updated image.
# Designed never to block: non-interactive, opted-out, throttled, offline, or
# version-read failures all fall through silently.
_maybe_prompt_claude_update() {
  _is_tty || return 0
  [[ "${CLEAT_NO_CLAUDE_UPDATE_CHECK:-}" == "1" ]] && return 0
  image_exists || return 0

  local now last_check=0
  now="$(date +%s)"
  if [[ -f "$CLAUDE_CHECK_FILE" ]]; then
    last_check="$(awk 'NR==1 {print $1}' "$CLAUDE_CHECK_FILE" 2>/dev/null || echo 0)"
    [[ "$last_check" =~ ^[0-9]+$ ]] || last_check=0
  fi
  # Throttle to once per interval. CLEAT_FORCE_CLAUDE_CHECK bypasses (tests).
  if [[ -z "${CLEAT_FORCE_CLAUDE_CHECK:-}" ]] && (( now - last_check < CLAUDE_CHECK_INTERVAL )); then
    return 0
  fi

  # Resolve and STRICTLY validate the channel before it touches a URL or the
  # in-container shell command: CLEAT_CLAUDE_CHANNEL is user-controlled, so a
  # value like `2.1.0; rm -rf ~` must not slip through to _upgrade_claude_image.
  local channel="${CLEAT_CLAUDE_CHANNEL:-latest}"
  local _semver='^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$'
  case "$channel" in
    stable|latest) ;;
    *) [[ "$channel" =~ $_semver ]] || channel="latest" ;;
  esac

  local remote
  remote="$(_claude_remote_version "$channel")"
  # Record the attempt regardless of outcome so a flaky network can't nag on
  # every single start.
  echo "$now $remote" > "$CLAUDE_CHECK_FILE" 2>/dev/null || true
  [[ -n "$remote" ]] || return 0

  local local_v
  local_v="$(_image_claude_version)"
  [[ -n "$local_v" ]] || return 0
  [[ "$remote" != "$local_v" ]] || return 0
  # Only prompt when the remote version is strictly newer: never nag to
  # downgrade (e.g. when the image already runs a newer build than `stable`).
  # Compare on the numeric base, stripping any prerelease suffix (`-rc.1`), so a
  # pinned-prerelease channel doesn't mis-rank against a plain release.
  local base_local="${local_v%%[-]*}" base_remote="${remote%%[-]*}"
  local newest
  newest="$(printf '%s\n%s\n' "$base_local" "$base_remote" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
  [[ "$newest" == "$base_remote" ]] || return 0

  echo ""
  info "New Claude Code available: ${DIM}${local_v}${RESET} → ${BOLD}${remote}${RESET} ${DIM}(${channel})${RESET}"
  local yn=""
  _ask_yn yn "Update the image before starting? ${DIM}(downloads the new build)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    _upgrade_claude_image "$channel" || warn "Update failed. Starting with the current version."
  fi
  # Close the block with one blank line: this prompt opened with a leading blank
  # (above), so the bring-up that follows (Container started → Auth shared → …)
  # reads as its own contiguous group instead of sitting flush against the
  # "Claude Code upgraded" confirmation. Only reached when the prompt fired (all
  # the no-op early returns are above), so a start with no Claude update prints
  # neither blank.
  echo ""
}

# ── Commands ────────────────────────────────────────────────────────────────
cmd_build() {
  if image_exists; then
    # An image of the wrong architecture (e.g. an amd64 pull cached on an
    # Apple Silicon machine) counts as missing: every box created from it
    # would run emulated. Re-acquire a native one instead.
    if _image_arch_ok; then
      success "Image ready ${RESET}${DIM}(cached)"
      return
    fi
    _warn_image_emulated
  fi
  _do_pull || _do_build
}

_human_bytes() {
  local b="${1:-0}"
  [[ "$b" =~ ^[0-9]+$ ]] || { echo "?"; return; }
  [[ "$b" == "0" ]] && { echo "?"; return; }
  awk -v b="$b" 'BEGIN{
    split("B KB MB GB", u, " "); i=1
    while (b>=1024 && i<4) { b/=1024; i++ }
    printf("%.0f %s", b, u[i])
  }'
}

# Pull the prebuilt image from GHCR for a specific version (default: $VERSION),
# retagging it as $IMAGE_NAME on success. Returns 1 if the remote image isn't
# available so callers can fall back to a local build.
#
# Short-circuits when ${REGISTRY_BASE}:v${target_version} is already on disk:
# the only thing a pull would do in that case is verify cache freshness, and
# a transient registry/network error there shouldn't kick a perfectly good
# cached image out into a 2-5 min local build.
_do_pull() {
  local target_version="${1:-$VERSION}"
  local target_image="${REGISTRY_BASE}:v${target_version}"
  local log rc=0

  # Pin the pull to the daemon's architecture. A single-arch manifest of the
  # WRONG arch then fails loudly ('no matching manifest') and the caller's
  # `_do_pull || _do_build` falls back to a native local build, instead of
  # the pre-multi-arch behavior where docker pulled it anyway with a warning
  # the CLI discarded, and every box silently ran emulated. Empty daemon arch
  # (unreachable, exotic) omits the flag: today's behavior, fail-open.
  local arch platform_args=()
  arch="$(_daemon_arch)"
  [[ -n "$arch" ]] && platform_args=(--platform "linux/${arch}")
  local arch_note="${arch:+, ${arch}}"

  # Cache short-circuit: if the version-tagged prebuilt image is already on
  # disk AND matches the daemon arch, retag it as $IMAGE_NAME and skip the
  # network entirely. An arch-mismatched cache entry (an amd64 image pulled
  # before multi-arch publishing) must NOT short-circuit: fall through to
  # the platform-pinned pull so the native half of the manifest replaces it.
  # A failure to retag (rare: disk full, denied, etc.) must also fall
  # through so we never lie about success.
  if docker image inspect "$target_image" > /dev/null 2>&1 && _image_arch_ok "$target_image"; then
    if docker tag "$target_image" "$IMAGE_NAME" > /dev/null 2>&1; then
      local size_bytes size_human
      size_bytes=$(docker image inspect "$IMAGE_NAME" --format '{{.Size}}' 2>/dev/null || echo 0)
      size_human=$(_human_bytes "$size_bytes")
      success "Image ready ${RESET}${DIM}(cached v${target_version}${arch_note}, ${size_human})"
      return 0
    fi
    warn "Cached prebuilt image found but could not be tagged as ${IMAGE_NAME}; falling through to pull"
  fi

  log="$(mktemp)"

  if ! _is_tty; then
    info "Pulling image from ghcr.io ${DIM}(v${target_version}${arch_note})${RESET}"
    docker pull "${platform_args[@]+"${platform_args[@]}"}" "$target_image" > /dev/null 2>&1 || rc=$?
    if [[ $rc -ne 0 ]]; then
      warn "Prebuilt image unavailable for v${target_version}, building locally"
      rm -f "$log"
      return 1
    fi
    docker tag "$target_image" "$IMAGE_NAME" > /dev/null 2>&1 || true
    success "Image ready ${RESET}${DIM}(pulled v${target_version}${arch_note})"
    # Routine GC: drop superseded prebuilt tags and orphaned builds so each
    # update doesn't accrete another ~1-2 GB. Silent and fail-soft: images
    # still referenced by a container are kept.
    cmd_prune > /dev/null 2>&1 || true
    rm -f "$log"
    return 0
  fi

  # TTY: run docker pull in the background and animate progress by tailing
  # its line-per-event output (non-TTY docker pull writes one line per layer
  # event: "Pulling fs layer", "Downloading", "Extracting", "Pull complete").
  ( docker pull "${platform_args[@]+"${platform_args[@]}"}" "$target_image" > "$log" 2>&1 ) &
  local pull_pid=$!

  local frames
  if _has_unicode; then
    frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  else
    frames=('-' '\' '|' '/')
  fi

  { command -v tput &>/dev/null && tput civis 2>/dev/null; } || true

  local i=0 total=0 complete=0 status
  while kill -0 "$pull_pid" 2>/dev/null; do
    if [[ -s "$log" ]]; then
      total=$(grep -c 'Pulling fs layer' "$log" 2>/dev/null || true)
      complete=$(grep -c 'Pull complete' "$log" 2>/dev/null || true)
      total="${total:-0}"
      complete="${complete:-0}"
    fi
    if (( total > 0 )); then
      status="${complete}/${total} layers"
    else
      status="connecting…"
    fi
    printf "\r\033[K  ${BLUE}%s${RESET} Pulling ${BOLD}cleat:v%s${RESET} from ghcr.io ${DIM}(%s)${RESET}" \
      "${frames[$i]}" "$target_version" "$status"
    i=$(( (i + 1) % ${#frames[@]} ))
    sleep 0.08
  done

  wait "$pull_pid"
  rc=$?
  { command -v tput &>/dev/null && tput cnorm 2>/dev/null; } || true

  if [[ $rc -ne 0 ]]; then
    printf "\r\033[K  ${AMBER}!${RESET} Prebuilt image unavailable for v%s, building locally\n" \
      "$target_version"
    rm -f "$log"
    return 1
  fi

  docker tag "$target_image" "$IMAGE_NAME" > /dev/null 2>&1 || true

  local size_bytes size_human
  size_bytes=$(docker image inspect "$IMAGE_NAME" --format '{{.Size}}' 2>/dev/null || echo 0)
  size_human=$(_human_bytes "$size_bytes")

  printf "\r\033[K  ${GREEN}✔${RESET} Image ready ${DIM}(pulled v%s%s, %s)${RESET}\n" \
    "$target_version" "$arch_note" "$size_human"
  # Routine GC: see the non-TTY path above.
  cmd_prune > /dev/null 2>&1 || true
  rm -f "$log"
  return 0
}

_do_build() {
  local build_log
  build_log="$(mktemp)"
  spin "Building image..."
  local rc=0
  docker build -f "$REPO_DIR/docker/Dockerfile" -t "$IMAGE_NAME" \
    --label "sh.cleat.version=$VERSION" \
    --label "sh.cleat.image-spec=$_IMAGE_SPEC_VERSION" "$REPO_DIR/docker" >"$build_log" 2>&1 || rc=$?
  spin_stop "$rc" "Image ready" "Image build failed"
  if [[ $rc -ne 0 ]]; then
    echo ""
    echo -e "  ${DIM}Build log:${RESET}"
    tail -20 "$build_log" | sed 's/^/    /'
    rm -f "$build_log"
    exit 1
  fi
  rm -f "$build_log"
  # Routine GC: the build that was just replaced is now a dangling
  # sh.cleat.version image (1.5-2.5 GB). Silent, fail-soft, keeps anything a
  # container still references.
  cmd_prune > /dev/null 2>&1 || true
}

cmd_rebuild() {
  local build_log
  build_log="$(mktemp)"
  spin "Rebuilding image..."
  local rc=0
  docker build --no-cache -f "$REPO_DIR/docker/Dockerfile" -t "$IMAGE_NAME" \
    --label "sh.cleat.version=$VERSION" \
    --label "sh.cleat.image-spec=$_IMAGE_SPEC_VERSION" "$REPO_DIR/docker" >"$build_log" 2>&1 || rc=$?
  spin_stop "$rc" "Image rebuilt" "Image build failed"
  if [[ $rc -ne 0 ]]; then
    echo ""
    echo -e "  ${DIM}Build log:${RESET}"
    tail -20 "$build_log" | sed 's/^/    /'
    rm -f "$build_log"
    exit 1
  fi
  rm -f "$build_log"
  # Routine GC: see _do_build. Drift rebuilds are the main bloat source: a
  # maintainer's image churns daily and every rebuild orphaned the previous.
  cmd_prune > /dev/null 2>&1 || true
}

# Upgrade the Claude Code build bundled inside the shared image.
#
# Claude Code lives at ~/.local/share/claude/versions/<v> in the image and is
# NOT host-mounted, so it's frozen at image build/pull time. This re-runs the
# official installer in a throwaway container from the current image and
# `docker commit`s the result back, durably baking the new version into
# $IMAGE_NAME (fast: only the new binary is downloaded).
#
# The upgrade is local-only: `cleat rebuild`, `cleat update`, and `cleat nuke`
# reset $IMAGE_NAME to a fresh release image (which already bundles a current
# Claude Code) and discard this commit. That's intentional: a CLI release
# supersedes a manual bump. Re-run this if a release happens to bundle an older
# Claude Code than you had.
#
# Usage: cleat upgrade-claude [stable|latest|VERSION]   (default: latest)
cmd_upgrade_claude() {
  local channel="${1:-latest}"

  # Validate strictly. The channel is interpolated into the container's shell
  # command, so anything but `stable`, `latest`, or a bare semver would be a
  # command-injection vector (e.g. `2.1.0; rm -rf ~`). The regex admits an
  # optional prerelease/build suffix (`-rc.1`, `.20240101`) but no shell
  # metacharacters, whitespace, or slashes.
  local _semver='^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$'
  case "$channel" in
    stable|latest) ;;
    *)
      if [[ ! "$channel" =~ $_semver ]]; then
        error "Invalid version: ${BOLD}${channel}${RESET}."
        echo -e "    ${DIM}Use ${BOLD}stable${RESET}${DIM}, ${BOLD}latest${RESET}${DIM}, or a version like ${BOLD}2.1.156${RESET}${DIM}.${RESET}"
        exit 1
      fi
      ;;
  esac

  _upgrade_claude_image "$channel" || exit 1

  # Existing containers were created from the old image and still run the old
  # Claude Code. Recreate the current project's container so the upgrade takes
  # effect immediately (sessions live on the host and are preserved).
  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project")"
  if container_exists "$cname"; then
    if _is_tty; then
      local yn=""
      _ask_yn yn "Recreate ${BOLD}${cname}${RESET} now to use it? [Y/n] "
      if [[ -z "$yn" || "$yn" == [yY]* ]]; then
        if is_running "$cname"; then
          docker stop "$cname" > /dev/null 2>&1 || true
        fi
        docker rm -f "$cname" > /dev/null 2>&1 || true
        rm -rf "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
        success "Removed ${BOLD}${cname}${RESET}."
        cmd_run "$project"
        return
      fi
    fi
    info "Run ${BOLD}cleat rm && cleat${RESET} to use the new Claude Code in ${BOLD}${cname}${RESET}."
  fi
  echo -e "  ${DIM}Other projects pick up the new Claude Code next time their container is recreated.${RESET}"
}

# Core upgrade: re-install Claude Code into the local image for <channel> and
# commit the result back over the image. The channel MUST be pre-validated by
# the caller (it is interpolated into the in-container shell command). Returns
# 0 on success, 1 on failure: it never exits the process and never recreates
# a container, so the on-start update prompt can update the image in place and
# then let cmd_run continue starting a fresh container from it.
_upgrade_claude_image() {
  local channel="$1"

  # Need an image to upgrade: build or pull one first if missing.
  if ! image_exists; then
    info "No image yet. Preparing one first..."
    _do_pull || _do_build
  fi
  # Defensive: if pull+build still left us without an image, stop here rather
  # than spawning a container against a non-existent reference.
  if ! image_exists; then
    error "No ${BOLD}${IMAGE_NAME}${RESET} image available to upgrade."
    return 1
  fi

  local before old_id
  before="$(_image_claude_version)"
  old_id="$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null || true)"

  local tmp="cleat-claude-upgrade"
  # Self-heal a leftover container from a previously interrupted run.
  docker rm -f "$tmp" > /dev/null 2>&1 || true

  local log
  log="$(mktemp 2>/dev/null)" || log="/tmp/cleat-upgrade.$$"
  : > "$log" 2>/dev/null || true

  # Build the in-container command. Notes on why each piece matters:
  #   set -euo pipefail  (without pipefail, a failed `curl` feeds empty input
  #                        to `bash` which exits 0, so a network failure would
  #                        silently commit an UNCHANGED image. This makes the
  #                        installer download failure abort the whole run.
  #   absolute paths     (HOME is always /home/coder in the image; hardcoding
  #                        avoids any empty-$HOME `rm -rf /...` surprise.
  #   test -x readlink   (verifies the installer actually produced a runnable
  #                        claude binary before we commit it. A broken/partial
  #                        install fails here instead of being baked in.
  # `$channel` is safe to interpolate: validated above.
  local install_cmd
  install_cmd='set -euo pipefail; curl -fsSL https://claude.ai/install.sh | bash -s -- '"$channel"'; rm -rf /home/coder/.claude/downloads; test -x "$(readlink -f /home/coder/.local/bin/claude)"'

  spin "Upgrading Claude Code (${channel})..."
  local rc=0
  # The image ENTRYPOINT remaps UID/GID as root then drops to the coder user.
  # Pass the host UID/GID so the installer writes ~/.local owned by the SAME uid
  # the runtime container will remap coder to. Without this the throwaway defaults
  # to the image-baked uid (1000), baking a 1000-owned ~/.local that a host-uid
  # (e.g. macOS 501) runtime can't write, breaking manual `claude update`.
  docker run --name "$tmp" -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)" "$IMAGE_NAME" bash -c "$install_cmd" > "$log" 2>&1 || rc=$?

  if [[ $rc -eq 0 ]]; then
    # Commit the updated filesystem over the working image. Restore the default
    # CMD: the throwaway container overrode it with the install command, and
    # `docker commit` would otherwise bake that in (breaking `cleat run`, which
    # relies on the image's `["bash"]` CMD to keep the container alive).
    docker commit --change 'CMD ["bash"]' "$tmp" "$IMAGE_NAME" >> "$log" 2>&1 || rc=$?
  fi
  docker rm -f "$tmp" > /dev/null 2>&1 || true

  # Fold the version delta straight into the success line so the result is a
  # single row, "Claude Code upgraded (2.1.156 → 2.1.161)", instead of a green
  # check followed by a separate version line. Read the new version BEFORE
  # spin_stop, and keep the message plain text: spin_stop's TTY path prints it
  # with printf %s, which would NOT interpret embedded color escapes.
  local after="" ok_msg="Claude Code upgraded"
  if [[ $rc -eq 0 ]]; then
    after="$(_image_claude_version)"
    if [[ -n "$before" && -n "$after" && "$before" != "$after" ]]; then
      ok_msg="Claude Code upgraded (${before} → ${after})"
    elif [[ -n "$after" && "$before" == "$after" ]]; then
      ok_msg="Claude Code already at ${after} (no change)"
    elif [[ -n "$after" ]]; then
      ok_msg="Claude Code upgraded (now ${after})"
    fi
  fi
  spin_stop "$rc" "$ok_msg" "Upgrade failed"

  if [[ $rc -ne 0 ]]; then
    echo ""
    echo -e "  ${DIM}Upgrade log:${RESET}"
    tail -20 "$log" 2>/dev/null | sed 's/^/    /'
    rm -f "$log"
    return 1
  fi
  rm -f "$log"

  if [[ -z "$after" ]]; then
    warn "Upgrade committed, but could not read the installed Claude Code version."
  fi

  # Drop the now-orphaned pre-commit layer so repeated upgrades don't stack
  # dangling images. Best-effort and heavily guarded: only when the old id is
  # truly untagged (a version tag like cleat:vX.Y.Z would keep it) and not
  # referenced by any container: `docker rmi` refuses both, harmlessly.
  if [[ -n "$old_id" ]]; then
    local new_id old_tags
    new_id="$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null || true)"
    if [[ "$old_id" != "$new_id" ]]; then
      old_tags="$(docker image inspect "$old_id" --format '{{len .RepoTags}}' 2>/dev/null || echo 1)"
      [[ "$old_tags" == "0" ]] && docker rmi "$old_id" > /dev/null 2>&1 || true
    fi
  fi

  return 0
}

cmd_run() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  _RESOLVED_PROJECT="$project"
  local cname
  cname="$(container_name_for "$project" "$box")"

  if is_running "$cname"; then
    warn "Container ${BOLD}${cname}${RESET} already running for this project."
    return
  fi

  if container_exists "$cname"; then
    docker rm "$cname" > /dev/null
  fi

  if ! image_exists; then
    _do_pull || _do_build
  elif ! _image_arch_ok; then
    # Wrong-arch image (e.g. an amd64 pull cached on Apple Silicon) counts as
    # missing: a box created from it would run emulated. Re-acquire native.
    _warn_image_emulated
    _do_pull || _do_build
  else
    # No leading blank: the bring-up block (Image ready/rebuilt → Container
    # started → …) stays one contiguous coloured group. Separation from the
    # preceding notices is owned by those notices (the release highlight emits
    # a trailing blank), so a rebuild's "Image rebuilt" flows straight into
    # this line instead of being split by a stray blank. See concept/21.
    success "Image ready ${RESET}${DIM}(cached)"
  fi

  # If the image was built by an older Cleat, offer to rebuild it before we
  # create the container (so the fresh container picks up the new setup).
  _maybe_prompt_image_rebuild "$cname"

  # If a newer Claude Code than the image ships is available, offer to bump it
  # (durably, by committing into the image) before we start the container.
  _maybe_prompt_claude_update

  if [[ ! -d "$project" ]]; then
    error "Project directory does not exist: ${BOLD}${project}${RESET}"
    exit 1
  fi

  # Resolve capabilities and env for this run
  resolve_caps "$project"
  resolve_env_args "$project"

  # ── Forked workspace ──────────────────────────────────────────────────────
  # A fork box mounts its own COPY at /workspace. $project stays the real path
  # everywhere else, so naming, trust, caps and kits are untouched.
  local _workspace="$project"
  local _fork_path=""
  # An explicit --fork ALWAYS ensures a copy exists. Guarding only on "is this
  # already a fork" made an interrupted or failed first run unrecoverable: the
  # marker is written once the copy lands, so a `docker run` that then failed
  # left a marked box with no container, and the next `--fork` refused instead
  # of healing. Refusing is right when the user did NOT ask for a fork (that is
  # the silent re-bind guard below); it is wrong when they typed the flag.
  if [[ "${_FORK_REQUESTED:-false}" == true ]] \
     && { ! _box_is_fork "$cname" || [[ ! -d "$(_fork_dir "$cname")" ]]; }; then
    _fork_path="$(_fork_dir "$cname")"
    # Refuse to fork a directory that already lives under the forks dir: a fork
    # of a fork nests copies without bound.
    case "$project/" in
      "$CLEAT_FORKS_DIR"/*) error "Refusing to fork a fork: ${project/#${HOME}/~}"; exit 1 ;;
    esac
    # Its own spinner phase: the copy can take a moment on a filesystem
    # without copy-on-write, and printing into an already-running spinner
    # leaves a frozen glyph and two messages on one line.
    local _copy_rc=0
    spin "Copying workspace..."
    _fork_copy_tree "$project" "$_fork_path" || _copy_rc=$?
    spin_stop "$_copy_rc" "Workspace copied" "Workspace copy failed"
    if [[ $_copy_rc -ne 0 ]]; then
      rm -rf "$_fork_path"
      error "Could not copy the workspace. The fork was not created."
      echo -e "    ${DIM}An unreadable file in the project will do this. Fix it, or exclude it with a [fork] exclude line in .cleat.${RESET}"
      exit 1
    fi
    _fork_prune_excludes "$_fork_path" "$project"
    _fork_mark "$cname"
  fi
  if _box_is_fork "$cname"; then
    _fork_path="$(_fork_dir "$cname")"
    # The marker says this box is a fork. If the copy is gone we must NOT fall
    # back to the live tree: that is the silent re-bind this marker exists to
    # prevent. Refuse and tell the user how to resolve it.
    if [[ ! -d "$_fork_path" ]]; then
      error "This box is a fork but its workspace copy is missing."
      echo -e "    ${DIM}Expected: ${_fork_path/#${HOME}/~}${RESET}"
      echo -e "    ${DIM}Recreate it with ${BOLD}cleat start ${_BOX} --fork${RESET}${DIM}, or drop the fork with ${BOLD}cleat rm ${_BOX}${RESET}${DIM}.${RESET}"
      exit 1
    fi
    _workspace="$_fork_path"
  fi


  spin "Starting container..."

  # Clipboard bridge
  local clip_dir="$CLEAT_RUN_DIR/${cname}/clip"
  mkdir -p "$clip_dir"

  # ── Settings overlay ──────────────────────────────────────────────────────
  # When hooks OFF: strip hooks from settings (they'd fail in the container).
  # When hooks ON:  replace hook commands with an event forwarder; the host-side
  #                 bridge reads forwarded events and executes the real commands.
  local settings_overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  rm -rf "$settings_overlay_dir"
  mkdir -p "$settings_overlay_dir"
  local _overlay_ok=false
  if [[ -f "${HOME}/.claude/settings.json" ]] && [[ -s "${HOME}/.claude/settings.json" ]]; then
    if command -v jq &>/dev/null; then
      if cap_is_active hooks; then
        # Replace hook commands with forwarder; preserve event types and matchers
        local _forwarded
        _forwarded="$(jq '
          if .hooks then
            .hooks |= with_entries(.value |= [.[] |
              .hooks = [.hooks[] | select(.type == "command") |
                .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
              ]
            ])
          else . end
        ' "${HOME}/.claude/settings.json" 2>/dev/null)" || true
        if [[ -n "$_forwarded" ]]; then
          echo "$_forwarded" > "$settings_overlay_dir/settings.json"
          _overlay_ok=true
        fi
      else
        local _stripped
        _stripped="$(jq 'del(.hooks)' "${HOME}/.claude/settings.json" 2>/dev/null)" || true
        if [[ -n "$_stripped" ]]; then
          echo "$_stripped" > "$settings_overlay_dir/settings.json"
          _overlay_ok=true
        fi
      fi
    fi
  fi
  if ! $_overlay_ok; then
    echo '{}' > "$settings_overlay_dir/settings.json"
  fi

  # ── Per-project session isolation ──────────────────────────────────────
  # Claude Code stores sessions under ~/.claude/projects/<key>/ where key
  # is derived from the CWD. Inside containers CWD is always /workspace,
  # so all containers write to ~/.claude/projects/-workspace/. We overlay
  # that path with a per-project directory so each container sees only its
  # own sessions. Input history (arrow-up) lives in ~/.claude/history.jsonl.
  # We overlay that too so each project has its own history.
  # The base ~/.claude mount provides auth and global config.
  local project_session_key
  project_session_key="$(_derive_project_session_key "$project" "$box")"
  local project_session_dir="${HOME}/.claude/projects/${project_session_key}"
  mkdir -p "$project_session_dir"
  # Ensure per-project history file exists (Docker needs the source for bind mounts)
  touch "$project_session_dir/history.jsonl"
  # Also ensure host history.jsonl exists (macOS virtiofs rejects nested mounts
  # when the target file is missing inside the parent bind mount's source)
  touch "${HOME}/.claude/history.jsonl"
  # Also ensure the overlay target exists in the base mount (Docker needs it)
  mkdir -p "${HOME}/.claude/projects/-workspace"
  # Also ensure the settings-mask target exists in the base mount. Same
  # VirtioFS constraint as history.jsonl above: on macOS the nested file
  # mount fails when its target is missing inside the parent bind source. A
  # fresh host that never ran native claude has no ~/.claude/settings.json
  # (found 2026-07-10 running the integration suite against a real macOS
  # daemon; every developer machine masked it because the file existed).
  # Write '{}', not an empty file, so native claude still reads valid JSON.
  [[ -f "${HOME}/.claude/settings.json" ]] || echo '{}' > "${HOME}/.claude/settings.json"

  # ── Kit overlay (concept/34) ──────────────────────────────────────────────
  # Read-only masks over the base ~/.claude mount replace what the box sees at
  # ~/.claude/CLAUDE.md, agents, commands and skills with host-generated
  # content (the user's own content + the enabled kit for CLAUDE.md/agents, or
  # a plain pass-through copy). Mounted on EVERY box so enabling, switching, or
  # disabling a kit later is a content regeneration, never a recreate. :ro so
  # the caged agent cannot rewrite its own instructions, and (the hardening
  # property) can no longer write ANY of the host-user-level instruction
  # surfaces through the base mount that native host claude would obey: memory,
  # subagents, slash commands, skills and plugins. skills is the sharpest of
  # them: Claude Code auto-loads whatever sits there as a <name>@skills-dir
  # plugin, with no user action. plugins is self-masked (the host path over
  # itself, no copy) because it is a live runtime tree, 9 MB with a git
  # checkout in it. Read-only at its NORMAL path is deliberate: measured
  # 2026-07-25, claude reads marketplaces and installed plugins fine from a
  # read-only plugins dir, but redirecting the root with
  # CLAUDE_CODE_PLUGIN_CACHE_DIR made it report "No marketplaces configured"
  # and "No plugins installed", so the redirect was dropped. Installing a NEW
  # plugin inside a box fails EROFS by design; install on the host.
  # The box still READS the user's real content
  # (pass-through copy). Project-level /workspace/.claude/* is unaffected
  # (still writable in the repo).
  _generate_kit_overlay "$cname"
  # Mask targets must exist on the host before the nested mounts (VirtioFS);
  # dies with a clear remedy on a broken symlink. See _ensure_kit_mask_targets.
  _ensure_kit_mask_targets

  # Per-box replacements for the cross-project surfaces. See
  # _generate_home_overlay: a :ro self-mask would block writes but not reads,
  # so these are generated empties, never the host content.
  _generate_home_overlay "$cname" "$project" "$project_session_key"
  local home_overlay="$CLEAT_RUN_DIR/${cname}/home"

  local mount_args=(
    -v "$_workspace":/workspace
    -v "${HOME}/.claude:/home/coder/.claude"
    -v "$settings_overlay_dir/settings.json:/home/coder/.claude/settings.json"
    -v "$home_overlay/projects:/home/coder/.claude/projects:ro"
    -v "${project_session_dir}:/home/coder/.claude/projects/-workspace"
    -v "${project_session_dir}/history.jsonl:/home/coder/.claude/history.jsonl"
    -v "$CLEAT_RUN_DIR/${cname}/kit/CLAUDE.md:/home/coder/.claude/CLAUDE.md:ro"
    -v "$CLEAT_RUN_DIR/${cname}/kit/agents:/home/coder/.claude/agents:ro"
    -v "$CLEAT_RUN_DIR/${cname}/kit/commands:/home/coder/.claude/commands:ro"
    -v "$CLEAT_RUN_DIR/${cname}/kit/skills:/home/coder/.claude/skills:ro"
    -v "${HOME}/.claude/plugins:/home/coder/.claude/plugins:ro"
    -v "$clip_dir":/tmp/cleat-clip
  )

  # Per-box private dirs, read-write so Claude Code can use them normally, but
  # backed by this box's own empty directory instead of the shared host one.
  local _pd
  for _pd in $_CLAUDE_PRIVATE_DIRS; do
    mount_args+=(-v "$home_overlay/$_pd:/home/coder/.claude/$_pd")
  done

  # ── hooks capability: shared directory for event forwarding to host bridge
  if cap_is_active hooks; then
    local hooks_dir="$CLEAT_RUN_DIR/${cname}/hooks"
    mkdir -p "$hooks_dir"
    mount_args+=(-v "$hooks_dir":/var/log/cleat)
  fi

  # ── Project-level settings overlays ──────────────────────────────────────
  # When hooks ON:  replace hook commands with forwarder (host bridge executes originals)
  # When hooks OFF: strip hooks entirely (prevent container from running host commands)
  # Without an overlay, project .claude/settings*.json files are visible via the
  # workspace bind mount and Claude Code would try to run host commands (like
  # osascript) inside the container where they don't exist.
  # Guard on the WORKSPACE, not the project: for a fork box the nested mount
  # target lives inside the copy, and a copy without .claude would fail the
  # mount on macOS VirtioFS with an opaque "create mountpoint" error.
  if [[ -d "$_workspace/.claude" ]]; then
    local pf
    for pf in "$_workspace/.claude/settings.json" "$_workspace/.claude/settings.local.json"; do
      [[ -f "$pf" ]] || continue
      local _base _overlay_name
      _base="$(basename "$pf")"
      _overlay_name="project-$_base"
      if cap_is_active hooks; then
        # Replace hook commands with event forwarder
        if [[ -s "$pf" ]] && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
          jq '
            if .hooks then
              .hooks |= with_entries(.value |= [.[] |
                .hooks = [.hooks[] | select(.type == "command") |
                  .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
                ]
              ])
            else . end
          ' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
        else
          cp "$pf" "$settings_overlay_dir/$_overlay_name"
        fi
      else
        # Strip hooks so container can't run host-specific commands
        if [[ -s "$pf" ]] && command -v jq &>/dev/null && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
          jq 'del(.hooks)' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
        else
          cp "$pf" "$settings_overlay_dir/$_overlay_name"
        fi
      fi
      mount_args+=(-v "$settings_overlay_dir/$_overlay_name:/workspace/.claude/$_base")
    done
  fi

  # ── Per-project Claude global-state (.claude.json) isolation ──────────────
  # Build an isolated, persistent per-project ~/.claude.json instead of mounting
  # the shared host file directly. The shared mount let concurrent containers
  # truncate the file (→ "Configuration Error / Unexpected EOF") and leaked
  # trust/MCP approvals across projects. See _build_project_claude_json.
  local project_claude_json="$CLEAT_PROJECTS_DIR/${project_session_key}/claude.json"
  _build_project_claude_json "$project_claude_json"
  mount_args+=(-v "$project_claude_json:/home/coder/.claude.json")

  # ── git capability: mount gitconfig (read-only) for commit identity
  if cap_is_active git; then
    if [[ -f "${HOME}/.gitconfig" ]]; then
      mount_args+=(-v "${HOME}/.gitconfig:/home/coder/.gitconfig:ro")
    fi
  fi

  # ── ssh capability: mount SSH keys (read-only) and forward agent
  if cap_is_active ssh; then
    if [[ -d "${HOME}/.ssh" ]]; then
      mount_args+=(-v "${HOME}/.ssh:/home/coder/.ssh:ro")
    fi
  fi

  local ssh_args=()
  if cap_is_active ssh && [[ -S "${SSH_AUTH_SOCK:-}" ]]; then
    ssh_args+=(-v "${SSH_AUTH_SOCK}:/tmp/ssh-agent.sock" -e "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
  fi

  # ── gh capability: mount GitHub CLI config (read-write) for token auth
  # Read-write so `gh auth login` inside the container writes tokens back to the
  # host, same model as ~/.claude. Create dir if missing so users can auth from
  # inside the container even without gh installed on the host.
  if cap_is_active gh; then
    mkdir -p "${HOME}/.config/gh"
    mount_args+=(-v "${HOME}/.config/gh:/home/coder/.config/gh")
  fi

  # ── docker capability: mount the host Docker socket so the container can
  # build, run, and manage Docker workloads against the host daemon. Also
  # bind-mount the project at its HOST path (in addition to /workspace) and
  # set workdir there, so $(pwd) returns a host-valid path and bind-mount
  # sources in `docker run -v $(pwd):/app` resolve on the host daemon.
  # Full rationale: concept/15-docker-capability.md.
  local docker_args=()
  if cap_is_active docker; then
    mount_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
    # A fork box must expose its COPY at the host path, never the live tree:
    # mounting $project here would hand a fork box the real working directory
    # read-write and point its workdir at it, cancelling the isolation.
    mount_args+=(-v "$_workspace:$_workspace")
    docker_args+=(--workdir "$_workspace" -e "CLEAT_HOST_PROJECT=$_workspace")
    # Session-dir unification: with the docker cap, workdir is the host path
    # (not /workspace), so Claude Code encodes its session directory from
    # that path ('/Users/marcin/proj' → 'projects/-Users-marcin-proj/')
    # instead of the v0.8.0-assumed 'projects/-workspace/'. Overlay the
    # per-project session dir at the host-path-derived location too, so
    # sessions land in the same place regardless of which cap was active
    # when they were created. Slashes become dashes to match Claude's key.
    local _host_project_key="${project//\//-}"
    mkdir -p "${HOME}/.claude/projects/${_host_project_key}"
    mount_args+=(-v "${project_session_dir}:/home/coder/.claude/projects/${_host_project_key}")
  fi

  # ── Per-box memory ceiling. --memory-swap equal to --memory disables swap
  # for the box: a runaway process OOMs inside its own cgroup instead of
  # dragging the whole VM (and every other session) into swap-thrash.
  local box_memory
  box_memory="$(resolve_box_memory "$project" "$box")"

  # ── Per-box CPU ceiling, only when configured ([resources] cpus). No
  # default: CPU is work-conserving, so an unconfigured box keeps all cores.
  local box_cpus cpu_args=()
  box_cpus="$(resolve_box_cpus "$project" "$box")"
  [[ -n "$box_cpus" ]] && cpu_args=(--cpus "$box_cpus")

  # ── Compute config fingerprint and store as label, prefixed with the storage
  # format version so a later formula change is detectable (see _CONFIG_FP_VERSION).
  local config_hash
  config_hash="v${_CONFIG_FP_VERSION}:$(compute_config_fingerprint "$project")"

  local label_args=(
    --label "sh.cleat.config-hash=$config_hash"
    --label "sh.cleat.version=$VERSION"
    --label "sh.cleat.box=$box"
  )

  # ── Host connectivity: always-on so user-defined hooks and MCP servers work
  local host_args=()
  if ! _is_docker_desktop 2>/dev/null; then
    host_args+=(--add-host "host.docker.internal:host-gateway")
  fi

  # BROWSER points at the in-container open shim. Claude Code 2.1.191+ refuses
  # to invoke any opener on a display-less Linux system unless $BROWSER is set,
  # and its login drops to the manual code-paste flow; with BROWSER set it
  # opens through the shim and keeps the hands-free loopback login, which the
  # host-side callback proxy completes. Passed at create (not only baked into
  # the image) so boxes recreated from an older image get it too. Placed BEFORE
  # the user's [env] args: docker's last -e wins, so a .cleat `BROWSER=` can
  # override the shim.
  local _docker_err="/tmp/cleat-err.$$"
  local run_rc=0
  docker run -d \
    --name "$cname" \
    "${mount_args[@]}" \
    "${ssh_args[@]+"${ssh_args[@]}"}" \
    "${docker_args[@]+"${docker_args[@]}"}" \
    "${host_args[@]+"${host_args[@]}"}" \
    -e "BROWSER=/usr/local/bin/open-bridge" \
    "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" \
    "${label_args[@]}" \
    -e "HOST_UID=$(id -u)" \
    -e "HOST_GID=$(id -g)" \
    -e "HOME=/home/coder" \
    --pids-limit 4096 \
    --memory "$box_memory" \
    --memory-swap "$box_memory" \
    "${cpu_args[@]+"${cpu_args[@]}"}" \
    --init \
    -it \
    "$IMAGE_NAME" > /dev/null 2>"$_docker_err" || run_rc=$?
  spin_stop "$run_rc" "Container started" "Container failed to start"
  if [[ $run_rc -ne 0 ]]; then
    [[ -s "$_docker_err" ]] && error "${DIM}$(cat "$_docker_err")${RESET}"
    # A full store is a common opaque bring-up failure. The disk gate cannot read
    # fill when the box will not start, so this ENOSPC backstop covers it.
    _maybe_explain_enospc "$_docker_err"
    rm -f "$_docker_err"
    # Clean up any partial container state so the next attempt starts fresh
    docker rm -f "$cname" > /dev/null 2>&1 || true
    exit 1
  fi
  rm -f "$_docker_err"

  # A --desc set at creation time (host-side, keyed by cname; never recreates).
  if [[ "${_CLI_DESC_SET:-0}" == "1" ]]; then
    _box_desc_write "$cname" "$_CLI_DESC"
  fi

  # First run of this fresh container: apply [setup] provisioning, if any was
  # approved by the resolve_caps call above. Covers direct `cleat run` and
  # every recreate funnel that ends up here.
  _maybe_run_setup "$cname" "$project" "${_BOX:-main}" || true
}

cmd_start() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  _RESOLVED_PROJECT="$project"
  local cname
  cname="$(container_name_for "$project" "$box")"

  # Resolve caps early for startup output and drift detection
  resolve_caps "$project"
  resolve_env_args "$project"

  # Config drift (caps/env keys changed since container was created): prompt
  # to recreate before any docker operations. On accept this removes the
  # container so the branches below fall into cmd_run with the new settings.
  _resolve_config_drift "$cname" "$project"

  # Image-version drift: offer to rebuild before any docker operations. On
  # accept it removes the container too, so the branches below recreate it
  # from the freshly-built image.
  _maybe_prompt_image_rebuild "$cname"

  # Reaper drift: a box created without --init wedges on long sessions; offer
  # a recreate (the branches below then recreate it with the current flags).
  _maybe_prompt_init_recreate "$cname"

  # Refresh the kit overlay (the selection or the user's own CLAUDE.md/agents
  # may have changed between sessions). In-place, so it lands for stopped AND
  # running boxes; pre-kit boxes (no mask mounts) are skipped, see concept/34.
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
  fi
  _maybe_note_missing_kit_masks "$cname"

  # Start container if not running (restart stopped ones)
  if ! is_running "$cname"; then
    if container_exists "$cname"; then
      # Detect stale mounts. The container's bind sources are baked in at
      # creation and `docker start` re-mounts them as-is, so if any has moved
      # or vanished the start aborts with an opaque OCI error; recreate
      # instead. Two independent classes: a missing/wrong-type settings overlay
      # (_settings_overlay_intact), and any vanished bind source, most often
      # the macOS SSH agent socket, whose launchd path rotates every reboot
      # (_container_bind_sources_present).
      if ! _settings_overlay_intact "$cname" || ! _container_bind_sources_present "$cname"; then
        info "Recreating container ${DIM}(host paths changed)"
        docker rm -f "$cname" > /dev/null 2>&1 || true
        cmd_run "$project"
      else
        # Restarting a stopped container: image already exists
        success "Image ready ${RESET}${DIM}(cached)"
        # Fold host-side changes and logins from other boxes into this box's
        # ~/.claude.json while it is safely stopped (docker start re-resolves
        # the bind source). See _refresh_project_claude_json.
        _refresh_project_claude_json "$project" "$box"
        spin "Starting container..."
        local _docker_err="/tmp/cleat-err.$$"
        local start_rc=0
        docker start "$cname" > /dev/null 2>"$_docker_err" || start_rc=$?
        spin_stop "$start_rc" "Container started" "Container failed to start"
        if [[ $start_rc -ne 0 ]]; then
          [[ -s "$_docker_err" ]] && error "${DIM}$(cat "$_docker_err")${RESET}"
          rm -f "$_docker_err"
          if _is_tty; then
            echo ""
            local yn=""
            _ask_yn yn "Remove container and start fresh? [Y/n] "
            if [[ -z "$yn" || "$yn" == [yY]* ]]; then
              docker rm -f "$cname" > /dev/null 2>&1 || true
              success "Removed ${BOLD}$cname${RESET}."
              cmd_run "$project"
            else
              exit 1
            fi
          else
            error "Try ${BOLD}cleat rm${RESET} then ${BOLD}cleat${RESET} to recreate."
            exit 1
          fi
        fi
        rm -f "$_docker_err" 2>/dev/null
      fi
    else
      cmd_run "$project"
    fi
  else
    success "Image ready ${RESET}${DIM}(cached)"
    success "Container started"
  fi

  success "Auth shared"

  # Docker cap is the only capability that breaks the sandbox: loud warning.
  if cap_is_active docker; then
    warn_sandbox "Docker socket mounted. Container can create host-level processes"
  fi

  show_first_run_tip

  # A start that funneled through cmd_run above already ran this; this second
  # call is a silent marker no-op by design (the run-once marker is already
  # written), so every `cleat start` still gets a chance to apply [setup] on a
  # container that was created some other way (e.g. a bare `docker run`).
  _maybe_run_setup "$cname" "$project" "${_BOX:-main}" || true

  success "Claude launched"
  _print_summary_block "$cname" "$project"
  _maybe_gate_on_disk_fill "$cname"
  echo ""
  exec_claude "$cname" --dangerously-skip-permissions
}

cmd_resume() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  _RESOLVED_PROJECT="$project"
  local cname
  cname="$(container_name_for "$project" "$box")"

  # Resolve caps for startup output and drift detection
  resolve_caps "$project"
  resolve_env_args "$project"

  # Config drift: prompt to recreate before refreshing overlays. If the user
  # accepts, the container and tmp dirs are gone; the missing-container path
  # below will call cmd_run, which rebuilds the overlay from scratch.
  _resolve_config_drift "$cname" "$project"

  # Image-version drift: offer to rebuild (and recreate) before resuming.
  _maybe_prompt_image_rebuild "$cname"

  # Reaper drift: a box created without --init wedges on long sessions; offer
  # a recreate (the missing-container path below then recreates it).
  _maybe_prompt_init_recreate "$cname"

  # Refresh the kit overlay (selection or the user's own CLAUDE.md/agents may
  # have changed between sessions); pre-kit boxes are skipped, see concept/34.
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
  fi
  _maybe_note_missing_kit_masks "$cname"

  # Refresh settings overlays (user may have changed hooks between stop/resume)
  local settings_overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  if [[ -d "$settings_overlay_dir" ]] && command -v jq &>/dev/null; then
    # Global settings overlay
    if [[ -f "${HOME}/.claude/settings.json" ]]; then
      if cap_is_active hooks; then
        jq '
          if .hooks then
            .hooks |= with_entries(.value |= [.[] |
              .hooks = [.hooks[] | select(.type == "command") |
                .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
              ]
            ])
          else . end
        ' "${HOME}/.claude/settings.json" > "$settings_overlay_dir/settings.json" 2>/dev/null || true
      else
        jq 'del(.hooks)' "${HOME}/.claude/settings.json" > "$settings_overlay_dir/settings.json" 2>/dev/null || true
      fi
    fi
    # Project-level settings overlays (only when .claude/ exists)
    if cap_is_active hooks && [[ -d "$project/.claude" ]]; then
      local pf
      for pf in "$project/.claude/settings.json" "$project/.claude/settings.local.json"; do
        local _base _overlay_name
        _base="$(basename "$pf")"
        _overlay_name="project-$_base"
        if [[ -s "$pf" ]] && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
          jq '
            if .hooks then
              .hooks |= with_entries(.value |= [.[] |
                .hooks = [.hooks[] | select(.type == "command") |
                  .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
                ]
              ])
            else . end
          ' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
        elif [[ -f "$pf" ]]; then
          cp "$pf" "$settings_overlay_dir/$_overlay_name"
        else
          echo '{}' > "$settings_overlay_dir/$_overlay_name"
        fi
      done
    fi
  fi

  # Start container if stopped
  if ! is_running "$cname"; then
    if container_exists "$cname"; then
      # Detect stale mounts and recreate transparently (sessions live on the
      # host, so --continue below still resumes the conversation). A missing
      # settings overlay (_settings_overlay_intact) or any vanished bind source,
      # most often the macOS SSH agent socket, whose launchd path rotates
      # every reboot (_container_bind_sources_present), would otherwise make
      # `docker start` abort with an opaque OCI error.
      if ! _settings_overlay_intact "$cname" || ! _container_bind_sources_present "$cname"; then
        info "Recreating container ${DIM}(host paths changed)${RESET}"
        docker rm -f "$cname" > /dev/null 2>&1 || true
        cmd_run "$project"
      else
        # Same stopped-container refresh as cmd_start: fold in host changes and
        # logins from other boxes before the bind source is re-resolved.
        _refresh_project_claude_json "$project" "$box"
        local _docker_err="/tmp/cleat-err.$$"
        local resume_rc=0
        docker start "$cname" > /dev/null 2>"$_docker_err" || resume_rc=$?
        if [[ $resume_rc -ne 0 ]]; then
          error "Container failed to start."
          [[ -s "$_docker_err" ]] && error "${DIM}$(cat "$_docker_err")${RESET}"
          rm -f "$_docker_err"
          error "Try ${BOLD}cleat rm${RESET} then ${BOLD}cleat${RESET} to recreate."
          exit 1
        fi
        rm -f "$_docker_err" 2>/dev/null
      fi
    else
      # No container exists (e.g., after `cleat rm`). Session files live on
      # the host at ~/.claude/projects/<key>/, so `--continue` below will
      # pick up right where Claude left off. Create a fresh container and
      # fall through to the resume flow.
      info "No container for this project. Creating fresh ${DIM}(sessions will resume from host)${RESET}"
      cmd_run "$project"
    fi
  fi

  # Docker cap is the only capability that breaks the sandbox: loud warning.
  if cap_is_active docker; then
    warn_sandbox "Docker socket mounted. Container can create host-level processes"
  fi

  _maybe_run_setup "$cname" "$project" "${_BOX:-main}" || true

  success "Session resumed"
  _print_summary_block "$cname" "$project"
  _maybe_gate_on_disk_fill "$cname"
  echo ""
  exec_claude "$cname" --dangerously-skip-permissions --continue
}

cmd_stop() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  if is_running "$cname"; then
    docker stop "$cname" > /dev/null 2>&1
    success "Session ended. Resume with: ${BOLD}cleat resume${RESET}"
  else
    info "Container not running."
  fi
}

cmd_rm() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  if is_running "$cname"; then
    docker stop "$cname" > /dev/null
  fi
  if container_exists "$cname"; then
    docker rm "$cname" > /dev/null
    # Clean up this container's runtime dir: sessions on the host are
    # intentionally NOT touched; they live at ~/.claude/projects/<key>/ and
    # survive cleat rm.
    rm -rf "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
    success "Removed ${BOLD}${cname}${RESET}."
    echo -e "    ${DIM}Sessions preserved. Run ${BOLD}cleat resume${RESET}${DIM} to pick up where you left off.${RESET}"
    echo -e "    ${DIM}The box's disk layer is freed. Its image and build cache stay in the shared Docker disk: ${RESET}${BOLD}cleat storage${RESET}${DIM} shows what is left.${RESET}"
  else
    info "No container to remove."
  fi
  # Remove the box's host-side description and kit selection unconditionally:
  # `cleat rm <box>` is the documented removal path even for a box that was
  # only ever describe'd or kitted.
  _box_desc_remove "$cname"
  _box_kit_remove "$cname"
  # A fork's workspace copy is NOT removed here, deliberately. It can hold the
  # only copy of hours of work, and for a project with no git at all there is
  # no cheap "is anything unlanded" check to gate a delete on. Silently
  # destroying it is the exact data loss Cleat exists to prevent. So `cleat rm`
  # frees the container and leaves the workspace, keeping the marker so a later
  # `cleat run <box>` picks the same fork back up.
  if _box_is_fork "$cname"; then
    local _fp
    _fp="$(_fork_dir "$cname")"
    if [[ -d "$_fp" ]]; then
      info "Fork workspace kept: ${BOLD}${_fp/#${HOME}/~}${RESET}"
      echo -e "    ${DIM}Re-running this box reuses it. Remove it yourself when you are done.${RESET}"
    fi
  fi
}

cmd_shell() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  require_running "$cname"
  _wait_for_coder_remap "$cname"
  resolve_caps "$project"
  # resolve_caps may have just prompted for and approved [setup]; honor it
  # here so entering the box actually provisions (a no-op once the marker is
  # written). Without this the prompt would show but nothing would run.
  _maybe_run_setup "$cname" "$project" "$box" || true
  resolve_env_args "$project"
  _ensure_docker_access "$cname"

  # Browser bridge for shell sessions too. $BROWSER in the box points at the
  # open shim, so a `claude /login` (or gh auth, etc.) run from this shell
  # emits its URL through the bridge file; without a watcher the URL would go
  # nowhere and a loopback login would wait forever on a callback. Same
  # parameters as exec_claude: auto mode defers plain links to this terminal,
  # auth URLs open on the host.
  local _shell_clip_dir="$CLEAT_RUN_DIR/${cname}/clip"
  mkdir -p "$_shell_clip_dir"
  local _shell_open_cmd _shell_bw_pid=""
  _shell_open_cmd="$(_host_open_cmd)"
  if [ -n "$_shell_open_cmd" ]; then
    local _shell_interactive=0
    _is_tty && _shell_interactive=1
    # Terminal-safety redirect (see exec_claude): keep a fork-starved watcher's
    # stderr out of this shell's TUI, in a per-box log instead.
    _browser_watcher "$_shell_clip_dir" "$_shell_open_cmd" "$cname" "$(_browser_bridge_mode)" "$_shell_interactive" >>"$_shell_clip_dir/.watcher-log" 2>&1 &
    _shell_bw_pid=$!
    disown "$_shell_bw_pid" 2>/dev/null || true
  fi

  info "Container ${BOLD}${cname}${RESET}"
  local shell_rc=0
  docker exec -it "${CLAUDE_ENV[@]}" \
    "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" "$cname" \
    runuser -u coder -- bash || shell_rc=$?

  if [ -n "$_shell_bw_pid" ]; then
    kill "$_shell_bw_pid" 2>/dev/null || true
    wait "$_shell_bw_pid" 2>/dev/null || true
  fi
  rm -f "$_shell_clip_dir/.browser-open"

  _restore_terminal
  return "$shell_rc"
}

cmd_login() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  require_running "$cname"
  _wait_for_coder_remap "$cname"
  resolve_caps "$project"
  # Honor a just-approved [setup] so the login prompt to approve it is not
  # shown without effect (no-op once the marker is written).
  _maybe_run_setup "$cname" "$project" "$box" || true
  resolve_env_args "$project"
  info "Authenticating with your Anthropic team account..."

  # Start browser bridge so auth URL opens automatically and callback works
  local _login_clip_dir="$CLEAT_RUN_DIR/${cname}/clip"
  local _login_browser_pid=""
  local _login_open_cmd
  _login_open_cmd="$(_host_open_cmd)"

  if [ -n "$_login_open_cmd" ]; then
    mkdir -p "$_login_clip_dir"
    local _login_bridge_mode
    _login_bridge_mode="$(_browser_bridge_mode)"
    # host_opens_clicks=0: this watcher only ever sees the auth URL `claude login`
    # launches programmatically through the open shim, never a link the user
    # clicked, so the terminal will NOT open it and deferral is never correct here.
    # The bridge must open it in auto/always: _is_auth_url matches any
    # redirect_uri= URL, the console code-paste authorize URL included, so both
    # login flows auto-open; only CLEAT_BROWSER_BRIDGE=off withholds the
    # auto-open (the callback proxy still runs).
    # Terminal-safety redirect (see exec_claude): keep a fork-starved watcher's
    # stderr out of the login TUI, in a per-box log instead.
    _browser_watcher "$_login_clip_dir" "$_login_open_cmd" "$cname" "$_login_bridge_mode" "0" >>"$_login_clip_dir/.watcher-log" 2>&1 &
    _login_browser_pid=$!
    disown "$_login_browser_pid" 2>/dev/null || true
    if [ "$_login_bridge_mode" = off ]; then
      echo -e "  ${DIM}A URL will appear. Open it in your browser to sign in ${RESET}${DIM}(CLEAT_BROWSER_BRIDGE=off).${RESET}"
    else
      echo -e "  ${DIM}Your browser will open automatically for sign-in.${RESET}"
    fi
  else
    echo -e "  ${DIM}A URL will appear. Open it in your browser to sign in.${RESET}"
  fi
  echo ""

  _ensure_docker_access "$cname"
  local login_rc=0
  docker exec -it "${CLAUDE_ENV[@]}" \
    "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" "$cname" \
    runuser -u coder -- claude login || login_rc=$?
  _restore_terminal

  # Cleanup browser bridge
  if [ -n "$_login_browser_pid" ]; then
    kill "$_login_browser_pid" 2>/dev/null || true
    wait "$_login_browser_pid" 2>/dev/null || true
  fi
  rm -f "$_login_clip_dir/.browser-open"

  if [[ $login_rc -eq 0 ]]; then
    success "Auth saved to ~/.claude (shared across all containers)."
  fi
}

cmd_claude() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  require_running "$cname"
  _RESOLVED_PROJECT="$project"
  resolve_caps "$project"
  resolve_env_args "$project"

  # Config drift: prompt to recreate. If accepted the container is gone, so
  # call cmd_run to rebuild it before attaching.
  _resolve_config_drift "$cname" "$project"
  if ! container_exists "$cname"; then
    cmd_run "$project"
  fi
  _maybe_note_missing_kit_masks "$cname"
  _maybe_run_setup "$cname" "$project" "$box" || true

  # Refresh project-level settings overlays (hooks may have changed)
  local settings_overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  if [[ -d "$settings_overlay_dir" ]] && command -v jq &>/dev/null && cap_is_active hooks && [[ -d "$project/.claude" ]]; then
    local pf
    for pf in "$project/.claude/settings.json" "$project/.claude/settings.local.json"; do
      local _base _overlay_name
      _base="$(basename "$pf")"
      _overlay_name="project-$_base"
      if [[ -s "$pf" ]] && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
        jq '
          if .hooks then
            .hooks |= with_entries(.value |= [.[] |
              .hooks = [.hooks[] | select(.type == "command") |
                .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
              ]
            ])
          else . end
        ' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
      elif [[ -f "$pf" ]]; then
        cp "$pf" "$settings_overlay_dir/$_overlay_name"
      else
        echo '{}' > "$settings_overlay_dir/$_overlay_name"
      fi
    done
  fi

  if cap_is_active docker; then
    warn_sandbox "Docker socket mounted. Container can create host-level processes"
  fi

  success "Claude launched"
  _print_summary_block "$cname" "$project"
  _maybe_gate_on_disk_fill "$cname"
  echo ""
  exec_claude "$cname" --dangerously-skip-permissions
}

cmd_logs() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"
  require_running "$cname"
  docker logs -f "$cname"
}

cmd_ps() {
  echo ""
  echo -e "  ${BOLD}Cleat containers:${RESET}"
  echo ""
  local found=false
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      found=true
      local name status project_path color meta box_label running rest
      name="$(echo "$line" | awk -F'\t' '{print $1}' | xargs)"
      status="$(echo "$line" | awk -F'\t' '{print $2}' | xargs)"

      # Exit 255 is the Docker-restart signature (the VM went away under the
      # box); without the hint it reads as a crash. RestartPolicy is 'no' by
      # design, so a restarted Docker leaves every box stopped.
      [[ "$status" == *"Exited (255)"* ]] && status="${status}. Docker restarted; resume with: cleat resume"

      # One inspect per container yields everything this row renders: the box
      # label, the running state (dot colour) and the /workspace mount source.
      # Field order is box|running|path so a literal '|' in the project path
      # (legal on disk) falls into the trailing field and can't corrupt the
      # parse of the two fixed-charset fields ahead of it.
      meta="$(docker inspect "$name" --format '{{index .Config.Labels "sh.cleat.box"}}|{{.State.Running}}|{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null)"
      box_label="${meta%%|*}"
      rest="${meta#*|}"
      running="${rest%%|*}"
      project_path="${rest#*|}"

      if [[ "$running" == "true" ]]; then color="$GREEN"; else color="$YELLOW"; fi

      # Box column: read from the sh.cleat.box label (concept/20-boxes.md).
      # Containers created before boxes (or the default box) have no label or
      # "main"; either way show nothing extra to keep the default view clean.
      [[ -z "$box_label" || "$box_label" == "<no value>" ]] && box_label="main"

      if [[ "$box_label" != "main" ]]; then
        echo -e "    ${color}●${RESET} ${BOLD}${name}${RESET}  ${DIM}[box: ${box_label}]${RESET}"
      else
        echo -e "    ${color}●${RESET} ${BOLD}${name}${RESET}"
      fi
      echo -e "      ${DIM}${status}${RESET}"
      local box_desc
      box_desc="$(_box_desc_read "$name" | head -n 1)"
      if [[ -n "$box_desc" ]]; then printf '      %b%s%b\n' "$DIM" "$box_desc" "$RESET"; fi
      if [[ -n "$project_path" ]]; then
        echo -e "      ${DIM}${project_path}${RESET}"
      fi
    fi
  done < <(docker ps -a --filter "name=^cleat-" --format "{{.Names}}\t{{.Status}}" 2>/dev/null)

  if ! $found; then
    echo -e "    ${DIM}No containers found.${RESET}"
  fi
  echo ""
  echo -e "  ${DIM}Resume with: cd <project-dir> && cleat resume${RESET}"
  echo ""
}

cmd_stop_all() {
  info "Stopping all Cleat containers..."
  local containers
  containers=$(docker ps -a --filter "name=^cleat-" --format '{{.Names}}' 2>/dev/null)
  if [[ -z "$containers" ]]; then
    info "Nothing to stop."
    return
  fi
  echo "$containers" | while read -r c; do
    docker stop "$c" > /dev/null 2>&1 || true
    docker rm "$c" > /dev/null 2>&1 || true
    echo -e "    ${DIM}removed ${c}${RESET}"
  done
  # Box descriptions are keyed by container name; drop any whose container is now
  # gone (mirrors cmd_clean) so a stale label can't resurrect on box recreate.
  if [[ -d "$CLEAT_BOXES_DIR" ]]; then
    local _bf _bcn
    for _bf in "$CLEAT_BOXES_DIR"/*; do
      [[ -f "$_bf" ]] || continue
      _bcn="$(basename "$_bf")"
      # Per-box state files may carry a suffix (<cname>.fork). Strip it, or the
      # basename never matches a container, the file is pruned, and a fork box
      # silently reverts to mounting the LIVE tree on its next run.
      _bcn="${_bcn%.fork}"
      if ! container_exists "$_bcn"; then rm -f "$_bf" 2>/dev/null || true; fi
    done
  fi
  success "All stopped."
}

cmd_status() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  # Resolve caps for display only: never trigger a trust prompt from
  # a read-only status call.
  resolve_caps "$project" readonly

  echo ""
  echo -e "  ${BOLD}Project:${RESET}   ${project}"
  echo -e "  ${BOLD}Container:${RESET} ${cname}"

  if is_running "$cname"; then
    echo -e "  ${BOLD}Status:${RESET}    ${GREEN}● running${RESET}"
    # Zombie pressure: a pre---init box accumulates unreapable zombies until
    # fork() fails at the pids cap and the session freezes. Surface the count
    # while it's still a warning, not a wedge.
    local _zombies
    _zombies="$(_box_zombie_count "$cname")"
    if [[ "$_zombies" =~ ^[0-9]+$ ]] && (( _zombies > 0 )); then
      echo -e "  ${BOLD}Zombies:${RESET}   ${AMBER}● ${_zombies} unreaped${RESET} ${DIM}(recreate the box to get the --init reaper: cleat rm && cleat)${RESET}"
    fi
  elif container_exists "$cname"; then
    echo -e "  ${BOLD}Status:${RESET}    ${YELLOW}● stopped${RESET}"
  elif ! _docker_cli_present; then
    # Not installed is distinct from not running: hand over the install command,
    # not a "start it" that can't work. Read-only verbs never act, only tell.
    echo -e "  ${BOLD}Status:${RESET}    ${AMBER}● Docker isn't installed${RESET} ${DIM}(install it with: $(_docker_install_hint))${RESET}"
  elif ! _daemon_up; then
    # Don't claim "not created" when the daemon is merely off: is_running and
    # container_exists are both false-negative against a down daemon, and the
    # old line lied after every reboot. Read-only verbs never auto-start;
    # they just tell the truth. Only glue a real command into "start it with:";
    # for kinds with no single command, print the instruction bare.
    local _sk _sh
    _sk="$(_autostart_pick)"
    _sh="$(_autostart_hint "$_sk")"
    if _autostart_hint_is_command "$_sk"; then
      echo -e "  ${BOLD}Status:${RESET}    ${AMBER}● Docker isn't running${RESET} ${DIM}(start it with: ${_sh})${RESET}"
    else
      echo -e "  ${BOLD}Status:${RESET}    ${AMBER}● Docker isn't running${RESET} ${DIM}(${_sh})${RESET}"
    fi
  else
    echo -e "  ${BOLD}Status:${RESET}    ${DIM}○ not created${RESET}"
  fi

  if image_exists; then
    local size iarch darch
    size=$(docker images "$IMAGE_NAME" --format '{{.Size}}' | head -1)
    iarch="$(_image_arch "$IMAGE_NAME")"
    darch="$(_daemon_arch)"
    if [[ -n "$iarch" && -n "$darch" && "$iarch" != "$darch" ]]; then
      # Loud: an emulated image is the documented trigger for node crashes
      # and garbled TTYs, and the next `cleat start` will replace it anyway.
      echo -e "  ${BOLD}Image:${RESET}     ${AMBER}● ${IMAGE_NAME} (${iarch}, EMULATED on ${darch}; next start fetches native)${RESET} ${DIM}(${size})${RESET}"
    elif [[ -n "$iarch" ]]; then
      echo -e "  ${BOLD}Image:${RESET}     ${GREEN}● ${IMAGE_NAME}${RESET} ${DIM}(${iarch}, ${size})${RESET}"
    else
      echo -e "  ${BOLD}Image:${RESET}     ${GREEN}● ${IMAGE_NAME}${RESET} ${DIM}(${size})${RESET}"
    fi
  else
    echo -e "  ${BOLD}Image:${RESET}     ${DIM}○ not built${RESET}"
  fi

  if [[ -d "${HOME}/.claude" ]] && find "${HOME}/.claude" -name '.credentials*' -o -name 'credentials*' 2>/dev/null | grep -q .; then
    echo -e "  ${BOLD}Auth:${RESET}      ${GREEN}● logged in${RESET} ${DIM}(via ~/.claude)${RESET}"
  else
    echo -e "  ${BOLD}Auth:${RESET}      ${YELLOW}○ not configured${RESET} ${DIM}(cleat login)${RESET}"
  fi

  # Show active capabilities: same categorized renderer as the post-launch
  # summary block; status passes BOLD to match the other status labels.
  if [[ ${#ACTIVE_CAPS[@]} -gt 0 ]]; then
    _print_caps "  " "Caps:" "      " "$BOLD"
  else
    echo -e "  ${BOLD}Caps:${RESET}      ${DIM}none${RESET} ${DIM}(cleat config)${RESET}"
  fi

  # ── Boxes: every sandbox for this project (see concept/20-boxes.md). The
  # detail above is the main box; this lists all boxes (main + named) so you
  # can see what exists here. Boxes are discovered by the INVARIANT project hash
  # plus the sh.cleat.box label and the /workspace mount source, NOT the main
  # container-name prefix (container_name_for re-truncates the dir segment per
  # box, so a long project dir would otherwise HIDE named boxes here, and a
  # sibling project could collide on the prefix and show a phantom box). The
  # `< <(... || true)` form also keeps `set -euo pipefail` from aborting status
  # when the docker daemon is down. See concept/20-boxes.md.
  echo ""
  echo -e "  ${BOLD}Boxes:${RESET}"
  local _main_cname _hash _n _meta _b _rest _running _src
  _main_cname="$(container_name_for "$project" main)"
  _hash="$(echo -n "$project" | _md5 | head -c 8)"
  # Third arg is an OPTIONAL pre-resolved running state ("true"/"false"). The
  # named-box loop already learns this from its one discovery inspect, so it
  # passes it here to skip the is_running + container_exists docker calls. The
  # main row passes nothing and falls back to probing (it may not exist yet).
  _status_box_row() {
    local _bx="$1" _cn="$2" _known="${3:-}"
    if [[ "$_known" == "true" ]]; then
      echo -e "    ${GREEN}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}running${RESET}"
    elif [[ "$_known" == "false" ]]; then
      echo -e "    ${YELLOW}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}stopped${RESET}"
    elif is_running "$_cn"; then
      echo -e "    ${GREEN}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}running${RESET}"
    elif container_exists "$_cn"; then
      echo -e "    ${YELLOW}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}stopped${RESET}"
    elif ! _daemon_up; then
      # Same honesty rule as the Status line above: against a down daemon the
      # probes are blind, so "not created" would lie about every box.
      echo -e "    ${DIM}○ ${_bx}${RESET} ${DIM}unknown (Docker isn't running)${RESET}"
    else
      echo -e "    ${DIM}○ ${_bx}${RESET} ${DIM}not created${RESET}"
    fi
    # First line only: a multi-line description must not break the list layout.
    local _desc
    _desc="$(_box_desc_read "$_cn" | head -n 1)"
    if [[ -n "$_desc" ]]; then printf '        %b%s%b\n' "$DIM" "$_desc" "$RESET"; fi
  }
  _status_box_row "main" "$_main_cname"
  while IFS= read -r _n; do
    [[ -z "$_n" ]] && continue
    # Cheap pre-filter on the invariant hash; the mount-source check below is
    # authoritative (a sibling project could embed this hash in its dir name).
    case "$_n" in *"-${_hash}"*) ;; *) continue ;; esac
    # One inspect per candidate yields label|running|workspace-source. Field
    # order keeps the (possibly '|'-bearing) path trailing so it can't corrupt
    # the parse of the two fixed-charset fields ahead of it.
    _meta="$(docker inspect "$_n" --format '{{index .Config.Labels "sh.cleat.box"}}|{{.State.Running}}|{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null || true)"
    _b="${_meta%%|*}"
    _rest="${_meta#*|}"
    _running="${_rest%%|*}"
    _src="${_rest#*|}"
    if [[ -z "$_b" || "$_b" == "<no value>" ]]; then _b="main"; fi
    # A fork box mounts its own COPY at /workspace, so its mount source is the
    # forks path, not the project path. Match that too, or every fork box
    # silently vanishes from Boxes while still showing up in `cleat ps`.
    [[ "$_src" == "$project" || "$_src" == "$(_fork_dir "$_n")" ]] || continue
    [[ "$_b" == "main" ]] && continue
    # A candidate from `docker ps -a` always exists, so running/stopped is the
    # only distinction: pass the inspect's State.Running and skip re-probing.
    _status_box_row "$_b" "$_n" "$_running"
  done < <(docker ps -a --filter "name=^cleat-" --format '{{.Names}}' 2>/dev/null || true)

  # ── VM memory budget: running containers' limits vs what the VM actually
  # has. Overcommit means the limits can't bind and a runaway process swap-
  # thrashes EVERY session at once (counts all containers: the VM is shared).
  # Trigger AND display in the SAME whole-GB unit (the configured slider via
  # _docker_vm_display_gb), mirroring the on-start overload path: comparing raw
  # bytes against the kernel's MemTotal while PRINTING the rounded slider let the
  # line fire and then print parity ("promised 24 GB of a 24 GB VM") or even an
  # inverted "promised 23 GB of a 24 GB VM" whenever the sum landed in the gap
  # between MemTotal and the slider. One unit for both makes that impossible.
  local _vm_bytes _limit_sum _sum_gb _vm_gb
  _vm_bytes="$(_docker_vm_memory)"
  if [[ "$_vm_bytes" =~ ^[0-9]+$ ]] && (( _vm_bytes > 0 )); then
    _limit_sum="$(_running_memory_limits_sum)"
    if [[ "$_limit_sum" =~ ^[0-9]+$ ]]; then
      _sum_gb=$(( _limit_sum / 1073741824 ))
      _vm_gb="$(_docker_vm_display_gb "$_vm_bytes")"
      if (( _sum_gb > _vm_gb )); then
        echo ""
        # Same engine-aware noun as the on-start overload warning: a native
        # Linux engine has no VM, the pool is the host's RAM. Detected only
        # inside this rare branch so a healthy status pays no extra round-trip.
        if _docker_pool_is_vm 2>/dev/null; then
          echo -e "  ${BOLD}VM memory:${RESET} ${AMBER}● overcommitted${RESET}${DIM}: running containers reserve ${_sum_gb} GB of ceilings on a ${_vm_gb} GB VM${RESET}"
        else
          echo -e "  ${BOLD}Host memory:${RESET} ${AMBER}● overcommitted${RESET}${DIM}: running containers reserve ${_sum_gb} GB of ceilings on a ${_vm_gb} GB host${RESET}"
        fi
      fi
    fi
  fi
  echo ""
}

# ── Prune: cleat-owned image bloat ──────────────────────────────────────────
# Two artifact classes accrete in daily use (see concept/22):
#   1. Dangling images labeled sh.cleat.version: every drift rebuild orphans
#      the previous build (1.5-2.5 GB each, several per day for a maintainer).
#   2. Superseded ghcr.io prebuilt version tags: `cleat update` pulls the new
#      tag but never removed old ones (~1 GB per release; amd64-era tags can
#      never be used natively again on Apple Silicon).
# Boxes (even exited ones) are NEVER touched: a stopped box is a resumable
# session holding /tmp state. Other projects' images and caches are never
# touched. This is the safe middle ground between `clean` and `nuke`.

# ── Shared docker human-size parser ──────────────────────────────────────────
# docker prints sizes as human strings ("36.34GB", "67.95MB", "512kB", "2.5TB",
# "0B"), and `docker system df` appends a " (NN%)" reclaimable suffix. ONE
# hardened converter backs every size/reclaimable number the CLI reports (cleat
# storage, the disk advisory, prune --cache reclaimed bytes, the image-bloat sum
# in _cleat_prunable_stats), so a parse bug can never make the advisory and the
# command that acts on it disagree.
#
# h2b(s) -> BYTES (a double; callers format once). Strips a trailing " (NN%)"
# suffix FIRST. Requires a digit immediately before the unit so a bare "kB"/"TB"
# parses to 0 (never a unit-only value). Units B/kB/KB/MB/GB/TB/PB as 1024-steps
# to match the CLI's existing GiB math. Two load-bearing portability guards:
# LC_ALL=C (BSD awk honors LC_NUMERIC, so a comma locale would truncate "36.34"
# to 36) and printf "%.0f" NOT "%d" (mawk's %d clamps at 2^31-1, so any size
# >= 2GB would silently collapse; %.0f is a double, exact past PB).
_SIZE_AWK='
function h2b(s,   u, n, m) {
  sub(/[ \t]*\([0-9]+%\)[ \t]*$/, "", s)
  if (match(s, /[0-9][0-9.]*(B|kB|KB|MB|GB|TB|PB)/) == 0) return 0
  s = substr(s, RSTART, RLENGTH)
  u = s; sub(/^[0-9.]+/, "", u)
  n = s + 0
  if      (u == "B")               m = 1
  else if (u == "kB" || u == "KB") m = 1024
  else if (u == "MB")              m = 1048576
  else if (u == "GB")              m = 1073741824
  else if (u == "TB")              m = 1099511627776
  else if (u == "PB")              m = 1125899906842624
  else                             m = 0
  return n * m
}'

# Convert ONE docker human-size token to integer bytes. Empty/garbage -> 0.
_human_size_to_bytes() {
  LC_ALL=C awk -v s="${1:-}" "$_SIZE_AWK"'BEGIN { printf "%.0f", h2b(s) }'
}

# Seams for cmd_prune/_cleat_prunable_stats (overridable in tests: the docker
# stub serves one canned `images` response for every query shape).
_dangling_cleat_images() {
  docker images -f dangling=true -f label=sh.cleat.version -q 2>/dev/null || true
}

# Prints "tag<TAB>size" per prebuilt image (size used by the stats helper).
_prebuilt_image_tags() {
  docker images "$REGISTRY_BASE" --format '{{.Repository}}:{{.Tag}}	{{.Size}}' 2>/dev/null || true
}

# Full image IDs (sha256:...) pinned by ANY container, running OR stopped, one
# per line. This is exactly the set `docker rmi` (no -f) refuses to remove: a
# box, even exited, holds its image by ID. A drift rebuild orphans the old build
# into a dangling image, but the stopped box built from it still pins it, and
# Cleat never touches boxes (concept/22), so those pinned images accumulate.
# Empty on a down daemon. Seam (overridable in tests). `docker ps -a -q` uses
# separate tokens so the docker stub's token-bounded ` -a ` detection routes it.
_container_image_ids() {
  local ids=() id
  while IFS= read -r id; do
    [[ -n "$id" ]] && ids+=("$id")
  done < <(docker ps -a -q 2>/dev/null || true)
  [[ ${#ids[@]} -eq 0 ]] && return 0
  docker inspect --format '{{.Image}}' "${ids[@]}" 2>/dev/null || true
}

# Resolve an image ref (dangling short ID or repo:tag) to its full image ID
# (sha256:...). Empty when the ref no longer exists. Seam.
_image_id_of() {
  docker image inspect "$1" --format '{{.Id}}' 2>/dev/null || true
}

# True when image ref $1 is pinned by a container in the newline set $2 of
# container image IDs: `docker rmi` would refuse it, so the prune OFFER must not
# count it (the action, cmd_prune, keeps it and reports it as "kept"). Resolves
# $1 to its full ID, tests whole-line (`-x`) membership with fixed strings
# (`-F`, so a sha256 with no regex metachars matches literally, and a short ID
# can't substring-match a longer one). False when $1 no longer resolves.
_image_referenced_by_container() {
  local iid; iid="$(_image_id_of "$1")"
  [[ -n "$iid" ]] || return 1
  printf '%s\n' "${2:-}" | grep -Fxq -- "$iid"
}

# Count and approximate size (MB) of prunable cleat artifacts: "count<TAB>mb".
# Sizes are docker's human strings (1.72GB / 971MB): close enough to decide
# whether a prune is worth offering. Images a container still references are
# EXCLUDED from both the count and the byte total, because cmd_prune (docker rmi,
# no -f) cannot remove them: counting them made the offer promise a prune that
# then removed nothing ("N stale images" -> "Nothing to prune. N kept"). The 5 GB
# gate now measures removable-only bloat too, so the offer never fires on bytes
# no prune can reclaim.
_cleat_prunable_stats() {
  local referenced; referenced="$(_container_image_ids)"
  {
    local id
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      _image_referenced_by_container "$id" "$referenced" && continue
      # Unsizeable still counts: the artifact exists even if inspect hiccups.
      docker image inspect "$id" --format '{{.Size}}B' 2>/dev/null || echo "0B"
    done < <(_dangling_cleat_images)

    local line tag
    while IFS= read -r line; do
      tag="${line%%	*}"
      [[ -n "$tag" ]] || continue
      [[ "$tag" == "${REGISTRY_BASE}:v${VERSION}" ]] && continue
      _image_referenced_by_container "$tag" "$referenced" && continue
      printf '%s\n' "${line#*	}"
    done < <(_prebuilt_image_tags)
  } | LC_ALL=C awk "$_SIZE_AWK"'
    { n++; b += h2b($0) }
    END { printf "%d\t%.0f", n, int(b / 1048576) }
  '
}

# Reclaim GLOBAL, regenerable Docker build cache (reclaimable-only, never -a).
# Build cache is content-addressed and shared across ALL Docker projects, so it
# cannot be scoped to cleat: the typed --cache flag plus this loud default-No
# confirm are the consent. --yes bypasses the prompt (still prints the
# disclosure). Non-interactive without --yes prints the disclosure and skips.
_prune_build_cache() {
  local assume_yes="${1:-0}"
  echo ""
  warn "${BOLD}cleat prune --cache${RESET} clears the ${BOLD}shared${RESET} Docker build cache used by ${BOLD}all${RESET} Docker projects."
  echo -e "    ${DIM}It is regenerable. Your next build re-creates what it needs.${RESET}"
  if (( ! assume_yes )); then
    if ! _is_interactive; then
      echo -e "    ${DIM}Re-run with ${RESET}${BOLD}--yes${RESET}${DIM} to clear it non-interactively.${RESET}"
      return 0
    fi
    local yn=""
    _ask_yn yn "Clear the shared build cache? [y/N] "
    [[ "$yn" == [yY]* ]] || { info "Left the build cache in place."; return 0; }
  fi
  local out reclaimed
  out="$(docker builder prune -f 2>/dev/null || true)"
  reclaimed="$(printf '%s\n' "$out" | grep -Eo '[0-9][0-9.]*[kKMGTP]?B' | tail -1 || true)"
  if [[ -n "$reclaimed" && "$reclaimed" != "0B" ]]; then
    success "Cleared build cache. Reclaimed ${BOLD}${reclaimed}${RESET}."
  else
    info "No reclaimable build cache."
  fi
}

cmd_prune() {
  local want_cache=0 assume_yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --cache|--build-cache) want_cache=1 ;;
      --yes|-y)              assume_yes=1 ;;
    esac
  done

  local removed=0 failed=0

  # Superseded prebuilt version tags (everything but the current version's).
  local line tag
  while IFS= read -r line; do
    tag="${line%%	*}"
    [[ -z "$tag" ]] && continue
    [[ "$tag" == "${REGISTRY_BASE}:v${VERSION}" ]] && continue
    if docker rmi "$tag" > /dev/null 2>&1; then
      removed=$((removed + 1))
    else
      failed=$((failed + 1))   # in use by a container; leave it
    fi
  done < <(_prebuilt_image_tags)

  # Dangling cleat builds (label-filtered: other projects' dangling images
  # are not ours to delete).
  local id
  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    if docker rmi "$id" > /dev/null 2>&1; then
      removed=$((removed + 1))
    else
      failed=$((failed + 1))
    fi
  done < <(_dangling_cleat_images)

  if (( removed > 0 )); then
    success "Pruned ${removed} stale cleat image$( (( removed != 1 )) && echo s )."
  else
    info "Nothing to prune."
  fi
  if (( failed > 0 )); then
    echo -e "    ${DIM}${failed} kept (still referenced by a container).${RESET}"
  fi

  if (( want_cache )); then
    _prune_build_cache "$assume_yes"
  fi
}

# ── On-start Docker pressure check ──────────────────────────────────────────
# TTY-only, throttled to once per day, entirely local, fail-soft (a down
# daemon yields empty reads and silence). Two independent signals:
#   1. BLOAT: prunable cleat artifacts above ~5 GB → offer `cleat prune`
#      ([Y/n]; the fix is safe and one keypress away: users should never be
#      told to run manual docker cleanup).
#   2. OVERLOAD: running containers' memory limits overcommit the Docker VM
#      → a one-line notice. No auto-fix: resizing the VM or stopping boxes is
#      the user's call. Counts ALL running containers, not just cleat's: the
#      VM is shared, and a neighboring compose stack squeezes cleat boxes
#      just the same.
_PRESSURE_BLOAT_MB_THRESHOLD=5120

# Two-tier disk-fill thresholds, keyed on the shared Docker storage's Use% as a
# box sees it via `df` (cap-relative: a 60 GB Docker Desktop VM and a 1.8 TB one
# trip at the same fullness, never at an absolute GB, because df inside a box
# reports the ONE shared disk). Each tier also requires a low absolute-free
# floor, so a 95%-full 1.8 TB disk that still has 90 GB free never fires: the
# free floor can only ever REMOVE a trigger, never add one. An 80% hard block
# would fire on healthy large disks (80% of 1.8 TB = 360 GB free) and cross the
# never-cripple line, so the gate sits at 95 and 85 is a read-only nudge.
# Tunable in one line each.
_DISK_ADVISORY_PCT=85      # >= this AND free < advisory floor: read-only advisory
_DISK_ADVISORY_FREE_GB=25
_DISK_GATE_PCT=95          # >= this AND free < gate floor: advisory PLUS a keypress hold
_DISK_GATE_FREE_GB=10
# Advisory is daily-throttled with its OWN stamp (the memory check already
# stamps PRESSURE_CHECK_FILE this run, so sharing it would suppress one of them).
# The hard gate is never throttled: it reads fresh every interactive start and
# holds whenever the critical predicate is true, like the undersized-VM advisory.
DISK_CHECK_FILE="$REPO_DIR/.disk_check"
DISK_CHECK_INTERVAL=86400

# Count zombie processes inside a running box by reading /proc directly (the
# image ships no `ps`). The comm field in /proc/N/stat may contain spaces, so
# strip through the closing paren before taking the state field. Empty output
# on any failure: callers treat that as "unknown", never as an error.
_box_zombie_count() {
  docker exec "$1" sh -c '
    z=0
    for f in /proc/[0-9]*/stat; do
      s=$(sed "s/^[^)]*) //" "$f" 2>/dev/null | cut -d" " -f1)
      [ "$s" = "Z" ] && z=$((z+1))
    done
    echo "$z"
  ' 2>/dev/null || true
}

# Sum of HostConfig.Memory over all RUNNING containers, in bytes.
_running_memory_limits_sum() {
  local ids=() id sum=0 mem
  while IFS= read -r id; do
    [[ -n "$id" ]] && ids+=("$id")
  done < <(docker ps -q 2>/dev/null || true)
  if [[ ${#ids[@]} -eq 0 ]]; then
    echo 0
    return
  fi
  while IFS= read -r mem; do
    [[ "$mem" =~ ^[0-9]+$ ]] || continue
    sum=$(( sum + mem ))
  done < <(docker inspect --format '{{.HostConfig.Memory}}' "${ids[@]}" 2>/dev/null || true)
  echo "$sum"
}

# Names of RUNNING cleat boxes, one per line (the sh.cleat.version label is on
# every box this CLI creates; non-cleat containers never carry it). Seam for the
# overload message's session count and the idle sweep. Empty on a down daemon.
_running_cleat_boxes() {
  docker ps --filter "label=sh.cleat.version" --format '{{.Names}}' 2>/dev/null || true
}

# Count of running cleat boxes (0 on any failure).
_running_cleat_box_count() {
  local n=0 name
  while IFS= read -r name; do
    [[ -n "$name" ]] && n=$(( n + 1 ))
  done < <(_running_cleat_boxes)
  echo "$n"
}

# Recommended Docker VM size in whole GB: the comfortable-default target
# (_PRESSURE_TARGET_VM_GB, 16 GiB, room for several sessions to each spike near
# their quarter-of-VM ceiling at once, NOT a session cap), but never more than half the
# host's RAM (leave the rest for macOS + apps). Host RAM unknown → just the
# target. Always ≥ 1. Arg: $1 = host RAM bytes (may be empty).
_recommended_vm_gb() {
  local host_bytes="${1:-}" rec="$_PRESSURE_TARGET_VM_GB" half
  if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
    half=$(( host_bytes / 2 / 1073741824 ))
    (( half < rec )) && rec=$half
  fi
  (( rec < 1 )) && rec=1
  echo "$rec"
}

# Print the two concrete Docker-Desktop steps that fix the VM (the one knob the
# `docker` CLI cannot touch). The CALLER prints the lead-in line and guarantees
# this is Docker Desktop AND that growing the VM actually helps (recommended >
# current): on a host already near its safe max we steer to "fewer sessions"
# instead, so this never names a target SMALLER than the VM they already have.
#
# Colour discipline (kept consistent so the block reads as ONE thing, not a
# random mix): every line is a DIM bullet so none starts on a bold word (which
# read as a section break); BOLD marks only what you click or set (the menu
# paths, the memory/swap values, VirtioFS); DIM carries the connective prose.
# No amber in the body, that belongs to the `!` marker alone. No engine
# re-detection here (the caller detects once) and no trailing blank (the
# pressure block owns that, so the gap survives when this block is skipped).
# Args: $1 = host RAM bytes (may be empty), $2 = recommended GB.
_print_docker_vm_fix() {
  local host_bytes="${1:-}" rec_gb="${2:-$_PRESSURE_TARGET_VM_GB}" max_note=""
  if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
    max_note="${DIM}   (max ≈ $(( host_bytes * 3 / 4 / 1073741824 )) GB)${RESET}"
  fi
  # Docker Desktop's WSL2 backend takes memory/swap from .wslconfig, not the
  # Resources slider (which that backend removes). Name the real knob there.
  if _is_wsl; then
    echo -e "    ${DIM}•${RESET} ${DIM}In ${RESET}${BOLD}.wslconfig${RESET}${DIM} (your Windows user folder) under ${RESET}${BOLD}[wsl2]${RESET}${DIM} set ${RESET}${BOLD}memory=${rec_gb}GB${RESET}${DIM} and ${RESET}${BOLD}swap=2GB${RESET}${DIM}, then run ${RESET}${BOLD}wsl --shutdown${RESET}${max_note}"
    return 0
  fi
  echo -e "    ${DIM}•${RESET} ${BOLD}Settings → Resources → Advanced${RESET}${DIM}: set ${RESET}${BOLD}Memory limit ${rec_gb} GB${RESET}${DIM} and ${RESET}${BOLD}Swap ≥ 2 GB${RESET}${DIM}, then Apply & restart${RESET}${max_note}"
  echo -e "    ${DIM}•${RESET} ${DIM}Faster I/O: ${RESET}${BOLD}Settings → General → Virtual Machine Options${RESET}${DIM} → ${RESET}${BOLD}VirtioFS${RESET}"
}

# ── Idle-session sweep ───────────────────────────────────────────────────────
# True when a real agent is running inside the box: claude (a node process) or a
# bare node shows in the container's process list. A DETACHED box (terminal
# closed, the foreground exec gone) runs only docker-init/su/bash, so this is
# false. A box working UNATTENDED keeps its host `docker exec` (and thus the
# claude/node process) alive, so this is TRUE and the sweep leaves it strictly
# alone (the "leave it running, walk away" promise). `docker top` reads the
# process list from the daemon (the image ships no `ps`), so no exec is needed.
# Fails SAFE: any error, or output we can't read, is treated as "live" → skip.
_box_has_live_agent() {
  local top
  top="$(docker top "$1" 2>/dev/null)" || return 0     # unreadable → assume live (safe)
  [[ -n "$top" ]] || return 0                          # empty → assume live (safe)
  printf '%s\n' "$top" | grep -qiE 'claude|node'
}

# Stop cleat boxes that are PROVABLY safe to stop: detached (no live agent) AND
# idle past the grace window. Never stops $1 (the box being launched now) or any
# box with a live agent. A stopped box is preserved on disk; running `cleat` in
# its project brings it right back, so the notice does not nag about resuming.
# Prints ONE summary line when it stops anything. Args: $1 = self cname to skip,
# $2 = grace seconds. Fail-soft; TTY-gating is the caller's job.
_sweep_idle_boxes() {
  local self="${1:-}" grace_secs="${2:-$_IDLE_SWEEP_GRACE_SECS}"
  local now name age mem victims=() freed=0
  now="$(date +%s)"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    [[ "$name" == "$self" ]] && continue
    # Grace gate FIRST (cheap, local, and decisive for cost): the run dir's mtime
    # is re-stamped on attach AND detach (exec_claude / _cleanup_session), so
    # `now - mtime` is the time since this box last had a host session. Skip boxes
    # inside the grace window, and skip an unknown age (0/unreadable) rather than
    # stop on an unknown clock. Running this before the `docker top` round-trip
    # avoids one daemon call per within-grace box AND shrinks the window where a
    # box another terminal just re-attached to (mtime freshly stamped) could be
    # caught during its bring-up, before claude shows up in the process list.
    age="$(_path_mtime "$CLEAT_RUN_DIR/$name")"
    [[ "$age" =~ ^[0-9]+$ ]] && (( age > 0 )) || continue
    (( now - age < grace_secs )) && continue
    # Liveness gate: a claude/node process means the box is attached or working
    # unattended → never touch it. Fail-safe (an unreadable `docker top` = live).
    _box_has_live_agent "$name" && continue
    mem="$(docker inspect --format '{{.HostConfig.Memory}}' "$name" 2>/dev/null)" || mem=0
    [[ "$mem" =~ ^[0-9]+$ ]] && (( mem > 0 )) && freed=$(( freed + mem ))
    victims+=("$name")
  done < <(_running_cleat_boxes)

  [[ ${#victims[@]} -gt 0 ]] || return 0
  docker stop "${victims[@]}" >/dev/null 2>&1 || true
  local n=${#victims[@]} gb=$(( (freed + 536870912) / 1073741824 )) freed_note=""
  (( gb > 0 )) && freed_note=", freed ${gb} GB"
  echo ""
  info "Stopped ${n} idle session$( (( n != 1 )) && printf s )${freed_note}. ${DIM}A detached box keeps its memory ceiling until stopped.${RESET}"
}

# On-start wrapper: TTY-only (never on a pipe or in cron), opt-out via
# CLEAT_NO_IDLE_SWEEP=1, grace override via CLEAT_IDLE_GRACE_MINS. Resolves the
# box being launched from the same [box] positional the dispatch passes, so the
# sweep never stops the session you are starting. Entirely fail-soft.
_maybe_sweep_idle_boxes() {
  _is_tty || return 0
  [[ "${CLEAT_NO_IDLE_SWEEP:-}" == "1" ]] && return 0
  command -v docker >/dev/null 2>&1 || return 0
  # Don't sweep for a malformed invocation that _set_box is about to reject (an
  # extra positional, or an invalid box name): a command that won't run must not
  # stop any box. Let validation error first.
  [[ $# -gt 1 ]] && return 0
  [[ -n "${1:-}" ]] && ! _validate_box_name "$1" 2>/dev/null && return 0
  local grace_secs="$_IDLE_SWEEP_GRACE_SECS"
  [[ "${CLEAT_IDLE_GRACE_MINS:-}" =~ ^[0-9]+$ ]] && grace_secs=$(( CLEAT_IDLE_GRACE_MINS * 60 ))
  local self_project self_box="main" self_cname=""
  self_project="$(resolve_project 2>/dev/null || printf '%s' "$PWD")"
  [[ -n "${1:-}" ]] && self_box="$1"   # already validated above
  self_cname="$(container_name_for "$self_project" "$self_box" 2>/dev/null || true)"
  _sweep_idle_boxes "$self_cname" "$grace_secs"
}

_maybe_check_docker_pressure() {
  _is_tty || return 0

  # Two cadences. The bloat→prune prompt and the OVERLOAD notice are PERIODIC
  # (throttled to once per interval): the first is an interactive prompt, the
  # second a transient runtime condition (a promise > VM compares ceilings, not
  # usage, and is often harmless), so neither should fire on every start. The
  # UNDERSIZED-VM advisory is different: an invalid Docker config (the VM memory
  # slider set too low) must surface on EVERY start until it is fixed, the same
  # way the positive "Docker tuned" line shows on every good start. So the daily
  # stamp gates only the periodic halves; the undersized advisory ignores it.
  local now last=0 bloat_due=true
  now="$(date +%s)"
  if [[ -f "$PRESSURE_CHECK_FILE" ]]; then
    last="$(head -1 "$PRESSURE_CHECK_FILE" 2>/dev/null || echo 0)"
    [[ "$last" =~ ^[0-9]+$ ]] || last=0
  fi
  (( now - last < PRESSURE_CHECK_INTERVAL )) && bloat_due=false

  # Whitespace model: every notice owns ONE blank line ABOVE it. For the first
  # notice that blank separates the section from the update/restart lines above;
  # for a later notice it separates it from the previous one (the prune prompt and
  # the VM advisory can both fire on the daily check, and ran flush together before
  # v0.16.4). The prune notice prints its leading blank only when nothing came
  # before it (`$printed || echo ""`); the VM advisories print theirs always (so
  # the prune→advisory gap is never lost). `printed` also gates a single TRAILING
  # blank after the last notice (owned HERE, not inside the Docker-Desktop fix
  # block, so the gap survives when that block is skipped), which flags
  # _ONSTART_GAP_OPEN so the highlight doesn't add a second.
  local printed=false

  # 1. Bloat → prune prompt (periodic; only on the daily check).
  if $bloat_due; then
    echo "$now" > "$PRESSURE_CHECK_FILE" 2>/dev/null || true
    local stats count mb
    stats="$(_cleat_prunable_stats)"
    count="${stats%%	*}"
    mb="${stats##*	}"
    if [[ "$count" =~ ^[0-9]+$ && "$mb" =~ ^[0-9]+$ ]] && (( mb >= _PRESSURE_BLOAT_MB_THRESHOLD )); then
      $printed || echo ""
      info "Docker is carrying ${BOLD}${count} stale cleat images${RESET} ${DIM}(~$(( (mb + 512) / 1024 )) GB of old builds and superseded pulls)${RESET}"
      printed=true
      local yn=""
      _ask_yn yn "Prune them now? ${DIM}(boxes and other projects are not touched)${RESET} [Y/n] "
      if [[ -z "$yn" || "$yn" == [yY]* ]]; then
        cmd_prune
      fi
    fi
  fi

  # 2. VM memory vs the host + the running sessions. A box and a worktree are
  #    the same thing here: one session, one quarter-of-VM ceiling. Both point at the one
  #    knob the `docker` CLI can't change: the Docker Desktop memory slider.
  local vm_bytes sum host_bytes vm_gb rec_gb is_dd=false pool_vm=false host_note=""
  vm_bytes="$(_docker_vm_memory)"
  if [[ "$vm_bytes" =~ ^[0-9]+$ ]] && (( vm_bytes > 0 )); then
    vm_gb="$(_docker_vm_display_gb "$vm_bytes")"   # prefer the configured slider; fall back to rounding MemTotal
    sum="$(_running_memory_limits_sum)"
    host_bytes="$(_host_total_memory)"
    rec_gb="$(_recommended_vm_gb "$host_bytes")"
    # Detect the engine ONCE: every `docker info` is a round-trip to a daemon
    # that's slow precisely when this fires (under swap), so we never call it
    # again per-branch. pool_vm (what noun the warnings use) derives from the
    # is_dd already in hand instead of _docker_pool_is_vm for the same reason.
    _is_docker_desktop 2>/dev/null && is_dd=true
    if _is_macos || $is_dd; then pool_vm=true; fi
    [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )) \
      && host_note=" of your ${BOLD}$(( host_bytes / 1073741824 )) GB${RESET}"

    # Compare in the SAME whole-GB unit the message prints (vm_gb, the configured
    # slider via _docker_vm_display_gb), not raw MemTotal bytes: a slider that
    # rounds UP relative to MemTotal would otherwise let the trigger fire while the
    # printed "promised X of Y" reads as parity (X == Y) or even inverted, the
    # "shows X but warns it's too small" contradiction _vm_gb_rounded forbids.
    local overloaded=false sum_gb=0
    [[ "$sum" =~ ^[0-9]+$ ]] && sum_gb=$(( sum / 1073741824 ))
    [[ "$sum" =~ ^[0-9]+$ ]] && (( sum_gb > vm_gb )) && overloaded=true

    # 2a. OVERLOAD (periodic): the sessions running RIGHT NOW are promised more
    #     memory than the VM has. Real on any engine, so the warn always fires and
    #     names the real RAM. The follow-up is honest about the host: where the VM
    #     can safely grow (recommended > current) we point at the Docker Desktop
    #     memory slider; where it can't (the VM is already near ~¾ of host RAM,
    #     e.g. a 7 GB VM on an 8 GB Mac) growing it is impossible/harmful, so we
    #     steer to running fewer sessions or lowering a box's own ceiling instead.
    #     Never suggests a VM target below the current. Shown on the daily check
    #     only (it's transient, not a config error worth nagging every start).
    if $overloaded && $bloat_due; then
      echo ""
      # Name the COUNT of running cleat sessions, not just a GB number: "promised
      # 25 GB" next to a 24 GB slider reads like an off-by-one rounding bug, when
      # it's really N boxes each reserving a quarter-of-VM ceiling. The GB clause
      # has a SEPARATE subject ("running containers"), because the sum spans ALL
      # running containers (the VM is shared) while the count is cleat-only: a
      # non-cleat stack must not be mislabeled as cleat sessions. "reserve
      # ceilings" (not "promised") also stops the number reading as a hard
      # reservation or live usage (idle boxes touch a fraction of their ceiling).
      # _s is computed with a standalone `(( )) && _s=s` (set -e safe: a failing
      # non-final command of a top-level &&-list is exempt), NOT inside the
      # assignment, where the substitution's exit 1 on the singular case would
      # abort `cleat start` under `set -euo pipefail`.
      local _n_boxes _who _s=""
      _n_boxes="$(_running_cleat_box_count)"
      if [[ "$_n_boxes" =~ ^[0-9]+$ ]] && (( _n_boxes > 0 )); then
        (( _n_boxes != 1 )) && _s="s"
        _who="${_n_boxes} session${_s} still running"
      else
        _who="Sessions are still running"
      fi
      # Name the pool truthfully: a native Linux engine has no VM, the ceilings
      # overcommit the host's own RAM (host_note would read "N GB of your N GB"
      # there, pure noise, so it stays VM-only).
      if $pool_vm; then
        warn "${_who}; running containers reserve ${sum_gb} GB of memory ceilings but the Docker VM holds only ${vm_gb} GB${host_note}. Under load they swap together and freeze."
      else
        warn "${_who}; running containers reserve ${sum_gb} GB of memory ceilings but the host has only ${vm_gb} GB of RAM. Under load they swap together and freeze."
      fi
      if $is_dd && (( rec_gb > vm_gb )); then
        echo -e "    ${DIM}Closing a terminal does not stop its box. Stop one you are done with, or give Docker more memory (Docker Desktop only):${RESET}"
        _print_docker_vm_fix "$host_bytes" "$rec_gb"
      else
        echo -e "    ${DIM}Closing a terminal does not stop its box. Stop ones you are done with (${RESET}${BOLD}cleat stop${RESET}${DIM}), or lower a box's ceiling with ${RESET}${BOLD}[resources] memory${RESET}${DIM} in .cleat.${RESET}"
      fi
      printed=true
      _VM_ADVISORY_SHOWN=1

    # 2b. UNDERSIZED VM for parallel work: Docker-Desktop-only (a native-Linux
    #     engine's "VM" is the host: nothing to resize). The recommendation is
    #     host-aware (the comfortable-default target, capped at half the host RAM).
    #     This is the invalid CONFIG, so it shows on EVERY start while the VM is
    #     below the target, until it's set right (not throttled: a once-a-day nudge
    #     is too easy to miss, and a smooth run depends on the VM being sized well).
    #     Host RAM unknown → conservative 8 GiB floor so we never over-recommend.
    elif $is_dd; then
      local bad=false
      # Compare in WHOLE rounded GB (vm_gb), never raw bytes: the kernel's
      # MemTotal undershoots the slider, so a byte compare against an exact GiB
      # target false-positives a correctly-sized VM (a 16 GB slider reads ~15.6
      # GiB < 16 GiB). vm_gb already rounds that back to 16. The announce-ready
      # all-clear mirrors this test exactly; keep the two in lockstep.
      if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
        (( vm_gb < rec_gb )) && bad=true
      else
        (( vm_gb < _PRESSURE_VM_ADVISORY_BYTES / 1073741824 )) && bad=true
      fi
      if $bad; then
        echo ""
        warn "Docker VM memory is ${BOLD}${vm_gb} GB${RESET}${host_note}. Tight for parallel sessions."
        echo -e "    ${DIM}Each box reserves a memory ceiling (a quarter of the VM). Give Docker more memory (Docker Desktop only):${RESET}"
        _print_docker_vm_fix "$host_bytes" "$rec_gb"
        printed=true
        _VM_ADVISORY_SHOWN=1
        # A real config error (the slider set too low), not a transient state:
        # arm the gate so the interactive launch stops on it (concept/21).
        _DOCKER_GATE_PENDING=1
        _DOCKER_GATE_SUMMARY="Docker VM memory is ${vm_gb} GB (aim for ${rec_gb} GB)."
      fi
    fi
  fi

  # One blank line separates whatever we printed from the release highlight (or
  # the bring-up) that follows. Flag the open gap so the highlight doesn't add a
  # second blank of its own.
  if $printed; then
    echo ""
    _ONSTART_GAP_OPEN=1
  fi
}

# The every-start, positive counterpart to the pressure advisory: when the Docker
# VM is sized right for parallel work, say so in ONE green line that sits directly
# above the bring-up. Runs on every session-launching start (NOT daily-gated like
# the warning: the reassurance is wanted each time), and is the exact inverse of
# the 2b "undersized" test, so the two are complementary, never both, never
# contradictory: a correctly sized VM shows this, an undersized one shows the
# warning. Costs one `docker info` for MemTotal plus, on Linux only, a second
# single-field read for the engine noun (_docker_pool_is_vm; macOS
# short-circuits); the host read is local.
#
# One twist on top of the inverse: even with memory sized right, swap may be left
# at the Docker Desktop default. So when memory passes but swap reads below the
# target, this prints a focused swap advisory in place of the all-clear (memory is
# good, swap needs a nudge). Swap that can't be read falls through to the all-clear.
#
# Whitespace: one blank ABOVE unless an earlier notice already opened the gap, and
# NEVER a trailing blank, so "Image ready" flows straight on from this line and
# the two read as one contiguous block (the placement the maintainer asked for).
# Silent off a TTY, when the VM size can't be read, or when the VM is undersized
# (don't claim "tuned" when it isn't, and don't fight the warning).
_maybe_announce_docker_ready() {
  _is_tty || return 0
  # Defer to the warning: if the pressure check already flagged the VM (overload or
  # undersized) this run, stay silent so a "tuned" nod and a warning never both
  # appear (the overload case can fire even on an adequately sized VM).
  [[ "${_VM_ADVISORY_SHOWN:-0}" == "1" ]] && return 0
  local vm_bytes vm_gb host_bytes rec_gb
  vm_bytes="$(_docker_vm_memory)"
  [[ "$vm_bytes" =~ ^[0-9]+$ ]] && (( vm_bytes > 0 )) || return 0
  vm_gb="$(_docker_vm_display_gb "$vm_bytes")"   # prefer the configured slider (see _docker_vm_display_gb)
  host_bytes="$(_host_total_memory)"
  rec_gb="$(_recommended_vm_gb "$host_bytes")"
  # Adequately sized? Mirror the 2b "bad" test EXACTLY: compare WHOLE rounded GB
  # (host-aware target when host RAM is known, else the conservative 8 GiB floor)
  # so this and the warning are perfect complements. A byte compare here would
  # disagree with the rounded vm_gb the warning shows (a 16 GB slider reading
  # ~15.6 GiB would stay silent here AND trip the warning there). Anything below
  # the target is "undersized" and stays silent.
  if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
    (( vm_gb < rec_gb )) && return 0
  else
    (( vm_gb < _PRESSURE_VM_ADVISORY_BYTES / 1073741824 )) && return 0
  fi

  # Memory is sized right. One more check before the all-clear: swap. The memory
  # slider and the swap slider are separate, so a user who bumps memory (often on
  # our own advice) can leave swap at the Docker Desktop default, too little
  # overflow for a brief spike, so a session freezes instead of paging out. When
  # swap reads below the target, say what's right (memory) AND what still needs a
  # nudge (swap) rather than a blanket "tuned". `docker info` can't report swap,
  # so this reads Docker Desktop's settings file; a value we can't trust returns
  # empty and falls through to the all-clear (never warn on a guess). Same
  # whitespace as the tuned line: one blank above unless a gap is open, none below.
  local swap_bytes
  swap_bytes="$(_docker_vm_swap_bytes)"
  if [[ "$swap_bytes" =~ ^[0-9]+$ ]] && (( swap_bytes < _SWAP_ADVISORY_BYTES )); then
    [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
    # Describe the shortfall honestly. NOT _human_bytes here: it rounds (%.0f), so
    # 1.5 GB would read "2 GB" and contradict the "set Swap ≥ 2 GB" step below, and
    # 0 would render "?". Floored GB never rounds a sub-2 GB value up; sub-GB shows
    # MB; 0 reads as "disabled".
    if (( swap_bytes == 0 )); then
      warn "Docker memory is sized right, but swap is ${BOLD}disabled${RESET}. A memory spike can freeze a session instead of paging out."
      _DOCKER_GATE_SUMMARY="Docker swap is disabled (aim for ≥ 2 GB)."
    else
      local swap_human
      if (( swap_bytes < 1073741824 )); then
        swap_human="$(( swap_bytes / 1048576 )) MB"
      else
        swap_human="$(( swap_bytes / 1073741824 )) GB"
      fi
      warn "Docker memory is sized right, but its swap is only ${BOLD}${swap_human}${RESET}. A memory spike can freeze a session instead of paging out."
      _DOCKER_GATE_SUMMARY="Docker swap is only ${swap_human} (aim for ≥ 2 GB)."
    fi
    echo -e "    ${DIM}Add overflow headroom (Docker Desktop only):${RESET}"
    echo -e "    ${DIM}•${RESET} ${BOLD}Settings → Resources → Advanced${RESET}${DIM}: set ${RESET}${BOLD}Swap ≥ 2 GB${RESET}${DIM}, then Apply & restart${RESET}"
    _VM_ADVISORY_SHOWN=1   # defensive symmetry with the pressure check; no on-start step reads it after this today
    # Swap left at the default is a real config error too (freezes under a spike),
    # so arm the gate to hold the launch on it (concept/21).
    _DOCKER_GATE_PENDING=1
    # We printed content and left NO trailing blank, so the gap above the gate is
    # closed: clear the flag so the gate opens its own single blank (else it would
    # sit flush against this fix line). The undersized path leaves the flag set (a
    # trailing blank is genuinely open above the gate), so the gate skips its blank.
    _ONSTART_GAP_OPEN=0
    return 0
  fi

  [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
  # No session count: "many" is honest (light sessions run dozens), a number reads
  # as a hard cap and isn't true. A box can OOM only if it does genuinely heavy
  # memory work, the same way Claude Code can outside Docker, and that is rare.
  #
  # Name the pool truthfully. VM-backed engines (Docker Desktop anywhere, every
  # macOS backend) keep "tuned" and "VM": a slider exists and it is sized right.
  # A native Linux engine has no VM and no knob was tuned, so it reads "ready"
  # and "RAM". And a small native host (below the 8 GiB advisory floor, which
  # the undersized warning never covers because there is nothing to resize)
  # earns no parallel-headroom claim: four 1 GB ceilings is not "room for
  # many", so the line states the size and stops.
  local pool_vm=false
  _docker_pool_is_vm 2>/dev/null && pool_vm=true
  if $pool_vm; then
    success "Docker tuned for Cleat ${RESET}${DIM}(${vm_gb} GB VM, room for many parallel sessions)${RESET}"
  elif (( vm_gb >= _PRESSURE_VM_ADVISORY_BYTES / 1073741824 )); then
    success "Docker ready for Cleat ${RESET}${DIM}(${vm_gb} GB RAM, room for many parallel sessions)${RESET}"
  else
    success "Docker ready for Cleat ${RESET}${DIM}(${vm_gb} GB RAM available to boxes)${RESET}"
  fi
}

# The one place Cleat deliberately BLOCKS the launch. concept/21's startup rule is
# "never block, never nag", and every other on-start notice honors it. This is the
# single documented exception: when Docker itself is misconfigured (the VM memory
# slider set too low, or swap left at the tiny default), the non-blocking advisory
# that already printed above proved missable in the field. A user ran degraded for
# a long time because the amber warning "just blinked" past on start, then reported
# Cleat as slow. So for a genuine CONFIG error (never the transient overload notice,
# which a `cleat stop` resolves) we hold the launch for one keypress, so the warning
# cannot scroll by unread.
#
# Guardrails that keep this from breaking the "walk away" pillar:
#   - Interactive-only: BOTH stdin and stdout must be a terminal (_is_interactive),
#     so unattended runs (cron, pipes, `</dev/null`, CI) never reach the read.
#   - Escape hatch: CLEAT_NO_DOCKER_GATE=1 keeps the printed advisory but skips the
#     hold, for someone who runs cleat interactively yet has accepted their setup.
#     This knob earns its keep precisely because the behavior it gates is blocking
#     (the env-var philosophy in concept/21 reserves opt-outs for network calls and
#     for blocking prompts, not for cosmetic notices).
#   - Fail-open: a `read` that hits EOF falls through (|| true) instead of hanging,
#     and the function always returns 0 (it runs bare in main's dispatch under the
#     binary's `set -euo pipefail`).
#
# Fires only when an advisory ABOVE armed _DOCKER_GATE_PENDING (undersized VM
# memory in _maybe_check_docker_pressure, or low/disabled swap in
# _maybe_announce_docker_ready). A well-tuned Docker never arms it, so this stays
# silent on every healthy start.
_maybe_gate_on_docker_config() {
  [[ "${_DOCKER_GATE_PENDING:-0}" == "1" ]] || return 0
  # WSL2 memory is elastic (the VM reclaims RAM back to Windows), so a hard hold
  # on an "undersized" WSL VM is more likely a false alarm than a real block. The
  # advisory above already printed (now .wslconfig-correct); skip only the hold.
  _is_wsl && return 0
  _is_interactive || return 0
  [[ "${CLEAT_NO_DOCKER_GATE:-}" == "1" ]] && return 0

  # A prominent, full-width amber banner: the whole point is that this cannot be
  # mistaken for a passing line or scroll by unnoticed. ASCII rule off a UTF-8
  # locale so the box never renders as mojibake.
  local rule
  if _has_unicode; then
    rule="────────────────────────────────────────────────"
  else
    rule="================================================"
  fi
  # One blank above the banner, never two. Same convention as the highlight and
  # the "tuned"/swap line: if the printer above us already left its trailing blank
  # (_ONSTART_GAP_OPEN=1, e.g. the undersized advisory + highlight both do), don't
  # add a second. The swap-advisory path closes the gap (it prints content with no
  # trailing blank and resets the flag), so there we open it ourselves.
  [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo -e "  ${AMBER}${BOLD}  Docker is not tuned for Cleat${RESET}"
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo ""
  if [[ -n "${_DOCKER_GATE_SUMMARY:-}" ]]; then
    echo -e "  ${AMBER}!${RESET} ${BOLD}${_DOCKER_GATE_SUMMARY}${RESET} ${DIM}Sessions will run slow or freeze under load.${RESET}"
  fi
  echo -e "    ${DIM}Fix Docker with the steps above, then re-run ${RESET}${BOLD}cleat${RESET}${DIM}.${RESET}"
  echo -e "    ${DIM}To skip this stop from now on: ${RESET}${BOLD}CLEAT_NO_DOCKER_GATE=1${RESET}${DIM}.${RESET}"
  echo ""
  echo -en "  ${BLUE}▸${RESET} Press ${BOLD}Enter${RESET} to launch anyway, or ${BOLD}Ctrl-C${RESET} to stop and fix Docker first "
  local _ack=""
  read -r _ack || true
  echo ""
  return 0
}

# ── Disk-fill advisory + gate (cross-OS) ─────────────────────────────────────
# The MECHANISM is engine-agnostic: `df` runs inside the box (always Linux) and
# reads the shared docker storage. Only the guidance COPY branches per backend.

# True when the active docker endpoint is REMOTE (ssh:// or tcp:// to a non-local
# host), where we cannot advise on a local host disk. Local iff empty, a unix
# socket, or a Windows named pipe. Seam.
_docker_endpoint_is_remote() {
  local ep; ep="$(_docker_context_endpoint)"
  case "$ep" in
    ""|unix://*|npipe://*) return 1 ;;
    *) return 0 ;;
  esac
}

# The daemon's data-root (native /var/lib/docker, rootless ~/.local/share/docker,
# etc.), resolved live so the copy names the real path. Falls back to the common
# default. Seam.
_docker_root_dir() {
  local d
  d="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
  [[ -n "$d" ]] && printf '%s' "$d" || printf '/var/lib/docker'
}

# Read the shared Docker storage fill from inside a RUNNING box: prints
# "<use_pct> <avail_kb>" or nothing on any failure. `df -kP /` reports the
# container overlay's backing store, which IS the shared docker storage on every
# engine (the VM disk on VM engines, the host data-root on native Linux).
# `/workspace` would report the HOST disk (a different number) so we use `/`.
# `-kP` forces 1024-byte POSIX blocks and one data row. Fail-soft: a stopped or
# unreadable box, or a down daemon, yields empty output. Seam (test override).
_read_container_disk_use() {
  local cname="$1"
  [[ -n "$cname" ]] || return 0
  docker exec "$cname" df -kP / 2>/dev/null \
    | awk '$NF=="/" { p=$5; gsub(/%/,"",p); print p" "$4 }' || true
}

# The disk-help LEVER branch for the current backend (daemon is UP when this
# runs): desktop | orbstack | colima | wsl | linux-host | generic.
# _is_docker_desktop (a docker info read) wins first so an OrbStack daemon on a
# Mac that also has Docker Desktop installed never inherits the Desktop slider.
# WSL in-distro is its OWN kind (its vhdx grows and does not auto-shrink, unlike
# native Linux where deletes free space immediately). A remote endpoint has no
# local host to advise on -> generic. Seam.
_disk_help_kind() {
  # WSL first: an in-distro or Docker-Desktop-WSL2 store is a vhdx compacted via
  # `wsl`, never a Desktop disk slider, so a WSL2 + Docker Desktop host must NOT
  # inherit the desktop lever (it would name a slider that backend has removed).
  _is_wsl && { echo wsl; return 0; }
  _is_docker_desktop 2>/dev/null && { echo desktop; return 0; }
  if _is_macos; then
    case "$(_autostart_pick 2>/dev/null)" in
      orbstack)        echo orbstack ;;
      colima|colima:*) echo colima ;;
      *)               echo generic ;;
    esac
    return 0
  fi
  _docker_endpoint_is_remote && { echo generic; return 0; }
  echo linux-host
}

# The banner subject phrase for a kind ("<phrase> is 96% full"). Neutral about
# auto-shrink (that differs per engine and lives in the lever).
_disk_subject() {
  case "$1" in
    wsl)        printf 'The WSL distro disk' ;;
    linux-host) printf 'The host disk' ;;
    generic)    printf "Docker's disk" ;;
    *)          printf 'The Docker VM disk' ;;
  esac
}

# One concise, engine-correct lever line (DIM/BOLD formatted), reused by the
# advisory, the gate banner, the ENOSPC backstop and `cleat storage`. Every
# branch stays honest about how THIS backend returns host space. $2 is the left
# indent, defaulting to the 4 spaces the notice blocks use. `cleat storage`
# passes 2 so the lever lines up with the prose line above it in that block.
_disk_lever_short() {
  local i="${2:-    }"
  case "$1" in
    desktop)
      echo -e "${i}${DIM}Docker Desktop: reclaim with ${RESET}${BOLD}cleat prune --cache${RESET}${DIM}, or raise the disk-size slider in ${RESET}${BOLD}Settings → Resources → Advanced${RESET}${DIM}.${RESET}" ;;
    orbstack)
      echo -e "${i}${DIM}OrbStack has no size slider. Free the Mac or run ${RESET}${BOLD}cleat prune --cache${RESET}${DIM}. OrbStack usually returns the space. A restart reclaims it if not.${RESET}" ;;
    colima)
      echo -e "${i}${DIM}Colima: grow the VM disk with ${RESET}${BOLD}colima start --disk <N>${RESET}${DIM} then restart (add ${RESET}${BOLD}-p <profile>${RESET}${DIM} for a named profile), or reclaim with ${RESET}${BOLD}colima ssh -- sudo fstrim -a${RESET}${DIM}.${RESET}" ;;
    wsl)
      echo -e "${i}${DIM}WSL: free space, then shrink the distro disk with ${RESET}${BOLD}wsl --manage ${WSL_DISTRO_NAME:-<distro>} --set-sparse true${RESET}${DIM} (reclaims on a later WSL shutdown).${RESET}" ;;
    linux-host)
      echo -e "${i}${DIM}Linux: ${RESET}${BOLD}cleat prune --cache${RESET}${DIM} frees the host disk immediately, or grow the partition holding ${RESET}${BOLD}$(_docker_root_dir)${RESET}${DIM}.${RESET}" ;;
    *)
      echo -e "${i}${DIM}Free space with ${RESET}${BOLD}cleat prune --cache${RESET}${DIM}. Inspect with ${RESET}${BOLD}docker system df${RESET}${DIM}.${RESET}" ;;
  esac
}

# ENOSPC backstop: when a docker bring-up error is an out-of-space error, name
# the full store and print the engine-correct lever. The disk gate cannot read
# fill when the box will not start, so this covers the "too full to bring up"
# case. Callable and testable in isolation. Fail-soft: no file or no match is
# silent, always returns 0. Arg: $1 = the captured docker stderr file.
_maybe_explain_enospc() {
  local errfile="$1"
  [[ -s "$errfile" ]] || return 0
  grep -qiE 'no space left|ENOSPC' "$errfile" 2>/dev/null || return 0
  local dk; dk="$(_disk_help_kind)"
  echo ""
  warn "$(_disk_subject "$dk") is full, so the box could not start."
  _disk_lever_short "$dk"
}

# Post-bring-up disk-fill check (called from cmd_start/cmd_resume/cmd_claude
# right after _print_summary_block, before exec_claude). Reads the shared Docker
# storage Use%+free from inside the just-started box and, in two tiers, prints a
# read-only advisory (>= _DISK_ADVISORY_PCT AND low free) or a full-width amber
# banner that HOLDS the launch on one keypress (>= _DISK_GATE_PCT AND lower
# free). Cap-relative Use%, so a 60 GB and a 1.8 TB disk trip at the same
# fullness. Fail-soft: off a TTY, on an unreadable fill, or a down daemon it
# stays silent. Always returns 0 (runs bare under set -euo pipefail).
_maybe_gate_on_disk_fill() {
  local cname="$1"
  _is_tty || return 0
  [[ -n "$cname" ]] || return 0

  local read_out pct avail_kb free_gb
  read_out="$(_read_container_disk_use "$cname")"
  pct="${read_out%% *}"
  avail_kb="${read_out##* }"
  [[ "$pct" =~ ^[0-9]+$ && "$avail_kb" =~ ^[0-9]+$ ]] || return 0
  free_gb=$(( avail_kb / 1048576 ))

  # Advisory predicate: high fill AND genuinely low free. The free floor removes
  # the 95%-of-1.8-TB = 90-GB-free false positive (it can only ever REMOVE a
  # trigger). Below the band: silence.
  (( pct >= _DISK_ADVISORY_PCT && free_gb < _DISK_ADVISORY_FREE_GB )) || return 0

  local gate=false
  (( pct >= _DISK_GATE_PCT && free_gb < _DISK_GATE_FREE_GB )) && gate=true

  local kind subject
  kind="$(_disk_help_kind)"
  subject="$(_disk_subject "$kind")"

  # Cleat's OWN reclaimable images only (label-scoped, container-pinned excluded).
  # Honest by construction: never includes build cache or volumes (shared).
  local stats mb reclaim_gb=0
  stats="$(_cleat_prunable_stats)"
  mb="${stats##*	}"
  [[ "$mb" =~ ^[0-9]+$ ]] && reclaim_gb=$(( (mb + 512) / 1024 ))

  if ! $gate; then
    # ADVISORY band: read-only, daily-throttled with its OWN stamp (the memory
    # check already stamped PRESSURE_CHECK_FILE this run).
    local now last=0
    now="$(date +%s)"
    if [[ -f "$DISK_CHECK_FILE" ]]; then
      last="$(head -1 "$DISK_CHECK_FILE" 2>/dev/null || echo 0)"
      [[ "$last" =~ ^[0-9]+$ ]] || last=0
    fi
    (( now - last < DISK_CHECK_INTERVAL )) && return 0
    echo "$now" > "$DISK_CHECK_FILE" 2>/dev/null || true

    echo ""
    warn "${subject} is ${BOLD}${pct}% full${RESET} ${DIM}(${free_gb} GB free)${RESET}. Every Cleat box shares it."
    if (( reclaim_gb >= 1 )); then
      echo -e "    ${DIM}Cleat can reclaim ~${reclaim_gb} GB of stale images: ${RESET}${BOLD}cleat prune${RESET}"
    fi
    echo -e "    ${DIM}What is using the disk: ${RESET}${BOLD}cleat storage${RESET}"
    _disk_lever_short "$kind"
    return 0
  fi

  # HARD band: full-width amber banner + one-keypress hold. The banner IS the
  # escalated advisory (same substance plus the keypress), never printed on top
  # of the compact advisory.
  local rule
  if _has_unicode; then
    rule="────────────────────────────────────────────────"
  else
    rule="================================================"
  fi
  echo ""
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo -e "  ${AMBER}${BOLD}  Docker's disk is almost full${RESET}"
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo ""
  echo -e "  ${AMBER}!${RESET} ${BOLD}${subject} is ${pct}% full (${free_gb} GB free).${RESET} Writes across every Cleat box are about to fail."
  echo -e "    ${DIM}Every box shares this one disk, so one full disk stops them all.${RESET}"
  echo ""
  if (( reclaim_gb >= 1 )); then
    echo -e "    ${DIM}Cleat can reclaim ~${reclaim_gb} GB of stale images: ${RESET}${BOLD}cleat prune${RESET}"
  else
    echo -e "    ${DIM}Cleat's own images are not the bulk here. Most of the space is other projects or build cache.${RESET}"
  fi
  echo -e "    ${DIM}What is using the disk: ${RESET}${BOLD}cleat storage${RESET}"
  _disk_lever_short "$kind"
  echo ""

  # The hold: interactive-only and escapable, mirroring the config gate. The box
  # is ALREADY running here (we just read its df), so Ctrl-C does NOT stop it:
  # the copy says so truthfully instead of the config gate's "Ctrl-C to stop".
  if _is_interactive && [[ "${CLEAT_NO_DISK_GATE:-}" != "1" ]]; then
    echo -e "    ${DIM}To skip this stop from now on: ${RESET}${BOLD}CLEAT_NO_DISK_GATE=1${RESET}${DIM}.${RESET}"
    echo -e "    ${DIM}Ctrl-C stops here but leaves the box running. Free disk, then run cleat again.${RESET}"
    echo ""
    echo -en "  ${BLUE}▸${RESET} Press ${BOLD}Enter${RESET} to continue into the session, or ${BOLD}Ctrl-C${RESET} to stop "
    local _ack=""
    read -r _ack || true
  fi
  return 0
}

cmd_clean() {
  cmd_stop_all
  if image_exists; then
    info "Removing image..."
    docker rmi "$IMAGE_NAME" > /dev/null
    success "Image removed."
  else
    info "No image to remove."
  fi

  # Prune orphaned box descriptions (boxes whose container no longer exists).
  if [[ -d "$CLEAT_BOXES_DIR" ]]; then
    local _bf _bcn
    for _bf in "$CLEAT_BOXES_DIR"/*; do
      [[ -f "$_bf" ]] || continue
      _bcn="$(basename "$_bf")"
      # Per-box state files may carry a suffix (<cname>.fork). Strip it, or the
      # basename never matches a container, the file is pruned, and a fork box
      # silently reverts to mounting the LIVE tree on its next run.
      _bcn="${_bcn%.fork}"
      if ! container_exists "$_bcn"; then rm -f "$_bf" 2>/dev/null || true; fi
    done
  fi

  # Prune orphaned per-container runtime dirs: overlays for containers that no
  # longer exist (project dir moved/deleted, or the container was removed
  # outside cleat). cmd_stop_all only stops containers, so live ones still
  # exist and their dirs are kept. Kept LAST so its if/fi guard remains
  # cmd_clean's final statement (a trailing false `[[ ]] &&` would exit 1).
  if [[ -d "$CLEAT_RUN_DIR" ]]; then
    local _d _cn _pruned=0
    for _d in "$CLEAT_RUN_DIR"/*/; do
      [[ -d "$_d" ]] || continue
      _cn="$(basename "$_d")"
      if ! container_exists "$_cn"; then
        rm -rf "$_d" 2>/dev/null || true
        _pruned=$((_pruned + 1))
      fi
    done
    # Use if/fi, not `[[ ]] &&`: a trailing false test would make cmd_clean
    # (the last statement in main) exit 1 on a successful run with 0 orphans.
    if [[ $_pruned -gt 0 ]]; then info "Pruned ${_pruned} orphaned runtime dir(s)."; fi
  fi
}

cmd_nuke() {
  echo ""
  warn "This will remove ${BOLD}ALL${RESET} Cleat containers and images."
  echo -e "  ${DIM}It also clears the shared Docker build cache used by all projects (regenerable).${RESET}"
  echo -e "  ${DIM}Your project files and ~/.claude auth are safe (they live on the host).${RESET}"
  echo ""
  read -rp "  Type 'nuke' to confirm: " confirm
  if [[ "$confirm" != "nuke" ]]; then
    info "Aborted."
    return
  fi
  echo ""

  local containers
  containers=$(docker ps -a --filter "name=^cleat-" --format '{{.Names}}' 2>/dev/null)
  if [[ -n "$containers" ]]; then
    info "Removing containers..."
    echo "$containers" | while read -r c; do
      docker rm -f "$c" > /dev/null 2>&1
      echo -e "    ${DIM}removed ${c}${RESET}"
    done
  fi

  if image_exists; then
    info "Removing image..."
    docker rmi -f "$IMAGE_NAME" > /dev/null 2>&1
  fi

  # Per-container runtime dirs (overlays / clipboard / hook spool) are persistent
  # now, so /tmp rotation won't reclaim them: wipe them explicitly.
  if [[ -d "$CLEAT_RUN_DIR" ]]; then
    info "Removing per-container runtime dirs..."
    rm -rf "$CLEAT_RUN_DIR" 2>/dev/null || true
  fi

  # Per-project persistent .claude.json store (trust/MCP approvals): nuke
  # removes everything Cleat-related, so clear it too. (cleat rm preserves it.)
  if [[ -d "$CLEAT_PROJECTS_DIR" ]]; then
    info "Removing per-project Claude state..."
    rm -rf "$CLEAT_PROJECTS_DIR" 2>/dev/null || true
  fi

  if [[ -d "$CLEAT_BOXES_DIR" ]]; then
    rm -rf "$CLEAT_BOXES_DIR" 2>/dev/null || true
  fi

  if [[ -d "$CLEAT_KITS_DIR" ]]; then
    rm -rf "$CLEAT_KITS_DIR" 2>/dev/null || true
  fi

  # Dangling cleat builds only (label-scoped): other projects' dangling images
  # are not ours to delete. Same _dangling_cleat_images seam cmd_prune uses.
  local _did id
  _did="$(_dangling_cleat_images)"
  if [[ -n "$_did" ]]; then
    info "Pruning dangling cleat images..."
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      docker rmi "$id" > /dev/null 2>&1 || true
    done <<< "$_did"
  fi

  info "Pruning build cache ${DIM}(shared across all Docker projects)${RESET}..."
  docker builder prune -f > /dev/null 2>&1 || true

  echo ""
  success "Nuked. All Cleat containers and images are gone from Docker."
  echo -e "  ${DIM}Run ${BOLD}cleat start${RESET}${DIM} to rebuild from scratch.${RESET}"
  echo ""
}

# Format a byte count as GB for display ("12.3 GB", or "36 GB" when >= 10).
_fmt_gb() {
  LC_ALL=C awk -v b="${1:-0}" 'BEGIN { g = b / 1073741824; printf (g >= 10 ? "%.0f GB" : "%.1f GB"), g }'
}

# Fill of the shared docker store as "used_kb total_kb pct", read from a running
# cleat box first, else a one-shot on cleat's OWN image (never a foreign
# container: reading into another project's box crosses the boundary cleat
# defends). Empty when neither is available. Seam (test override).
_storage_fill() {
  local cname
  cname="$(_running_cleat_boxes 2>/dev/null | head -1)"
  if [[ -n "$cname" ]]; then
    docker exec "$cname" df -kP / 2>/dev/null \
      | awk '$NF=="/" { p=$5; gsub(/%/,"",p); print $3" "$2" "p }' || true
    return 0
  fi
  if image_exists 2>/dev/null; then
    docker run --rm --entrypoint df "$IMAGE_NAME" -kP / 2>/dev/null \
      | awk '$NF=="/" { p=$5; gsub(/%/,"",p); print $3" "$2" "p }' || true
  fi
}

# `cleat storage`: a read-only, cross-OS breakdown of the shared Docker store.
# Honest attribution: cleat IMAGES + BOXES are label-scoped (attributable);
# build cache and volumes are shared/other-project (never called "cleat's").
# Never mutates: docker system df is on-demand here, never on the start path.
cmd_storage() {
  if ! _daemon_up; then
    error "Docker is not running."
    echo -e "  ${DIM}Start it, then run ${RESET}${BOLD}cleat storage${RESET}${DIM} again.${RESET}"
    return 1
  fi

  local kind; kind="$(_disk_help_kind)"

  echo ""
  echo -e "  ${BOLD}Docker storage${RESET}   ${DIM}one shared store, used by every container on this host${RESET}"
  echo ""

  # Fill bar (the cap-relative number the field incident proved matters).
  local fill used_kb total_kb pct
  fill="$(_storage_fill)"
  if [[ -n "$fill" ]]; then
    used_kb="${fill%% *}"
    total_kb="$(printf '%s' "$fill" | awk '{print $2}')"
    pct="${fill##* }"
    [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
    [[ "$used_kb" =~ ^[0-9]+$ ]] || used_kb=0
    [[ "$total_kb" =~ ^[0-9]+$ ]] || total_kb=0
    local barw=28 filled empty gl gd bar="" bar2="" i=0 tier
    filled=$(( pct * barw / 100 ))
    (( filled > barw )) && filled=barw
    (( filled < 0 )) && filled=0
    empty=$(( barw - filled ))
    if _has_unicode; then gl="█"; gd="░"; else gl="#"; gd="-"; fi
    while (( i < filled )); do bar="${bar}${gl}"; i=$(( i + 1 )); done
    i=0
    while (( i < empty )); do bar2="${bar2}${gd}"; i=$(( i + 1 )); done
    if   (( pct >= _DISK_GATE_PCT ));     then tier="$RED"
    elif (( pct >= _DISK_ADVISORY_PCT )); then tier="$AMBER"
    else tier="$GREEN"; fi
    echo -e "  ${BLUE}▸${RESET} ${BOLD}Disk${RESET}   ${tier}${bar}${RESET}${DIM}${bar2}${RESET}   ${BOLD}$(_fmt_gb $(( used_kb * 1024 )))${RESET} ${DIM}/ $(_fmt_gb $(( total_kb * 1024 )))${RESET}   ${BOLD}${pct}% full${RESET}"
  else
    echo -e "  ${BLUE}▸${RESET} ${BOLD}Disk${RESET}   ${DIM}(start a box to read live fill: ${RESET}${BOLD}cleat start${RESET}${DIM})${RESET}"
  fi
  echo ""

  # Authoritative per-type totals from docker system df (on-demand, never on
  # start). Value-only fields, so the " (NN%)" reclaimable suffix stays parseable.
  local t s r
  local img_b=0 img_rb=0 con_b=0 con_rb=0 vol_b=0 vol_rb=0 cache_b=0 cache_rb=0
  while IFS="$(printf '\t')" read -r t s r; do
    case "$t" in
      Images)          img_b="$(_human_size_to_bytes "$s")";   img_rb="$(_human_size_to_bytes "$r")" ;;
      Containers)      con_b="$(_human_size_to_bytes "$s")";   con_rb="$(_human_size_to_bytes "$r")" ;;
      "Local Volumes") vol_b="$(_human_size_to_bytes "$s")";   vol_rb="$(_human_size_to_bytes "$r")" ;;
      "Build Cache")   cache_b="$(_human_size_to_bytes "$s")"; cache_rb="$(_human_size_to_bytes "$r")" ;;
    esac
  done < <(docker system df --format "{{.Type}}$(printf '\t'){{.Size}}$(printf '\t'){{.Reclaimable}}" 2>/dev/null)

  echo -e "  ${BOLD}On disk${RESET} ${DIM}(all projects)${RESET}"
  printf "    %-20s %9s   %11s\n" "" "size" "reclaimable"
  printf "    %-20s %9s   %11s\n" "Images"     "$(_fmt_gb "$img_b")"   "$(_fmt_gb "$img_rb")"
  printf "    %-20s %9s   %11s\n" "Containers" "$(_fmt_gb "$con_b")"   "$(_fmt_gb "$con_rb")"
  printf "    %-20s %9s   %11s\n" "Volumes"    "$(_fmt_gb "$vol_b")"   "$(_fmt_gb "$vol_rb")"
  printf "    %-20s %9s   %11s\n" "Build cache (shared)" "$(_fmt_gb "$cache_b")" "$(_fmt_gb "$cache_rb")"
  echo ""

  # Cleat's attributable share: COUNTS (a byte sum of {{.Size}} would double-count
  # shared base layers, so we show counts plus the accurate reclaimable figure).
  local cleat_img_n=0 cleat_box_n=0 id seen=" "
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    case "$seen" in *" $id "*) continue ;; esac
    seen="$seen$id "
    cleat_img_n=$(( cleat_img_n + 1 ))
  done < <(docker images --filter label=sh.cleat.version --format '{{.ID}}' 2>/dev/null)
  local nm
  while IFS= read -r nm; do
    [[ -n "$nm" ]] && cleat_box_n=$(( cleat_box_n + 1 ))
  done < <(docker ps -a --filter label=sh.cleat.version --format '{{.Names}}' 2>/dev/null)

  # Cleat's reclaimable images (accurate, label-scoped, container-pinned excluded).
  local stats mb cleat_reclaim_b=0
  stats="$(_cleat_prunable_stats)"
  mb="${stats##*	}"
  [[ "$mb" =~ ^[0-9]+$ ]] && cleat_reclaim_b=$(( mb * 1048576 ))

  echo -e "  ${BOLD}Cleat's share${RESET}"
  printf "    %-20s %2s image%s, %s box%s\n" "" "$cleat_img_n" "$( (( cleat_img_n != 1 )) && printf s )" "$cleat_box_n" "$( (( cleat_box_n != 1 )) && printf es )"
  echo ""
  echo -e "  ${BOLD}Cleat can reclaim${RESET}"
  echo -e "    ${GREEN}$(_fmt_gb "$cleat_reclaim_b")${RESET}   ${DIM}stale cleat images${RESET}      ${BOLD}cleat prune${RESET}"
  echo -e "    ${DIM}$(_fmt_gb "$cache_rb")${RESET}   ${DIM}shared build cache${RESET}     ${BOLD}cleat prune --cache${RESET} ${DIM}(all projects)${RESET}"
  echo ""
  echo -e "  ${DIM}Other projects hold the rest. Cleat never deletes them. See ${RESET}${BOLD}docker system df${RESET}${DIM}.${RESET}"
  # Same 2-space indent as the line above and no blank between them: these two
  # are one closing paragraph (where the rest went, then how to get space back),
  # not the indented tail of a notice block.
  _disk_lever_short "$kind" "  "
  echo ""
}

cmd_install() {
  local target="/usr/local/bin"
  local script_path
  script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

  info "Installing CLI symlink..."

  if [[ -w "$target" ]]; then
    ln -sf "$script_path" "$target/cleat"
  else
    sudo ln -sf "$script_path" "$target/cleat"
  fi

  success "Installed! You can now use ${BOLD}cleat${RESET} from anywhere."
  echo ""
  echo -e "  ${DIM}Try it:${RESET}"
  echo -e "    ${BOLD}cd ~/some-project && cleat start${RESET}"
  echo ""
}

cmd_uninstall() {
  local target="/usr/local/bin"
  info "Removing CLI symlinks..."
  if [[ -w "$target" ]]; then
    rm -f "$target/cleat"
  else
    sudo rm -f "$target/cleat"
  fi
  success "Uninstalled."
}

# ── cleat config ────────────────────────────────────────────────────────────
_cap_description() {
  case "$1" in
    git)    echo "Mount ~/.gitconfig (read-only) for commit identity" ;;
    ssh)    echo "Mount ~/.ssh (read-only) and forward SSH agent" ;;
    env)    echo "Load env vars from ~/.config/cleat/env and .cleat.env" ;;
    hooks)  echo "Run your Claude Code hooks on the host (global + project)" ;;
    gh)     echo "GitHub CLI auth (persists across rm/nuke/rebuild)" ;;
    docker) echo "Host Docker socket (breaks sandbox) to test Docker apps" ;;
    *)      echo "(unknown capability)" ;;
  esac
}

_scaffold_cleat_env() {
  local project="${1:-$PWD}"
  local env_file="$project/.cleat.env"
  [[ -f "$env_file" ]] && return 0
  cat > "$env_file" << 'ENVEOF'
# .cleat.env: project environment variables for Cleat
# Loaded when the "env" capability is enabled.
# Add to .gitignore: do not commit secrets.
#
# KEY=VALUE  set explicitly
# KEY        inherit from host environment
#
# Example:
# GH_TOKEN
# DATABASE_URL=postgres://localhost:5432/myapp
ENVEOF
  success "Created ${DIM}${env_file}${RESET} (add to .gitignore)"
}

# ── .cleat editor (capabilities + resources) ───────────────────────────────
#
# `cleat config` opens ONE flat list that edits both [caps] (SPACE toggles) and
# [resources] memory/cpus (←/→ cycles a preset ring). In GLOBAL scope a final
# "generate" row also stamps the selections into this project's ./.cleat, so the
# per-project config never has to be hand-written. It follows the `cleat kit`
# editor's shape (arrow-key TUI + a text fallback for non-TTY).

# Preset rings for the resource rows. Index 0 is the "unset" sentinel (default /
# all) so a previously-set value can be CLEARED by cycling back to it. 2g is
# deliberately absent from the memory ring: the VM-derived default floors at 4g,
# so offering 2g would read as a DOWNGRADE of "default". A hand-set custom value
# (e.g. 16g, 1.5) that is not a ring stop stays reachable (see _config_cycle_value).
#
# These two are the STATIC FALLBACK rings, used verbatim when the machine cannot
# be sized. The live editor builds its rings from the real machine instead (see
# _config_mem_choices / _config_cpu_choices) so it never offers a value this
# Docker cannot honour. It also stops hiding headroom this Docker really has.
_CONFIG_MEM_CHOICES=(default 4g 6g 8g)
_CONFIG_CPU_CHOICES=(all 1 2 4 8)

# The ceiling resolve_box_memory clamps a PROJECT-supplied value to. A .cleat
# ships with the repo, so an untrusted project must not be able to re-introduce
# VM-wide overcommit. Kept in whole GB for the ring and the notes. This MUST stay
# in sync with the 8589934592 byte comparisons in resolve_box_memory and
# _configured_box_memory; `config: project ring stops at the runtime clamp`
# in config.bats fails if the two ever drift.
_PROJECT_MEM_CAP_GB=8

# The Docker VM's memory in whole GB, empty when it cannot be sized. The single
# seam the memory ring AND its warnings both read, so the top of the ring and
# the "that is your whole VM" warning can never disagree (the same
# one-helper-for-display-and-threshold rule _docker_vm_display_gb exists for).
_config_vm_gb() {
  local b g
  b="$(_docker_vm_memory)"
  [[ "$b" =~ ^[0-9]+$ ]] && (( b > 0 )) || return 0
  g="$(_docker_vm_display_gb "$b")"
  if [[ "$g" =~ ^[0-9]+$ ]] && (( g > 0 )); then
    printf '%s' "$g"
  fi
  return 0
}

# The memory ring for a scope, space separated. GLOBAL scope climbs in real
# stops up to the Docker VM's own size: someone who runs one box at a time may
# legitimately want all of it. Capping the picker at 8g hid headroom on a
# 24 GB VM. PROJECT scope stops at the runtime clamp, so the picker can never
# offer a repo-shipped value the box would silently not get. Unknown VM size
# falls back to the static ring (never invent headroom we cannot verify).
_config_mem_choices() {
  local scope="${1:-global}" vm_gb g out
  out="${_CONFIG_MEM_CHOICES[*]}"
  if [[ "$scope" == "project" ]]; then
    printf '%s' "$out"
    return 0
  fi
  vm_gb="$(_config_vm_gb)"
  if ! [[ "$vm_gb" =~ ^[0-9]+$ ]] || (( vm_gb <= _PROJECT_MEM_CAP_GB )); then
    printf '%s' "$out"
    return 0
  fi
  for g in 12 16 24 32 48 64 96 128 192 256; do
    (( g < vm_gb )) || break
    out="$out ${g}g"
  done
  printf '%s %sg' "$out" "$vm_gb"
}

# The cpu ring, space separated, built from the daemon's REAL core count. A
# --cpus above NCPU is a dockerd error, so a ring stop the machine cannot honour
# is a trap. Equally, a fixed ring ending at 8 hid 16 cores on a big machine.
# The ring always ends on the exact core count (a hard cap at every core, which
# is not the same as `all`: `all` writes no --cpus at all). Unknown core count
# falls back to the static ring.
_config_cpu_choices() {
  local ncpu n out
  ncpu="$(_daemon_ncpu)"
  if ! [[ "$ncpu" =~ ^[0-9]+$ ]] || (( ncpu < 1 )); then
    printf '%s' "${_CONFIG_CPU_CHOICES[*]}"
    return 0
  fi
  out="all"
  for n in 1 2 4 8 16 32 64 128; do
    (( n < ncpu )) || break
    out="$out $n"
  done
  printf '%s %s' "$out" "$ncpu"
}

# The graduated note for a chosen memory ceiling. Emits EXACTLY two lines (both
# empty below the first tier) so the picker's redraw math stays a constant: a
# note that wrapped or changed height would desync every cursor-up in the TUI.
# Keep each line under ~74 visible columns for the same reason.
#
# Three tiers, because more RAM reads as free until it is not. A cgroup limit is
# a ceiling, not a reservation, so a big number is harmless right up until a box
# actually grows into it. The tiers are relative to the VM, the only number that
# decides whether one box can starve the daemon. The top tier is the honest
# one. $1 = the value, $2 = the VM size in GB (empty when unknown).
_config_mem_note() {
  local v="$1" vm_gb="${2:-}" gb
  case "$v" in ""|default) printf '\n\n'; return 0 ;; esac
  if ! _valid_memory_value "$v"; then printf '\n\n'; return 0; fi
  gb=$(( $(_mem_to_bytes "$v") / 1073741824 ))

  # The whole-VM tier is tested BEFORE the 8 GB floor, because it must agree
  # with _config_mem_warn_block, which has no floor. A Docker Desktop VM left at
  # its 8 GB default makes 8g BOTH the ring's top stop and the entire VM: with
  # the floor first the picker said nothing and then ENTER printed the full amber
  # block. The floor still guards the two milder tiers, so a 4g ceiling on a
  # small VM stays quiet (it is the derived default there, not a choice).
  if [[ "$vm_gb" =~ ^[0-9]+$ ]] && (( vm_gb >= 1 )) && (( gb >= vm_gb )); then
    printf 'warning: %s GB is the whole Docker VM. A box that grows into it\n' "$gb"
    printf '         starves the daemon, so Linux OOM-kills inside the VM.\n'
    return 0
  fi
  if (( gb <= _PROJECT_MEM_CAP_GB )); then printf '\n\n'; return 0; fi

  if ! [[ "$vm_gb" =~ ^[0-9]+$ ]] || (( vm_gb < 1 )); then
    printf 'note: above %s GB. A ceiling is not a reservation, so this only\n' "$_PROJECT_MEM_CAP_GB"
    printf '      bites when a box really grows into it.\n'
    return 0
  fi
  if (( gb * 2 >= vm_gb )); then
    printf 'note: over half the %s GB Docker VM. Two boxes at this ceiling can\n' "$vm_gb"
    printf '      oversubscribe it, so run one at a time.\n'
    return 0
  fi
  printf 'note: above %s GB of the %s GB VM. A ceiling is not a reservation,\n' "$_PROJECT_MEM_CAP_GB" "$vm_gb"
  printf '      so this only bites when a box really grows into it.\n'
}

# The full paragraph behind the top tier, printed once on SAVE (and by the
# direct-mode setter) rather than in the picker, where two lines is all the
# redraw can afford. This is the "why is that dangerous" the short note cannot
# hold. Prints nothing below the top tier.
_config_mem_warn_block() {
  local v="$1" vm_gb="${2:-}" gb
  case "$v" in ""|default) return 0 ;; esac
  _valid_memory_value "$v" || return 0
  [[ "$vm_gb" =~ ^[0-9]+$ ]] && (( vm_gb > 0 )) || return 0
  gb=$(( $(_mem_to_bytes "$v") / 1073741824 ))
  (( gb >= vm_gb )) || return 0
  echo ""
  warn "A ${gb} GB ceiling is the entire Docker VM."
  echo -e "    ${DIM}Docker gives the box a ceiling, not a reservation, so this is fine${RESET}"
  echo -e "    ${DIM}until an agent really uses it. When one does, nothing is left for${RESET}"
  echo -e "    ${DIM}the daemon or the VM's own kernel. The Linux OOM killer inside${RESET}"
  echo -e "    ${DIM}the VM then starts killing processes. That can take out a working${RESET}"
  echo -e "    ${DIM}agent mid-write or wedge Docker until you restart it. Leave the VM${RESET}"
  echo -e "    ${DIM}a couple of GB of headroom. Run one box at a time at this size.${RESET}"
}

# Cycle a resource value through its ring. $1 = next|prev, $2 = current value,
# $3 = custom pin (a hand-set value not in the ring; pass "" when none), $4.. =
# ring choices. Mirrors _kit_next_model/_kit_prev_model but wraps with modulo and
# folds the custom pin in ONCE (deduped against the choices so a preset value
# passed as custom does not double-append). ALWAYS ends on `echo`, never a bare
# test/arithmetic, so a strict-mode `$(...)` caller is never killed.
_config_cycle_value() {
  local dir="$1" current="$2" custom="$3"
  shift 3
  local ring=("$@")
  if [[ -n "$custom" ]]; then
    local _dup=false _c
    for _c in "$@"; do [[ "$_c" == "$custom" ]] && _dup=true; done
    $_dup || ring+=("$custom")
  fi
  local m=${#ring[@]} i
  for ((i = 0; i < m; i++)); do
    if [[ "${ring[$i]}" == "$current" ]]; then
      if [[ "$dir" == "prev" ]]; then
        echo "${ring[$(((i - 1 + m) % m))]}"
      else
        echo "${ring[$(((i + 1) % m))]}"
      fi
      return 0
    fi
  done
  # current is not on the ring (e.g. a value cleared out from under us): land on
  # the first stop so a keypress always moves somewhere sane.
  echo "${ring[0]}"
}

# Map a cursor position to the row it addresses. Echoes cap:<name> | mem | cpus |
# gen. The nav order is: caps 0..N-1, then memory, then cpus, then (global scope
# only) the generate row. This is the ONLY place that turns a cursor into a
# KNOWN_CAPS index, so no key handler ever indexes KNOWN_CAPS with a cursor that
# might land on a resource/generate row (that read is a set -u crash in the real
# binary, not a silent no-op).
_config_row_kind() {
  local cur="$1" ncaps=${#KNOWN_CAPS[@]}
  if (( cur < ncaps )); then
    echo "cap:${KNOWN_CAPS[$cur]}"
  elif (( cur == ncaps )); then
    echo "mem"
  elif (( cur == ncaps + 1 )); then
    echo "cpus"
  else
    echo "gen"
  fi
}

# Draw the whole editor block: a "Capabilities" group, the cap rows, a blank, a
# "Resources" group, the memory + cpus rows, and (when show_gen=1) a blank plus
# the generate row. It always emits the SAME number of physical lines for a given
# scope (deterministic), which is what lets the TUI's cursor-up/down math be a
# single scope-derived constant. Every row is one physical line; keep labels short
# so an 80-column terminal never wraps a row (a wrap desyncs the redraw). New
# params are read with `${n:-}` defaults so both the 2-arg draw tests and the real
# strict-mode binary are safe.
_config_picker_draw() {
  local cursor="$1"
  local toggled="$2"
  local mem="${3:-default}"
  local cpus="${4:-all}"
  local show_gen="${5:-0}"
  local gen_on="${6:-0}"
  local vm_gb="${7:-}"
  local ncaps=${#KNOWN_CAPS[@]}
  local i=0 cap marker

  printf '\033[2K'
  echo -e "  ${DIM}Capabilities${RESET} ${DIM}(space toggles host access)${RESET}"
  while [[ $i -lt $ncaps ]]; do
    cap="${KNOWN_CAPS[$i]}"
    marker="${DIM}·${RESET}"
    case ",${toggled}," in *,"$cap",*) marker="${GREEN}✔${RESET}" ;; esac
    printf '\033[2K'
    if [[ $i -eq $cursor ]]; then
      echo -e "  ${CYAN}▸${RESET} [${marker}] ${BOLD}${cap}${RESET}  $(_cap_description "$cap")"
    else
      echo -e "    [${marker}] ${cap}  ${DIM}$(_cap_description "$cap")${RESET}"
    fi
    i=$((i + 1))
  done

  printf '\033[2K'; echo ""
  printf '\033[2K'
  echo -e "  ${DIM}Resources${RESET} ${DIM}(←/→ changes the value)${RESET}"
  printf '\033[2K'
  if [[ $cursor -eq $ncaps ]]; then
    echo -e "  ${CYAN}▸${RESET} memory  ${BOLD}‹ ${mem} ›${RESET}  ${DIM}(per-box RAM ceiling)${RESET}"
  else
    echo -e "    memory  ${mem}  ${DIM}(per-box RAM ceiling)${RESET}"
  fi
  printf '\033[2K'
  if [[ $cursor -eq $((ncaps + 1)) ]]; then
    echo -e "  ${CYAN}▸${RESET} cpus    ${BOLD}‹ ${cpus} ›${RESET}  ${DIM}(core limit; all = no cap)${RESET}"
  else
    echo -e "    cpus    ${cpus}  ${DIM}(core limit; all = no cap)${RESET}"
  fi

  if [[ "$show_gen" == "1" ]]; then
    printf '\033[2K'; echo ""
    marker="${DIM}·${RESET}"
    [[ "$gen_on" == "1" ]] && marker="${GREEN}✔${RESET}"
    printf '\033[2K'
    if [[ $cursor -eq $((ncaps + 2)) ]]; then
      echo -e "  ${CYAN}▸${RESET} [${marker}] ${BOLD}Also write these to this project's .cleat${RESET}"
    else
      echo -e "    [${marker}] ${DIM}Also write these to this project's .cleat${RESET}"
    fi
  fi

  # The memory note area: ALWAYS exactly two lines, blank below the first tier.
  # Reserved rather than conditional because the TUI repositions by a constant
  # number of lines, so a note that appeared and vanished would desync the whole
  # redraw. Amber at the top tier, dim below it.
  local note_line note_i=0
  while IFS= read -r note_line; do
    note_i=$((note_i + 1))
    [[ $note_i -le 2 ]] || break
    printf '\033[2K'
    case "$note_line" in
      warning:*) echo -e "  ${AMBER}${note_line}${RESET}" ;;
      "")        echo "" ;;
      *)         echo -e "  ${DIM}${note_line}${RESET}" ;;
    esac
  done < <(_config_mem_note "$mem" "$vm_gb")
  while [[ $note_i -lt 2 ]]; do
    note_i=$((note_i + 1))
    printf '\033[2K'; echo ""
  done
}

# Read the scope file's memory into a (display-value, custom-pin) pair. Empty
# becomes the sentinel; a value not on the ring becomes the reachable custom pin.
# Printed as "<display>\t<custom>" for the caller to split. `|| true` because a
# strict-mode caller assigns this bare and a file read must never abort the editor.
_config_load_resource() {
  local file="$1" key="$2" unset_label="$3" ring="${4:-}"
  local v; v="$(_read_resource_from_file "$file" "$key" || true)"
  local choices
  # $4 is the live ring when the caller built one from this machine. Without it
  # we fall back to the static ring, which keeps every direct 3-arg caller (and
  # the 3-arg tests) reading exactly as before.
  if [[ -n "$ring" ]]; then
    choices=" $ring "
  elif [[ "$key" == "memory" ]]; then choices=" ${_CONFIG_MEM_CHOICES[*]} "; else choices=" ${_CONFIG_CPU_CHOICES[*]} "; fi
  if [[ -z "$v" ]]; then
    printf '%s\t%s\n' "$unset_label" ""
  else
    case "$choices" in
      *" $v "*) printf '%s\t%s\n' "$v" "" ;;
      *)        printf '%s\t%s\n' "$v" "$v" ;;
    esac
  fi
}

# Persist the editor state to the scope file (caps + resources, both section
# preserving), then, in global scope with the generate row on, offer to stamp a
# project ./.cleat. project is resolved ONCE by cmd_config and threaded through so
# the scope label and any write target can never diverge.
_config_editor_save() {
  local config_file="$1" scope="$2" project="$3" toggled="$4" mem="$5" cpus="$6" show_gen="$7" gen_on="$8" vm_gb="${9:-}"

  local final_caps=() cap
  for cap in "${KNOWN_CAPS[@]}"; do
    case ",${toggled}," in *,"$cap",*) final_caps+=("$cap") ;; esac
  done
  local mem_w="$mem" cpu_w="$cpus"
  case "$mem_w" in default|all) mem_w="" ;; esac
  case "$cpu_w" in default|all) cpu_w="" ;; esac

  _write_caps_to_file "$config_file" "${final_caps[@]+"${final_caps[@]}"}"
  _write_resources_to_file "$config_file" "$mem_w" "$cpu_w"
  success "Saved to ${config_file}"
  # The two-line picker note is a nudge. This is the full reason, printed once,
  # only when the ceiling reaches the whole VM.
  _config_mem_warn_block "$mem_w" "$vm_gb"

  case ",${toggled}," in
    *,env,*)
      if [[ -n "$project" && ! -f "${project}/.cleat.env" ]]; then
        echo ""
        local yn=""
        _ask_yn yn "Create .cleat.env in ${project}? [Y/n] "
        if [[ -z "$yn" || "$yn" == [yY]* ]]; then
          _scaffold_cleat_env "$project"
        fi
      fi
      ;;
  esac

  if [[ "$show_gen" == "1" && "$gen_on" == "1" ]]; then
    _config_generate_project "$project" "$mem_w" "$cpu_w" "${final_caps[@]+"${final_caps[@]}"}"
  fi
}

_config_picker_tui() {
  local config_file="$1"
  local scope="$2"
  local project="${3:-}"

  echo ""
  echo -e "  ${BOLD}Cleat config${RESET} ${DIM}(capabilities + resources)${RESET}"
  echo ""
  local scope_label
  if [[ "$scope" == "project" ]]; then
    scope_label="project (${config_file})"
  else
    scope_label="global (${config_file})"
  fi
  echo -e "  ${DIM}Scope: ${scope_label}${RESET}"

  # Rings are built ONCE from the real machine (VM memory, daemon core count) and
  # threaded through every cycle below, so the picker offers exactly what this
  # Docker can honour. Both fall back to the static rings when the machine cannot
  # be sized, so a down daemon degrades to the old behaviour instead of an error.
  local mem_ring cpu_ring vm_gb
  mem_ring="$(_config_mem_choices "$scope")"
  cpu_ring="$(_config_cpu_choices)"
  vm_gb="$(_config_vm_gb)"

  # Project scope stops at the runtime clamp, so say why rather than let the ring
  # look arbitrarily short next to a global editor that climbs to the VM size.
  if [[ "$scope" == "project" ]]; then
    echo -e "  ${DIM}A project .cleat caps memory at ${_PROJECT_MEM_CAP_GB} GB. Raise it in the global config.${RESET}"
  fi

  local toggled="" cap
  while IFS= read -r cap; do
    [[ -n "$cap" ]] && toggled="${toggled:+${toggled},}${cap}"
  done < <(_read_caps_from_file "$config_file")

  local mem mem_custom cpus cpu_custom _pair
  _pair="$(_config_load_resource "$config_file" memory default "$mem_ring")"
  mem="${_pair%%$'\t'*}"; mem_custom="${_pair#*$'\t'}"
  _pair="$(_config_load_resource "$config_file" cpus all "$cpu_ring")"
  cpus="${_pair%%$'\t'*}"; cpu_custom="${_pair#*$'\t'}"

  local show_gen=0 gen_on=0
  [[ "$scope" == "global" && -n "$project" ]] && show_gen=1

  local ncaps=${#KNOWN_CAPS[@]}
  # nav_rows: the rows the cursor ranges over. draw_lines: the physical lines the
  # block draws (incl. the two group headers, the blank separators and the
  # always-two-line memory note area). BOTH are scope-derived and computed ONCE
  # so every reposition below uses one constant.
  local nav_rows=$((ncaps + 2)) draw_lines=$((ncaps + 7))
  if [[ "$show_gen" == "1" ]]; then
    nav_rows=$((nav_rows + 1))
    draw_lines=$((draw_lines + 2))
  fi

  if [[ "$show_gen" == "1" ]]; then
    echo -e "  ${DIM}The last row writes ./.cleat so every clone runs in the same cage.${RESET}"
  fi
  echo ""

  local cursor=0
  tput civis 2>/dev/null || true

  _config_picker_draw "$cursor" "$toggled" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb"
  echo ""
  echo -e "  ${DIM}↑/↓ move  space toggle  ←/→ change  ⏎ save  q cancel${RESET}"
  printf '\033[%dA' "$((draw_lines + 2))"

  while true; do
    local key kind
    key="$(_read_keypress)"
    kind="$(_config_row_kind "$cursor")"

    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=$((cursor - 1)) ;;
      DOWN) [[ $cursor -lt $((nav_rows - 1)) ]] && cursor=$((cursor + 1)) ;;
      SPACE)
        case "$kind" in
          cap:*)
            local current_cap="${kind#cap:}"
            case ",${toggled}," in
              *,"$current_cap",*)
                local _new="" _c
                for _c in $(echo "$toggled" | tr ',' ' '); do
                  [[ "$_c" == "$current_cap" ]] && continue
                  _new="${_new:+${_new},}${_c}"
                done
                toggled="$_new" ;;
              *) toggled="${toggled:+${toggled},}${current_cap}" ;;
            esac ;;
          mem)  mem="$(_config_cycle_value next "$mem" "$mem_custom" $mem_ring)" ;;
          cpus) cpus="$(_config_cycle_value next "$cpus" "$cpu_custom" $cpu_ring)" ;;
          gen)  [[ "$gen_on" == "1" ]] && gen_on=0 || gen_on=1 ;;
        esac ;;
      RIGHT)
        case "$kind" in
          mem)  mem="$(_config_cycle_value next "$mem" "$mem_custom" $mem_ring)" ;;
          cpus) cpus="$(_config_cycle_value next "$cpus" "$cpu_custom" $cpu_ring)" ;;
        esac ;;
      LEFT)
        case "$kind" in
          mem)  mem="$(_config_cycle_value prev "$mem" "$mem_custom" $mem_ring)" ;;
          cpus) cpus="$(_config_cycle_value prev "$cpus" "$cpu_custom" $cpu_ring)" ;;
        esac ;;
      ENTER)
        tput cnorm 2>/dev/null || true
        printf '\033[%dB' "$((draw_lines + 2))"
        printf '\033[2K'
        echo ""
        _config_editor_save "$config_file" "$scope" "$project" "$toggled" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb"
        return ;;
      QUIT|ESC)
        tput cnorm 2>/dev/null || true
        printf '\033[%dB' "$((draw_lines + 2))"
        printf '\033[2K'
        echo ""
        info "Cancelled."
        return ;;
    esac

    _config_picker_draw "$cursor" "$toggled" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb"
    printf '\033[%dA' "$draw_lines"
  done
}

# Write a project ./.cleat from the editor's selections. Fixed args FIRST so the
# variadic caps can be recovered in bash 3.2 (`shift 3; caps=("$@")`). When the
# file is FRESH we lay down a short header comment first (readers skip `#` lines),
# then the section-preserving caps + resources writers keep it as preamble. When
# it already exists we never touch the header: the writers replace only [caps] and
# [resources] and leave [setup] and any other section byte-for-byte.
_generate_project_cleat() {
  local project="$1" memory="$2" cpus="$3"
  shift 3
  local caps=("$@")
  local file="${project}/.cleat"
  local fresh=0
  [[ -f "$file" ]] || fresh=1

  if [[ $fresh -eq 1 ]]; then
    mkdir -p "$project"
    {
      echo "# .cleat: Cleat project config. Commit it so every clone runs in the same cage."
      echo "# Written by 'cleat config'. Edit freely or re-run the editor."
      echo "# [caps] grant host access (off by default). [resources] cap the box."
      echo "# Docs: https://cleat.sh/docs"
      echo ""
    } > "$file"
  fi

  _write_caps_to_file "$file" "${caps[@]+"${caps[@]}"}"
  _write_resources_to_file "$file" "$memory" "$cpus"
}

# Confirm and stamp the selections into ./.cleat (global-scope generate row). This
# is an outward-facing write of a file the user is told to commit and share, so it
# is gated behind an explicit default-DENY confirm that spells out exactly which
# caps land in it (docker called out in amber: it hands over the host once trusted).
# We never auto-trust and never offer `cleat trust` here: trust is a separate,
# next-run ritual (and cmd_trust would also approve any pre-existing [setup]).
_config_generate_project() {
  local project="$1" memory="$2" cpus="$3"
  shift 3
  local caps=("$@")
  local target="${project}/.cleat"

  case "$project" in
    ""|"/"|"$HOME")
      warn "Not writing .cleat in ${project:-this location} ${DIM}(run cleat config from a project directory)${RESET}"
      return 0 ;;
  esac
  if [[ ${#caps[@]} -eq 0 && -z "$memory" && -z "$cpus" ]]; then
    info "Nothing to write to .cleat ${DIM}(no capabilities enabled and resources at default)${RESET}"
    return 0
  fi

  # The global editor's memory ring climbs to the VM size, but resolve_box_memory
  # clamps a PROJECT value back down, so writing the bigger number into .cleat
  # would promise a ceiling the box never gets. Clamp here and say so, rather
  # than stamp a figure the runtime quietly overrides.
  local mem_clamped=0
  if [[ -n "$memory" ]] && _valid_memory_value "$memory" && (( $(_mem_to_bytes "$memory") > 8589934592 )); then
    memory="${_PROJECT_MEM_CAP_GB}g"
    mem_clamped=1
  fi

  echo ""
  echo -e "  ${BOLD}Write ${target}${RESET}"
  echo -e "  ${DIM}This file is committed and shared. Every clone runs in the same cage.${RESET}"
  echo ""
  if [[ ${#caps[@]} -gt 0 ]]; then
    echo -e "  ${DIM}Capabilities (host access):${RESET}"
    local c
    for c in "${caps[@]}"; do
      if [[ "$c" == "docker" ]]; then
        echo -e "    ${AMBER}!${RESET} ${BOLD}docker${RESET} ${DIM}(mounts the host Docker socket: full host control once trusted)${RESET}"
      else
        echo -e "    ${GREEN}✔${RESET} ${c}"
      fi
    done
  else
    echo -e "  ${DIM}Capabilities: none${RESET}"
  fi
  local res=""
  [[ -n "$memory" ]] && res="memory = ${memory}"
  [[ -n "$cpus" ]] && res="${res:+${res}    }cpus = ${cpus}"
  [[ -n "$res" ]] && echo -e "  ${DIM}Resources: ${res}${RESET}"
  if [[ $mem_clamped -eq 1 ]]; then
    echo -e "  ${DIM}Memory written as ${_PROJECT_MEM_CAP_GB}g: a project .cleat is capped there. Your global setting keeps its larger value.${RESET}"
  fi
  if [[ -f "$target" ]]; then
    echo -e "  ${DIM}${target} exists: its [caps] and [resources] are replaced, other sections kept.${RESET}"
  fi
  echo ""
  local yn=""
  _ask_yn yn "Write this .cleat? ${DIM}[y/N]${RESET} "
  if [[ "$yn" == [yY]* ]]; then
    _generate_project_cleat "$project" "$memory" "$cpus" "${caps[@]+"${caps[@]}"}"
    success "Wrote ${target}"
    info "Its capabilities apply after you approve it on the next run ${DIM}(or cleat trust)${RESET}"
  else
    info "Skipped .cleat"
  fi
}

# Trim leading/trailing whitespace then a single leading '=' then whitespace, so a
# resource keyword accepts `memory 4g`, `memory=4g`, and `memory = 4g` (users mirror
# the file, which writes `memory = 8g`). Echoes the bare value.
_config_kw_value() {
  local rest="$1"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  rest="${rest#=}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  rest="${rest%"${rest##*[![:space:]]}"}"
  echo "$rest"
}

_config_picker_text() {
  local config_file="$1"
  local scope="$2"
  local project="${3:-}"

  echo ""
  echo -e "  ${BOLD}Cleat config${RESET} ${DIM}(capabilities + resources)${RESET}"
  echo ""
  local scope_label
  if [[ "$scope" == "project" ]]; then
    scope_label="project (${config_file})"
  else
    scope_label="global (${config_file})"
  fi
  echo -e "  ${DIM}Scope: ${scope_label}${RESET}"
  echo ""

  local _active="" cap
  while IFS= read -r cap; do
    [[ -n "$cap" ]] && _active="${_active:+${_active},}${cap}"
  done < <(_read_caps_from_file "$config_file")

  local mem cpus _pair vm_gb
  _pair="$(_config_load_resource "$config_file" memory default)"; mem="${_pair%%$'\t'*}"
  _pair="$(_config_load_resource "$config_file" cpus all)"; cpus="${_pair%%$'\t'*}"
  # Text mode types a value instead of cycling a ring, so it can name any size
  # at all. It therefore needs the VM size just as much as the TUI does, or a
  # piped `memory 64g` saves a whole-VM ceiling in silence.
  vm_gb="$(_config_vm_gb)"

  local show_gen=0 gen_on=0
  [[ "$scope" == "global" && -n "$project" ]] && show_gen=1
  if [[ "$scope" == "project" ]]; then
    echo -e "  ${DIM}A project .cleat caps memory at ${_PROJECT_MEM_CAP_GB} GB. Raise it in the global config.${RESET}"
  fi

  for cap in "${KNOWN_CAPS[@]}"; do
    local marker="${DIM}·${RESET}"
    case ",${_active}," in *,"$cap",*) marker="${GREEN}✔${RESET}" ;; esac
    echo -e "    [${marker}] ${BOLD}${cap}${RESET}     $(_cap_description "$cap")"
  done
  echo ""
  echo -e "  ${DIM}Resources: memory=${mem}  cpus=${cpus}${RESET}"

  echo ""
  echo -e "  ${DIM}Capabilities: type a name to flip. Resources: \"memory 4g\", \"cpus 2\"${RESET}"
  if [[ "$show_gen" == "1" ]]; then
    echo -e "  ${DIM}\"project\" writes ./.cleat too. \"done\" to save, \"q\" to cancel${RESET}"
  else
    echo -e "  ${DIM}\"done\" to save, \"q\" to cancel${RESET}"
  fi

  while true; do
    echo -n "  > "
    local input
    read -r input || { echo ""; info "Cancelled."; return 0; }
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"

    case "$input" in
      done)
        _config_editor_save "$config_file" "$scope" "$project" "$_active" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb"
        return
        ;;
      q|quit)
        info "Cancelled."
        return
        ;;
      memory|memory[!a-zA-Z0-9]*)
        local _v; _v="$(_config_kw_value "${input#memory}")"
        case "$_v" in
          ""|default) mem="default"; success "memory set to default" ;;
          *)
            if _valid_memory_value "$_v"; then
              mem="$_v"; success "memory set to ${_v}"
            else
              warn "Not a memory value: ${BOLD}${_v}${RESET} ${DIM}(use e.g. 4g, 4096m, or \"default\")${RESET}"
            fi ;;
        esac
        ;;
      cpus|cpus[!a-zA-Z0-9]*)
        local _v; _v="$(_config_kw_value "${input#cpus}")"
        case "$_v" in
          ""|all) cpus="all"; success "cpus set to all (no cap)" ;;
          *)
            if _valid_cpus_value "$_v"; then
              cpus="$_v"; success "cpus set to ${_v}"
            else
              warn "Not a cpus value: ${BOLD}${_v}${RESET} ${DIM}(use e.g. 2, 1.5, or \"all\")${RESET}"
            fi ;;
        esac
        ;;
      project|generate)
        if [[ "$show_gen" == "1" ]]; then
          [[ "$gen_on" == "1" ]] && gen_on=0 || gen_on=1
          [[ "$gen_on" == "1" ]] && success "will also write ./.cleat" || info "will not write ./.cleat"
        else
          warn "\"project\" only applies to the global config ${DIM}(project scope already writes .cleat)${RESET}"
        fi
        ;;
      *)
        local found=false known
        for known in "${KNOWN_CAPS[@]}"; do
          if [[ "$known" == "$input" ]]; then
            found=true
            case ",${_active}," in
              *,"$input",*)
                local _new_active="" _c
                for _c in $(echo "$_active" | tr ',' ' '); do
                  [[ "$_c" == "$input" ]] && continue
                  _new_active="${_new_active:+${_new_active},}${_c}"
                done
                _active="$_new_active"
                success "${input} disabled"
                ;;
              *)
                _active="${_active:+${_active},}${input}"
                success "${input} enabled"
                ;;
            esac
            break
          fi
        done
        if ! $found; then
          warn "Unknown capability: ${input}. Available: ${KNOWN_CAPS[*]}"
        fi
        ;;
    esac
  done
}

cmd_config() {
  local scope="global"
  local action=""
  local cap_name=""
  local box=""
  # `__MISSING__` distinguishes "flag with no value token" (an error) from an
  # explicit empty value (`--memory ""` / `--memory default`), which CLEARS the key.
  local res_key="" res_val="__MISSING__"

  # Parse config subcommand flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)  scope="project"; shift ;;
      --enable)
        action="enable"
        if [[ $# -lt 2 ]]; then cap_name=""; shift; else cap_name="$2"; shift 2; fi
        ;;
      --disable)
        action="disable"
        if [[ $# -lt 2 ]]; then cap_name=""; shift; else cap_name="$2"; shift 2; fi
        ;;
      --memory)
        action="resource"; res_key="memory"
        if [[ $# -lt 2 ]]; then res_val="__MISSING__"; shift; else res_val="$2"; shift 2; fi
        ;;
      --cpus)
        action="resource"; res_key="cpus"
        if [[ $# -lt 2 ]]; then res_val="__MISSING__"; shift; else res_val="$2"; shift 2; fi
        ;;
      --list)     action="list"; shift ;;
      --*)
        error "Unknown config option: $1"
        exit 1
        ;;
      *)
        # A bareword positional is a box name → operate on that box's project
        # cap file (.cleat.<box>). "main" maps to the base .cleat.
        if [[ -n "$box" ]]; then
          error "Unexpected argument: ${BOLD}$1${RESET}"
          exit 1
        fi
        if ! _validate_box_name "$1"; then
          error "Invalid box name: ${BOLD}$1${RESET}"
          echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
          exit 1
        fi
        box="$1"; scope="project"; shift
        ;;
    esac
  done

  # pwd resolved ONCE so the scope label, the config target, and any generated
  # ./.cleat all agree (matches the historical `$(pwd)/.cleat` behavior).
  local project; project="$(pwd)"
  local config_file
  if [[ -n "$box" && "$box" != "main" ]]; then
    config_file="${project}/.cleat.$box"
  elif [[ "$scope" == "project" ]]; then
    config_file="${project}/.cleat"
  else
    config_file="$CLEAT_GLOBAL_CONFIG"
  fi

  # ── Direct mode: --list
  if [[ "$action" == "list" ]]; then
    echo ""
    echo -e "  ${BOLD}Capabilities${RESET}"
    echo ""
    # Read current caps
    local _active_list=""
    local cap
    while IFS= read -r cap; do
      [[ -n "$cap" ]] && _active_list="${_active_list:+${_active_list},}${cap}"
    done < <(_read_caps_from_file "$CLEAT_GLOBAL_CONFIG")
    # Also read project caps if available (box-aware: .cleat.<box> else .cleat)
    local _proj_caps_file
    _proj_caps_file="$(_project_caps_file "$project" "${box:-main}")"
    if [[ -f "$_proj_caps_file" ]]; then
      while IFS= read -r cap; do
        [[ -n "$cap" ]] && case ",${_active_list}," in *,"$cap",*) ;; *) _active_list="${_active_list:+${_active_list},}${cap}" ;; esac
      done < <(_read_caps_from_file "$_proj_caps_file")
    fi

    for cap in "${KNOWN_CAPS[@]}"; do
      local marker="${DIM}·${RESET}"
      case ",${_active_list}," in *,"$cap",*) marker="${GREEN}✔${RESET}" ;; esac
      echo -e "    [${marker}] ${BOLD}${cap}${RESET}  ${DIM}$(_cap_description "$cap")${RESET}"
    done
    echo ""
    # Resources declared in THIS scope's file (empty reads as the effective default).
    # `|| true` keeps a strict-mode caller safe on a bare command-substitution assign.
    local _lm _lc
    _lm="$(_read_resource_from_file "$config_file" memory || true)"
    _lc="$(_read_resource_from_file "$config_file" cpus || true)"
    echo -e "  ${BOLD}Resources${RESET}"
    if [[ -n "$_lm" ]]; then echo -e "    memory  ${_lm}"; else echo -e "    memory  ${DIM}default${RESET}"; fi
    if [[ -n "$_lc" ]]; then echo -e "    cpus    ${_lc}"; else echo -e "    cpus    ${DIM}all (no cap)${RESET}"; fi
    echo ""
    echo -e "  ${DIM}Config: ${config_file}${RESET}"
    echo ""
    return
  fi

  # ── Direct mode: --memory / --cpus
  if [[ "$action" == "resource" ]]; then
    if [[ "$res_val" == "__MISSING__" ]]; then
      error "Missing value. Usage: cleat config --${res_key} <value>"
      echo -e "    ${DIM}Clear it with: cleat config --${res_key} default${RESET}"
      exit 1
    fi
    # Sentinels and empty clear the key; anything else must validate.
    local write_val="$res_val"
    case "$res_val" in ""|default|all) write_val="" ;; esac
    if [[ -n "$write_val" ]]; then
      if [[ "$res_key" == "memory" ]] && ! _valid_memory_value "$write_val"; then
        error "Invalid memory value: ${BOLD}${write_val}${RESET} ${DIM}(use e.g. 2g, 4096m)${RESET}"; exit 1
      fi
      if [[ "$res_key" == "cpus" ]] && ! _valid_cpus_value "$write_val"; then
        error "Invalid cpus value: ${BOLD}${write_val}${RESET} ${DIM}(use e.g. 2, 1.5)${RESET}"; exit 1
      fi
    fi
    # Preserve the OTHER key: read both, replace the one being set, write both.
    local cur_mem cur_cpus
    cur_mem="$(_read_resource_from_file "$config_file" memory || true)"
    cur_cpus="$(_read_resource_from_file "$config_file" cpus || true)"
    if [[ "$res_key" == "memory" ]]; then cur_mem="$write_val"; else cur_cpus="$write_val"; fi
    _write_resources_to_file "$config_file" "$cur_mem" "$cur_cpus"
    if [[ -n "$write_val" ]]; then
      success "${res_key} set to ${write_val} ${DIM}(${config_file})${RESET}"
    else
      success "${res_key} cleared, using default ${DIM}(${config_file})${RESET}"
    fi
    # Direct mode skips the picker, so the same truths are printed here: a
    # project value above the clamp, a ceiling that reaches the whole VM, or a
    # core count this daemon would reject.
    if [[ -n "$write_val" && "$res_key" == "memory" ]]; then
      if [[ "$scope" == "project" ]] && (( $(_mem_to_bytes "$write_val") > 8589934592 )); then
        warn "A project .cleat caps memory at ${_PROJECT_MEM_CAP_GB} GB. The box will run at ${_PROJECT_MEM_CAP_GB}g."
        echo -e "    ${DIM}Set a larger ceiling in the global config instead: ${RESET}${BOLD}cleat config --memory ${write_val}${RESET}"
      else
        _config_mem_warn_block "$write_val" "$(_config_vm_gb)"
      fi
    fi
    if [[ -n "$write_val" && "$res_key" == "cpus" ]]; then
      local _ncpu; _ncpu="$(_daemon_ncpu)"
      if [[ "$_ncpu" =~ ^[0-9]+$ ]] && (( _ncpu > 0 )) && \
         awk -v v="$write_val" -v n="$_ncpu" 'BEGIN { exit !(v > n) }'; then
        warn "This Docker reports ${_ncpu} cores. Docker rejects a --cpus above that."
        echo -e "    ${DIM}The box will run at ${_ncpu} cores from a project .cleat, or fail to start from the global config.${RESET}"
      fi
    fi
    return
  fi

  # ── Direct mode: --enable / --disable
  if [[ -n "$action" ]]; then
    if [[ -z "$cap_name" ]]; then
      error "Missing capability name. Usage: cleat config --${action} <name>"
      exit 1
    fi

    # Validate capability name
    local valid=false
    for known in "${KNOWN_CAPS[@]}"; do
      [[ "$known" == "$cap_name" ]] && valid=true
    done
    if ! $valid; then
      error "Unknown capability: ${BOLD}${cap_name}${RESET}"
      echo -e "    ${DIM}Available: ${KNOWN_CAPS[*]}${RESET}"
      exit 1
    fi

    # Read current caps
    local current_caps=()
    while IFS= read -r cap; do
      [[ -n "$cap" ]] && current_caps+=("$cap")
    done < <(_read_caps_from_file "$config_file")

    if [[ "$action" == "enable" ]]; then
      # Check if already enabled
      local already=false
      for cap in "${current_caps[@]+"${current_caps[@]}"}"; do
        [[ "$cap" == "$cap_name" ]] && already=true
      done
      if ! $already; then
        current_caps+=("$cap_name")
      fi
      _write_caps_to_file "$config_file" "${current_caps[@]}"
      success "${cap_name} enabled"
      echo -e "    ${DIM}$(_cap_description "$cap_name")${RESET}"

      # Scaffold .cleat.env when enabling env capability
      if [[ "$cap_name" == "env" ]]; then
        _scaffold_cleat_env "$project"
      fi
    else
      # Disable: remove from list
      local new_caps=()
      for cap in "${current_caps[@]+"${current_caps[@]}"}"; do
        [[ "$cap" != "$cap_name" ]] && new_caps+=("$cap")
      done
      _write_caps_to_file "$config_file" "${new_caps[@]+"${new_caps[@]}"}"
      success "${cap_name} disabled"
    fi
    return
  fi

  # ── Interactive mode (no flags)
  if [[ -t 0 ]] && [[ -t 1 ]]; then
    _config_picker_tui "$config_file" "$scope" "$project"
  else
    _config_picker_text "$config_file" "$scope" "$project"
  fi
}

# ── Workspace trust subcommands ────────────────────────────────────────────
#
# `cleat trust [path] [box]`   : record approval for a project's .cleat (or a
#                                box's .cleat.<box>) caps and [setup]
# `cleat trust --list`         : list all trusted projects and boxes
# `cleat untrust [path] [box]` : remove approval for a project (or a box)
#
# Normally users will be prompted automatically on first run. These
# subcommands exist for scripting, manual approval, and inspection.

# Resolve the (project, box) a trust/untrust verb targets from its
# positionals. Prints "<project><TAB><box>" on stdout for the caller to split;
# ALL diagnostics go to stderr (this runs inside $(...)) and a bad target
# returns 1 so the caller can `|| exit 1`.
#
# Grammar, backward compatible with the historical lone-[path] form:
#   (none)          current dir, main box
#   <box>           current dir, that box   (a lone valid box name, no '/')
#   <path>          that path, main box     (a token containing '/')
#   <path> <box>    that path, that box     (path first, then box)
#
# Whether the one-arg token is a box or a path is decided PURELY by syntax: a
# token containing '/' is a path, otherwise a valid box name is that box. This
# is deliberately NOT a filesystem check (`-d`): a `-d` test would be
# time-dependent, so `cleat trust web` could record box "web" today and
# `cleat untrust web` could silently resolve to the ./web directory tomorrow
# (once a build created it) and fail to revoke the box, leaving a stale
# approval live. Syntax-only keeps trust and untrust symmetric. To trust the
# project in a bare-named subdirectory, give it a path shape: `cleat trust
# ./web` or `cleat trust . web` for that subdir's box.
_trust_target() {
  local proj box="main" a1="${1:-}" n=$#
  if [[ $n -gt 2 ]]; then
    error "Unexpected argument: ${BOLD}${3:-}${RESET}" >&2
    echo -e "    ${DIM}Usage: cleat trust [path] [box]${RESET}" >&2
    return 1
  fi
  if [[ $n -eq 2 ]]; then
    proj="$(resolve_project "$a1")"
    box="$2"
  elif [[ $n -eq 1 ]]; then
    if [[ "$a1" == */* ]]; then
      proj="$(resolve_project "$a1")"
    elif _validate_box_name "$a1"; then
      proj="$(resolve_project "")"
      box="$a1"
    else
      # Neither a path shape nor a valid box name: treat as a path so the
      # caller's "no .cleat file" error still names what the user typed.
      proj="$(resolve_project "$a1")"
    fi
  else
    proj="$(resolve_project "")"
  fi
  if [[ "$box" != "main" ]] && ! _validate_box_name "$box"; then
    error "Invalid box name: ${BOLD}${box}${RESET}" >&2
    echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}" >&2
    return 1
  fi
  # Mirror _trust_record's control-char refusal here, before the tab-delimited
  # print: a project path with an embedded tab/newline/CR would otherwise split
  # wrong in the caller and slip past that guard (it only sees the truncated
  # project column).
  case "$proj" in
    *$'\t'*|*$'\n'*|*$'\r'*)
      error "Refusing to trust a project path containing control characters" >&2
      return 1 ;;
  esac
  printf '%s\t%s\n' "$proj" "$box"
}

cmd_trust() {
  # Flag parsing
  local list_mode=0
  local -a pos_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list) list_mode=1; shift ;;
      --help|-h)
        echo "Usage: cleat trust [path] [box]   Record trust for a project's .cleat"
        echo "       cleat trust [box]           Trust a box of the current project"
        echo "       cleat trust --list          List all trusted projects and boxes"
        return 0 ;;
      *) pos_args+=("$1"); shift ;;
    esac
  done

  if [[ $list_mode -eq 1 ]]; then
    if [[ ! -f "$CLEAT_TRUST_FILE" ]]; then
      info "No trusted projects."
      return 0
    fi
    local count
    count="$(_trust_list | wc -l | tr -d ' ')"
    if [[ "$count" -eq 0 ]]; then
      info "No trusted projects."
      return 0
    fi
    echo -e "  ${BOLD}Trusted projects${RESET} ${DIM}(${count})${RESET}"
    echo ""
    _trust_list | while IFS=$'\t' read -r p b; do
      [[ -z "$p" ]] && continue
      [[ -z "$b" ]] && b="main"
      local marker="${GREEN}●${RESET}"
      # Indicate if the box's cap file has changed since approval
      local _cf _stored _cur
      _cf="$(_project_caps_file "$p" "$b")"
      _stored="$(_trust_lookup "$p" "$b")"
      _cur="$(_hash_cleat_caps "$_cf")"
      if [[ -f "$_cf" && -n "$_cur" && "$_stored" != "$_cur" ]]; then
        marker="${YELLOW}●${RESET}"
      fi
      if [[ "$b" == "main" ]]; then
        echo -e "    ${marker} ${p}"
      else
        echo -e "    ${marker} ${p}  ${DIM}[${b}]${RESET}"
      fi
    done
    echo ""
    echo -e "  ${DIM}${GREEN}●${DIM} trusted at current caps   ${YELLOW}●${DIM} .cleat changed since approval${RESET}"
    return 0
  fi

  # Record trust for a specific (project, box). Default: current dir, main box.
  local _t project box
  _t="$(_trust_target "${pos_args[@]+"${pos_args[@]}"}")" || exit 1
  project="${_t%%$'\t'*}"
  box="${_t#*$'\t'}"
  _BOX="$box"
  # A named box uses .cleat.<box> when present, else falls back to .cleat: the
  # same file resolve_caps would prompt for at `cleat run <box>`, so trusting
  # here records the byte-identical trust row (see _project_caps_file).
  local caps_file caps_base
  caps_file="$(_project_caps_file "$project" "$box")"
  caps_base="$(basename "$caps_file")"
  if [[ ! -f "$caps_file" ]]; then
    error "No ${caps_base} file found in ${BOLD}${project}${RESET}"
    echo -e "    ${DIM}Nothing to trust. This box has no capability config.${RESET}"
    exit 1
  fi
  local hash
  hash="$(_hash_cleat_caps "$caps_file")"
  # An explicit `cleat trust` approves the whole file the user is looking
  # at: caps and [setup] both, separate consent classes (concept/16). A
  # caps-less file with a [setup] section is still approvable: setup trust
  # records as a 4th trust-file column, "-" standing in for the caps hash.
  local setup_payload setup_rc=0
  setup_payload="$(_build_setup_payload "$project" "$box")" || setup_rc=$?
  if [[ $setup_rc -ne 0 ]]; then
    # _build_setup_payload already warned about the specific bad directive.
    warn "Project [setup] is invalid, not approved ${DIM}(see the warning above)${RESET}"
    setup_payload=""
  fi
  if [[ -z "$hash" && -z "$setup_payload" ]]; then
    error "Project ${caps_base} has no capabilities or setup commands to trust"
    exit 1
  fi
  local setup_hash="" setup_count=""
  if [[ -n "$setup_payload" ]]; then
    setup_hash="$(_setup_payload_hash "$setup_payload")"
    setup_count="$(_read_setup_from_file "$caps_file" | wc -l | tr -d ' ')"
    _trust_record "$project" "$hash" "$box" "$setup_hash" || exit 1
  elif ! _trust_record "$project" "$hash" "$box"; then
    exit 1
  fi
  if [[ "$box" == "main" ]]; then
    success "Trusted ${BOLD}${project}${RESET}"
  else
    success "Trusted ${BOLD}${project}${RESET} ${DIM}[${box}]${RESET}"
  fi
  if [[ -n "$hash" ]]; then
    local caps
    caps="$(_read_caps_from_file "$caps_file" | _canonical_caps)"
    echo -e "    ${DIM}Approved caps: $(_sanitize_repo_str "$caps")${RESET}"
  fi
  if [[ -n "$setup_payload" ]]; then
    echo -e "    ${DIM}Approved setup: ${setup_count} command(s)${RESET}"
  fi
}

cmd_untrust() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat untrust [path] [box]   Remove trust for a project"
      echo "       cleat untrust [box]           Untrust a box of the current project"
      return 0 ;;
  esac
  local -a pos_args=()
  while [[ $# -gt 0 ]]; do pos_args+=("$1"); shift; done
  local _t project box
  _t="$(_trust_target "${pos_args[@]+"${pos_args[@]}"}")" || exit 1
  project="${_t%%$'\t'*}"
  box="${_t#*$'\t'}"
  _BOX="$box"
  # A trust row (any column) counts as trusted: a setup-only row has "-" in the
  # caps column, which _trust_lookup returns non-empty, so it's detected here.
  local had
  had="$(_trust_lookup "$project" "$box")"
  _trust_remove "$project" "$box"
  local suffix=""
  [[ "$box" != "main" ]] && suffix=" ${DIM}[${box}]${RESET}"
  if [[ -n "$had" ]]; then
    success "Removed trust for ${BOLD}${project}${RESET}${suffix}"
  else
    info "${project}${suffix} was not trusted"
  fi
}

# ── Box descriptions ────────────────────────────────────────────────────────
#
# `cleat describe`             : show the main box's description
# `cleat describe <box>`       : show that box's description
# `cleat describe <box> text`  : set/update it (no docker calls; never recreates)
#
# The description is host-side metadata (see concept/20-boxes.md), so updating
# it never restarts or recreates the container: the writable layer (e.g. an
# `az login`) is untouched.
cmd_describe() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat describe [box] [text]"
      echo "       cleat describe <box>          Show a box's description"
      echo "       cleat describe <box> \"text\"   Set/update it (no container restart)"
      return 0 ;;
  esac

  local box="main"
  if [[ $# -gt 0 ]]; then
    if ! _validate_box_name "$1"; then
      error "Invalid box name: ${BOLD}$1${RESET}"
      echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
      exit 1
    fi
    box="$1"; shift
  fi

  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"

  if [[ $# -gt 0 ]]; then
    # Set/update: remaining args are the description, joined and stored as data.
    _box_desc_write "$cname" "$*"
    success "Description set for box ${BOLD}${box}${RESET}"
    # Print the description as DATA (%s), never through echo -e, which would
    # interpret backslash escapes / ANSI in user text. Colors use %b.
    printf '    %b%s%b\n' "$DIM" "$*" "$RESET"
  else
    local cur
    cur="$(_box_desc_read "$cname")"
    if [[ -n "$cur" ]]; then
      printf '  %b%s%b  %s\n' "$BOLD" "$box" "$RESET" "$cur"
    else
      info "No description set for box ${BOLD}${box}${RESET}."
      echo -e "    ${DIM}Set one with: cleat describe ${box} \"...\"${RESET}"
    fi
  fi
}

# `cleat kit`: enable/disable/inspect curated Claude pre-configurations per
# box. Two positionals (`kit <name> [box]`), so like `describe` it parses
# inside cmd_kit and never routes through _set_box (which rejects a second
# positional). Reserved words (off/list/show) resolve before the kit registry.
# See concept/34-kits.md.
cmd_kit() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat kit                       Interactive picker: kit, then models"
      echo "       cleat kit list                  Plain library + this project's selections"
      echo "       cleat kit <name> [box]          Enable a kit for a box (default: main)"
      echo "       cleat kit off [box]             Disable (back to your own config)"
      echo "       cleat kit show <name>           Print everything a kit injects"
      return 0 ;;
  esac

  local sub="${1:-}"
  # Bare `cleat kit` is interactive, exactly like bare `cleat config`: the
  # arrow-key TUI on a terminal, the typed text mode otherwise. The plain
  # listing stays available as `cleat kit list` (and for scripts).
  if [[ -z "$sub" ]]; then
    if [[ -t 0 ]] && [[ -t 1 ]]; then
      _kit_picker_tui
    else
      _kit_picker_text
    fi
    return 0
  fi
  if [[ "$sub" == "list" ]]; then
    _kit_print_library
    return 0
  fi
  shift

  case "$sub" in
    show)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        error "Usage: ${BOLD}cleat kit show <name>${RESET}"
        echo -e "    ${DIM}Available kits: ${KNOWN_KITS[*]}${RESET}"
        exit 1
      fi
      if ! _kit_known "$name"; then
        error "Unknown kit: ${BOLD}${name}${RESET}"
        echo -e "    ${DIM}Available kits: ${KNOWN_KITS[*]}${RESET}"
        exit 1
      fi
      _kit_show "$name"
      ;;
    off)
      _kit_disable "${1:-main}"
      ;;
    *)
      if ! _kit_known "$sub"; then
        error "Unknown kit: ${BOLD}${sub}${RESET}"
        echo -e "    ${DIM}Available kits: ${KNOWN_KITS[*]}${RESET}"
        echo -e "    ${DIM}Run ${BOLD}cleat kit${RESET}${DIM} for descriptions.${RESET}"
        exit 1
      fi
      _kit_enable "$sub" "${1:-main}"
      ;;
  esac
}

_kit_require_box() {
  if ! _validate_box_name "$1"; then
    error "Invalid box name: ${BOLD}$1${RESET}"
    echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
    exit 1
  fi
}

# Boxes created before the kit feature lack the mask mounts (bind mounts are
# baked at create): offer the rebuild instead of silently "enabling" a kit the
# box would ignore. Declining changes nothing. Shared by the direct grammar
# and the interactive picker. Returns 0 = continue to the normal apply,
# 1 = handled here (rebuild accepted or declined), caller stops either way.
_kit_prekit_offer() {
  local kit="$1" box="$2" cname="$3"
  if container_exists "$cname" && ! _container_has_kit_mounts "$cname"; then
    echo ""
    info "This box was created before kits existed and needs a rebuild to gain"
    echo -e "    the kit mount points. ${DIM}Your project, auth, and sessions are safe;${RESET}"
    echo -e "    ${DIM}ad-hoc installs inside the box are not.${RESET}"
    echo ""
    local yn=""
    _ask_yn yn "Rebuild now? [y/N] "
    if [[ "$yn" == [yY]* ]]; then
      docker rm -f "$cname" > /dev/null 2>&1 || true
      rm -rf "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
      _box_kit_write "$cname" "$kit"
      success "Kit ${BOLD}${kit}${RESET} enabled for box ${BOLD}${box}${RESET}."
      echo -e "    ${DIM}Next ${BOLD}cleat${RESET}${DIM} rebuilds the box with the kit active.${RESET}"
    else
      info "Kept as is. Nothing changed."
    fi
    return 1
  fi
  return 0
}

# Post-consent apply, shared by the direct grammar (after its [Y/n]) and the
# interactive picker (where selecting IS the consent): collision heads-up,
# selection write, in-place overlay refresh, success + next-session note.
_kit_apply() {
  local kit="$1" box="$2" cname="$3"

  # Collision heads-up, checked by agent NAME (what Claude dispatches by), not
  # filename: the overlay generation prefers a same-named user agent
  # (concept/34), so tell the user which agent Claude will actually use.
  # mktemp -d, not a predictable $$ path, so nothing can pre-plant the staging
  # tree on a shared host.
  local _ck_tmp _ck_f _kn
  _ck_tmp="$(mktemp -d "${TMPDIR:-/tmp}/cleat-kit-check.XXXXXX")" || _ck_tmp=""
  if [[ -n "$_ck_tmp" ]]; then
    # Names the user's agents already claim.
    local _un=" " _uf _unn
    if [[ -d "${HOME}/.claude/agents" ]]; then
      for _uf in "${HOME}/.claude/agents"/*; do
        [[ -f "$_uf" ]] || continue
        _unn="$(_agent_name "$_uf")"
        [[ -n "$_unn" ]] && _un="${_un}${_unn} "
      done
    fi
    _kit_emit "$kit" "$_ck_tmp"
    for _ck_f in "$_ck_tmp/agents"/*; do
      [[ -f "$_ck_f" ]] || continue
      _kn="$(_agent_name "$_ck_f")"
      if [[ -n "$_kn" && "$_un" == *" $_kn "* ]]; then
        warn "You already have an agent named ${BOLD}${_kn}${RESET}. Yours wins."
        echo -e "    ${DIM}The kit's ${_kn} is skipped, so dispatch to that name uses your agent.${RESET}"
        echo -e "    ${DIM}The kit's policy now steers your agent: its model and tools apply, not the kit's.${RESET}"
      fi
    done
    rm -rf "$_ck_tmp"
  fi

  _box_kit_write "$cname" "$kit"

  # Refresh the overlay now when the box already has the mounts (in-place, so
  # it lands even for a running box; a currently-attached session already read
  # its config, hence "next session").
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
  fi

  success "Kit ${BOLD}${kit}${RESET} enabled for box ${BOLD}${box}${RESET}."
  if container_exists "$cname" && _box_has_live_agent "$cname"; then
    echo -e "    ${DIM}A session is live in this box. The kit applies from the next session.${RESET}"
  else
    echo -e "    ${DIM}Takes effect next session: ${BOLD}cleat${RESET}"
  fi
  _kit_post_enable_hint "$kit"
}

_kit_enable() {
  local kit="$1" box="$2"
  _kit_require_box "$box"
  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"

  _kit_prekit_offer "$kit" "$box" "$cname" || return 0

  echo ""
  echo -e "  ${BOLD}Enable kit ${kit} for box ${box}?${RESET}"
  echo ""
  _kit_description "$kit" | fold -s -w 66 | sed 's/^/  /'
  echo ""
  _kit_reference_line "$kit"
  echo ""
  echo -e "  This kit adds, ${BOLD}inside the box only${RESET}:"
  _kit_confirm_lines "$kit"
  echo ""
  echo -e "  ${DIM}Your host ~/.claude and this repo are not touched.${RESET}"
  echo ""
  local yn=""
  _ask_yn yn "Enable? [Y/n] "
  if [[ -n "$yn" && "$yn" != [yY]* ]]; then
    info "Cancelled."
    return 0
  fi

  _kit_apply "$kit" "$box" "$cname"
}

_kit_disable() {
  local box="$1"
  _kit_require_box "$box"
  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"

  local cur
  cur="$(_box_kit_read "$cname")"
  if [[ -z "$cur" ]]; then
    info "No kit enabled for box ${BOLD}${box}${RESET}."
    return 0
  fi
  _box_kit_remove "$cname"
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
  fi
  # $cur comes from the hand-editable selection file: print it as data.
  printf '  %b✔ Kit %b%s%b disabled for box %b%s%b.%b\n' "$GREEN" "$BOLD" "$cur" "$RESET$GREEN" "$BOLD" "$box" "$RESET$GREEN" "$RESET"
  echo -e "    ${DIM}Back to your own config next session.${RESET}"
}

_kit_print_library() {
  local project base
  project="$(resolve_project)"
  base="$(container_name_for "$project" "main")"

  echo ""
  echo -e "  ${BOLD}Cleat Kits${RESET} ${DIM}(curated Claude pre-configurations, per box)${RESET}"
  echo ""
  local k
  for k in "${KNOWN_KITS[@]}"; do
    echo -e "  ${GREEN}${k}${RESET}"
    _kit_description "$k" | fold -s -w 62 | sed 's/^/    /'
  done

  # This project's current selections (any box).
  local _kf _bname _blabel _kname _shown=false
  if [[ -d "$CLEAT_KITS_DIR" ]]; then
    for _kf in "$CLEAT_KITS_DIR"/*; do
      [[ -f "$_kf" ]] || continue
      _bname="$(basename "$_kf")"
      case "$_bname" in
        "$base")   _blabel="main" ;;
        "$base"-*) _blabel="${_bname#${base}-}" ;;
        *) continue ;;
      esac
      _kname="$(cat "$_kf")"
      if ! $_shown; then
        echo ""
        echo -e "  ${DIM}This project:${RESET}"
        _shown=true
      fi
      # Selection files are hand-editable: print their content as data.
      printf '    %s: %b%s%b\n' "$_blabel" "$BLUE" "$_kname" "$RESET"
    done
  fi

  echo ""
  echo -e "  ${DIM}Enable:  ${BOLD}cleat kit <name> [box]${RESET}${DIM}    Disable: ${BOLD}cleat kit off [box]${RESET}"
  echo -e "  ${DIM}Inspect: ${BOLD}cleat kit show <name>${RESET}"
  echo -e "  ${DIM}Models:  set ${BOLD}worker_model${RESET}${DIM} / ${BOLD}scout_model${RESET}${DIM} under ${BOLD}[kits]${RESET}${DIM} in ~/.config/cleat/config${RESET}"
}

# Write the [kits] model overrides to a config file, preserving everything
# outside the [kits] section (same shape as _write_caps_to_file). Defaults are
# OMITTED so an untouched setup keeps a clean config: when both roles are the
# default alias, no [kits] section is written at all.
_write_kits_to_file() {
  local file="$1" worker="$2" scout="$3"
  mkdir -p "$(dirname "$file")"

  local preserved="" in_kits=false line
  if [[ -f "$file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      if [[ "$line" == "[kits]" ]]; then
        in_kits=true
        continue
      fi
      if $in_kits; then
        if [[ "$line" == "["*"]" ]]; then
          in_kits=false
          preserved+="$line"$'\n'
        fi
        continue
      fi
      preserved+="$line"$'\n'
    done < "$file"
  fi

  # Explicit ifs, never `[[ ]] && echo`: a false test as the block's last
  # list would make this function return 1 and kill the strict-mode caller
  # (found live: the text picker died silently on "done" with default models).
  {
    if [[ -n "$preserved" ]]; then
      printf '%s' "$preserved"
    fi
    if [[ "$worker" != "$_KIT_DEFAULT_MODEL" || "$scout" != "$_KIT_DEFAULT_MODEL" ]]; then
      echo "[kits]"
      if [[ "$worker" != "$_KIT_DEFAULT_MODEL" ]]; then
        echo "worker_model = $worker"
      fi
      if [[ "$scout" != "$_KIT_DEFAULT_MODEL" ]]; then
        echo "scout_model = $scout"
      fi
    fi
  } > "$file"
}

# Next model in the picker cycle for a role. The cycle is _KIT_MODEL_CHOICES;
# a custom value from a hand-edited config (a pinned ID like claude-sonnet-5)
# is kept reachable by cycling back to it after the last stock choice.
_kit_next_model() {
  local current="$1" custom="$2"
  local n=${#_KIT_MODEL_CHOICES[@]} i
  for ((i = 0; i < n; i++)); do
    if [[ "${_KIT_MODEL_CHOICES[$i]}" == "$current" ]]; then
      if [[ $((i + 1)) -lt $n ]]; then
        echo "${_KIT_MODEL_CHOICES[$((i + 1))]}"
      elif [[ -n "$custom" ]]; then
        echo "$custom"
      else
        echo "${_KIT_MODEL_CHOICES[0]}"
      fi
      return 0
    fi
  done
  # current IS the custom value (or unknown): wrap to the first stock choice.
  echo "${_KIT_MODEL_CHOICES[0]}"
}

# Previous model in the picker cycle: the exact reverse of _kit_next_model's
# ring (stock choices, then the custom pin if one exists).
_kit_prev_model() {
  local current="$1" custom="$2"
  local n=${#_KIT_MODEL_CHOICES[@]} i
  for ((i = 0; i < n; i++)); do
    if [[ "${_KIT_MODEL_CHOICES[$i]}" == "$current" ]]; then
      if [[ $i -gt 0 ]]; then
        echo "${_KIT_MODEL_CHOICES[$((i - 1))]}"
      elif [[ -n "$custom" ]]; then
        echo "$custom"
      else
        echo "${_KIT_MODEL_CHOICES[$((n - 1))]}"
      fi
      return 0
    fi
  done
  # current IS the custom value (or unknown): wrap to the last stock choice.
  echo "${_KIT_MODEL_CHOICES[$((n - 1))]}"
}

# ── Interactive kit picker (mirrors _config_picker_tui / _config_picker_text) ─

# Screen 1 rows: every known kit + "none". Radio marker on the current
# selection, cursor pointer like the caps picker.
_kit_picker_draw() {
  local cursor="$1" selected="$2"
  local rows=("${KNOWN_KITS[@]}" "none")
  local i=0 label marker
  while [[ $i -lt ${#rows[@]} ]]; do
    local row="${rows[$i]}"
    if [[ "$row" == "none" ]]; then
      label="none  ${DIM}(your own config, no kit)${RESET}"
      [[ -z "$selected" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
    else
      label="${BOLD}${row}${RESET}"
      [[ "$selected" == "$row" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
    fi
    printf '\033[2K'
    if [[ $i -eq $cursor ]]; then
      echo -e "  ${CYAN}▸${RESET} ${marker} ${label}"
    else
      echo -e "    ${marker} ${label}"
    fi
    i=$((i + 1))
  done
  # Detail pane: what the cursored kit actually is, so nobody has to enable
  # one to find out. Fixed height (_KIT_PANE_LINES) keeps the redraw math
  # constant; short content pads with cleared blanks.
  printf '\033[2K'
  echo ""
  local pane_text
  if [[ "${rows[$cursor]}" == "none" ]]; then
    pane_text="Your own Claude config, exactly as you set it up. Kits merge on top and never replace it; switch back here any time."
  else
    pane_text="$(_kit_description "${rows[$cursor]}")"
  fi
  local printed=0 line
  while IFS= read -r line; do
    [[ $printed -ge $_KIT_PANE_LINES ]] && break
    printf '\033[2K'
    echo -e "    ${DIM}${line}${RESET}"
    printed=$((printed + 1))
  done << PANE_EOF
$(echo "$pane_text" | fold -s -w 60)
PANE_EOF
  while [[ $printed -lt $_KIT_PANE_LINES ]]; do
    printf '\033[2K'
    echo ""
    printed=$((printed + 1))
  done
}

# Screen 2 rows: worker + scout with their effective models.
_kit_models_draw() {
  local cursor="$1" worker="$2" scout="$3"
  # Chevrons on the active row advertise that ←/→ cycles the model.
  printf '\033[2K'
  if [[ $cursor -eq 0 ]]; then
    echo -e "  ${CYAN}▸${RESET} worker  ${BOLD}‹ ${worker} ›${RESET}  ${DIM}(executes implementation chunks)${RESET}"
  else
    echo -e "    worker  ${worker}  ${DIM}(executes implementation chunks)${RESET}"
  fi
  printf '\033[2K'
  if [[ $cursor -eq 1 ]]; then
    echo -e "  ${CYAN}▸${RESET} scout   ${BOLD}‹ ${scout} ›${RESET}  ${DIM}(read-only exploration)${RESET}"
  else
    echo -e "    scout   ${scout}  ${DIM}(read-only exploration)${RESET}"
  fi
}

# Screen 2: pick the models, save on ⏎ (writes [kits] to the GLOBAL config,
# then applies the kit to the box). q/ESC cancels with nothing written.
_kit_models_tui() {
  local kit="$1" box="$2" cname="$3"
  local worker scout worker_custom="" scout_custom=""
  worker="$(_kit_agent_model worker "$_KIT_DEFAULT_MODEL")"
  scout="$(_kit_agent_model scout "$_KIT_DEFAULT_MODEL")"
  # A hand-pinned custom ID stays reachable in the cycle.
  case " ${_KIT_MODEL_CHOICES[*]} " in
    *" $worker "*) ;;
    *) worker_custom="$worker" ;;
  esac
  case " ${_KIT_MODEL_CHOICES[*]} " in
    *" $scout "*) ;;
    *) scout_custom="$scout" ;;
  esac

  echo ""
  echo -e "  ${BOLD}Kit ${kit}${RESET} ${DIM}· agent models (global, all kitted boxes)${RESET}"
  echo -e "  ${DIM}planner = your session's model, not changed by the kit${RESET}"
  echo ""

  local cursor=0
  tput civis 2>/dev/null || true
  _kit_models_draw "$cursor" "$worker" "$scout"
  echo ""
  echo -e "  ${DIM}↑/↓ navigate  ←/→ change model  ⏎ enable kit  q cancel${RESET}"
  printf '\033[%dA' 4

  while true; do
    local key
    key="$(_read_keypress)"
    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=0 ;;
      DOWN) [[ $cursor -lt 1 ]] && cursor=1 ;;
      RIGHT|SPACE)
        if [[ $cursor -eq 0 ]]; then
          worker="$(_kit_next_model "$worker" "$worker_custom")"
        else
          scout="$(_kit_next_model "$scout" "$scout_custom")"
        fi
        ;;
      LEFT)
        if [[ $cursor -eq 0 ]]; then
          worker="$(_kit_prev_model "$worker" "$worker_custom")"
        else
          scout="$(_kit_prev_model "$scout" "$scout_custom")"
        fi
        ;;
      ENTER)
        tput cnorm 2>/dev/null || true
        printf '\033[%dB' 4
        printf '\033[2K'
        echo ""
        _write_kits_to_file "$CLEAT_GLOBAL_CONFIG" "$worker" "$scout"
        _kit_apply "$kit" "$box" "$cname"
        return 0
        ;;
      QUIT|ESC)
        tput cnorm 2>/dev/null || true
        printf '\033[%dB' 4
        printf '\033[2K'
        echo ""
        info "Cancelled."
        return 0
        ;;
    esac
    _kit_models_draw "$cursor" "$worker" "$scout"
    printf '\033[%dA' 2
  done
}

# Screen 1: pick a kit (or none) for the default box, then fall through to
# the models screen. ⏎ selects, q/ESC cancels.
_kit_picker_tui() {
  local box="main" project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"
  local selected
  selected="$(_box_kit_read "$cname")"

  echo ""
  echo -e "  ${BOLD}Cleat Kits${RESET} ${DIM}(curated Claude pre-configurations)${RESET}"
  echo -e "  ${DIM}Box: ${box} ${DIM}· other boxes: ${BOLD}cleat kit <name> <box>${RESET}"
  echo ""

  local rows=$(( ${#KNOWN_KITS[@]} + 1 ))
  # The redraw block is the rows plus the detail pane (and its separator).
  local block=$(( rows + 1 + _KIT_PANE_LINES ))
  local cursor=0
  tput civis 2>/dev/null || true
  _kit_picker_draw "$cursor" "$selected"
  echo ""
  echo -e "  ${DIM}↑/↓ navigate  ⏎/→ select  q cancel${RESET}"
  printf '\033[%dA' "$((block + 2))"

  while true; do
    local key
    key="$(_read_keypress)"
    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=$((cursor - 1)) ;;
      DOWN) [[ $cursor -lt $((rows - 1)) ]] && cursor=$((cursor + 1)) ;;
      ENTER|RIGHT)
        tput cnorm 2>/dev/null || true
        printf '\033[%dB' "$((block + 2))"
        printf '\033[2K'
        if [[ $cursor -eq $((rows - 1)) ]]; then
          echo ""
          _kit_disable "$box"
          return 0
        fi
        local kit="${KNOWN_KITS[$cursor]}"
        _kit_prekit_offer "$kit" "$box" "$cname" || return 0
        _kit_models_tui "$kit" "$box" "$cname"
        return 0
        ;;
      QUIT|ESC)
        tput cnorm 2>/dev/null || true
        printf '\033[%dB' "$((block + 2))"
        printf '\033[2K'
        echo ""
        info "Cancelled."
        return 0
        ;;
    esac
    _kit_picker_draw "$cursor" "$selected"
    printf '\033[%dA' "$block"
  done
}

# Text-mode fallback for non-TTY (mirrors _config_picker_text): type a kit
# name (or "none"), worker=<model> / scout=<model>, "done" to save + enable,
# "q" to cancel. EOF cancels.
_kit_picker_text() {
  local box="main" project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"
  local selected worker scout
  selected="$(_box_kit_read "$cname")"
  worker="$(_kit_agent_model worker "$_KIT_DEFAULT_MODEL")"
  scout="$(_kit_agent_model scout "$_KIT_DEFAULT_MODEL")"

  echo ""
  echo -e "  ${BOLD}Cleat Kits${RESET} ${DIM}(box: ${box})${RESET}"
  echo ""
  local k marker
  for k in "${KNOWN_KITS[@]}"; do
    [[ "$selected" == "$k" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
    echo -e "    ${marker} ${BOLD}${k}${RESET}"
    _kit_description "$k" | fold -s -w 60 | sed "s/^/      /" | while IFS= read -r _dl; do
      echo -e "${DIM}${_dl}${RESET}"
    done
  done
  [[ -z "$selected" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
  echo -e "    ${marker} none ${DIM}(your own config, no kit)${RESET}"
  echo ""
  echo -e "  ${DIM}models: worker=${worker} scout=${scout} (global, all kitted boxes; planner = your session's model)${RESET}"
  echo ""
  echo -e "  ${DIM}Select: a kit name or \"none\"; worker=<model> / scout=<model>;${RESET}"
  echo -e "  ${DIM}\"done\" to save, \"q\" to cancel${RESET}"

  local choice="$selected"
  while true; do
    echo -n "  > "
    local input
    read -r input || { echo ""; info "Cancelled."; return 0; }
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"

    case "$input" in
      done)
        _write_kits_to_file "$CLEAT_GLOBAL_CONFIG" "$worker" "$scout"
        if [[ -z "$choice" ]]; then
          if [[ -n "$selected" ]]; then
            _kit_disable "$box"
          else
            info "No kit enabled. Models saved."
          fi
        else
          _kit_prekit_offer "$choice" "$box" "$cname" || return 0
          _kit_apply "$choice" "$box" "$cname"
        fi
        return 0
        ;;
      q|Q)
        info "Cancelled."
        return 0
        ;;
      none)
        choice=""
        echo -e "    ${DIM}selection: none${RESET}"
        ;;
      worker=*|scout=*)
        local _role="${input%%=*}" _val="${input#*=}"
        if [[ -n "$_val" && "$_val" =~ ^[A-Za-z0-9._-]+$ ]]; then
          [[ "$_role" == "worker" ]] && worker="$_val" || scout="$_val"
          echo -e "    ${DIM}${_role} model: ${_val}${RESET}"
        else
          warn "Not a model token (letters, digits, '.', '_', '-'): ${BOLD}${_val}${RESET}"
        fi
        ;;
      *)
        if _kit_known "$input"; then
          choice="$input"
          echo -e "    ${DIM}selection: ${input}${RESET}"
        else
          warn "Unknown kit: ${BOLD}${input}${RESET} ${DIM}(available: ${KNOWN_KITS[*]}, or \"none\")${RESET}"
        fi
        ;;
    esac
  done
}

_kit_show() {
  local kit="$1"
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/cleat-kit-show.XXXXXX")" || { error "Could not create a temp dir."; return 1; }
  _kit_emit "$kit" "$tmp"
  echo ""
  echo -e "  ${BOLD}Kit: ${kit}${RESET}"
  echo ""
  _kit_description "$kit" | fold -s -w 66 | sed 's/^/  /'
  echo ""
  echo -e "  ${DIM}── CLAUDE.md fragment (appended after your own content) ──${RESET}"
  sed 's/^/  /' "$tmp/CLAUDE.md"
  local f
  for f in "$tmp/agents"/*; do
    [[ -f "$f" ]] || continue
    echo ""
    echo -e "  ${DIM}── agents/$(basename "$f") ──${RESET}"
    sed 's/^/  /' "$f"
  done
  rm -rf "$tmp"
  if [[ "$kit" == "plan-big-execute-small" ]]; then
    echo ""
    echo -e "  ${DIM}Adapted from Anthropic's coordinator-pattern cookbook:${RESET}"
    echo "  https://github.com/anthropics/claude-cookbooks/blob/main/managed_agents/CMA_plan_big_execute_small.ipynb"
    echo ""
    echo -e "  ${DIM}Verify it is routing: after a heavy session, /usage should show the${RESET}"
    echo -e "  ${DIM}bulk of tokens on the worker model. Only your session model there${RESET}"
    echo -e "  ${DIM}means delegation is not happening.${RESET}"
  fi
}

# `cleat setup [box] [--show]`: run a project's [setup] provisioning outside
# the normal session-start flow (see _maybe_run_setup), or inspect it without
# running anything. Box is a bareword positional exactly like cmd_config's,
# parsed alongside --show so either can come first.
cmd_setup() {
  local box="" show=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --show) show=1; shift ;;
      --help|-h)
        echo "Usage: cleat setup [box]           Run this project's [setup] provisioning now"
        echo "       cleat setup [box] --show     Preview the payload, trust & marker state"
        return 0 ;;
      --*)
        error "Unknown setup option: $1"
        exit 1 ;;
      *)
        if [[ -n "$box" ]]; then
          error "Unexpected argument: ${BOLD}$1${RESET}"
          exit 1
        fi
        if ! _validate_box_name "$1"; then
          error "Invalid box name: ${BOLD}$1${RESET}"
          echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
          exit 1
        fi
        box="$1"; shift
        ;;
    esac
  done
  _BOX="${box:-main}"
  box="$_BOX"

  local project cname caps_file
  project="$(resolve_project "")"
  cname="$(container_name_for "$project" "$box")"
  _RESOLVED_PROJECT="$project"
  caps_file="$(_project_caps_file "$project" "$box")"

  if [[ $show -eq 1 ]]; then
    # A pure inspection command: never prompts, never records trust.
    resolve_caps "$project" readonly
  else
    resolve_caps "$project"
  fi

  if [[ "${_SETUP_DECLARED:-0}" != "1" ]]; then
    # _SETUP_DECLARED stays 0 both when the section is absent and when a
    # `script` directive is invalid: tell those apart here so the explicit
    # verb doesn't claim "no section" over a broken one. --show resolves in
    # readonly mode, which silences the builder, so rebuild loudly here to
    # surface the specific directive error the user needs.
    if [[ -n "$(_read_setup_from_file "$caps_file")" ]]; then
      _build_setup_payload "$project" "$box" >/dev/null || true
      error "Project [setup] is invalid"
      exit 1
    fi
    info "No [setup] section in $(basename "$caps_file")"
    exit 0
  fi

  if [[ $show -eq 1 ]]; then
    # readonly resolve_caps leaves _SETUP_TRUSTED at 0 for unapproved
    # content, so trust state for display is derived directly from the
    # trust store, not the resolved-caps decision.
    local payload hash stored trust_state marker_state count
    payload="$(_build_setup_payload "$project" "$box")" || payload=""
    hash="$(_setup_payload_hash "$payload")"
    stored="$(_trust_lookup_setup "$project" "$box")"
    if [[ -n "$stored" && "$stored" == "$hash" ]]; then
      trust_state="approved"
    else
      trust_state="pending approval"
    fi
    if is_running "$cname"; then
      local marker
      marker="$(docker exec "$cname" cat /home/coder/.cleat-setup-applied 2>/dev/null || true)"
      if [[ "$marker" == "$hash" ]]; then
        marker_state="applied"
      else
        marker_state="not applied"
      fi
    else
      marker_state="unknown (box not running)"
    fi
    count="$(_read_setup_from_file "$caps_file" | wc -l | tr -d ' ')"

    echo ""
    echo -e "  ${BOLD}Source:${RESET}   ${caps_file}"
    echo -e "  ${BOLD}Commands:${RESET} ${count}"
    echo -e "  ${BOLD}Hash:${RESET}     ${hash}"
    echo -e "  ${BOLD}Trust:${RESET}    ${trust_state}"
    echo -e "  ${BOLD}Marker:${RESET}   ${marker_state}"
    echo ""
    if [[ -t 1 ]]; then
      local line
      while IFS= read -r line; do
        echo -e "  ${DIM}$(_sanitize_repo_str "$line")${RESET}"
      done <<< "$payload"
    else
      printf '%s\n' "$payload"
    fi
    exit 0
  fi

  # Run mode: the box must already be running (provisioning execs into it).
  require_running "$cname"

  if [[ "${_SETUP_TRUSTED:-0}" != "1" ]]; then
    error "Project [setup] is not approved"
    echo -e "    ${DIM}Re-run interactively to approve it, or set CLEAT_TRUST_SETUP=1 to approve non-interactively.${RESET}"
    exit 1
  fi

  _maybe_run_setup "$cname" "$project" "$box" 1
  exit "${_SETUP_LAST_RC:-0}"
}

# ── Version & Update ──────────────────────────────────────────────────────
cmd_version() {
  echo -e "  ${BOLD}cleat${RESET} ${DIM}v${VERSION}${RESET}"
}

cmd_update() {
  info "Checking for updates..."

  if [[ ! -d "$REPO_DIR/.git" ]]; then
    error "Cannot auto-update: not a git installation."
    echo -e "    ${DIM}Re-install with: curl -fsSL https://raw.githubusercontent.com/cleatdev/cleat/main/install.sh | bash${RESET}"
    exit 1
  fi

  git -C "$REPO_DIR" fetch --tags --force --quiet 2>/dev/null || {
    error "Failed to fetch updates. Check your internet connection."
    exit 1
  }

  local remote_version
  remote_version=$(latest_remote_tag)

  if [[ -z "$remote_version" ]]; then
    error "Could not determine remote version. No tags found."
    exit 1
  fi

  if [[ "$VERSION" == "$remote_version" ]]; then
    success "Already on the latest version (v${VERSION})."
    return
  fi

  info "Updating v${VERSION} -> v${remote_version}..."
  git -C "$REPO_DIR" checkout "v${remote_version}" --quiet 2>/dev/null || {
    error "Failed to checkout v${remote_version}."
    exit 1
  }
  success "Updated to v${remote_version}."

  rm -f "$UPDATE_CHECK_FILE" 2>/dev/null || true
  # The new release image bundles its own Claude Code, so invalidate the
  # Claude update-check cache to re-check against the fresh image next start.
  rm -f "$CLAUDE_CHECK_FILE" 2>/dev/null || true

  # Pull the prebuilt image matching the new version. _do_pull prints its own
  # progress/result; on failure the user can rebuild locally.
  if ! _do_pull "$remote_version"; then
    echo ""
    echo -e "  ${DIM}To update the container image locally:${RESET}"
    echo -e "    ${BOLD}cleat rebuild${RESET}"
  fi
  echo ""
}

