  echo -e "    ${GREEN}kit${RESET}                Interactive picker ${DIM}(pick a kit, then its models)${RESET}"
  echo -e "    ${GREEN}kit${RESET} ${DIM}list${RESET}           Plain library + this project's selections"
  echo -e "    ${GREEN}kit${RESET} ${DIM}<name> [box]${RESET}   Enable a kit ${DIM}(merges on top of your own config)${RESET}"
  echo -e "    ${GREEN}kit${RESET} ${DIM}off [box]${RESET}      Disable ${DIM}(back to your own config)${RESET}"
  echo -e "    ${GREEN}kit${RESET} ${DIM}show <name>${RESET}    Print everything a kit injects"
  echo ""
  echo -e "  ${BOLD}FORKS${RESET} ${DIM}(a box on its own copy of the project, so it cannot touch your tree)${RESET}"
  echo -e "    ${GREEN}fork${RESET} ${DIM}start [box]${RESET}    Create a fork box and launch Claude ${DIM}(= ${BOLD}start <box> --fork${RESET}${DIM})${RESET}"
  echo -e "    ${GREEN}fork${RESET} ${DIM}run [box]${RESET}      Create it without launching Claude"
  echo -e "    ${GREEN}fork${RESET}               List every workspace copy ${DIM}(size, age, whether its box is left)${RESET}"
  echo -e "    ${GREEN}fork${RESET} ${DIM}path [box]${RESET}     Print a copy's path ${DIM}(cd \"\$(cleat fork path feat-a)\")${RESET}"
  echo -e "    ${GREEN}fork${RESET} ${DIM}rm [box]${RESET}       Delete a copy and drop the fork marker"
  echo -e "    ${GREEN}fork${RESET} ${DIM}prune${RESET}          Delete copies whose container is gone"
  echo -e "    ${GREEN}fork${RESET} ${DIM}refresh [box]${RESET}  Re-copy from the live project ${DIM}(after changing [fork] exclude)${RESET}"
  echo ""
  echo -e "  ${BOLD}INTERACT${RESET}"
