#!/usr/bin/env bash
set -euo pipefail

# ── Config ──────────────────────────────────────────────────────────────────
VERSION="1.4.3"
# Gates the on-start release highlight (_maybe_show_release_highlight): must
# equal VERSION to fire. Bump it to the new VERSION at each tag so the
# maintainer-curated highlight re-surfaces for that release; a mismatch shows
# nothing (fail-safe). The highlight COPY and its version label are editorial,
# set by hand below, not derived from VERSION (a big feature stays highlighted
# across several releases, labelled with the version it shipped in).
RELEASE_HIGHLIGHT_VERSION="1.4.3"
# How many launches after an upgrade the highlight is shown before going quiet.
# Bounded repetition aids feature discovery (people miss it the first time)
# without training the eye to skip the startup block, where drift/update/security
# notices also live. See concept/21-on-start-notices.md.
RELEASE_HIGHLIGHT_MAX_SHOWS=3
IMAGE_NAME="cleat"
REGISTRY_BASE="ghcr.io/cleatdev/cleat"
REGISTRY_IMAGE="${REGISTRY_BASE}:v${VERSION}"
REPO_URL="https://github.com/cleatdev/cleat"

# Image content identity, DELIBERATELY decoupled from VERSION.
#
# The on-start rebuild prompt used to fire whenever the image's baked CLI
# version was older than this CLI, so a version-only release (no change under
# docker/) still nagged every user to re-pull and recreate their container,
# discarding its writable layer for nothing. ~Two-thirds of recent releases
# were version-only. This integer tracks the IMAGE CONTENT instead.
#
# Bump _IMAGE_SPEC_VERSION by one (1 -> 2 -> 3 ...) whenever anything that lands
# in the built image changes: docker/Dockerfile, docker/entrypoint.sh,
# docker/clip, docker/clip-daemon, docker/open-bridge, docker/CLAUDE.md, or a
# pinned base. A CLI-only release leaves it untouched and no one is nagged.
# It is stamped onto the image as the sh.cleat.image-spec label (by _do_build,
# cmd_rebuild, and the publish CI) and read back by _maybe_prompt_image_rebuild,
# which prompts only when the local image's spec is OLDER than this value.
#
# A unit test (test/unit/image_spec.bats) hashes the build inputs and FAILS if
# they change without this being bumped, so it can never be silently forgotten.
# See concept/24-image-spec-versioning.md.
#
# Spec history (what each value shipped):
#   1  initial scheme; floating node:24-bookworm-slim base
#   2  base image pinned by digest (reproducible base; see docker/Dockerfile)
#   3  ENV BROWSER=open shim, so Claude Code 2.1.191+ opens login URLs through
#      the bridge instead of dropping to the code-paste flow
#   4  entrypoint chowns the shell rc files and ~/.config after the UID remap,
#      so a [setup] payload can put a toolchain on PATH. Without it every host
#      whose UID is not 1000 (i.e. every macOS host) hit EACCES on ~/.bashrc,
#      ~/.profile and mkdir ~/.config/*, which aborts the payload under bash -e
_IMAGE_SPEC_VERSION=4
# Anchor for classifying PRE-STAMPING images (built before sh.cleat.image-spec
# existed, so they carry no spec label): their content is inferred from the
# version they were built at. v0.16.3 was the LAST docker/ content change before
# stamping, so a label-less image built at or after it carries that pre-pin,
# floating-base content == spec 1; an older label-less image predates even that
# and is treated as spec 0. Both are then compared against _IMAGE_SPEC_VERSION,
# so on the release that introduces this scheme (spec 2, pinned base) a label-less
# spec-1 image is correctly offered the one-time refresh to the pinned base. This
# anchor never moves: every image built from the stamping release on carries an
# explicit label, so the inference path only ever sees genuinely pre-stamping
# images.
_IMAGE_SPEC_INTRO_VERSION="0.16.3"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# XDG-compliant config directory
CLEAT_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cleat"
CLEAT_GLOBAL_CONFIG="$CLEAT_CONFIG_DIR/config"
CLEAT_GLOBAL_ENV="$CLEAT_CONFIG_DIR/env"

# Per-container runtime state: the settings overlay, clipboard bridge, and hook
# event spool. Persistent (deliberately NOT under /tmp) so macOS file rotation
# and reboots can't delete a container's bind-mount sources out from under it and
# force a recreate (which would discard the container's writable layer, e.g. an
# ad-hoc `az` install). One dir per container:
#   $CLEAT_RUN_DIR/<cname>/{settings,clip,hooks,kit}
# settings and hooks are host-side state. clip and the kit masks ARE mounted in
# (kit/* read-only).
CLEAT_RUN_DIR="$CLEAT_CONFIG_DIR/run"
CLEAT_TRUST_FILE="$CLEAT_CONFIG_DIR/trust"
# Host-side per-box descriptions, keyed by container name. NOT Docker labels:
# labels are immutable, so editing one would force a recreate that wipes the
# writable layer (e.g. an `az login`). See concept/20-boxes.md.
CLEAT_BOXES_DIR="$CLEAT_CONFIG_DIR/boxes"
# Forked workspaces: one directory per fork box, a full copy of the project.
# Under $CLEAT_CONFIG_DIR so it is inside Docker's shared scope on macOS and
# normally on the same volume as the project, which is what lets APFS clone
# blocks copy-on-write instead of duplicating them.
CLEAT_FORKS_DIR="$CLEAT_CONFIG_DIR/forks"

# Host-side per-box kit selection, keyed by container name: one file per box
# holding the enabled kit's name. Same rationale as CLEAT_BOXES_DIR (not a
# Docker label: labels are immutable, editing one would force a recreate). A
# separate dir, not a suffixed file inside CLEAT_BOXES_DIR, so the description
# display globs never iterate a non-description file. See concept/34-kits.md.
CLEAT_KITS_DIR="$CLEAT_CONFIG_DIR/kits"

# Curated kit library (maintainer-authored, embedded as heredocs in _kit_emit;
# no cache, no network: the CLI release is the single source of truth). Order
# matters for display.
KNOWN_KITS=(plan-big-execute-small)
# Default model alias for kit agents (floats to the current Sonnet with the
# bundled Claude), and the cycle order the interactive picker offers.
_KIT_DEFAULT_MODEL="sonnet"
_KIT_MODEL_CHOICES=(sonnet haiku opus inherit)
# Fixed height of the kit picker's detail pane (kit description under the
# list). Fixed so the TUI redraw math stays constant per frame. Must hold
# the longest _kit_description folded at 60 columns.
_KIT_PANE_LINES=7

# Rows the `cleat session` list shows at once. It is the first SCROLLING list
# in this file: every other picker draws its whole list (9 rows at most), but a
# project accumulates sessions without bound (27 in the maintainer's own repo),
# and a block taller than the terminal loses its frame origin for good, because
# cursor-up never scrolls the screen back down. The draw always emits exactly
# this many rows, padding short pages with cleared blanks, so the redraw math
# stays a compile-time constant the way _KIT_PANE_LINES does.
_SESSIONS_PAGE_LINES=10

# Persistent per-project Claude global-state (.claude.json) store. Unlike
# $CLEAT_RUN_DIR (per-container, wiped on `cleat rm`/recreate), this is keyed by
# PROJECT and deliberately survives recreate so a project's trust/MCP approvals
# persist. One file per project: $CLEAT_PROJECTS_DIR/<project_session_key>/claude.json
CLEAT_PROJECTS_DIR="$CLEAT_CONFIG_DIR/projects"

# Known capabilities (order matters for display).
# Three behavioral categories. See _cap_category for the mapping:
#   mount   git, ssh, env, hooks, gh   auth/identity bind-mounts (no install)
#   sandbox docker                     mounts host docker socket (breaks isolation)
#   guard   unsafe-rm                  disables a Claude Code safety prompt in the box
# unsafe-rm is global/CLI only (never granted from a project .cleat): it disarms
# the delete-safety prompt for the very agent that could write .cleat. See
# resolve_caps and concept/42-unsafe-rm.md.
KNOWN_CAPS=(git ssh env hooks gh docker unsafe-rm)

# Session-scoped state (populated by parse_global_flags / cmd_run / cmd_resume)
_CLI_CAPS=()
_RESOLVED_PROJECT=""
# The active box: a named per-project sandbox (see concept/20-boxes.md).
# Default "main" = the legacy suffix-less container. Set by the dispatch via
# _set_box for box-aware verbs; stays "main" for everything else.
_BOX="main"
_FORK_REQUESTED=false   # set by --fork; only read when a box is CREATED
_FORK_PREFLIGHT_DONE="" # one preflight per process: start/resume run it, then cmd_run
_CLI_ENVS=()
_CLI_ENV_FILES=()
_CLI_TRUST_PROJECT=0
# Separate consent class from _CLI_TRUST_PROJECT: approving caps never
# approves [setup] provisioning and vice versa (concept/16).
_CLI_TRUST_SETUP=0
_CLI_DESC=""
_CLI_DESC_SET=0
# Original argv as `main` received it, used by the CLI self-update preflight to
# re-exec the freshly-installed version with the same command.
_CLEAT_ORIG_ARGV=()

# Caps display buckets (populated by _caps_bucket_active for _print_caps).
_CAPS_MOUNT=()
_CAPS_SANDBOX=()

# ── Colors & Formatting ────────────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
# Amber/orange for warnings, visually distinct from the neutral-yellow status
# markers. xterm-256 color 214 (~#ffaf00) approximates the site's warning orange
# rgb(245,158,11) and renders correctly everywhere 256-color is supported
# (Terminal.app, iTerm2, Linux terminals, VS Code), unlike 24-bit truecolor,
# which degrades to the default foreground on terminals that don't support it.
AMBER='\033[38;5;214m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
UNDERLINE='\033[4m'
RESET='\033[0m'

header() {
  echo ""
  echo -e "${BOLD}${CYAN}  ┌───────────────────────────────────────────┐${RESET}"
  echo -e "${BOLD}${CYAN}  │   Cleat                                   │${RESET}"
  echo -e "${BOLD}${CYAN}  │   Give the agent a cage, not your keys.   │${RESET}"
  echo -e "${BOLD}${CYAN}  │   Unattended, not unguarded.              │${RESET}"
  echo -e "${BOLD}${CYAN}  └───────────────────────────────────────────┘${RESET}"
  echo ""
}

info()    { echo -e "  ${BLUE}▸${RESET} $1"; }
success() { echo -e "  ${GREEN}✔ $1${RESET}"; }
warn()    { echo -e "  ${AMBER}!${RESET} $1"; }
# A sandbox-break warning: the whole line renders in the sandbox amber (marker
# AND message), so it reads as loud as the `docker` cap it warns about. Unlike
# generic warn(), which tints only the `!` marker and leaves the text default.
warn_sandbox() { echo -e "  ${AMBER}! $1${RESET}"; }
error()   { echo -e "  ${RED}✖${RESET} $1"; }

# Aligned interactive Y/n prompt that pairs with an info()/warn() headline.
# The headline owns the icon (▸/!); the question continues underneath it,
# indented to sit under the headline TEXT (4 spaces), not back at the margin.
# Reads one line into the named variable. TTY-gating is the caller's job.
#
# A `read` FAILURE (EOF: e.g. `cleat start </dev/null`, a wrapper that redirects
# stdin, a non-interactive pipe) yields "n", i.e. DECLINE, never an empty string.
# Callers treat empty as the [Y/n] default of yes, so without this a redirected
# stdin would silently auto-accept destructive actions (git checkout + re-exec,
# a rebuild) with no human input. Empty-as-yes only happens on a real Enter press.
# Usage: _ask_yn answer "Rebuild now? [Y/n] "
_ask_yn() {
  local _var="$1" _prompt="$2"
  echo -en "    ${_prompt}"
  local _reply=""
  read -r _reply || { printf -v "$_var" '%s' 'n'; return 0; }
  printf -v "$_var" '%s' "$_reply"
}

# Repo-controlled text (cap names, .cleat lines, section names) is rendered
# via echo -e (colors above are literal escape strings), so echo -e is
# load-bearing: raw control bytes AND backslash escapes in that text are
# both terminal-injection vectors once they reach it. Strip every control
# byte except tab (0x09) and newline (0x0a) and double backslashes so
# echo -e can't interpret anything attacker-supplied. The stripped set is
# C0 0x00-0x08 and 0x0b-0x1f (this INCLUDES carriage return 0x0d: a lone CR
# rewinds the cursor to column 0, so a preview line could overwrite itself
# and hide what actually runs), DEL 0x7f, and C1 0x80-0x9f. Sanitize at
# every render site for repo-controlled text.
_sanitize_repo_str() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013-\037\177\200-\237' | sed 's/\\/\\\\/g'
}

# ── Spinner ────────────────────────────────────────────────────────────────
_SPIN_PID=""

_is_tty() { [[ -t 1 ]]; }

# Cursor visibility. Guarded on _is_tty because `tput` writes its escapes to
# STDOUT regardless of whether stdout is a terminal. Unguarded, every command
# ended with a cursor-restore sequence on stdout, which is invisible noise for a
# human but corrupts any output meant to be captured: `cd "$(cleat fork path
# feat-a)"` got the path plus a newline plus \033[?12l\033[?25h and failed with
# "no such file or directory". Found on a host run 2026-07-31.
_cursor_hide() { _is_tty && { command -v tput &>/dev/null && tput civis 2>/dev/null; }; return 0; }
_cursor_show() { _is_tty && { command -v tput &>/dev/null && tput cnorm 2>/dev/null; }; return 0; }

# Stricter than _is_tty (which checks stdout alone): BOTH stdin and stdout must be
# a real terminal. Used only by the one place Cleat deliberately BLOCKS for a
# keypress (_maybe_gate_on_docker_config): a launch with no human to answer
# (cron, a pipe, `cleat start </dev/null`, CI) must never be held, so the gate
# needs stdin to be interactive too, not just stdout.
#
# The `-t 0` term is load-bearing and INTENTIONALLY distinct from _is_tty. Do NOT
# "simplify" this to `[[ -t 1 ]]`: dropping the stdin check would let a launch with
# a redirected stdin (stdout still a tty) hit the blocking `read`, the exact
# walk-away-pillar violation the gate exists to avoid. A ttyless test harness can't
# tell `[[ -t 0 && -t 1 ]]` from `[[ -t 1 ]]` (both false when stdout isn't a tty),
# so no unit test can catch that specific regression: this comment is the guard.
# A test + mutation DO catch the coarser "always interactive" regression.
_is_interactive() { [[ -t 0 && -t 1 ]]; }

_has_unicode() {
  local lang="${LANG:-}${LC_ALL:-}${LC_CTYPE:-}"
  [[ "$lang" == *UTF-8* ]] || [[ "$lang" == *utf8* ]]
}

# Terminal width, for truncating rows that carry arbitrary-length text.
#
# The first width helper in this file, and it arrives late: every existing
# picker avoids wrapping by keeping its rows short by hand, which is a rule a
# comment cannot enforce. A session row carries a model-written title of any
# length, so it has to measure.
#
# COLUMNS is not exported to scripts (bash sets it for interactive shells only),
# so it is usually empty here and tput answers instead. tput is an OPTIONAL
# dependency in this CLI (see _cursor_hide's `command -v` guard), so 80 is the
# floor. Clamped at both ends because the fixed-height redraw math breaks on a
# 20-column terminal and gains nothing past 200.
# Raw terminal geometry as "ROWS COLS", falling back to 24 80. The single
# measurement both _term_rows and _term_cols are built on.
#
# ORDER MATTERS AND IT IS NOT THE OBVIOUS ONE. `stty size` comes first because
# it is the only LIVE reading: it asks the kernel for the window size of fd 0
# every time. `tput` is second and can be actively wrong, because ncurses
# use_env makes an exported LINES or COLUMNS override the real ioctl, so a user
# whose shell rc exports either would get the launch-time size forever and the
# viewport would never follow a resize. The environment variables themselves are
# not consulted at all: bash sets them for interactive shells and does not
# export them, so a script never sees them anyway.
#
# `stty size` reads fd 0 and fails loudly (non-zero, empty) when stdin is not a
# terminal, which is what makes the 24x80 fallback deterministic in tests. tput
# is the opposite and cannot be error-checked: with no measurement it prints the
# terminfo entry's static size and still exits 0.
#
# The reject pattern includes `0*`, which covers two real cases in one: a pty
# whose window size was never set reports "0 0" with rc 0, and a leading-zero
# value would be read as octal by (( )) and kill the binary under `set -e`.
_term_size() {
  local rows="" cols="" sz
  sz="$(stty size 2>/dev/null || true)"
  set -- $sz
  rows="${1:-}"; cols="${2:-}"
  case "$rows" in ''|0*|*[!0-9]*) rows="" ;; esac
  case "$cols" in ''|0*|*[!0-9]*) cols="" ;; esac
  if [[ -z "$rows" || -z "$cols" ]] && command -v tput >/dev/null 2>&1; then
    [[ -n "$rows" ]] || rows="$(tput lines 2>/dev/null || true)"
    [[ -n "$cols" ]] || cols="$(tput cols 2>/dev/null || true)"
    case "$rows" in ''|0*|*[!0-9]*) rows="" ;; esac
    case "$cols" in ''|0*|*[!0-9]*) cols="" ;; esac
  fi
  printf '%s %s' "${rows:-24}" "${cols:-80}"
}

# One row's worth of sanitized title, for the line-oriented render sites.
#
# _sessions_frame clamps the title to the row budget, but the `echo -e` lines
# (the delete confirmation's headline, the rename prompt's "Current:" line and
# the action screen's header) did not. A title can be as long as the title
# window allows, so an over-long one wrapped to arbitrarily many physical lines
# and scrolled the very line naming the session id and its size off the screen.
# That is the line a user reads before answering a destructive prompt.
_sessions_safe_title() {
  local t
  t="$(_sessions_safe_str "$1")"
  local room
  room=$(( $(_term_cols) - 18 ))
  (( room < 12 )) && room=12
  if [[ ${#t} -gt $room ]]; then
    t="${t:0:$(( room - 1 ))}…"
  fi
  printf '%s' "$t"
}

# Terminal width for row truncation, clamped to what the renderer can lay out.
#
# The clamp is a RENDERING range, not a claim about the terminal. A window
# narrower than the floor cannot hold this layout at all, and pretending it is
# 40 columns wide makes every row wrap, which is what actually destroys a
# fixed-height redraw. So callers that care must ask _term_size themselves and
# refuse, the way cmd_sessions does before it ever opens the picker.
_term_cols() {
  local c
  c="$(_term_size)"
  c="${c#* }"
  case "$c" in ''|0*|*[!0-9]*) c=80 ;; esac
  (( c < 40 ))  && c=40
  (( c > 200 )) && c=200
  printf '%s' "$c"
}

# Terminal height, same contract.
_term_rows() {
  local r
  r="$(_term_size)"
  r="${r%% *}"
  case "$r" in ''|0*|*[!0-9]*) r=24 ;; esac
  (( r < 5 ))   && r=5
  (( r > 200 )) && r=200
  printf '%s' "$r"
}

# Render-safety for a session title or prompt preview.
#
# _sanitize_repo_str above is the WRONG tool for this class and must not be used
# on it. That one deliberately KEEPS newline and tab (its input is repo-authored
# multi-line text), and a session title is drawn as ONE row: a newline in it
# would inject an extra physical line, desyncing the fixed-height redraw and
# letting a title forge a convincing "Delete session X? [y/N]" line of its own.
# It also strips \200-\237, which eats UTF-8 continuation bytes and mangles any
# non-ASCII title.
#
# So: drop every C0 control byte INCLUDING newline and carriage return (a lone
# CR rewinds the cursor to column 0, so a row could overwrite the row above and
# hide which session is really selected) and DEL, but leave 0x80+ alone so UTF-8
# survives. Double backslashes last, because every render site is `echo -e`.
#
# This text is model-written and lives in a file the box can write, so it is
# untrusted in the same sense a repo file is. Sanitize at every render site.
_sessions_safe_str() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' | sed 's/\\/\\\\/g'
}

# True when the terminal is known to render OSC 8 hyperlinks (and we're on a
# TTY). Deliberately a conservative allow-list: a miss just falls back to a bare
# clickable URL (see _hyperlink), so we never risk escape garbage on an unknown
# or old terminal, a multiplexer, or piped output. Covers the terminals the
# maintainer's audience actually uses; Apple Terminal is intentionally absent
# (it has no OSC 8 but autodetects bare URLs itself).
_supports_osc8() {
  _is_tty || return 1
  case "${TERM_PROGRAM:-}" in
    iTerm.app|vscode|WezTerm|ghostty|Hyper|Tabby|rio) return 0 ;;
  esac
  [[ -n "${KITTY_WINDOW_ID:-}" || -n "${WEZTERM_PANE:-}" || -n "${GHOSTTY_BIN_DIR:-}" ]] && return 0
  # GNOME VTE 0.50+ (VTE_VERSION ≥ 5000) added OSC 8 support.
  [[ "${VTE_VERSION:-}" =~ ^[0-9]+$ ]] && (( ${VTE_VERSION:-0} >= 5000 )) && return 0
  return 1
}

# Render a terminal hyperlink. In OSC-8-capable terminals (iTerm2, VS Code,
# WezTerm, Ghostty, kitty, GNOME/VTE…) the short TEXT becomes a clickable link to
# URL; elsewhere it degrades to the bare URL, which terminals like Apple Terminal
# autodetect and make clickable on their own (so it's always at least copyable).
# OSC 8 format:  ESC ] 8 ; ; URL  ST   TEXT   ESC ] 8 ; ; ST     (ST = ESC \).
# Prints with no trailing newline; callers add color/underline around it.
_hyperlink() {
  local url="$1" text="${2:-$1}"
  if _supports_osc8; then
    printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$text"
  else
    printf '%s' "$url"
  fi
}

spin() {
  local msg="$1"
  if ! _is_tty; then
    info "$msg"
    return
  fi
  # A second spin() before spin_stop would orphan the first frame loop and
  # interleave two \r-animations into garbage. Stop the old one first.
  [[ -n "${_SPIN_PID:-}" ]] && _cleanup_spin
  local frames
  if _has_unicode; then
    frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  else
    frames=('-' '\' '|' '/')
  fi
  _cursor_hide
  local _spin_parent=$$
  (
    trap 'exit 0' TERM INT
    local i=0
    while kill -0 "$_spin_parent" 2>/dev/null; do
      printf "\r  ${BLUE}%s${RESET} %s" "${frames[$i]}" "$msg"
      i=$(( (i + 1) % ${#frames[@]} ))
      sleep 0.08
    done
    # Parent died without spin_stop (SIGKILL, hard crash): erase the frame and
    # restore the cursor instead of overwriting the shell prompt every 80 ms
    # with the cursor left hidden. The old spinner was un-disownable spam.
    printf "\r\033[K"
    _cursor_show
  ) &
  _SPIN_PID=$!
  # NOT disowned: spin_stop's `wait` must synchronize with the loop's exit so
  # no final frame can print after the ✔/✖ line (wait on a disowned pid is a
  # no-op race).
}

spin_stop() {
  local code="$1" ok_msg="$2" fail_msg="${3:-$2}"
  if [[ -n "$_SPIN_PID" ]]; then
    kill "$_SPIN_PID" 2>/dev/null || true
    wait "$_SPIN_PID" 2>/dev/null || true
    _SPIN_PID=""
    _cursor_show
  fi
  if ! _is_tty; then
    [[ "$code" -eq 0 ]] && success "$ok_msg" || error "$fail_msg"
    return
  fi
  if [[ "$code" -eq 0 ]]; then
    printf "\r\033[K  ${GREEN}✔ %s${RESET}\n" "$ok_msg"
  else
    printf "\r\033[K  ${RED}✖${RESET} %s\n" "$fail_msg"
  fi
}

_cleanup_spin() {
  if [[ -n "${_SPIN_PID:-}" ]]; then
    kill "$_SPIN_PID" 2>/dev/null || true
    wait "$_SPIN_PID" 2>/dev/null || true
    _SPIN_PID=""
  fi
  _cursor_show
}

# Restore the host terminal after an interactive `docker exec`. The docker CLI
# only undoes the termios state it set itself; private modes enabled by the
# in-box TUI: alternate screen, mouse tracking, bracketed paste, hidden
# cursor: survive a hard crash (a SIGSEGV'd claude, fork lockup at the pids
# cap) and leave the terminal spraying escape garbage on every keystroke and
# mouse move until a manual `reset`. Every sequence here is a no-op on a
# terminal already in a clean state, so this is safe after normal exits too.
_restore_terminal() {
  _is_tty || return 0
  {
    stty sane
    printf '\033[?1049l\033[?2004l\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?25h\033[0m'
  } </dev/tty >/dev/tty 2>/dev/null || true
}

# ── Keypress reader for TUI ────────────────────────────────────────────────
_read_keypress() {
  local key
  IFS= read -rsn1 key 2>/dev/null || true
  if [[ "$key" == $'\e' ]]; then
    # Read the rest of the escape sequence in one call.
    # Arrow keys send \e[A/B/C/D. Read up to 2 chars with a timeout.
    # Only a BARE Escape (nothing follows) is ESC. Every unrecognized
    # sequence (PgUp \e[5~, F-keys, Home/End) must be OTHER: mapping the
    # unknown to ESC made any stray arrow or function key close the
    # pickers, because the TUI loops treat ESC as cancel.
    local seq=""
    IFS= read -rsn2 -t 1 seq 2>/dev/null || true
    case "$seq" in
      "[A") echo "UP" ;;
      "[B") echo "DOWN" ;;
      "[C") echo "RIGHT" ;;
      "[D") echo "LEFT" ;;
      "")   echo "ESC" ;;
      *)    echo "OTHER" ;;
    esac
  elif [[ "$key" == " " ]]; then
    echo "SPACE"
  elif [[ "$key" == "" ]]; then
    echo "ENTER"
  elif [[ "$key" == "q" || "$key" == "Q" ]]; then
    echo "QUIT"
  else
    echo "OTHER"
  fi
}

# Portable MD5: works on both Linux (md5sum) and macOS (md5 -q)
_md5() {
  if command -v md5sum &>/dev/null; then
    md5sum
  elif command -v md5 &>/dev/null; then
    md5 -q
  else
    cksum | awk '{print $1}'
  fi
}

# ── Project-scoped container naming ─────────────────────────────────────────
container_name_for() {
  local project_path="$1"
  local box="${2:-}"
  local dir_name hash suffix=""
  # A named (non-default) box folds in as a trailing -<box>. The default box
  # ("main" or empty) gets the legacy suffix-less name: zero migration for
  # existing containers (see concept/20-boxes.md). The 8-char hash is ALWAYS
  # preserved; only the human-readable dir segment is re-truncated to fit.
  if [[ -n "$box" && "$box" != "main" ]]; then
    suffix="-${box}"
  fi
  dir_name="$(basename "$project_path" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
  # Keep the full name under Docker's 63-char limit:
  #   "cleat-" (6) + dir + "-" (1) + hash8 (8) + suffix = 15 + dir + |suffix|.
  # Budget the remaining room (48 minus the suffix length) for dir_name.
  local max_dir=$(( 48 - ${#suffix} ))
  (( max_dir < 1 )) && max_dir=1
  dir_name="${dir_name:0:$max_dir}"
  # Remove trailing dash from truncation
  dir_name="${dir_name%-}"
  hash="$(echo -n "$project_path" | _md5 | head -c 8)"
  echo "cleat-${dir_name}-${hash}${suffix}"
}

# Validate a box name. Boxes are named, per-project sandboxes (see
# concept/20-boxes.md): 1–31 chars, must start with a lowercase alnum, and may
# contain lowercase alnum, dash, or underscore. The pattern is held in a
# variable and used UNQUOTED: bash 3.2 treats a quoted =~ RHS as a literal
# string, which would silently break matching.
_validate_box_name() {
  local box="$1"
  local _box_re='^[a-z0-9][a-z0-9_-]{0,30}$'
  [[ "$box" =~ $_box_re ]]
}

# Derive the per-project session key used for Claude session/history isolation
# and the per-project .claude.json store (see concept/19-claude-json-isolation.md
# and concept/20-boxes.md). The DEFAULT box ("main" or empty) returns the legacy
# <basename>-<hash8> key BYTE-IDENTICALLY: folding a suffix in for the default
# would orphan every existing user's session history on upgrade. A named box
# appends "-<box>" so two boxes over one workspace never share sessions.
#
# LC_ALL=C pins tr and sed to ASCII, exactly as _claude_session_key does and
# explains. Without it a UTF-8 collation can fold a non-ASCII basename
# differently from one run to the next (a locale change between two `cleat`
# invocations is enough), and a key that moves orphans the project's whole
# session history and its .claude.json store. Byte-identical for every ASCII
# basename. A non-ASCII basename that v1.4.3 keyed under a UTF-8 locale keeps
# that key while its session directory exists and the C key's does not.
#
# The legacy lookup tries the caller's own locale first (what v1.4.3 ran), then
# C.UTF-8, then en_US.UTF-8. A locale the host does not have makes tr and sed
# fall back to C, so that candidate equals the C key and is skipped. Only an
# existing real directory adopts a legacy key: a symlink never does.
_derive_project_session_key() {
  local project="$1"
  local box="${2:-}"
  local _basename _hash key _suffix="" _legacy _loc
  _basename="$(basename "$project" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9-]/-/g')"
  _hash="$(echo -n "$project" | _md5 | head -c 8)"
  if [[ -n "$box" && "$box" != "main" ]]; then
    _suffix="-${box}"
  fi
  if [[ ! -d "${HOME}/.claude/projects/${_basename}-${_hash}${_suffix}" ]] \
     && printf '%s' "$(basename "$project")" | LC_ALL=C grep -q '[^[:print:]]' 2>/dev/null; then
    for _loc in "" C.UTF-8 en_US.UTF-8; do
      if [[ -z "$_loc" ]]; then
        _legacy="$(basename "$project" 2>/dev/null | tr '[:upper:]' '[:lower:]' 2>/dev/null | sed 's/[^a-z0-9-]/-/g' 2>/dev/null)"
      else
        _legacy="$(basename "$project" 2>/dev/null | LC_ALL="$_loc" tr '[:upper:]' '[:lower:]' 2>/dev/null | LC_ALL="$_loc" sed 's/[^a-z0-9-]/-/g' 2>/dev/null)"
      fi
      [[ -n "$_legacy" && "$_legacy" != "$_basename" ]] || continue
      if [[ -d "${HOME}/.claude/projects/${_legacy}-${_hash}${_suffix}" && ! -L "${HOME}/.claude/projects/${_legacy}-${_hash}${_suffix}" ]]; then
        _basename="$_legacy"
        break
      fi
    done
  fi
  key="${_basename}-${_hash}${_suffix}"
  echo "$key"
}

# Parse and validate the box positional for a box-aware verb (see
# concept/20-boxes.md). Sets the global _BOX; an empty arg → the default box
# "main". Prints an error and exits on an invalid name. Call from the dispatch
# DIRECTLY, not inside $(...), so the exit propagates to the whole process.
_set_box() {
  local box="${1:-}"
  # A box-aware verb takes exactly one [box] positional; reject stray args so a
  # typo like `cleat stop az dev` errors instead of silently acting on only az.
  if [[ $# -gt 1 ]]; then
    error "Unexpected argument: ${BOLD}${2}${RESET}"
    echo -e "    ${DIM}A box-aware command takes a single [box] name.${RESET}"
    exit 1
  fi
  if [[ -z "$box" ]]; then
    _BOX="main"
    return 0
  fi
  if ! _validate_box_name "$box"; then
    error "Invalid box name: ${BOLD}${box}${RESET}"
    echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars (e.g. ${BOLD}az${RESET}${DIM}, ${BOLD}dev${RESET}${DIM}).${RESET}"
    exit 1
  fi
  _BOX="$box"
}

resolve_project() {
  local project="${1:-$PWD}"
  if [[ -d "$project" ]]; then
    (cd "$project" && pwd)
  else
    echo "$project"
  fi
}

# ── Helpers ─────────────────────────────────────────────────────────────────
is_running() {
  docker ps --filter "name=^${1}$" --format '{{.Names}}' 2>/dev/null | grep -q "^${1}$"
}

container_exists() {
  docker ps -a --filter "name=^${1}$" --format '{{.Names}}' 2>/dev/null | grep -q "^${1}$"
}

image_exists() {
  docker images --format '{{.Repository}}' 2>/dev/null | grep -q "^${IMAGE_NAME}$"
}

# GOARCH of the docker daemon (arm64/amd64): the architecture containers
# actually run as. Read from the SERVER, not uname: with a remote DOCKER_HOST
# the local machine's arch is irrelevant. Empty when unreachable (callers
# must fail open).
_daemon_arch() {
  docker version --format '{{.Server.Arch}}' 2>/dev/null || true
}

# GOARCH of a local image, empty if unknown/absent.
_image_arch() {
  docker image inspect "$1" --format '{{.Architecture}}' 2>/dev/null || true
}

# True when the image's architecture matches the daemon's, i.e. its
# containers run natively. Unknown daemon or image arch fails OPEN (ok): an
# unreachable daemon or exotic setup must never force a rebuild loop. FALSE
# means the image would run under emulation: slow, and the documented
# trigger for node segfaults and garbled TTYs on Apple Silicon (Docker calls
# amd64-on-arm "best effort"). Callers treat such an image as missing and
# re-acquire a native one.
_image_arch_ok() {
  local image="${1:-$IMAGE_NAME}"
  local want have
  want="$(_daemon_arch)"
  [[ -n "$want" ]] || return 0
  have="$(_image_arch "$image")"
  [[ -n "$have" ]] || return 0
  [[ "$have" == "$want" ]]
}

# One-line explanation used by the acquisition gates when replacing an
# emulated image with a native one.
_warn_image_emulated() {
  warn "Local image is ${BOLD}$(_image_arch "$IMAGE_NAME")${RESET} but Docker runs ${BOLD}$(_daemon_arch)${RESET}. Emulated boxes are slow and crash-prone; fetching a native image"
}

require_running() {
  local cname="$1"
  if ! is_running "$cname"; then
    error "Container ${BOLD}${cname}${RESET} is not running."
    echo -e "    ${DIM}Start it with: cleat start${RESET}"
    exit 1
  fi
}

# Resolve a symlink chain down to the physical file, portably. BSD readlink
# (macOS before 12.3) has no usable -f, so the chain is walked by hand: a
# relative target resolves against the link's OWN directory, and the closing
# `pwd -P` collapses both the `..` segments a Homebrew symlink is made of and
# any symlinked parent directory. The hop cap means a symlink cycle can never
# hang the CLI. A path that does not exist (or whose directory is unreadable)
# comes back unchanged: callers only pattern-match the result.
_resolve_physical_path() {
  local p="${1:-}" target dir hops=0
  while [[ -L "$p" && $hops -lt 40 ]]; do
    target="$(readlink "$p" 2>/dev/null)" || break
    [[ -n "$target" ]] || break
    case "$target" in
      /*) p="$target" ;;
      *)  p="$(dirname "$p")/$target" ;;
    esac
    hops=$((hops + 1))
  done
  if [[ -e "$p" ]]; then
    dir="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || dir=""
    if [[ -n "$dir" ]]; then
      # Trimming a trailing slash keeps a root-level file as /cleat, not //cleat.
      printf '%s/%s\n' "${dir%/}" "$(basename "$p")"
      return 0
    fi
  fi
  printf '%s\n' "$p"
}

# True when the cleat at $1 is a Homebrew keg install. The signal is where the
# PHYSICAL file lives (a path segment named Cellar, or the keg's
# INSTALL_RECEIPT.json a couple of levels above it), never the directory the
# command was invoked through: /usr/local/bin is BOTH Homebrew's bin on an
# Intel Mac and install.sh's symlink target, so the directory proves nothing.
# Deliberately never shells out to `brew` and never reads $HOMEBREW_PREFIX:
# both are absent unless the user ran `eval "$(brew shellenv)"`, which plenty
# of Intel-Mac setups never did and a cron or non-login shell never has. The
# path is a parameter so the caller decides what gets probed.
_is_brew_managed() {
  [[ -n "${1:-}" ]] || return 1
  local phys dir hops=0
  phys="$(_resolve_physical_path "$1")"
  case "$phys" in
    */Cellar/*) return 0 ;;
  esac
  # Second signal: the keg receipt at the keg root, which sits a short way
  # above the binary (bin/ under libexec/ under the keg, so three levels).
  # Bounded at 4: enough for that layout with one to spare, and short enough
  # to stay near the install. Homebrew writes this file at a keg root and
  # nowhere else, so a hit anywhere in that range means a keg.
  dir="$(dirname "$phys")"
  while [[ $hops -lt 4 ]]; do
    [[ -f "$dir/INSTALL_RECEIPT.json" ]] && return 0
    [[ "$dir" == "/" || "$dir" == "." ]] && break
    dir="$(dirname "$dir")"
    hops=$((hops + 1))
  done
  return 1
}

# Hand a keg operation back to Homebrew, replacing this process.
#
# `exec` is load-bearing, not a shortcut. `brew upgrade` removes the keg the
# running script lives in, and bash reads a script incrementally rather than
# all at once, so a file replaced underneath it can be misparsed mid-run.
# Replacing the process image means nothing more of this file is ever read.
#
# Returns 1 WITHOUT exec'ing when brew is unreachable, which is a real case
# and the reason detection never depended on brew in the first place: a keg
# used from a shell that never ran `brew shellenv`, or from cron. The caller
# then falls back to printing the command for the user to run.
# Every cleat executable reachable on this machine, as "<bin path>\t<physical
# path>" lines, in PATH order (so the first line is the one a bare `cleat`
# actually runs) followed by the fixed locations an installer can write to.
#
# Those fixed locations are searched even when they are NOT on PATH, which is
# the whole point: a Homebrew prefix is invisible to a shell that never ran
# `eval "$(brew shellenv)"`, and a fresh ~/.local/bin often is not on PATH
# yet either. Checking only PATH would report "no other install" while a
# second one sits right there, which is exactly the state this exists to
# prevent.
#
# Deduped by bin path, bracket-delimited so a path containing a space cannot
# produce a false match. Emits nothing when only one cleat exists.
_find_cleat_installs() {
  local dirs seen="" d p phys
  dirs="$(printf '%s' "${PATH:-}" | tr ':' '\n')
/usr/local/bin
${HOME:-}/.local/bin
/opt/homebrew/bin
/home/linuxbrew/.linuxbrew/bin"
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    p="$d/cleat"
    [[ -x "$p" ]] || continue
    case "$seen" in *"[$p]"*) continue ;; esac
    seen="${seen}[$p]"
    phys="$(_resolve_physical_path "$p")"
    printf '%s\t%s\n' "$p" "$phys"
  done <<< "$dirs"
}

# Render the running/shadowed rows for a set of installs. Shared verbatim by
# `cleat status` and the on-start multiple-install notice so their rows stay
# byte-identical. $1 = _find_cleat_installs output (bin<TAB>phys lines),
# $2 = the physical path of the running binary.
_render_install_shadow_list() {
  local _installs="$1" _self_phys="$2" _p _phys _kind _mark
  while IFS=$'\t' read -r _p _phys; do
    [[ -n "$_p" ]] || continue
    case "$_phys" in
      */Cellar/*) _kind="Homebrew" ;;
      *)          _kind="git" ;;
    esac
    if [[ "$_phys" == "$_self_phys" ]]; then _mark="${GREEN}running ${RESET}"; else _mark="${DIM}shadowed${RESET}"; fi
    echo -e "    ${_mark} ${_p} ${DIM}(${_kind})${RESET}"
  done <<< "$_installs"
}

# On-start notice (concept/21): warn when this is not the only cleat on the
# machine. The one-install guard lives only in cleat's OWN installers (install.sh
# and `cleat install`), so `brew install` or a manual copy can add a second cleat
# that a bare `cleat` then resolves by PATH order: the invisible split behind a
# "cleat update did nothing" or a stale --version. Surfaced on every interactive
# start until fixed. Warns, never blocks: Homebrew owns the install moment, cleat
# can only make the state visible. Silence with CLEAT_NO_INSTALL_CHECK=1.
_maybe_warn_multiple_installs() {
  _is_tty || return 0
  [[ "${CLEAT_NO_INSTALL_CHECK:-}" == "1" ]] && return 0
  local _installs _count _self_phys
  _installs="$(_find_cleat_installs)"
  _count="$(printf '%s\n' "$_installs" | grep -c . || true)"
  [[ "$_count" =~ ^[0-9]+$ ]] && (( _count > 1 )) || return 0
  _self_phys="$(_resolve_physical_path "${BASH_SOURCE[0]:-$0}")"
  # One guarded blank above. Do NOT touch _ONSTART_GAP_OPEN: _ensure_daemon and
  # _maybe_sweep_idle_boxes run between this notice and the pressure/highlight
  # cluster and ignore the flag, so a trailing-blank handoff would mis-space.
  [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
  warn "$_count cleat installs found. PATH order decides which one runs."
  _render_install_shadow_list "$_installs" "$_self_phys"
  # Remedy: name the single shadow precisely. A keg is `brew uninstall`; a script
  # install is removing its printed bin path, because `cleat uninstall` only ever
  # acts on the RUNNING binary, never a shadow. Fall back to the generic line for
  # 3+ installs or the same-file-via-two-symlinks case (zero shadows).
  local _p _phys _nshadow=0 _shadow_bin="" _shadow_phys=""
  while IFS=$'\t' read -r _p _phys; do
    [[ -n "$_p" ]] || continue
    [[ "$_phys" == "$_self_phys" ]] && continue
    _nshadow=$(( _nshadow + 1 )); _shadow_bin="$_p"; _shadow_phys="$_phys"
  done <<< "$_installs"
  if (( _nshadow == 1 )); then
    case "$_shadow_phys" in
      */Cellar/*) echo -e "    ${DIM}Remove the one you are not using: ${BOLD}brew uninstall cleatdev/tap/cleat${RESET}" ;;
      *)          echo -e "    ${DIM}Remove the one you are not using: ${BOLD}rm ${_shadow_bin}${RESET}${DIM} (add sudo if the directory is unwritable).${RESET}" ;;
    esac
  else
    echo -e "    ${DIM}Remove one: ${BOLD}cleat uninstall${RESET}${DIM}, or ${BOLD}brew uninstall cleatdev/tap/cleat${RESET}${DIM} for the keg.${RESET}"
  fi
  return 0
}

# One cleat per machine. Refuses when another cleat executable sits at a bin
# path other than the one we are about to write, because from then on PATH
# order decides which one runs and the loser is invisible until it bites (a
# stale version "fixing itself" after a shell restart, an update that appears
# to do nothing). Returns 0 when the machine is clear.
#
# Same bin path is NOT a conflict: re-pointing the symlink we own is a
# re-install, which is the documented upgrade path.
#
# A Homebrew keg is never overridable, with or without force. Replacing brew's
# symlink leaves brew tracking an install it no longer owns, which is the exact
# hazard the rest of the guard exists to prevent, so the only correct move is
# `brew uninstall` first. A conflicting REGULAR FILE is not overridable either:
# that is somebody's own copy of the script, not something this command gets to
# delete. Only a symlink can be replaced, and only with force.
_refuse_other_installs() {
  local ours="$1" force="${2:-}"
  local p phys brews="" links="" files=""
  while IFS=$'\t' read -r p phys; do
    [[ -n "$p" ]] || continue
    [[ "$p" == "$ours" ]] && continue
    case "$phys" in
      */Cellar/*) brews="${brews}${p}"$'\n' ; continue ;;
    esac
    if [[ -L "$p" ]]; then
      links="${links}${p}"$'\n'
    else
      files="${files}${p}"$'\n'
    fi
  done <<< "$(_find_cleat_installs)"

  if [[ -n "$brews" ]]; then
    error "cleat is already installed by Homebrew."
    _print_install_list "$brews"
    echo -e "    ${DIM}Remove that one first: ${BOLD}brew uninstall cleatdev/tap/cleat${RESET}"
    echo -e "    ${DIM}Then re-run this. Your config, boxes, trust and sessions are untouched.${RESET}"
    return 1
  fi
  if [[ -n "$files" ]]; then
    error "cleat is already installed elsewhere on this machine."
    _print_install_list "$files"
    echo -e "    ${DIM}That is a real file, not a symlink, so Cleat will not remove it.${RESET}"
    echo -e "    ${DIM}Delete it yourself, then re-run.${RESET}"
    return 1
  fi
  [[ -n "$links" ]] || return 0

  if [[ -z "$force" ]]; then
    error "cleat is already installed elsewhere on this machine."
    _print_install_list "$links"
    echo -e "    ${DIM}Two installs mean PATH order decides which one runs.${RESET}"
    echo -e "    ${DIM}Replace it with: ${BOLD}cleat install --force${RESET}"
    return 1
  fi

  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    warn "Replacing the install at ${BOLD}${p}${RESET}"
    if [[ -w "$(dirname "$p")" ]]; then
      rm -f "$p"
    else
      sudo rm -f "$p"
    fi
  done <<< "$links"
  return 0
}

_print_install_list() {
  local _line
  while IFS= read -r _line; do
    [[ -n "$_line" ]] || continue
    echo -e "    ${BOLD}${_line}${RESET}"
  done <<< "$1"
}

_brew_delegate() {
  _brew_present || return 1
  info "Homebrew owns this install. Running: ${BOLD}brew $*${RESET}"
  # execfail keeps a failed exec (brew on PATH but not executable, or removed
  # between the check and the call, which in cleat uninstall spans a human
  # prompt) from killing the shell at 126/127. Without it the printed-command
  # fallback below the caller is unreachable in exactly the case it is for.
  shopt -s execfail 2>/dev/null || true
  exec brew "$@" || true
  return 1
}

# ── Host connectivity ────────────────────────────────────────────────────
# Docker Desktop provides host.docker.internal automatically. Every other
# engine (Docker Engine on Linux, rootless, Colima, Rancher Desktop, Lima, on
# a Mac as much as on Linux) needs --add-host for it.
_is_docker_desktop() {
  # Read JUST the OperatingSystem field via --format, NOT `docker info | grep`.
  # The piped form is SIGPIPE-fragile under `set -o pipefail` (which the real
  # binary runs): when `grep -q` matches it exits immediately and closes the
  # pipe, `docker info` then dies of SIGPIPE (141) on its next write, and
  # pipefail reports the whole pipeline as FAILED even though it matched. Under
  # memory pressure `docker info` is slow and has lots still to write when grep
  # bails, so the race tips to "failed" exactly when the Docker-Desktop-only VM
  # advisory needs to fire: the on-start "give Docker more memory" steps then
  # silently vanished (observed v0.16.1). The format query has no pipe, no race,
  # and is cheaper (one field, not the whole info dump).
  local os
  os="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null)" || return 1
  [[ "$os" == *"Docker Desktop"* ]]
}

# True on macOS. macOS keeps Claude Code's OAuth login in the login Keychain,
# not in ~/.claude/.credentials.json, so the shared ~/.claude mount carries no
# token and a freshly-auth'd host still re-prompts inside the box. The seed
# helpers below bridge that gap. Overridable in tests.
_is_macos() {
  [[ "${OSTYPE:-}" == darwin* ]] || [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]
}

# Whether the daemon's memory pool is a VM: Docker Desktop on any OS, and every
# macOS backend (Desktop, OrbStack, and Colima all run the daemon in a Linux
# VM). A native or rootless Linux engine (and a WSL2 in-distro engine) draws
# from the host's own RAM: no VM exists, so the memory advisories must not
# call the pool one. macOS short-circuits without touching the daemon; the
# Linux branch costs one `docker info` field read, plus a context-endpoint read
# only when the daemon is neither macOS nor Docker Desktop. Overridable in tests.
_docker_pool_is_vm() {
  _is_macos && return 0
  _is_docker_desktop && return 0
  # Lima-backed engines (Colima, Rancher Desktop, plain Lima) run dockerd inside
  # a VM on LINUX hosts too, where _is_macos and _is_docker_desktop are both
  # false (the in-VM `docker info` names the guest distro, never "Docker
  # Desktop"). Detect them by their socket living under the user's HOME dot-dir
  # (~/.colima, ~/.rd, ~/.lima) so the docker cap binds the in-VM
  # /var/run/docker.sock, not the unresolvable host forward path.
  #
  # Anchored to $HOME on purpose. A bare */.colima/* substring would also match
  # an unrelated host-local socket that merely CONTAINS such a segment (e.g. a
  # hand-set DOCKER_HOST=unix:///opt/.rd/docker.sock on a native daemon),
  # misrouting it to the VM branch, which binds /var/run/docker.sock with no
  # liveness guard: if that path is absent on the host, Docker materialises a
  # phantom DIRECTORY there (the machine-damage pattern). A relocated
  # LIMA_HOME/COLIMA_HOME outside $HOME simply falls back to host-local (the
  # pre-detection behaviour): degraded, never dangerous.
  # An empty or root HOME would degenerate the anchor to /.colima/* (or match
  # far too broadly), reopening the over-match the anchor exists to close. No
  # HOME means no Lima-family engine to detect, so answer host-local.
  case "${HOME:-}" in ""|/) return 1 ;; esac
  local _ep="${DOCKER_HOST:-$(_docker_context_endpoint)}"
  _ep="${_ep#unix://}"
  case "$_ep" in
    "$HOME"/.colima/*|"$HOME"/.rd/*|"$HOME"/.lima/*) return 0 ;;
  esac
  return 1
}

# ── Docker autopilot (concept/29) ────────────────────────────────────────────
#
# A down daemon after a reboot is the single most common "Docker is friction"
# moment. On the session verbs, in an interactive terminal, cleat starts the
# user's own Docker (Docker Desktop / OrbStack / Colima on macOS, Docker
# Desktop or a rootless engine on Linux, the Windows-side Docker Desktop from
# WSL2), waits on a bounded poll, then continues the original command. Where
# it cannot start Docker safely (remote endpoints, a root-owned Linux engine)
# it prints the exact one-line command instead of guessing. One-shot: cleat
# launches the user's own Docker and adds no persistent process of its own.

# Is the docker CLI on PATH at all? Overridable in tests.
_docker_cli_present() {
  command -v docker > /dev/null 2>&1
}

# Daemon reachable? An EXIT-CODE gate, deliberately NOT a stderr string match:
# the "Cannot connect to the Docker daemon" text is version- and locale-
# dependent (Docker 29 says "failed to connect to the docker API").
# Overridable in tests.
_daemon_up() {
  docker info > /dev/null 2>&1
}

# The current context's daemon endpoint / name, both readable with NO live
# daemon (unlike _is_docker_desktop, which needs `docker info`). Empty when
# unreadable. Overridable in tests.
_docker_context_endpoint() {
  docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true
}

_docker_context_name() {
  docker context show 2>/dev/null || true
}

# Overridable in tests. Is $1 a live unix socket on the host? Gating the docker
# cap's bind on this is the SAFETY property: a bind mount whose SOURCE is
# missing makes the engine materialise a DIRECTORY on the host at that path
# (the pattern that once broke git machine-wide, see the host-damage note).
_host_sock_is_live() {  # path
  [ -S "$1" ]
}

# The host Docker socket PATH the docker cap should bind, engine-aware so it is
# never a blind /var/run/docker.sock: under rootless the daemon lives at
# /run/user/<uid>/docker.sock and under Colima at ~/.colima/<profile>/docker.sock.
# $1 is the already-resolved endpoint (DOCKER_HOST or the active context). Prints
# the unix socket path, the standard path for an empty endpoint, or NOTHING for a
# remote (tcp/ssh/fd) endpoint that has no local socket to bind.
_resolve_host_docker_sock() {  # endpoint
  case "$1" in
    # Strip a single trailing slash: an env-file DOCKER_HOST like
    # 'unix:///var/run/docker.sock/' would otherwise miss the [ -S ] liveness
    # guard and bind nothing on a live host-local daemon. A unix socket is a
    # file, never a directory, so a trailing slash is always spurious.
    unix://*) local _p="${1#unix://}"; printf '%s\n' "${_p%/}" ;;
    "")       printf '%s\n' "/var/run/docker.sock" ;;
    *)        ;;
  esac
}

# True when $1 is a tcp endpoint on the LOOPBACK interface, i.e. a host-local
# daemon reached over TCP rather than a genuinely remote one. It matters because
# 127.0.0.1 means something different inside the box: forwarding such a
# DOCKER_HOST would point the box's client at ITS OWN loopback. Matches the
# host part only, so a routable address that merely starts with those digits
# (tcp://127.0.0.1.example.com) is not treated as loopback. Overridable in tests.
_endpoint_is_loopback() {  # endpoint
  local _hostport="${1#tcp://}"
  case "$1" in tcp://*) ;; *) return 1 ;; esac
  # IPv6 first, matched on the raw endpoint: the port-strip below cuts at the
  # first ':' and would mangle a bracketed address. Every bracketed form is
  # DECIDED here and never falls through, because a bracketed address that is
  # not loopback is remote by definition. Only the literal [::1] used to match,
  # so an expanded, zone-scoped or v4-mapped spelling of the same loopback
  # address classified remote and the docker capability silently forwarded
  # DOCKER_HOST into a box where ::1 means the box itself.
  case "$1" in
    "tcp://["*)
      local _v6="${1#tcp://[}"
      case "$_v6" in *"]"*) ;; *) return 1 ;; esac     # unclosed bracket
      _v6="${_v6%%]*}"
      _v6="${_v6%%\%*}"                       # drop a zone id: [::1%eth0]
      _v6="$(printf '%s' "$_v6" | tr '[:upper:]' '[:lower:]')"
      case "$_v6" in
        ::1|0:0:0:0:0:0:0:1) return 0 ;;
        # v4-mapped loopback (::ffff:127.0.0.1). Numeric tail only, the same
        # guard the 127/8 arm below applies to a dotted address.
        ::ffff:127.*)
          case "${_v6##*:}" in *[!0-9.]*) ;; *) return 0 ;; esac
          ;;
      esac
      # A wildcard ([::]) or any routable address is not loopback.
      return 1
      ;;
  esac
  _hostport="${_hostport%%/*}"   # drop any path
  _hostport="${_hostport%%:*}"   # drop the port
  # DNS names are case-insensitive, so tcp://LOCALHOST is loopback too. bash 3.2
  # has no ${var,,}; one tr on a launch-time path is fine.
  _hostport="$(printf '%s' "$_hostport" | tr '[:upper:]' '[:lower:]')"
  case "$_hostport" in
    localhost) return 0 ;;
    # The WHOLE 127/8 block is loopback (a local socket-proxy often binds
    # 127.0.0.2 and friends), but only as a NUMERIC dotted address: a DNS name
    # that merely starts with those digits (127.0.0.1.example.com) stays remote.
    127.*)
      case "$_hostport" in *[!0-9.]*) ;; *) return 0 ;; esac
      ;;
  esac
  return 1
}

# True inside WSL2 (Docker Desktop for Windows integrates via WSL; the
# Windows-side app can be launched from here). Overridable in tests.
_is_wsl() {
  grep -qi microsoft /proc/version 2>/dev/null
}

# Where Docker Desktop for Windows lives, as seen from WSL (empty when
# absent). Overridable in tests.
_wsl_desktop_exe() {
  # Docker Desktop for Windows, as seen from WSL. Probe the default install
  # under any drvfs mount root (automount.root may not be /mnt, the system
  # drive may not be C:), so a non-C: or custom-mount install is still found.
  local exe root
  for root in /mnt/c /mnt/*; do
    exe="$root/Program Files/Docker/Docker/Docker Desktop.exe"
    if [[ -e "$exe" ]]; then
      printf '%s' "$exe"
      return 0
    fi
  done
}

# WSL interop is live (the kernel can exec Windows .exe binaries). When
# interop is disabled, the drvfs mount still shows Docker Desktop.exe but
# launching it fails, so gate wsl-desktop on this. Overridable in tests.
_wsl_interop_ok() {
  [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]] \
    || [[ -e /proc/sys/fs/binfmt_misc/WSLInterop-late ]]
}

# A macOS app bundle is installed, checking both the system and per-user
# (no-admin install) Applications dirs. Overridable in tests (Linux CI has
# no /Applications).
# $HOME is sandboxed in tests but /Applications is NOT, so a test asserting an
# app is absent silently depended on the developer's machine not having it
# installed. It passed on Linux and on CI and failed on the one machine that
# matters, a Mac with Docker Desktop. _APP_DIR_SYSTEM is a test seam only; it
# defaults to the real path and production behaviour is unchanged.
_app_bundle_present() {
  local _sys="${_APP_DIR_SYSTEM:-/Applications}"
  [[ -d "$_sys/$1.app" ]] || [[ -d "$HOME/Applications/$1.app" ]]
}

_colima_present() {
  command -v colima > /dev/null 2>&1
}

# Docker Desktop for Linux installs a per-user systemd unit; its presence is
# daemon-down-safe evidence. Overridable in tests.
_desktop_linux_unit_present() {
  local units
  units="$(systemctl --user list-unit-files docker-desktop.service 2>/dev/null)" || units=""
  [[ "$units" == *docker-desktop* ]]
}

# Evidence of an in-distro Docker engine (native Linux or inside a WSL
# distro), from daemon-down-safe signals: a system docker unit, a sysv/init
# script, or the dockerd binary. Used inside WSL to prefer the in-distro
# engine over the Windows-side Desktop (attaching to the wrong engine is
# worse than a slower start). Overridable in tests.
_distro_docker_present() {
  local units
  units="$(systemctl list-unit-files docker.service 2>/dev/null)" || units=""
  [[ "$units" == *docker.service* ]] && return 0
  [[ -e /etc/init.d/docker ]] && return 0
  command -v dockerd > /dev/null 2>&1
}

# Pick the launcher for a DOWN daemon, from daemon-down-safe evidence only:
# the docker context (the user's explicit choice), then app/unit presence.
# _is_docker_desktop() is useless here (it needs `docker info`). Prints one
# of: desktop-macos | orbstack | colima | colima:<profile> | wsl-desktop |
# wsl-none | desktop-linux | rootless-linux | engine-linux | none.
_autostart_pick() {
  local ctx endpoint p
  ctx="$(_docker_context_name)"
  endpoint="$(_docker_context_endpoint)"

  if _is_macos; then
    # A stale context (backend uninstalled) must not be trusted for a
    # backgrounded launcher (colima) whose spawn failure we can't catch, so
    # colima arms verify _colima_present and otherwise fall through to app
    # detection. colima names its context `colima` (default) or
    # `colima-<profile>`; a named profile MUST be plumbed through or a bare
    # `colima start` boots the wrong VM and the poll waits on a socket that
    # never comes up.
    case "$ctx" in
      orbstack) echo orbstack; return 0 ;;
      colima)   _colima_present && { echo colima; return 0; } ;;
      colima-*) _colima_present && { echo "colima:${ctx#colima-}"; return 0; } ;;
      desktop-linux) echo desktop-macos; return 0 ;;
    esac
    case "$endpoint" in
      *"/.orbstack/"*) echo orbstack; return 0 ;;
      *"/.colima/"*)
        if _colima_present; then
          p="${endpoint#*/.colima/}"; p="${p%%/*}"
          if [[ -n "$p" && "$p" != "default" ]]; then echo "colima:$p"; else echo colima; fi
          return 0
        fi
        ;;
    esac
    # No usable context: fall back to what's installed, Desktop first
    # (the overwhelmingly common install).
    if _app_bundle_present Docker; then
      echo desktop-macos
    elif _app_bundle_present OrbStack; then
      echo orbstack
    elif _colima_present; then
      echo colima
    else
      echo none
    fi
    return 0
  fi

  # Linux, native or inside a WSL distro. In-distro evidence wins FIRST, so a
  # docker-ce / rootless engine inside the distro is chosen over the
  # Windows-side Desktop (attaching a session to the wrong engine is worse
  # than a slower start).
  if [[ "$ctx" == "desktop-linux" ]] || _desktop_linux_unit_present; then
    echo desktop-linux
    return 0
  fi
  case "$ctx" in
    rootless) echo rootless-linux; return 0 ;;
  esac
  case "$endpoint" in
    *"/run/user/"*) echo rootless-linux; return 0 ;;
  esac
  # Rootless socket under a non-standard XDG_RUNTIME_DIR (not /run/user/<uid>).
  if [[ -n "${XDG_RUNTIME_DIR:-}" && -n "$endpoint" && "$endpoint" == *"${XDG_RUNTIME_DIR}"* ]]; then
    echo rootless-linux
    return 0
  fi

  if _is_wsl; then
    # No in-distro Desktop/rootless context above. Prefer an in-distro root
    # engine if there's evidence; otherwise launch the Windows-side Desktop,
    # but only when interop can actually exec it.
    if _distro_docker_present; then
      echo engine-linux
      return 0
    fi
    if _wsl_interop_ok && [[ -n "$(_wsl_desktop_exe)" ]]; then
      echo wsl-desktop
    else
      echo wsl-none
    fi
    return 0
  fi

  # Native Linux: a root-owned engine is the catch-all.
  echo engine-linux
}

# Human name for messages.
_autostart_label() {
  case "$1" in
    desktop-macos|desktop-linux) echo "Docker Desktop" ;;
    orbstack)             echo "OrbStack" ;;
    colima|colima:*)      echo "Colima" ;;
    wsl-desktop|wsl-none) echo "Docker Desktop (Windows)" ;;
    rootless-linux)       echo "rootless Docker" ;;
    *)                    echo "Docker" ;;
  esac
}

# The exact start command (or, for kinds that have no single command, a plain
# instruction) for when autopilot can't or won't launch. Callers must NOT glue
# this into a "start it with: <hint>" template unconditionally; use
# _autostart_hint_is_command to tell the two apart.
_autostart_hint() {
  case "$1" in
    desktop-macos)  echo "open -a Docker" ;;
    orbstack)       echo "open -a OrbStack" ;;
    colima)         echo "colima start" ;;
    colima:*)       echo "colima start -p ${1#colima:}" ;;
    wsl-desktop|wsl-none) echo "start Docker Desktop on Windows (enable WSL integration for this distro)" ;;
    desktop-linux)  echo "systemctl --user start docker-desktop" ;;
    rootless-linux)
      if command -v systemctl > /dev/null 2>&1; then
        echo "systemctl --user start docker"
      else
        echo "dockerd-rootless.sh (or your init's rootless docker service)"
      fi
      ;;
    engine-linux)
      if command -v systemctl > /dev/null 2>&1; then
        echo "sudo systemctl start docker"
      else
        echo "sudo service docker start"
      fi
      ;;
    *) echo "start Docker, then retry" ;;
  esac
}

# True when _autostart_hint returns a copy-pasteable command (vs a plain
# instruction), so callers phrase "start it with: X" vs a bare sentence.
_autostart_hint_is_command() {
  case "$1" in
    wsl-desktop|wsl-none|none) return 1 ;;
    *) return 0 ;;
  esac
}

# Launch the picked backend, one-shot, output suppressed. Blocking starters
# (colima, the Windows exe) go to a disowning subshell; `open` and systemctl
# return immediately on their own. Overridable in tests. Non-zero when the
# launch command itself failed to spawn (or the kind is not launchable).
_autostart_launch() {
  case "$1" in
    desktop-macos)  open -g -a Docker > /dev/null 2>&1 ;;
    orbstack)       open -g -a OrbStack > /dev/null 2>&1 ;;
    colima)         ( colima start > /dev/null 2>&1 & ) ;;
    colima:*)       ( colima start -p "${1#colima:}" > /dev/null 2>&1 & ) ;;
    wsl-desktop)    ( "$(_wsl_desktop_exe)" > /dev/null 2>&1 & ) ;;
    desktop-linux)  systemctl --user start docker-desktop > /dev/null 2>&1 ;;
    rootless-linux) systemctl --user start docker > /dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

# VM-backed backends show "the Docker VM"; a rootless/root host daemon has no
# VM, so the poll says "the Docker daemon" instead.
_autostart_poll_noun() {
  case "$1" in
    rootless-linux|engine-linux) echo "the Docker daemon" ;;
    *) echo "the Docker VM" ;;
  esac
}

# ── Docker install offer (the autopilot's missing-CLI branch) ───────────────
#
# Installing Docker is privileged and system-mutating, so unlike the launcher
# it is CONSENT-FIRST everywhere: the exact command is shown, the default is
# No, non-TTY never prompts (it prints the per-OS command and exits), and
# CLEAT_NO_AUTOSTART=1 suppresses the offer along with the rest of autopilot.
# macOS asks WHICH flavor because the choice is licensing as much as tech
# (Docker Desktop and OrbStack are paid for larger companies; Colima is open
# source); automation goes through Homebrew's official casks. Linux installs
# the engine via Docker's official convenience script, downloaded to a file
# first (never a blind curl-pipe-sh), then offers the docker-group add. WSL2
# installs the Windows-side Docker Desktop through winget when reachable.

# Seams, overridable in tests (which must never run a real installer).
_brew_present()   { command -v brew > /dev/null 2>&1; }
_winget_present() { command -v winget.exe > /dev/null 2>&1; }

# Run one visible install step: echo the exact command, then execute it
# attached to the terminal (sudo and brew may prompt). Overridable in tests
# (records instead of running).
_install_run() {
  echo -e "    ${DIM}\$ $*${RESET}"
  "$@"
}

# The per-OS one-line install command, for non-TTY and declined offers. Kept
# to a single copy-pasteable command that fits ~80 cols with its "Install it
# with: " prefix (the interactive menu is where the OrbStack/Colima
# alternatives live); the Linux get.docker.com line is inherently long but is
# one pasteable unit.
_docker_install_hint() {
  if _is_macos; then
    echo "brew install --cask docker"
  elif _is_wsl; then
    echo "winget.exe install -e --id Docker.DockerDesktop"
  else
    echo "curl -fsSL https://get.docker.com -o get-docker.sh && sudo sh get-docker.sh"
  fi
}

# Package managers whose lock a first-boot updater holds. Matched on the process
# NAME only, never the command line, so a path or an argument that merely
# mentions "apt" cannot produce a false positive. `unattended-upgr` is the real
# 15-char truncated comm of unattended-upgrades, not an abbreviation of it.
_PKG_LOCK_PROCS="apt apt-get aptitude dpkg unattended-upgr packagekitd dnf yum zypper"

# Names the package manager currently running, or fails when none is. Prints the
# process name on success.
#
# Why this exists: a fresh cloud image runs its own updater on first boot
# (unattended-upgrades on Debian and Ubuntu, dnf-makecache on Fedora), which
# holds the package lock. get.docker.com then dies with "Could not get lock
# /var/lib/dpkg/lock-frontend" and the reader saw a bare "Install failed",
# concluding cleat was broken when the fix was to wait a minute.
#
# STRICTLY A DIAGNOSTIC, only ever called on an already-failed path. Every probe
# is best-effort: a false negative falls back to the plain message, so this can
# never turn a working install into a failure. It must also never hang, so
# nothing here waits on a lock, it only asks what is running right now.
_pkg_manager_busy() {
  local want comm
  if command -v pgrep > /dev/null 2>&1; then
    for want in $_PKG_LOCK_PROCS; do
      if pgrep -x "$want" > /dev/null 2>&1; then
        printf '%s\n' "$want"
        return 0
      fi
    done
    return 1
  fi
  # No pgrep (a minimal image without procps): read the command-name column from
  # ps and strip any leading path, which is the same comparison pgrep -x makes.
  command -v ps > /dev/null 2>&1 || return 1
  while IFS= read -r comm; do
    comm="${comm##*/}"
    for want in $_PKG_LOCK_PROCS; do
      if [ "$comm" = "$want" ]; then
        printf '%s\n' "$want"
        return 0
      fi
    done
  done <<PKGPS
$(ps -eo comm= 2>/dev/null || true)
PKGPS
  return 1
}

# Interactive install offer. Returns 0 when an install ran and the docker CLI
# is now present (the caller re-enters the autopilot flow), non-zero exit
# otherwise. TTY-only by contract (the caller gates).
_offer_docker_install() {
  if _is_macos; then
    if ! _brew_present; then
      echo -e "    ${DIM}Homebrew isn't installed, so cleat won't automate this. Official installers:${RESET}"
      echo -e "    ${DIM}Docker Desktop: https://docker.com/products/docker-desktop${RESET}"
      echo -e "    ${DIM}OrbStack:       https://orbstack.dev${RESET}"
      echo -e "    ${DIM}Colima:         https://github.com/abiosoft/colima${RESET}"
      exit 1
    fi
    echo ""
    echo -e "  Install Docker now? ${DIM}(via Homebrew)${RESET}"
    echo ""
    echo -e "    ${BOLD}1${RESET}) Docker Desktop  ${DIM}(the standard; free for personal use, paid for larger companies)${RESET}"
    echo -e "    ${BOLD}2${RESET}) OrbStack        ${DIM}(fast, mac-native; free for personal use, paid commercially)${RESET}"
    echo -e "    ${BOLD}3${RESET}) Colima          ${DIM}(open source, CLI-only, no GUI)${RESET}"
    echo -e "    ${BOLD}n${RESET}) no"
    echo ""
    local choice=""
    echo -en "    Choice [1/2/3/n] "
    read -r choice || choice=""
    case "$choice" in
      1) _install_run brew install --cask docker || { error "Install failed."; exit 1; } ;;
      2) _install_run brew install --cask orbstack || { error "Install failed."; exit 1; } ;;
      3) _install_run brew install docker colima || { error "Install failed."; exit 1; } ;;
      *)
        info "Skipped. Install later with: ${BOLD}$(_docker_install_hint)${RESET}"
        exit 1
        ;;
    esac
    return 0
  fi

  if _is_wsl; then
    if ! _winget_present; then
      echo -e "    ${DIM}Install Docker Desktop on Windows (docker.com/products/docker-desktop),${RESET}"
      echo -e "    ${DIM}enable WSL integration for this distro, then retry.${RESET}"
      exit 1
    fi
    echo ""
    local yn=""
    _ask_yn yn "Install Docker Desktop on Windows now (via winget)? [y/N] "
    if [[ "$yn" != [yY]* ]]; then
      info "Skipped. Install later with: ${BOLD}$(_docker_install_hint)${RESET}"
      exit 1
    fi
    _install_run winget.exe install -e --id Docker.DockerDesktop || { error "Install failed."; exit 1; }
    echo -e "    ${DIM}Start Docker Desktop on Windows and enable WSL integration for this distro.${RESET}"
    return 0
  fi

  # Linux: Docker's official convenience script, downloaded first so what
  # runs under sudo is a file you could have inspected, never a blind pipe.
  if ! command -v curl > /dev/null 2>&1 && ! command -v wget > /dev/null 2>&1; then
    error "Need curl or wget to fetch the Docker install script."
    echo -e "    ${DIM}Install one, or install Docker from your distro's packages.${RESET}"
    exit 1
  fi
  echo ""
  echo -e "  Install Docker Engine now? ${DIM}(Docker's official install script for mainstream distros, run with sudo)${RESET}"
  local yn=""
  _ask_yn yn "Download get.docker.com and run it? [y/N] "
  if [[ "$yn" != [yY]* ]]; then
    info "Skipped. Install later with: ${BOLD}$(_docker_install_hint)${RESET}"
    exit 1
  fi
  # Stage in a private 0700 dir created atomically by mktemp, NOT a predictable
  # $$-named file in world-writable /tmp: the download is then run under sudo,
  # so a pre-created/symlinked attacker-owned temp file would be a local root
  # TOCTOU (curl -o has no O_EXCL). mktemp -d makes the dir unguessable and
  # owned exclusively by us, so nothing can pre-plant or rewrite the script.
  local stage script
  stage="$(mktemp -d "${TMPDIR:-/tmp}/cleat-docker.XXXXXX")" || { error "Could not create a temp dir."; exit 1; }
  script="$stage/get-docker.sh"
  if command -v curl > /dev/null 2>&1; then
    if ! _install_run curl -fsSL https://get.docker.com -o "$script"; then
      rm -rf "$stage"; error "Download failed."; exit 1
    fi
  else
    if ! _install_run wget -qO "$script" https://get.docker.com; then
      rm -rf "$stage"; error "Download failed."; exit 1
    fi
  fi
  if ! _install_run sudo sh "$script"; then
    rm -rf "$stage"
    # Assigned on its own line: `local x=$(...)` would mask the exit status and
    # the || guard would never fire under set -e.
    local _busy=""
    _busy="$(_pkg_manager_busy)" || _busy=""
    if [ -n "$_busy" ]; then
      error "Install failed: the package manager is busy."
      echo -e "    ${DIM}${_busy} is already running, so Docker's installer could not take the${RESET}"
      echo -e "    ${DIM}package lock. A fresh cloud image runs its own updater on first boot.${RESET}"
      echo -e "    ${DIM}Wait for it to finish, then run ${BOLD}cleat${RESET}${DIM} again.${RESET}"
    else
      error "Install failed."
      echo -e "    ${DIM}Install Docker yourself with: ${BOLD}$(_docker_install_hint)${RESET}"
    fi
    exit 1
  fi
  rm -rf "$stage"
  # $USER can be unset under `su -c` or minimal PTYs; set -u would abort here.
  local u="${USER:-$(id -un 2>/dev/null)}"
  local gyn=""
  _ask_yn gyn "Add ${u} to the docker group (run docker without sudo)? [y/N] "
  if [[ "$gyn" == [yY]* ]]; then
    _install_run sudo usermod -aG docker "$u" || true
    success "Docker Engine installed."
    echo -e "    ${DIM}Log out and back in for the docker group to apply, then run ${BOLD}cleat${RESET}${DIM} again.${RESET}"
  else
    success "Docker Engine installed."
    echo -e "    ${DIM}Without the docker group you'll need sudo for docker. Run ${BOLD}cleat${RESET}${DIM} again to continue.${RESET}"
  fi
  # The fresh engine's socket isn't usable by this shell yet (group membership
  # applies at next login), so the session can't continue in the same breath.
  exit 1
}

# Ensure the daemon is reachable before a session verb. Remote endpoints are
# refused (launching a local app is wrong for them), the GUI pop is TTY-gated
# with a CLEAT_NO_AUTOSTART=1 opt-out (consistent with CLEAT_NO_IDLE_SWEEP /
# CLEAT_NO_UPDATE_CHECK), and the wait is a bounded foreground poll
# (CLEAT_AUTOSTART_TIMEOUT_SECS, default 90: a Docker Desktop cold boot is
# often 30-60s). Exits non-zero when Docker stays down; never loops forever.
_ensure_daemon() {
  if ! _docker_cli_present; then
    error "Docker isn't installed."
    if [[ "${CLEAT_NO_AUTOSTART:-}" == "1" ]] || ! _is_tty; then
      echo -e "    ${DIM}Install it with: ${BOLD}$(_docker_install_hint)${RESET}"
      exit 1
    fi
    # Consent-first install offer; on success the CLI exists now, so fall
    # through to the normal autopilot flow (down daemon → launch → poll).
    _offer_docker_install
    if ! _docker_cli_present; then
      if _is_wsl; then
        error "docker isn't on PATH yet."
        echo -e "    ${DIM}Start Docker Desktop on Windows, enable WSL integration for this distro, then retry.${RESET}"
      else
        error "docker still isn't on PATH ${DIM}(open a new terminal, then retry)${RESET}."
      fi
      exit 1
    fi
    success "Docker installed."
  fi

  _daemon_up && return 0

  # Remote endpoints: say where the daemon runs instead of popping a local
  # GUI. DOCKER_HOST wins over the context (docker's own precedence). Strip
  # control chars before display: the endpoint can carry terminal escapes
  # from a poisoned DOCKER_HOST or an imported context, and error() uses
  # echo -e which would render them raw.
  local endpoint="${DOCKER_HOST:-}"
  [[ -n "$endpoint" ]] || endpoint="$(_docker_context_endpoint)"
  local endpoint_show
  endpoint_show="$(printf '%s' "$endpoint" | tr -d '\000-\037')"
  case "$endpoint" in
    tcp://*|ssh://*|npipe://*|fd://*)
      error "Remote Docker daemon unreachable ${DIM}(${endpoint_show})${RESET}."
      echo -e "    ${DIM}Start it where it runs, then retry.${RESET}"
      exit 1
      ;;
  esac

  # Permission, not down: a local unix socket that EXISTS but isn't accessible
  # means the daemon is up and the user just isn't in the docker group. Saying
  # "start Docker" here would loop the user (worst case: right after cleat's own
  # installer told them to re-login). Only when the socket is a real, present,
  # inaccessible socket, so a genuinely-down daemon (no socket) still autostarts.
  case "$endpoint" in
    unix://*)
      local sock="${endpoint#unix://}"
      if [[ -S "$sock" && ! -w "$sock" ]]; then
        error "Docker is running, but you can't reach its socket ${DIM}(${sock})${RESET}."
        local u="${USER:-$(id -un 2>/dev/null)}"
        echo -e "    ${DIM}Add yourself to the docker group: ${BOLD}sudo usermod -aG docker ${u}${RESET}${DIM}, then log out and back in.${RESET}"
        exit 1
      fi
      ;;
  esac

  local kind
  kind="$(_autostart_pick)"

  # Kinds that cannot be safely auto-launched (root engine, remote-less WSL
  # with no interop, nothing recognized) message and exit; the rest launch.
  if [[ "${CLEAT_NO_AUTOSTART:-}" == "1" ]] || ! _is_tty \
     || [[ "$kind" == "engine-linux" || "$kind" == "none" || "$kind" == "wsl-none" ]]; then
    error "Docker isn't running."
    if _autostart_hint_is_command "$kind"; then
      echo -e "    ${DIM}Start it with: ${BOLD}$(_autostart_hint "$kind")${RESET}"
    else
      echo -e "    ${DIM}To fix: $(_autostart_hint "$kind").${RESET}"
    fi
    exit 1
  fi

  warn "Docker isn't running. Starting $(_autostart_label "$kind")..."
  if ! _autostart_launch "$kind"; then
    error "Could not launch $(_autostart_label "$kind")."
    echo -e "    ${DIM}Start it with: ${BOLD}$(_autostart_hint "$kind")${RESET}"
    exit 1
  fi

  # Bounded foreground poll with the _do_pull frame idiom (no background
  # watcher: a daemon poll has no natural terminator, so it needs an explicit
  # deadline and a non-zero exit, or a broken install hangs the CLI forever).
  local deadline="${CLEAT_AUTOSTART_TIMEOUT_SECS:-90}"
  if ! [[ "$deadline" =~ ^[0-9]+$ ]] || (( deadline < 1 )); then
    deadline=90
  fi
  local frames
  if _has_unicode; then
    frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  else
    frames=('-' '\' '|' '/')
  fi
  _cursor_hide
  local poll_noun
  poll_noun="$(_autostart_poll_noun "$kind")"
  local start now elapsed=0 i=0
  start="$(date +%s)"
  while ! _daemon_up; do
    now="$(date +%s)"
    elapsed=$(( now - start ))
    if (( elapsed >= deadline )); then
      _cursor_show
      printf "\r\033[K"
      error "Docker did not come up in ${deadline}s. Open it manually, then retry."
      exit 1
    fi
    printf "\r\033[K  ${BLUE}%s${RESET} waiting for %s ${DIM}(%ss)${RESET}" "${frames[$i]}" "$poll_noun" "$elapsed"
    i=$(( (i + 1) % ${#frames[@]} ))
    sleep 0.5
  done
  _cursor_show
  printf "\r\033[K"
  success "Docker ready"
  return 0
}

# Read Claude Code's OAuth credential blob from the macOS login Keychain. Claude
# stores it as a generic-password under the service "Claude Code-credentials"
# (older builds: "Claude Code"); `-w` prints just the secret (the JSON blob).
# Prints the blob on stdout, nothing on failure. `security` may pop a one-time
# Keychain access dialog the first time. Once the user clicks "Always Allow"
# it's silent; a denied/headless read (errSecInteractionNotAllowed over SSH)
# simply fails and we fall through. Overridable in tests.
_macos_keychain_credentials() {
  command -v security &>/dev/null || return 1
  local svc blob
  for svc in "Claude Code-credentials" "Claude Code"; do
    blob="$(security find-generic-password -s "$svc" -w 2>/dev/null)" || continue
    [[ -n "$blob" ]] && { printf '%s' "$blob"; return 0; }
  done
  return 1
}

# The one flat object held under KEY in a JSON blob on stdin, printed as its own
# JSON text, or nothing. KEY is a plain identifier.
#
# A credential file holds more than the Claude login. Claude Code keeps sibling
# keys in the same blob: mcpOAuth has one entry per MCP server, each with its
# OWN accessToken, refreshToken and expiresAt. 2.1.270 writes it AFTER
# claudeAiOauth once an MCP login follows a Claude login. A reader that searches
# the whole blob for a field answers about whichever entry comes last, which is
# key order and not meaning. Every reader of a credential scopes through this.
#
# One path and no jq, so a host with jq and a host without give the same answer
# by construction. The login object Claude writes is flat (strings, numbers and
# an array of strings), so the object ends at the first closing brace outside a
# string. Anything that cannot be isolated unambiguously prints nothing: no KEY,
# KEY more than once at any depth, or an object nested inside it. Nothing is the
# keep-safe answer every caller already handles. Newlines are only ever
# whitespace between JSON tokens, so they fold to spaces first and a
# pretty-printed file reads the same as the compact one Claude writes. A NUL
# folds too, or bash warns about it on the host terminal from a box-written file.
#
# It reads ALL of stdin, deliberately. Stopping early would SIGPIPE a
# `printf | _oauth_expires_at` caller. Under the CLI's pipefail that aborts the
# launch. A caller reading a file the box can write caps it with head -c.
# Always returns 0: callers assign it in `x="$(...)"` under set -e.
_json_flat_object() {
  local key="$1" blob hit re='[{].*'
  blob="$(LC_ALL=C tr '\000\r\n' '   ' 2>/dev/null || true)"
  # Every occurrence of the key, nested or not. A second one means there is no
  # way to know which object Claude reads.
  hit="$(printf '%s' "$blob" | LC_ALL=C grep -aoE "\"${key}\"[[:space:]]*:" 2>/dev/null || true)"
  case "$hit" in ''|*$'\n'*) return 0 ;; esac
  # Strings are matched whole, so a brace inside one neither ends the object
  # nor refuses it. A brace outside a string is a nested object and no match.
  hit="$(printf '%s' "$blob" \
    | LC_ALL=C grep -aoE "\"${key}\"[[:space:]]*:[[:space:]]*[{]([^{}\"]|\"([^\"\\\\]|\\\\.)*\")*[}]" 2>/dev/null || true)"
  # From the first brace on, which is the object's own: the key holds none.
  [[ "$hit" =~ $re ]] || return 0
  printf '%s' "${BASH_REMATCH[0]}"
  return 0
}

# The integer held under KEY in a flat object (the output of _json_flat_object).
# Prints it, or returns 1 when KEY is absent, appears twice or holds anything
# but a plain integer: a string, a fraction, an exponent, a leading zero or more
# than 15 digits. A leading zero reads as octal in bash arithmetic, where
# `(( 0800 > x ))` prints an error on the host terminal. More than 15 digits can
# wrap. An epoch in milliseconds has 13.
_json_flat_num() {
  local obj="$1" key="$2" hit v
  local re='^"[^"]*"[[:space:]]*:[[:space:]]*([0-9]+)[[:space:]]*[,}]$'
  # One line per occurrence of the key. The anchored match below takes exactly
  # one line holding a bare integer, so a second occurrence of any type refuses.
  hit="$(printf '%s' "$obj" | LC_ALL=C grep -aoE "\"${key}\"[[:space:]]*:[^,}]*[,}]?" 2>/dev/null || true)"
  [[ "$hit" =~ $re ]] || return 1
  v="${BASH_REMATCH[1]}"
  case "$v" in 0?*) return 1 ;; esac
  [[ ${#v} -le 15 ]] || return 1
  printf '%s' "$v"
}

# The string held under KEY in a flat object (the output of _json_flat_object),
# with its JSON escapes decoded. Prints it (possibly empty), or returns 1 when
# KEY is absent, appears twice or holds anything but a string.
#
# Two copies of a key are two answers and no way to know which one Claude reads,
# so the reader refuses rather than picking the first or the last. That pick is
# exactly how an MCP server's token was once read as the Claude login's. In the
# JSON Claude writes, "KEY" followed by a colon can only be a key. A quote inside
# a string is always escaped. A string value is never followed by a colon.
_json_flat_str() {
  local obj="$1" key="$2" hit
  # One line per occurrence of the key, whatever it holds.
  hit="$(printf '%s' "$obj" | LC_ALL=C grep -aoE "\"${key}\"[[:space:]]*:" 2>/dev/null || true)"
  case "$hit" in ''|*$'\n'*) return 1 ;; esac
  hit="$(printf '%s' "$obj" | LC_ALL=C grep -aoE "\"${key}\"[[:space:]]*:[[:space:]]*\"([^\"\\\\]|\\\\.)*\"" 2>/dev/null || true)"
  [[ -n "$hit" ]] || return 1
  hit="${hit#*\"${key}\"}"
  hit="${hit#*\"}"
  hit="${hit%\"}"
  case "$hit" in
    *\\*) _sessions_json_unesc "$hit" ;;
    *)    printf '%s' "$hit" ;;
  esac
}

# The Claude login's access-token expiry (epoch MILLISECONDS) from a credential
# blob on stdin: claudeAiOauth.expiresAt and nothing else, never an MCP server's
# token beside it. Empty when the login cannot be isolated or its expiresAt is
# not a plain integer. Claude stores it in ms. An empty value makes
# _seed_macos_credentials keep the file and reads as 0 in _account_cred_expiry,
# which never earns a harvest. A seconds-scaled value is NOT kept: it reads as
# long expired.
_oauth_expires_at() {
  _json_flat_num "$(_json_flat_object claudeAiOauth)" expiresAt || true
  # Always succeed: the caller assigns this in `x="$(...)"`, and a non-zero exit
  # there trips the CLI's `set -e` (a missing/absent expiresAt is normal, not an
  # error). The empty stdout is the signal; the exit code must stay 0.
  return 0
}

# On macOS, materialize the Keychain-stored OAuth credential into
# ~/.claude/.credentials.json (the path Claude reads on Linux), so the box,
# which only sees the mounted ~/.claude dir, never the Keychain, starts
# authenticated instead of re-prompting. The blob is validated as a JSON object
# and written 0600. No-op off macOS or when the Keychain has nothing.
#
# When to (re)seed:
#   - File ABSENT/empty  -> seed (Linux hosts already have it; this never runs).
#   - File PRESENT       -> re-seed ONLY when its OAuth token has EXPIRED *and*
#                           the Keychain holds a fresher, still-valid one.
# The re-seed closes the host-re-login gap (concept/23 open item): a host
# re-login rotates the Keychain token and invalidates the file's now-stale
# refresh token, so a freshly-created box that has never refreshed reads a dead
# token from the shared file and drops to an interactive LOGIN. A still-valid
# file token is never touched (the box refreshes its own and may be fresher than
# the Keychain). Only the Claude login's own expiry counts
# (claudeAiOauth.expiresAt). MCP server logins kept in the same file under
# mcpOAuth carry their own expiresAt and never count, in the file or in the
# Keychain blob. Anything we can't parse (no claudeAiOauth object, a nested or
# second copy of it, a missing or non-numeric expiresAt) falls through to "keep
# the file", so an unrecognized schema can never trigger a clobber. Sets
# _SEEDED_CREDS=1 on a write. _CLEAT_NOW_S overrides the clock for tests.
#
# ~/.claude is mounted read-write into every box, so the file is box-writable.
# Its read is capped and cannot abort the launch when the file is unreadable.
# The temp file is a mktemp name a box cannot guess and plant a link at.
_SEEDED_CREDS=0
_seed_macos_credentials() {
  _is_macos || return 0
  local cred="${HOME}/.claude/.credentials.json"
  local blob=""
  if [[ -s "$cred" ]]; then
    local file_exp kc_exp now_ms
    file_exp="$(head -c "$_ACCOUNT_CRED_MAX_BYTES" "$cred" 2>/dev/null | _oauth_expires_at || true)"
    [[ "$file_exp" =~ ^[0-9]+$ ]] || return 0          # unparseable file token -> keep
    now_ms=$(( ${_CLEAT_NOW_S:-$(date +%s)} * 1000 ))
    (( file_exp > now_ms )) && return 0                # file token still valid -> keep
    blob="$(_macos_keychain_credentials)" || return 0
    [[ -n "$blob" ]] || return 0
    kc_exp="$(printf '%s' "$blob" | _oauth_expires_at 2>/dev/null)"
    [[ "$kc_exp" =~ ^[0-9]+$ ]] || return 0            # unparseable keychain token -> keep
    # Only a Keychain token that is BOTH fresher than the file's AND not itself
    # expired earns the overwrite; otherwise keep what we have.
    (( kc_exp > file_exp && kc_exp > now_ms )) || return 0
  else
    blob="$(_macos_keychain_credentials)" || return 0
    [[ -n "$blob" ]] || return 0
  fi
  mkdir -p "${HOME}/.claude" 2>/dev/null || return 0
  # mktemp, not "$cred.tmp.$$". A pid is guessable. A box that planted a
  # symlink at that name had the Keychain login written through it onto any
  # host file the user can write. mktemp refuses an existing path (symlink or
  # FIFO included) and creates at 0600 on both BSD and GNU.
  local tmp
  tmp="$(mktemp "${cred}.tmp.XXXXXX" 2>/dev/null)" || return 0
  ( umask 077; printf '%s' "$blob" > "$tmp" ) 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
  # Never write a non-JSON-object (e.g. an error string) into the creds file.
  local ok=false
  if command -v jq &>/dev/null; then
    jq -e 'type=="object"' "$tmp" >/dev/null 2>&1 && ok=true
  else
    _looks_like_json_object "$tmp" && ok=true
  fi
  if $ok; then
    chmod 600 "$tmp" 2>/dev/null || true
    if mv -f "$tmp" "$cred" 2>/dev/null; then _SEEDED_CREDS=1; else rm -f "$tmp" 2>/dev/null; fi
  else
    rm -f "$tmp" 2>/dev/null
  fi
  return 0
}

# ── Per-box sections ────────────────────────────────────────────────────────
#
# A project's .cleat can scope any section to one box:
#
#     [caps]                 # the project default, used by every box
#     git
#     [box.review.caps]      # box `review` DECLARES its own, replacing the above
#     git
#     [box.locked.caps]      # DECLARED and EMPTY: zero caps, a hard lockdown
#
# DECLARED replaces, it never merges. That is what keeps least privilege: a box
# can still ask for FEWER capabilities than the project (concept/20). ABSENT
# inherits the bare section. Present-but-empty is a real value, not absence,
# which is the one thing the old per-box FILES could not express.
#
# Presence is a PREDICATE, never an exit status threaded through a command
# substitution. `local out="$(f)"` reports local's status, not f's, so an
# rc-based declared/absent contract silently reads "declared" every time. Six
# call sites in this file already use that idiom.
_cleat_section_present() {
  local file="$1" want="[$2]" line
  [[ -r "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#$'\xef\xbb\xbf'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ "$line" == "$want" ]] && return 0
  done < "$file"
  return 1
}

# The section name to read for (box, kind): the box's own when it declares one,
# else the bare project section. LIST kinds only (caps, setup, fork); resources
# resolves per KEY instead, see _read_resource_from_file.
#
# `main` is deliberately NOT special-cased. [box.main.caps] is honoured, which
# costs nothing (a file with no box sections resolves byte-identically) and lets
# a .cleat be written so the RESTRICTIVE section is the one an older Cleat reads.
_scoped_section() {
  local file="$1" box="${2:-}" kind="$3"
  if [[ -n "$box" ]] && _cleat_section_present "$file" "box.${box}.${kind}"; then
    printf 'box.%s.%s' "$box" "$kind"
  else
    printf '%s' "$kind"
  fi
}

# ── Capabilities: config file reading ──────────────────────────────────────
# Read capabilities from a config file. Returns newline-separated cap names.
# Config format: [caps] section header, then one cap name per line.
# $2 is the BOX: with one, a declared [box.<box>.caps] replaces [caps] entirely.
# Callers that mean the global config (which has no boxes) pass nothing.
_read_caps_from_file() {
  local file="$1" _box="${2:-}"
  [[ -r "$file" ]] || return 0
  local _want; _want="[$(_scoped_section "$file" "$_box" caps)]"
  local in_caps=false
  # `|| [[ -n "$line" ]]` so a final line with no trailing newline (common in
  # hand-edited .cleat/config files, e.g. `printf '[caps]\nenv'`) is still read;
  # without it `read` returns non-zero at EOF and the last capability is silently
  # dropped. Matches the env-file parser (_parse_env_file).
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip carriage return (CRLF from Windows editors)
    line="${line%$'\r'}"
    line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, silently voided the first section
    # Strip leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    # Skip empty lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue
    # Section header
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "$_want" ]] && in_caps=true || in_caps=false
      continue
    fi
    if $in_caps; then
      echo "$line"
    fi
  done < "$file"
}

# Read [setup] provisioning lines from a config file. Exact structural
# mirror of _read_caps_from_file above, matching the literal "[setup]"
# header instead: same CRLF strip, whitespace trim, blank/# skip, and
# no-trailing-newline handling. ANY other `[...]` line turns the section
# off (INI hazard: a stray `[ -f x ]` test line reads as a header; docs say
# use `test`, and _warn_unknown_cleat_sections surfaces the mistake).
_read_setup_from_file() {
  local file="$1" _box="${2:-}"
  [[ -r "$file" ]] || return 0
  local _want; _want="[$(_scoped_section "$file" "$_box" setup)]"
  local in_setup=false
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, silently voided the first section
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "$_want" ]] && in_setup=true || in_setup=false
      continue
    fi
    if $in_setup; then
      echo "$line"
    fi
  done < "$file"
}

# Write capabilities to a config file. Preserves non-[caps] sections.
_write_caps_to_file() {
  local file="$1"
  shift
  local caps=("$@")
  # $_WRITE_SECTION scopes the write to a per-box section. It is a global rather
  # than a positional because the cap list is variadic. Empty = the bare [caps].
  local _sec="${_WRITE_SECTION:-caps}"

  mkdir -p "$(dirname "$file")"

  # If file exists, preserve everything outside [caps] section
  local preserved=""
  if [[ -f "$file" ]]; then
    local in_caps=false _h
    # `|| [[ -n "$line" ]]` so a project .cleat whose LAST section is hand-written
    # and ends WITHOUT a trailing newline (e.g. a final `[setup]` line) is not
    # silently dropped from `preserved`: without the guard `read` returns non-zero
    # at EOF and the last line is lost, corrupting a section this writer must keep
    # byte-for-byte. Matches _read_section_from_file / _write_kits_to_file / _write_resources_to_file.
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, same hygiene as the readers
      # Match the header the way every READER does: trimmed. Comparing the raw
      # line meant an indented `  [caps]` was a section to _read_caps_from_file
      # and ordinary preserved text to this writer, which then appended a
      # SECOND [caps] block. The reader reads both, so `cleat config --disable
      # docker` reported success while docker stayed ACTIVE, and an indented
      # [setup] between the two blocks was swallowed and deleted outright.
      # Found 2026-07-31. The preserved text keeps the original line, not the
      # trimmed one: other sections keep the user's own formatting.
      _h="${line#"${line%%[![:space:]]*}"}"
      _h="${_h%"${_h##*[![:space:]]}"}"
      if [[ "$_h" == "[$_sec]" ]]; then
        in_caps=true
        continue
      fi
      if $in_caps; then
        # Skip lines in old [caps] section until next section or EOF
        if [[ "$_h" == "["*"]" ]]; then
          in_caps=false
          preserved+="$line"$'\n'
        fi
        continue
      fi
      preserved+="$line"$'\n'
    done < "$file"
  fi

  # Write preserved content + new [caps] section
  {
    if [[ -n "$preserved" ]]; then
      printf '%s' "$preserved"
    fi
    # A per-box section that has been DECLARED is never removed by emptying it.
    # Omitting the header would mean "absent", which means INHERIT, so
    # `cleat config locked --disable <last cap>` would silently escalate a
    # zero-caps box to the project's full set. Empty is written as a bare header.
    if [[ ${#caps[@]} -gt 0 ]]; then
      echo "[$_sec]"
      for cap in "${caps[@]}"; do
        echo "$cap"
      done
    elif [[ "$_sec" != "caps" && "${_WRITE_EMPTY_SECTION:-0}" == "1" ]]; then
      echo "[$_sec]"
    fi
  } > "$file.cleat-tmp.$$" && mv -f "$file.cleat-tmp.$$" "$file" || {
    rm -f "$file.cleat-tmp.$$" 2>/dev/null || true
    error "Could not write ${file/#${HOME}/~}"
    return 1
  }
}

# Which section the editor writes for a box, resolved exactly the way the
# readers resolve it. Without this shared rule `cleat config main` wrote [caps]
# while _read_caps_from_file read an existing [box.main.caps], so the edit was a
# silent no-op that also granted the caps project-wide.
_config_section_for() {
  local file="$1" box="${2:-}" kind="$3"
  # No box at all: the bare project/global section.
  [[ -n "$box" ]] || { printf '%s' "$kind"; return 0; }
  # Already declared: write where the readers read, whatever the box is called.
  if _cleat_section_present "$file" "box.${box}.${kind}"; then
    printf 'box.%s.%s' "$box" "$kind"; return 0
  fi
  # Not declared yet. `main` IS the bare section, so it edits [caps]; any other
  # box gets its own section created rather than editing the project default.
  if [[ "$box" == "main" ]]; then
    printf '%s' "$kind"
  else
    printf 'box.%s.%s' "$box" "$kind"
  fi
}

# A one-line note at the top of a .cleat that has grown its first per-box
# section. .cleat is COMMITTED and shared, and a Cleat older than this release
# cannot see [box.*] sections: it falls back to [caps], so a per-box REDUCTION
# reads as the permissive project set on a teammate's older CLI. That fails
# OPEN, so it is worth saying in the file itself rather than only in the docs.
_config_note_sections_version() {
  local file="$1"
  [[ -r "$file" ]] || return 0
  grep -q '^# Per-box config' "$file" 2>/dev/null && return 0
  grep -q '^\[box\.' "$file" 2>/dev/null || return 0
  local tmp="${file}.cleat-note.$$"
  {
    # No version number. VERSION is the release being RUN, and at the moment a
    # file first grows a section that is still the last release that CANNOT read
    # one, so naming it stated the exact opposite of the truth in a file the user
    # then commits. The warning that matters does not need a number.
    echo "# Per-box config: [box.<name>.<kind>] sections, read by newer Cleat."
    echo "# Older versions ignore them and apply [caps] to every box."
    cat "$file"
  } > "$tmp" && mv -f "$tmp" "$file" || rm -f "$tmp" 2>/dev/null || true
  return 0
}

# Write a cap set for a scope, with the two rules the adversarial review made
# non-negotiable:
#
#   DELETE-ON-EQUAL. If the box's resulting set is exactly what it would inherit,
#   drop the section so the box goes back to INHERITING. Without this a no-op
#   edit (even a bare ENTER) silently pins the box to today's project caps
#   forever, and no verb can undo it.
#
#   NEVER VANISH. Otherwise, always emit the header, empty included. An omitted
#   section means "absent" means "inherit", so writing an empty set by omission
#   would escalate a locked-down box to the project's full capability set.
_config_write_caps_scoped() {
  local file="$1" sec="$2" box="$3"; shift 3
  local caps=("$@")
  if [[ -z "$box" ]]; then
    _write_caps_to_file "$file" "${caps[@]+"${caps[@]}"}"
    # Editing the project default while box `main` DECLARES its own section
    # changes nothing for main, and reporting a bare success reads as if it did.
    if _cleat_section_present "$file" "box.main.caps"; then
      warn "Box ${BOLD}main${RESET} declares ${BOLD}[box.main.caps]${RESET}, so it is unaffected by this edit."
      echo -e "    ${DIM}Edit it with ${BOLD}cleat config main --enable <cap>${RESET}${DIM}, or delete that section to make main inherit again.${RESET}"
    fi
    return
  fi
  local _mine _inherited
  _mine="$(printf '%s\n' "${caps[@]+"${caps[@]}"}" | _canonical_caps)"
  _inherited="$(_read_caps_from_file "$file" "" | _canonical_caps)"
  # ONLY for a per-box section. For the bare [caps] the "inherited" set IS the
  # set being written, so this fired on every no-op edit of the project config
  # and deleted [caps] outright: a silent, total capability wipe.
  # And never on an EMPTY set: a bare [box.B.caps] is an explicit lockdown, and
  # dropping it would let the box inherit whatever the project gains later.
  if [[ "$sec" == box.* && -n "$_mine" && "$_mine" == "$_inherited" ]]; then
    _WRITE_SECTION="$sec" _WRITE_EMPTY_SECTION=0 _write_caps_to_file "$file"
    info "Box ${BOLD}${box}${RESET} now inherits the project capabilities."
    return
  fi
  _WRITE_SECTION="$sec" _WRITE_EMPTY_SECTION=1 _write_caps_to_file "$file" "${caps[@]+"${caps[@]}"}"
  _config_note_sections_version "$file"
}

# Write [resources] memory/cpus to a config file, preserving everything OUTSIDE
# [resources] (same shape as _write_caps_to_file / _write_kits_to_file). An empty
# value, or the picker sentinels "default"/"all", OMITS that key; when BOTH keys
# are unset no [resources] section is written at all, so an untouched config stays
# clean. Never touches [caps], [setup], or [kits]. The block uses explicit ifs
# (never `[[ ]] && echo`): a false test as the block's last list would make the
# `{ ...; } > file` compound return 1 and kill a strict-mode caller on the
# both-unset path (the exact bug the kits writer's comment records).
_write_resources_to_file() {
  local file="$1" memory="$2" cpus="$3"
  local _sec="${_WRITE_RES_SECTION:-resources}"
  mkdir -p "$(dirname "$file")"

  # Sentinel -> empty (callers translate too; this is belt and suspenders so a
  # literal "default"/"all" can never leak into the file and get warned+ignored
  # by resolve_box_memory on every subsequent run).
  case "$memory" in default|all) memory="" ;; esac
  case "$cpus" in default|all) cpus="" ;; esac

  local preserved="" in_res=false line
  if [[ -f "$file" ]]; then
    # `|| [[ -n "$line" ]]` and the `\r` strip mirror the caps/kits writers: keep a
    # no-trailing-newline final section, and match a CRLF `[resources]\r` header so
    # the old section is REPLACED (not duplicated into two [resources] blocks).
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, same hygiene as the readers
      # Trimmed header match, same parity fix as _write_caps_to_file. Here the
      # stale duplicate WINS every read, because _read_section_from_file
      # returns on its first match, so a memory the user had just raised
      # silently kept the old value.
      _h="${line#"${line%%[![:space:]]*}"}"
      _h="${_h%"${_h##*[![:space:]]}"}"
      if [[ "$_h" == "[$_sec]" ]]; then
        in_res=true
        continue
      fi
      if $in_res; then
        if [[ "$_h" == "["*"]" ]]; then
          in_res=false
          preserved+="$line"$'\n'
        fi
        continue
      fi
      preserved+="$line"$'\n'
    done < "$file"
  fi

  {
    if [[ -n "$preserved" ]]; then
      printf '%s' "$preserved"
    fi
    if [[ -n "$memory" || -n "$cpus" ]]; then
      echo "[$_sec]"
      if [[ -n "$memory" ]]; then
        echo "memory = $memory"
      fi
      if [[ -n "$cpus" ]]; then
        echo "cpus = $cpus"
      fi
    fi
  } > "$file.cleat-tmp.$$" && mv -f "$file.cleat-tmp.$$" "$file" || {
    rm -f "$file.cleat-tmp.$$" 2>/dev/null || true
    error "Could not write ${file/#${HOME}/~}"
    return 1
  }
}

# Resolve which project cap file applies to a box (see concept/20-boxes.md):
# a named box uses .cleat.<box> if present, ELSE falls back to .cleat. The
# default/"main" box always uses .cleat. REPLACE semantics: a box file fully
# replaces .cleat (it does NOT inherit), which is what enables least privilege:
# a box can declare FEWER caps than the project default.
# The project config file. Always .cleat now: per-box config moved INTO it as
# [box.<name>.<kind>] sections, so there is one file per project instead of one
# per box (a week of forks used to leave nine committed dotfiles in the repo
# root, and the ephemeral ones outlived their boxes).
#
# The old $project/.cleat.<box> files are NO LONGER READ. That is a deliberate
# clean break, and it is announced rather than silent: a leftover file would
# otherwise change a box's capabilities in either direction with nothing on
# screen. Dropping the fallback also retires a shipped footgun for free, because
# `.cleat.env` is the project ENV file and used to double as box `env`'s cap
# file: `cleat config env --memory 4g` appended [resources] next to API_TOKEN=.
_project_caps_file() {
  local project="$1"
  echo "$project/.cleat"
}

# Announce a leftover per-box file exactly once per run, per file.
_WARNED_LEGACY_BOX_FILES=""
_warn_legacy_box_file() {
  # Separate lines on purpose: bash expands the whole `local` list against the
  # PREVIOUS scope, so `local a="$1" b="$a/x"` builds b from an unset a.
  local project="$1" box="${2:-main}"
  # `env` is the project ENV sidecar (.cleat.env), never a per-box caps file.
  # Warning on it told the user to move their secrets into the committed .cleat.
  [[ "$box" != "env" ]] || return 0
  local f="$project/.cleat.$box"
  [[ -n "$box" && "$box" != "main" ]] || return 0
  [[ -f "$f" ]] || return 0
  case "$_WARNED_LEGACY_BOX_FILES" in *"|$f|"*) return 0 ;; esac
  _WARNED_LEGACY_BOX_FILES="${_WARNED_LEGACY_BOX_FILES}|$f|"
  warn "${BOLD}.cleat.${box}${RESET} is no longer read ${DIM}(per-box config moved into .cleat)${RESET}"
  echo -e "    ${DIM}Move its sections into ${BOLD}.cleat${RESET}${DIM} as ${BOLD}[box.${box}.caps]${RESET}${DIM}, ${BOLD}[box.${box}.resources]${RESET}${DIM}, ${BOLD}[box.${box}.setup]${RESET}${DIM}. This box is using the project defaults until you do.${RESET}"
}

# Build the executable [setup] payload for (project, box): stdout is the
# exact byte stream that will run in the box. This framing (the "# cleat
# setup: begin/end script <path>" markers) is part of the hashed trust
# input (see _setup_payload_hash) and is FROZEN once shipped: changing it
# would silently invalidate every prior approval's byte-exactness.
# Empty stdout + rc 0 when there's no [setup] section (or no cap file).
# rc 1 (after a warn to stderr naming the bad directive) on an invalid
# `script <path>` line; the caller treats that as "skip setup, never abort
# the session", not a hard failure.
_build_setup_payload() {
  local project="$1" box="${2:-main}"
  local caps_file
  caps_file="$(_project_caps_file "$project")"
  [[ -f "$caps_file" ]] || return 0

  local line
  while IFS= read -r line; do
    case "$line" in
      # Any whitespace after the directive, not just a space. A tab fell
      # through to the default arm and was handed to the shell as a command
      # line, so a `script<TAB>provision.sh` line ran as an arbitrary command
      # while the user had written (and the trust prompt showed) a script.
      "script "*|"script	"*)
        local path="${line#script}"
        # Trim surrounding whitespace, then one leading "./".
        path="${path#"${path%%[![:space:]]*}"}"
        path="${path%"${path##*[![:space:]]}"}"
        path="${path#./}"
        # Repo-controlled text rendered via warn()'s echo -e: sanitize the
        # display copy, keep the raw path for the actual file operations.
        local path_disp
        path_disp="$(_sanitize_repo_str "$path")"

        if [[ -z "$path" ]]; then
          warn "Project [setup] has an empty script path ${DIM}(script <path>)${RESET}" >&2
          return 1
        fi
        case "$path" in
          /*)
            warn "Project [setup] script path must be project-relative: ${BOLD}${path_disp}${RESET}" >&2
            return 1 ;;
        esac
        case "/$path/" in
          */../*)
            warn "Project [setup] script path may not contain '..': ${BOLD}${path_disp}${RESET}" >&2
            return 1 ;;
        esac

        local full="$project/$path"
        if [[ ! -f "$full" ]]; then
          warn "Project [setup] script not found: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        fi
        if [[ -L "$full" ]]; then
          warn "Project [setup] script may not be a symlink: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        fi

        local project_root parent_dir
        project_root="$(cd "$project" 2>/dev/null && pwd -P)" || {
          warn "Project [setup] script path could not be resolved: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        }
        parent_dir="$(cd "$(dirname "$full")" 2>/dev/null && pwd -P)" || {
          warn "Project [setup] script path could not be resolved: ${BOLD}${path_disp}${RESET}" >&2
          return 1
        }
        case "$parent_dir/" in
          "$project_root/"*) ;;
          *)
            warn "Project [setup] script escapes the project directory: ${BOLD}${path_disp}${RESET}" >&2
            return 1 ;;
        esac

        echo "# cleat setup: begin script $path"
        cat "$full"
        printf '\n'
        echo "# cleat setup: end script $path"
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done < <(_read_setup_from_file "$caps_file" "$box")
}

# Same fallback shape for the env file: .cleat.<box>.env else .cleat.env, so
# an az box's cloud credentials are never visible to a dev box.
_project_env_file() {
  local project="$1" box="${2:-main}"
  if [[ "$box" != "main" && -f "$project/.cleat.$box.env" ]]; then
    echo "$project/.cleat.$box.env"
  else
    echo "$project/.cleat.env"
  fi
}

# ── Resources: per-box memory limit ──────────────────────────────────────────
# Read one key from a config file's [<section>] section. Lines are
# `key = value` (spaces optional). Same parsing hygiene as [caps]: CRLF-safe,
# comment- and whitespace-tolerant. Prints the value, or nothing when absent.
_read_section_from_file() {
  local file="$1" section="$2" key="$3"
  [[ -r "$file" ]] || return 0
  local in_section=false line k v
  # `|| [[ -n "$line" ]]` so a final line with no trailing newline (a hand-edited
  # `.cleat` ending in `memory = 8g`) is still read; without it `read` returns
  # non-zero at EOF and the configured value is silently dropped, falling back
  # to the default. Matches _read_caps_from_file and _parse_env_file.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, silently voided the first section
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "[$section]" ]] && in_section=true || in_section=false
      continue
    fi
    $in_section || continue
    [[ "$line" == *"="* ]] || continue
    k="${line%%=*}"
    v="${line#*=}"
    k="${k%"${k##*[![:space:]]}"}"
    v="${v#"${v%%[![:space:]]*}"}"
    if [[ "$k" == "$key" ]]; then
      echo "$v"
      return 0
    fi
  done < "$file"
}

# Back-compat wrapper: every existing [resources] call site keeps its shape.
# Resources resolve per KEY, not per section: declaring [box.B.resources] with
# only `memory` must not silently un-declare `cpus`. caps/setup/fork are LIST
# sections and replace wholesale; this one is key/value and each key falls back
# on its own. $3 is the box.
_read_resource_from_file() {
  local _file="$1" _key="$2" _box="${3:-}" _v
  if [[ -n "$_box" ]]; then
    _v="$(_read_section_from_file "$_file" "box.${_box}.resources" "$_key")"
    [[ -n "$_v" ]] && { printf '%s\n' "$_v"; return 0; }
  fi
  _read_section_from_file "$_file" resources "$_key"
}

# A docker memory value: positive integer with optional b/k/m/g suffix.
_valid_memory_value() {
  [[ "$1" =~ ^[0-9]+[bkmgBKMG]?$ ]] || return 1
  local n="${1%[bkmgBKMG]}"
  [[ -n "$n" ]] || return 1
  # Per-suffix digit caps keep the byte conversion inside 64-bit arithmetic.
  # An overflowed product WRAPS (possibly negative), slips past the 8g project
  # clamp comparison, and then aborts `docker run` with an opaque daemon error,
  # so e.g. "99999999999g" must be rejected here, not discovered by dockerd.
  case "$1" in
    *[gG]) [[ ${#n} -le 9 ]] || return 1 ;;
    *[mM]) [[ ${#n} -le 12 ]] || return 1 ;;
    *[kK]) [[ ${#n} -le 15 ]] || return 1 ;;
    *)     [[ ${#n} -le 18 ]] || return 1 ;;
  esac
  # Force base-10: a leading zero ("08g") is otherwise an octal parse error in
  # bash arithmetic, and all-zero spellings ("0", "00g") mean --memory 0,
  # which docker treats as UNLIMITED, a clamp bypass rather than a limit.
  (( 10#$n > 0 )) || return 1
  # dockerd refuses anything under 6 MB ("Minimum memory limit allowed is
  # 6MB"). Without a floor here a forgotten suffix (`memory = 4`, meaning 4
  # BYTES) passed validation and then aborted `docker run` with a daemon error
  # the user had no way to trace back to their config line.
  local _b
  _b="$(_mem_to_bytes "$1")"
  [[ "$_b" =~ ^[0-9]+$ ]] || return 0
  (( _b >= 6291456 ))
}

# Convert a validated memory value to bytes (for clamping comparisons).
_mem_to_bytes() {
  local v="$1" n unit
  n="${v%[bkmgBKMG]}"
  unit="${v#"$n"}"
  n=$(( 10#$n ))   # strip leading zeros; bare $((08*…)) is an octal error
  case "$unit" in
    [gG]) echo $(( n * 1073741824 )) ;;
    [mM]) echo $(( n * 1048576 )) ;;
    [kK]) echo $(( n * 1024 )) ;;
    *)    echo "$n" ;;
  esac
}

# The Docker VM's total memory in bytes (empty when unknown). Split out so
# tests and the overload check can override/reuse it.
_docker_vm_memory() {
  docker info --format '{{.MemTotal}}' 2>/dev/null || true
}

# Round a byte count to the NEAREST whole GB. `docker info` reports the guest
# kernel's MemTotal, which is always a few hundred MB UNDER the Docker Desktop
# memory slider (the kernel reserves some at boot), so a 16 GB slider reports
# ~15.6 GiB. Flooring that prints a misleading "15 GB" AND, compared against an
# exact 16 GiB target, false-positives the undersized advisory on a VM that is
# in fact sized right. The slider moves in whole-GB steps and the reserve is
# under half a GB, so rounding to the nearest GB recovers the configured value:
# 15.6 → 16, while a genuine 15 GB slider (~14.6 GiB) still rounds to 15. Used
# for BOTH the displayed size and the threshold so the two can never contradict
# (no "shows 16 GB but warns it's too small"). Arg: $1 = bytes. Echoes whole GB
# (0 on missing/non-numeric input).
_vm_gb_rounded() {
  local b="${1:-0}"
  [[ "$b" =~ ^[0-9]+$ ]] || { echo 0; return; }
  # 10# forces base-10: a digit-only value can still carry a leading zero, which is
  # invalid octal and would abort the arithmetic under set -e (same guard the swap
  # reader uses). +0.5 GiB then floor = round-to-nearest.
  echo $(( (10#$b + 536870912) / 1073741824 ))
}

# The Docker Desktop settings file (empty when none is readable). `docker info`
# reports the VM's MemTotal but NOT its configured swap, so swap can only be read
# from Docker Desktop's own settings, which on macOS live under
# ~/Library/Group Containers/group.com.docker/. Newer Docker Desktop writes
# settings-store.json (PascalCase keys); older writes settings.json (camelCase).
# Try the newer one first. The base dir is overridable for tests.
_docker_desktop_settings_file() {
  # Only when Docker Desktop is the ACTIVE engine. The file is picked by path,
  # and that path survives uninstalling Desktop, so on a host that used to run
  # it and now runs OrbStack or Colima this returned a DEAD config. Every
  # reader below then described a VM that is not the one running the boxes:
  # wrong memory in the advisory, and a swap value that could raise the
  # blocking config gate over a setting the live engine does not even have.
  # _is_docker_desktop asks the daemon, so it follows the context.
  _is_docker_desktop || return 0
  local base="${_DD_SETTINGS_DIR:-$HOME/Library/Group Containers/group.com.docker}"
  local f
  for f in "$base/settings-store.json" "$base/settings.json"; do
    [[ -r "$f" ]] && { printf '%s' "$f"; return 0; }
  done
  return 0   # no file is the common case (non-Docker-Desktop, or a moved path):
             # return clean so a caller's `f="$(...)"` can never trip set -e.
}

# The Docker Desktop VM's configured SWAP size in bytes, empty when it can't be
# read. Scrapes "SwapMiB": <n> (case-insensitive, so it matches both the newer
# `SwapMiB` and the older `swapMiB`) from the settings file with a pure-bash grep
# (no jq dependency). Fail-soft is deliberate: a parse miss returns empty so the
# swap advisory NEVER fires on a guess, only on a value we definitely read. The
# raw value is overridable for tests via _DD_SWAP_BYTES.
_docker_vm_swap_bytes() {
  if [[ -n "${_DD_SWAP_BYTES:-}" ]]; then
    [[ "${_DD_SWAP_BYTES}" =~ ^[0-9]+$ ]] && printf '%s' "${_DD_SWAP_BYTES}"
    return 0
  fi
  local f mib
  f="$(_docker_desktop_settings_file)"
  [[ -n "$f" ]] || return 0
  # `|| true` keeps a no-match (grep exits 1) from tripping `set -e` inside the
  # assignment under pipefail; the regex guard below handles the empty result.
  mib="$(grep -iEo '"swapmib"[[:space:]]*:[[:space:]]*[0-9]+' "$f" 2>/dev/null \
           | grep -Eo '[0-9]+' | tail -1 || true)"
  [[ "$mib" =~ ^[0-9]+$ ]] || return 0
  # 10# forces base-10: a leading-zero value (a hand-edited "08"/"09") passes the
  # digit guard but is invalid octal, which under set -e aborts the arithmetic and
  # leaks an error to the user; "0001024" would silently misread as octal. Same
  # guard _mem_to_bytes uses. Fail-soft stays intact.
  printf '%s' "$(( 10#$mib * 1048576 ))"
}

# The Docker Desktop VM's CONFIGURED memory slider in whole GB, empty when it
# can't be read. `docker info` reports the guest kernel's MemTotal, which sits a
# few hundred MB to over a GiB UNDER the slider (the kernel reserves memory at
# boot and the reserve GROWS with VM size), so on a large VM round-to-nearest
# can't recover the slider: a 24 GB slider reads ~23.4 GiB and rounds to 23, and
# MemTotal alone can't even tell a 23 GB slider from a 24 GB one once the reserve
# is ~0.6 GiB. The true value lives only in Docker Desktop's settings: MemoryMiB
# (newer, PascalCase) or memoryMiB (older, camelCase). Docker Desktop labels
# these GiB as "GB", which is exactly what we print. Fail-soft: a parse miss
# returns empty so the caller falls back to MemTotal rounding (Linux, no Docker
# Desktop, a moved path). Rounds MiB -> GB through `_vm_gb_rounded` (the same
# round-to-nearest the fallback uses), so a non-1024-aligned MemoryMiB (a
# hand-edited or non-standard-default value) reports the slider the user set
# (7936 -> 8) instead of truncating it (7) and re-tripping the undersized nag.
# Whole-GB sliders stay exact (24576 -> 24). Overridable for tests via _DD_MEMORY_MIB.
_docker_vm_configured_gb() {
  if [[ -n "${_DD_MEMORY_MIB:-}" ]]; then
    # 10# forces base-10 (a hand-edited leading-zero value is invalid octal and
    # would abort the arithmetic under set -e), same guard the swap reader uses.
    [[ "${_DD_MEMORY_MIB}" =~ ^[0-9]+$ ]] && _vm_gb_rounded "$(( 10#${_DD_MEMORY_MIB} * 1048576 ))"
    return 0
  fi
  local f mib
  f="$(_docker_desktop_settings_file)"
  [[ -n "$f" ]] || return 0
  # `|| true` keeps a no-match (grep exits 1) from tripping `set -e` under
  # pipefail; the regex guard below handles the empty result. The leading-quote
  # anchor ("memorymib") never matches SwapMiB / DiskSizeMiB / *ReservationMiB.
  mib="$(grep -iEo '"memorymib"[[:space:]]*:[[:space:]]*[0-9]+' "$f" 2>/dev/null \
           | grep -Eo '[0-9]+' | tail -1 || true)"
  [[ "$mib" =~ ^[0-9]+$ ]] || return 0
  _vm_gb_rounded "$(( 10#$mib * 1048576 ))"
}

# The VM size to DISPLAY and to THRESHOLD against, in whole GB. Prefer the
# configured Docker Desktop slider (exact); fall back to rounding the kernel's
# MemTotal when the settings can't be read. Display AND every threshold must
# call THIS one helper so a "shows 24 GB but warns it's too small" contradiction
# is impossible by construction. Arg: $1 = MemTotal bytes (for the fallback).
_docker_vm_display_gb() {
  local cfg
  cfg="$(_docker_vm_configured_gb)"
  if [[ "$cfg" =~ ^[0-9]+$ ]] && (( cfg > 0 )); then
    printf '%s' "$cfg"
    return 0
  fi
  _vm_gb_rounded "${1:-0}"
}

# Total physical RAM of the HOST machine in BYTES, empty when unknown. Used to
# judge whether the Docker Desktop VM is sized sensibly *relative to the host*
# (concept/22: a VM of ~half the host RAM). macOS: `sysctl hw.memsize` (already
# bytes). Linux: read MemTotal (kB) from /proc/meminfo and scale in bash, NOT
# `awk '{print $2 * 1024}'`, which makes awk do float math and print scientific
# notation (e.g. `3.36e+10`) for real RAM sizes, failing the `^[0-9]+$` check
# every consumer uses (→ host RAM silently treated as unknown on Linux). The
# meminfo path is overridable for tests. Empty on any failure → callers fall
# back to the absolute floor.
_host_total_memory() {
  if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
    sysctl -n hw.memsize 2>/dev/null || true
  elif [[ -r "${_MEMINFO_FILE:-/proc/meminfo}" ]]; then
    local kb
    kb="$(awk '/^MemTotal:/ { print $2; exit }' "${_MEMINFO_FILE:-/proc/meminfo}" 2>/dev/null)"
    # Explicit if, not a tail `[[ ]] && echo`: a garbled MemTotal would make
    # that list rc 1, and a function ending on rc 1 kills the strict-mode
    # binary at the caller (the kit-writer class of bug).
    if [[ "$kb" =~ ^[0-9]+$ ]]; then
      echo $(( kb * 1024 ))
    fi
  fi
}

# Default per-box memory: a quarter of the Docker VM's memory, clamped to
# [4g, 8g]. A cgroup limit is a ceiling, not a reservation: a box only uses
# what it touches, so a bigger floor only bites when several boxes spike at
# once, which the on-start overload notice and undersized-VM advisory already
# warn about. The 2g floor that shipped in v0.16.0 was too tight for a single
# 1M-context Opus session: at 60% (the NODE_OPTIONS heap pin) that's a ~1.2g
# heap, which GC-thrashes and OOM-kills under a build/test. 4g lifts that to
# ~2.4g. Still far under the old fixed 8g that exceeded entire default VMs.
# Unknown VM size falls back to 2g: we can't gauge overcommit risk on a VM we
# can't size, so we stay conservative there rather than commit to the 4g floor.
_default_box_memory() {
  local vm_bytes
  vm_bytes="$(_docker_vm_memory)"
  if ! [[ "$vm_bytes" =~ ^[0-9]+$ ]] || (( vm_bytes == 0 )); then
    echo "2g"
    return
  fi
  local quarter_gb=$(( vm_bytes / 4 / 1073741824 ))
  if (( quarter_gb < 4 )); then
    echo "4g"
  elif (( quarter_gb > 8 )); then
    echo "8g"
  else
    echo "${quarter_gb}g"
  fi
}

# Resolve the per-box memory limit: project box config ([resources] memory in
# .cleat.<box>, else .cleat) > global config > VM-derived default. Invalid
# values fall through to the next source (a typo must not abort `docker run`
# with an opaque daemon error). PROJECT-supplied values are clamped to 8g,
# .cleat ships with the repo, and an untrusted project must not be able to
# re-introduce VM-wide overcommit; the user's own global config is not capped.
resolve_box_memory() {
  local project="$1" box="${2:-main}"
  local v

  v="$(_read_resource_from_file "$(_project_caps_file "$project")" memory "$box")"
  if [[ -n "$v" ]]; then
    if _valid_memory_value "$v"; then
      if (( $(_mem_to_bytes "$v") > 8589934592 )); then
        echo "8g"
      else
        echo "$v"
      fi
      return 0
    fi
    warn "Ignoring invalid memory '$v' in project config ${DIM}(use e.g. 2g, 4096m)${RESET}" >&2
  fi

  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" memory)"
  if [[ -n "$v" ]]; then
    if _valid_memory_value "$v"; then
      echo "$v"
      return 0
    fi
    warn "Ignoring invalid memory '$v' in global config ${DIM}(use e.g. 2g, 4096m)${RESET}" >&2
  fi

  _default_box_memory
}

# A docker --cpus value: positive decimal (2, 1.5, 0.5). Length-capped so the
# clamp arithmetic below can't overflow; zero is rejected (docker reads 0 as
# "no limit", not a limit).
_valid_cpus_value() {
  [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  [[ ${#1} -le 7 ]] || return 1
  local digits="${1//./}"
  (( 10#$digits > 0 ))
}

# The daemon's core count (empty when unknown). Seam for tests + the clamp.
_daemon_ncpu() {
  docker info --format '{{.NCPU}}' 2>/dev/null || true
}

# Resolve the per-box CPU limit: project box config > global config > NO
# default. Memory gets a default ceiling because memory is held, not shared;
# CPU is work-conserving: an idle core costs nothing and the scheduler
# already balances competing boxes, so an unconfigured box keeps all cores.
# PROJECT-supplied values are clamped to the daemon's core count: --cpus
# above NCPU is a dockerd error, so an untrusted .cleat could otherwise abort
# `docker run` outright. The user's own global config is passed through
# (dockerd validates it against the actual machine).
resolve_box_cpus() {
  local project="$1" box="${2:-main}"
  local v ncpu

  v="$(_read_resource_from_file "$(_project_caps_file "$project")" cpus "$box")"
  if [[ -n "$v" ]]; then
    if _valid_cpus_value "$v"; then
      ncpu="$(_daemon_ncpu)"
      if [[ "$ncpu" =~ ^[0-9]+$ ]] && (( ncpu > 0 )) && \
         awk -v v="$v" -v n="$ncpu" 'BEGIN { exit !(v > n) }'; then
        echo "$ncpu"
      else
        echo "$v"
      fi
      return 0
    fi
    warn "Ignoring invalid cpus '$v' in project config ${DIM}(use e.g. 2, 1.5)${RESET}" >&2
  fi

  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" cpus)"
  if [[ -n "$v" ]]; then
    if _valid_cpus_value "$v"; then
      echo "$v"
      return 0
    fi
    warn "Ignoring invalid cpus '$v' in global config ${DIM}(use e.g. 2, 1.5)${RESET}" >&2
  fi
}

# ── Configured resources, for the config fingerprint ONLY ────────────────────
# The fingerprint must reflect what the USER declared in config, never a value
# the CLI derives at runtime. resolve_box_memory falls back to a VM-derived
# default (_default_box_memory) and resolve_box_cpus clamps to the daemon's core
# count, so both MOVE when the Docker VM is resized or the CLI's own default
# formula changes between versions, even though the user touched nothing. Folding
# those into the fingerprint quietly reintroduced the very version/VM coupling the
# VERSION exclusion was meant to kill: a CLI upgrade or a memory-slider change
# would shift the hash and fire a false "config changed, recreate?" on an
# untouched box. These variants read config files ONLY (project box > project >
# global) and emit nothing when unset, so an unconfigured box hashes the same
# regardless of VM size or CLI version. Values are validated but NOT warned about
# here (the real resolvers warn during the actual run); an invalid value is
# ignored so a typo can't change the fingerprint either.
_configured_box_memory() {
  local project="$1" box="${2:-main}" v
  v="$(_read_resource_from_file "$(_project_caps_file "$project")" memory "$box")"
  if [[ -n "$v" ]] && _valid_memory_value "$v"; then
    # Mirror resolve_box_memory's project clamp so the fingerprint matches the
    # ceiling the container would actually get (deterministic, not VM-dependent).
    if (( $(_mem_to_bytes "$v") > 8589934592 )); then echo "8g"; else echo "$v"; fi
    return 0
  fi
  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" memory)"
  if [[ -n "$v" ]] && _valid_memory_value "$v"; then
    echo "$v"
    return 0
  fi
  return 0
}

_configured_box_cpus() {
  local project="$1" box="${2:-main}" v
  v="$(_read_resource_from_file "$(_project_caps_file "$project")" cpus "$box")"
  if [[ -n "$v" ]] && _valid_cpus_value "$v"; then
    echo "$v"
    return 0
  fi
  v="$(_read_resource_from_file "$CLEAT_GLOBAL_CONFIG" cpus)"
  if [[ -n "$v" ]] && _valid_cpus_value "$v"; then
    echo "$v"
    return 0
  fi
  return 0
}

# ── Box descriptions (host-side metadata) ────────────────────────────────────
# An optional one-line human description per box, keyed by container name so it
# survives stop/resume/recreate and is removed with the box. Text is always
# written with printf and printed as data, never eval'd. See
# concept/20-boxes.md for why this is a host-side file, not a Docker label.
_box_desc_file() {
  echo "$CLEAT_BOXES_DIR/$1"
}

_box_desc_read() {
  local f
  f="$(_box_desc_file "$1")"
  [[ -f "$f" ]] && cat "$f" || true
}

_box_desc_write() {
  local cname="$1" text="$2"
  # Collapse CR/LF so a description is always a single line (it renders as a
  # one-line sub-entry in status/ps; see concept/20-boxes.md).
  text="$(printf '%s' "$text" | tr '\r\n' '  ')"
  mkdir -p "$CLEAT_BOXES_DIR"
  printf '%s\n' "$text" > "$(_box_desc_file "$cname")"
}

_box_desc_remove() {
  rm -f "$(_box_desc_file "$1")" 2>/dev/null || true
}

# ── Kits ─────────────────────────────────────────────────────────────────────
#
# A kit is a maintainer-curated Claude Code pre-configuration (a CLAUDE.md
# policy fragment + custom subagents) enabled per box: `cleat kit <name>`.
# Inside the box, three read-only masks over the shared ~/.claude mount
# replace what Claude sees at ~/.claude/CLAUDE.md, ~/.claude/agents, and
# ~/.claude/commands with content generated host-side in
# $CLEAT_RUN_DIR/<cname>/kit/ on every create/start: the user's own config
# first, the kit merged on top (commands is always a plain pass-through copy;
# kits ship no commands). The kit content is never written to the host
# ~/.claude; native claude never sees the kit. Kits ship instructions and
# subagents only: no hooks, no settings, nothing that executes as a program.
# Full design: concept/34-kits.md.

_box_kit_file() {
  echo "$CLEAT_KITS_DIR/$1"
}

_box_kit_read() {
  local f
  f="$(_box_kit_file "$1")"
  [[ -f "$f" ]] && cat "$f" || true
}

_box_kit_write() {
  local cname="$1" kit="$2"
  mkdir -p "$CLEAT_KITS_DIR"
  printf '%s\n' "$kit" > "$(_box_kit_file "$cname")"
}

_box_kit_remove() {
  rm -f "$(_box_kit_file "$1")" 2>/dev/null || true
}

_kit_known() {
  local k
  for k in "${KNOWN_KITS[@]}"; do
    [[ "$k" == "$1" ]] && return 0
  done
  return 1
}

# Effective model for a kit agent role. Users can pin or swap the models kits
# use via a [kits] section in the GLOBAL config (trusted, user-authored):
#   [kits]
#   worker_model = claude-sonnet-5
#   scout_model  = haiku
# Read at every overlay generation, so a change lands next session with no
# recreate. Global-only by design: the value is written into agent YAML
# frontmatter, so it must never come from a project's untrusted .cleat.
# Values are sanitized to a bare model token (letters, digits, dot, dash,
# underscore); anything else falls back to the default alias, fail-safe
# (this is the frontmatter-injection guard, do not widen it). The planner has
# no knob: it is the session's main-loop model by definition.
_kit_agent_model() {
  local role="$1" default="$2" v
  v="$(_read_section_from_file "$CLEAT_GLOBAL_CONFIG" kits "${role}_model")"
  if [[ -n "$v" && "$v" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "$v"
  else
    echo "$default"
  fi
}

# In-box operational notes composed into EVERY box's ~/.claude/CLAUDE.md
# (vanilla and kitted) by _generate_kit_overlay. The same text is baked into
# the image at this path (docker/CLAUDE.md) since v0.1.0, but a bake below a
# bind mount is invisible: the host ~/.claude dir mount (and now the mask)
# always shadowed it, so no box ever saw these rules until the overlay
# started carrying them. MUST stay byte-identical to docker/CLAUDE.md (a
# guard test enforces it): the bake still covers any box without the mask.
_box_notes_claude_md() {
  cat << 'BOX_NOTES_EOF'
# Clipboard

This environment runs inside Docker with clipboard bridge forwarding.
`xclip`, `pbcopy`, `xsel`, and `clip` all work for COPYING text to the host clipboard.
The primary mechanism writes to a shared file that the host picks up automatically.
OSC 52 terminal escape sequences are used as a fallback when the bridge is unavailable.
Paste/read-back (`xclip -o`, `xsel -o`, `pbpaste`) is not supported. Do NOT try to verify clipboard contents after copying.
The copy succeeded if the command exits 0. Do not run a second command to check.
BOX_NOTES_EOF
}

# Stage-0 "concierge" provisioning notes, composed into EVERY box's
# ~/.claude/CLAUDE.md (vanilla and kitted) by _generate_kit_overlay, right
# after the box notes. Unlike _box_notes_claude_md, this fragment is
# CLI-generated only: it is deliberately not baked into docker/CLAUDE.md,
# which must stay byte-identical to _box_notes_claude_md per the guard test.
_provisioning_notes_claude_md() {
  cat << 'PROVISIONING_NOTES_EOF'
# Installing tools

You are inside a Cleat box (a Docker container). `sudo apt-get install <pkg>` works
(passwordless sudo) and installs persist across `cleat stop`/`cleat start`. They do
NOT survive a container recreate (config changes, image updates, `cleat rm`).
For tools this project always needs, add a `[setup]` section to the project's
`.cleat` file. Its lines are shell commands that run automatically once per
container, as the `coder` user inside the box, after every create or recreate.
The user reviews and approves them once; editing the section triggers a fresh
review, never a container recreate.

[setup]
sudo apt-get update
sudo apt-get install -y <pkg>

A line `script ./provision.sh` inlines that repo file's contents at that position.
Never suggest forking Cleat, editing its Dockerfile, or `cleat rebuild` to add
tools; `[setup]` is the supported path. There is no egress allowlist: the box has
full network access.
PROVISIONING_NOTES_EOF
}

# One-paragraph description for the library listing and the confirm screen.
# Deliberately mechanical claims only: planning runs on your session's model,
# execution bills at worker rates. Never add outcome/quality percentages here;
# the cookbook's benchmark numbers belong to its API harness, not this
# adaptation (concept/34).
_kit_description() {
  case "$1" in
    plan-big-execute-small)
      echo "Run your session on Fable 5.1: it plans and reviews while worker and scout subagents (Sonnet 5 by default) execute and explore, each in its own context window so the main session stays lean. Flagship judgment on the plan and every review, the mechanical bulk billed at the worker model's rate, so heavy work burns your rate limit far slower. Adapted from Anthropic's coordinator-pattern cookbook."
      ;;
  esac
}

# Post-enable nudge, per kit. The flagship pairing names Fable 5.1 as the
# planner, but the kit never touches the session model (concept/34): the
# user's knob is /model inside the session, so name it at the moment they
# are about to start one. Claude Code saves /model as the default for new
# sessions, so this is a one-time step, not a ritual.
# One dim provenance line for the confirm screen. The full URL is long, so
# it lives in `cleat kit show`; this line says where the pattern comes from
# and where to read it. Same claim discipline as _kit_description.
_kit_reference_line() {
  case "$1" in
    plan-big-execute-small)
      echo -e "  ${DIM}Pattern from Anthropic's cookbook: big models for planning,${RESET}"
      echo -e "  ${DIM}small models for execution. Link: cleat kit show $1${RESET}"
      ;;
  esac
}

_kit_post_enable_hint() {
  case "$1" in
    plan-big-execute-small)
      echo -e "    ${DIM}The planner is your session's model: pick Fable 5.1 with ${RESET}${BOLD}/model${RESET}${DIM} in-session (it sticks for new sessions).${RESET}"
      ;;
  esac
}

# The confirm screen's "what this kit adds" lines. Models shown are the
# EFFECTIVE ones (after [kits] overrides), so the screen never lies.
_kit_confirm_lines() {
  case "$1" in
    plan-big-execute-small)
      local _w _s
      _w="$(_kit_agent_model worker sonnet)"
      _s="$(_kit_agent_model scout sonnet)"
      echo -e "    ${DIM}agents${RESET}     worker (model: ${_w}), scout (model: ${_s}, read-only by contract)"
      echo -e "    ${DIM}CLAUDE.md${RESET}  a delegation policy section (appended, yours stays)"
      echo -e "    ${DIM}planner${RESET}    your session's model, not changed by the kit"
      ;;
  esac
}

# Emit a kit's files into <destdir>: CLAUDE.md (the policy fragment appended
# under the marked header by _generate_kit_overlay) and agents/kit-*.md. The
# heredocs here are the kit: `cleat kit show` prints from this function, and
# kits update in lockstep with CLI releases. Kit content deliberately makes no
# performance-number claims: the cookbook's benchmarks belong to its API
# harness, not this prompt-level adaptation (concept/34).
# The `name:` a Claude Code agent declares in its YAML frontmatter (this is
# what Claude dispatches by, NOT the filename). Prints empty when absent.
_agent_name() {
  local f="$1" line
  line="$(grep -m1 '^name:' "$f" 2>/dev/null)" || true
  line="${line#name:}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s' "$line"
}

_kit_emit() {
  local kit="$1" dest="$2"
  mkdir -p "$dest/agents"
  case "$kit" in
    plan-big-execute-small)
      cat > "$dest/CLAUDE.md" << 'KIT_EOF'
You are the planner in a plan-big / execute-small team.

- For any task with real mechanical editing (multi-file, or a sizable
  change within one file): write the plan first, then dispatch each
  self-contained chunk to the `worker` agent, one at a time. Dispatch,
  review, then dispatch the next. Never launch several workers in one
  message; parallel dispatch has scrambled briefs and clobbered files.
  A dispatch names the files, the exact change, the constraints, and
  the test to run; the worker executes, it does not re-derive context.
  Prefer fewer, larger chunks; every dispatch pays a fixed overhead.
- Review every worker result before dispatching the next dependent chunk.
  If a result is wrong or incomplete, dispatch a corrected chunk instead
  of fixing it yourself. If a dispatch fails with an error instead of a
  report, re-dispatch the same chunk unchanged; never absorb its work
  into the main loop. You own integration and the final review.
- Use the `scout` agent for all code exploration (call sites, structure,
  impact, the research behind a plan); never search in the main loop.
  Plan from scout's findings, not from memory: when a premise decides
  the plan's shape (a call-site list, an assumed behavior), have scout
  verify it before you dispatch workers.
  When the judgment is in the raw code itself (a subtle bug, a delicate
  refactor), have scout locate it, then read the located code yourself.
- `worker` and `scout` are the only subagents you dispatch. Built-in
  agents (Explore, Plan, general-purpose) run on expensive models; do
  not substitute them. If worker or scout is missing, tell the user the
  kit is broken instead of quietly working around it.
- The same routing applies inside workflows: pass agentType: 'scout' on
  exploration stages and agentType: 'worker' on implementation stages.
  An agent() call with no agentType runs on the expensive session model.
- Keep the main loop for: planning, judgment calls, reviewing diffs,
  integration, and talking to the user.
- Do not delegate trivial edits, even multi-file ones; just make them.
KIT_EOF
      # Frontmatter via an UNQUOTED heredoc so the effective (possibly
      # [kits]-overridden) model lands in it; bodies stay quoted. The model
      # value is sanitized by _kit_agent_model, never raw config text.
      # Frontmatter is strict YAML: an unquoted value (description) must
      # never contain colon-space or end in a colon, on any wrapped line.
      # Claude Code silently drops an agent whose frontmatter fails to
      # parse (the v1.2.0 scout bug: "all exploration: finding").
      local _worker_model _scout_model
      _worker_model="$(_kit_agent_model worker sonnet)"
      _scout_model="$(_kit_agent_model scout sonnet)"
      cat > "$dest/agents/kit-worker.md" << KIT_FM
---
name: worker
description: Implementation executor. Dispatch one precise, self-contained
  task with full context. It executes exactly that and reports back.
tools: Read, Edit, Write, Grep, Glob, Bash
model: ${_worker_model}
---
KIT_FM
      cat >> "$dest/agents/kit-worker.md" << 'KIT_EOF'

You execute exactly the task you are given, nothing more.

- Implement precisely what the dispatch describes. Do not expand scope,
  refactor adjacent code, or re-plan the approach.
- If the task is ambiguous or turns out to be impossible as specified,
  stop and report the blocker instead of improvising.
- Match the surrounding code style. Run the narrowest relevant test if
  one is named in the dispatch.
- Open the report with a status: done as dispatched, done with
  deviations (name them), partial (what remains), or blocked (why).
- Report back: what changed (files and line ranges), the diff when it
  is short (for a large change, per-file line ranges and one line per
  change; the planner reviews with git diff), test results distilled
  to pass or fail plus the failing cases, and anything the planner
  must know. Never paste full logs or files you only read.
KIT_EOF
      cat > "$dest/agents/kit-scout.md" << KIT_FM
---
name: scout
description: Read-only codebase scout. Use for all exploration. It finds
  call sites, maps structure, locates definitions, and sizes a change.
tools: Read, Grep, Glob, Bash
model: ${_scout_model}
---
KIT_FM
      cat >> "$dest/agents/kit-scout.md" << 'KIT_EOF'

You explore and report. You never modify anything.

- Answer the specific question asked: locations (file:line), shapes,
  call sites, blast radius.
- Read only what the question needs. Prefer excerpts over whole files.
- Bash is for read-only inspection (ls, git log, git grep) only.
- Report findings compactly: paths, line numbers, one-line conclusions.
- If you find nothing, say so: what you searched and what remains
  unknown. Never guess.
KIT_EOF
      ;;
  esac
}

# Does this container mount the kit overlay? Boxes created before the kit
# feature do not (bind mounts are baked at create); they gain the mounts on
# their next natural recreate, or explicitly via `cleat kit` which offers the
# rebuild. Unreadable inspect degrades to "no mounts", the safe answer for
# both callers (skip the regen / route the enable through the rebuild offer).
# DELIBERATELY keyed on CLAUDE.md alone, never on the full mask set: a box
# created before a LATER mask (skills, plugins) still has a live overlay that
# must keep tracking the user's content. Tightening this to "has every mask"
# would freeze those boxes' CLAUDE.md/agents/commands at whatever they last
# held. The missing-mask signal is _maybe_note_missing_kit_masks, not this.
_container_has_kit_mounts() {
  local dests
  dests="$(docker inspect "$1" --format '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null)" || return 1
  printf '%s\n' "$dests" | grep -qx '/home/coder/.claude/CLAUDE.md'
}

# Boxes created before the read-only ~/.claude masks existed (or before the
# skills and plugins masks landed) keep those host-level surfaces writable
# until recreated: bind mounts are baked at create, and the config fingerprint
# deliberately excludes mounts. Say so on every start until fixed, the same
# always-on treatment as the undersized-VM advisory: a silent protection gap
# is worse than a repeated note. Unreadable inspect stays silent, matching
# _container_has_kit_mounts (the box may be mid-recreate).
_maybe_note_missing_kit_masks() {
  local cname="$1"
  container_exists "$cname" || return 0
  local dests d
  dests="$(docker inspect "$cname" --format '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null)" || return 0
  # The instruction-surface masks join this list rather than bumping
  # _IMAGE_SPEC_VERSION. That constant means image CONTENT, a mount is not image
  # content, and the bump would cost every user the apt-get state inside their
  # box. The config fingerprint does not cover mounts either, so this advisory
  # is the only signal an existing box gets, which is the deliberate trade: it
  # tells, it never forces.
  local _instr
  # The remedy names the box. A bare `cleat rm` removes main without a prompt,
  # so telling a named box to run `cleat rm && cleat` removed the wrong one.
  local _b="${_BOX:-main}" _fix="cleat rm && cleat"
  if [[ "$_b" != main ]]; then
    _fix="cleat rm ${_b} && cleat start ${_b}"
  fi
  for d in /home/coder/.claude/CLAUDE.md /home/coder/.claude/agents \
           /home/coder/.claude/commands /home/coder/.claude/skills \
           /home/coder/.claude/plugins; do
    if ! printf '%s\n' "$dests" | grep -qx "$d"; then
      info "This box predates the read-only ~/.claude masks. Recreate to enable them: ${BOLD}${_fix}${RESET}"
      return 0
    fi
  done
  # The per-box private dirs gained session-env, daemon and seed-admin, which the
  # host's own Claude Code executes content from. A box without those mounts can
  # still write the host's copies, so it is told the same way.
  local _priv
  for _priv in $_CLAUDE_PRIVATE_DIRS; do
    if ! printf '%s\n' "$dests" | grep -qx "/home/coder/.claude/$_priv"; then
      info "This box predates the per-box ~/.claude state directories. Recreate to enable them: ${BOLD}${_fix}${RESET}"
      return 0
    fi
  done
  for _instr in $_CLAUDE_INSTR_DIRS $_CLAUDE_INSTR_FILES; do
    if ! printf '%s\n' "$dests" | grep -qx "/home/coder/.claude/$_instr"; then
      info "This box predates the ~/.claude instruction-surface masks. Recreate to enable them: ${BOLD}${_fix}${RESET}"
      return 0
    fi
  done
}

# ~/.claude/.config.json, the one host global config no mount can protect.
#
# Claude Code checks for that file first and, when it exists, loads it as its
# global config INSTEAD of ~/.claude.json and starts every MCP server it lists.
# Measured on 2.1.270: a planted file with a shell command under mcpServers ran
# that command at the next launch. A box reaches it through the read-write
# ~/.claude root, with no capability.
#
# No mask can close it. Every bind needs its target to exist on the host
# (VirtioFS refuses a missing one and runc creates one), and a target that
# exists at that path IS the file the host then loads in place of the user's
# real config. The fix is the box-private ~/.claude that concept/41 records as
# the direction. Until then this is visibility, not a boundary.
#
# Stateless on purpose. A user whose real config still lives in that legacy
# file is exposed the same way on every start, so the note repeats, which is
# the same always-on treatment as the missing-mask note above.
_host_global_config_present() {
  [[ -e "${HOME}/.claude/.config.json" || -L "${HOME}/.claude/.config.json" ]]
}

_maybe_note_host_global_config() {
  _host_global_config_present || return 0
  warn "${BOLD}~/.claude/.config.json${RESET} exists. Claude Code on this machine loads it as its global config and starts every MCP server it lists."
  echo -e "    ${DIM}A box can write that file and Cleat cannot mask it. Cleat never creates it. If you did not either, read it before you run claude here.${RESET}"
}

_maybe_report_host_global_config_appeared() {
  [[ "${1:-1}" == "0" ]] || return 0
  _host_global_config_present || return 0
  warn "${BOLD}~/.claude/.config.json${RESET} appeared during this session. Claude Code on this machine loads it as its global config and starts every MCP server it lists."
  echo -e "    ${DIM}Cleat never creates it. Read it before you run claude on this machine.${RESET}"
}

# VirtioFS rejects nested mounts whose target is missing inside the parent
# bind source; ensure every mask target exists on the host (inert for native
# claude: an empty CLAUDE.md and empty agents/commands/skills/plugins dirs are
# nothing to it). Modern Docker Desktop auto-creates a missing DIRECTORY
# target, but as root, which would leave an unwritable dir in the user's home
# on rootful Linux; creating them here keeps them owned by the user.
# A broken symlink at any target, or a regular file where a directory belongs,
# would make the touch/mkdir fail with a raw trace under strict mode (and if it
# reached Docker, an opaque rc=125 "not a directory" OCI error); refuse both
# with a clear remedy instead. We never delete a user's symlink, even a
# dangling one: it may point into a dotfiles repo not checked out yet.
_ensure_kit_mask_targets() {
  local _t
  for _t in "${HOME}/.claude/CLAUDE.md" "${HOME}/.claude/agents" \
            "${HOME}/.claude/commands" "${HOME}/.claude/skills" \
            "${HOME}/.claude/plugins"; do
    if [[ -L "$_t" && ! -e "$_t" ]]; then
      error "${_t/#${HOME}/~} is a broken symlink. Fix or remove it, then rerun."
      return 1
    fi
  done
  # The four dir targets must not be regular files. CLAUDE.md is excluded: it
  # is the one target that is supposed to be a file.
  for _t in "${HOME}/.claude/agents" "${HOME}/.claude/commands" \
            "${HOME}/.claude/skills" "${HOME}/.claude/plugins"; do
    if [[ -e "$_t" && ! -d "$_t" ]]; then
      error "${_t/#${HOME}/~} is not a directory. Move or remove it, then rerun."
      return 1
    fi
  done
  # The containment and instruction-surface targets get the same two refusals.
  # Every one of them is emitted as a bind on every box, so skipping a wrong
  # shape here only moved the failure to docker run, where it is the opaque
  # rc=125 above. A dir target must be a directory (or a link to one) and a
  # file target must not be a directory. Nothing here deletes the user's path.
  for _t in $_CLAUDE_PRIVATE_DIRS $_CLAUDE_INSTR_DIRS $_CLAUDE_INSTR_FILES; do
    _t="${HOME}/.claude/$_t"
    if [[ -L "$_t" && ! -e "$_t" ]]; then
      error "${_t/#${HOME}/~} is a broken symlink. Fix or remove it, then rerun."
      return 1
    fi
  done
  for _t in $_CLAUDE_PRIVATE_DIRS $_CLAUDE_INSTR_DIRS; do
    _t="${HOME}/.claude/$_t"
    if [[ -e "$_t" && ! -d "$_t" ]]; then
      error "${_t/#${HOME}/~} is not a directory. Move or remove it, then rerun."
      return 1
    fi
  done
  for _t in $_CLAUDE_INSTR_FILES; do
    _t="${HOME}/.claude/$_t"
    if [[ -d "$_t" ]]; then
      error "${_t/#${HOME}/~} is a directory. Move or remove it, then rerun."
      return 1
    fi
  done
  touch "${HOME}/.claude/CLAUDE.md"
  mkdir -p "${HOME}/.claude/agents" "${HOME}/.claude/commands" \
           "${HOME}/.claude/skills" "${HOME}/.claude/plugins"
  # Containment targets. Same VirtioFS rule: the nested mount's target must
  # exist inside the parent bind source. These are only mountpoints, and the
  # host content behind them is never mounted into the box. One that already
  # exists is the user's and keeps its mode. One created here drops group and
  # other write, which is what Claude Code demands of seed-admin/.
  local _p
  for _p in $_CLAUDE_PRIVATE_DIRS; do
    [[ -d "${HOME}/.claude/$_p" ]] && continue
    mkdir -p "${HOME}/.claude/$_p" 2>/dev/null || true
    chmod go-w "${HOME}/.claude/$_p" 2>/dev/null || true
  done
  # Instruction-surface targets, same rule again. Every one of these is absent
  # on a live box, so this creates them, which is the point: an empty directory
  # and an inert placeholder are nothing to the user's own Claude Code, and
  # without the target the mask cannot mount at all on VirtioFS.
  for _p in $_CLAUDE_INSTR_DIRS; do
    [[ -d "${HOME}/.claude/$_p" ]] && continue
    mkdir -p "${HOME}/.claude/$_p" 2>/dev/null || true
  done
  for _p in $_CLAUDE_INSTR_FILES; do
    # Never touch one that already exists: it is the user's, and its content is
    # not ours to replace. Never follow a symlink into one either.
    [[ -e "${HOME}/.claude/$_p" || -L "${HOME}/.claude/$_p" ]] && continue
    _claude_instr_placeholder "$_p" > "${HOME}/.claude/$_p" 2>/dev/null || true
  done
  # The one exception. An earlier unreleased build wrote a bare `{}` as the
  # keybindings.json placeholder, and the keybindings loader rejects that shape
  # outright. A file holding exactly that is Cleat's own, carries no binding,
  # and is repaired in place. Anything else in it is the user's.
  local _kb="${HOME}/.claude/keybindings.json"
  if [[ -f "$_kb" && ! -L "$_kb" ]] && [[ "$(cat "$_kb" 2>/dev/null)" == "{}" ]]; then
    _claude_instr_placeholder keybindings.json > "$_kb" 2>/dev/null || true
  fi
}

# (Re)generate the kit overlay content for a box: the three surfaces masked
# over ~/.claude inside the container. Called at create (cmd_run) and refreshed on
# every start/resume, mirroring the settings overlay. Merge semantics
# (concept/34): the user's real global CLAUDE.md comes FIRST byte-for-byte
# with the kit fragment appended under a marked header; the agents dir is a
# copy of the user's agents plus the kit's kit-*.md files (a same-named user
# file wins). Vanilla boxes (no kit) get a plain pass-through copy, so the
# mount shape is uniform and a kit change is never a recreate.
_generate_kit_overlay() {
  local cname="$1"
  local kit_dir="$CLEAT_RUN_DIR/${cname}/kit"
  local kit
  kit="$(_box_kit_read "$cname")"
  # An unknown selection (hand-edited file, or written by a different CLI
  # version) degrades to vanilla rather than failing the start.
  if [[ -n "$kit" ]] && ! _kit_known "$kit"; then
    kit=""
  fi

  # Self-heal wrong types from manual tampering: a directory where the file
  # goes (or vice versa) would fail the writes below under strict mode. -L is
  # in the dir checks on purpose: a SYMLINK at an overlay dir path is not
  # caught by -f, and the clear loop below would then delete files in the
  # link's target directory instead of in the overlay.
  [[ -d "$kit_dir/CLAUDE.md" ]] && rm -rf "$kit_dir/CLAUDE.md"
  [[ -L "$kit_dir/agents" || -f "$kit_dir/agents" ]] && rm -f "$kit_dir/agents"
  [[ -L "$kit_dir/commands" || -f "$kit_dir/commands" ]] && rm -f "$kit_dir/commands"
  [[ -L "$kit_dir/skills" || -f "$kit_dir/skills" ]] && rm -f "$kit_dir/skills"
  mkdir -p "$kit_dir/agents" "$kit_dir/commands" "$kit_dir/skills"

  # Rewrite IN PLACE (truncate the file, clear inside the dir; never rm the
  # sources themselves): all are bind-mounted, and a running container keeps
  # the original inodes, so in-place rewrites are what make a kit change
  # visible to the box's next session without a container restart.
  local _f
  # -e alone misses dangling symlinks (a symlinked host command whose target
  # moved), which would then linger in the overlay across every future regen;
  # -L catches them regardless of target state.
  for _f in "$kit_dir/agents"/*; do
    [[ -e "$_f" || -L "$_f" ]] || continue
    rm -rf "$_f"
  done
  for _f in "$kit_dir/commands"/* "$kit_dir/commands"/.[!.]*; do
    [[ -e "$_f" || -L "$_f" ]] || continue
    rm -rf "$_f"
  done
  # skills/: same both-globs shape as commands (skill bundles carry dotfiles,
  # and a hidden skill dir is a real shape). The rm is made NON-FATAL here and
  # the copy below normalizes modes: a skill dir can arrive from unzip, a git
  # archive or a marketplace install at 0500, which copies through as 0500 and
  # makes the NEXT regen's rm die EPERM. Under strict mode that raw
  # "Permission denied" would take the whole `cleat start` down.
  for _f in "$kit_dir/skills"/* "$kit_dir/skills"/.[!.]*; do
    [[ -e "$_f" || -L "$_f" ]] || continue
    rm -rf "$_f" 2>/dev/null || true
  done

  # CLAUDE.md: the user's real global memory first, byte-for-byte.
  if [[ -f "${HOME}/.claude/CLAUDE.md" ]]; then
    cat "${HOME}/.claude/CLAUDE.md" > "$kit_dir/CLAUDE.md"
  else
    : > "$kit_dir/CLAUDE.md"
  fi

  # Box notes second, under a marked header: operational guidance every box
  # needs (the clipboard-bridge rules). This is the only path that actually
  # reaches the box; see _box_notes_claude_md for why the image bake never
  # did. A kit section, if any, follows below.
  {
    echo ""
    echo "# ── Cleat box notes ──"
    echo ""
    _box_notes_claude_md
  } >> "$kit_dir/CLAUDE.md"

  # Provisioning notes third, under its own marked header: the stage-0
  # concierge guidance ([setup] section, apt-get persistence). CLI-generated
  # only, same reasoning as the box notes above; see _provisioning_notes_claude_md.
  {
    echo ""
    echo "# ── Cleat box provisioning ──"
    echo ""
    _provisioning_notes_claude_md
  } >> "$kit_dir/CLAUDE.md"

  # agents/: the user's own agents, as-is.
  if [[ -d "${HOME}/.claude/agents" ]]; then
    for _f in "${HOME}/.claude/agents"/*; do
      [[ -f "$_f" ]] || continue
      cp "$_f" "$kit_dir/agents/" 2>/dev/null || true
    done
  fi

  # commands/: a read-only PASS-THROUGH of the user's own slash commands
  # (recursive, so namespaced subdirs survive). Kits add no commands, so this
  # is a plain copy. Its purpose is the :ro mask: with it, a caged agent can
  # read the user's commands but cannot plant a NEW host-user-level command
  # that native host claude would run on invocation, closing the third
  # instruction surface after CLAUDE.md and agents. Project-level
  # /workspace/.claude/commands is unaffected (still writable in the repo).
  # Copied entry by entry, exactly like skills below and for the same reason.
  # The blanket `cp -RL` this used to be dereferenced EVERY link at every
  # depth, so `mycommands/keys -> ~/.ssh` materialized real host secrets inside
  # the cage. That is the one thing the cage exists to prevent, and
  # _fork_copy_tree guards the identical property for the workspace ("never add
  # -L or -H"). The TOP-LEVEL entry is still dereferenced, because dotfile-repo
  # users symlink their whole commands dir or individual command files and a
  # copied link would be dead inside the box. A link NESTED inside a command
  # directory is copied AS a link and simply dangles there.
  if [[ -d "${HOME}/.claude/commands" ]]; then
    local _cm _cmb
    for _cm in "${HOME}/.claude/commands"/* "${HOME}/.claude/commands"/.[!.]*; do
      [[ -e "$_cm" ]] || continue
      _cmb="${_cm##*/}"
      if [[ -d "$_cm" ]]; then
        mkdir -p "$kit_dir/commands/$_cmb"
        cp -R "$_cm/." "$kit_dir/commands/$_cmb/" 2>/dev/null || true
      else
        cp "$_cm" "$kit_dir/commands/$_cmb" 2>/dev/null || true
      fi
    done
    chmod -R u+rwX "$kit_dir/commands" 2>/dev/null || true
  fi

  # skills/: a read-only PASS-THROUGH of the user's own skills. Same purpose
  # as commands above, one degree stronger: ~/.claude/skills is an AUTO-LOAD
  # plugin source (Claude Code registers what it finds there as
  # <name>@skills-dir), so a planted skill needs no user action at all to be
  # discovered and invoked, and a skill root can carry hooks/, bin/ and
  # .mcp.json, not only a SKILL.md. Copied entry by entry ON PURPOSE, and the
  # recursive step drops -L: the TOP-LEVEL entry is still dereferenced
  # (dotfile-repo users symlink a whole skill dir, and a copied link would be
  # dead inside the box) while a symlink NESTED inside a skill is copied as a
  # symlink. A blanket cp -RL would dereference `myskill/keys -> ~/.ssh` and
  # materialize real host secrets inside the cage, the one thing the cage
  # exists to prevent. A nested link that points outside simply dangles in the
  # box.
  if [[ -d "${HOME}/.claude/skills" ]]; then
    local _sk _skb
    for _sk in "${HOME}/.claude/skills"/* "${HOME}/.claude/skills"/.[!.]*; do
      [[ -e "$_sk" ]] || continue
      _skb="${_sk##*/}"
      if [[ -d "$_sk" ]]; then
        mkdir -p "$kit_dir/skills/$_skb"
        cp -R "$_sk/." "$kit_dir/skills/$_skb/" 2>/dev/null || true
      else
        cp "$_sk" "$kit_dir/skills/$_skb" 2>/dev/null || true
      fi
    done
    # Normalize modes so the overlay is always owner-removable (see the clear
    # loop above). X, not x: only dirs and already-executable files get +x.
    chmod -R u+rwX "$kit_dir/skills" 2>/dev/null || true
  fi

  [[ -n "$kit" ]] || return 0

  # Collect the NAMES the user's agents declare (Claude dispatches by name,
  # not filename). A kit agent whose name a user agent already claims must be
  # skipped, or the box ends up with two agents named e.g. `worker` and the
  # kit's read-only guarantee dissolves into an ambiguous dispatch. "User
  # wins" is the documented contract; here it is enforced by name, not just
  # by the near-impossible filename collision.
  local _user_names=" " _n
  for _f in "$kit_dir/agents"/*; do
    [[ -f "$_f" ]] || continue
    _n="$(_agent_name "$_f")"
    [[ -n "$_n" ]] && _user_names="${_user_names}${_n} "
  done

  # Merge the kit on top: fragment appended under a marked header; agents
  # added without clobbering a same-FILENAME or same-NAME user agent (the
  # user wins; the collision is also warned about at enable time, where no
  # spinner owns the terminal).
  local stage="$kit_dir/.stage"
  rm -rf "$stage"
  _kit_emit "$kit" "$stage"
  {
    echo ""
    echo "# ── Cleat kit: $kit ──"
    echo ""
    cat "$stage/CLAUDE.md"
  } >> "$kit_dir/CLAUDE.md"
  local _base _kn
  for _f in "$stage/agents"/*; do
    [[ -f "$_f" ]] || continue
    _base="$(basename "$_f")"
    [[ -e "$kit_dir/agents/$_base" ]] && continue
    _kn="$(_agent_name "$_f")"
    [[ -n "$_kn" && "$_user_names" == *" $_kn "* ]] && continue
    cp "$_f" "$kit_dir/agents/$_base"
  done
  rm -rf "$stage"
}

# ── ~/.claude containment (concept/34 Follow-up 13) ─────────────────────────
#
# The base ~/.claude bind is read-write and carries auth, so everything not
# explicitly handled passes through to the HOST. That leaked far more than
# instructions. Measured on the maintainer's machine 2026-07-25: projects/ held
# 976 MB across 24 directories, one per project ever run under Claude Code, and
# file-history/ held 185 MB of versioned file snapshots with content from at
# least four unrelated projects. A caged agent could read all of it.
#
# Two different shapes are needed, and the distinction is the whole design:
#
#   * A :ro self-mask (what plugins uses) blocks WRITES but not READS. Measured:
#     with the host projects/ masked over itself :ro, a sibling project's
#     transcript was still fully readable. So :ro is useless against disclosure.
#   * A GENERATED replacement blocks both, because the host content is simply
#     never mounted. That is what these dirs get.
#
# Per-box private dirs: the box gets its own empty, writable copy. Nothing to
# read from other projects, nothing that outlives `cleat rm`. These hold
# cross-project data with no reason to be shared into a cage.
#
# hooks/ is in this list for a stronger reason than the rest, and it is the one
# entry that must never be downgraded to a :ro mask. The hooks CAPABILITY runs
# the user's hook commands on the HOST (see _execute_host_hooks). A hook command
# that names a script under ~/.claude/hooks/ therefore turns any write into that
# directory into host execution: a caged agent drops a file, triggers any tool
# event, and the bridge runs it outside the box as the user. :ro would stop that
# write, but an empty per-box dir stops it AND keeps the user's hook scripts
# (internal URLs, tokens, company automation) out of the cage. Nothing is lost:
# the box never reads these. With the cap ON every command in the box's settings
# overlay is rewritten to the forwarder, and with it OFF hooks are deleted
# outright, so no in-box code path resolves a path under ~/.claude/hooks.
#
# session-env/, daemon/ and seed-admin/ are here for the same reason as hooks/:
# the HOST's own Claude Code executes what sits in them, with no capability
# involved. Claude Code's sandbox denies writes to all three, and the reasons
# were read out of the 2.1.270 bundle:
#
#   * session-env/<session id>/ holds `(setup|sessionstart|cwdchanged|
#     filechanged)-hook-N.sh` files that the Bash tool builder joins and runs
#     ahead of the next command. A box could list the host's live session ids
#     there and drop a file into one.
#   * daemon/dispatch/ is watched by the background daemon, and a dispatch job
#     in "exec" mode names a command the worker spawns.
#   * seed-admin/ is where Claude Code stages git metadata for a working tree
#     and then runs git against it.
#
# Private rather than masked, because a box runs its own sessions and its own
# daemon: an empty :ro dir would break them, an empty per-box writable dir does
# not. Claude Code refuses a seed-admin dir that is group or other writable and
# chmods daemon/ to 0700 itself, so every one of these is created without group
# or other write, on the host and in the overlay alike.
_CLAUDE_PRIVATE_DIRS="file-history paste-cache uploads backups shell-snapshots session-env daemon seed-admin sessions tasks jobs hooks"

# ── The third channel: the ~/.claude ROOT is writable ───────────────────────
#
# `-v "${HOME}/.claude:/home/coder/.claude"` is read-write and only named LEAVES
# are masked, so the box can create any file at the root that is not on the mask
# list. That needs no capability, no trust prompt and no egress: it is the same
# escalation class the hooks capability spends five guards closing, reached for
# free.
#
# What matters there is not runtime state, it is INSTRUCTION SURFACES: paths a
# later session, or the user's own uncaged Claude Code, reads as configuration,
# hooks, agents, commands, skills or rules. That set is small, enumerable and
# has no overlap with the state Claude Code writes for itself.
#
# The list is a REVIEWED SUBSET of the vendor's, not a guess. Claude Code's own
# sandbox builds a write deny list over names in its config home, so refreshing
# this is a re-read rather than a re-derivation. It is not the whole of that
# list. The runtime state it names (shell-snapshots, session-env, daemon,
# seed-admin, jobs, backups) is a per-box private dir above, projects/ has its
# generated parent, CLAUDE.md, agents, commands, skills and plugins have the kit
# masks, and policy-limits.json with its two signature sidecars is left writable
# on purpose (concept/41 records why). The tail of that list (remote-settings
# and its consent files, state, shares, mcp-skill-archives,
# mcp-discovery-cache, bridge-spawn, .cc-writes) has NOT been reviewed.
# remote-settings.json is a cached managed-settings file, so concept/41 names it
# as open rather than inert. bridge-spawn holds the MCP config the host's own
# remote-control bridge hands a spawned session, and Claude Code refuses a spawn
# root that is not exactly 0700, so it cannot join the go-w private dirs above
# as they stand. .cc-writes is the host writer's rename staging dir, which a
# mount would break with EXDEV.
#
# The root itself is NOT made read-only, and that is a measured decision rather
# than a missing step. Token refresh CREATES files at the root
# (`.oauth_refresh.lock` per refresh, and 22 of the 31 root-level state names in
# Claude Code 2.1.258's registry do not exist on a live box) and it RENAMES
# `.credentials.json` into place, which returns EBUSY onto a mountpoint. This
# repo already documents that rename trap three times over in its own words. The
# failure would be silent, delayed by hours and would land as "log in again" in
# the middle of an unattended session, which is the one thing this product
# cannot ship broken.
#
# Every one is mounted :ro over a per-box overlay. What the overlay HOLDS
# differs, and it was wrong the first time. The claim that none of these is
# read at the user level is false: Claude Code 2.1.270 loads user rules from
# rules/, user themes from themes/, workflows from workflows/ with source
# userSettings, output styles from output-styles/, keybindings.json (a
# default-on feature) and loop.md. Blanking those took the user's own config
# out of every box. So the names in _CLAUDE_INSTR_PASSTHROUGH get a read-only
# COPY of the user's content, regenerated on create, start and resume the way
# the kit overlay is. The rest stay EMPTY until each is shown to be read: an
# empty mask turns a future vendor read into a missing feature the user
# reports, instead of an invisible host write primitive nobody sees.
#
# `local` is the npm-local install. The host's `claude` alias runs
# local/node_modules/.bin/claude and its updater runs npm in that directory,
# so a box that could write it would own the next host launch. Its empty host
# target is not an install: Claude Code checks for node_modules/.bin/claude.
_CLAUDE_INSTR_DIRS="workflows routines rules output-styles themes cowork_plugins project-settings local-settings local"
# Files, masked the same way. The inert placeholder is per name, because the
# reader that would choke on a wrong one is the user's OWN Claude Code:
# keybindings.json is `{"bindings":[]}` (its loader rejects any object without a
# bindings array, `{}` included), the other JSON files keep `{}` (read as nothing
# configured by the scheduled_tasks.json, daemon.json and settings readers, and
# not re-checked for launch.json) and loop.md is empty (an empty loop.md reads as
# absent). See _claude_instr_placeholder.
#
# daemon.json is the background daemon's config and its schema accepts workers
# with a permission mode. The worker entry point is switched off in 2.1.270, so
# a planted one runs nothing today. It is masked while that costs one name.
#
# `settings.local.json` earns its place on a measurement rather than on the
# earlier claim. Claude Code 2.1.258 resolves that file from the GIT ROOT, and
# the literal `~/.claude/settings.local.json` appears zero times in the bundle,
# so the widely repeated "the host's Claude Code reads it" is not true as
# written. But when the cwd is $HOME and $HOME is not inside a git repo, the
# local path resolves to exactly that, and it is then the highest-precedence
# non-managed tier, hooks included. The mask costs one line.
#
# `.config.json` is deliberately NOT here, and it DOES matter: Claude Code
# prefers ~/.claude/.config.json over ~/.claude.json as its global config when
# it exists, and starts every MCP server that file lists. No mount can close it.
# Any mount needs its target to exist on the host (VirtioFS refuses a missing
# one, runc creates one), and a target that exists at that path IS the file the
# host's Claude Code then loads instead of the user's real config. It needs the
# box-private ~/.claude, see concept/41. Until then
# _maybe_note_host_global_config says so whenever the file is there.
_CLAUDE_INSTR_FILES="scheduled_tasks.json launch.json loop.md keybindings.json settings.local.json daemon.json"

# The instruction surfaces the bundled Claude Code reads at the user level. The
# box gets a read-only COPY of these, not an empty mask. See above.
_CLAUDE_INSTR_PASSTHROUGH="rules output-styles themes workflows keybindings.json loop.md"

# The inert content for a file mask, on the host target and in the overlay.
_claude_instr_placeholder() {
  case "$1" in
    keybindings.json) printf '{"bindings":[]}\n' ;;
    *.json)           printf '{}\n' ;;
    *)                : ;;
  esac
}

_claude_instr_is_passthrough() {
  case " $_CLAUDE_INSTR_PASSTHROUGH " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

# Claude Code's encoding of a working directory into its ~/.claude/projects/<key>
# directory name: every '/' AND every '.' becomes a dash.
#
# Measured against a live box on 2026-07-29. With the workspace at
#   /Users/marcin/.config/cleat/forks/cleat-demo-ab8ed4e5-feat-a
# Claude reported its own session path as
#   ~/.claude/projects/-Users-marcin--config-cleat-forks-cleat-demo-ab8ed4e5-feat-a
# Note the DOUBLE dash where '/.' appeared. Replacing only slashes matched for a
# project path with no dot in it, which is why this went unnoticed for so long,
# but the default fork root is ~/.config/cleat/forks, so every fork box under the
# docker cap looked for a session dir that was never created. Any project path
# containing a dot had the same problem.
#
# Re-measured against the bundled Claude Code 2.1.220 on 2026-07-31 by running
# it in a directory named  a_b c+d@e#f%g(h)i,j=k~l  and reading the key it
# created:  a-b-c-d-e-f-g-h-i-j-k-l. So the rule is not "slash and dot" but
# EVERY character outside [A-Za-z0-9], dashes excepted. Handling only / and .
# left underscore broken, and snake_case project names (my_app, foo_bar) are
# everywhere: each one got its session mountpoint at a key Claude Code never
# reads, and under the docker cap the parent is :ro so it could not create the
# right one either. Sessions and memory silently did not persist, exactly as
# the dot bug did, by a commoner route.
#
# LC_ALL=C pins the ranges to ASCII: under a UTF-8 collation an A-Z range can
# match outside the letters you meant. sed rather than ${var//[!A-Za-z0-9]/-}
# for the same reason, and it matches how container_name_for already sanitizes.
# A path made only of [A-Za-z0-9/.-] encodes byte-identically to the old form,
# so no existing user is re-keyed.
_claude_session_key() {
  printf '%s' "$(printf '%s' "$1" | LC_ALL=C sed 's/[^A-Za-z0-9]/-/g')"
}

# Build the per-box replacement content for the containment mounts: the
# per-box credential store, the private dirs and the projects/ parent holding
# this box's session keys. Called from cmd_run only, so it runs when the box is
# CREATED, and the mounts are fixed then as well. A private dir added in a later
# release reaches an existing box only through a recreate, which the start-time
# note in _maybe_note_missing_kit_masks advises. The part refreshed on every
# start and resume of a box that has the mounts is the instruction-surface copy,
# through _generate_instr_overlay, which this also calls at create. Apart from
# those copies everything made here is an empty dir, so there is no IO
# proportional to the size of the host's ~/.claude.
_generate_home_overlay() {
  # $2 is the WORKSPACE, not the project. For a plain box they are the same path.
  # For a fork box the workspace is the copy, and the copy is what the container
  # cd's into under the docker cap, so the copy is what Claude Code encodes its
  # session key from. Passing the project here shipped broken: a fork box with
  # the docker cap got a mountpoint named after the live project while Claude
  # looked for one named after the copy, found nothing, and could not create it
  # because this parent is mounted :ro. Sessions and memory silently did not
  # persist. Found on a real host run 2026-07-29.
  local cname="$1" workspace="$2" session_key="$3"
  local home_dir="$CLEAT_RUN_DIR/${cname}/home"
  local _d

  # The per-box credential store. Created here for the same reason every other
  # bind source is: a missing bind source makes Docker create a DIRECTORY at the
  # target, which is the failure that once broke `git` host-wide. It is empty
  # unless a named account is pinned, and an empty one is exactly what "signed
  # out" looks like to Claude Code.
  local _auth_dir="$CLEAT_RUN_DIR/${cname}/auth"
  [[ -L "$_auth_dir" || -f "$_auth_dir" ]] && rm -f "$_auth_dir"
  mkdir -p "$_auth_dir"
  chmod 700 "$_auth_dir" 2>/dev/null || true

  for _d in $_CLAUDE_PRIVATE_DIRS; do
    # Self-heal a wrong type (file or symlink where the dir goes), matching
    # _generate_kit_overlay. A symlink here would make the box write through
    # to whatever it points at.
    [[ -L "$home_dir/$_d" || -f "$home_dir/$_d" ]] && rm -f "$home_dir/$_d"
    mkdir -p "$home_dir/$_d"
    # Claude Code refuses a seed-admin dir that is group or other writable, and
    # a host umask of 002 would hand it one.
    chmod go-w "$home_dir/$_d" 2>/dev/null || true
  done

  # The instruction-surface overlay. See _generate_instr_overlay.
  _generate_instr_overlay "$cname"

  # projects/: a generated parent holding ONLY this project's session keys as
  # empty mountpoints. Masked :ro so the agent cannot create a sibling key, with
  # the real session dir mounted read-write INSIDE it so --continue and --resume
  # keep working. Both keys are always created: '-workspace' is the normal CWD
  # encoding, and the host-path key is what Claude Code derives when the docker
  # cap moves the workdir (see the docker cap block). Creating the second
  # unconditionally costs an empty dir and keeps this independent of cap order.
  [[ -L "$home_dir/projects" || -f "$home_dir/projects" ]] && rm -f "$home_dir/projects"
  local _wskey
  _wskey="$(_claude_session_key "$workspace")"
  mkdir -p "$home_dir/projects/-workspace"
  mkdir -p "$home_dir/projects/$_wskey"
  # Drop stale keys from a previous workspace path so the box never sees a
  # mountpoint it no longer owns.
  local _k
  for _k in "$home_dir/projects"/*; do
    [[ -d "$_k" ]] || continue
    case "${_k##*/}" in
      -workspace|"$_wskey") ;;
      *) rmdir "$_k" 2>/dev/null || true ;;
    esac
  done
  : "$session_key"
}

# (Re)generate what sits behind every instruction-surface mask. Called at create
# through _generate_home_overlay and again on every start and resume next to
# _generate_kit_overlay, so a rule the user edits on the host reaches the box's
# next session with no recreate, and adding a surface never needs one either for
# a box that already has the mount.
#
# In place, never by replacing a mount source: a running container keeps the
# original inodes, so a dir is cleared from the inside and a file is truncated.
#
# The pass-through copies DIRECTORIES AND REGULAR FILES ONLY, at every depth,
# and follows no symlink, the top-level one included. That is stricter than
# commands/ and skills/, on purpose. These surfaces sat on the read-write root
# in every released box, so a box could already have planted
# `~/.claude/rules/x.md -> ~/.ssh/id_rsa`, and a copy that followed it would hand
# the key to the next box as a user rule. The cost is that a dotfile-repo
# symlink here is not seen inside a box, which concept/41 names.
_generate_instr_overlay() {
  local cname="$1"
  local instr="$CLEAT_RUN_DIR/${cname}/home/instr"
  local _i _dst _src _f
  [[ -L "$instr" || -f "$instr" ]] && rm -f "$instr"
  mkdir -p "$instr"
  for _i in $_CLAUDE_INSTR_DIRS; do
    _dst="$instr/$_i"
    # Self-heal a wrong type. A symlink here would be a write-through, and the
    # clear below would delete inside its target instead of inside the overlay.
    [[ -L "$_dst" || -f "$_dst" ]] && rm -f "$_dst"
    mkdir -p "$_dst"
    # A copied dir can arrive at 0500. Make the previous copy removable first.
    chmod -R u+rwX "$_dst" 2>/dev/null || true
    for _f in "$_dst"/* "$_dst"/.[!.]* "$_dst"/..?*; do
      [[ -e "$_f" || -L "$_f" ]] || continue
      rm -rf "$_f" 2>/dev/null || true
    done
    _claude_instr_is_passthrough "$_i" || continue
    _src="${HOME}/.claude/$_i"
    [[ -d "$_src" && ! -L "$_src" ]] || continue
    # cp -R copies a nested link AS a link on both BSD and GNU cp. The find then
    # drops every entry that is neither a directory nor a regular file, so no
    # link, FIFO or socket survives into the overlay.
    cp -R "$_src/." "$_dst/" 2>/dev/null || true
    find "$_dst" ! -type d ! -type f -exec rm -f {} + 2>/dev/null || true
    chmod -R u+rwX "$_dst" 2>/dev/null || true
  done
  for _i in $_CLAUDE_INSTR_FILES; do
    _dst="$instr/$_i"
    [[ -L "$_dst" || -d "$_dst" ]] && rm -rf "$_dst"
    _src="${HOME}/.claude/$_i"
    if _claude_instr_is_passthrough "$_i" && [[ -f "$_src" && ! -L "$_src" ]]; then
      cat "$_src" > "$_dst" 2>/dev/null || true
    else
      _claude_instr_placeholder "$_i" > "$_dst" 2>/dev/null || true
    fi
  done
}

# ── Forked workspaces (concept/31) ──────────────────────────────────────────
#
# A fork is not a new kind of thing: it is a BOX whose /workspace is its own
# copy of the project instead of the live tree. Everything else about the box
# (container name, session key, trust rows, caps, kits, description) still keys
# off the real project path, so nothing else in the CLI learns a new concept.
#
# A COPY, deliberately, not a git clone. A clone drags in the whole submodule /
# untracked-sibling / unpushed-SHA / git-identity problem class, and cannot
# serve a project with no git at all (the PoC A/B case). A copy just has the
# user's files: uncommitted work, untracked repos, gitignored build output.
# On APFS `cp -c` clones blocks copy-on-write, measured at 0.005s for 50 MB on
# the maintainer's machine, so "copy everything" is nearly free AND saves the
# caged agent an `npm install`.
# Physical path for something that may not exist yet. cd -P only works on an
# existing directory, and the fork root is created on demand, so resolve the
# deepest ancestor that DOES exist and re-attach the rest. Used to compare a
# fork root against a project path: comparing one side physically and the other
# logically is how the recursion guard below silently stopped firing on macOS,
# where /var/folders and /tmp are symlinks.
_phys_or_best() {
  local p="$1" rest="" base
  [[ -n "$p" ]] || return 0
  while [[ "$p" != "/" && -n "$p" && ! -d "$p" ]]; do
    rest="/${p##*/}$rest"
    p="${p%/*}"
    [[ -z "$p" ]] && p="/"
  done
  base="$(cd -P "$p" 2>/dev/null && pwd -P)" || { printf '%s' "$1"; return 0; }
  [[ "$base" == "/" ]] && base=""
  printf '%s%s' "$base" "$rest"
}

# Where fork copies live. Overridable with `[fork] dir` in the GLOBAL config
# (~/.config/cleat/config), and DELIBERATELY not from a project's .cleat: that
# file arrives with cloned repos and this value is a path Cleat creates and
# later removes under. The global config is written by the user, so it needs no
# trust gate.
#
# The default sits under $CLEAT_CONFIG_DIR next to run/, boxes/ and kits/. Two
# reasons someone would move it. XDG says variable data belongs in
# $XDG_DATA_HOME rather than a config dir, which is a fair reading. And
# copy-on-write only works WITHIN a volume, so a project on an external drive
# gets a full byte copy unless the fork root is on that drive too.
_fork_root() {
  local d
  d="$(_read_section_from_file "$CLEAT_GLOBAL_CONFIG" fork dir 2>/dev/null || true)"
  if [[ -n "$d" ]]; then
    case "$d" in
      "~"/*) d="${HOME}/${d#"~/"}" ;;
    esac
    # Absolute only. A relative fork root would resolve against whatever
    # directory the user happened to run cleat from.
    case "$d" in
      /?*) printf '%s\n' "${d%/}"; return 0 ;;
      # >&2 is load-bearing: warn writes to stdout and every caller of
      # _fork_root is a command substitution, so without it the warning TEXT
      # becomes the fork root and is then handed to mkdir, cp, rm -rf and mv
      # as a relative path.
      *) warn "Ignoring [fork] dir, not an absolute path: $d" >&2 ;;
    esac
  fi
  printf '%s\n' "$CLEAT_FORKS_DIR"
}

_fork_dir() { printf '%s\n' "$(_fork_root)/$1"; }

# How long ago the copy was taken. The fork directory's own mtime is the
# timestamp, so there is no extra state to write or keep in sync.
# Age of an EPOCH, as a short human string. Split out of _fork_age_human so a
# file mtime can use it too (the fork helper takes a directory and stats it);
# the tiers and the wording are unchanged, so both callers read identically.
# The tiers, given an already-computed age in seconds. Split out so a caller
# formatting many rows pays for ONE `date` instead of one per row: that fork was
# a measurable part of what made the sessions picker blink.
_age_from_delta() {
  local delta="$1"
  # A copy taken this second, or a clock that moved backwards, is "just now"
  # rather than nothing at all: an empty age would silently drop the whole line.
  (( delta < 0 )) && delta=0
  if   (( delta < 90 ));    then printf 'just now'
  elif (( delta < 5400 ));  then printf '%dm ago' $(( delta / 60 ))
  elif (( delta < 172800 ));then printf '%dh ago' $(( delta / 3600 ))
  else                           printf '%dd ago' $(( delta / 86400 ))
  fi
}

_age_human() {
  local mt="$1" now
  [[ "$mt" =~ ^[0-9]+$ ]] && [[ "$mt" -gt 0 ]] || return 0
  now="$(date +%s 2>/dev/null || echo 0)"
  [[ "$now" =~ ^[0-9]+$ ]] || return 0
  _age_from_delta $(( now - mt ))
}

_fork_age_human() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  _age_human "$(_path_mtime "$dir")"
}

# Whether a box is a fork is recorded SEPARATELY from the copy itself, in the
# same per-box host state dir as the description. The copy's existence looks
# like a sufficient marker and is not: if the copy is deleted, a bind source
# vanishes, cmd_start recreates the box, and a marker-free cmd_run would
# silently re-mount the LIVE tree and print success. A box the user believes is
# caged to a disposable copy would then be editing the real repo. The marker
# makes that case REFUSE instead.
_fork_marker_file() { echo "$CLEAT_BOXES_DIR/$1.fork"; }
_box_is_fork()      { [[ -f "$(_fork_marker_file "$1")" ]]; }
_fork_mark()        { mkdir -p "$CLEAT_BOXES_DIR"; : > "$(_fork_marker_file "$1")"; }
_fork_unmark()      { rm -f "$(_fork_marker_file "$1")"; }

# Delete a fork copy. Every caller passes a path it derived from _fork_dir, but
# this is an `rm -rf` on a path built from a container name and a configurable
# root, so it re-checks containment itself rather than trusting the caller. Same
# guard as _fork_copy_tree, and for the same reason: `[fork] dir` is user input
# and _fork_root once returned a warning STRING when it was relative.
_fork_rm_tree() {
  local target="$1" root
  root="$(_fork_root)"
  case "$target" in
    "$root"/?*) : ;;
    *) error "Refusing to delete outside ${root/#${HOME}/~}: $target"; return 1 ;;
  esac
  # A symlinked copy would make rm -rf follow it out of the root.
  if [[ -L "$target" ]]; then
    error "Fork workspace is a symlink, refusing to delete: ${target/#${HOME}/~}"
    return 1
  fi
  [[ -d "$target" ]] || return 0
  # The textual test above is necessary and NOT sufficient: it passes for any
  # string that starts with the root, including one whose '..' components
  # resolve elsewhere entirely. Resolve physically before deleting.
  if ! _fork_path_under_root "$target"; then
    error "Refusing to delete outside ${root/#${HOME}/~}: $target"
    return 1
  fi
  rm -rf "$target" || { error "Could not delete ${target/#${HOME}/~}"; return 1; }
  return 0
}

# Physical containment for a path this file is about to delete or overwrite.
#
# The `case "$target" in "$root"/?*` tests were the only guard, and they are
# purely textual: "$root/box/../../../Documents" matches the pattern and
# resolves to a real host directory. `cleat fork rm` and `cleat fork refresh`
# reached that path because their box positional was never validated (see
# cmd_fork), and rm -rf'd ~/Documents. Found 2026-07-31.
#
# A fork copy is always EXACTLY one level under the fork root, so resolve the
# parent physically and require it to BE the root. That is stricter than a
# prefix test and immune to '..'. cd -P plus pwd -P is the portable resolver
# here: macOS has no realpath in the base system. Same technique
# _fork_prune_excludes already uses against the same class of escape.
_fork_path_under_root() {
  local target="$1" base root_p parent_p
  base="${target##*/}"
  case "$base" in ''|.|..) return 1 ;; esac
  root_p="$(cd -P "$(_fork_root)" 2>/dev/null && pwd -P)" || return 1
  parent_p="$(cd -P "$(dirname "$target")" 2>/dev/null && pwd -P)" || return 1
  [[ "$parent_p" == "$root_p" ]]
}

# Every session verb must check this, not just cmd_run. The fork copy is a
# HOST-side invariant: whether the container happens to be running says nothing
# about whether its workspace still exists. cmd_resume only re-checks bind
# sources when the container is stopped, so a running fork box whose copy was
# deleted sailed straight through to exec_claude and came up on an empty (or
# Docker-recreated) /workspace with a success message. That is the silent
# re-bind this marker exists to prevent, reached by a different door.
#
# With an explicit --fork we heal instead of refusing: drop the container so the
# normal create path rebuilds both the copy and the mount, which is baked in at
# create and cannot be repointed on a running container.
_fork_preflight() {
  local cname="$1" can_recreate="${2:-}"
  # cmd_start and cmd_resume preflight, then call cmd_run, which preflights too so
  # that `cleat run <box> --fork` cannot reach the plain `docker rm` below without
  # being refused. Running the body twice is harmless but not silent: the heal
  # path printed "Fork workspace is missing, recreating it" once per call, which
  # a real host run showed as a duplicated line. Once per process is enough.
  [[ -n "$_FORK_PREFLIGHT_DONE" ]] && return 0
  _FORK_PREFLIGHT_DONE=1
  if ! _box_is_fork "$cname"; then
    # --fork on a box that already exists as a plain box did nothing at all:
    # the create block only runs when there is no container, so the flag was
    # silently ignored and the LIVE tree stayed mounted. The only signal was an
    # absent Fork line. Refuse loudly instead, and name the way out.
    if [[ "${_FORK_REQUESTED:-false}" == true ]] && container_exists "$cname"; then
      error "Box ${BOLD}${_BOX}${RESET} already exists and is not a fork."
      echo -e "    ${DIM}A box's workspace is fixed when it is created. Remove it first: ${BOLD}cleat rm ${_BOX}${RESET}${DIM}, then ${BOLD}cleat start ${_BOX} --fork${RESET}${DIM}.${RESET}"
      exit 1
    fi
    return 0
  fi
  local _fp
  _fp="$(_fork_dir "$cname")"
  [[ -d "$_fp" ]] && return 0
  # Healing drops the container so the create path rebuilds copy and mount
  # together. Only verbs that HAVE a create path may do that: from shell or
  # claude it would destroy a live box with nothing to rebuild it, so those
  # fall through to the refusal below.
  if [[ "${_FORK_REQUESTED:-false}" == true && "$can_recreate" == "recreate" ]]; then
    # Only announce a HEAL when there is something to heal. A fork marker
    # outlives both its container and its copy (cleat rm keeps the marker so
    # re-running the box reuses the copy), so a marker left over from a box
    # removed long ago made a brand-new `cleat fork start feat-b` open with
    # "Fork workspace is missing, recreating it" when nothing was missing and
    # nothing was being recreated: it was a first create. Reported from a host
    # run 2026-07-31. With no container there is nothing to drop and the create
    # path makes the copy anyway, so say nothing and let "Workspace copied"
    # speak. The refusal below is deliberately NOT gated this way: refusing to
    # silently re-bind the live tree matters whether or not a container exists.
    if container_exists "$cname"; then
      info "Fork workspace is missing, recreating it"
      docker rm -f "$cname" > /dev/null 2>&1 || true
    fi
    return 0
  fi
  error "This box is a fork but its workspace copy is missing."
  echo -e "    ${DIM}Expected: ${_fp/#${HOME}/~}${RESET}"
  echo -e "    ${DIM}Recreate it with ${BOLD}cleat start ${_BOX} --fork${RESET}${DIM}, or drop the fork with ${BOLD}cleat fork rm ${_BOX}${RESET}${DIM}.${RESET}"
  exit 1
}

# Every value for a REPEATED key in a section, one per line. The existing
# _read_section_from_file returns the first match only, which is right for
# `memory = 8g` and wrong for `exclude = node_modules` repeated N times.
_read_section_all_from_file() {
  local file="$1" section="$2" key="$3"
  [[ -r "$file" ]] || return 0
  local in_section=false line k v
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, silently voided the first section
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == "["*"]" ]]; then
      [[ "$line" == "[$section]" ]] && in_section=true || in_section=false
      continue
    fi
    $in_section || continue
    [[ "$line" == *"="* ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    k="${k%"${k##*[![:space:]]}"}"
    v="${v#"${v%%[![:space:]]*}"}"
    v="${v%"${v##*[![:space:]]}"}"
    [[ "$k" == "$key" && -n "$v" ]] && printf '%s\n' "$v"
  done < "$file"
}

# cp flags, probed ONCE from the cp BINARY and never from `uname -s`. A macOS
# host with Homebrew coreutils on PATH has GNU cp under the plain name, and GNU
# cp rejects -c outright ("invalid option -- 'c'", exit 1, nothing copied), so
# an OS-keyed branch hard-fails the fork for exactly that profile. No pipeline
# in the probe: `cp --version | head -1` can hand cp a SIGPIPE, and pipefail
# then reports the pipeline failed even when the match succeeded.
_FORK_CP_PROBED=""
_FORK_CP_FLAGS=""
_fork_cp_flags() {
  if [[ -n "$_FORK_CP_PROBED" ]]; then printf '%s' "$_FORK_CP_FLAGS"; return 0; fi
  _FORK_CP_PROBED=1
  local _v _h _p
  _v="$(cp --version 2>/dev/null || true)"
  case "$_v" in
    *"GNU coreutils"*)
      _h="$(cp --help 2>/dev/null || true)"
      # --reflink=auto degrades silently to a byte copy on a non-CoW
      # filesystem. Never =always, which fails instead. -d keeps hardlinks
      # inside the tree shared, so a pnpm store does not multiply.
      case "$_h" in
        *--reflink*) _FORK_CP_FLAGS="-R -d --reflink=auto" ;;
        *)           _FORK_CP_FLAGS="-R -d" ;;
      esac
      ;;
    *)
      # BSD. -c clones each regular file and falls back internally on EXDEV or
      # ENOTSUP without changing the exit status, so no CoW retry is needed.
      # Probe acceptance of the flag rather than assuming it.
      _FORK_CP_FLAGS="-R"
      _p="$(_fork_root)/.cpprobe.$$"
      rm -rf "$_p" 2>/dev/null || true
      if mkdir -p "$_p/s" "$_p/d" 2>/dev/null && : > "$_p/s/f" 2>/dev/null \
         && cp -Rc "$_p/s/." "$_p/d/" 2>/dev/null; then
        _FORK_CP_FLAGS="-Rc"
      fi
      rm -rf "$_p" 2>/dev/null || true
      ;;
  esac
  printf '%s' "$_FORK_CP_FLAGS"
}

# Recursive copy of a project tree into a fork workspace.
#
# Load-bearing, each measured:
#   * The source form is "$src/." into a freshly created "$dst/". `cp -R "$src"
#     "$dst"` looks equivalent and is not: when the PROJECT ROOT is itself a
#     symlink it copies the LINK, so the fork becomes an alias for the live
#     tree and the whole feature voids in silence. It also nests to
#     $dst/$(basename $src) whenever $dst survives, which a root-owned leftover
#     from the box's passwordless sudo can cause.
#   * Flags come from _fork_cp_flags, which probes the binary. See there.
#   * Plain -R copies symlinks AS symlinks on both BSD and GNU. That is the
#     security property: a project containing `sub/keys -> ~/.ssh` must NOT
#     have real key bytes materialised into the cage. Never add -L or -H.
#
# Copies into a temp dir inside CLEAT_FORKS_DIR and renames, so an interrupted
# copy never presents a half tree as a workspace, and takes a mkdir lock so two
# concurrent --fork runs cannot both rm -rf and copy into the same target.
_fork_copy_tree() {
  local src="$1" dst="$2" lock rc=0
  local root; root="$(_fork_root)"
  mkdir -p "$root" || return 1
  # Never rm -rf outside the fork root, whatever the caller passes. Textual
  # first, then physical: this function rm -rf's $dst before moving the copy
  # into place, so a '..' that only LOOKS contained deleted a host directory
  # and then replaced it with the project. See _fork_path_under_root.
  case "$dst" in
    "$root"/?*) : ;;
    *) error "Refusing to write a fork outside ${root/#${HOME}/~}"; return 1 ;;
  esac
  if ! _fork_path_under_root "$dst"; then
    error "Refusing to write a fork outside ${root/#${HOME}/~}"
    return 1
  fi
  [[ -d "$src" ]] || { error "Fork source is not a directory: $src"; return 1; }
  lock="$root/.lock.$(basename "$dst")"
  if ! mkdir "$lock" 2>/dev/null; then
    error "Another cleat is already copying this workspace."
    echo -e "    ${DIM}If nothing else is running, remove ${BOLD}${lock/#${HOME}/~}${RESET}${DIM} and retry.${RESET}"
    return 1
  fi
  _fork_copy_tree_locked "$src" "$dst" || rc=$?
  rmdir "$lock" 2>/dev/null || true
  return "$rc"
}

_fork_copy_tree_locked() {
  local src="$1" dst="$2" tmp cpflags rc=0 root
  root="$(_fork_root)"
  tmp="$root/.tmp.$$"
  rm -rf "$tmp" || return 1
  mkdir -p "$tmp" || return 1
  cpflags="$(_fork_cp_flags)"
  # shellcheck disable=SC2086
  cp $cpflags "$src/." "$tmp/" || rc=$?
  if [[ $rc -ne 0 ]]; then rm -rf "$tmp"; return "$rc"; fi
  rm -rf "$dst" || { rm -rf "$tmp"; return 1; }
  mv "$tmp" "$dst" || { rm -rf "$tmp"; return 1; }
  return 0
}

# Prune configured excludes AFTER the copy. cp has no --exclude, and rsync
# would lose clonefile on macOS, so copy-everything-then-prune keeps one code
# path and keeps CoW. Paths are refused if absolute or containing '..': an
# exclude must never be able to delete outside the fork.
# $3 is the BOX. The excludes were read from $project/.cleat unconditionally,
# so a named box using .cleat.<box> had its caps honoured from that file and
# its [fork] excludes read from a different one. _project_caps_file is the same
# resolver every other per-box setting goes through.
_fork_prune_excludes() {
  local dst="$1" project="$2" box="${3:-main}" e _root _parent _target _exfile
  _exfile="$(_project_caps_file "$project")"
  _root="$(cd -P "$dst" 2>/dev/null && pwd -P)" || return 0
  while IFS= read -r e; do
    [[ -n "$e" ]] || continue
    # Cheap syntactic refusals first.
    case "$e" in
      /*|*..*) warn "Ignoring unsafe [fork] exclude: $e"; continue ;;
      # `.` resolves to the fork root itself. It passes the physical-parent
      # check below, and `rm -rf "$dir/."` is refused by rm with a non-zero
      # status, which under set -e would abort the whole run after the copy.
      .|./|"") warn "Ignoring [fork] exclude that names the workspace root: $e"; continue ;;
    esac
    # Then the one that actually matters. `rm -rf` follows every INTERMEDIATE
    # symlink component, and the copy deliberately preserves symlinks, so an
    # exclude that is neither absolute nor traversing can still reach outside
    # the fork: a project containing `docs -> ~/Documents` plus
    # `exclude = docs/thesis.txt` would delete the real host file. Resolve the
    # PHYSICAL parent and require it to sit inside the fork. cd -P plus pwd -P
    # is the portable resolver here: macOS has no realpath in the base system.
    _target="$dst/$e"
    _parent="$(cd -P "$(dirname "$_target")" 2>/dev/null && pwd -P)" || continue
    case "$_parent" in
      "$_root"|"$_root"/*) ;;
      *) warn "Ignoring [fork] exclude that resolves outside the fork: $e"; continue ;;
    esac
    # The leaf itself must not be a symlink either: removing it is fine, but
    # only the link, never through it.
    # Non-fatal: an exclude that cannot be removed (a root-owned path the
    # box's own passwordless sudo created, for instance) must not take down a
    # copy that already succeeded.
    rm -rf "$_parent/$(basename "$_target")" 2>/dev/null \
      || warn "Could not prune [fork] exclude: $e"
  done < <(_read_section_all_from_file "$_exfile" "$(_scoped_section "$_exfile" "$box" fork)" exclude)
}

# ── Workspace trust ─────────────────────────────────────────────────────────
#
# A project's .cleat file lives in the repo: it's untrusted input. Before
# applying any capabilities it declares, the user must explicitly trust the
# file. Approval is per-project, keyed by the project's absolute path, and
# re-prompted whenever the set of requested caps changes (hash mismatch).
#
# Global config (~/.config/cleat/config) and --cap CLI flags are always
# trusted: the user wrote those themselves.
#
# Full design: concept/16-workspace-trust.md.

# Canonicalize a cap list for hashing: sort, deduplicate, join with commas.
# Reads one cap per line from stdin, outputs a single canonical string.
_canonical_caps() {
  awk 'NF' | LC_ALL=C sort -u | paste -sd, -
}

# Hash the canonical cap list from a .cleat file. Prints empty when the
# file is missing or declares no caps (nothing to gate).
# Note: `_md5` passes stdin through `md5sum` on Linux, which appends
# "  -" (the filename of stdin). Strip that so the stored trust hash is
# purely hex, otherwise we write malformed tab-separated lines.
_hash_cleat_caps() {
  local path="$1" box="${2?_hash_cleat_caps needs a box}"
  [[ -f "$path" ]] || return 0
  local caps
  caps="$(_read_caps_from_file "$path" "$box" | _canonical_caps)"
  [[ -z "$caps" ]] && return 0
  echo -n "$caps" | _md5 | awk '{print $1}'
}

# Hash a built [setup] payload (see _build_setup_payload) for trust
# comparison. Same _md5 note as _hash_cleat_caps above: strip md5sum's
# trailing "  -" filename artifact so the stored hash is purely hex.
_setup_payload_hash() {
  local payload="$1"
  printf '%s' "$payload" | _md5 | awk '{print $1}'
}

# Look up the stored trust hash for a (project, box). Empty on miss.
# The trust file is <path><TAB><box><TAB><hash>. Legacy two-column rows
# (<path><TAB><hash>) are read as the "main" box (see concept/20-boxes.md).
_trust_lookup() {
  local project="$1" box="${2:-main}"
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  CLEAT_AWK_P="$project" CLEAT_AWK_B="$box" awk -F'\t' '
    BEGIN { p = ENVIRON["CLEAT_AWK_P"]; b = ENVIRON["CLEAT_AWK_B"] }
    /^#/ { next }
    $1 != p { next }
    NF >= 3 { if ($2 == b) { print $3; exit } ; next }
    NF == 2 { if (b == "main") { print $2; exit } }
  ' "$CLEAT_TRUST_FILE" 2>/dev/null
}

# Look up the stored [setup] trust hash for a (project, box). Empty on
# miss. Unlike _trust_lookup, there is no legacy two-column case: setup
# trust only ever exists in a 4-column row (see _trust_record), since it
# shipped after the box-aware three-column format.
_trust_lookup_setup() {
  local project="$1" box="${2:-main}"
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  CLEAT_AWK_P="$project" CLEAT_AWK_B="$box" awk -F'\t' '
    BEGIN { p = ENVIRON["CLEAT_AWK_P"]; b = ENVIRON["CLEAT_AWK_B"] }
    /^#/ { next }
    $1 != p { next }
    NF >= 4 { if ($2 == b) { print $4; exit } }
  ' "$CLEAT_TRUST_FILE" 2>/dev/null
}

# Append/update a trust entry for a (project, box). Atomic via temp+rename.
# 0600 permissions. Refuses paths containing tab/newline/carriage-return.
# Recording the "main" box also supersedes any legacy two-column row.
# setup_hash is an optional 4th arg, a separate consent class from the caps
# hash (concept/16): when non-empty the row grows to four columns (path,
# box, caps hash or "-", setup hash); when empty/omitted the row is
# byte-identical to the pre-[setup] three-column format, so existing
# 3-arg callers and existing rows are untouched.
_trust_record() {
  # box is the optional 3rd arg so legacy 2-arg callers (project, hash) keep
  # working with box defaulting to "main".
  local project="$1" hash="$2" box="${3:-main}" setup_hash="${4:-}"
  case "$project" in
    *$'\t'*|*$'\n'*|*$'\r'*)
      error "Refusing to trust a project path containing control characters"
      return 1 ;;
  esac
  # A 3-column row needs a real caps hash (nothing else to record). A
  # 4-column row can carry setup trust alone, with "-" standing in for an
  # absent/untrusted caps hash (see printf below).
  if [[ -z "$setup_hash" ]]; then
    [[ -z "$hash" ]] && return 1
  fi
  mkdir -p "$(dirname "$CLEAT_TRUST_FILE")"
  local tmp="${CLEAT_TRUST_FILE}.tmp.$$"
  {
    echo "# Cleat project trust file (one entry per line)"
    echo "# <absolute-project-path><TAB><box><TAB><hash-of-canonical-caps>"
    echo "# Legacy two-column rows (<path><TAB><hash>) are read as the 'main' box."
    if [[ -f "$CLEAT_TRUST_FILE" ]]; then
      CLEAT_AWK_P="$project" CLEAT_AWK_B="$box" awk -F'\t' '
        BEGIN { p = ENVIRON["CLEAT_AWK_P"]; b = ENVIRON["CLEAT_AWK_B"] }
    /^#/ { next }
        NF < 2 { next }
        {
          if ($1 == p) {
            if (NF >= 3 && $2 == b) next
            if (NF == 2 && b == "main") next
          }
          print
        }
      ' "$CLEAT_TRUST_FILE"
    fi
    if [[ -n "$setup_hash" ]]; then
      printf '%s\t%s\t%s\t%s\n' "$project" "$box" "${hash:--}" "$setup_hash"
    else
      printf '%s\t%s\t%s\n' "$project" "$box" "$hash"
    fi
  } > "$tmp"
  chmod 0600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$CLEAT_TRUST_FILE"
}

# Remove a (project, box) trust entry. Silent no-op if not present. Removing
# the "main" box also clears any legacy two-column row for the path.
_trust_remove() {
  local project="$1" box="${2:-main}"
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  local tmp="${CLEAT_TRUST_FILE}.tmp.$$"
  {
    echo "# Cleat project trust file (one entry per line)"
    echo "# <absolute-project-path><TAB><box><TAB><hash-of-canonical-caps>"
    echo "# Legacy two-column rows (<path><TAB><hash>) are read as the 'main' box."
    CLEAT_AWK_P="$project" CLEAT_AWK_B="$box" awk -F'\t' '
      BEGIN { p = ENVIRON["CLEAT_AWK_P"]; b = ENVIRON["CLEAT_AWK_B"] }
    /^#/ { next }
      NF < 2 { next }
      {
        if ($1 == p) {
          if (NF >= 3 && $2 == b) next
          if (NF == 2 && b == "main") next
        }
        print
      }
    ' "$CLEAT_TRUST_FILE"
  } > "$tmp"
  chmod 0600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$CLEAT_TRUST_FILE"
}

# List all trusted (project, box) pairs as <path><TAB><box>, one per line.
# Legacy two-column rows surface as <path><TAB>main.
_trust_list() {
  [[ -f "$CLEAT_TRUST_FILE" ]] || return 0
  awk -F'\t' '
    /^#/ { next }
    NF >= 3 { print $1 "\t" $2; next }
    NF == 2 { print $1 "\t" "main" }
  ' "$CLEAT_TRUST_FILE" 2>/dev/null
}

# Is a project trusted at its current .cleat caps hash?
# Returns 0 when trusted, 1 when not (missing entry, stale hash, or no .cleat).
_is_project_trusted() {
  local project="$1"
  local box="${_BOX:-main}"
  local caps_file stored current
  caps_file="$(_project_caps_file "$project")"
  stored="$(_trust_lookup "$project" "$box")"
  [[ -z "$stored" ]] && return 1
  current="$(_hash_cleat_caps "$caps_file" "$box")"
  [[ -z "$current" ]] && return 1
  [[ "$stored" == "$current" ]]
}

# Show a trust prompt and read y/n. Returns 0 on approval.
# $1 = project path; $2..$N = capability names being requested.
# Must only be called when _is_tty is true.
# How to describe the thing being approved. With per-box config in ONE file, the
# box name is the only thing distinguishing two different consent decisions, so
# a prompt that says only "Project .cleat" is ambiguous the moment a second box
# declares anything. Names the section when the box declares its own.
_trust_subject() {
  local project="$1" box="${2:-main}" kind="$3" file
  file="$(_project_caps_file "$project")"
  if [[ -n "$box" ]] && _cleat_section_present "$file" "box.${box}.${kind}"; then
    printf '.cleat [box.%s.%s]' "$box" "$kind"
  elif [[ "$box" != "main" ]]; then
    printf '.cleat [%s] (box %s)' "$kind" "$box"
  else
    printf '.cleat [%s]' "$kind"
  fi
}

_trust_prompt() {
  local project="$1"; shift
  local caps=("$@")

  # Detect if this is a re-prompt (stored hash exists but doesn't match).
  local is_reprompt=0
  [[ -n "$(_trust_lookup "$project" "${_BOX:-main}")" ]] && is_reprompt=1

  # Comma-joined cap names for the notice line; docker is amber because it
  # breaks the sandbox. Same aligned startup-prompt style (info + _ask_yn) as the
  # image-rebuild, Claude-update, and recreate prompts, not the old notice box.
  local cap _cap_safe _list=""
  for cap in "${caps[@]}"; do
    _cap_safe="$(_sanitize_repo_str "$cap")"
    if [[ "$cap" == "docker" ]]; then
      _list="${_list:+$_list, }${AMBER}${_cap_safe}${RESET}"
    else
      _list="${_list:+$_list, }${BOLD}${_cap_safe}${RESET}"
    fi
  done

  if [[ $is_reprompt -eq 1 ]]; then
    info "Project ${BOLD}.cleat${RESET} changed since you trusted it: it now grants ${_list} ${DIM}on your host${RESET}"
  else
    info "Project ${BOLD}$(_trust_subject "$project" "${_BOX:-main}" caps)${RESET} requests host access: ${_list} ${DIM}(beyond the sandbox)${RESET}"
  fi

  # Default-DENY ([y/N]): only an explicit yes grants the caps. Empty / EOF / no
  # all decline, so untrusted project input never auto-applies.
  local yn=""
  _ask_yn yn "Trust this project's .cleat? ${DIM}(applies its caps; approve once, undo with cleat untrust)${RESET} [y/N] "
  case "$yn" in
    [yY]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Show the [setup] consent prompt and read y/n. Returns 0 on approval.
# A separate consent class from _trust_prompt (concept/16): approving caps
# never approves this, and vice versa.
# $1 = project path, $2 = the built payload (for the preview), $3 = the
# number of declared [setup] entries (before script-directive expansion).
# Must only be called when _is_tty is true.
_setup_trust_prompt() {
  local project="$1" payload="$2" entry_count="$3"

  # Detect if this is a re-prompt (stored hash exists but doesn't match).
  local is_reprompt=0
  [[ -n "$(_trust_lookup_setup "$project" "${_BOX:-main}")" ]] && is_reprompt=1

  if [[ $is_reprompt -eq 1 ]]; then
    info "Project ${BOLD}$(_trust_subject "$project" "${_BOX:-main}" setup)${RESET} setup changed since you approved it: it runs ${BOLD}${entry_count} command(s)${RESET} ${DIM}in the box as coder${RESET}"
  else
    info "Project ${BOLD}$(_trust_subject "$project" "${_BOX:-main}" setup)${RESET} wants to run ${BOLD}${entry_count} command(s)${RESET} ${DIM}in the box as coder (full network access)${RESET}"
  fi

  # Preview: up to the first 15 payload lines, sanitized (repo-controlled
  # text rendered via echo -e, see _sanitize_repo_str), with a truncation
  # note when more remain.
  local total shown=0 line
  total="$(printf '%s\n' "$payload" | wc -l | tr -d ' ')"
  while IFS= read -r line && [[ $shown -lt 15 ]]; do
    shown=$((shown + 1))
    echo -e "      ${DIM}$(_sanitize_repo_str "$line")${RESET}"
  done <<< "$payload"
  if [[ $total -gt 15 ]]; then
    echo -e "      ${DIM}… (+$((total - 15)) more lines, see: cleat setup --show)${RESET}"
  fi

  # Default-DENY ([y/N]): only an explicit yes runs the commands. Empty /
  # EOF / no all decline, so untrusted project input never auto-runs.
  local yn=""
  _ask_yn yn "Run this project's setup commands? ${DIM}(runs once per container; approve once, undo with cleat untrust)${RESET} [y/N] "
  case "$yn" in
    [yY]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Session-scoped decision cache: avoid prompting twice per invocation when
# resolve_caps is called from multiple command paths in the same run.
_TRUST_SESSION_DECISION=""   # "", "approved", "rejected"
_TRUST_SESSION_PROJECT=""    # the project path we decided on
_TRUST_SESSION_BOX=""        # the box we decided on (per-box trust)

# Same idea for [setup] provisioning, a separate consent class (concept/16)
# so it gets its own session cache. The cached decision carries the hash it
# was approved at ("approved:<hash>"): a mid-process rewrite of [setup]
# between two resolve_caps calls must not ride an earlier approval of
# different content, so a stale hash is treated as no cached decision.
_SETUP_SESSION_DECISION=""   # "", "approved:<hash>", "rejected"
_SETUP_SESSION_PROJECT=""    # the project path we decided on
_SETUP_SESSION_BOX=""        # the box we decided on (per-box trust)

# Whether the active project declares a [setup] section (0/1) and whether
# it's currently trusted to run (0/1). Set by _resolve_setup_trust, which
# resets both to 0 on every call: resolve_caps can run for different
# projects within one process.
_SETUP_DECLARED=0
_SETUP_TRUSTED=0

# Exit code of the last _maybe_run_setup payload run (0 on success or any
# skip). Only the explicit `cleat setup` verb reads this, to propagate a real
# exit status; session callers ignore it.
_SETUP_LAST_RC=0

# Containers whose [setup] payload _maybe_run_setup has already attempted to
# run this process (pipe-delimited, bash 3.2-safe accumulator). Guards the
# recreate-funnel double-run where a failed payload leaves no marker; see
# _maybe_run_setup. Force runs (the `cleat setup` verb) ignore it.
_SETUP_ATTEMPTED=""

# Decide whether to apply a project's .cleat caps. Sets _TRUST_SESSION_* on
# first call for a given project. Returns 0 = apply, 1 = skip.
# $1 = project path (must have a .cleat with caps; caller's responsibility).
# $2 = "prompt" (default) or "readonly" to forbid interactive prompting.
_resolve_project_trust() {
  local project="$1"
  local mode="${2:-prompt}"
  local box="${_BOX:-main}"
  local caps_file
  caps_file="$(_project_caps_file "$project")"

  # Cached decision for this session/project/box
  if [[ -n "$_TRUST_SESSION_DECISION" && "$_TRUST_SESSION_PROJECT" == "$project" && "$_TRUST_SESSION_BOX" == "$box" ]]; then
    [[ "$_TRUST_SESSION_DECISION" == "approved" ]] && return 0 || return 1
  fi

  # Already approved at the current hash (per box)
  if _is_project_trusted "$project"; then
    _TRUST_SESSION_DECISION="approved"
    _TRUST_SESSION_PROJECT="$project"
    _TRUST_SESSION_BOX="$box"
    return 0
  fi

  # Explicit non-interactive opt-in
  if [[ "${CLEAT_TRUST_PROJECT:-}" == "1" || "${_CLI_TRUST_PROJECT:-0}" == "1" ]]; then
    local hash
    hash="$(_hash_cleat_caps "$caps_file" "$box")"
    # Preserve any existing [setup] trust (col4): approving caps never
    # creates setup trust, and passing through an empty lookup is exactly
    # that (a no-op 4th arg keeps the row 3-column, see _trust_record).
    _trust_record "$project" "$hash" "$box" "$(_trust_lookup_setup "$project" "$box")" || true
    _TRUST_SESSION_DECISION="approved"
    _TRUST_SESSION_PROJECT="$project"
    _TRUST_SESSION_BOX="$box"
    return 0
  fi

  # Read-only contexts never prompt (e.g. cleat status)
  [[ "$mode" == "readonly" ]] && return 1

  # Interactive prompt
  if _is_tty; then
    local -a req_caps=()
    local c
    while IFS= read -r c; do [[ -n "$c" ]] && req_caps+=("$c"); done < <(_read_caps_from_file "$caps_file" "$box")
    # Hash BEFORE the prompt, from the same read that produced the caps we are
    # about to display. It used to be computed after the answer came back, so a
    # .cleat rewritten while the user was reading the prompt got recorded as
    # approved at its NEW hash: the user approved one set of capabilities and
    # the trust store remembered a different set, with no re-prompt on the next
    # run. The window is however long someone takes to read a security prompt,
    # which is exactly the window that matters, and the writer can be the
    # sandboxed agent itself.
    local hash
    hash="$(_hash_cleat_caps "$caps_file" "$box")"
    if _trust_prompt "$project" "${req_caps[@]}"; then
      # Preserve any existing [setup] trust (col4): see the opt-in branch
      # above, same reasoning.
      _trust_record "$project" "$hash" "$box" "$(_trust_lookup_setup "$project" "$box")" || true
      _TRUST_SESSION_DECISION="approved"
      _TRUST_SESSION_PROJECT="$project"
      _TRUST_SESSION_BOX="$box"
      return 0
    else
      warn "Project .cleat ignored, not trusted ${DIM}(global config still applied)${RESET}"
      _TRUST_SESSION_DECISION="rejected"
      _TRUST_SESSION_PROJECT="$project"
      _TRUST_SESSION_BOX="$box"
      return 1
    fi
  fi

  # Non-TTY, no explicit opt-in: default-deny with an informational warning
  warn "Project .cleat skipped in non-interactive mode ${DIM}(pass --trust-project or set CLEAT_TRUST_PROJECT=1 to approve)${RESET}"
  _TRUST_SESSION_DECISION="rejected"
  _TRUST_SESSION_PROJECT="$project"
  _TRUST_SESSION_BOX="$box"
  return 1
}

# Decide whether to run a project's [setup] provisioning. Sets
# _SETUP_DECLARED and _SETUP_TRUSTED (0/1). Never aborts resolve_caps:
# callers use `_resolve_setup_trust ... || true`. A separate consent class
# from _resolve_project_trust (concept/16): approving caps never approves
# setup, and vice versa.
# $1 = project path. $2 = "prompt" (default) or "readonly" to forbid
# interactive prompting (box is read from ${_BOX:-main}).
_resolve_setup_trust() {
  local project="$1"
  local mode="${2:-prompt}"
  local box="${_BOX:-main}"
  # resolve_caps can run for different projects within one process.
  _SETUP_DECLARED=0
  _SETUP_TRUSTED=0

  # Same no-project guard as the caps block in resolve_caps: an empty
  # project would otherwise resolve to a root-level /.cleat.
  [[ -n "$project" ]] || return 0

  local caps_file
  caps_file="$(_project_caps_file "$project")"
  [[ -f "$caps_file" ]] || return 0

  local payload
  if [[ "$mode" == "readonly" ]]; then
    # Read-only contexts (cleat status) stay fully silent, so swallow the
    # builder's diagnostic about a bad script directive too. cleat setup
    # --show re-surfaces the specific error loudly itself.
    if ! payload="$(_build_setup_payload "$project" "$box" 2>/dev/null)"; then
      return 0
    fi
  else
    # _build_setup_payload already warned about the specific bad directive.
    # A broken [setup] section skips provisioning loudly, it never aborts
    # the session.
    if ! payload="$(_build_setup_payload "$project" "$box")"; then
      return 0
    fi
  fi
  [[ -z "$payload" ]] && return 0
  _SETUP_DECLARED=1

  local hash
  hash="$(_setup_payload_hash "$payload")"

  # Already approved at the current hash (per box)
  local stored
  stored="$(_trust_lookup_setup "$project" "$box")"
  if [[ -n "$stored" && "$stored" == "$hash" ]]; then
    _SETUP_TRUSTED=1
    return 0
  fi

  # Cached decision for this session/project/box. Only honored when the
  # cached hash still matches the current one: a rewrite of [setup]
  # mid-process must not ride an earlier approval of different content.
  if [[ -n "$_SETUP_SESSION_DECISION" && "$_SETUP_SESSION_PROJECT" == "$project" && "$_SETUP_SESSION_BOX" == "$box" ]]; then
    case "$_SETUP_SESSION_DECISION" in
      "approved:$hash") _SETUP_TRUSTED=1; return 0 ;;
      rejected) return 0 ;;
    esac
  fi

  # Read-only contexts never prompt or warn (e.g. cleat status)
  [[ "$mode" == "readonly" ]] && return 0

  # Explicit non-interactive opt-in
  if [[ "${CLEAT_TRUST_SETUP:-}" == "1" || "${_CLI_TRUST_SETUP:-0}" == "1" ]]; then
    # Preserve the existing caps hash (never recompute it here: approving
    # setup never approves caps); "-" when there's none.
    _trust_record "$project" "$(_trust_lookup "$project" "$box")" "$box" "$hash" || true
    _SETUP_SESSION_DECISION="approved:$hash"
    _SETUP_SESSION_PROJECT="$project"
    _SETUP_SESSION_BOX="$box"
    _SETUP_TRUSTED=1
    return 0
  fi

  # Interactive prompt
  if _is_tty; then
    local entry_count
    entry_count="$(_read_setup_from_file "$caps_file" "$box" | wc -l | tr -d ' ')"
    if _setup_trust_prompt "$project" "$payload" "$entry_count"; then
      _trust_record "$project" "$(_trust_lookup "$project" "$box")" "$box" "$hash" || true
      _SETUP_SESSION_DECISION="approved:$hash"
      _SETUP_SESSION_PROJECT="$project"
      _SETUP_SESSION_BOX="$box"
      _SETUP_TRUSTED=1
      return 0
    else
      warn "Project [setup] skipped, not approved ${DIM}(box starts without provisioning; approve later with cleat setup)${RESET}"
      _SETUP_SESSION_DECISION="rejected"
      _SETUP_SESSION_PROJECT="$project"
      _SETUP_SESSION_BOX="$box"
      return 0
    fi
  fi

  # Non-TTY, no explicit opt-in: default-deny with an informational warning
  warn "Project [setup] skipped in non-interactive mode ${DIM}(set CLEAT_TRUST_SETUP=1 or pass --trust-setup to approve)${RESET}"
  _SETUP_SESSION_DECISION="rejected"
  _SETUP_SESSION_PROJECT="$project"
  _SETUP_SESSION_BOX="$box"
  return 0
}

# Guard: warn about each unhandled `[...]` section in a .cleat/global config
# at most once per file per process (no assoc arrays, bash 3.2: a
# pipe-delimited accumulator string).
_WARNED_SECTIONS_FILES=""
# Project cap files whose unsafe-rm has already been reported this run (see
# resolve_caps). Same once-per-file shape as the section warning above.
_WARNED_UNSAFE_RM_FILES=""

# Scan a config file for `[...]` section headers and warn about any this
# CLI version doesn't recognize, so a future or misspelled section degrades
# loudly instead of silently doing nothing (INI hazard, see
# _read_caps_from_file / _read_setup_from_file). scope = "project"
# (.cleat / .cleat.<box>: known sections are caps, resources, setup) or
# "global" (~/.config/cleat/config: known sections are caps, resources,
# kits). A section valid in the OTHER scope gets its own hint, so it reads
# as "wrong file" rather than "ignored".
_warn_unknown_cleat_sections() {
  local file="$1" scope="$2"
  [[ -r "$file" ]] || return 0
  case "$_WARNED_SECTIONS_FILES" in
    *"|$file|"*) return 0 ;;
  esac
  _WARNED_SECTIONS_FILES="${_WARNED_SECTIONS_FILES}|$file|"

  local base seen="" _bn _bk
  base="$(basename "$file")"
  local line name
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, silently voided the first section
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == "["*"]" ]] || continue
    name="${line#[}"; name="${name%]}"
    case "|$seen|" in *"|$name|"*) continue ;; esac
    seen="${seen:+$seen|}$name"
    case "$scope" in
      project)
        # [browser] in a project file is not merely unknown, it is a section
        # someone expected to WORK. Saying so beats the generic line: the
        # difference between "ignored" and "ignored, and here is where it goes"
        # is the difference between a typo and a security hole the user thinks
        # they closed.
        case "$name" in
          browser)
            warn "Section [browser] in .cleat is ignored ${DIM}(browser origins are global: ${BOLD}cleat browser allow <host>${RESET}${DIM})${RESET}"
            continue ;;
        esac
        # Per-box sections. The name AND the kind are both validated, so
        # [box.feta-a.caps] (a typo'd box) and [box.review.capss] still warn:
        # a silently accepted typo is a box running the wrong configuration.
        case "$name" in
          box.*.*)
            _bn="${name#box.}"; _bk="${_bn##*.}"; _bn="${_bn%.*}"
            case "$_bk" in
              caps|resources|setup|fork)
                if _validate_box_name "$_bn"; then continue; fi ;;
            esac ;;
        esac
        case "$name" in
          caps|resources|setup|fork) continue ;;
          kits)
            warn "Section [kits] in .cleat is ignored ${DIM}(kit models are read from the global config only)${RESET}"
            continue ;;
        esac ;;
      global)
        case "$name" in
          # Browser origins are GLOBAL only. See _bridge_origins_from_config:
          # the project file is one the caged agent edits as ordinary work.
          browser) continue ;;
          # Box names are per PROJECT, so a global [box.feat-a.*] would apply to
          # every project that happens to have a box called feat-a.
          box.*)
            warn "Section [$(_sanitize_repo_str "$name")] in the global config is ignored ${DIM}(per-box sections are project-only, in .cleat)${RESET}"
            continue ;;
          caps|resources|kits|fork) continue ;;
          setup)
            warn "Section [setup] in the global config is ignored ${DIM}([setup] is project-only, in .cleat)${RESET}"
            continue ;;
        esac ;;
    esac
    warn "Unknown section [$(_sanitize_repo_str "$name")] in ${base} ${DIM}(ignored)${RESET}"
  done < "$file"
  return 0
}

# Resolve active capabilities: global config + project config + CLI flags.
# Sets the global ACTIVE_CAPS array.
resolve_caps() {
  local project="${1:-}"
  local trust_mode="${2:-prompt}"
  local box="${_BOX:-main}"
  ACTIVE_CAPS=()

  # Every path that resolves capabilities passes through here, so this is where
  # a leftover per-box file gets announced. Warning only from cmd_config meant
  # `cleat start <box>` ran the box with the project defaults while a
  # .cleat.<box> sat there declaring something else, in either direction, with
  # nothing on screen.
  [[ -n "$project" ]] && _warn_legacy_box_file "$project" "$box"

  # 1. Global config
  local global_caps
  global_caps="$(_read_caps_from_file "$CLEAT_GLOBAL_CONFIG")"
  [[ -f "$CLEAT_GLOBAL_CONFIG" ]] && _warn_unknown_cleat_sections "$CLEAT_GLOBAL_CONFIG" global || true

  # 2. Project config, gated by workspace trust. A .cleat file sitting in
  # the repo is untrusted input. Apply its caps only if the user has
  # approved this project (either a persistent trust record, a one-off
  # --trust-project flag, or an interactive "y" to the prompt).
  # The box's cap file REPLACES .cleat (no merge): .cleat.<box> if present,
  # else .cleat; main always uses .cleat. See concept/20-boxes.md.
  local project_caps=""
  if [[ -n "$project" ]]; then
    local caps_file
    caps_file="$(_project_caps_file "$project")"
    [[ -f "$caps_file" ]] && _warn_unknown_cleat_sections "$caps_file" project || true
    if [[ -f "$caps_file" ]]; then
      local _raw_project_caps
      _raw_project_caps="$(_read_caps_from_file "$caps_file" "$box")"
      # unsafe-rm disarms the box's delete-safety guard, and the caged agent can
      # write .cleat in its own workspace. A project file must NEVER grant it, not
      # even a trusted one: strip it here so the only sources are the user's global
      # config and the --cap flag. Say so, because a silent drop reads as a bug.
      if printf '%s\n' "$_raw_project_caps" | grep -qx 'unsafe-rm'; then
        # Said once per file per run: a launch resolves caps more than once, and
        # the warning printed twice. The strip below stays unconditional.
        case "$_WARNED_UNSAFE_RM_FILES" in
          *"|$caps_file|"*) ;;
          *)
            _WARNED_UNSAFE_RM_FILES="${_WARNED_UNSAFE_RM_FILES}|$caps_file|"
            warn "Ignoring ${BOLD}unsafe-rm${RESET} from the project .cleat: it disarms the delete-safety guard and is accepted only from your global config or ${BOLD}--cap${RESET}."
            ;;
        esac
        _raw_project_caps="$(printf '%s\n' "$_raw_project_caps" | grep -vx 'unsafe-rm' || true)"
      fi
      if [[ -n "$_raw_project_caps" ]]; then
        if _resolve_project_trust "$project" "$trust_mode"; then
          project_caps="$_raw_project_caps"
        fi
      fi
    fi
  fi

  # [setup] provisioning trust is a separate consent class from caps trust
  # (concept/16); never let a bad/untrusted [setup] section abort resolve.
  _resolve_setup_trust "$project" "$trust_mode" || true

  # 3. Merge: global + project (union, deduplicated)
  local seen=""
  local cap
  while IFS= read -r cap; do
    [[ -z "$cap" ]] && continue
    case ",$seen," in
      *,"$cap",*) ;;
      *) seen="${seen:+$seen,}$cap"; ACTIVE_CAPS+=("$cap") ;;
    esac
  done <<< "${global_caps}${global_caps:+$'\n'}${project_caps}"

  # 4. Add CLI --cap flags (session-scoped additions)
  for cap in "${_CLI_CAPS[@]+"${_CLI_CAPS[@]}"}"; do
    case ",$seen," in
      *,"$cap",*) ;;
      *) seen="${seen:+$seen,}$cap"; ACTIVE_CAPS+=("$cap") ;;
    esac
  done
}

# Check if a specific capability is active
cap_is_active() {
  local target="$1"
  local cap
  for cap in "${ACTIVE_CAPS[@]+"${ACTIVE_CAPS[@]}"}"; do
    [[ "$cap" == "$target" ]] && return 0
  done
  return 1
}

# ── Capabilities: env file parsing ─────────────────────────────────────────
# Parse an env file and output KEY=VALUE lines (resolved).
# Bare KEY entries are resolved from the host environment.
_parse_env_file() {
  local file="$1"
  [[ -r "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip carriage return (CRLF from Windows editors)
    line="${line%$'\r'}"
    line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, silently voided the first section
    # Strip leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    # Skip empty lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == *=* ]]; then
      # KEY=VALUE: validate key is non-empty
      local _key="${line%%=*}"
      [[ -z "$_key" ]] && continue
      echo "$line"
    else
      # Bare KEY: resolve from host environment
      # Validate variable name to prevent indirect expansion of invalid names
      if [[ ! "$line" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        continue
      fi
      local val="${!line:-}"
      if [[ -n "$val" ]]; then
        echo "${line}=${val}"
      fi
    fi
  done < "$file"
}

# Resolve all env vars to pass to the container.
# Returns an array of -e KEY=VALUE docker arguments via _RESOLVED_ENV_ARGS.
resolve_env_args() {
  local project="${1:-}"
  _RESOLVED_ENV_ARGS=()
  # Parallel arrays: _ek[i] holds the key, _ev[i] holds the value
  local _ek=() _ev=()
  local key val line i

  _env_set() {
    local k="$1" v="$2"
    # Replace existing or append
    for ((i=0; i<${#_ek[@]}; i++)); do
      if [[ "${_ek[$i]}" == "$k" ]]; then
        _ev[$i]="$v"
        return
      fi
    done
    _ek+=("$k")
    _ev+=("$v")
  }

  # 1. If env capability is active, read env files
  if cap_is_active env 2>/dev/null; then
    # Global env file
    if [[ -f "$CLEAT_GLOBAL_ENV" ]]; then
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        key="${line%%=*}"; val="${line#*=}"
        _env_set "$key" "$val"
      done < <(_parse_env_file "$CLEAT_GLOBAL_ENV")
    fi

    # Project env file, box-aware: .cleat.<box>.env else .cleat.env
    local _env_file
    _env_file="$(_project_env_file "$project" "${_BOX:-main}")"
    if [[ -n "$project" && -f "$_env_file" ]]; then
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        key="${line%%=*}"; val="${line#*=}"
        _env_set "$key" "$val"
      done < <(_parse_env_file "$_env_file")
    fi
  fi

  # 2. --env-file flags (always work, bypass capability gate)
  for file in "${_CLI_ENV_FILES[@]+"${_CLI_ENV_FILES[@]}"}"; do
    if [[ ! -f "$file" ]]; then
      error "Env file not found: $file"
      exit 1
    fi
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      key="${line%%=*}"; val="${line#*=}"
      _env_set "$key" "$val"
    done < <(_parse_env_file "$file")
  done

  # 3. --env flags (always work, bypass capability gate)
  for entry in "${_CLI_ENVS[@]+"${_CLI_ENVS[@]}"}"; do
    if [[ "$entry" == *=* ]]; then
      key="${entry%%=*}"; val="${entry#*=}"
      _env_set "$key" "$val"
    else
      # Bare key: resolve from host
      val="${!entry:-}"
      if [[ -n "$val" ]]; then
        _env_set "$entry" "$val"
      fi
    fi
  done

  # 4. Build -e arguments (sorted for deterministic fingerprinting)
  if [[ ${#_ek[@]} -gt 0 ]]; then
    while IFS= read -r key; do
      for ((i=0; i<${#_ek[@]}; i++)); do
        if [[ "${_ek[$i]}" == "$key" ]]; then
          _RESOLVED_ENV_ARGS+=(-e "${key}=${_ev[$i]}")
          break
        fi
      done
    done < <(printf '%s\n' "${_ek[@]}" | sort)
  fi

  unset -f _env_set
}

# Count env vars loaded from each source (for startup feedback)
_env_summary() {
  local project="${1:-}"
  local global_count=0
  local project_count=0

  if cap_is_active env 2>/dev/null; then
    if [[ -f "$CLEAT_GLOBAL_ENV" ]]; then
      global_count=$(_parse_env_file "$CLEAT_GLOBAL_ENV" | wc -l)
      global_count=$((global_count + 0))  # force integer
    fi
    local _env_file
    _env_file="$(_project_env_file "$project" "${_BOX:-main}")"
    if [[ -n "$project" && -f "$_env_file" ]]; then
      project_count=$(_parse_env_file "$_env_file" | wc -l)
      project_count=$((project_count + 0))
    fi
  fi

  if (( global_count + project_count > 0 )); then
    local msg="Env:"
    if (( global_count > 0 )); then
      msg+=" ${global_count} from ~/.config/cleat/env"
    fi
    if (( project_count > 0 )); then
      [[ "$msg" != "Env:" ]] && msg+=","
      msg+=" ${project_count} from $(basename "$_env_file")"
    fi
    info "$msg"
  fi
}

# ── Configuration drift detection ──────────────────────────────────────────
# Fingerprint storage-format version. Bump whenever the fingerprint INPUTS change
# (v0.16.4 dropped the VM-derived resource values). It is stored as a `v<N>:`
# prefix on the container's config-hash label, so a hash written under an OLDER
# format is recognisable as legacy: its bytes can't be recomputed here (we no
# longer know the old formula or the VM size at creation), so a mismatch against
# it can't be trusted to mean real drift. Legacy-format containers are therefore
# NOT nagged to recreate; they adopt the current format the next time they're
# recreated for a genuine reason. See _resolve_config_drift.
_CONFIG_FP_VERSION=2

# Compute a fingerprint from sorted caps + sorted env keys ONLY.
# Env VALUES are intentionally excluded: only structural changes (adding/removing
# keys or capabilities) trigger drift. Value changes don't require container
# recreation since env vars are passed at exec time, not baked into the container.
#
# The CLI VERSION is deliberately NOT part of the fingerprint. Folding it in made
# every release fire a false "caps or env keys differ" notice on existing
# containers whose only change was the version bump: a misleading message whose
# offered remedy (recreate the container from the *same* image) does nothing for a
# version change. Version drift is handled separately by _maybe_prompt_image_rebuild,
# which offers a real rebuild and only when the image is genuinely older.
#
# Same principle for resources (fixed v0.16.4): the fingerprint uses CONFIGURED
# memory/cpus (_configured_box_*), never the VM-derived default or the daemon
# clamp, both of which move when the VM is resized or the CLI's default formula
# changes between releases. Folding those in had quietly re-coupled the hash to
# VM size and CLI version, so a memory-slider tweak or a routine upgrade fired a
# false recreate prompt on a box the user never touched. The stored hash carries a
# format-version prefix (_CONFIG_FP_VERSION) so a future formula change is
# detectable rather than silently mistaken for real drift; see _resolve_config_drift.
compute_config_fingerprint() {
  local project="${1:-}"
  local fingerprint_input=""

  # Caps (sorted)
  fingerprint_input+="caps:"
  if [[ ${#ACTIVE_CAPS[@]} -gt 0 ]]; then
    fingerprint_input+="$(printf '%s\n' "${ACTIVE_CAPS[@]}" | sort | tr '\n' ',')"
  fi
  fingerprint_input+=$'\n'

  # Env keys (sorted HERE, values excluded). We sort inside this function rather
  # than trust the caller's arg order: resolve_env_args happens to emit keys
  # sorted today, but folding that assumption in means a different ordering (a
  # refactor, a new env source) would silently change the hash and fire a false
  # "caps or env keys differ" drift notice on an otherwise-unchanged setup.
  fingerprint_input+="env-keys:"
  if [[ ${#_RESOLVED_ENV_ARGS[@]} -gt 0 ]]; then
    local _ekeys=""
    for arg in "${_RESOLVED_ENV_ARGS[@]}"; do
      [[ "$arg" == -e ]] && continue
      _ekeys+="${arg%%=*}"$'\n'
    done
    fingerprint_input+="$(printf '%s' "$_ekeys" | sort | tr '\n' ',')"
  fi
  fingerprint_input+=$'\n'

  # Resources: only what the user DECLARED in config (_configured_box_*), so an
  # explicit `[resources] memory = 8g` still triggers a recreate (the ceiling is
  # baked at `docker run`, not changeable on a live container) while an
  # unconfigured box stays stable across VM resizes and CLI upgrades. Never the
  # VM-derived default or the daemon-clamped cpus: those move underfoot and were
  # the source of the v0.16.4 false-positive recreate.
  fingerprint_input+="resources:memory=$(_configured_box_memory "$project" "${_BOX:-main}")"
  fingerprint_input+=$'\n'
  fingerprint_input+="resources:cpus=$(_configured_box_cpus "$project" "${_BOX:-main}")"
  fingerprint_input+=$'\n'

  if command -v sha256sum &>/dev/null; then
    echo -n "$fingerprint_input" | sha256sum | head -c 16
  else
    echo -n "$fingerprint_input" | _md5 | head -c 16
  fi
}

# Read config hash stored on a container's Docker label
_container_config_hash() {
  local cname="$1"
  docker inspect "$cname" --format '{{index .Config.Labels "sh.cleat.config-hash"}}' 2>/dev/null || echo ""
}

# Read Cleat version stored on the Docker image label
_image_cleat_version() {
  docker inspect "$IMAGE_NAME" --format '{{index .Config.Labels "sh.cleat.version"}}' 2>/dev/null || echo ""
}

# Read the image-content spec stamped on the Docker image label. Empty for
# pre-stamping images (built before sh.cleat.image-spec existed) and for any
# image the daemon can't inspect. See _IMAGE_SPEC_VERSION.
_image_spec_version() {
  docker inspect "$IMAGE_NAME" --format '{{index .Config.Labels "sh.cleat.image-spec"}}' 2>/dev/null || echo ""
}

# True when version $1 is >= version $2 (dotted numeric, prerelease/build suffix
# stripped). Used to classify a pre-stamping image's content from the version it
# was built at. Pure integer field sort, bash 3.2 safe.
_version_ge() {
  local a="${1%%[-+]*}" b="${2%%[-+]*}"
  [[ "$a" == "$b" ]] && return 0
  local newest
  newest="$(printf '%s\n%s\n' "$a" "$b" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
  [[ "$newest" == "$a" ]]
}

# Read the Claude Code version bundled in the image. The `claude` launcher is a
# symlink into ~/.local/share/claude/versions/<v>, so the target's basename is
# the version. Prints the version string, or nothing if it can't be determined
# (e.g. layout changed, or no image). Spawns a throwaway container to resolve
# the symlink as it exists *inside* the image.
_image_claude_version() {
  local target v
  target="$(docker run --rm "$IMAGE_NAME" \
    bash -c 'readlink -f /home/coder/.local/bin/claude 2>/dev/null' 2>/dev/null)" || true
  case "$target" in
    */versions/*) v="${target##*/versions/}"; v="${v%%/*}" ;;
    *) v="" ;;
  esac
  printf '%s' "$v"
}

# Return success if the container's settings-overlay bind sources are all
# present and the right type. Return failure when the overlay dir is missing
# OR when any bind source within it is missing or has the wrong type.
#
# The overlay now lives under $CLEAT_RUN_DIR (persistent), not /tmp, so routine
# macOS /tmp rotation no longer invalidates it. This check now serves two roles:
#   1. Migration: a container created before the move has its overlay mounts
#      under /tmp, so the new-layout dir is absent → recreate to adopt the
#      persistent layout.
#   2. Defense: if the overlay dir or a file within it is missing (manual
#      deletion, partial state), recreate rather than mount a broken source.
# Why per-file, not just the dir: Docker auto-creates a missing bind source as a
# directory, which then fails to mount onto a file destination with an opaque
# OCI "not a directory" error.
_settings_overlay_intact() {
  local cname="$1"
  local overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  [[ -d "$overlay_dir" ]] || return 1

  local mounts src
  mounts="$(docker inspect "$cname" --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' 2>/dev/null)" || return 0
  [[ -n "$mounts" ]] || return 0
  while IFS= read -r src; do
    [[ -z "$src" ]] && continue
    case "$src" in
      "$overlay_dir"/* | "$CLEAT_PROJECTS_DIR"/*)
        # Overlay files and the persistent per-project .claude.json are bind
        # sources mounted onto file destinations. If one was deleted, Docker
        # would auto-create it as a directory and the start would fail with an
        # opaque OCI error; recreate instead.
        [[ -f "$src" ]] || return 1
        ;;
    esac
  done <<< "$mounts"
  return 0
}

# Return failure when any of the container's bind-mount sources no longer exist
# on the host. Bind sources are baked in at `docker run` (creation) and cannot
# be changed; `docker start` re-mounts the SAME recorded sources, and if one has
# vanished it aborts with an opaque OCI error:
#   error mounting "<src>" to rootfs at "<dst>" ... not a directory:
#   Are you trying to mount a directory onto a file (or vice-versa)?
#
# The classic trigger is the macOS SSH agent socket (the `ssh` cap). launchd
# regenerates its socket directory (…/com.apple.launchd.XXXX/Listeners) on every
# boot, so SSH_AUTH_SOCK rotates and the path baked into the container points at
# a directory that no longer exists: every `ssh`-cap box fails to restart after
# a reboot. Detect it here so the caller can recreate transparently (cheap: the
# container is disposable; auth, sessions, and the project all live in other
# mounts). Only `bind` mounts are checked: volumes/tmpfs have no host source to
# stat. Unreadable inspect (no daemon, gone container) → treat as present (0):
# the start path that follows surfaces the real error.
_container_bind_sources_present() {
  local cname="$1"
  local mounts line typ src
  mounts="$(docker inspect "$cname" \
    --format '{{range .Mounts}}{{.Type}}|{{.Source}}{{"\n"}}{{end}}' 2>/dev/null)" || return 0
  [[ -n "$mounts" ]] || return 0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    typ="${line%%|*}"
    src="${line#*|}"
    [[ "$typ" == "bind" ]] || continue
    [[ -n "$src" ]] || continue
    [[ -e "$src" ]] || return 1
  done <<< "$mounts"
  return 0
}

# Build a per-project ~/.claude.json for the container, isolated from the shared
# host file. Mounting the host ~/.claude.json directly (the old behavior) caused
# two problems, because every container runs at CWD /workspace and writes back
# to the same host file:
#   1. Corruption: concurrent/interrupted writes from parallel containers
#      truncate the file → Claude greets the user with "Configuration Error /
#      Unexpected EOF" on startup.
#   2. Cross-project bleed: all containers share projects["/workspace"], so
#      trust-dialog / MCP / allowedTools approvals leak between unrelated projects.
#
# Strategy (per-project, host-as-base): on each (re)create AND on each start of
# a stopped container (see _refresh_project_claude_json) take the host file
# WHOLE as the base, preserving Claude's global identity, onboarding, migration
# flags, and whatever schema the installed host version writes (no drift), then
# overlay this project's persisted projects["/workspace"] block on top. Global
# identity/onboarding keys fall back to the persisted copy when the host lacks
# them, so onboarding done inside a container on a fresh machine still sticks;
# when BOTH lack them they fall back to the newest sibling box that holds a
# login (_newest_sibling_identity), so a login done inside any box satisfies
# the login gate of every box built or started afterwards.
# The result is written ATOMICALLY (temp + mv) to a persistent, project-keyed
# file that the container mounts. The container never writes the host file, so
# the corruption race and the cross-project bleed are gone by construction.
#
# jq-free sanity check: does a file look like a JSON object? After stripping all
# whitespace it must be non-empty and start with `{` and end with `}`. This is a
# heuristic, not a parser: it can't catch interior damage, but it reliably
# catches the dominant corruption mode (a truncated write → Claude's "Unexpected
# EOF"), which never ends in `}`. Used only when jq is unavailable on the host.
_looks_like_json_object() {
  local content
  content="$(tr -d '[:space:]' < "$1" 2>/dev/null)" || return 1
  [[ -n "$content" && "${content:0:1}" == "{" && "${content: -1}" == "}" ]]
}

# Replace a bind-mounted file's content IN PLACE without ever leaving it empty.
#
# The box sees ~/.claude.json through a single-file bind mount, so a new copy
# cannot be renamed over it (that swaps the inode out from under the mount) and
# has to be written into the same inode. `cat new > file` does that by
# TRUNCATING first, and until the write lands the file is empty. A reader in a
# tight loop saw it empty in about 1 read in 100 across 300 such rewrites on a
# Linux host, and Claude Code 2.1.270 does real damage with what it reads
# there. A session starting in the window stops on "Configuration error" and
# offers to reset the whole file. A running one "auto-repairs" by writing its
# cached copy back in place, after which the rest of our write lands on top of
# it and leaves broken JSON behind (reproduced against the real binary with
# rename made to fail the way it does on a bind mount).
#
# `1<>` opens the file without truncating it, and the new content is padded
# with trailing spaces to at least the old length, which JSON allows. A reader
# sees the whole old object or the whole new one, never an empty file and never
# a leftover tail. The file keeps the size of its largest past version until
# Claude next writes it, which resets the padding.
#
# This protects READERS only. A process writing the same file at the same time
# still tears it, so every caller checks for a live Claude right before.
#
# SRC is padded in place, so it must be a temp file the caller owns and drops.
_write_in_place() {
  local src="$1" dst="$2" old new
  [[ -f "$dst" && ! -L "$dst" && -f "$src" && -s "$src" ]] || return 1
  # wc pads its output on BSD, so the count goes through tr before it is used
  # as a number.
  old="$(wc -c < "$dst" 2>/dev/null | tr -d '[:space:]')"
  new="$(wc -c < "$src" 2>/dev/null | tr -d '[:space:]')"
  case "$old" in ''|*[!0-9]*) return 1 ;; esac
  case "$new" in ''|*[!0-9]*) return 1 ;; esac
  if (( new < old )); then
    printf '%*s' "$(( old - new ))" '' >> "$src" 2>/dev/null || return 1
  fi
  cat "$src" 1<> "$dst" 2>/dev/null
}

# Print the path of the newest sibling per-project claude.json that carries an
# oauthAccount, excluding $1 (the file being rebuilt). A login done INSIDE a
# box writes oauthAccount only into that box's mounted per-project file, and
# nothing ever writes the host ~/.claude.json (by design, see the strategy
# note above _build_project_claude_json), so this scan is how a login reaches
# every OTHER box that gets built or started afterwards: login once, every box.
# Prints nothing when no sibling has one. Requires jq (callers only use the
# result on the jq path). Fail-soft: any unreadable/corrupt sibling is skipped.
# A sibling whose box is pinned to a named account is skipped as well, see
# _pinned_project_keys.
_newest_sibling_identity() {
  local exclude="$1" f best="" best_m=0 m pinned k
  command -v jq &>/dev/null || return 0
  pinned="$(_pinned_project_keys)"
  for f in "$CLEAT_PROJECTS_DIR"/*/claude.json; do
    [[ -f "$f" ]] || continue
    [[ "$f" == "$exclude" ]] && continue
    # A box on a NAMED account holds that account's identity in its file, and
    # nothing inside the file says whose it is. Handing it to a box on the
    # shared login stamps the wrong email on it, which is the mirror of the
    # guard the builder already has for a pinned box reading the host file.
    k="${f%/claude.json}"
    k="${k##*/}"
    [[ "$pinned" == *":${k}:"* ]] && continue
    jq -e '.oauthAccount? != null' "$f" >/dev/null 2>&1 || continue
    m="$(_path_mtime "$f")"
    if (( m > best_m )); then best_m=$m; best="$f"; fi
  done
  [[ -n "$best" ]] && printf '%s' "$best"
  return 0
}

# Args: $1 = output path (the mount source / persisted per-project file)
#       $2 = optional persisted-input path (defaults to $1; the attached-box
#            in-place refresh writes a TEMP output while reading the real file)
#       $3 = optional container name, so the build can see whether this box is
#            pinned to a named account (`cleat account`). Identity is HOST-first
#            by default, which is right for a box on the shared login and wrong
#            for a pinned one: it would re-stamp the host account's email and
#            organisation onto a box running as somebody else, on every start.
_build_project_claude_json() {
  local out="$1"
  local proj_src="${2:-$1}"
  local _bpj_cname="${3:-}"
  local _bpj_pinned=0
  if [[ -n "$_bpj_cname" ]] && [[ "$(_box_account_read "$_bpj_cname")" != "$_ACCOUNT_DEFAULT" ]]; then
    _bpj_pinned=1
  fi
  mkdir -p "$(dirname "$out")"

  # Defensive: a stray directory at the output path (e.g. Docker auto-created a
  # missing bind source as a dir on a prior run) would make the atomic mv fail
  # and then break the file→file mount. Clear anything that isn't a regular file.
  [[ -e "$out" && ! -f "$out" ]] && rm -rf "$out"

  local host="${HOME}/.claude.json"
  local host_src="$host"

  # Corruption guard: never feed a broken host file into the build, and never
  # silently reset it to {}. "Broken" = not parseable JSON (the common case is a
  # truncated file → Claude's "Unexpected EOF") OR valid JSON that isn't an
  # object (a malformed shape that would crash the merge). Back the bad file up
  # and warn so the user can recover it; proceed from the persisted project copy
  # (onboarding preserved). The guard runs WITHOUT jq too: jq gives a precise
  # check, otherwise a pure-bash heuristic (must be {…}) catches truncation, the
  # dominant corruption mode, so a jq-less host can't propagate a corrupt file.
  local host_broken=false
  if [[ -f "$host" && -s "$host" ]]; then
    if command -v jq &>/dev/null; then
      jq -e 'type=="object"' "$host" >/dev/null 2>&1 || host_broken=true
    else
      _looks_like_json_object "$host" || host_broken=true
    fi
  fi
  if $host_broken; then
    cp "$host" "${host}.bak" 2>/dev/null || true
    warn "Host ${BOLD}~/.claude.json${RESET} is corrupt, backed up to ${BOLD}~/.claude.json.bak${RESET}."
    echo -e "    ${DIM}Container uses last-known project state; the host file is left untouched.${RESET}"
    host_src=""
  fi

  if command -v jq &>/dev/null; then
    local tmp="${out}.tmp.$$"
    local hf pf sf sib
    if [[ -n "$host_src" && -f "$host_src" && -s "$host_src" ]]; then hf="$host_src"; else hf=/dev/null; fi
    # The PERSISTED project copy gets the same corruption guard as the host
    # file above. It had none, so a project file truncated by a full disk or a
    # killed write was fed to jq, jq failed on the whole merge, and the box
    # came up with a file it could not read. Nothing healed it, so every later
    # start reproduced it: the box was stuck on the login screen with no
    # message naming the cause. Backing it up and treating it as absent lets
    # the merge rebuild from the host file and the sibling identity.
    if [[ -f "$proj_src" && -s "$proj_src" ]] && ! _looks_like_json_object "$proj_src"; then
      cp "$proj_src" "${proj_src}.bak" 2>/dev/null || true
      warn "This project's stored ${BOLD}.claude.json${RESET} was corrupt, backed up alongside it."
      echo -e "    ${DIM}Rebuilding it from the host file. Session history for this project may be reset.${RESET}"
      proj_src=""
    fi
    if [[ -n "$proj_src" && -f "$proj_src" && -s "$proj_src" ]]; then pf="$proj_src"; else pf=/dev/null; fi
    # Identity gained inside another box (its mounted per-project file is the
    # only place an in-box login lands) fills identity keys that BOTH the host
    # file and this project's own copy lack. Without it, a login done in box A
    # leaves every box built afterwards on the login screen, despite the fresh
    # shared ~/.claude/.credentials.json (the second half of the login gate).
    sf=/dev/null
    # A pinned box skips the sibling scan entirely. The scan picks the newest
    # per-project file that holds a login, and nothing in that file says WHICH
    # account it belongs to, so on a machine with two accounts it would stamp a
    # box with the other one's identity. Skipping is strictly safer than
    # guessing: Claude refetches identity from its own profile endpoint.
    if [[ $_bpj_pinned -eq 0 ]]; then
      sib="$(_newest_sibling_identity "$out")"
      [[ -n "$sib" && -f "$sib" && -s "$sib" ]] && sf="$sib"
    fi
    # slurpfile reads each input fully before output is written, so reading $out
    # while writing $tmp is safe; mv makes the swap atomic.
    if jq -n --slurpfile h "$hf" --slurpfile p "$pf" --slurpfile s "$sf" \
            --argjson pinned "$( [[ $_bpj_pinned -eq 1 ]] && printf true || printf false )" '
        ($h[0] // {}) as $host |
        ($p[0] // {}) as $proj |
        ($s[0] // {}) as $sib |
        (($host.projects // {}) + ($proj.projects // {})) as $projects |
        # What a brand-new /workspace is born with INSIDE the cage. The sandbox
        # IS the trust boundary and cleat always launches claude with
        # --dangerously-skip-permissions, so pre-accepting folder trust, project
        # onboarding, and bypass mode for /workspace is correct, and it stops a
        # newer bundled Claude from re-running its first-run/onboarding flow (which
        # can surface as a login screen) in a fresh project that has no persisted
        # block. Defaults are on the LEFT of `+`, so any persisted/host /workspace
        # value wins per key (jq `+` is right-biased). Unknown future key names are
        # harmless extras; the real ones gate the prompts.
        ({hasTrustDialogAccepted:true, hasCompletedProjectOnboarding:true, bypassPermissionsModeAccepted:true}) as $wsdefaults |
        # Base is proj-then-host (host wins any shared top-level key, so there is
        # no schema drift from the installed host version), but a top-level key
        # present ONLY in this per-project copy SURVIVES. That matters because
        # this rebuild now re-runs on accumulated box state (stopped-box
        # start/resume and the running-box attach heal, not just first create),
        # and a host-only base would silently drop box-written top-level state
        # like a user-scoped mcpServers (claude mcp add -s user) on every start.
        # At first create $proj is {} so this is identical to a host-only base.
        # .projects and identity are still overlaid explicitly below, so their
        # precedence is unchanged.
        ($proj + $host)
        + { projects: ($projects + { "/workspace": ($wsdefaults + ($projects["/workspace"] // {})) }) }
        # Identity precedence: host wins, then the persisted copy of THIS
        # project, then the newest sibling box that holds a login (see
        # _newest_sibling_identity). jq // falls through per key on null.
        + ( (if $pinned then ["userID","lastOnboardingVersion"]
                         else ["oauthAccount","userID","lastOnboardingVersion"] end)
            | map({ (.): ($host[.] // $proj[.] // $sib[.]) })
            | add
            | with_entries(select(.value != null)) )
        # userID stays host-first even when pinned: it is machine-scoped, a
        # random 64-hex string, not derived from the account. oauthAccount is
        # the opposite, so for a pinned box it is REMOVED here rather than
        # merely left out of the overlay. Leaving it out is not enough, because
        # ($proj + $host) already carried the host copy into the base. NOTE: no
        # apostrophes in this comment block, it sits inside a single-quoted
        # jq program.
        # cachedUsageUtilization goes with it, and for a reason that is only
        # true for a pinned box. Claude guards that cache against cross-account
        # reuse by comparing its stored accountUuid against the one in
        # oauthAccount, and a pinned box has deliberately removed oauthAccount,
        # so the entry is written WITHOUT a uuid and read back as a match. A
        # failed live fetch inside the hour would then show the OTHER account
        # numbers under "Showing last-known usage".
        | (if $pinned then del(.oauthAccount) | del(.cachedUsageUtilization) else . end)
        # Onboarding is complete by construction inside the cage. This flag is
        # load-bearing: Claude 2.1.x gates its startup login/onboarding screen
        # on hasCompletedOnboarding ALONE (verified in the 2.1.202 binary; an
        # in-box /logout sets it false, which is what re-prompted every later
        # session), while oauthAccount above is identity/org metadata that some
        # Claude flows also treat as login state. A dead token surfaces as a
        # runtime "revoked, run /login" error instead.
        + { hasCompletedOnboarding: true }
        # The container always runs the native installer build (~/.local/bin/
        # claude → versions/), but this file is rebuilt from the host every run,
        # shadowing the installMethod the installer wrote at image-build time.
        # Without it, `claude doctor` warns "native installation but config
        # install method is unknown" and the updater logs install_failed. Force
        # it to match the real install so config agrees with the filesystem.
        + { installMethod: "native" }
      ' > "$tmp" 2>/dev/null; then
      mv -f "$tmp" "$out"
    else
      rm -f "$tmp" 2>/dev/null || true
      # jq failed unexpectedly: keep the persisted copy if present, else start clean.
      [[ -f "$out" && -s "$out" ]] || echo '{}' > "$out"
    fi
  else
    # No jq: best effort. Keep persisted copy, else seed from host, else empty.
    if [[ -f "$out" && -s "$out" ]]; then
      :
    elif [[ -n "$host_src" && -f "$host_src" && -s "$host_src" ]]; then
      cp "$host_src" "$out"
    else
      echo '{}' > "$out"
    fi
    # Both of those sources can carry an account this pinned box is not on: the
    # host login, or the one the box was on before a switch. The jq branch above
    # deletes it on every build and a host with no jq cannot, so flag it. The
    # launch clears it through the box's own jq before Claude reads the file
    # (_claude_json_clear_stale_identity).
    if [[ $_bpj_pinned -eq 1 ]]; then
      : > "${out}.identity-stale" 2>/dev/null || true
    fi
  fi
}

# Rebuild the per-project ~/.claude.json bind source for a STOPPED container,
# just before `docker start`. Bind sources are re-resolved at start and a
# stopped box has no writer, so this is the safe moment to fold in host-side
# changes and identity gained in other boxes since it stopped (the login-once
# -every-box guarantee; without this, only a full recreate would pick it up).
# Never call it for a RUNNING container: the mount pins the file's old inode
# (the atomic mv swaps inodes) and the container may be mid-write.
_refresh_project_claude_json() {
  local project="$1" box="$2"
  local key
  key="$(_derive_project_session_key "$project" "$box")"
  _build_project_claude_json "$CLEAT_PROJECTS_DIR/${key}/claude.json" "" \
    "$(container_name_for "$project" "$box")"
}

# The RUNNING-box counterpart, for session attach. The create/start rebuilds
# cannot run here: the bind mount pins the file's inode (the atomic temp+mv
# swap would detach it) and a live box may hold concurrent writers. But a
# running box carries exactly the poisoned state the rebuild exists to fix:
# an in-box /logout writes hasCompletedOnboarding:false into the live file.
# Claude 2.1.x gates its startup login/onboarding screen on that flag ALONE
# (verified in the binary), so every later session in the box re-prompts for
# login despite fresh shared credentials. The gate below therefore keys on
# hasCompletedOnboarding only: an already-onboarded box shows no login screen
# regardless of oauthAccount, so it short-circuits with no docker probe and no
# rewrite (this is what keeps an API-key box, which never has an oauthAccount,
# from running the pipeline on every single attach). oauthAccount is still
# injected from a sibling at create/start; a running box that is onboarded but
# identity-less simply doesn't need it to avoid the re-prompt.
#
# When it DOES heal (onboarding false) it goes through _build_project_claude_json,
# whose proj-then-host base preserves any box-written top-level state (e.g. a
# user-scoped mcpServers), then copies the temp over the SAME inode with a
# truncating cat (the bind mount pins the inode; an atomic mv would detach the
# container's view). It runs only past the liveness gate (docker top shows no
# claude process; fail-safe: unknown counts as live), so no concurrent writer
# exists and the only reader (the claude this session is about to exec) starts
# after the write completes. Two simultaneous attaches can both heal; they
# write near-identical objects microseconds apart (last writer wins), a benign
# host-side race left deliberately unlocked.
_refresh_attached_claude_json() {
  local cname="$1" project="$2" box="$3"
  [[ -n "$project" ]] || return 0
  local key f
  key="$(_derive_project_session_key "$project" "$box")"
  f="$CLEAT_PROJECTS_DIR/${key}/claude.json"
  # Before the jq gate, because this is the half of the identity drop a host
  # with no jq leaves for the launch, and it is the launch that has a running
  # box to borrow a jq from.
  _claude_json_clear_stale_identity "$cname" "$f" "$box"
  command -v jq &>/dev/null || return 0
  [[ -f "$f" && -s "$f" ]] || return 0
  # Cheap gate first: an onboarded box shows no login screen, nothing to fix,
  # no docker call. Only a logout-poisoned (or never-onboarded) box proceeds.
  jq -e '.hasCompletedOnboarding == true' "$f" >/dev/null 2>&1 && return 0
  _box_has_live_agent "$cname" && return 0
  local tmp="${f}.attach.$$"
  _build_project_claude_json "$tmp" "$f" "$cname"
  # Refuse to copy anything that is not a healed object (a failed build leaves
  # {} or nothing): an in-place write must never make the file worse.
  # The build above scans every sibling project, which can take seconds, and a
  # second terminal's claude may have started in that time. Its own saves write
  # this same file in place, so two in-place writers tear it. Ask again here.
  if [[ -s "$tmp" ]] && jq -e '.hasCompletedOnboarding == true' "$tmp" >/dev/null 2>&1 \
     && ! _box_has_live_agent "$cname"; then
    _write_in_place "$tmp" "$f" || true
  fi
  rm -f "$tmp" 2>/dev/null
  return 0
}

# Print a notice box with dynamic width. Each argument is a line of plain text.
# Supports {BOLD}...{/BOLD} for bold spans within lines.
_notice_box() {
  local lines=("$@")
  local width=0
  local i line stripped

  # Find widest line
  for line in "${lines[@]}"; do
    stripped="${line//{BOLD\}/}"
    stripped="${stripped//{\/BOLD\}/}"
    local len=${#stripped}
    [[ $len -gt $width ]] && width=$len
  done

  # Draw box
  local border=""
  for (( i = 0; i < width + 4; i++ )); do border+="─"; done

  echo ""
  echo -e "  ${CYAN}┌${border}┐${RESET}"
  for line in "${lines[@]}"; do
    stripped="${line//{BOLD\}/}"
    stripped="${stripped//{\/BOLD\}/}"
    local pad=""
    for (( i = ${#stripped}; i < width; i++ )); do pad+=" "; done
    # Replace {BOLD}/{/BOLD} with actual escape codes
    local formatted="${line//\{BOLD\}/${BOLD}}"
    formatted="${formatted//\{\/BOLD\}/${RESET}}"
    echo -e "  ${CYAN}│${RESET}  ${formatted}${pad}  ${CYAN}│${RESET}"
  done
  echo -e "  ${CYAN}└${border}┘${RESET}"
  echo ""
}

# Resolve configuration drift between the current config and the existing
# container. Triggers: a changed capability (`cleat config --enable <cap>`), a
# changed env key, or a changed EXPLICITLY-configured resource limit
# ([resources] memory/cpus in .cleat). On TTY: prompt to recreate; on accept,
# stop+rm container and clean tmp dirs so the caller's existing "no container"
# path (cmd_run) recreates with the new config. On non-TTY or declined: print a
# warning and continue with the stale container.
#
# Only hashes written in the current storage format (the v<N>: prefix) are
# comparable. A legacy or unlabelled hash can't be recomputed (we no longer know
# the old formula or the VM size at creation), so a mismatch against it would be
# a guess: such containers are NOT nagged, and silently adopt the current format
# the next time they're recreated for a real reason. This is what makes a CLI
# upgrade that changes the fingerprint formula recreate-free.
_resolve_config_drift() {
  local cname="$1"
  local project="${2:-}"

  container_exists "$cname" || return 0

  local stored_hash current_hash
  stored_hash="$(_container_config_hash "$cname")"
  [[ "$stored_hash" == "v${_CONFIG_FP_VERSION}:"* ]] || return 0
  current_hash="v${_CONFIG_FP_VERSION}:$(compute_config_fingerprint "$project")"
  [[ "$stored_hash" == "$current_hash" ]] && return 0

  if _is_tty; then
    info "${BOLD}Config changed${RESET} since ${BOLD}${cname}${RESET} was created: its capabilities, environment, or resource limits differ from your current setup"
    local yn=""
    _ask_yn yn "Recreate ${BOLD}${cname}${RESET} now? [Y/n] "
    if [[ -z "$yn" || "$yn" == [yY]* ]]; then
      info "Recreating container..."
      if is_running "$cname"; then
        docker stop "$cname" > /dev/null 2>&1 || true
      fi
      docker rm -f "$cname" > /dev/null 2>&1 || true
      _account_wipe_run_dir "${cname}"
      success "Removed ${BOLD}${cname}${RESET}."
      return 0
    fi
    info "Skipped. Keeping existing container. Run ${BOLD}cleat rm && cleat${RESET} when ready."
    return 0
  fi

  info "${BOLD}Config changed${RESET} since ${BOLD}${cname}${RESET} was created. Recreate to apply: ${BOLD}cleat rm && cleat${RESET}"
}

# Image-content drift: the local image's baked content spec is OLDER than the
# spec this CLI ships, so it predates a real change under docker/ (entrypoint,
# clipboard/browser shims, the Dockerfile, a pinned base). Offer to refresh it
# as an interactive startup action, the same aligned Y/n prompt style (_ask_yn)
# as the other startup prompts. This is keyed to IMAGE CONTENT, not the CLI
# version: a version-only release leaves _IMAGE_SPEC_VERSION untouched and never
# nags. See concept/24-image-spec-versioning.md.
#
# Pre-stamping images (built before sh.cleat.image-spec existed) carry no spec
# label; their content is inferred from the version they were built at, so an
# image already at today's content stays silent and the cutover to this scheme
# forces no recreate. An image with neither label is left alone (fail open).
#
# On accept: acquire the current image, then drop this project's container so the
# normal start flow recreates it from the fresh image (the same mechanism
# _resolve_config_drift uses). Runs at most once per process, TTY-only, and only
# when the image content is strictly OLDER (never nags an equal-or-newer image).
_REBUILD_PROMPTED=0
_maybe_prompt_image_rebuild() {
  local cname="$1"
  _is_tty || return 0
  [[ "$_REBUILD_PROMPTED" == "1" ]] && return 0
  image_exists || return 0

  # Resolve the local image's content spec. Newer images carry an explicit
  # integer label; pre-stamping images infer it from their build version against
  # _IMAGE_SPEC_INTRO_VERSION (at/after intro == today's content == spec 1). An
  # image with no spec AND no version is exotic/hand-built: fail open, never nag.
  local stored_spec
  stored_spec="$(_image_spec_version)"
  if [[ -z "$stored_spec" ]]; then
    local image_version
    image_version="$(_image_cleat_version)"
    [[ -n "$image_version" ]] || return 0
    if _version_ge "$image_version" "$_IMAGE_SPEC_INTRO_VERSION"; then
      stored_spec=1
    else
      stored_spec=0
    fi
  fi
  # Guard a malformed label, then prompt only when the image content is strictly
  # older than what this CLI ships. Equal (current) or greater (a dev image
  # pulled ahead of the CLI) never nags. The 10# forces base 10 so a tampered
  # leading-zero label (e.g. 08) can't be misread as invalid octal and leak an
  # arithmetic error to stderr on the otherwise-silent start path.
  [[ "$stored_spec" =~ ^[0-9]+$ ]] || return 0
  (( 10#$stored_spec < 10#$_IMAGE_SPEC_VERSION )) || return 0
  _REBUILD_PROMPTED=1

  info "Cleat image is out of date: its setup predates this release ${DIM}(image content changed, not just the version)${RESET}"
  local yn=""
  _ask_yn yn "Refresh the image now? ${DIM}(downloads the prebuilt v${VERSION}, or builds it locally; recreates this project's container, discarding its writable layer)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    # Prefer pulling the released multi-arch image for THIS version: it ships
    # the exact tested setup and Claude build, and a download beats a ~2 min
    # local rebuild. Fall back to a local build only when the prebuilt image
    # isn't published (e.g. an unreleased dev VERSION). Same chain as cmd_run's
    # acquisition path, so an outdated image is refreshed the same way a missing
    # one is acquired. See concept/22 (multi-arch publish).
    _do_pull "$VERSION" || _do_build
    # Drop the existing container so the start flow recreates it from the fresh
    # image (its bind mounts and base layer are baked in at creation time).
    if container_exists "$cname"; then
      is_running "$cname" && docker stop "$cname" > /dev/null 2>&1 || true
      docker rm -f "$cname" > /dev/null 2>&1 || true
      _account_wipe_run_dir "${cname}"
    fi
  fi
}

# Reaper drift: containers created before Cleat passed --init have `su` as
# PID 1, which never reaps re-parented children. Orphans from agent subshells
# accumulate as zombies until the box hits its pids cap, fork() fails, and the
# session wedges mid-keystroke (`docker stop` also burns its full timeout,
# `su` doesn't forward SIGTERM either). Detect such boxes on start and offer a
# recreate, which picks up --init from the current creation flags. Same prompt
# family as _maybe_prompt_image_rebuild: TTY-only, once per process, fail-open.
_INIT_RECREATE_PROMPTED=0
_maybe_prompt_init_recreate() {
  local cname="$1"
  _is_tty || return 0
  [[ "$_INIT_RECREATE_PROMPTED" == "1" ]] && return 0
  container_exists "$cname" || return 0
  # {{json .HostConfig}} is version-portable: Init serializes as true / false /
  # null (very old daemons omit the key). Only an explicit true means a reaper
  # is present; an inspect failure stays silent: never block a start on it.
  local hostconfig
  hostconfig="$(docker inspect --format '{{json .HostConfig}}' "$cname" 2>/dev/null)" || return 0
  [[ -n "$hostconfig" ]] || return 0
  [[ "$hostconfig" == *'"Init":true'* ]] && return 0
  _INIT_RECREATE_PROMPTED=1

  info "Box ${BOLD}${cname}${RESET} predates the zombie reaper ${DIM}(long sessions can freeze at the pids cap)${RESET}"
  local yn=""
  _ask_yn yn "Recreate it now? ${DIM}(project files and Claude state survive; /tmp and apt installs don't)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    is_running "$cname" && { docker stop "$cname" > /dev/null 2>&1 || true; }
    docker rm -f "$cname" > /dev/null 2>&1 || true
    _account_wipe_run_dir "${cname}"
  fi
}

# ── First-run tip ──────────────────────────────────────────────────────────
_first_run_tip_file="$CLEAT_CONFIG_DIR/.tip-shown"

show_first_run_tip() {
  # Show tip if no config file and tip hasn't been shown
  if [[ ! -f "$CLEAT_GLOBAL_CONFIG" && ! -f "$_first_run_tip_file" ]]; then
    info "Tip: run ${BOLD}cleat config${RESET} to enable git access, env passthrough, and more"
    mkdir -p "$CLEAT_CONFIG_DIR"
    touch "$_first_run_tip_file"
  fi
}

# ── Startup output ─────────────────────────────────────────────────────────
#
# Caps display groups active caps by behavior: same UI on the landing page.
#   mount   green   git, ssh, env, hooks, gh    auth/identity, no install
#   sandbox amber   docker                      breaks isolation (host socket)
#
# When only one category has active caps the line collapses to the legacy
# single-line form (`Caps:    git, ssh`). With caps in two categories the
# renderer breaks them into a labeled block: the categorization itself
# teaches the user that the docker cap behaves differently.

# Map a single cap name to its display category. Stdout: mount|sandbox|guard.
_cap_category() {
  case "$1" in
    docker)    echo "sandbox" ;;
    unsafe-rm) echo "guard" ;;
    *)         echo "mount" ;;
  esac
}

# Bucket ACTIVE_CAPS into _CAPS_MOUNT/_CAPS_SANDBOX/_CAPS_GUARD globals.
_caps_bucket_active() {
  _CAPS_MOUNT=()
  _CAPS_SANDBOX=()
  _CAPS_GUARD=()
  local cap
  for cap in "${ACTIVE_CAPS[@]+"${ACTIVE_CAPS[@]}"}"; do
    case "$(_cap_category "$cap")" in
      sandbox) _CAPS_SANDBOX+=("$cap") ;;
      guard)   _CAPS_GUARD+=("$cap") ;;
      mount)   _CAPS_MOUNT+=("$cap") ;;
    esac
  done
}

# Render the active caps. Indent prefix, top-level label, single-line pad,
# and label color are parameters so the same renderer drives both the
# summary block (DIM label) and `cleat status` (BOLD label).
_print_caps() {
  local indent="${1:-  }"
  local label="${2:-Caps:}"
  local pad="${3:-      }"
  local label_color="${4:-$DIM}"

  [[ ${#ACTIVE_CAPS[@]} -eq 0 ]] && return 0
  _caps_bucket_active

  local cats=0
  [[ ${#_CAPS_MOUNT[@]}   -gt 0 ]] && cats=$((cats + 1))
  [[ ${#_CAPS_SANDBOX[@]} -gt 0 ]] && cats=$((cats + 1))
  [[ ${#_CAPS_GUARD[@]}   -gt 0 ]] && cats=$((cats + 1))

  # A guard cap always renders in the labeled block so its "(disables ...)" note
  # is never dropped by the single-line fast path, even when it is the only cap.
  if [[ $cats -le 1 && ${#_CAPS_GUARD[@]} -eq 0 ]]; then
    local color s
    if [[ ${#_CAPS_SANDBOX[@]} -gt 0 ]]; then
      color="$AMBER"; s="$(printf '%s, ' "${_CAPS_SANDBOX[@]}")"
    else
      color="$GREEN"; s="$(printf '%s, ' "${_CAPS_MOUNT[@]}")"
    fi
    s="${s%, }"
    s="$(_sanitize_repo_str "$s")"
    echo -e "${indent}${label_color}${label}${RESET}${pad}${color}${BOLD}${s}${RESET}"
    return 0
  fi

  echo -e "${indent}${label_color}${label}${RESET}"
  local s
  if [[ ${#_CAPS_MOUNT[@]} -gt 0 ]]; then
    s="$(printf '%s, ' "${_CAPS_MOUNT[@]}")"; s="${s%, }"
    s="$(_sanitize_repo_str "$s")"
    echo -e "${indent}  ${DIM}mount:${RESET}    ${GREEN}${BOLD}${s}${RESET}"
  fi
  if [[ ${#_CAPS_SANDBOX[@]} -gt 0 ]]; then
    s="$(printf '%s, ' "${_CAPS_SANDBOX[@]}")"; s="${s%, }"
    s="$(_sanitize_repo_str "$s")"
    echo -e "${indent}  ${DIM}sandbox:${RESET}  ${AMBER}${BOLD}${s}${RESET} ${DIM}(breaks isolation)${RESET}"
  fi
  if [[ ${#_CAPS_GUARD[@]} -gt 0 ]]; then
    s="$(printf '%s, ' "${_CAPS_GUARD[@]}")"; s="${s%, }"
    s="$(_sanitize_repo_str "$s")"
    echo -e "${indent}  ${DIM}guard:${RESET}    ${RED}${BOLD}${s}${RESET} ${DIM}(disables the delete-safety prompt)${RESET}"
  fi
}

# Legacy entry point retained for tests and possible future inline use.
_print_startup_caps() {
  _print_caps "  " "Caps:" "      "
}

_print_summary_block() {
  local cname="$1"
  local project="${2:-}"
  echo ""
  echo -e "  ${DIM}Container:${RESET}  ${BLUE}${cname}${RESET}"
  if [[ -n "$project" ]]; then
    local _tilde='~'
    local display_path="${project/#$HOME/$_tilde}"
    # With the docker cap the container's workdir IS the host path (mounted at
    # its own path so $(pwd) and `docker run -v $(pwd)` resolve on the host
    # daemon; see the docker-cap mount block). Without it, the project lives at
    # /workspace. Show the truth for each case.
    #
    # A fork box is a third case and it used to fall into the first one, which
    # read "Project: ~/proj (same path, sandboxed)". That is false twice over:
    # the box has the COPY mounted, not ~/proj, and the path it is mounted at is
    # the copy's own path. A real host run showed exactly that line above a Fork
    # line naming a different directory. Say "not mounted" and let the Fork line
    # below say what is.
    if _box_is_fork "$cname"; then
      echo -e "  ${DIM}Project:${RESET}    ${display_path} ${DIM}(not mounted, this box works on a copy)${RESET}"
    elif cap_is_active docker; then
      echo -e "  ${DIM}Project:${RESET}    ${display_path} ${DIM}(same path, sandboxed)${RESET}"
    else
      echo -e "  ${DIM}Project:${RESET}    ${display_path} ${DIM}→${RESET} /workspace"
    fi
  fi
    # A fork box works on a COPY, so printing only "Project: ~/foo" would be
    # actively misleading: edits there do not touch that path. Show where the
    # copy lives (landing the work needs the path) and how old it is, because a
    # fork drifts from the project it was taken from and nothing else says so.
    if _box_is_fork "$cname"; then
      local _fp _age _where
      _fp="$(_fork_dir "$cname")"
      _age="$(_fork_age_human "$_fp")"
      # Now that the Project line says "not mounted", this line has to carry the
      # mount, in the same shape the Project line uses for a plain box.
      if cap_is_active docker; then
        _where="${DIM}(same path, sandboxed)${RESET}"
      else
        _where="${DIM}→${RESET} /workspace"
      fi
      if [[ -n "$_age" ]]; then
        echo -e "  ${DIM}Fork:${RESET}       ${_fp/#$HOME/~} ${_where} ${DIM}(copied ${_age})${RESET}"
      else
        echo -e "  ${DIM}Fork:${RESET}       ${_fp/#$HOME/~} ${_where}"
      fi
    fi
  # A box's personality must never be invisible: show the enabled kit. The
  # selection file is hand-editable, so print its content as DATA (%s), never
  # through echo -e (same convention as cmd_describe).
  local _summary_kit
  _summary_kit="$(_box_kit_read "$cname")"
  if [[ -n "$_summary_kit" ]]; then
    printf '  %bKit:%b        %b%s%b\n' "$DIM" "$RESET" "$BLUE" "$_summary_kit" "$RESET"
  fi
  # Same rule as the Kit row: the pin file is hand-editable, so print it as
  # DATA (%s), never through echo -e. Silent on `default`, which is every box
  # that has never run the verb.
  local _summary_acct _summary_eff=0
  _summary_acct="$(_box_account_read "$cname")"
  if [[ -n "$_summary_acct" && "$_summary_acct" != "$_ACCOUNT_DEFAULT" ]]; then
    _account_effective "$cname" >/dev/null || _summary_eff=$?
    if [[ $_summary_eff -ne 0 ]]; then
      # The warning about this prints further down, so the row must not read as
      # a statement that the box IS on that account.
      printf '  %bAccount:%b    %b%s%b %b(not in effect, recreate the box)%b\n' \
        "$DIM" "$RESET" "$BLUE" "$_summary_acct" "$RESET" "$DIM" "$RESET"
    else
      printf '  %bAccount:%b    %b%s%b\n' "$DIM" "$RESET" "$BLUE" "$_summary_acct" "$RESET"
    fi
  fi
  _print_caps "  " "Caps:" "       "
  # The browser bridge mode and whether the destination gate is on (EGRESS-SPEC
  # B7). Silent in auto, which is every launch that never set the variable, so
  # the default summary stays as quiet as concept/21 asks. The two other modes
  # are a host env var the user may have set months ago in a profile, and
  # `always` turns the gate off for opening, so each is named on every launch
  # rather than only by `cleat browser origins`.
  case "$(_browser_bridge_mode)" in
    always) echo -e "  ${DIM}Browser:${RESET}    ${AMBER}${BOLD}always${RESET} ${DIM}(any origin the box picks, destination check off)${RESET}" ;;
    off)    echo -e "  ${DIM}Browser:${RESET}    ${BOLD}off${RESET} ${DIM}(nothing auto-opens, callback proxy still runs for an allowlisted origin)${RESET}" ;;
  esac
  _env_summary_inline "$project"
}

_env_summary_inline() {
  local project="${1:-}"
  local global_count=0
  local project_count=0
  local global_exists=false
  local project_exists=false

  if cap_is_active env 2>/dev/null; then
    if [[ -f "$CLEAT_GLOBAL_ENV" ]]; then
      global_exists=true
      global_count=$(_parse_env_file "$CLEAT_GLOBAL_ENV" | wc -l)
      global_count=$((global_count + 0))
    fi
    local _env_file
    _env_file="$(_project_env_file "$project" "${_BOX:-main}")"
    if [[ -n "$project" && -f "$_env_file" ]]; then
      project_exists=true
      project_count=$(_parse_env_file "$_env_file" | wc -l)
      project_count=$((project_count + 0))
    fi
  fi

  if $global_exists || $project_exists; then
    local msg=""
    if $global_exists; then
      msg+="${global_count} from ~/.config/cleat/env"
    fi
    if $project_exists; then
      [[ -n "$msg" ]] && msg+=", "
      msg+="${project_count} from $(basename "$_env_file")"
    fi
    echo -e "  ${DIM}Env:${RESET}        ${msg}"
  fi
}

# ── Clipboard bridge ──────────────────────────────────────────────────────
# DISABLE_AUTOUPDATER=1 turns off Claude Code's launch-time/background self-
# updater inside the container. Cleat owns Claude's version (it's baked into the
# image and updated via `cleat upgrade-claude`); an in-container self-update is
# ephemeral (reverts on recreate) AND has been observed to hang the TUI at launch
# on a freshly-(re)created container. Manual `claude update` / `claude doctor`
# still work. See docs.claude.com/en/setup#disable-auto-updates.
CLAUDE_ENV=(-e HOME=/home/coder -e DISABLE_AUTOUPDATER=1 -e PATH="/home/coder/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")

# TERM/COLORTERM are the two DELIBERATE host-templated entries: docker exec -t
# does not propagate the attached terminal's type, so without these the box's
# terminfo can mismatch the real terminal (wrong key sequences, degraded
# colors in iTerm2/Ghostty/tmux). Everything else from the host stays out,
# the exec_claude tests pin the exact key set.
CLAUDE_ENV+=(-e "TERM=${TERM:-xterm-256color}")
if [[ -n "${COLORTERM:-}" ]]; then
  CLAUDE_ENV+=(-e "COLORTERM=${COLORTERM}")
fi

# BROWSER must ride every exec, not just `docker run`: exec inherits the
# CONTAINER's Config.Env, frozen at create. A box created before v1.1.1 has no
# BROWSER there (and its image predates the ENV), so claude 2.1.191+ refuses to
# invoke any opener and login drops to the manual code-paste flow, silently,
# forever: the config fingerprint excludes cleat-injected env, so nothing ever
# nags a recreate. Injecting it here heals every existing box on its next
# session. The shim itself has shipped in the image since the bridge landed, so
# the target exists even in old boxes. CLAUDE_ENV precedes the user's [env]
# args on every exec line and docker's last -e wins, so a .cleat `BROWSER=`
# override still beats this, matching the create-time ordering. A one-shot
# `--env BROWSER=...` given only at create is overridden here on later
# sessions (exec -e beats the frozen Config.Env, as it already did for
# HOME/PATH/TERM); a lasting override belongs in the [env] config.
CLAUDE_ENV+=(-e "BROWSER=/usr/local/bin/open-bridge")

# IS_SANDBOX rides every exec only when the HOST user is root. Claude hard-
# refuses --dangerously-skip-permissions under uid 0 (its root/sudo guard,
# anthropics/claude-code#9184), and on a root-only host (a stock VPS image,
# `sudo cleat`) the entrypoint's uid remap makes coder uid 0, so every session
# died at launch with "Claude exited with code 1" right after a green
# bring-up. IS_SANDBOX=1 is upstream's own escape hatch for exactly this
# case, a sandboxed container (Anthropic's reference devcontainer sets it).
# Scoped to a root host so ordinary boxes keep an unchanged env, and injected
# at exec (not create) so existing root boxes heal on their next session.
if [[ "$(id -u)" == "0" ]]; then
  CLAUDE_ENV+=(-e "IS_SANDBOX=1")
fi

_host_clip_cmd() {
  if command -v pbcopy &>/dev/null; then echo pbcopy
  elif command -v xclip &>/dev/null; then echo "xclip -selection clipboard"
  elif command -v xsel &>/dev/null; then echo "xsel --clipboard"
  elif command -v wl-copy &>/dev/null; then echo wl-copy
  else echo ""
  fi
}

# ── Image paste (concept/39) ──────────────────────────────────────────────
# Claude Code reads a clipboard IMAGE by shelling out to
#   xclip -selection clipboard -t TARGETS -o | grep -E "image/(png|jpeg|...)"
# which inside a box hits Cleat's copy shim (exits 0, no output) and would fail
# even without it: the box has no DISPLAY, no Wayland and no X socket. Nothing
# in a box can reach the host pasteboard, and giving it a way to would hand the
# model an on-demand read of everything you copy. So the image is delivered from
# the HOST side: the box's ctrl+v shim writes a request and the host watcher
# answers it with the current clipboard image.

# Write the host clipboard's image to $1. Returns 0 on success, 1 when the
# clipboard holds no image. Stock tools only: `pngpaste` is the usual macOS
# answer and is Homebrew-only, while osascript ships with the OS.
_host_clip_read_image() {
  local out="$1" tiff rc=1
  : > "$out" 2>/dev/null || return 1

  if _is_macos; then
    # «class PNGf» is what a screenshot or a Preview copy publishes. Passing the
    # path through argv rather than interpolating it into the script keeps a
    # path with quotes or spaces from becoming AppleScript source.
    osascript - "$out" <<'AS' >/dev/null 2>&1
on run argv
  set f to open for access (POSIX file (item 1 of argv)) with write permission
  try
    set eof f to 0
    write (the clipboard as «class PNGf») to f
    close access f
  on error errMsg
    try
      close access f
    end try
    error errMsg
  end try
end run
AS
    [ -s "$out" ] && return 0

    # Chromium and Electron apps (Figma, Chrome) publish TIFF and no PNGf.
    # /usr/bin/sips is stock, so this stays dependency-free.
    tiff="${out}.tiff"
    osascript - "$tiff" <<'AS' >/dev/null 2>&1
on run argv
  set f to open for access (POSIX file (item 1 of argv)) with write permission
  try
    set eof f to 0
    write (the clipboard as «class TIFF») to f
    close access f
  on error errMsg
    try
      close access f
    end try
    error errMsg
  end try
end run
AS
    if [ -s "$tiff" ] && command -v sips &>/dev/null; then
      sips -s format png "$tiff" --out "$out" >/dev/null 2>&1 && [ -s "$out" ] && rc=0
    fi
    rm -f "$tiff" 2>/dev/null || true
    return $rc
  fi

  if _is_wsl && _wsl_interop_ok; then
    # -Sta is mandatory: the clipboard APIs need a single-threaded apartment.
    # Base64 over the pipe avoids binary mangling, and the CR strip is required
    # because PowerShell emits CRLF.
    powershell.exe -NoProfile -NonInteractive -Sta -Command \
      'Add-Type -AssemblyName System.Windows.Forms; $i=[Windows.Forms.Clipboard]::GetImage(); if($i -ne $null){$m=New-Object IO.MemoryStream; $i.Save($m,[Drawing.Imaging.ImageFormat]::Png); [Convert]::ToBase64String($m.ToArray())}' \
      2>/dev/null | tr -d '\r' | base64 -d > "$out" 2>/dev/null
    [ -s "$out" ] && return 0
    return 1
  fi

  # Linux desktop. On a headless host there is no clipboard at all, so this
  # finds nothing and the paste request is answered empty.
  if command -v xclip &>/dev/null; then
    xclip -selection clipboard -t image/png -o > "$out" 2>/dev/null
    [ -s "$out" ] && return 0
  fi
  if command -v wl-paste &>/dev/null; then
    wl-paste --type image/png > "$out" 2>/dev/null
    [ -s "$out" ] && return 0
  fi
  return 1
}

# ── Native ctrl+v image paste ─────────────────────────────────────────────
# Claude Code's Linux clipboard contract, extracted verbatim from the 2.1.227
# bundle:
#   checkImage: xclip -selection clipboard -t TARGETS -o | grep -E "image/(png|jpeg|jpg|gif|webp|bmp)" || wl-paste -l ...
#   saveImage:  xclip -selection clipboard -t image/png -o > FILE || wl-paste ... || -t image/bmp ...
# Two separate invocations, so the host pasteboard is read ONCE on the check and
# the bytes are cached in the box for the save.
#
# The shim is dropped into /home/coder/.local/bin, which bin/cleat already puts
# first on PATH for every docker exec. Nothing under cli/docker/ changes, so no
# image spec bump and no box is recreated.
#
# The shim is a CONVENIENCE, never a control: it lives inside the cage where the
# model can replace it. Every gate that matters is host-side, and the request it
# sends is contentless on purpose (see _clipimg_watcher).
_CLIPIMG_BOX_DIR="/home/coder/.cleat-clipimg"
_CLIPIMG_SHIM_PATH="/home/coder/.local/bin/xclip"
_CLIPIMG_MAX_BYTES=10485760       # 10 MB, the ceiling on a served image

# Write the shim to $1. Kept in one place so the tests can execute it directly.
_clipimg_emit() {
  cat > "$1" << 'CLIPIMG_SHIM_EOF'
#!/bin/sh
# cleat-shim v1
# Answers Claude Code's clipboard IMAGE probes by asking the host. Anything
# else is delegated to the real shim, so copy and text reads behave exactly as
# they did before this file existed.
REQ=/tmp/cleat-clip/.image-req
LOCK=/tmp/cleat-clip/.image-lock
D="$HOME/.cleat-clipimg"
REAL=/usr/local/bin/xclip

# Parse a COPY of the args so "$@" survives for the delegation below. A
# substring match would misread `-selection clipboard` and `-t text/plain`.
want_out=0; target=""; next_is_target=0
for a in "$@"; do
  if [ "$next_is_target" -eq 1 ]; then target="$a"; next_is_target=0; continue; fi
  case "$a" in
    -o|-out|-output|--out|--output) want_out=1 ;;
    -t|-target|--target)            next_is_target=1 ;;
    -t?*)                           target="${a#-t}" ;;
  esac
done

[ "$want_out" -eq 1 ] || exec "$REAL" "$@"

case "$target" in
  TARGETS)  ;;
  image/*)
    # Save leg: hand over the bytes the check leg cached, once.
    [ -s "$D/cache.png" ] || exit 1
    cat "$D/cache.png"
    rm -f "$D/cache.png" 2>/dev/null
    exit 0 ;;
  *) exec "$REAL" "$@" ;;
esac

# Check leg: ask the host, and always terminate. A shim that blocks forever
# would hang the paste for the life of the session.
mkdir -p "$D" 2>/dev/null
# Single flight. Two fast ctrl+v presses share one fixed temp path upstream, so
# refusing the second is strictly better than racing it.
mkdir "$LOCK" 2>/dev/null || exit 1
# Release the lock on any catchable signal. Without this, a shim killed while it
# holds the lock (session Ctrl+C or the terminal closing mid-paste) strands the
# lock DIRECTORY on the shared mount, and since nothing box-side sweeps it every
# later paste fails the mkdir above and silently attaches nothing. SIGKILL
# cannot be trapped, so the host watcher sweeps a stale lock too; this covers the
# common signals at no cost.
trap 'rm -f "$REQ" 2>/dev/null; rmdir "$LOCK" 2>/dev/null; exit 1' INT TERM HUP
# Clear AFTER taking the lock, so a second press that loses the lock cannot
# delete the winner's in-flight delivery on its way out. Only the holder wipes
# the slot, and it still clears before writing the request, so a fully-landed
# stale delivery from an earlier paste is never mistaken for this one.
rm -f "$D/in.png" "$D/in.done" "$D/cache.png" 2>/dev/null
: > "$REQ" 2>/dev/null || { rmdir "$LOCK" 2>/dev/null; exit 1; }

# The host's first act is to rm the marker, so its disappearance is proof a
# watcher is alive. No heartbeat needed, and no host write into this directory.
i=0
while [ -e "$REQ" ]; do
  i=$((i + 1))
  if [ "$i" -gt 24 ]; then
    rm -f "$REQ" 2>/dev/null
    rmdir "$LOCK" 2>/dev/null
    exit 1
  fi
  sleep 0.05
done

i=0
while [ ! -e "$D/in.done" ]; do
  i=$((i + 1))
  if [ "$i" -gt 50 ]; then rmdir "$LOCK" 2>/dev/null; exit 1; fi
  sleep 0.05
done
rmdir "$LOCK" 2>/dev/null
# Past the locked region: a late signal must not turn a nearly-complete paste
# into a lock cleanup that exits 1.
trap - INT TERM HUP

# An empty in.png is the host's negative answer.
[ -s "$D/in.png" ] || exit 1
mv "$D/in.png" "$D/cache.png" 2>/dev/null || exit 1
echo "image/png"
exit 0
CLIPIMG_SHIM_EOF
  chmod +x "$1" 2>/dev/null || true
}

# Drop the shim into a running box, ahead of the real xclip on PATH. Idempotent:
# re-run every session, overwriting any earlier copy. Nothing under cli/docker/
# changes, so no image spec bump and no recreate.
_clipimg_drop_shim() {
  local cname="$1"
  local tmp="$CLEAT_RUN_DIR/$cname/.clipimg-shim.$$"
  mkdir -p "$CLEAT_RUN_DIR/$cname" 2>/dev/null || return 1
  _clipimg_emit "$tmp" || { rm -f "$tmp" 2>/dev/null; return 1; }
  docker exec -u coder "$cname" mkdir -p /home/coder/.local/bin >/dev/null 2>&1 || true
  docker cp "$tmp" "$cname:$_CLIPIMG_SHIM_PATH" >/dev/null 2>&1 || { rm -f "$tmp" 2>/dev/null; return 1; }
  # docker cp preserves the host file's 0755, so coder can exec it. Force it
  # anyway in case a daemon quirk drops the bit.
  docker exec -u root "$cname" chmod 0755 "$_CLIPIMG_SHIM_PATH" >/dev/null 2>&1 || true
  rm -f "$tmp" 2>/dev/null || true
}

# Remove our shim, and only ours. The v1 marker on line 2 is what keeps this
# from deleting a file the user placed at the same path. Used when the kill
# switch is set so a box goes straight back to today's behaviour.
_clipimg_remove_shim() {
  local cname="$1"
  docker exec -u coder "$cname" sh -c \
    'f=/home/coder/.local/bin/xclip; [ -f "$f" ] && head -2 "$f" 2>/dev/null | grep -q "cleat-shim v1" && rm -f "$f"' \
    >/dev/null 2>&1 || true
}

# Answer one image request: read the host clipboard, validate, deliver. Called
# by the watcher after it has already consumed the request marker. ALWAYS
# delivers, positive or negative, so the shim never waits out its timeout on a
# text paste. A negative answer is an empty in.png.
_clipimg_serve() {
  local cname="$1" stage_dir="$2"
  mkdir -p "$stage_dir" 2>/dev/null || return 0
  # Unique per serve. A reader killed by the bound below can leave an orphan
  # child (osascript) that writes late, and a fixed name would let it scribble
  # the NEXT serve's file. A unique name sends that stray write to a dead path.
  local img="$stage_dir/serve.$$.${RANDOM}.png"
  rm -f "$img" 2>/dev/null || true
  : > "$img"

  # Image-only by construction: _host_clip_read_image has no text reader. On a
  # text or empty clipboard it fails and leaves the file empty.
  #
  # Bound the read. It shells out to osascript, which can block with no limit:
  # the macOS 15.4+ pasteboard-privacy modal waits on a human click, a large
  # TIFF plus a sips convert is slow, a WSL powershell is a cold start. If it
  # overran the requesting shim's ~2.5s give-up window, the shim would report a
  # miss while this serve was still in flight, and the late delivery would then
  # be attached by the NEXT paste as a stale wrong image. macOS ships no
  # timeout(1), so bound it with a background job and a kill. Worst case is a
  # miss, which the gates below already produce, never a wrong image.
  _host_clip_read_image "$img" >/dev/null 2>&1 &
  local _rpid=$! _rn=0
  while kill -0 "$_rpid" 2>/dev/null; do
    _rn=$((_rn + 1))
    if [ "$_rn" -ge 16 ]; then kill "$_rpid" 2>/dev/null; break; fi   # ~1.6s
    sleep 0.1
  done
  wait "$_rpid" 2>/dev/null || true

  # Validate independently of the reader, the same two host-side gates: magic
  # kind and size. Any failure collapses to an empty file, which the shim reads
  # as a miss.
  local kind size
  kind="$(_image_magic_kind "$img" 2>/dev/null)"
  size="$(wc -c < "$img" 2>/dev/null | tr -d '[:space:]')"
  case "$size" in ''|*[!0-9]*) size=0 ;; esac
  if [ -z "$kind" ] || [ "$size" -eq 0 ] || [ "$size" -gt "$_CLIPIMG_MAX_BYTES" ]; then
    : > "$img"
  fi
  chmod 0644 "$img" 2>/dev/null || true

  # Deliver in.png first and let it finish, THEN in.done. docker cp is
  # synchronous, so once in.done exists in.png is already whole. The shim waits
  # on in.done, so it can never read a half-copied image. docker cp resolves
  # inside the container rootfs, so a symlink the box planted at either path can
  # only redirect the file elsewhere inside the box.
  docker cp "$img" "$cname:$_CLIPIMG_BOX_DIR/in.png" >/dev/null 2>&1
  local done="$stage_dir/done.$$"
  : > "$done"; chmod 0644 "$done" 2>/dev/null || true
  docker cp "$done" "$cname:$_CLIPIMG_BOX_DIR/in.done" >/dev/null 2>&1
  rm -f "$img" "$done" 2>/dev/null || true
}

# Poll for image requests and serve them. One dedicated watcher rather than
# folding into _clipboard_watcher, because that one is event-driven off inotify
# and this needs a tight fixed cadence at keystroke time. 250 ms worst-case
# notice sits well inside the shim's 1.2 s give-up window.
_clipimg_watcher() {
  local clip_dir="$1" cname="$2"
  trap 'exit 0' TERM INT HUP
  local _ciw_parent=$$
  local req="$clip_dir/.image-req"
  local lock="$clip_dir/.image-lock"
  local stage_dir; stage_dir="$(dirname "$clip_dir")/clipimg-stage"
  while true; do
    # Orphan guards, same as the other watchers: the run dir vanishing (rm/nuke)
    # or the parent cleat dying (terminal closed, SIGKILL) stops the poll.
    [ -d "$clip_dir" ] || exit 0
    kill -0 "$_ciw_parent" 2>/dev/null || exit 0
    # Sweep a lock a shim stranded when a signal (SIGKILL, or one that beat its
    # trap) killed it mid-paste. It is a DIRECTORY on the shared mount that
    # survives stop/start, and nothing else removes it, so every later paste
    # would fail its mkdir and silently attach nothing (the same latch class as
    # .host-ready). The shim holds it at most ~4s, so older than 10s is orphaned.
    # rmdir, since rm -f no-ops on a directory. This runs before the first paste
    # can, so a lock stranded by a prior session clears in time. A negative age
    # (clock stepped back) is left alone: never yank a live lock.
    # A symlink at the lock path is never the shim's, which only ever mkdirs a
    # real directory. `[ -d ]` DEREFERENCES, so a link to a directory would aim
    # the rmdir at that directory instead, and a link to anything else latches
    # image paste off forever (every later mkdir keeps failing). Drop it unread.
    if [ -L "$lock" ]; then
      rm -f "$lock" 2>/dev/null || true
    elif [ -e "$lock" ] && [ ! -d "$lock" ]; then
      rm -f "$lock" 2>/dev/null || true
    fi
    if [ -d "$lock" ] && [ "$(( $(date +%s) - $(_path_mtime "$lock") ))" -gt 10 ]; then
      rmdir "$lock" 2>/dev/null || true
    fi
    # Atomic claim: mv, not test-then-rm. Two sessions on one box each run a
    # watcher on this shared dir, and a non-atomic [ -e ] then rm -f let both
    # pass in one window and both serve, doubling the host clipboard read (two
    # osascript pasteboard accesses per paste). mv makes the request vanish for
    # exactly one winner, and its disappearance is still the shim's proof a
    # watcher is alive. A symlink at $req is moved, not followed, then dropped
    # unread: the request carries nothing.
    # Guarded so an IDLE tick forks nothing: this loop runs four times a second
    # for the life of every session, and the overwhelmingly common case is no
    # pending request. Same shape as the browser watcher's claim guard. The
    # -L arm keeps a planted symlink claimable, so it is still swept below.
    if { [ -e "$req" ] || [ -L "$req" ]; } && mv "$req" "$req.claimed" 2>/dev/null; then
      rm -f "$req.claimed" 2>/dev/null || true
      _clipimg_serve "$cname" "$stage_dir"
    fi
    sleep 0.25
  done
}

# Remove .watcher.<pid> markers whose process is gone. Each marker is stamped
# with the HOST pid of a clipboard watcher, so `kill -0` is the liveness test,
# the same shape _box_has_attached_session uses for .attached.<pid>.
#
# A recycled pid can make a dead marker look live, which only delays the sweep
# to the next session. The reverse mistake, treating a live watcher as dead,
# would drop .host-ready out from under a working bridge, so this errs toward
# keeping a marker.
_sweep_dead_watcher_markers() {
  local dir="$1" m pid
  for m in "$dir"/.watcher.*; do
    [ -e "$m" ] || continue
    pid="${m##*/.watcher.}"
    case "$pid" in
      ''|*[!0-9]*) rm -f "$m" 2>/dev/null || true; continue ;;
    esac
    kill -0 "$pid" 2>/dev/null || rm -f "$m" 2>/dev/null || true
  done
}

# The image type of $1 by magic bytes, or empty. Never trust an extension: this
# decides what gets pushed into a box.
_image_magic_kind() {
  local sig
  sig="$(LC_ALL=C head -c 12 "$1" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')"
  case "$sig" in
    89504e470d0a1a0a*)           printf 'png' ;;
    ffd8ff*)                     printf 'jpg' ;;
    474946383761*|474946383961*) printf 'gif' ;;
    52494646????????57454250*)   printf 'webp' ;;
    *)                           printf '' ;;
  esac
}

# Mirrors MAX_PAYLOAD in docker/clip. The shim caps what it writes, but the
# cap has to hold on the HOST too: the shim is not the only thing that can put
# a file in the shared clip dir, and the README states the limit as a fact.
_CLIP_MAX_PAYLOAD=102400          # 100KB

_clipboard_watcher() {
  local clip_dir="$1"
  local clip_cmd="$2"
  trap 'exit 0' TERM INT HUP
  # Same orphan story as _browser_watcher: a watcher whose cleat process died
  # without the cleanup trap (terminal closed, SIGKILL) must not keep writing
  # a dead session's box clipboard over the host clipboard. Checked at the
  # single copy choke point so all three watch modes are covered.
  local _cw_parent=$$

  # Remove any payload left over from an earlier session before advertising
  # readiness. A leftover means no watcher claimed it (teardown race, or a
  # crash that skipped cleanup); replaying it now would shove a dead
  # session's copy over whatever the user currently has on the host
  # clipboard (the stale-redelivery bug). Age-gated like the browser
  # bridge's startup sweep: concurrent watchers share this dir, and a FRESH
  # file is a live copy a sibling is about to claim, so only a file older
  # than several poll ticks is a true leftover. A NEGATIVE age (mtime ahead
  # of the clock after a backward clock step) also sweeps: failing toward
  # "never replay old bytes into the clipboard" is this bridge's safe
  # direction. _path_mtime returns 0 on failure, which reads as ancient and
  # still gets swept, so unreadable files fail safe too.
  #
  # A SYMLINK here is never a real copy. The shim only ever renames a regular
  # file into place, so a link is something the box planted, and it is dropped
  # unread and unaged: see _do_copy for what reading one would do. It must be
  # tested before the [ -f ] below, because -f follows the link and a link to a
  # regular host file passes it.
  local leftover_age
  if [ -L "$clip_dir/clipboard" ]; then
    rm -f "$clip_dir/clipboard" 2>/dev/null || true
  elif [ -f "$clip_dir/clipboard" ]; then
    leftover_age=$(( $(date +%s) - $(_path_mtime "$clip_dir/clipboard") ))
    if [ "$leftover_age" -gt 5 ] || [ "$leftover_age" -lt 0 ]; then
      rm -f "$clip_dir/clipboard" 2>/dev/null || true
    fi
  fi
  # Claims live OUTSIDE the bind mount. Only $clip_dir is shared with the box
  # (docker run -v "$clip_dir":/tmp/cleat-clip), so a claim renamed up here is
  # one the box cannot see, enumerate or swap, which is what closes the window
  # between the rename and the read in _do_copy. A dedicated subdir rather than
  # the run dir itself: the idle sweep measures staleness from the run dir's
  # mtime, so churning claim files directly in it would re-stamp that clock on
  # every copy and quietly hold the box out of the sweep.
  local claim_dir
  claim_dir="$(dirname "$clip_dir")/clipclaim"
  mkdir -p "$claim_dir" 2>/dev/null || claim_dir="$clip_dir"

  # Claims stranded by a watcher killed between rename and delivery are the
  # same kind of leftover: same age gate. A live claim is milliseconds old
  # and never matches.
  local stale_claim
  for stale_claim in "$claim_dir"/.claim.* "$clip_dir"/.claim.*; do
    [ -f "$stale_claim" ] || continue
    if [ $(( $(date +%s) - $(_path_mtime "$stale_claim") )) -gt 5 ]; then
      rm -f "$stale_claim" 2>/dev/null || true
    fi
  done

  _sweep_dead_watcher_markers "$clip_dir"
  # touch FOLLOWS a symlink, so a link planted at this path would have the host
  # create or re-stamp whatever file it names. Drop it first.
  _drop_unless_regular "$clip_dir/.host-ready"
  touch "$clip_dir/.host-ready"

  # Consume-on-read, mirroring _browser_claim_url: atomically claim the
  # payload before piping it to the host clipboard, so a delivered copy no
  # longer exists on disk and can never be replayed by a later session's
  # watcher. When several watchers race (two sessions on one box), the
  # rename hands the payload to exactly one. Claiming also retires the old
  # mtime-second dedup, which silently swallowed a second copy written in
  # the same wall-clock second. The claim lives OUTSIDE the .clipboard.*
  # namespace on purpose: every session's exit sweeps .clipboard.* (the
  # shim's temp files) unconditionally, and a sibling exiting mid-delivery
  # must never delete this watcher's in-flight claim. Our own exit removes
  # .claim.$$.* and the startup sweep above catches claims stranded by a
  # crash.
  _do_copy() {
    kill -0 "$_cw_parent" 2>/dev/null || exit 0
    local claim="$claim_dir/.claim.$$.${RANDOM}"
    # Rename FIRST, into a directory the box cannot reach. `mv` moves a symlink
    # without following it, so a planted link arrives here intact rather than
    # being resolved, and once it is out of the shared dir the box can no longer
    # swap it for one.
    mv "$clip_dir/clipboard" "$claim" 2>/dev/null || return 0
    # Now test what we actually got. The redirect below FOLLOWS a symlink, and
    # it runs on the host: a link naming any file the host user can read would
    # have this watcher pipe that file into the host clipboard. The shim never
    # produces a link, so this is only ever hostile. Drop it unread.
    if [ -L "$claim" ]; then
      rm -f "$claim" 2>/dev/null || true
      return 0
    fi
    # Anything else that is not a regular file is hostile too: a directory
    # makes the `wc` below fail, and a failed command substitution under the
    # binary's set -e killed this watcher outright, while a FIFO blocks it.
    # The claim sits outside the mount and the arm above already unlinked a
    # symlink, so rm -rf here can only ever remove the box's own junk.
    if [ ! -f "$claim" ]; then
      rm -rf "$claim" 2>/dev/null || true
      return 0
    fi
    # Cap IN PLACE, then hand the eval the same file redirect it always had.
    # Piping into the eval instead would move it into a pipeline subshell,
    # where errexit is no longer suppressed by the `|| true` below, and a
    # compound clip command whose first element fails (a user `ls ... ; cat`)
    # would abort before delivering. The claim already sits outside the mount,
    # so the temp beside it is not box-reachable.
    local _sz
    _sz="$(wc -c < "$claim" 2>/dev/null | tr -d '[:space:]')"
    case "$_sz" in ''|*[!0-9]*) _sz=0 ;; esac
    if [ "$_sz" -gt "$_CLIP_MAX_PAYLOAD" ]; then
      if head -c "$_CLIP_MAX_PAYLOAD" < "$claim" > "$claim.capped" 2>/dev/null; then
        mv -f "$claim.capped" "$claim" 2>/dev/null || rm -f "$claim.capped" 2>/dev/null || true
      else
        rm -f "$claim.capped" 2>/dev/null || true
      fi
    fi
    eval "$clip_cmd" < "$claim" 2>/dev/null || true
    rm -f "$claim" 2>/dev/null || true
  }

  if command -v inotifywait &>/dev/null; then
    while inotifywait -qq -e moved_to "$clip_dir" 2>/dev/null; do
      _do_copy
    done
    return
  fi

  if command -v fswatch &>/dev/null; then
    fswatch --event Updated --event Created -0 "$clip_dir" 2>/dev/null \
      | while IFS= read -r -d '' path; do
          case "$(basename "$path")" in clipboard) _do_copy ;; esac
        done
    return
  fi

  # Polling fallback. No mtime tracking: the payload only exists while a
  # copy is undelivered (the claim renames it away), so presence IS the
  # signal, and a pre-existing file can never masquerade as a fresh copy.
  while true; do
    kill -0 "$_cw_parent" 2>/dev/null || exit 0
    # -L as well as -e: a DANGLING symlink fails -e, so without this a planted
    # link naming a nonexistent path would sit here untouched. -e rather than -f
    # because a planted DIRECTORY (or FIFO) fails -f, and skipping it here left
    # it wedged in the shared dir forever: the next `mv payload clipboard` moves
    # the payload INSIDE it, so every later copy is silently swallowed. The
    # inotify and fswatch branches never had this hole because they fire on the
    # event, not on the shape. _do_copy claims it and drops whatever is not a
    # regular file.
    if [ -L "$clip_dir/clipboard" ] || [ -e "$clip_dir/clipboard" ]; then
      _do_copy
    fi
    sleep 1
  done
}

# ── Browser bridge ────────────────────────────────────────────────────────
# Watches for URLs written by the container's open-bridge shim and opens them
# on the host. Reuses the clipboard bridge dir ($CLEAT_RUN_DIR/<cname>/clip).

_host_open_cmd() {
  if command -v open &>/dev/null; then echo "open"
  elif command -v xdg-open &>/dev/null; then echo "xdg-open"
  else echo ""
  fi
}

# ── The browser destination gate ────────────────────────────────────────────
#
# The box writes a URL and the HOST opens it, in the host's own browser, with
# the host's cookies. Until this gate the destination was whatever the box
# chose, which is the one command in the default configuration that refuted the
# published claim. A URL is auto-opened only when its origin is an exact member
# of a host-side list.
#
# The list SHIPS. The default is not read from a config file, and that is a
# decision rather than an omission: a user blocked in the middle of a login who
# has to find a file, guess a section name and guess a key will reach for
# CLEAT_BROWSER_BRIDGE=always, which turns the gate off entirely. Trading a dozen
# narrow identity hosts for one user disabling the feature is a bad trade. Two
# things append to it and nothing subtracts from it: CLEAT_BROWSER_ORIGINS for
# one shell, and the `origin =` lines `cleat browser allow` writes into a
# [browser] section of the GLOBAL config. A [browser] section in a project
# .cleat is ignored with a warning.
#
# Every entry is a login page a tool actually opens, read from the vendor's own
# documentation or from the CLI's own source. `api.anthropic.com` is NOT here:
# it is an API host and never a browser destination, and including it would be
# the API-versus-browser confusion that produces a list which both fails to work
# and widens the surface.
#
# The list can never be complete and the docs must not claim it is. An
# Atlassian site is the user's own site, a self-hosted GitLab is their own
# hostname, and an MCP server names its own authorization host, one per server.
# That is arithmetic, not policy, and it is why CLEAT_BROWSER_ORIGINS exists.
#
# AWS is NOT in that category, and an earlier draft said it was. Since AWS CLI
# 2.22 `aws sso login` defaults to PKCE and opens
# https://oidc.<region>.amazonaws.com/authorize (dual-stack: oidc.<region>.api.aws),
# a fixed host per region, and only then redirects to the tenant's portal. So it
# could ship. It does not, by the maintainer's decision on 2026-09-13: one host
# per region is a long list for one tool, and `cleat browser allow` for the
# region you use is a single line.
#
# Claude Code's own hosts are measured in its bundle, not copied from a fixture.
# 2.1.270 opens claude.com/cai/oauth/authorize for a claude.ai login and
# platform.claude.com/oauth/authorize for a Console login, and its code-paste
# redirect_uri is platform.claude.com/oauth/code/callback. Leaving those two out
# refused the hands-free login in every mode. claude.ai stays: 2.1.270 still
# links there (claude.ai/code, the usage page), and older releases opened their
# login on it. console.anthropic.com is in no 2.1.270 string and stays anyway.
# It is the code-paste host older releases used (concept/33, from 2.1.202), and
# Cleat bakes Claude's version into the image with the self-updater off, so a
# box built from an older image still runs one of those releases.
_BROWSER_ORIGINS="claude.ai claude.com platform.claude.com console.anthropic.com
github.com www.npmjs.com login.docker.com accounts.google.com
login.microsoftonline.com microsoft.com dash.cloudflare.com auth.openai.com
cli-auth.heroku.com app.netlify.com app.pulumi.com app.planetscale.com
app.terraform.io sentry.io gitlab.com"

# Echoes the lowercased HOST of an http(s) URL, or fails. Never a substring.
#
# Seven properties copied from _extract_callback_port, which is the precedent in
# this file (concept/41 rule 3: a value from the box is parsed, not searched):
# the length bound comes first, `case` globs do the matching rather than [[ =~ ]]
# or grep, only #/##/%/%% cut the string, `tr` folds case because bash 3.2 has
# no ${var,,}, the match is exact alternation rather than a wildcard, and the
# default is a hard `return 1`.
_bridge_url_host() {
  local url="$1" rest authority host
  [ "${#url}" -le 2048 ] || return 1
  # The scheme is case-insensitive (RFC 3986) and a tool really does emit
  # HTTPS://. Fold only the scheme: the caller opens the ORIGINAL bytes, and the
  # path and query are case-SENSITIVE.
  local scheme="${url%%://*}"
  [ "$scheme" != "$url" ] || return 1
  scheme="$(printf '%s' "$scheme" | tr 'A-Z' 'a-z')"
  case "$scheme" in http|https) ;; *) return 1 ;; esac
  rest="${url#*://}"
  authority="${rest%%[/?#]*}"
  [ -n "$authority" ] || return 1
  # Userinfo: REJECT, never strip. https://claude.ai@evil.example/ has the
  # attacker's host to the RIGHT of the @, so ${authority%%@*} hands back the
  # name they chose. Taking ${authority##*@} is correct; rejecting is stronger.
  case "$authority" in *@*) return 1 ;; esac
  # Every byte of the authority, before the port is cut. One rule kills a
  # percent-encoded authority, a backslash, an underscore, a space, every
  # punycode confusable that is not already ASCII, and an IPv6 literal, whose
  # brackets are outside the set. That last one matters for the contract: a
  # success from here always means "this is a hostname", so a later caller that
  # treats it that way inherits no latent bug. A separate bracket arm was
  # written first and removed: a guard that another guard already covers cannot
  # be mutation-tested, so it is indistinguishable from a guard that does nothing.
  case "$authority" in *[!A-Za-z0-9.:-]*) return 1 ;; esac
  case "$authority" in *:*) host="${authority%:*}" ;; *) host="$authority" ;; esac
  case "$host" in *:*) return 1 ;; esac
  [ -n "$host" ] || return 1
  # A trailing dot, a leading dot, an empty label or a leading dash all resolve
  # to a real name while being a different string from the list entry.
  case "$host" in .*|*.|*..*|-*|*-) return 1 ;; esac
  printf '%s' "$host" | tr 'A-Z' 'a-z'
}

# The host of one user-supplied origin entry, or fails. A bare host and a full
# origin are both accepted: the blocked line prints the bare host, and someone
# reading the docs may paste a whole URL. Anything carrying `://` is a URL and
# goes to _bridge_url_host untouched, which folds the scheme's case and refuses
# every scheme but http(s). Matching only a lower-case `http://` here made
# HTTPS://auth.example.com a bare host whose host is `https`, and ftp://x one
# whose host is `ftp`. One helper for the env var, the config and the allow verb.
_bridge_entry_host() {
  case "$1" in
    *://*) _bridge_url_host "$1" ;;
    *)     _bridge_url_host "https://$1" ;;
  esac
}

# Split CLEAT_BROWSER_ORIGINS and put every entry through the SAME parser the
# shipped list is matched with, so a hostile value in the user's own profile
# cannot widen matching in a way a built-in could not. A malformed entry is
# dropped, never treated as a wildcard. $1 = "ok" for the accepted hosts,
# "bad" for the rejected entries, so one parse serves the gate and the warning.
_bridge_origins_from_env() {
  local want="${1:-ok}" raw="${CLEAT_BROWSER_ORIGINS:-}" e h
  [ -n "$raw" ] || return 0
  # Bound it before any string work. Host-side, but it is walked per claim.
  [ "${#raw}" -le 4096 ] || return 0
  raw="$(printf '%s' "$raw" | tr ',;' '  ')"
  # Split on whitespace with globbing OFF. Unquoted, `*.example.com` expanded
  # against the working directory, and the watcher runs in the project folder,
  # which the box writes: a file named `evil.tld#.example.com` became an entry
  # whose authority is evil.tld. Restored after, unless the caller had it off.
  local _glob_off=0
  case $- in *f*) _glob_off=1 ;; esac
  set -f
  for e in $raw; do
    [ -n "$e" ] || continue
    h="$(_bridge_entry_host "$e" 2>/dev/null)" || h=""
    # A loopback or private host parses, and the gate still never opens it, so
    # listing it as accepted reads as "allowed and still does not work".
    [ -n "$h" ] && _bridge_host_is_local "$h" && h=""
    if [ -n "$h" ]; then
      [ "$want" = "ok" ] && printf '%s\n' "$h"
    else
      [ "$want" = "bad" ] && printf '%s\n' "$(_sanitize_repo_str "$e")"
    fi
  done
  [ "$_glob_off" = 1 ] || set +f
  return 0
}

# Origins the user added with `cleat browser allow`. GLOBAL config only, never
# the project .cleat.
#
# That is a correctness rule, not a preference: /workspace/.cleat is a file the
# caged agent edits as ordinary work, and this repo already treats it that way
# (_maybe_run_setup re-hashes its payload at exec time for exactly this reason).
# An allowlist whose escape hatch the attacker writes is not an allowlist. The
# trust prompt would not save it either: the prompt's subject line names
# CAPABILITIES, so an added origin is not what the user is reading, and under
# CLEAT_TRUST_PROJECT=1 it is approved with no prompt at all.
#
# Every entry goes through the same parser as the shipped list, so a hand-edited
# config cannot widen matching in a way a built-in could not.
_bridge_origins_from_config() {
  local want="${1:-ok}" e h
  [[ -r "$CLEAT_GLOBAL_CONFIG" ]] || return 0
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    h="$(_bridge_entry_host "$e" 2>/dev/null)" || h=""
    # Same rule as the env var: a local host is never opened, so it is bad.
    [ -n "$h" ] && _bridge_host_is_local "$h" && h=""
    if [ -n "$h" ]; then
      [ "$want" = "ok" ] && printf '%s\n' "$h"
    else
      [ "$want" = "bad" ] && printf '%s\n' "$(_sanitize_repo_str "$e")"
    fi
  done < <(_read_section_all_from_file "$CLEAT_GLOBAL_CONFIG" browser origin)
  return 0
}

# Append one origin to [browser] in the global config, preserving every other
# section byte for byte. Same preserve-and-rewrite shape as _write_caps_to_file,
# including its trailing-newline guard: a config whose last section is
# hand-written and ends without one must not lose its final line.
_bridge_origin_write() {
  local host="$1" file="$CLEAT_GLOBAL_CONFIG" preserved="" line _h in_sec=false
  local existing="" others="" _k _v
  [ -n "$host" ] || return 1
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  if [[ -f "$file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      _h="${line%$'\r'}"
      _h="${_h#$'\xef\xbb\xbf'}"
      _h="${_h#"${_h%%[![:space:]]*}"}"
      _h="${_h%"${_h##*[![:space:]]}"}"
      if [[ "$_h" == "[browser]" ]]; then in_sec=true; continue; fi
      if $in_sec; then
        if [[ "$_h" == "["*"]" ]]; then in_sec=false; preserved+="$line"$'\n'; continue; fi
        # An origin is split by VALUE, exactly the way _read_section_all_from_file
        # reads it back: the key is what precedes the first `=`, trimmed, and the
        # value is what follows it, trimmed. Keeping "everything after the word
        # origin" kept ` = host`, and the rewrite below prefixed another
        # `origin = `, so each allow broke every origin written before it.
        case "$_h" in
          *=*)
            _k="${_h%%=*}"
            _k="${_k%"${_k##*[![:space:]]}"}"
            if [ "$_k" = "origin" ]; then
              _v="${_h#*=}"
              _v="${_v#"${_v%%[![:space:]]*}"}"
              existing+="$_v"$'\n'
              continue
            fi ;;
        esac
        # A comment or any other key stays exactly as written. It is never an
        # origin, so it is never written back behind `origin = `.
        [ -n "$_h" ] && others+="$line"$'\n'
        continue
      fi
      preserved+="$line"$'\n'
    done < "$file"
  fi
  {
    [ -n "$preserved" ] && printf '%s' "$preserved"
    echo "[browser]"
    [ -n "$others" ] && printf '%s' "$others"
    local ex
    while IFS= read -r ex; do
      [ -n "$ex" ] || continue
      [ "$ex" = "$host" ] && continue
      echo "origin = $ex"
    done <<EOF
$existing
EOF
    echo "origin = $host"
  } > "$file.cleat-tmp.$$" && mv -f "$file.cleat-tmp.$$" "$file" || {
    rm -f "$file.cleat-tmp.$$" 2>/dev/null || true
    error "Could not write ${file/#${HOME}/~}"
    return 1
  }
  chmod 0600 "$file" 2>/dev/null || true
  return 0
}

# The effective list: the shipped defaults FIRST, then the env var. It appends
# and never replaces. A user who sets the variable to add one origin must not
# silently lose claude.ai and break their own login, which is the single
# property this variable stands or falls on.
_bridge_origins_effective() {
  local o
  for o in $_BROWSER_ORIGINS; do
    [ -n "$o" ] && printf '%s\n' "$o"
  done
  _bridge_origins_from_config ok
  _bridge_origins_from_env ok
  return 0
}

# Exact host membership. Not a suffix test: a `*claude.ai` pattern also matches
# `evilclaude.ai`, and a suffix rule is how an origin allowlist usually fails.
_bridge_origin_allowed() {
  local host="$1" entry
  [ -n "$host" ] || return 1
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    [ "$host" = "$entry" ] && return 0
  done <<EOF
$(_bridge_origins_effective)
EOF
  return 1
}

# Exact host membership in the PERSISTENT list: the shipped defaults and the
# global config, never the env var. `cleat browser allow` asks this and not
# _bridge_origin_allowed, because a host that is only in CLEAT_BROWSER_ORIGINS
# for this shell read as "already allowed" and nothing was written, so the
# allow was gone the moment the variable was.
_bridge_origin_persisted() {
  local host="$1" entry
  [ -n "$host" ] || return 1
  for entry in $_BROWSER_ORIGINS; do
    [ "$host" = "$entry" ] && return 0
  done
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    [ "$host" = "$entry" ] && return 0
  done <<EOF
$(_bridge_origins_from_config ok)
EOF
  return 1
}

# True when a host is an IPv4 address in a form the loopback ranges cannot judge.
# Those ranges are dotted text, and a browser is not. WHATWG URL parsing treats a
# host whose LAST label is a number (all digits, or 0x and hex digits) as an IPv4
# address, and reads 2130706433, 0x7f000001, 0177.0.0.1 and 127.1 all as
# 127.0.0.1 and 0 as 0.0.0.0. So a host that ends in a number is refused outright
# unless it is the one form the ranges can judge: four decimal labels, each
# 0-255 with no leading zero. 8.8.8.8 still falls through to the ranges.
_bridge_ipv4_noncanonical() {
  local last="${1##*.}" rest="$1" label n=0
  case "$last" in
    '') return 1 ;;
    *[!0-9]*)
      case "$last" in
        0[xX]*) case "${last#0[xX]}" in *[!0-9a-fA-F]*) return 1 ;; esac ;;
        *) return 1 ;;
      esac ;;
  esac
  while :; do
    n=$((n + 1))
    [ "$n" -le 4 ] || return 0
    label="${rest%%.*}"
    case "$label" in
      [0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) ;;
      *) return 0 ;;
    esac
    case "$rest" in *.*) rest="${rest#*.}" ;; *) break ;; esac
  done
  [ "$n" -eq 4 ] && return 1
  return 0
}

# Loopback, link-local and private space, tested on the authority of the URL
# that is actually opened. Deliberately NOT on redirect_uri: that is a different
# field with a different job, _extract_callback_port reads it, and denying it
# would kill the hands-free login this bridge exists to complete.
#
# What this removes is a cookie-bearing authenticated navigation into a host
# service. It does NOT make host loopback unreachable from the box: every box
# gets host.docker.internal, and on Docker Desktop that gateway is expected to
# proxy to the host's own loopback (not yet measured, concept/41 "Not
# verified"). The smaller claim is the honest one.
#
# A host ending in a number that is not a plain dotted quad is refused first,
# because the text ranges below cannot judge it. See _bridge_ipv4_noncanonical.
_bridge_host_is_local() {
  _bridge_ipv4_noncanonical "$1" && return 0
  case "$1" in
    localhost|*.localhost) return 0 ;;
    127.*|0.0.0.0|::1) return 0 ;;
    169.254.*) return 0 ;;
    10.*|192.168.*) return 0 ;;
    172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
    *.local) return 0 ;;
  esac
  return 1
}

# The whole destination decision for one URL: 0 = the host may open this, 1 = it
# may not. Pure, so it is exhaustively unit-tested the way _browser_should_open
# already is.
_bridge_dest_allowed() {
  local host
  host="$(_bridge_url_host "$1" 2>/dev/null)" || return 1
  [ -n "$host" ] || return 1
  _bridge_host_is_local "$host" && return 1
  _bridge_origin_allowed "$host"
}

# True when a URL is an OAuth authorization request at an allowlisted origin
# (the three requirements are listed below). Claude Code logs in through two
# flows: the loopback flow (redirect_uri=http://localhost:PORT/callback, which
# the callback proxy completes hands-free) and the manual code-paste flow
# (redirect_uri https://platform.claude.com/oauth/code/callback in 2.1.270, on
# console.anthropic.com in older releases; the user pastes a code back into the
# terminal). BOTH must count as auth for _browser_should_open: an OAuth URL emitted
# programmatically through the container's open shim is never a terminal
# click, so deferring it like a plain link strands the login. Claude 2.1.x
# happens to hand its opener only the loopback URL today; this guards
# gh-auth-style flows and any future claude change that opens a non-loopback
# authorize URL. Only the loopback flow additionally earns a callback proxy;
# that stays keyed on _extract_callback_port below.
# The old test was "the string contains redirect_uri=" anywhere, which made
# https://evil.example/pwn?redirect_uri=x an AUTH url. The auto branch returns
# on is_auth BEFORE it consults the terminal, so that one substring opened any
# destination the box named even with a terminal attached. Three things are
# required now:
#
#   1. The origin is on the allowlist. This is the load-bearing one.
#   2. redirect_uri arrives as a QUERY parameter. In the fragment it is never
#      sent to the server, so it is not part of an OAuth request. The old glob
#      matched it there, and _extract_callback_port reads the whole string, so
#      a fragment-borne value made the host bind a port too.
#   3. Its value decodes to an absolute http(s) URL whose authority parses.
#
# Deliberately NOT "a loopback authority with a canonical port", which is what
# the brief for this work asked for. That would drop the code-paste login flow,
# whose redirect_uri points at platform.claude.com (console.anthropic.com before
# it) and which regressions.bats pins as auth. Login is the worst regression area in this repo's history, and
# with requirement 1 in place the remaining surface is a tab to an allowlisted
# origin. The loopback shape is still required separately by
# _extract_callback_port, which is what gates the callback proxy.
#
# Requirements 2 and 3 live in _is_auth_url_shape so the watcher can ask the
# question the refusal notice needs answered: would this URL have opened had
# its origin been listed? Only then is `cleat browser allow` a fix.
_is_auth_url() {
  local url="$1"
  _bridge_dest_allowed "$url" || return 1
  _is_auth_url_shape "$url"
}

# The OAuth half of _is_auth_url, with no opinion on the origin: redirect_uri
# arrives as a query parameter and decodes to an absolute http(s) URL whose
# authority parses. 0 = shaped like an authorize request.
_is_auth_url_shape() {
  local url="$1" enc dec
  # Query only. Cut the fragment off FIRST, then look for the parameter.
  local q="${url%%#*}"
  case "$q" in
    *\?redirect_uri=*|*\&redirect_uri=*) ;;
    *) return 1 ;;
  esac
  enc="${q#*redirect_uri=}"
  enc="${enc%%&*}"
  [ -n "$enc" ] || return 1
  [ "${#enc}" -le 2048 ] || return 1
  dec="$(printf '%b' "${enc//%/\\x}" 2>/dev/null)" || return 1
  # An absolute http(s) callback whose authority parses. _bridge_url_host
  # rejects an IPv6 literal and userinfo, so a redirect_uri of
  # https://claude.ai@evil.example/ does not make the outer URL auth either.
  case "$dec" in
    http://*|https://*) ;;
    *) return 1 ;;
  esac
  _bridge_url_host "$dec" >/dev/null 2>&1 || return 1
  return 0
}

# Extracts the localhost port from a redirect_uri in an OAuth URL.
# Returns 0 and prints the port if found, returns 1 otherwise.
_extract_callback_port() {
  local url="$1"

  # Bound the input before any string work. It is written by the caged side.
  [ "${#url}" -le 4096 ] || return 1

  case "$url" in
    *redirect_uri=*) ;;
    *) return 1 ;;
  esac

  # Isolate the redirect_uri value
  local encoded="${url#*redirect_uri=}"
  encoded="${encoded%%&*}"
  encoded="${encoded%%#*}"

  # URL-decode (%XX → bytes)
  local decoded
  decoded=$(printf '%b' "${encoded//%/\\x}" 2>/dev/null) || return 1

  # Parse the AUTHORITY, never a substring. `*localhost:*` matched anywhere in
  # the value, so a redirect_uri of http://evil.example/?next=localhost:9999
  # made the HOST bind port 9999 for a destination the box chose. Take what
  # sits between the scheme and the first '/'.
  #
  # Userinfo needs no arm of its own: in http://localhost:9999@evil.example/
  # the @ lands right of the final colon, so the port check below rejects it,
  # and in http://user@localhost:9999/ it lands left of it, so the host check
  # does. Both forms have a test.
  local authority="${decoded#*://}"
  authority="${authority%%[/?#]*}"
  case "$authority" in
    *:*) ;;
    *) return 1 ;;
  esac

  local host="${authority%:*}" port="${authority##*:}"
  # DNS names are case-insensitive. bash 3.2 has no ${var,,}.
  host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
  case "$host" in
    localhost|127.0.0.1) ;;
    *) return 1 ;;
  esac

  # Digits only, in a range BOTH backends agree on. socat truncates a port
  # modulo 65536 and python3 raises OverflowError, so an out-of-range value
  # binds the wrong port or none at all. A leading zero means two different
  # ports to the two backends. Below 1024 is privileged: claude never asks for
  # one, and binding it would fail on the host anyway.
  case "$port" in
    ''|*[!0-9]*) return 1 ;;
    0*) return 1 ;;
  esac
  [ "${#port}" -le 5 ] || return 1
  [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || return 1

  echo "$port"
  return 0
}

# TCP proxy: forwards one connection from host:PORT to container:PORT.
# Enables OAuth callbacks to reach Claude Code's HTTP server inside Docker.
# Uses socat on host if available, falls back to python3.
# The exact token a refusal line carries. The foreground reads it back out of
# the proxy log after the session, so it is a constant rather than prose: the
# writer and the reader must never drift, and neither may a translation of the
# surrounding sentence.
_BROWSER_BLOCKED_MARK="BLOCKED-ORIGIN"

# How long a callback proxy holds the port the box named while no connection
# arrives, in seconds. Both backends read this one value, so they cannot
# disagree about it.
_ACP_WAIT_SECS=300

# The argv prefix that bounds a command to $1 seconds of wall clock, left in
# _BOUNDED_ARGV. timeout(1) where it exists, then Homebrew coreutils' gtimeout,
# then perl's alarm. A stock macOS has no timeout(1), and every bound written as
# `command -v timeout && ...` silently disappeared there. perl ships with macOS.
# It sets the alarm and EXECS the command, so the pid a caller holds is the
# command's own pid and a TERM sent to it lands on the command. The alarm
# survives exec, and SIGALRM's default action ends the process. With none of
# the three the prefix is empty and the command runs unbounded.
#
# A prefix and not only a wrapper, because a backgrounded shell FUNCTION is a
# subshell of its own: `_run_bounded 300 socat ... &` hands $! the subshell,
# and a TERM to it orphans socat with the port still bound. The callback proxy
# puts the prefix straight in front of its backgrounded command instead.
_bounded_argv() {
  _BOUNDED_ARGV=()
  if command -v timeout >/dev/null 2>&1; then
    _BOUNDED_ARGV=(timeout "$1")
  elif command -v gtimeout >/dev/null 2>&1; then
    _BOUNDED_ARGV=(gtimeout "$1")
  elif command -v perl >/dev/null 2>&1; then
    _BOUNDED_ARGV=(perl -e 'alarm shift @ARGV; exec { $ARGV[0] } @ARGV or exit 127' "$1")
  fi
}

# Run a command in the foreground under _bounded_argv's bound. Exit status is
# the command's own, or 124 (timeout, gtimeout) or 142 (perl, SIGALRM) when the
# bound fires.
_run_bounded() {
  _bounded_argv "$1"
  shift
  ${_BOUNDED_ARGV[@]+"${_BOUNDED_ARGV[@]}"} "$@"
}

# Is something already listening on this host loopback port? A bounded connect,
# because the point is to decide in the foreground of the watcher loop and a
# hang there is invisible (the watcher's fds go to a log). Returns 0 when the
# port ANSWERS, which means a host service holds it.
#
# This is the half of "bind before opening" that carries the security property:
# without it the box names a port an unrelated host service is on, the proxy
# fails to bind, and the browser opens anyway, pointed at that service with the
# host's cookies. bash's /dev/tcp is a builtin and present on bash 3.2.
#
# Both loopbacks. The proxy binds 127.0.0.1, so a host service listening on
# [::1] alone does not stop the bind, and a browser resolving `localhost` to
# ::1 first then reaches THAT service. Either address answering means taken.
_port_in_use() {
  local port="$1" _lo
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  for _lo in 127.0.0.1 ::1; do
    _run_bounded 2 bash -c "exec 9<>/dev/tcp/${_lo}/${port}" 2>/dev/null && return 0
  done
  return 1
}

_auth_callback_proxy() {
  local port="$1"
  local cname="$2"
  local log_file="${3:-}"
  # Touched once the listener is actually up. The watcher waits for it rather
  # than sleeping a fixed 0.5s and hoping, and opens NOTHING if it never
  # appears. A backgrounded socat's bind success is not observable by the
  # parent shell, so this file is the readiness channel.
  local ready_file="${4:-}"

  _proxy_log() { [ -n "$log_file" ] && echo "[proxy $(date +%H:%M:%S)] $*" >> "$log_file"; }

  # The backend below runs as a BACKGROUND child with an explicit wait, never
  # in the foreground. bash defers a trap until a foreground child exits, so a
  # foreground backend made this subshell swallow the TERM that _bw_cleanup
  # sends: the listener kept the loopback port bound past session end, and the
  # watcher's own `wait` on this pid never returned, wedging session teardown.
  # Backgrounding lets the trap run at once and take the backend down with it.
  local _acp_child=""
  trap '[ -n "$_acp_child" ] && kill "$_acp_child" 2>/dev/null; exit 0' TERM INT HUP

  _proxy_log "starting: port=$port container=$cname"

  # Prefer socat on host → docker exec socat in container
  # Try IPv6 first (Node.js binds to ::1 when given "localhost"), fall back to IPv4
  # Use ignoreeof on the container side so stdin EOF doesn't kill the TCP read
  # Retry bind up to 30s if the port is temporarily busy
  if command -v socat &>/dev/null; then
    _proxy_log "using socat on host"
    local socat_rc=0 _attempt
    for _attempt in $(seq 1 30); do
      # SYSTEM:, not EXEC:. socat's EXEC address strips the quotes and splits
      # the rest on whitespace without ever invoking a shell, so `sh -c
      # 'docker exec ...'` ran `docker` with NO arguments (the rest became sh's
      # positional parameters) and the forward returned an EMPTY reply on
      # every host that has socat. The bug hid because a host without socat
      # takes the python3 branch below, which works. SYSTEM: hands the whole
      # string to a shell, which is what the `||` fallback needs.
      #
      # Inside a SYSTEM: parameter BOTH ',' and ':' are socat's own
      # separators: an unescaped comma starts the option list and an unescaped
      # colon ends the parameter, which silently truncated the command at
      # `TCP6` and dropped the whole IPv4 fallback. Every one of them is
      # escaped. Both interpolations are safe: the port is digits only
      # (_extract_callback_port) and the container name is cleat-generated.
      # Bounded by _ACP_WAIT_SECS, the value the python backend's
      # srv.settimeout reads. socat has no timeout of its own, so without this
      # the port the BOX named stays bound until a connection arrives or
      # teardown runs, and the two backends disagree about how long that is.
      # The prefix comes from _bounded_argv, which also bounds a stock macOS
      # with no timeout(1), and it execs, so $! below is still the process the
      # TERM trap has to reach.
      _bounded_argv "$_ACP_WAIT_SECS"
      ${_BOUNDED_ARGV[@]+"${_BOUNDED_ARGV[@]}"} socat "TCP-LISTEN:${port},bind=127.0.0.1,reuseaddr" \
        "SYSTEM:docker exec -i ${cname} socat -\\,ignoreeof TCP6\\:localhost\\:${port} 2>/dev/null || docker exec -i ${cname} socat -\\,ignoreeof TCP\\:localhost\\:${port}" \
        2>>"${log_file:-/dev/null}" &
      _acp_child=$!
      # socat exits within milliseconds on EADDRINUSE, so a child still alive
      # after a short settle has bound. Not a probe: a connect would CONSUME the
      # single connection TCP-LISTEN accepts without `fork`, which is the one
      # connection the login needs.
      if [ -n "$ready_file" ]; then
        sleep 0.3
        kill -0 "$_acp_child" 2>/dev/null && : > "$ready_file" 2>/dev/null || true
      fi
      # Quiet: a socat ended by the perl alarm makes `wait` print bash's
      # "Alarm clock" job line, which would land in the watcher log as noise.
      wait "$_acp_child" 2>/dev/null && socat_rc=0 || socat_rc=$?
      _acp_child=""
      [[ $socat_rc -eq 1 ]] || break
      [[ $_attempt -eq 1 ]] && _proxy_log "socat bind failed, retrying..."
      sleep 1
    done
    _proxy_log "socat exited with status $socat_rc"
    return
  fi

  # Fallback: python3 HTTP-aware proxy with retry
  if command -v python3 &>/dev/null; then
    _proxy_log "using python3 fallback"
    local py_rc=0
    python3 - "$port" "$cname" "$log_file" "$ready_file" "$_ACP_WAIT_SECS" <<'PYEOF' &
import socket, subprocess, sys, signal, os, time
log_file = sys.argv[3] if len(sys.argv) > 3 else None
ready_file = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] else None
# _ACP_WAIT_SECS, the bound the socat backend reads too.
wait_secs = int(sys.argv[5])
def _log(msg):
    if log_file:
        try:
            with open(log_file, 'a') as f: f.write(f"[proxy-py {msg}]\n")
        except: pass
def _term(*_): os._exit(0)
signal.signal(signal.SIGTERM, _term)
signal.signal(signal.SIGINT, _term)
def _send_generic_success(conn):
    body = (b"<!doctype html><html><head><title>Authentication Successful</title>"
            b"<style>body{font-family:system-ui,-apple-system,sans-serif;max-width:32em;"
            b"margin:4em auto;padding:2em;text-align:center;color:#222}"
            b"h1{color:#22863a}</style></head><body>"
            b"<h1>Authentication Successful</h1>"
            b"<p>You can close this window and return to Claude Code.</p>"
            b"</body></html>")
    resp = (b"HTTP/1.1 200 OK\r\n"
            b"Content-Type: text/html; charset=utf-8\r\n"
            b"Content-Length: " + str(len(body)).encode() + b"\r\n"
            b"Connection: close\r\n\r\n" + body)
    try: conn.sendall(resp)
    except Exception: pass
port, cname = int(sys.argv[1]), sys.argv[2]
srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
# No SO_REUSEPORT. The port is named by the CAGED side, and with REUSEPORT a
# box could co-bind a live host loopback service that also set it, taking a
# share of that service's connections. REUSEADDR plus the retry loop below
# already cover every legitimate case (a TIME_WAIT socket from a prior login).
# Retry bind: the port may be briefly held by another process
bound = False
for bind_attempt in range(30):
    try:
        srv.bind(('127.0.0.1', port))
        bound = True
        break
    except OSError as e:
        if bind_attempt == 0:
            _log(f"bind attempt 1 failed: {e}, retrying...")
        time.sleep(1)
if not bound:
    _log(f"bind failed after 30 attempts, giving up")
    sys.exit(0)
# Readiness, on a real bind and nowhere else. The watcher opens no browser
# until this exists, so a failed bind can never fall through to an open.
if ready_file:
    try:
        with open(ready_file, 'w') as f: f.write('1')
    except Exception: pass
_log(f"listening on 127.0.0.1:{port}")
srv.listen(1)
srv.settimeout(wait_secs)
try:
    cli, addr = srv.accept()
    _log(f"accepted connection from {addr}")
    # Read the full HTTP request from the browser
    cli.settimeout(5)
    req_data = b""
    while True:
        try:
            chunk = cli.recv(4096)
            if not chunk: break
            req_data += chunk
            # HTTP request ends with \r\n\r\n (GET has no body)
            if b"\r\n\r\n" in req_data: break
        except socket.timeout: break
    _log(f"got {len(req_data)} bytes from browser")
    # Rewrite Connection: keep-alive → close so the container's server will
    # close the TCP connection after its response.
    req_data = req_data.replace(b"Connection: keep-alive", b"Connection: close      ")
    req_data = req_data.replace(b"connection: keep-alive", b"connection: close      ")
    # Forward to the container: try IPv6 first (Node.js binds to ::1), fall back to IPv4
    # Use `-,ignoreeof` so socat doesn't propagate stdin EOF to the TCP socket,
    # giving the container server time to write its response before closing.
    ok = False
    for proto in ['TCP6', 'TCP']:
        proc = subprocess.Popen(
            ['docker', 'exec', '-i', cname, 'socat', '-,ignoreeof', f'{proto}:localhost:{port}'],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            stdout, stderr = proc.communicate(input=req_data, timeout=30)
            errtxt = stderr.decode(errors='replace').strip() if stderr else ''
            if stdout:
                _log(f"forwarded OK via {proto}, got {len(stdout)} bytes back")
                cli.sendall(stdout)
                ok = True
                break
            if proc.returncode == 0:
                # Connection succeeded, request delivered, but no response bytes.
                _log(f"delivered via {proto} (empty response, assuming success)")
                _send_generic_success(cli)
                ok = True
                break
            if 'refused' in errtxt.lower():
                _log(f"{proto} connection refused, trying next")
                continue
            _log(f"{proto} failed rc={proc.returncode} stderr={errtxt}")
        except subprocess.TimeoutExpired:
            proc.kill()
            try: proc.wait(timeout=2)
            except subprocess.TimeoutExpired: pass
            _log(f"{proto} timed out, assuming code was delivered")
            _send_generic_success(cli)
            ok = True
            break
    if not ok:
        _log("forwarding failed on both IPv6 and IPv4")
        cli.sendall(b"HTTP/1.1 502 Bad Gateway\r\nContent-Type: text/html\r\n\r\n"
                    b"<h1>Cleat: callback forwarding failed</h1>"
                    b"<p>Could not reach Claude Code's auth server inside the container.</p>"
                    b"<p>Check <code>/tmp/cleat-clip/.proxy-log</code> for details.</p>")
    cli.close()
except socket.timeout:
    _log(f"timeout waiting for callback ({wait_secs}s)")
except Exception as e:
    _log(f"error: {e}")
finally: srv.close()
PYEOF
    _acp_child=$!
    wait "$_acp_child" && py_rc=0 || py_rc=$?
    _acp_child=""
    _proxy_log "python3 proxy exited with status $py_rc"
    return
  fi

  _proxy_log "FAILED: neither socat nor python3 available on host"
}

# Atomically claim the URL pending in the bridge file. Prints the URL and returns
# 0 if THIS caller won the claim; returns 1 if there was nothing to claim. The
# rename is atomic, so when several watchers race on the same bridge file (e.g.
# an orphan left by a crashed/SIGKILL'd session plus the current one) exactly
# ONE wins per written URL. That makes a single in-container `open` open exactly
# one host tab instead of one-per-watcher (the duplicate-tab bug). Consuming the
# file also retires the old mtime-second dedup, which silently dropped a second
# URL written in the same wall-clock second.
_browser_claim_url() {
  local bridge_file="$1"
  # Where the claim goes. The watcher passes a directory outside the box's bind
  # mount, which is what stops the box swapping the claim between the rename and
  # the read. Defaults beside the bridge file so direct callers are unchanged.
  local claim_dir="${2:-}"
  [ -n "$claim_dir" ] || claim_dir="$(dirname "$bridge_file")"
  # Same shape as the clipboard payload path, same fix. A symlink is never a
  # real claim: the box's open shim writes a regular file. `mv` moves the LINK
  # without following it and the `cat` below DOES follow it, so a planted link
  # would have the host read whatever file it names. Tested before [ -f ],
  # which dereferences and so passes a link to any readable file.
  if [ -L "$bridge_file" ]; then
    rm -f "$bridge_file" 2>/dev/null || true
    return 1
  fi
  [ -f "$bridge_file" ] || return 1
  local claim="$claim_dir/.browser-open.opening.$$.${RANDOM}"
  mv "$bridge_file" "$claim" 2>/dev/null || return 1
  if [ -L "$claim" ]; then
    rm -f "$claim" 2>/dev/null || true
    return 1
  fi
  # Bounded. The box picks the file's size, and an unbounded `cat` here put the
  # whole thing in a shell variable and then on an `echo` into the log. The cap
  # is well above the 2048 _bridge_url_host accepts, so nothing that could ever
  # be opened is cut.
  head -c 8192 "$claim" 2>/dev/null || true
  rm -f "$claim" 2>/dev/null || true
  return 0
}

# Epoch mtime of a path, or 0 when it can't be read. GNU stat (-c) first, then
# BSD/macOS (-f).
_path_mtime() {
  local m
  # Trailing `|| echo ""` guarantees a zero exit (and empty output) when both
  # stats fail, so the binary's `set -e` can't trip on this assignment if the
  # marker is removed between the glob and the stat.
  m="$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo "")"
  case "$m" in ''|*[!0-9]*) m=0 ;; esac
  printf '%s' "$m"
}

# Same-URL debounce, shared across watchers via per-URL marker dirs in the clip
# dir. The atomic claim above makes each WRITE open exactly once, but one user
# action can produce SEVERAL writes: a TUI link click fires the open shim on both
# press and release, and tools retry. With a single watcher the 0.5s poll
# collapses rapid rewrites (the second write lands before the first is claimed);
# with overlapping watchers (a login alongside a session, two shells on one box,
# or an orphan from a crashed session) each watcher claims one write, so two
# writes become two tabs unless the debounce is shared.
#
# The debounce MUST be atomic. The earlier design read a `.last-open` stamp,
# decided "not seen", then wrote it: two watchers could both read "not seen"
# before either wrote, and both opened (the one-click-two-tabs bug that the
# atomic claim alone did not fix, seen with concurrent sessions). Here the
# test-and-set is a single `mkdir`: it succeeds for exactly ONE racer and fails
# with EEXIST for the rest, so only the winner opens, no matter how many watchers
# are live. The marker's own mtime (set atomically by mkdir, so there is no
# create-then-stamp gap a concurrent sweep could misread) is the clock; markers
# older than the window are swept on each claim, so the same URL opens again
# later and stale markers can't accumulate. Different URLs hash to different
# markers and never dedupe.
_BROWSER_DEBOUNCE_SECS=2
# Remove debounce markers older than the window. Fresh markers are load-bearing
# (a concurrent watcher's debounce), so ONLY expired ones go. Called on each
# claim and once at watcher start: a box whose last session never claims again
# would otherwise keep its final markers forever.
_browser_sweep_stale_markers() {
  local clip_dir="$1" now d
  now="$(date +%s)"
  for d in "$clip_dir"/.open.*; do
    [ -d "$d" ] || continue
    if [ $(( now - $(_path_mtime "$d") )) -gt "$_BROWSER_DEBOUNCE_SECS" ]; then
      rm -rf "$d" 2>/dev/null || true
    fi
  done
  return 0
}
_browser_recently_opened() {
  local clip_dir="$1" url="$2"
  local now hash lock
  now="$(date +%s)"
  # Sweep markers past the window (runs only when a URL was actually claimed, over
  # a handful of recent markers, so the cost is negligible).
  _browser_sweep_stale_markers "$clip_dir"
  # Filesystem-safe per-URL key. cksum is POSIX (present on macOS and Linux); a
  # collision would only over-dedupe two URLs fired within the same 2s, which
  # never happens in practice.
  hash="$(printf '%s' "$url" | cksum 2>/dev/null)"; hash="${hash// /_}"
  lock="$clip_dir/.open.$hash"
  if mkdir "$lock" 2>/dev/null; then
    return 1   # we won the atomic claim → open it
  fi
  return 0     # a fresh marker exists → another watcher already opened this URL
}

# The rate cap on host opens (EGRESS-SPEC B6). The destination gate bounds WHERE
# the box can aim the host browser. This bounds HOW OFTEN: every open is a real
# request from the host, outside anything a future gateway sees, carrying up to
# 2048 box-chosen bytes (8192 under `always`, where the host parser that enforces
# 2048 is not consulted). No login opens more than a couple of tabs, so a cap
# far above that costs no real flow.
#
# Per minute is a ledger shared by every watcher on the box (a login alongside a
# session, a shell beside both), so starting another session does not buy the
# box another six. It lives in the claim dir, outside the bind mount, so the box
# can neither empty it nor fill it. Per session is this watcher's own counter.
# Past either cap the watcher refuses the open, logs one line naming the cap and
# keeps polling, so a login after the window still works.
_BROWSER_RATE_PER_MIN=6
_BROWSER_RATE_PER_SESSION=30
_BROWSER_RATE_WINDOW_SECS=60
# The token a capped open's log line carries, read back when the session ends
# by _maybe_report_capped_opens. A constant for the reason _BROWSER_BLOCKED_MARK
# is one. Without the report a capped login looked like a browser that never
# opened, because Claude Code hands a loopback authorize URL only to $BROWSER.
_BROWSER_CAPPED_MARK="RATE-CAPPED"
# Returns 0 and records the open when it fits under both caps, 1 when a cap is
# reached. $1 is the ledger path, empty when the claim dir could not be created
# outside the mount (then only the session cap applies, because a ledger the box
# can write is not a cap). $2 is how many opens this watcher has already made.
_browser_rate_take() {
  local ledger="${1:-}" made="${2:-0}" now line n=0 keep=""
  case "$made" in ''|*[!0-9]*) made=0 ;; esac
  [ "$made" -lt "$_BROWSER_RATE_PER_SESSION" ] || return 1
  [ -n "$ledger" ] || return 0
  now="$(date +%s)"
  _drop_unless_regular "$ledger"
  if [ -f "$ledger" ]; then
    # Bounded read, and only well-formed epochs count. A leading zero is refused
    # because bash arithmetic reads it as octal, and 08 is an error rather than
    # a number. An entry from the future (a clock stepped back) is dropped, or
    # it would hold the window shut for as long as the step.
    while IFS= read -r line; do
      case "$line" in ''|0*|*[!0-9]*) continue ;; esac
      [ "${#line}" -le 12 ] || continue
      [ "$line" -le "$now" ] || continue
      [ $(( now - line )) -lt "$_BROWSER_RATE_WINDOW_SECS" ] || continue
      n=$(( n + 1 ))
      keep="${keep}${line}
"
    done <<EOF
$(head -c 1024 "$ledger" 2>/dev/null)
EOF
  fi
  [ "$n" -lt "$_BROWSER_RATE_PER_MIN" ] || return 1
  # Rewritten through a rename, so a sibling watcher reading mid-write sees the
  # old ledger or the new one and never a truncated file. Two watchers opening
  # in the same instant can each drop the other's entry, which undercounts by
  # one and never wedges.
  if printf '%s%s\n' "$keep" "$now" > "$ledger.$$" 2>/dev/null; then
    mv -f "$ledger.$$" "$ledger" 2>/dev/null || rm -f "$ledger.$$" 2>/dev/null
  fi
  return 0
}

# Resolve the bridge open policy from CLEAT_BROWSER_BRIDGE. An unknown value
# falls back to the safe default rather than erroring, so a typo never wedges a
# session. Echoes one of: auto | always | off.
#   auto   (default): open an OAuth authorize URL (see _is_auth_url) only when
#                     its origin is on the allowlist. Everything else defers:
#                     a plain link, a device-flow page, and any URL at an
#                     unlisted origin. That holds with or without a terminal.
#                     An attached terminal opens a clicked link itself, which
#                     is why deferring never costs a tab there, and off a
#                     terminal nobody is watching the browser at all.
#   always:           open every claimed http(s) URL at any origin (the
#                     pre-gate behaviour). The callback proxy still needs an
#                     allowlisted origin, and the rate cap still applies.
#   off:              never open a browser. The auth callback proxy still runs
#                     for an allowlisted origin, and the claimed URL lands in
#                     the box's .proxy-log. The loopback URL is never printed
#                     by claude (2.1.191+ hands it only to $BROWSER), so the log
#                     is where to find it to open by hand. The printed
#                     code-paste flow needs no proxy.
_browser_bridge_mode() {
  case "${CLEAT_BROWSER_BRIDGE:-auto}" in
    always) printf 'always' ;;
    off)    printf 'off' ;;
    *)      printf 'auto' ;;
  esac
}

# Decide whether the bridge should open a claimed URL on the host. Pure (no I/O)
# so it is exhaustively unit-tested. Returns 0 to OPEN, 1 to DEFER.
# Args: $1 mode (auto|always|off), $2 host_opens_clicks (1 when an interactive
# host terminal is attached and will open the link itself), $3 is_auth (1 when
# the URL is an OAuth authorize URL at an allowlisted origin), $4 dest_allowed
# (1 when the URL's own origin is on the allowlist).
#
# $2 no longer changes the answer. Once a plain link deferred off a terminal as
# well as on one (below), no branch reads it. It is still passed so the callers
# and the watcher's deferral log line keep one shape.
#
# Two changes from the pre-gate behaviour, both deliberate:
#
# The auto branch now requires the destination. Nothing else in the function
# can substitute for it: is_auth used to return early, so an attached terminal
# was irrelevant to a URL carrying the literal text `redirect_uri=`.
#
# A plain link with NO terminal now defers instead of opening. That window is
# `cleat login` (which passes host_opens_clicks=0 unconditionally), a pipe,
# cron, CI and nohup, which is the unattended overnight run this product exists
# for. With nobody watching the browser, opening a plain link the box chose has
# no user value and is exactly the exfiltration primitive. `always` keeps the
# old behaviour in one line for anyone who wants it.
_browser_should_open() {
  local mode="$1" host_opens_clicks="${2:-0}" is_auth="${3:-0}" dest_ok="${4:-0}"
  case "$mode" in
    always) return 0 ;;   # a documented full bypass: any origin the box picks
    off)    return 1 ;;
    *)  # auto
        [ "$dest_ok" = 1 ] || return 1            # not on the list: never open
        [ "$is_auth" = 1 ] && return 0            # auth URL: the bridge owns it
        return 1 ;;                               # plain link: the terminal, or nobody
  esac
}

# Sweep a leftover bridge file without swallowing a live one. A symlink is
# never ours and goes unaged. A regular file younger than several polls is a
# URL some sibling watcher is about to claim (a login alongside a session, two
# shells on one box), and removing it strands that login, so only an aged file
# is a true leftover. _path_mtime returns 0 when it cannot read the mtime,
# which reads as ancient and still gets swept, so this fails safe.
_browser_sweep_stale_bridge() {
  local bridge_file="${1:?}/.browser-open"
  if [ -L "$bridge_file" ]; then
    rm -f "$bridge_file" 2>/dev/null || true
  elif [ -f "$bridge_file" ] && [ "$(( $(date +%s) - $(_path_mtime "$bridge_file") ))" -gt 5 ]; then
    rm -f "$bridge_file" 2>/dev/null || true
  fi
  return 0
}

# Teardown sweep of the bridge file. With another session alive on this box
# (its .watcher.<pid> marker survives the dead-marker sweep) a FRESH bridge
# file is a login URL that sibling is about to claim, so only a stale one goes.
# With no live sibling there is nobody left to claim it, and leaving it behind
# would hand it to the NEXT session on this box, which would open the previous
# session's URL, so it goes unconditionally, exactly as it always did.
_browser_teardown_bridge() {
  local dir="${1:?}"
  _sweep_dead_watcher_markers "$dir"
  if ls "$dir"/.watcher.* >/dev/null 2>&1; then
    _browser_sweep_stale_bridge "$dir"
  elif [ -L "$dir/.browser-open" ] || [ -e "$dir/.browser-open" ]; then
    rm -f "$dir/.browser-open" 2>/dev/null || true
  fi
  return 0
}

_browser_watcher() {
  local clip_dir="$1"
  local open_cmd="$2"
  local cname="${3:-}"
  local bridge_mode="${4:-auto}"
  local host_opens_clicks="${5:-0}"   # 1 when an interactive host terminal is attached
  local bridge_file="$clip_dir/.browser-open"
  local _proxy_pid=""
  # $$ is the spawning cleat process even inside this backgrounded function,
  # used below to reap orphans (see the liveness check in the loop).
  local _bw_parent=$$

  _bw_cleanup() {
    if [ -n "$_proxy_pid" ]; then
      kill "$_proxy_pid" 2>/dev/null || true
      wait "$_proxy_pid" 2>/dev/null || true
      _proxy_pid=""
    fi
    [ -n "${_bw_ready:-}" ] && rm -f "$_bw_ready" 2>/dev/null
    return 0
  }
  trap '_bw_cleanup; exit 0' TERM INT HUP

  # Sweep a URL left over from a previous session (age-gated, see the helper:
  # a FRESH file is a live URL some sibling watcher is about to claim), then
  # the debounce markers that outlived their window.
  _browser_sweep_stale_bridge "$clip_dir"
  # Cap the proxy log once per session. This bounds what carries over between
  # sessions and keeps the window the post-session report reads small. It does
  # NOT bound host disk use, and no cap here could: the clip dir is mounted
  # read-write, so the box can append to this file directly with no claim at
  # all, and /workspace is a host directory it can fill besides. Capping on
  # every append instead would truncate below the byte offset exec_claude
  # captured, losing this session's refusals from the report (concept/41).
  # _cap_watcher_log also unlinks a symlink found at that path. The per-claim
  # guard below is what covers a link planted DURING the session.
  _cap_watcher_log "$clip_dir/.proxy-log" >/dev/null
  # Claims land outside the bind mount, same sibling the clipboard bridge uses.
  local _bw_claim_dir
  _bw_claim_dir="$(dirname "$clip_dir")/clipclaim"
  mkdir -p "$_bw_claim_dir" 2>/dev/null || _bw_claim_dir="$clip_dir"
  # The per-box minute ledger for the rate cap, and this session's open count.
  # No ledger when the claim dir fell back into the mount: see _browser_rate_take.
  local _bw_ledger="" _bw_opens=0
  [ "$_bw_claim_dir" != "$clip_dir" ] && _bw_ledger="$_bw_claim_dir/.opens"
  # Readiness marker for the callback proxy. Outside the bind mount, beside the
  # claim dir and for the same reason: inside it the box could touch the file
  # and make the watcher believe a listener exists that does not.
  local _bw_ready="$_bw_claim_dir/.proxy-ready.$$"
  _browser_sweep_stale_markers "$clip_dir"
  while true; do
    # If the session's run dir was removed (cleat rm/clean/nuke), this watcher is
    # an orphan from a now-gone session: stop polling instead of spinning forever.
    [ -d "$clip_dir" ] || { _bw_cleanup; exit 0; }
    # If the cleat process that spawned this watcher is gone (terminal closed,
    # SIGKILL, anything that skips the cleanup trap), exit instead of polling
    # the box's clip dir forever. Leaked watchers are how one click became one
    # tab PER crashed session.
    kill -0 "$_bw_parent" 2>/dev/null || { _bw_cleanup; exit 0; }
    # Gate the claim's command-substitution behind a builtin `[ -f ]` so an IDLE
    # poll (no bridge file, the overwhelmingly common case) forks nothing but the
    # loop's `sleep`. Without the guard the `$(...)` forks a subshell every 0.5s
    # even when _browser_claim_url would immediately return 1, doubling this
    # watcher's idle fork rate and its contribution to host process pressure under
    # a heavy multi-agent run. Behavior is identical: _browser_claim_url also
    # returns 1 when the file is absent.
    local url=""
    if { [ -f "$bridge_file" ] || [ -L "$bridge_file" ]; } && url="$(_browser_claim_url "$bridge_file" "$_bw_claim_dir")"; then
      if _browser_recently_opened "$clip_dir" "$url"; then
        url=""   # duplicate of a just-opened URL; drop it
      fi
      if [[ "$url" == http://* ]] || [[ "$url" == https://* ]]; then
        # _bind_failed: the callback port could not be held, so the browser must
        # not be pointed at it. Reset per claim, never carried between URLs.
        local _is_auth=0 cb_port _bind_failed=0
        # The URL is written by the CAGED side and echoed into the log below.
        # An embedded newline let it forge whole log lines, which with a
        # planted symlink meant arbitrary lines in a host file. Strip every
        # control character. Never truncate: in `off` mode this line is the
        # ONLY surviving copy of the authorize URL (claude 2.1.191+ hands it to
        # $BROWSER and never prints it), so a shortened one is unusable by hand.
        local _clean_url
        _clean_url="$(printf '%s' "$url" | LC_ALL=C tr -d '[:cntrl:]' 2>/dev/null || printf '%s' "$url" | LC_ALL=C tr -d '\000-\037\177')"
        # Re-checked on every claimed URL, not just at startup: the clip dir is
        # mounted rw, so the box can plant the link at any moment mid-session,
        # and every append below follows one. This runs only when a URL was
        # actually claimed, so it costs nothing on an idle poll.
        _drop_unless_regular "$clip_dir/.proxy-log"
        # Both decisions are taken on $_clean_url, the exact bytes handed to
        # $open_cmd below, and never on $url. Stripping control characters can
        # REWRITE an authority: https://claude.ai<CR>.evil.example/ parses as
        # the host `claude.ai` before the strip and as `claude.ai.evil.example`
        # after it, so a policy that reads $url and an opener that reads
        # $_clean_url disagree about where the browser is going.
        local _dest_ok=0 _dest_host=""
        _dest_host="$(_bridge_url_host "$_clean_url" 2>/dev/null)" || _dest_host=""
        if _bridge_dest_allowed "$_clean_url"; then _dest_ok=1; fi
        # Auth is an OAuth authorize URL at an ALLOWLISTED origin, not any
        # string carrying redirect_uri. The code-paste login flow has no
        # localhost callback and must still open (see _is_auth_url). The proxy
        # below stays loopback-only on top of that.
        _is_auth_url "$_clean_url" && _is_auth=1
        # Start the auth callback proxy when the URL's redirect_uri names a
        # loopback port (_extract_callback_port below).
        # Gated on the DESTINATION as well as on cname and _is_auth. Before the
        # gate this ran in every mode, off included, so `CLEAT_BROWSER_BRIDGE=off`
        # did not stop the box making the host bind a loopback port and forward
        # into the container. That is the only mechanism in Cleat that makes the
        # host bind a box-chosen port, and it contradicted the published
        # no-published-ports claim. The gate holds in `always` too, and that
        # has a cost: a loopback login at an origin nobody listed gets its tab
        # but no callback, so it needs `cleat browser allow` rather than the
        # bypass. That is chosen over leaving a box-chosen bind in any mode
        # (concept/41). Still runs in `off` mode for an allowlisted origin, so
        # `cleat login` completes when the user opens the URL by hand.
        if [ -n "$cname" ] && [ "$_is_auth" = 1 ] && [ "$_dest_ok" = 1 ]; then
          local proxy_log="$clip_dir/.proxy-log"
          # The port comes from _clean_url too: the opener and the forwarder
          # must agree about which URL they are serving.
          cb_port=$(_extract_callback_port "$_clean_url" 2>/dev/null) && {
            _bw_cleanup  # kill any previous proxy
            if _port_in_use "$cb_port"; then
              # A host service already holds it. Binding is impossible, and
              # opening the browser now would aim it at THAT service with the
              # host's cookies, for a port the box chose. Refuse both.
              echo "[browser-watcher $(date +%H:%M:%S)] callback port=$cb_port already in use on the host, not opening" >> "$proxy_log"
              _bind_failed=1
            else
              echo "[browser-watcher $(date +%H:%M:%S)] extracted callback port=$cb_port from URL" >> "$proxy_log"
              rm -f "$_bw_ready" 2>/dev/null || true
              _auth_callback_proxy "$cb_port" "$cname" "$proxy_log" "$_bw_ready" &
              _proxy_pid=$!
              # Wait for the LISTENER, never a fixed sleep. A backgrounded
              # socat's bind is not observable by the parent shell, so the
              # backend touches a file and this loop watches for it. Bounded at
              # about 2s (20 polls of 0.1s): the watcher's fds go to a log, so a
              # hang here is invisible.
              local _bw_w=0
              while [ "$_bw_w" -lt 20 ]; do
                [ -f "$_bw_ready" ] && break
                kill -0 "$_proxy_pid" 2>/dev/null || break
                sleep 0.1
                _bw_w=$(( _bw_w + 1 ))
              done
              if [ ! -f "$_bw_ready" ]; then
                echo "[browser-watcher $(date +%H:%M:%S)] callback proxy never bound port=$cb_port, not opening" >> "$proxy_log"
                _bind_failed=1
              fi
            fi
          } || {
            echo "[browser-watcher $(date +%H:%M:%S)] no redirect_uri port found in URL" >> "$clip_dir/.proxy-log"
          }
        fi
        # Open on the host unless the policy defers to the terminal. A plain link
        # the user clicked is already opened by the host terminal itself; opening
        # it again here is the duplicate tab the maintainer reported. In auto only
        # an authorize URL at an allowlisted origin opens here. A plain link
        # defers with no terminal attached too (see _browser_should_open).
        # Both outcomes are logged: a deferred URL is invisible otherwise, and
        # that silence is what made the code-paste login regression hard to
        # diagnose from the field.
        # Both lines carry the URL itself: the claim above consumed the bridge
        # file, so this log is the only place a deferred or off-mode URL still
        # exists. Claude 2.1.191+ hands the loopback authorize URL ONLY to
        # $BROWSER (never the terminal), so without the URL here an off-mode
        # loopback login would be unrecoverable by hand. Same trust domain as
        # the bridge file (the box's own run dir), so no new exposure.
        if [ "$_bind_failed" = 1 ]; then
          echo "[browser-watcher $(date +%H:%M:%S)] deferring URL to terminal (callback port unavailable) url=$_clean_url" >> "$clip_dir/.proxy-log"
        elif _browser_should_open "$bridge_mode" "$host_opens_clicks" "$_is_auth" "$_dest_ok"; then
          # Every mode, always included: the bypass lifts the destination gate,
          # not the ceiling on how often the host is made to open something.
          # The callback proxy above still runs, so a capped login can still be
          # completed by opening the logged URL by hand, exactly as in off mode.
          if _browser_rate_take "$_bw_ledger" "$_bw_opens"; then
            _bw_opens=$(( _bw_opens + 1 ))
            echo "[browser-watcher $(date +%H:%M:%S)] opening URL on host (mode=$bridge_mode auth=$_is_auth dest=$_dest_ok) url=$_clean_url" >> "$clip_dir/.proxy-log"
            $open_cmd "$_clean_url" >/dev/null 2>&1 || true
          else
            # The marker is what the report at session end reads. The line
            # carries the whole URL, since it is the only copy left.
            echo "[browser-watcher $(date +%H:%M:%S)] ${_BROWSER_CAPPED_MARK} limit=${_BROWSER_RATE_PER_MIN}/min,${_BROWSER_RATE_PER_SESSION}/session url=$_clean_url" >> "$clip_dir/.proxy-log"
          fi
        elif [ "$_dest_ok" != 1 ] && [ "$bridge_mode" != "off" ] && _is_auth_url_shape "$_clean_url"; then
          # A REFUSED destination, not a deferral, and it gets its own marker so
          # the foreground can find it after the exec returns. A denial that
          # exists only in a log inside the box's own clip dir reproduces the
          # silent-deferral regression that concept/33 blames for being
          # undiagnosable from the field, and the box can rewrite that log.
          # _BROWSER_BLOCKED_MARK is what the host-side reader greps for.
          #
          # Only a URL that listing its origin would have opened: an OAuth
          # authorize request. A plain link or a device-flow page defers even at
          # a listed origin, so reporting one printed an allow line that could
          # never make it open. Those fall through to the deferral line below.
          echo "[browser-watcher $(date +%H:%M:%S)] ${_BROWSER_BLOCKED_MARK} origin=${_dest_host:-unparsed} url=$_clean_url" >> "$clip_dir/.proxy-log"
        else
          echo "[browser-watcher $(date +%H:%M:%S)] deferring URL to terminal (mode=$bridge_mode interactive=$host_opens_clicks auth=$_is_auth dest=$_dest_ok) url=$_clean_url" >> "$clip_dir/.proxy-log"
        fi
      fi
    fi
    sleep 0.5
  done
}

# `cleat browser`: see and extend the destination allowlist.
#
# With the list shipped rather than configured, a user has no other way to
# answer "what does my sandbox trust", and "read the source" is not an answer
# for a security feature. This verb is the whole audit story, and `allow` is the
# single copy-pasteable line the blocked notice prints.
cmd_browser() {
  local sub="${1:-origins}"
  case "$sub" in
    --help|-h|help)
      echo "Usage: cleat browser origins        Print the origins the bridge may open"
      echo "       cleat browser allow <origin> Add one origin, for every box"
      echo ""
      echo "  The box can ask your host to open a URL, which is how a login inside"
      echo "  a box reaches your browser."
      echo "  Cleat opens a login page only when its origin is on this list."
      echo "  A login anywhere else is refused and printed when the session ends."
      echo "  Other links are left for you to click."
      return 0 ;;
    origins|list|ls) shift 2>/dev/null || true; _browser_origins_print; return 0 ;;
    allow) ;;
    *)
      error "Unknown subcommand: ${BOLD}${sub}${RESET}"
      echo -e "    ${DIM}cleat browser takes ${BOLD}origins${RESET}${DIM} and ${BOLD}allow <origin>${RESET}${DIM}.${RESET}"
      return 1 ;;
  esac
  shift
  local want="${1:-}"
  if [[ -z "$want" ]]; then
    error "Which origin? ${DIM}cleat browser allow <host>${RESET}"
    echo -e "    ${DIM}Cleat prints the exact host when it refuses one.${RESET}"
    return 1
  fi
  local host
  host="$(_bridge_entry_host "$want" 2>/dev/null)" || host=""
  if [[ -z "$host" ]]; then
    error "Not a host Cleat can match: ${BOLD}$(_sanitize_repo_str "$want")${RESET}"
    echo -e "    ${DIM}An origin is a bare hostname such as ${BOLD}auth.example.com${RESET}${DIM}, letters, digits, dots and dashes.${RESET}"
    return 1
  fi
  if _bridge_host_is_local "$host"; then
    error "${BOLD}${host}${RESET} is a loopback or private address, or an IP written in a form that can hide one."
    echo -e "    ${DIM}Cleat never opens one: it would be an authenticated navigation into a service on your own machine, at an address the box chose.${RESET}"
    return 1
  fi
  if _bridge_origin_persisted "$host"; then
    info "${BOLD}${host}${RESET} is already allowed."
    return 0
  fi
  _bridge_origin_write "$host" || return 1
  success "Allowed ${BOLD}${host}${RESET} ${DIM}(every box, from the next URL on)${RESET}"
  echo -e "    ${DIM}Stored in ${CLEAT_GLOBAL_CONFIG/#${HOME}/~}. Remove it by deleting the line.${RESET}"
  return 0
}

_browser_origins_print() {
  local o mode bad
  mode="$(_browser_bridge_mode)"
  echo ""
  echo -e "  ${BOLD}Browser origins${RESET} ${DIM}(mode ${mode})${RESET}"
  if [[ "$mode" == "always" ]]; then
    echo -e "  ${DIM}CLEAT_BROWSER_BRIDGE=always is set, so the list is not consulted:${RESET}"
    echo -e "  ${DIM}every origin the box picks is opened.${RESET}"
  elif [[ "$mode" == "off" ]]; then
    echo -e "  ${DIM}CLEAT_BROWSER_BRIDGE=off is set, so no URL is opened at all.${RESET}"
  fi
  echo ""
  echo -e "  ${DIM}shipped with cleat${RESET}"
  for o in $_BROWSER_ORIGINS; do
    [ -n "$o" ] && echo "    $o"
  done
  local _cfg _env
  _cfg="$(_bridge_origins_from_config ok)"
  if [[ -n "$_cfg" ]]; then
    echo ""
    echo -e "  ${DIM}added with cleat browser allow${RESET}"
    printf '%s\n' "$_cfg" | while IFS= read -r o; do [ -n "$o" ] && echo "    $o"; done
  fi
  _env="$(_bridge_origins_from_env ok)"
  if [[ -n "$_env" ]]; then
    echo ""
    echo -e "  ${DIM}from CLEAT_BROWSER_ORIGINS${RESET}"
    printf '%s\n' "$_env" | while IFS= read -r o; do [ -n "$o" ] && echo "    $o"; done
  fi
  # A dropped entry is the failure a user cannot see any other way: it reads as
  # "I allowed it and it still does not work".
  bad="$(_bridge_origins_from_env bad; _bridge_origins_from_config bad)"
  if [[ -n "$bad" ]]; then
    echo ""
    warn "Ignored, not a host Cleat will open:"
    printf '%s\n' "$bad" | while IFS= read -r o; do [ -n "$o" ] && echo -e "    ${DIM}${o}${RESET}"; done
  fi
  echo ""
  echo -e "  ${DIM}Add one with ${BOLD}cleat browser allow <host>${RESET}${DIM}. The list can never be complete:${RESET}"
  echo -e "  ${DIM}an MCP server, an Atlassian site or a self-hosted host is yours, not Cleat's.${RESET}"
  return 0
}

# ── Host-side hook bridge ─────────────────────────────────────────────────
# Tails forwarded events and executes the user's host-defined command hooks.
# The settings overlay replaces hook commands with an event forwarder inside
# the container; this bridge reads those events and runs the real commands.
_HOOK_BRIDGE_PID=""
_HOOK_BRIDGE_CHILDREN=()
# Ceiling on hooks executing at once. The spool is written by the CAGED side,
# so its line count is attacker-influenced; this is what stops it becoming a
# host process count. Every event still runs, just not all in one instant.
_HOOK_BRIDGE_MAX_CONCURRENT=8
# The token a dropped-event line carries, read back by the foreground after the
# session. A constant for the same reason _BROWSER_BLOCKED_MARK is: the writer
# and the reader must not drift, and neither may a rewording of the sentence.
_HOOK_DROP_MARK="DROPPED-EVENT"

# The scoped-writer channels. Declared here so an ambient value inherited from
# the caller's ENVIRONMENT can never redirect which section a write lands in:
# these are function parameters carried in globals, not user-facing knobs.
_WRITE_SECTION=""
_WRITE_RES_SECTION=""
_WRITE_EMPTY_SECTION=0

# The ONE file a hook command may come from. It is NOT outside every mount: the
# whole host ~/.claude is bound read-write into the box, and the box is kept off
# this file only by the per-box settings overlay bound over the same path. A
# host save that renames a new file over it detaches that overlay in a running
# box until the box restarts (concept/41 residual 10, measured on Linux).
#
# The bridge used to re-read the command from all three settings files on every
# event, and two of them live inside the read-write /workspace mount. That is
# not a theoretical path: event one ran the user's own hook, the box rewrote the
# file the way a box writes through /workspace, and event two executed the
# rewritten command on the HOST. The comment on _execute_host_hooks states the
# intent this broke in its own words: enabling the capability is a decision to
# run YOUR hooks on your machine, not a decision to let the box choose the
# command.
#
# Split by ORIGIN rather than gated by consent, and that is the decisive
# argument: settings.local.json is a file Claude Code itself WRITES during
# ordinary operation, so a trust hash over it would change as a routine
# consequence of the agent doing its job. A prompt that fires whenever a build
# finishes is a prompt the user learns to accept, and the attacker chooses when
# it fires. No amount of consent makes a box-authored host command safe, so the
# project files are default-deny with no prompt at all.
_HOOK_HOST_SETTINGS="${HOME}/.claude/settings.json"

# Project-level settings files that DEFINE hooks which will not run on the host.
# Printed once at session start so the change is visible rather than silent.
_hook_project_files_with_hooks() {
  local f
  for f in "${_RESOLVED_PROJECT:-.}/.claude/settings.json" "${_RESOLVED_PROJECT:-.}/.claude/settings.local.json"; do
    [[ -s "$f" ]] || continue
    jq -e '.hooks // empty | length > 0' "$f" >/dev/null 2>&1 || continue
    printf '%s\n' "$f"
  done
  return 0
}

_has_host_hooks() {
  [[ -s "$_HOOK_HOST_SETTINGS" ]] || return 1
  jq -e '.hooks // empty | length > 0' "$_HOOK_HOST_SETTINGS" >/dev/null 2>&1
}

_hook_bridge_watcher() {
  local hooks_file="$1"
  # The WORKSPACE, for path translation. For a plain box it is the project; for
  # a fork box it is the copy, and that distinction is the whole point (see
  # _hook_translate_path). Defaulted so a two-argument caller still works.
  local _hb_ws="${2:-${_RESOLVED_PROJECT:-}}"
  # The box this bridge serves, recorded on every log line so the end-of-session
  # report counts this box's drops and not a concurrent session's in another.
  local _hb_cname="${3:-}"
  # Orphan guard, as in _browser_watcher: a bridge whose cleat process died
  # without the cleanup trap must not keep executing host hooks for a dead
  # session. $$ is the spawning cleat process even in this backgrounded call.
  local _hb_parent=$$
  # ONE settings file, and it is the host's. See _HOOK_HOST_SETTINGS: the two
  # project files sit inside the read-write /workspace mount, so a command read
  # from either is a command the box can write.
  local settings_files=()
  [[ -s "$_HOOK_HOST_SETTINGS" ]] && settings_files+=("$_HOOK_HOST_SETTINGS")
  # On exit: kill all child hook processes
  trap '_hook_bridge_cleanup; exit 0' TERM INT HUP
  trap '_hook_bridge_cleanup' EXIT

  # Wait for the spool to appear, for as long as the session lives.
  #
  # This used to give up after 30 seconds, and the spool only comes into
  # existence when the box fires its FIRST hook event. A session where the user
  # reads the screen and types a prompt before the agent's first tool call is
  # past 30s, so the bridge had already exited and the whole session ran with no
  # host hooks and no message. That is how the cap looked dead on a real Mac
  # (2026-09-18). The session's own lifetime is the only honest bound here: the
  # parent check below ends the wait the moment cleat goes away.
  while [[ ! -f "$hooks_file" ]]; do
    kill -0 "$_hb_parent" 2>/dev/null || return 0
    # Checked HERE as well as after the loop: a link to a character device or
    # a fifo is not a regular file, so `[[ ! -f ]]` stays true and the bridge
    # would wait for a spool that will never be regular.
    _drop_unless_regular "$hooks_file"
    sleep 1
  done
  # The spool sits in a directory the box mounts read-write. A symlink here is
  # never the forwarder's, which only ever appends to a regular file, and
  # reading through one is how a box aims this bridge at a host file: `wc -c`
  # on a link to a fifo or /dev/zero never returns, wedging the bridge with no
  # signal at all. `[[ -f ]]` dereferences, so the link test has to come first.
  _drop_unless_regular "$hooks_file"
  [[ -f "$hooks_file" ]] || return 0

  # Tail new lines and execute matching host hooks.
  # We track our byte offset to avoid wc -l / tail race conditions.
  # Start from the current end of the file to skip events from prior sessions.
  local byte_offset
  byte_offset=$(wc -c < "$hooks_file" 2>/dev/null || echo 0)
  byte_offset=$((byte_offset + 0))
  # Set while the rest of an oversized line is being discarded. Kept across
  # passes, because one line can span two read windows.
  local _hb_skip=0
  while true; do
    # Liveness BEFORE processing: an orphaned bridge must not run one last
    # batch of host hooks for a session whose cleat process is already gone.
    kill -0 "$_hb_parent" 2>/dev/null || { _hook_bridge_cleanup; exit 0; }
    # Re-checked every pass, not just at startup: the box can plant the link at
    # any moment, including between two polls of a live bridge.
    if [ -L "$hooks_file" ] || { [ -e "$hooks_file" ] && [ ! -f "$hooks_file" ]; }; then
      _drop_unless_regular "$hooks_file"
      _hook_bridge_cleanup
      exit 0
    fi
    local file_size
    file_size=$(wc -c < "$hooks_file" 2>/dev/null || echo 0)
    file_size=$((file_size + 0))

    local _win _start _count
    # A spool that shrank starts over, and so does any discard in progress.
    [ "$file_size" -lt "$byte_offset" ] && _hb_skip=0
    if _win="$(_hook_bridge_window "$byte_offset" "$file_size")"; then
      read -r _start _count <<< "$_win"
      # Reap finished children
      _hook_bridge_reap

      # _hb_pos is the spool byte offset of the chunk being handled, which the
      # logs record so an entry can be found in the spool afterwards.
      local _hb_pos=$(( _start - 1 )) _hb_lpos
      while _hook_read_chunk; do
        _hb_lpos=$_hb_pos
        # Over the cap: the read stopped at the cap, so the newline is still
        # unread and the rest of the line follows as more chunks. Log the line
        # once and discard until the chunk that ends it.
        if [ "$_HOOK_CHUNK_LEN" -gt "$_HOOK_LINE_MAX" ]; then
          _hb_pos=$(( _hb_pos + _HOOK_CHUNK_LEN ))
          [ "$_hb_skip" -eq 1 ] || _hook_drop_log "size" "$_HOOK_CHUNK" "$_hb_cname" "$_hb_lpos"
          _hb_skip=1
          continue
        fi
        _hb_pos=$(( _hb_pos + _HOOK_CHUNK_LEN + 1 ))
        if [ "$_hb_skip" -eq 1 ]; then
          _hb_skip=0
          continue
        fi
        line="$_HOOK_CHUNK"
        [[ -n "$line" ]] || continue
        # Validate and translate BEFORE anything is dispatched. A failure drops
        # the event and records it: the default is refuse, not sanitise. Called
        # in this shell, not a command substitution, so the directory its
        # relative paths were judged from comes back with it and the hook is
        # started there.
        local _ev_rc=0
        _hook_translate_event_to "$line" "$_hb_ws" 2>/dev/null || _ev_rc=$?
        if [ "$_ev_rc" -ne 0 ]; then
          _hook_drop_log "$(_hook_drop_reason "$_ev_rc")" "$line" "$_hb_cname" "$_hb_lpos"
          continue
        fi
        _hook_run_log "$_HOOK_EV_OUT" "$line" "$_hb_cname" "$_hb_lpos"
        _execute_host_hook_bg "$_HOOK_EV_OUT" "$_HOOK_EV_DIR" "$_hb_ws" "${settings_files[@]}"
      done < <(tail -c +"$_start" "$hooks_file" 2>/dev/null | head -c "$_count")

      byte_offset=$file_size
    fi
    sleep 0.5
  done
}

# The next read window over the spool, as "<start-byte> <count>", or non-zero
# when there is nothing new. Split out of the watcher loop because that loop is
# an infinite poll and this arithmetic is where both of its bugs lived.
#
#   * COUNT IS BOUNDED to the size already sampled. The old code ran `tail -c
#     +N` with no bound, so it read to the LIVE end of file, which the box can
#     push past the sampled size while the read is in flight. byte_offset was
#     then set to the older, smaller size, so every byte written during the read
#     came back on the next pass and its hook RAN A SECOND TIME. A hook is
#     arbitrary user automation (a deploy, a notification, a commit), so a
#     duplicate is a real side effect, not a cosmetic double read.
#   * A SHRINKING SPOOL REWINDS. The offset only ever grew, so once the box
#     truncated or replaced events.jsonl the "is there more" test could never be
#     true again and the bridge silently stopped running the user's hooks for
#     the rest of the session, with nothing on screen to say so.
_hook_bridge_window() {
  local offset="$1" size="$2"
  [[ "$size" -lt "$offset" ]] && offset=0
  [[ "$size" -gt "$offset" ]] || return 1
  printf '%s %s' "$(( offset + 1 ))" "$(( size - offset ))"
}

# Read the next spool line from stdin into _HOOK_CHUNK, never more than one
# byte past the cap, with its BYTE length in _HOOK_CHUNK_LEN. A length over
# _HOOK_LINE_MAX means the read stopped at the cap and the line goes on.
#
# The cap used to be checked after `read -r line` had already buffered the
# whole line, so the box chose how much host memory one line cost: 8 MB of
# line peaked the bridge at 88 MB, 256 MB at 1.7 GB, and a genuine hook waited
# behind it. The subshell pins LC_ALL=C on every bash, so `read -n` and ${#}
# count bytes rather than characters. It reads from a pipe, where bash takes
# one byte at a time, so it consumes exactly what it returns. A final line with
# no newline yet is not returned, the same as the plain read before it.
_hook_read_chunk() {
  local _c
  _c="$(LC_ALL=C
        IFS= read -r -n "$(( _HOOK_LINE_MAX + 1 ))" _l || exit 1
        printf '%s:%s' "${#_l}" "$_l")" || return 1
  _HOOK_CHUNK_LEN="${_c%%:*}"
  _HOOK_CHUNK="${_c#*:}"
  return 0
}

# Reap finished child processes from the tracking array
_hook_bridge_reap() {
  local alive=()
  for pid in "${_HOOK_BRIDGE_CHILDREN[@]+"${_HOOK_BRIDGE_CHILDREN[@]}"}"; do
    if kill -0 "$pid" 2>/dev/null; then
      alive+=("$pid")
    else
      wait "$pid" 2>/dev/null || true
    fi
  done
  _HOOK_BRIDGE_CHILDREN=("${alive[@]+"${alive[@]}"}")
}

# Kill all tracked children.
# These run inside the bridge's process group (which is disowned from the parent).
# We kill them directly: no wait needed since they're in our own process tree.
_hook_bridge_cleanup() {
  for pid in "${_HOOK_BRIDGE_CHILDREN[@]+"${_HOOK_BRIDGE_CHILDREN[@]}"}"; do
    # The GROUP first: _execute_host_hook_bg starts each hook under `set -m`,
    # so the subshell leads its own process group and the real work (timeout,
    # bash -c, whatever the hook spawns) is inside it. Signalling only the
    # tracked PID hit the subshell and left the actual hook process running
    # past the end of the session. Fall back to the bare PID for any child
    # started before job control, or if the group is already gone.
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
  done
  # Brief pause to let children exit, then reap
  sleep 0.1 2>/dev/null || true
  for pid in "${_HOOK_BRIDGE_CHILDREN[@]+"${_HOOK_BRIDGE_CHILDREN[@]}"}"; do
    wait "$pid" 2>/dev/null || true
  done
  _HOOK_BRIDGE_CHILDREN=()
}

# Execute a single event's host hooks in a tracked background subprocess, from
# directory $2, which has to be inside workspace $3 (see _hook_enter_run_dir).
_execute_host_hook_bg() {
  local event_json="$1" run_dir="$2" ws="$3"
  shift 3
  local settings_files=("$@")

  # Bounded concurrency. The spool is bind-mounted read-write into the box, so
  # the number of lines is chosen by the CAGED side: one background subshell
  # per line, unbounded, meant a box appending N lines forked N host processes
  # at once. Host fork exhaustion has already corrupted this project's TUI once,
  # and it is the one failure a sandbox must not import from the thing it is
  # sandboxing.
  #
  # This does NOT change whether or which hooks run. Enabling the capability is
  # the user's decision to run THEIR hooks on their machine, and every spooled
  # event still gets its hooks, in order. It only stops them all starting in
  # the same instant. Blocking here also applies backpressure to the read loop,
  # which is the point: the spool is a queue, not a fan-out.
  local _waited=0
  while [[ "$(_hook_bridge_live_count)" -ge "$_HOOK_BRIDGE_MAX_CONCURRENT" ]]; do
    _hook_bridge_reap
    [[ "$(_hook_bridge_live_count)" -lt "$_HOOK_BRIDGE_MAX_CONCURRENT" ]] && break
    sleep 0.1
    _waited=$(( _waited + 1 ))
    # Never wedge the bridge on a hook that ignores its own timeout. 600 x 0.1s
    # is well past the 30s `timeout` each hook already carries.
    [[ $_waited -ge 600 ]] && break
  done

  # Job control so each hook lands in its OWN process group. Without it the
  # tracked PID is the subshell and the actual `timeout`/`bash -c` is a
  # grandchild, so _hook_bridge_cleanup signalled a shell that was already
  # waiting and left the real hook process running after the session ended.
  set -m 2>/dev/null || true
  (
    if ! _hook_enter_run_dir "$run_dir" "$ws"; then
      printf 'cleat: hook not run, its directory could not be entered inside the workspace: %s\n' \
        "$(_sanitize_repo_str "${run_dir:0:200}")" >&2
      exit 0
    fi
    _execute_host_hooks "$event_json" "${settings_files[@]}"
  ) &
  _HOOK_BRIDGE_CHILDREN+=("$!")
  set +m 2>/dev/null || true
}

# Enter the directory a hook runs in, or fail, in which case the hook does not
# run. It is the event's translated cwd (the workspace when there is none), the
# same directory _hook_translate_event_to judged every relative path from.
#
# The bridge used to start every hook in its OWN working directory, which is
# wherever cleat was launched and, for a fork box, the origin tree. A relative
# `evil/id_rsa` then passed a check made in /workspace/sub, where sub/evil is a
# real directory, and was opened from the project root, where the box had
# planted `evil -> ~/.ssh`. The PostToolUse hook copied the key out.
#
# `cd -P` and then a check of $PWD, never a check of the name before the cd.
# The directory was already judged when the event was translated, so this is
# the second look, and it is the one that holds: once entered, the directory
# cannot be moved out of the workspace by the box, because a rename cannot
# cross the bind mount. A link swapped in before the cd is caught here. Upstream
# runs the hook from the translated cwd for the same reason.
_hook_enter_run_dir() {
  local dir="$1" ws="$2"
  [ -n "$dir" ] && [ -n "$ws" ] || return 1
  cd -P -- "$dir" 2>/dev/null || return 1
  _hook_phys_inside "$PWD" "$ws"
}

# How many tracked children are still alive. Counting is separate from reaping
# because the bound above has to ask repeatedly while it waits.
_hook_bridge_live_count() {
  local pid n=0
  for pid in "${_HOOK_BRIDGE_CHILDREN[@]+"${_HOOK_BRIDGE_CHILDREN[@]}"}"; do
    kill -0 "$pid" 2>/dev/null && n=$(( n + 1 ))
  done
  printf '%s' "$n"
}

# ── Payload validation ──────────────────────────────────────────────────────
#
# The event JSON a host hook receives on stdin is written by the CAGED side, so
# every field in it is attacker-chosen. Claude Code 2.1.258 already solves this
# exact problem for its own cloud and container sessions, and its posture is
# stronger than Cleat's was, so this adopts the vendor's six properties rather
# than inventing a scheme. Being able to say "the same posture Claude Code
# itself takes for container sessions" is worth as much as the code.
#
#   1. The two transcript fields are REPLACED with a sentinel, never validated.
#   2. cwd and every path field Claude Code's own table knows is translated to
#      its host path and required to be inside the workspace, ON DISK as well
#      as by spelling (see _hook_path_inside). The field set is upstream's:
#      every tool_input string under a path-shaped key (file_path, path,
#      filePath, cwd, notebook_path and the rest of _HOOK_JQ_CANDS), the same
#      inside each tool_calls[] entry, and tool_response filePath,
#      notebook_path, file and file.filePath. Those DROP the event. The
#      response lists file.outputDir and filenames[] are informational, so an
#      entry that does not map is NULLED instead. A relative value is judged
#      from the event's cwd, and the hook runs in that directory.
#   3. Per-segment rejects: empty, `.`, `..`, control and format characters,
#      U+2028 and U+2029, backslash, colon.
#   4. Whole-value rejects: leading or trailing whitespace, a `~` prefix, or a
#      `$ % ` ! =` prefix.
#   5. The default is REFUSE, not sanitise. An event naming a path this machine
#      could not map to its own files does not run.
#   6. The event name is bounded and charset-checked, and the line must hold
#      exactly one JSON value, an object.
#
# Deliberately untouched: Bash rawOutputPath and persistedOutputPath, Agent
# outputFile and worktreePath, and every other tool_response member. They name
# container paths, so no host hook can open them, and they are the same class
# as the free text residual in concept/11. Top-level path fields of non-tool
# events (InstructionsLoaded and FileChanged file_path, CwdChanged old_cwd and
# new_cwd) are outside upstream's table too. concept/41 names both.

# Claude Code's own per-line cap for the same channel. Cleat had no size cap
# anywhere in the bridge, and the spool is box-written, so the length of one
# event was the box's to choose. It is a BYTE count, and the bridge enforces it
# on the read itself (_hook_read_chunk), so an oversized line is never held
# whole in memory.
_HOOK_LINE_MAX=1044480

# Upstream's own ceilings: at most 256 path fields judged per event (more drops
# it), and at most 64 missing components or symlink hops walked per path.
# A tool_response filenames entry is not counted toward the 256, as upstream
# leaves response arrays out of its count, so a Grep over many files keeps its
# event. Those entries get their own bound instead: past _HOOK_LIST_MAX they are
# nulled by jq without being judged, so a box that lists 200,000 names in one
# megabyte of line cannot make the bridge walk each of them on disk.
_HOOK_PATHS_MAX=256
_HOOK_WALK_MAX=64
_HOOK_LIST_MAX=1024

# The visibility log of events that passed validation. Rotated to .1 past this
# size, checked every _HOOK_RUN_LOG_EVERY writes, because unlike the drop log
# it grows with every tool call the agent makes.
_HOOK_RUN_MARK="RAN-EVENT"
_HOOK_RUN_LOG_MAX=1048576
_HOOK_RUN_LOG_EVERY=64
_HOOK_RUN_LOG_N=0

# Which spool values are paths, as jq definitions shared by the two passes of
# _hook_translate_event: one lists the candidates, the other writes the
# translated values back by position, so both must enumerate the same paths in
# the same order. The key patterns are Claude Code 2.1.270's own (`rho` and
# `Cnt` beside its `ude` table): a string is a candidate when its key names a
# path, or when it sits in an array or plain object under such a key. A URL key
# whose value really is a URL (https, s3, mailto and so on) is not a path.
# Output: {c, p, v} with c = C (cwd), D (drop when it does not map), N (null
# when it does not map), L (a filenames entry: nulled like N, left out of the
# path-field count, and only the first $lmax are listed, _hlistcap nulling the
# rest) or X (nested past 16 levels, which is refused).
_HOOK_JQ_CANDS='
def _hk: test("(^|_)(path|paths|file|files|filename|filenames|dir|directory|directories|cwd|filepath|filepaths|abspath|realpath|fullpath|relpath|dirname|basename|pathname|folder|folders|dirs|workdir|outdir|rootdir|basedir|tmpdir|subdir|srcdir|destdir|builddir|datadir|homedir)$|(Path|Paths|File|Files|Filename|Filenames|Dir|Dirs|Directory|Directories|Folder|Folders|Cwd)$");
def _hu: test("(^|_)(uri|uris|url|urls)$|(Uri|Uris|Url|Urls|URI|URIs|URL|URLs)$");
def _hurl: test("^(https?|s3|gs|ftps?|mailto|data):[^\\p{Cc}\\p{Cf}\\p{Z}\\s]*$"; "i");
def _hwalk($all; $url; $d):
  if (type != "array" and type != "object") then empty
  elif $d > 16 then {c: "X", p: [], v: ""}
  elif type == "array" then
    to_entries[] | .key as $k | .value
    | if type == "string" then
        (if $all and (($url and _hurl) | not) then {p: [$k], v: .} else empty end)
      else
        ($all and ((type == "object" and (keys | any(_hk or _hu))) | not)) as $re
        | _hwalk($re; $re and $url; $d + 1) | .p = [$k] + .p
      end
  else
    to_entries[] | .key as $k | .value
    | ($all or ($k | _hk or _hu)) as $hit
    | ($url or ($k | _hu)) as $u
    | if $hit and type == "string" then
        (if $u and _hurl then empty else {p: [$k], v: .} end)
      elif $hit and type == "array" then
        _hwalk(true; $u; $d + 1) | .p = [$k] + .p
      else
        ($hit and type == "object" and ((keys | any(_hk or _hu)) | not)) as $me
        | _hwalk($me; $me and $u; $d + 1) | .p = [$k] + .p
      end
  end;
def _hresp:
  (if (.filePath | type) == "string" then {c: "D", p: ["filePath"], v: .filePath} else empty end),
  (if (.notebook_path | type) == "string" then {c: "D", p: ["notebook_path"], v: .notebook_path} else empty end),
  (if (.file | type) == "string" then {c: "D", p: ["file"], v: .file} else empty end),
  (if (.file | type) == "object" and (.file.filePath | type) == "string" then {c: "D", p: ["file", "filePath"], v: .file.filePath} else empty end),
  (if (.file | type) == "object" and (.file.outputDir | type) == "string" then {c: "N", p: ["file", "outputDir"], v: .file.outputDir} else empty end),
  (if (.filenames | type) == "array" then .filenames | to_entries[] | select((.value | type) == "string" and .key < $lmax) | {c: "L", p: ["filenames", .key], v: .value} else empty end);
def _hlistcap:
  if (.tool_response | type) == "object" and (.tool_response.filenames | type) == "array"
  then .tool_response.filenames |= [to_entries[] | if .key >= $lmax and (.value | type) == "string" then null else .value end]
  else . end;
def _htool($pre):
  ( .tool_input
    | if type == "string" then {c: "D", p: [], v: .}
      elif type == "array" then _hwalk(true; false; 0) | .c = (.c // "D")
      else _hwalk(false; false; 0) | .c = (.c // "D")
      end
    | .p = $pre + ["tool_input"] + .p ),
  ( .tool_response | if type == "object" then _hresp | .p = $pre + ["tool_response"] + .p else empty end );
def _hcands:
  (if has("cwd") and .cwd != null and .cwd != "" then {c: "C", p: ["cwd"], v: .cwd} else empty end),
  _htool([]),
  (if (.tool_calls | type) == "array" then .tool_calls | to_entries[] | .key as $i | .value | select(type == "object") | _htool(["tool_calls", $i]) else empty end);
'

# What the transcript fields become. Property 1: they name CONTAINER paths that
# do not exist on the host, so no legitimate host hook can be using them, and
# validating them is the trap in C1 below.
_HOOK_TRANSCRIPT_SENTINEL="/cleat/transcript-is-inside-the-box"

# Per-event timeouts, Claude Code's own values rather than Cleat's flat 30s. A
# Stop hook that formats a large repo legitimately takes minutes, and a
# PreToolUse hook that takes 30 seconds has already wedged the turn.
_hook_timeout_for() {
  case "$1" in
    PreToolUse|PostToolUse) printf '15' ;;
    UserPromptSubmit)       printf '30' ;;
    Stop|SubagentStop)      printf '120' ;;
    *)                      printf '30' ;;
  esac
}

# A charset and a length, deliberately NOT a roster. concept/11 lists 25 event
# names and Claude Code 2.1.258 ships 33, so the repo's own list is already
# stale by eight, and a hardcoded one means the next Claude Code release
# silently stops running the user's hook for a new event. The name is handed to
# jq as --arg and indexed `.hooks[$ev]`, so an unknown name can only ever fail
# to match a key the user wrote, which is the effective behaviour today.
_hook_event_name_ok() {
  local n="$1"
  [ -n "$n" ] || return 1
  [ "${#n}" -le 64 ] || return 1
  case "$n" in *[!A-Za-z0-9_-]*) return 1 ;; esac
  return 0
}

# Translate one container path to the host path that names the same file, or
# fail. Failing is what drops the event.
#
# The target is $ws, the WORKSPACE, and never $_RESOLVED_PROJECT. In a fork box
# those differ, and translating to the project would point the user's host hook
# at the ORIGIN working tree from inside a fork box, cancelling exactly the
# isolation the fork feature sells.
#
# Two steps. The first is a literal PREFIX rewrite, and the value the hook
# receives is that rewrite, so it keeps the spelling of the project Cleat
# computed. The second checks where the rewrite LANDS on disk
# (_hook_path_inside). The rewrite alone let a box aim a hook anywhere: the
# workspace is mounted read-write, so `ln -s /Users/you/.ssh evil` makes
# /workspace/evil/id_rsa a perfectly spelled in-project path that opens a host
# credential, and a formatter hook writes through it just as easily.
#
# The on-disk check is not the obvious `cd -P "$(dirname "$p")" && pwd -P`
# string compare, which carries three macOS-first failures that would not
# reproduce on the Linux box this was written on: resolve_project is logical,
# so a project reached through a symlink (~/Code on an external volume, iCloud,
# Dropbox, /tmp on macOS) fails every comparison; APFS is case-insensitive, so
# two spellings of one real directory compare unequal; and the parent has to
# EXIST, so a PreToolUse for a file in a directory the agent is about to create
# resolves to nothing. See _hook_path_inside for how each is kept.
_hook_translate_path() {
  _hook_translate_path_to "$1" "$2" || return 1
  printf '%s' "$_HOOK_TP_OUT"
}

# The same, with the result in _HOOK_TP_OUT rather than on stdout, so the event
# loop does not fork a subshell per path field.
_hook_translate_path_to() {
  local p="$1" ws="$2" rest out
  _HOOK_TP_OUT=""
  [ -n "$p" ] || return 1
  [ -n "$ws" ] || return 1
  [ "${#p}" -le 4096 ] || return 1
  # Whole-value rejects (property 4). Upstream also refuses a `~`, `$`, `%`,
  # backtick, `!` or `=` PREFIX. Those are not repeated here, and deliberately:
  # this function requires the value to start with `/workspace` or with the
  # workspace path, so a value beginning with any of them is already refused by
  # the fall-through at the end. Restating them would be a guard another guard
  # covers, which cannot be mutation-tested and is therefore indistinguishable
  # from a guard that does nothing. Leading and trailing whitespace IS reachable
  # (`/workspace/a ` has the right prefix) so it gets its own arm. A RELATIVE
  # path field has no prefix to require, so _hook_relative_ok restates all of
  # them, and there each one is reachable.
  case "$p" in
    [[:space:]]*|*[[:space:]]) return 1 ;;
  esac
  # Per-segment rejects (property 3), the structural half: an empty segment or
  # a dot segment. The character half is _hook_segment_chars_ok below.
  case "$p" in
    *//*|*/./*|*/../*|*/.|*/..|.|..) return 1 ;;
  esac
  # With the docker cap on, 8412 mounts "$_workspace:$_workspace" and sets
  # --workdir to it, so events from such a box already carry host-absolute
  # paths. Both shapes have to be accepted or the cap breaks every hook.
  if [ "$p" = "/workspace" ] || [ "$p" = "$ws" ]; then
    out="$ws"; rest=""
  else
    case "$p" in
      /workspace/*) rest="${p#/workspace/}"; out="$ws/$rest" ;;
      "$ws"/*) rest="${p#"$ws"/}"; out="$p" ;;
      *) return 1 ;;
    esac
  fi
  # Only the part after the workspace prefix is judged by character, so a host
  # project whose own path holds a colon is never refused by this rule.
  [ -z "$rest" ] || _hook_segment_chars_ok "$rest" || return 1
  _hook_path_inside "$out" "$ws" || return 1
  _HOOK_TP_OUT="$out"
  return 0
}

# Property 3's character rule: no control or format character, no U+2028 or
# U+2029, no backslash, no colon. Judged by jq, whose regex classes are Unicode
# and ignore the locale, so the verdict is the same under LC_ALL=C and a UTF-8
# locale. A bash [[:cntrl:]] is not: U+0085 is a control character under
# C.UTF-8 and two ordinary bytes under C, and U+202E (right-to-left override)
# is neither. The fast path skips the jq fork for the common all-ASCII path.
# It is an explicit character list, not a range, so no collation can widen it.
_hook_segment_chars_ok() {
  case "$1" in
    *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/@+,=%#~\ -]*) ;;
    *) return 0 ;;
  esac
  [ "$(printf '%s' "$1" | jq -Rs 'test("[\\p{Cc}\\p{Cf}\\x{2028}\\x{2029}\\\\:]")' 2>/dev/null)" = "false" ]
}

# Where a path lands on disk: the physical path of its nearest existing
# ancestor with the missing components appended, in _HOOK_PHYS. The same walk
# as Claude Code's own (gIe): resolve what exists, walk up past what does not,
# and REFUSE when a component is a symlink that resolves to nothing, because
# that is a dangling or looping link whose target the box can still choose.
# Every existing component is resolved by the kernel (`[ -d ]`, `cd -P`), and
# the only lexical step is dropping a missing trailing name, so a `..` in a
# missing tail (reachable only through a link target) is refused rather than
# guessed. Symlink hops and missing components together are bounded.
_hook_physical_path() {
  local p="$1" tail="" n=0 d tgt base here="$PWD"
  _HOOK_PHYS=""
  while :; do
    n=$(( n + 1 ))
    [ "$n" -le "$_HOOK_WALK_MAX" ] || return 1
    while [ "${#p}" -gt 1 ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done
    if [ -d "$p" ]; then
      # `cd -P` in this shell and read $PWD, rather than `$(cd -P ... && pwd
      # -P)`: a Glob or Grep response lists hundreds of files, and this saves a
      # subshell per entry. The event path already runs inside a command
      # substitution, and the directory is restored for any other caller.
      cd -P -- "$p" 2>/dev/null || return 1
      d="$PWD"
      cd -- "$here" 2>/dev/null || true
      d="${d%/}$tail"
      [ -n "$d" ] || d="/"
      _HOOK_PHYS="$d"
      return 0
    fi
    if [ -L "$p" ]; then
      [ -e "$p" ] || return 1
      tgt="$(readlink "$p" 2>/dev/null && printf x)" || return 1
      tgt="${tgt%x}"
      tgt="${tgt%?}"
      [ -n "$tgt" ] || return 1
      case "$tgt" in *[[:cntrl:]]*) return 1 ;; esac
      case "$tgt" in
        /*) p="$tgt" ;;
        *) p="${p%/*}/$tgt" ;;
      esac
      continue
    fi
    # Only in a race can a dot segment get here: every value is refused one
    # lexically before this, and a link target is followed only when it
    # resolves. Refused, never appended to a physical prefix it would climb.
    base="${p##*/}"
    case "$base" in ''|.|..) return 1 ;; esac
    tail="/$base$tail"
    p="${p%/*}"
    [ -n "$p" ] || p="/"
  done
}

# Is path $1 inside workspace $2 where it lands on disk? Two ways to say yes,
# and each keeps one macOS case working.
#
#   * The physical path starts with the workspace as Cleat spelled it. That is
#     the only way a workspace that does not exist yet can match, and a
#     physical path cannot start with a spelling that passes through a symlink,
#     so it never lets a link through.
#   * An ancestor of the physical path IS the workspace (`-ef`, same device and
#     inode). That is what keeps a project reached through a symlink and a
#     project spelled in a different case on APFS: neither compares equal as a
#     string, both are the same directory.
#
# A residual stays, and concept/41 names it: this is a check at one instant.
# The box can swap a link after it and before the hook opens the path.
_hook_path_inside() {
  _hook_physical_path "$1" || return 1
  _hook_phys_inside "$_HOOK_PHYS" "$2"
}

# The second half on its own: is the already PHYSICAL path $1 inside workspace
# $2? Split out for the hook's working directory, which is entered with `cd -P`
# and judged from $PWD. Walking it again would cd by name and back, and a box
# that swaps a link in between moves the directory the hook then runs in.
_hook_phys_inside() {
  local a="$1" ws="$2"
  [ -n "$a" ] && [ -n "$ws" ] || return 1
  case "$a" in
    "$ws"|"$ws"/*) return 0 ;;
  esac
  [ -d "$ws" ] || return 1
  while :; do
    [ "$a" -ef "$ws" ] && return 0
    [ "$a" = "/" ] && return 1
    a="${a%/*}"
    [ -n "$a" ] || a="/"
  done
}

# A path field that is RELATIVE (a Grep or Glob path, an MCP tool's filename)
# is kept as the box wrote it and judged from $base, the event's translated cwd.
# That is only sound because the hook RUNS in that same directory (see
# _hook_enter_run_dir): the bridge's own working directory is wherever cleat was
# launched, and for a fork box that is the origin tree, so a value judged in one
# directory and opened from another resolves through links the check never saw.
# It still has to pass the value and segment rules, and it still has to land
# inside the workspace, or a relative `evil/id_rsa` through a planted link
# escapes exactly the way an absolute one did. _hook_translate_path_to gets the
# whole-value prefix rejects for free from its absolute prefix requirement. A
# relative value has no prefix, so they are restated here and each is reachable.
# A `.` segment is allowed here, as upstream allows it.
_hook_relative_ok() {
  local v="$1" ws="$2" base="$3" rest seg norm=""
  [ "${#v}" -le 4096 ] || return 1
  case "$v" in
    [[:space:]]*|*[[:space:]]) return 1 ;;
    '~'*|'$'*|'%'*|'`'*|'!'*|'='*) return 1 ;;
  esac
  _hook_segment_chars_ok "$v" || return 1
  rest="$v"
  while [ -n "$rest" ]; do
    case "$rest" in
      */*) seg="${rest%%/*}"; rest="${rest#*/}" ;;
      *) seg="$rest"; rest="" ;;
    esac
    case "$seg" in
      .) continue ;;
      ''|..) return 1 ;;
    esac
    norm="$norm/$seg"
  done
  [ -n "$norm" ] || return 0
  _hook_path_inside "${base%/}$norm" "$ws"
}

# One candidate value, into _HOOK_TV_OUT: "T<host path>" to write back, "K" to
# keep, or failure.
_hook_translate_value() {
  local v="$1" ws="$2" base="$3"
  _HOOK_TV_OUT=""
  if [ -z "$v" ]; then _HOOK_TV_OUT="K"; return 0; fi
  case "$v" in
    /*)
      _hook_translate_path_to "$v" "$ws" || return 1
      _HOOK_TV_OUT="T$_HOOK_TP_OUT"
      return 0
      ;;
  esac
  _hook_relative_ok "$v" "$ws" "$base" || return 1
  _HOOK_TV_OUT="K"
}

# Is this line within the cap in BYTES? A subshell so LC_ALL=C takes effect on
# every bash, the way _sessions_title_ok pins it: under a UTF-8 locale ${#x}
# counts characters, and a 95-byte line of 55 characters passed a 60-byte cap.
_hook_line_fits() (
  LC_ALL=C
  [ "${#1}" -le "$_HOOK_LINE_MAX" ]
)

# Why an event was dropped, from _hook_translate_event's status.
_hook_drop_reason() {
  case "$1" in
    2) printf 'size' ;;
    4) printf 'name' ;;
    5) printf 'path' ;;
    *) printf 'json' ;;
  esac
}

# Rewrite one spool line into the event a host hook receives, or fail, in which
# case the event is DROPPED and counted. Property 5: the default is refuse.
# The status names the reason: 2 size, 3 not one JSON object, 4 event name,
# 5 a path that does not map.
_hook_translate_event() {
  _hook_translate_event_to "$1" "$2" || return $?
  printf '%s' "$_HOOK_EV_OUT"
}

# The same, with the event in _HOOK_EV_OUT and the directory its relative paths
# were judged from in _HOOK_EV_DIR, which is where the hook has to run. The
# bridge calls this form so the two cannot come from different computations.
_hook_translate_event_to() {
  local line="$1" ws="$2"
  local ev cands item cls val t repl="" repl_json="[]" base n=0 out
  local nl='
'
  _HOOK_EV_OUT=""
  _HOOK_EV_DIR=""
  command -v jq >/dev/null 2>&1 || return 3
  _hook_line_fits "$line" || return 2
  # Exactly one JSON value, and it is an object. The jq passes used to read
  # every value of their input, so `{...} {...}` validated the first object
  # and handed the hook both documents on stdin.
  printf '%s' "$line" | jq -e -n '[inputs] | length == 1 and (.[0] | type == "object")' >/dev/null 2>&1 || return 3
  # Every later pass reads the FIRST value only (`input`), so the check above is
  # the one place a second value is refused.
  ev="$(printf '%s' "$line" | jq -n -r 'input | .hook_event_name | if type == "string" then . else empty end' 2>/dev/null)" || return 3
  _hook_event_name_ok "$ev" || return 4
  case "$ws" in *"$nl"*) return 5 ;; esac

  # Pass one: the number of path fields, then every one of them on its own
  # line as <class><!|=><value>. A value holding a control character never
  # reaches this line-based loop, it is marked `!` and judged unmappable. The
  # count comes first so an event over upstream's ceiling is refused before a
  # single path is resolved. A filenames entry (L) is not counted, as upstream
  # leaves a response array out of its own count: a Grep over many files would
  # otherwise lose the whole event. Its cost is bounded by _HOOK_LIST_MAX.
  cands="$(printf '%s' "$line" | jq -n -r --argjson lmax "$_HOOK_LIST_MAX" "$_HOOK_JQ_CANDS"'
      input | [_hcands] | (map(select(.c != "L")) | length | tostring),
      (.[] | .c + (if (.v | type) != "string" or (.v | test("\\p{Cc}")) then "!" else "=" + .v end))' 2>/dev/null)" || return 3
  n="${cands%%"$nl"*}"
  case "$n" in ''|*[!0-9]*) return 3 ;; esac
  [ "$n" -le "$_HOOK_PATHS_MAX" ] || return 5
  cands="${cands#"$n"}"
  base="$ws"
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    cls="${item:0:1}"
    case "$item" in
      ?=*) val="${item#??}"; t="" ;;
      ?!*) val=""; t="bad" ;;
      *) return 3 ;;
    esac
    case "$cls" in
      C)
        [ -z "$t" ] || return 5
        _hook_translate_path_to "$val" "$ws" || return 5
        base="$_HOOK_TP_OUT"
        # A cwd that is not a directory here (the agent removed it, or the box
        # named one that never existed) cannot be entered, so the hook runs
        # from the workspace instead, the way upstream falls back to its launch
        # directory. The hook is told that directory, and every relative value
        # below is judged from it, so the check and the open still agree.
        [ -d "$base" ] || base="$ws"
        repl="${repl}T${base}${nl}"
        ;;
      D)
        [ -z "$t" ] || return 5
        _hook_translate_value "$val" "$ws" "$base" || return 5
        repl="${repl}${_HOOK_TV_OUT}${nl}"
        ;;
      N|L)
        if [ -z "$t" ] && _hook_translate_value "$val" "$ws" "$base"; then
          repl="${repl}${_HOOK_TV_OUT}${nl}"
        else
          repl="${repl}N${nl}"
        fi
        ;;
      *) return 5 ;;
    esac
  done <<EOF
$cands
EOF
  if [ -n "$repl" ]; then
    repl_json="$(printf '%s' "$repl" | jq -R -s -c 'split("\n") | map(select(length > 0))' 2>/dev/null)" || return 3
  fi

  # Pass two: write the translations back by position. The same definitions
  # enumerate the same candidates in the same order, and a count mismatch is a
  # refusal rather than a guess.
  #
  # transcript_path is a REQUIRED field on every event, and in a Cleat box it
  # lives under /home/coder/.claude/projects/-workspace/, which is never inside
  # /workspace. A naive "every path must resolve inside the project" rule
  # therefore fails EVERY event and no user hook ever runs again: the capability
  # becomes a no-op with a counter. That is why property 1 is a sentinel.
  out="$( { printf '%s\n' "$repl_json"; printf '%s' "$line"; } | jq -c -n \
      --argjson lmax "$_HOOK_LIST_MAX" \
      --arg sent "$_HOOK_TRANSCRIPT_SENTINEL" "$_HOOK_JQ_CANDS"'
        input as $r | input as $ev
      | [$ev | _hcands] as $cs
      | if ($r | length) != ($cs | length) then error("candidate count") else . end
      | reduce range(0; $cs | length) as $i ($ev;
          $r[$i] as $x
          | if ($x | startswith("T")) then setpath($cs[$i].p; $x[1:])
            elif $x == "N" then setpath($cs[$i].p; null)
            else . end)
      | _hlistcap
      | (if (.tool_calls | type) == "array" then .tool_calls |= map(if type == "object" then _hlistcap else . end) else . end)
      | (if has("transcript_path") then .transcript_path = $sent else . end)
      | (if has("agent_transcript_path") then .agent_transcript_path = $sent else . end)
      ' 2>/dev/null)" || return 3
  [ -n "$out" ] || return 3
  _HOOK_EV_OUT="$out"
  _HOOK_EV_DIR="$base"
  return 0
}

# Record a dropped event where the box cannot reach it and a teardown cannot
# delete it. NOT the clip dir (box-writable) and NOT the per-box run dir, which
# every cleat rm, recreate and nuke removes, and which the box can INDUCE the
# removal of: [resources] in a project .cleat is read with no trust gate, feeds
# the config fingerprint, and the resulting recreate prompt defaults to yes.
#
# Graded as telemetry, not as a boundary. It reduces attacker capability by
# zero. It is worth shipping because it turns "I think the agent did something
# to my Mac" into a diffable artifact.
#
# One tab-separated row: time, the mark, the reason (size, json, name or path),
# the box, the md5 of the raw spool line, its byte offset in the spool, and the
# first 200 characters of the line. The reason, box and offset are Cleat's own
# values. Only the line is box-authored. A `size` row is the exception for the
# md5: the bridge never holds an oversized line whole, so it hashes the first
# _HOOK_LINE_MAX + 1 bytes (1,044,481), which is all it read. The offset is how
# to find that line in the spool.
_hook_drop_log() {
  local reason="$1" line="$2" cname="${3:-}" off="${4:-}" f
  mkdir -p "$CLEAT_STATE_DIR" 2>/dev/null || return 0
  f="$CLEAT_STATE_DIR/hook-drops.log"
  [ -L "$f" ] && return 0
  # Everything from the line is box-authored, so it is collapsed to one line and
  # then sanitized before it is written, per concept/41 rule 2. Two steps on two
  # lines rather than one nested expansion: the collapse stops a forged payload
  # writing its own extra log rows, the sanitize strips the control bytes, and
  # each is separately mutable.
  local _safe
  _safe="$(printf '%s' "${line:0:200}" | tr '\n\r\t' '   ')"
  _safe="$(_sanitize_repo_str "$_safe")"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo unknown)" \
    "$_HOOK_DROP_MARK" \
    "$reason" \
    "$cname" \
    "$(_hook_line_md5 "$line")" \
    "$off" \
    "$_safe" >> "$f" 2>/dev/null || true
  return 0
}

# The md5 of a raw spool line, the hash alone whichever tool produced it.
_hook_line_md5() {
  local h
  h="$(printf '%s' "$1" | _md5 2>/dev/null)" || h=""
  printf '%s' "${h%% *}"
}

# Record an event that PASSED validation and was handed to the user's hooks,
# beside the drop log and for the same reason: the drop log alone shows what
# was refused and never what ran, so it could not answer "which box event ran
# my hook at 14:02". One row: time, the mark, the box, the event name, the tool
# name, the md5 of the raw spool line and its byte offset. The event name is
# already charset-checked. The tool name is box-authored: @tsv escapes its tab,
# newline and carriage return, so it cannot open a second row, and it is capped
# and sanitized for every other control byte. A hook whose matcher does not
# match still gets a row: this records the hand-over, not the match.
#
# Unlike the drop log it grows with every tool call the agent makes, so every
# _HOOK_RUN_LOG_EVERY rows it is checked and moved to hook-runs.log.1 past
# _HOOK_RUN_LOG_MAX. No report reads it, so a rotation loses no count.
_hook_run_log() {
  local ev_json="$1" line="$2" cname="${3:-}" off="${4:-}" f fields ev tool sz tab
  tab="$(printf '\t')"
  mkdir -p "$CLEAT_STATE_DIR" 2>/dev/null || return 0
  f="$CLEAT_STATE_DIR/hook-runs.log"
  [ -L "$f" ] && return 0
  _HOOK_RUN_LOG_N=$(( _HOOK_RUN_LOG_N + 1 ))
  if [ $(( (_HOOK_RUN_LOG_N - 1) % _HOOK_RUN_LOG_EVERY )) -eq 0 ] && [ -f "$f" ]; then
    sz="$(wc -c < "$f" 2>/dev/null | tr -d '[:space:]')"
    case "$sz" in ''|*[!0-9]*) sz=0 ;; esac
    if [ "$sz" -gt "$_HOOK_RUN_LOG_MAX" ]; then
      mv -f "$f" "$f.1" 2>/dev/null || true
    fi
  fi
  fields="$(printf '%s' "$ev_json" | jq -r '[(.hook_event_name // "" | tostring), (.tool_name // "" | tostring)] | @tsv' 2>/dev/null)" || fields=""
  ev="${fields%%"$tab"*}"
  tool="${fields#*"$tab"}"
  [ "$tool" != "$fields" ] || tool=""
  tool="$(_sanitize_repo_str "${tool:0:64}")"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo unknown)" \
    "$_HOOK_RUN_MARK" \
    "$cname" \
    "$(_sanitize_repo_str "${ev:0:64}")" \
    "$tool" \
    "$(_hook_line_md5 "$line")" \
    "$off" >> "$f" 2>/dev/null || true
  return 0
}

_execute_host_hooks() {
  local event_json="$1"
  shift
  local settings_files=("$@")

  local event_name
  event_name="$(echo "$event_json" | jq -r '.hook_event_name // empty' 2>/dev/null)" || return 0
  [[ -n "$event_name" ]] || return 0

  # Get the tool name for matcher support
  local tool_name
  tool_name="$(echo "$event_json" | jq -r '.tool_name // empty' 2>/dev/null)" || true

  # Process hooks from the settings files the bridge was handed. That is
  # ~/.claude/settings.json and nothing else (see _HOOK_HOST_SETTINGS): the two
  # project files sit inside the read-write /workspace mount, so a command read
  # from either would be a command the box wrote.
  #
  # $event_name arrives from the container: it is a field of a line the box
  # appended to the forwarding spool, which is bind-mounted read-write when the
  # cap is on. It is DATA, so it goes in through --arg and is indexed with
  # .hooks[$ev]. It must never be pasted into the jq program text. The old form
  # built `.hooks."$event_name" // [] | .[]` by interpolation, so an event name
  # carrying a double quote rewrote the program: `X" // [{"hooks":[{"type":
  # "command","command":"..."}]}] // "` returned an attacker-authored hook entry
  # no matter what the user's settings said, and the loop below then ran that
  # command on the HOST. Enabling the cap is a decision to run YOUR hooks on
  # your machine; it is not a decision to let the box choose the command.
  # --arg is also plain more correct: the dot form mis-parses a legitimate event
  # name containing a dot or a dash.
  local settings
  for settings in "${settings_files[@]}"; do
    local hook_entries
    hook_entries="$(jq -c --arg ev "$event_name" '.hooks[$ev] // [] | .[]' "$settings" 2>/dev/null)" || continue
    [[ -n "$hook_entries" ]] || continue

    while IFS= read -r entry; do
      [[ -n "$entry" ]] || continue

      # Check matcher (regex against tool_name for tool events).
      #
      # `echo "$tool_name" | grep -qE` matches per LINE, so a tool_name of
      # "Write\nBash" satisfied an ANCHORED matcher of ^Bash$ while every other
      # field of the payload described a Write. Anchoring was therefore not a
      # constraint at all, which is not recorded in concept/11 and should be.
      # A tool name is one token: reject a multi-line one outright and match the
      # single line, so an anchor means what the user wrote.
      local matcher
      matcher="$(echo "$entry" | jq -r '.matcher // empty' 2>/dev/null)" || true
      if [[ -n "$matcher" && -n "$tool_name" ]]; then
        case "$tool_name" in
          *$'\n'*|*$'\r'*) continue ;;
        esac
        printf '%s' "$tool_name" | grep -qE "$matcher" 2>/dev/null || continue
      fi

      # Execute each command hook in the entry
      while IFS= read -r hook; do
        [[ -n "$hook" ]] || continue
        local cmd
        cmd="$(echo "$hook" | jq -r '.command // empty' 2>/dev/null)" || continue
        [[ -n "$cmd" ]] || continue

        # Execute on the host with event JSON on stdin. The timeout is now per
        # event rather than a flat 30s, matching Claude Code's own values for
        # its own hooks: a Stop hook that formats a large repo legitimately
        # takes minutes, and a PreToolUse hook that takes 30 seconds has
        # already wedged the turn.
        # _run_bounded keeps the bound on a stock macOS, which has no
        # timeout(1) and used to run every hook unbounded.
        local _hto
        _hto="$(_hook_timeout_for "$event_name")"
        echo "$event_json" | _run_bounded "$_hto" bash -c "$cmd" >/dev/null 2>&1 || true
      done < <(echo "$entry" | jq -c '.hooks // [] | .[] | select(.type == "command")' 2>/dev/null)
    done <<< "$hook_entries"
  done
}

# Block until the container's entrypoint has finished remapping the `coder`
# user from the image-baked UID to the host UID, before we exec a session into
# it. `docker exec` works the instant PID 1 exists, which can be BEFORE the
# entrypoint rewrites /etc/passwd. If we exec into that window, `runuser -u
# coder` resolves the STALE uid, so clip-daemon and claude run as the wrong
# user: claude can't write its host-owned config/auth (it hangs), and clip-daemon
# stamps its runtime files with the wrong owner, which later, correctly-mapped
# sessions can't clean from the sticky /tmp (the historical clip-EPERM storm).
# Best-effort gate: a running container's `id -u coder` is always numeric, so an
# empty/non-numeric reply means "can't determine" (broken exec) and we proceed
# rather than stall; a valid-but-mismatched uid means the remap is still in
# flight, so we keep polling (up to 50 probes).
_wait_for_coder_remap() {
  local cname="$1" want got i=0
  want="$(id -u)"
  while [ "$i" -lt 50 ]; do
    got="$(docker exec "$cname" id -u coder 2>/dev/null)"
    case "$got" in
      ''|*[!0-9]*) return 0 ;;
    esac
    [ "$got" = "$want" ] && return 0
    i=$((i + 1))
    sleep 0.1
  done
  return 0
}

# Docker-capability session-start hardening (see concept/15-docker-capability.md).
# _heal_docker_sock: re-resolve the docker.sock owning GID and re-add coder to
# that group, AS ROOT, before each session exec. The entrypoint does this once
# at container start, but a Docker Desktop restart / daemon update can change the
# socket GID under a long-running (days-of-uptime) container, and a bare
# `docker exec` never re-runs the entrypoint, so `cleat`/`cleat shell` then fail
# with "permission denied /var/run/docker.sock". Inlined (not a baked image
# script) so it heals already-running containers without a rebuild; the following
# `runuser -u coder` re-runs initgroups and picks up the new group. Idempotent:
# groupmod re-points docker-host across GID changes instead of accreting groups.
_heal_docker_sock() {
  local cname="$1" _to=""
  command -v timeout >/dev/null 2>&1 && _to="timeout 10"
  $_to docker exec -u 0 "$cname" sh -c '
    [ -S /var/run/docker.sock ] || exit 0
    g=$(stat -c %g /var/run/docker.sock 2>/dev/null) || exit 0
    case "$g" in ""|*[!0-9]*) exit 0 ;; esac
    [ "$g" = "$(id -g coder)" ] && exit 0
    owner=$(getent group "$g" | cut -d: -f1)
    if [ -z "$owner" ]; then
      if getent group docker-host >/dev/null 2>&1; then groupmod -g "$g" docker-host 2>/dev/null || true
      else groupadd -g "$g" docker-host 2>/dev/null || true; fi
      owner=$(getent group "$g" | cut -d: -f1)
    fi
    [ -n "$owner" ] && usermod -aG "$owner" coder 2>/dev/null || true
  ' >/dev/null 2>&1 || true
}

# Ensure the docker cap can reach the daemon before a session. No-op unless the
# docker cap is active. Runs the per-exec GID self-heal, then probes as root: if
# even root can't reach the daemon, the socket bind is a stale inode (Docker
# replaced /var/run/docker.sock under the running container): no group fix can
# repair that in place, so guide the user to the re-bind recovery rather than
# silently failing. We do NOT auto-restart: a restart would kill any live
# session sharing this container.
_ensure_docker_access() {
  local cname="$1"
  cap_is_active docker 2>/dev/null || return 0
  _heal_docker_sock "$cname"
  local _to=""
  command -v timeout >/dev/null 2>&1 && _to="timeout 8"
  if ! $_to docker exec -u 0 "$cname" docker version >/dev/null 2>&1; then
    warn "Docker socket unreachable in this container ${DIM}(the daemon likely restarted)${RESET}"
    echo -e "    ${DIM}A stale socket bind can't be repaired in place. Recover with:${RESET}"
    echo -e "    ${BOLD}cleat stop && cleat resume${RESET}${DIM}  re-binds the socket; your session is preserved.${RESET}"
  fi
}

# Run a project's [setup] provisioning inside its box, once per container
# (see _build_setup_payload / concept/16). Never blocks a session: any skip
# or failure is a warn/info, and the function always returns 0. Sets
# _SETUP_LAST_RC (0 on success or any skip, the payload's own exit code on a
# failed run) so the explicit `cleat setup` verb can propagate a real exit
# status; every session caller (cmd_run/cmd_start/cmd_resume/cmd_claude)
# ignores it.
# $1 = container name, $2 = project path, $3 = box (default main), $4 =
# force (default 0; "1" bypasses the run-once marker, used only by the
# explicit `cleat setup` verb so the user can deliberately re-run).
_maybe_run_setup() {
  local cname="$1" project="$2" box="${3:-main}" force="${4:-0}"
  _SETUP_LAST_RC=0
  [[ "${_SETUP_DECLARED:-0}" == "1" ]] || return 0
  [[ "${_SETUP_TRUSTED:-0}" == "1" ]] || return 0  # resolve_caps already messaged any skip
  is_running "$cname" || return 0

  # A single invocation can reach this twice for one container: cmd_start's
  # stale-mount branch recreates via cmd_run (which runs setup) then falls
  # through to cmd_start's own post-start call. A success writes the marker
  # so the second call is a silent no-op, but a FAILED run leaves no marker,
  # so without this guard the failing payload would run and warn twice. The
  # explicit verb (force=1) always runs.
  if [[ "$force" != "1" ]]; then
    case "$_SETUP_ATTEMPTED" in
      *"|$cname|"*) return 0 ;;
    esac
  fi

  # TOCTOU close: rebuild the payload from disk right now and re-hash it, so
  # the bytes that run are byte-identical to what was approved, never a
  # rewrite an in-box agent made to /workspace/.cleat between approval (in
  # resolve_caps, earlier in this invocation) and this exec.
  local payload
  payload="$(_build_setup_payload "$project" "$box")" || {
    # _build_setup_payload already warned about the specific bad directive.
    warn "Project [setup] is invalid, skipped ${DIM}(run a cleat command again to review)${RESET}"
    return 0
  }
  [[ -z "$payload" ]] && return 0

  local hash stored
  hash="$(_setup_payload_hash "$payload")"
  stored="$(_trust_lookup_setup "$project" "$box")"
  [[ "$hash" == "$stored" ]] || {
    warn "Project [setup] changed since it was approved, skipped ${DIM}(run a cleat command again to review and approve)${RESET}"
    return 0
  }

  # Run-once marker, in-container. The explicit `cleat setup` verb (force=1)
  # bypasses this so the user can deliberately re-run.
  if [[ "$force" != "1" ]]; then
    local marker
    marker="$(docker exec "$cname" cat /home/coder/.cleat-setup-applied 2>/dev/null || true)"
    [[ "$marker" == "$hash" ]] && return 0
  fi

  _wait_for_coder_remap "$cname"
  _SETUP_ATTEMPTED="${_SETUP_ATTEMPTED}|$cname|"

  local caps_file count
  caps_file="$(_project_caps_file "$project")"
  count="$(_read_setup_from_file "$caps_file" "$box" | wc -l | tr -d ' ')"
  info "Running project setup ${DIM}(${count} command(s), [setup] in $(basename "$caps_file"))${RESET}"

  # Stage the payload into a file in the box, then run that file rather than
  # feeding it on stdin. Two reasons, both about correctness of the exit
  # code: (1) a setup command that itself reads stdin (ssh, apt without -y,
  # any `read`) would otherwise swallow the rest of the script off the same
  # pipe; (2) a large payload where the in-box bash exits before draining
  # the pipe would SIGPIPE the feeder, and pipefail would report that 141 as
  # the run's status even on success. The run exec omits -i so the script's
  # stdin is closed (EOF), decoupling command stdin from the script source.
  # `runuser -u coder` (not docker exec --user): see exec_claude's rationale
  # (--user skips initgroups(3), so supplementary groups never load).
  local runfile="/home/coder/.cleat-setup.run"
  docker exec "$cname" runuser -u coder -- rm -f "$runfile" >/dev/null 2>&1 || true
  printf '%s' "$payload" | docker exec -i "$cname" runuser -u coder -- tee "$runfile" >/dev/null 2>&1 || true
  local rc=0
  docker exec -e HOME=/home/coder -w /workspace "$cname" \
    runuser -u coder -- bash -e "$runfile" || rc=$?
  docker exec "$cname" runuser -u coder -- rm -f "$runfile" >/dev/null 2>&1 || true

  if [[ $rc -eq 0 ]]; then
    printf '%s\n' "$hash" | docker exec -i "$cname" runuser -u coder -- tee /home/coder/.cleat-setup-applied >/dev/null 2>&1 || true
    success "Setup applied ${DIM}(${count} command(s))${RESET}"
  else
    warn "Setup failed with exit code ${rc} ${DIM}(the box is up, provisioning did not finish)${RESET}"
    echo -e "    ${DIM}Fix .cleat or the box, then retry with: cleat setup${RESET}"
    _SETUP_LAST_RC="$rc"
  fi
  return 0
}

# ── Live switch: state both terminals read ───────────────────────────────────
# Host-only markers and tickets under $CLEAT_RUN_DIR/<cname> that a switch in
# one terminal and an attach or relaunch in another read to stay in step. Only
# the auth/ subdir of a box run dir is ever bind-mounted, so none of these paths
# reaches inside the box: they carry no secret and the box cannot forge one. See
# concept/44 and section 5.2 of the handover.

# A per-attach id, lowercase hex so two ids never differ only by case on APFS.
# The pid, the epoch and one 16-bit random word give 13 to 18 hex digits, always
# inside _handoff_id_ok's 12-to-32 range. Terminal 1 stamps it into its attach
# marker and its exec environment so a probe in terminal 2 can tie a live
# session to the marker that owns it.
_exec_claude_new_exec_id() {
  printf '%x%x%04x' "$$" "$(date +%s)" "$RANDOM"
}

# True for a validated exec id: 12 to 32 lowercase hex digits, nothing else.
_handoff_id_ok() {
  case "${1:-}" in
    ''|*[!0-9a-f]*) return 1 ;;
  esac
  [[ ${#1} -ge 12 && ${#1} -le 32 ]]
}

# _handoff_marker_read FILE: read a .attached.<pid> marker and set _HM_KIND
# (claude|shell) and _HM_EXEC. It accepts exactly `kind=claude exec=<id-or-empty>`
# or `kind=shell`. Anything else, an older cleat's empty marker included, reads
# as kind=shell, which fails closed for both the starting and the shell-open
# checks. A symlink or odd node is never followed, it just reads as shell.
_handoff_marker_read() {
  local f="$1" line=""
  _HM_KIND="shell"; _HM_EXEC=""
  [[ -e "$f" ]] || return 1
  if [[ -L "$f" || ! -f "$f" ]]; then
    return 0
  fi
  IFS= read -r line 2>/dev/null < "$f" || true
  line="${line:0:200}"
  if [[ "$line" == "kind=shell" ]]; then
    return 0
  fi
  case "$line" in
    "kind=claude exec="*)
      local id="${line#kind=claude exec=}"
      if [[ -z "$id" ]] || _handoff_id_ok "$id"; then
        _HM_KIND="claude"; _HM_EXEC="$id"
        return 0
      fi
      ;;
  esac
  _HM_KIND="shell"; _HM_EXEC=""
  return 0
}

# _handoff_marker_live_for_exec CNAME EXECID: true when a live .attached.<pid>
# marker (its filename pid answers kill -0) reads kind=claude with that exec id.
_handoff_marker_live_for_exec() {
  local cname="$1" want="$2" rd m pid
  [[ -n "$want" ]] || return 1
  rd="$CLEAT_RUN_DIR/$cname"
  for m in "$rd"/.attached.*; do
    [[ -e "$m" ]] || continue
    pid="${m##*/.attached.}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    _handoff_marker_read "$m" || continue
    [[ "$_HM_KIND" == "claude" && "$_HM_EXEC" == "$want" ]] && return 0
  done
  return 1
}

# _handoff_starting_markers CNAME [EXECID...]: print the pid of every live
# kind=claude marker younger than _HANDOFF_STARTING_MAX_S whose exec id is not
# one of the EXECIDs the caller already accounted for (an empty exec id matches
# none, so it always counts as starting). Returns 0 when it printed at least one.
# The offline switch passes no EXECIDs, so any such marker refuses there; the
# live handoff passes its probe's ids so its own live sessions do not count.
_handoff_starting_markers() {
  local cname="$1"; shift
  local rd m pid mt age now e skip found=0
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  rd="$CLEAT_RUN_DIR/$cname"
  for m in "$rd"/.attached.*; do
    [[ -e "$m" ]] || continue
    pid="${m##*/.attached.}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    _handoff_marker_read "$m" || continue
    [[ "$_HM_KIND" == "claude" ]] || continue
    mt="$(_path_mtime "$m")"
    age=$(( now - mt ))
    [[ $age -ge 0 && $age -le $_HANDOFF_STARTING_MAX_S ]] || continue
    skip=0
    for e in "$@"; do
      [[ -n "$_HM_EXEC" && "$_HM_EXEC" == "$e" ]] && { skip=1; break; }
    done
    [[ $skip -eq 1 ]] && continue
    printf '%s\n' "$pid"
    found=1
  done
  [[ $found -eq 1 ]]
}

# _handoff_shell_open CNAME: true when a live marker does not read as kind=claude
# (a cleat shell, or any unparseable marker which fails closed to shell). No age
# bound: a shell can sit open indefinitely.
_handoff_shell_open() {
  local cname="$1" rd m pid
  rd="$CLEAT_RUN_DIR/$cname"
  for m in "$rd"/.attached.*; do
    [[ -e "$m" ]] || continue
    pid="${m##*/.attached.}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    _handoff_marker_read "$m"
    [[ "$_HM_KIND" == "claude" ]] && continue
    return 0
  done
  return 1
}

_handoff_ticket_clear() { _HT_STATE=""; _HT_BY=""; _HT_AT=""; _HT_SID=""; _HT_TO=""; }

# _handoff_ticket_read FILE: parse a .handoff.<execid> ticket and set _HT_STATE
# _HT_BY _HT_AT _HT_SID _HT_TO. Requires a regular non-symlink file, v=1, a state
# of requested or ready, a `by` that is a plausible pid (^[1-9][0-9]{0,9}$) other
# than 1, an `at` of 1 to 12 digits no more than 5 s ahead of now, a UUID sid and
# a `to` that validates or is the default sentinel. Anything else reads as absent
# (return 1), so kill -0 never sees an unvalidated by such as 0 or a group.
_handoff_ticket_read() {
  local f="$1" k v ver="" now
  _handoff_ticket_clear
  [[ -f "$f" && ! -L "$f" ]] || return 1
  while IFS='=' read -r k v || [[ -n "$k" ]]; do
    case "$k" in
      v)     ver="$v" ;;
      state) _HT_STATE="$v" ;;
      by)    _HT_BY="$v" ;;
      at)    _HT_AT="$v" ;;
      sid)   _HT_SID="$v" ;;
      to)    _HT_TO="$v" ;;
    esac
  done < "$f"
  [[ "$ver" == "1" ]] || { _handoff_ticket_clear; return 1; }
  case "$_HT_STATE" in requested|ready) : ;; *) _handoff_ticket_clear; return 1 ;; esac
  case "$_HT_BY" in ''|0*|*[!0-9]*) _handoff_ticket_clear; return 1 ;; esac
  { [[ ${#_HT_BY} -le 10 && "$_HT_BY" != "1" ]]; } || { _handoff_ticket_clear; return 1; }
  case "$_HT_AT" in ''|*[!0-9]*) _handoff_ticket_clear; return 1 ;; esac
  [[ ${#_HT_AT} -le 12 ]] || { _handoff_ticket_clear; return 1; }
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  [[ $(( _HT_AT - now )) -le 5 ]] || { _handoff_ticket_clear; return 1; }
  _sessions_is_uuid "$_HT_SID" || { _handoff_ticket_clear; return 1; }
  if [[ "$_HT_TO" != "$_ACCOUNT_DEFAULT" ]] && ! _validate_account_name "$_HT_TO"; then
    _handoff_ticket_clear; return 1
  fi
  return 0
}

# _handoff_ticket_write CNAME EXECID STATE SID TO: write one ticket atomically
# (mktemp in the same dir, chmod 600, mv -f). by is this shell, at is now.
_handoff_ticket_write() {
  local cname="$1" execid="$2" state="$3" sid="$4" to="$5" rd tmp now
  _handoff_id_ok "$execid" || return 1
  case "$state" in requested|ready) : ;; *) return 1 ;; esac
  rd="$CLEAT_RUN_DIR/$cname"
  mkdir -p "$rd" 2>/dev/null || return 1
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  tmp="$(mktemp "$rd/.handoff-tmp.XXXXXX" 2>/dev/null)" || return 1
  if ! {
        printf 'v=1\n'
        printf 'state=%s\n' "$state"
        printf 'by=%s\n' "$$"
        printf 'at=%s\n' "$now"
        printf 'sid=%s\n' "$sid"
        printf 'to=%s\n' "$to"
      } > "$tmp" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$rd/.handoff.$execid" 2>/dev/null || { rm -f "$tmp" 2>/dev/null || true; return 1; }
  return 0
}

# _handoff_tickets_requested_live CNAME: true when a live-writer `requested`
# ticket of the box exists (4.1 row 4, the attach gate's own half).
_handoff_tickets_requested_live() {
  local cname="$1" rd f now age
  rd="$CLEAT_RUN_DIR/$cname"
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  for f in "$rd"/.handoff.*; do
    [[ -e "$f" ]] || continue
    _handoff_ticket_read "$f" || continue
    age=$(( now - _HT_AT ))
    [[ $age -ge 0 && $age -le $_HANDOFF_READY_MAX_AGE_S ]] || continue
    [[ "$_HT_STATE" == "requested" ]] || continue
    kill -0 "$_HT_BY" 2>/dev/null && return 0
  done
  return 1
}

# _handoff_tickets_pending CNAME: true when a ticket of the box is still holding
# a reopen. A `requested` ticket is pending while its writer lives. A `ready`
# ticket is pending while the marker with its exec id has a live pid and its sid
# is not already back in the caller's live probe set (_HO_SID). A caller with no
# probe (cleat account rm) has an empty _HO_SID, so any live `ready` ticket is
# pending whatever its sid.
_handoff_tickets_pending() {
  local cname="$1" rd f now age execid s in_probe
  rd="$CLEAT_RUN_DIR/$cname"
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  for f in "$rd"/.handoff.*; do
    [[ -e "$f" ]] || continue
    _handoff_ticket_read "$f" || continue
    age=$(( now - _HT_AT ))
    [[ $age -ge 0 && $age -le $_HANDOFF_READY_MAX_AGE_S ]] || continue
    if [[ "$_HT_STATE" == "requested" ]]; then
      kill -0 "$_HT_BY" 2>/dev/null && return 0
      continue
    fi
    execid="${f##*/.handoff.}"
    _handoff_marker_live_for_exec "$cname" "$execid" || continue
    in_probe=0
    for s in ${_HO_SID[@]+"${_HO_SID[@]}"}; do
      [[ "$s" == "$_HT_SID" ]] && { in_probe=1; break; }
    done
    [[ $in_probe -eq 0 ]] && return 0
  done
  return 1
}

# _handoff_tickets_sweep CNAME: drop tickets that no longer parse, whose exec id
# has no live marker, or whose `at` is out of the age bound. Run only under the
# account lock, right before a ticket write.
_handoff_tickets_sweep() {
  local cname="$1" rd f now age execid
  rd="$CLEAT_RUN_DIR/$cname"
  [[ -d "$rd" ]] || return 0
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  for f in "$rd"/.handoff.*; do
    [[ -e "$f" ]] || continue
    if ! _handoff_ticket_read "$f"; then
      rm -f "$f" 2>/dev/null || true
      continue
    fi
    age=$(( now - _HT_AT ))
    if [[ $age -lt 0 || $age -gt $_HANDOFF_READY_MAX_AGE_S ]]; then
      rm -f "$f" 2>/dev/null || true
      continue
    fi
    execid="${f##*/.handoff.}"
    _handoff_marker_live_for_exec "$cname" "$execid" || rm -f "$f" 2>/dev/null || true
  done
  return 0
}

# _handoff_flag_identity_stale PROJECT BOX: touch the batch-11 stale-identity
# flag beside the box's per-project claude.json (H9). Written before the pin
# moves, so a relaunch that reads the new pin never reads the old account name.
# Best effort: a box with no project dir yet has nothing to flag.
_handoff_flag_identity_stale() {
  local project="$1" box="$2" key f
  [[ -n "$project" ]] || return 0
  key="$(_derive_project_session_key "$project" "$box")" || return 0
  _account_session_key_ok "$key" || return 0
  f="$CLEAT_PROJECTS_DIR/${key}/claude.json"
  # The directory check comes first because a failed redirect reports itself
  # before `2>/dev/null` applies: a never-started box printed a raw bash error
  # above the switch's own success line.
  [[ -d "${f%/*}" ]] || return 0
  : > "${f}.identity-stale" 2>/dev/null || true
  return 0
}

# _account_attach_gate CNAME BOX CMDWORD: wait for a switch of this box to finish
# before the caller reads the pin. Taking and releasing the account lock is the
# whole gate: a switch holds it from its ticket write through the rename, so the
# attach either runs first (and the switch then sees its marker) or waits and
# reads the pin the switch left. Only when the lock stays busy past P2's wait AND
# a requested ticket of THIS box has a live writer does it refuse: that is a
# switch of this very box still running, where reading the pin now could land the
# session on the login the switch is replacing. Busy for any other reason (another
# box's switch, a nuke, an rm) is P2's fail-safe and the attach goes on.
_account_attach_gate() {
  local rc=0
  _account_settle "$1" || rc=$?
  if [[ $rc -eq $_ACCOUNT_LOCK_BUSY ]] && _handoff_tickets_requested_live "$1"; then
    _handoff_say R-switching "$2" "$3"
    return 1
  fi
  return 0
}

# ── Live switch: terminal 1 state and prepare (M3) ───────────────────────────
# The helpers terminal 1's relaunch loop reaches: which argv shapes may be
# reopened, the store-variable pair edit, the pin the exec really gets, the once
# -per-exec prepare, the wait on terminal 2's ticket and the typeahead drain.
# All host-only: none ships into a box.

# True only for the exact argv shapes a relaunch can rebuild without dropping a
# flag the user gave: --dangerously-skip-permissions alone, or followed by
# --continue, --resume <uuid>, or --resume <uuid> --model <m> with m carrying
# the [1m] suffix. Anything else is not relaunchable, so exec_claude stamps no
# exec id and the session reads as R-foreign to a switch in another terminal.
_exec_claude_argv_relaunchable() {
  local re_uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  local re_model='^claude-[a-z0-9.-]+\[1m\]$'
  [[ "${1:-}" == "--dangerously-skip-permissions" ]] || return 1
  shift
  [[ $# -ge 1 ]] || return 0
  case "$1" in
    --continue)
      [[ $# -eq 1 ]] || return 1
      return 0
      ;;
    --resume) : ;;
    *) return 1 ;;
  esac
  shift
  [[ $# -ge 1 ]] || return 1
  [[ "$1" =~ $re_uuid ]] || return 1
  shift
  [[ $# -ge 1 ]] || return 0
  [[ "$1" == "--model" ]] || return 1
  shift
  [[ $# -eq 1 ]] || return 1
  [[ "$1" =~ $re_model ]] || return 1
  return 0
}

# Drop the store variable from CLAUDE_ENV as a `-e VALUE` PAIR. Dropping only
# the value would leave a bare `-e` that swallows the next argument. Called at
# the top of every prepare so a re-prepare on a relaunch never leaves two
# CLAUDE_SECURESTORAGE_CONFIG_DIR pairs (the applier appends a fresh one).
_claude_env_drop_store() {
  local i=0 n=${#CLAUDE_ENV[@]} out=()
  while [[ $i -lt $n ]]; do
    if [[ "${CLAUDE_ENV[$i]}" == "-e" && $(( i + 1 )) -lt $n \
          && "${CLAUDE_ENV[$(( i + 1 ))]}" == CLAUDE_SECURESTORAGE_CONFIG_DIR=* ]]; then
      i=$(( i + 2 )); continue
    fi
    out+=("${CLAUDE_ENV[$i]}"); i=$(( i + 1 ))
  done
  CLAUDE_ENV=("${out[@]+"${out[@]}"}")
}

# The account the exec REALLY runs as: default when CLAUDE_ENV carries no store
# variable (a box with no mount runs on the shared login even when pinned), else
# the box pin. So the seed and the T1 line follow the environment, not the pin.
_claude_env_store_pin() {
  local cname="$1" e
  for e in "${CLAUDE_ENV[@]+"${CLAUDE_ENV[@]}"}"; do
    case "$e" in CLAUDE_SECURESTORAGE_CONFIG_DIR=*) _box_account_read "$cname"; return 0 ;; esac
  done
  printf '%s' "$_ACCOUNT_DEFAULT"
}

# The account block that used to sit once above the watchers, now run right
# before every exec (O3): drop any stale store pair, stage and pin the account
# env, seed the macOS Keychain only for a shared-login run, heal the box's
# claude.json (which also retries a switch's H9 identity flag). Sets _EC_PINNED
# to the pin the exec gets, for the T1 reopen line.
_exec_claude_prepare_account() {
  local cname="$1"
  _claude_env_drop_store
  _account_apply_exec_env "$cname" || true
  _EC_PINNED="$(_claude_env_store_pin "$cname")"
  if [[ "$_EC_PINNED" == "$_ACCOUNT_DEFAULT" ]]; then
    _seed_macos_credentials
  fi
  _refresh_attached_claude_json "$cname" "${_RESOLVED_PROJECT:-}" "${_BOX:-main}"
  return 0
}

# Render an account name as it reads in a sentence: "account foo", or "your
# shared login" for the default sentinel. Shared by the T lines here and the
# _handoff_say catalogue.
_handoff_acct_phrase() {
  if [[ "$1" == "$_ACCOUNT_DEFAULT" ]]; then printf 'your shared login'; else printf 'account %s' "$1"; fi
}

# The T1/T1b reopen line, then T-limit. TO is the ticket's account, FLAGS is the
# `L A` _handoff_tail_flags read from the transcript before the relaunch. The pin
# is _EC_PINNED, set by the prepare this iteration, so it names the login the
# relaunch really uses, never the ticket's target. No dialog hint: the reopen
# suppresses the resume-from-summary dialog (_HANDOFF_RESUME_THRESHOLD_MIN).
_handoff_say_t1() {
  local to="$1" flags="$2" pin="$_EC_PINNED" who="" phrase L A
  phrase="$(_handoff_acct_phrase "$pin")"
  if [[ "$pin" == "$to" ]]; then
    if [[ "$pin" != "$_ACCOUNT_DEFAULT" ]]; then
      who="$(_account_meta_get "$pin" who 2>/dev/null || true)"
      # Rendered through echo -e like every other print of the stored name, so
      # control bytes are dropped and backslashes doubled first.
      who="$(_sessions_safe_str "$who")"
    fi
    if [[ -n "$who" ]]; then
      info "Reopening this conversation on ${phrase} ${DIM}(${who})${RESET}"
    else
      info "Reopening this conversation on ${phrase}"
    fi
  else
    warn "The switch to $(_handoff_acct_phrase "$to") did not finish. Reopening this conversation on ${phrase}."
  fi
  set -- $flags
  L="${1:-0}"; A="${2:-0}"
  if [[ "$L" == "1" ]]; then
    if [[ "$A" == "1" ]]; then
      echo -e "    ${DIM}The usage limit lines in it are from before the restart. Nothing is scheduled.${RESET}"
    else
      echo -e "    ${DIM}The usage limit lines in it are from before the restart.${RESET}"
    fi
  fi
}

# Wait, in the CURRENT shell, for terminal 2's ticket to reach `ready`. Never
# call in $(...): a subshell resets the flag trap. Sets _HANDOFF_T1_STATE
# (ready|interrupted|unfinished) and, through the caller's _ec_to, the ticket's
# target. Prints T0 once while the ticket reads `requested` with a live writer.
# A dead writer, a vanished, malformed, too-old ticket, a failed sid or 60 s all
# end the wait as unfinished. A raised _EC_INT (the flag trap) ends it as
# interrupted. Keeps the flag trap in place so Ctrl-C still stops the wait.
_handoff_t1_await() {
  local t="$1" start said=0 now
  trap '_EC_INT=1' INT TERM HUP
  start=$SECONDS
  while :; do
    if [[ "$_EC_INT" == "1" ]]; then _HANDOFF_T1_STATE=interrupted; break; fi
    if ! _handoff_ticket_read "$t"; then _HANDOFF_T1_STATE=unfinished; break; fi
    _ec_to="$_HT_TO"
    now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
    if [[ $(( now - _HT_AT )) -gt $_HANDOFF_READY_MAX_AGE_S ]]; then _HANDOFF_T1_STATE=unfinished; break; fi
    case "$_HT_STATE" in
      ready) _HANDOFF_T1_STATE=ready; break ;;
      requested)
        if ! kill -0 "$_HT_BY" 2>/dev/null; then _HANDOFF_T1_STATE=unfinished; break; fi
        if [[ $said -eq 0 ]]; then said=1; _handoff_say T0 "$_HT_TO"; fi
        ;;
    esac
    if [[ $(( SECONDS - start )) -ge $_HANDOFF_T1_WAIT_S ]]; then _HANDOFF_T1_STATE=unfinished; break; fi
    _handoff_t1_pause || true
  done
  return 0
}

# Throw away what was typed during the wait. Neither Linux n_tty nor the BSD tty
# flushes pending input when docker's raw mode turns ICANON off, so a stray
# `continue` typed before the relaunch would otherwise be sent at once. Never
# `read -t 0`.
_handoff_drain_typeahead() {
  _is_interactive || return 0
  local saved
  saved="$(stty -g </dev/tty 2>/dev/null)" || return 0
  { stty -icanon min 0 time 0 && dd bs=4096 count=64 of=/dev/null 2>/dev/null; } </dev/tty 2>/dev/null || true
  stty "$saved" </dev/tty 2>/dev/null || true
  return 0
}

# The session ids of the box that are reopening after a switch: every ticket
# that parses, is within the age bound and whose exec id has a live kind=claude
# marker. cmd_resume adds these to its live set so it never reopens a
# conversation terminal 1 is about to relaunch (5.7).
_handoff_reopening_sids() {
  local cname="$1" rd f now age execid
  rd="$CLEAT_RUN_DIR/$cname"
  [[ -d "$rd" ]] || return 0
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  for f in "$rd"/.handoff.*; do
    [[ -e "$f" ]] || continue
    _handoff_ticket_read "$f" || continue
    age=$(( now - _HT_AT ))
    [[ $age -ge 0 && $age -le $_HANDOFF_READY_MAX_AGE_S ]] || continue
    execid="${f##*/.handoff.}"
    _handoff_marker_live_for_exec "$cname" "$execid" || continue
    printf '%s\n' "$_HT_SID"
  done
  return 0
}

# `L A` for a transcript tail: L=1 when the last conversation record is the 429
# rate-limit error, A=1 when an armed auto-continue record followed it. Read by
# terminal 1 after the kill and before the relaunch appends its own records.
_HANDOFF_TAIL_WINDOW=262144
_handoff_tail_flags() {
  local f="$1"
  [[ -f "$f" && ! -L "$f" ]] || { printf '0 0'; return 0; }
  tail -c "$_HANDOFF_TAIL_WINDOW" "$f" 2>/dev/null | LC_ALL=C awk '
    BEGIN { L=0; A=0 }
    /"isSidechain":true/ { next }
    /"type":"assistant"/ || /"type":"user"/ {
      if (index($0,"\"error\":\"rate_limit\"") && index($0,"\"isApiErrorMessage\":true")) { L=1; A=0 }
      else { L=0; A=0 }
      next
    }
    /"type":"system"/ {
      if (L==1 && index($0,"\"subtype\":\"informational\"") && index($0,"continuing automatically")) { A=1 }
      next
    }
    END { printf "%d %d", L, A }
  '
}

exec_claude() {
  local cname="$1"
  shift

  _CLIP_DIR="$CLEAT_RUN_DIR/${cname}/clip"
  _CLIP_WATCHER_PID=""
  _CLIPIMG_WATCHER_PID=""
  _BROWSER_WATCHER_PID=""
  _HOOK_BRIDGE_PID=""
  mkdir -p "$_CLIP_DIR"
  # Stamp this box's run dir with an ATTACH timestamp for the idle sweep's grace
  # gate. The dir's own mtime would otherwise freeze at creation (writes go into
  # the clip/ subdir, not the dir itself), so the grace would measure age-since
  # -creation, not idle-since-detach. _cleanup_session re-stamps it on detach, so
  # `now - mtime(run dir)` is the true time since the session last had a host
  # process. Fail-soft.
  touch "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true

  # A per-attach exec id and a content-bearing marker, written before any
  # account read (5.6). Only an interactive session running one of the
  # relaunchable argv shapes gets an id: a switch in another terminal ties a
  # live Claude to its marker by that id and reopens only what it can rebuild.
  # The attach gate and the account block that used to sit here move into the
  # loop below (O3), so they re-run before every relaunch, on the login
  # terminal 2 has just staged.
  local _ec_id="" _ec_marker="$CLEAT_RUN_DIR/${cname}/.attached.$$"
  if _is_interactive && _exec_claude_argv_relaunchable "$@"; then
    _ec_id="$(_exec_claude_new_exec_id)"
  fi
  printf 'kind=claude exec=%s\n' "$_ec_id" > "$_ec_marker" 2>/dev/null || true

  _cleanup_session() {
    # Kill clipboard watcher
    if [ -n "${_CLIP_WATCHER_PID:-}" ]; then
      kill "$_CLIP_WATCHER_PID" 2>/dev/null || true
      # A TERM is deferred while the watcher sits blocked in its foreground
      # inotifywait/fswatch (bash runs traps only after the foreground
      # command returns), and the wait below cannot reap it (the watcher was
      # disowned at spawn, so wait returns at once). Without killing the
      # blocking child too, the watcher and its inotifywait outlive the
      # session as orphans that exit only on the next clipboard event, if
      # ever. Harmless in the polling fallback (the child is at worst a
      # sleep). No-op where pkill is absent.
      pkill -P "$_CLIP_WATCHER_PID" 2>/dev/null || true
      wait "$_CLIP_WATCHER_PID" 2>/dev/null || true
      _CLIP_WATCHER_PID=""
    fi
    # Kill browser watcher (and its callback proxy child)
    if [ -n "${_BROWSER_WATCHER_PID:-}" ]; then
      kill "$_BROWSER_WATCHER_PID" 2>/dev/null || true
      wait "$_BROWSER_WATCHER_PID" 2>/dev/null || true
      _BROWSER_WATCHER_PID=""
    fi
    # Kill image-paste watcher. Plain kill suffices: its foreground command is
    # `sleep 0.25`, not a blocking inotifywait, so the TERM lands between ticks
    # and there is no blocked child to reap.
    if [ -n "${_CLIPIMG_WATCHER_PID:-}" ]; then
      kill "$_CLIPIMG_WATCHER_PID" 2>/dev/null || true
      wait "$_CLIPIMG_WATCHER_PID" 2>/dev/null || true
      _CLIPIMG_WATCHER_PID=""
    fi
    # Kill hook bridge: its EXIT/TERM trap kills child hook processes
    if [ -n "${_HOOK_BRIDGE_PID:-}" ]; then
      kill "$_HOOK_BRIDGE_PID" 2>/dev/null || true
      wait "$_HOOK_BRIDGE_PID" 2>/dev/null || true
      _HOOK_BRIDGE_PID=""
    fi
    _cleanup_spin
    rm -f "${_CLIP_DIR:?}/.clipboard."*
    # Own claims only: another session's live claim must survive our exit (see
    # _do_copy's claim-name note). Both locations: claims moved out of the bind
    # mount into clipclaim/, and the legacy in-mount path for a watcher started
    # by an older CLI that is still running against this box.
    rm -f "$(dirname "${_CLIP_DIR:?}")/clipclaim/.claim.$$."*
    rm -f "${_CLIP_DIR:?}/.claim.$$."*
    rm -f "$_CLIP_DIR/.watcher.$$"
    # After our own marker is gone, so a solo session sweeps unconditionally.
    _browser_teardown_bridge "${_CLIP_DIR:?}"
    # Only a LIVE sibling may hold .host-ready on. Testing mere existence let a
    # marker from a crashed session latch it forever, and the box's shim takes
    # the file-bridge path whenever .host-ready exists (docker/clip). So a
    # session with no watcher running wrote its payload to a bridge nobody was
    # reading, the copy was swept as a stale leftover, and the OSC 52 fallback
    # that would have worked was never tried. Found with two markers from two
    # days earlier still on disk.
    _sweep_dead_watcher_markers "$_CLIP_DIR"
    if ! ls "$_CLIP_DIR"/.watcher.* >/dev/null 2>&1; then
      rm -f "$_CLIP_DIR/.host-ready"
    fi
    # Re-stamp the run dir on detach so the idle sweep's grace measures time since
    # THIS session let go, not since the container was created (see the attach
    # touch above). Fail-soft.
    touch "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
  }

  # The per-box watcher log (target of the redirects below). Cap it on session
  # start and record the post-cap size, which is this session's read offset for
  # the end-of-session fork diagnostic.
  local _watcher_log="$_CLIP_DIR/.watcher-log" _watcher_log_off
  _watcher_log_off="$(_cap_watcher_log "$_watcher_log")"
  # The same offset trick for the bridge's own log, so the post-session report
  # names only the URLs THIS session refused. Without the offset a refusal from
  # a previous session re-fires on every run, which is the nagging concept/21
  # forbids.
  local _proxy_log_off
  _proxy_log_off="$(_cap_watcher_log "$_CLIP_DIR/.proxy-log")"
  # Whether ~/.claude/.config.json is there before the box runs, so the end of
  # the session can say it APPEARED. See _maybe_note_host_global_config.
  local _cfgjson_before=0
  _host_global_config_present && _cfgjson_before=1
  # The hook bridge's drop log is per INSTALL, not per box: it has to survive
  # the teardown of the box that wrote it, and the box must not be able to
  # induce its deletion. Offset captured the same way.
  local _hook_drop_log_path="$CLEAT_STATE_DIR/hook-drops.log" _hook_drop_off=0
  if [ -f "$_hook_drop_log_path" ]; then
    _hook_drop_off="$(wc -c < "$_hook_drop_log_path" 2>/dev/null | tr -d '[:space:]')"
    case "$_hook_drop_off" in ''|*[!0-9]*) _hook_drop_off=0 ;; esac
  fi

  local clip_cmd
  clip_cmd="$(_host_clip_cmd)"
  if [ -n "$clip_cmd" ]; then
    touch "$_CLIP_DIR/.watcher.$$"
    # Redirect the watcher's own stdout+stderr to a per-box log, NOT the
    # terminal. Under heavy multi-agent load the host can hit its process cap,
    # and a backgrounded watcher that inherits the interactive terminal's fd 2
    # prints bash's own "fork: Resource temporarily unavailable" straight into
    # the Claude Code TUI, corrupting it. The watcher never has anything the
    # user should see (it drives pbcopy and marker files, never the terminal),
    # so a log keeps fork spew and any stray output off-screen but debuggable.
    # `.watcher-log` (hyphen) stays clear of the `.watcher.*` liveness glob.
    _clipboard_watcher "$_CLIP_DIR" "$clip_cmd" >>"$_CLIP_DIR/.watcher-log" 2>&1 &
    _CLIP_WATCHER_PID=$!
    disown "$_CLIP_WATCHER_PID" 2>/dev/null || true

    # Native ctrl+v image paste: drop the shim ahead of xclip on PATH, then run
    # a watcher that answers its image requests from the host clipboard. Always
    # on, gated only by CLEAT_NO_CLIPBOARD_IMAGE=1. Reuses the .watcher.$$ marker
    # already touched above, so .host-ready stays correct. If the drop fails
    # (a locked-down box, an old daemon), the shim is simply absent and paste
    # falls back to today's "No image found", never an error.
    if [ "${CLEAT_NO_CLIPBOARD_IMAGE:-}" != "1" ]; then
      if _clipimg_drop_shim "$cname"; then
        _clipimg_watcher "$_CLIP_DIR" "$cname" >>"$_CLIP_DIR/.watcher-log" 2>&1 &
        _CLIPIMG_WATCHER_PID=$!
        disown "$_CLIPIMG_WATCHER_PID" 2>/dev/null || true
      fi
    else
      _clipimg_remove_shim "$cname"
    fi
  fi

  # Start browser watcher (always-on, like host connectivity). Pass whether an
  # interactive host terminal is attached. It reaches the watcher's deferral log
  # line only: plain links defer either way (no duplicate tab on a terminal, no
  # unattended open off one). See _browser_should_open.
  local open_cmd
  open_cmd="$(_host_open_cmd)"
  if [ -n "$open_cmd" ]; then
    local _bw_interactive=0
    _is_tty && _bw_interactive=1
    # Same terminal-safety redirect as the clipboard watcher: this loop opens
    # URLs (`$open_cmd ... >/dev/null 2>&1`) and logs to .proxy-log, so it never
    # needs the terminal, and a fork failure under load must not spew into the
    # TUI. Its callback-proxy child inherits these fds, so it is covered too.
    _browser_watcher "$_CLIP_DIR" "$open_cmd" "$cname" "$(_browser_bridge_mode)" "$_bw_interactive" >>"$_CLIP_DIR/.watcher-log" 2>&1 &
    _BROWSER_WATCHER_PID=$!
    disown "$_BROWSER_WATCHER_PID" 2>/dev/null || true
  fi

  # Start host-side hook bridge if user has hooks and hooks cap is active
  # _ec_pre_notice: did anything print between the caller's blank line and the
  # launch? See the reclaim invariant below.
  local _ec_pre_notice=0
  local hooks_file="$CLEAT_RUN_DIR/${cname}/hooks/events.jsonl"
  # _has_host_hooks parses settings with jq, so on a host without jq it cannot
  # answer and returns "no hooks". That is indistinguishable from a real "no
  # hooks configured", so the cap used to forward nothing with no message at all
  # while the summary block still listed it as active. jq ships in the image but
  # is not a documented HOST requirement (cli/README.md lists Docker, the OS, an
  # account and git), so this is a reachable configuration, not a hypothetical.
  if cap_is_active hooks 2>/dev/null && ! command -v jq >/dev/null 2>&1; then
    warn "hooks cap is on but jq is not installed on the host, so no hooks are forwarded. Install jq to enable them."
    _ec_pre_notice=1
  elif cap_is_active hooks 2>/dev/null && _has_host_hooks 2>/dev/null; then
    # Say what enabling it means, on every session that will actually run a host
    # hook (EGRESS-SPEC H4). The same amber line the docker cap gets, because it
    # is the same class: the box's activity runs a command outside the cage. Here
    # rather than beside the docker line in each verb, so start, resume and
    # claude share one site, and shell and login (which run no hook bridge) never
    # print it. A cap with no host hooks configured runs nothing, so it stays
    # quiet rather than warn about a command that does not exist.
    warn_sandbox "Host hooks enabled. The box chooses when they run and what is on their stdin."
    _ec_pre_notice=1
    # Terminal-safety redirect (see the clipboard watcher). The bridge runs hook
    # commands `>/dev/null 2>&1` and its `( _execute_host_hooks ) &` children
    # inherit these fds, so both the bridge and its children keep fork spew off
    # the TUI while staying debuggable in the log.
    # The WORKSPACE, not the project: for a fork box they differ, and
    # translating to the project would point the user's host hook at the ORIGIN
    # working tree from inside a fork box. Computed here from the fork marker,
    # never read from cmd_run's `local _workspace`: every caller reaches this
    # after cmd_run has returned (or without calling it at all, for a box that
    # is already running), so that name is unset and set -u killed the spawn.
    # Never empty either: the watcher's own default is the project, which is
    # the origin tree for a fork.
    local _hb_ws="${_RESOLVED_PROJECT:-}"
    if _box_is_fork "$cname"; then
      _hb_ws="$(_fork_dir "$cname")"
    fi
    # The spool, created here rather than waited for. The box makes it on its
    # first forwarded event, so the bridge otherwise spends the start of every
    # session waiting for a file that may be minutes away. Never through a link:
    # the directory is mounted read-write into the box, so a link planted there
    # would have this truncate whatever host file it points at. A path that is
    # anything other than absent is left exactly as it is, and the watcher's own
    # _drop_unless_regular decides what to do with it.
    if [[ ! -e "$hooks_file" && ! -L "$hooks_file" ]]; then
      mkdir -p "${hooks_file%/*}" 2>/dev/null || true
      ( umask 077; : > "$hooks_file" ) 2>/dev/null || true
    fi
    _hook_bridge_watcher "$hooks_file" "$_hb_ws" "$cname" >>"$_CLIP_DIR/.watcher-log" 2>&1 &
    _HOOK_BRIDGE_PID=$!
    disown "$_HOOK_BRIDGE_PID" 2>/dev/null || true
  fi
  # A project that defines hooks in its own settings files gets one line saying
  # they will not run on the host. Silence here would read as "my hooks broke".
  if cap_is_active hooks 2>/dev/null && command -v jq >/dev/null 2>&1; then
    local _pf _pf_seen=0
    while IFS= read -r _pf; do
      [ -n "$_pf" ] || continue
      _pf_seen=1
      break
    done < <(_hook_project_files_with_hooks 2>/dev/null)
    if [ "$_pf_seen" = "1" ]; then
      warn "This project defines hooks in its own ${BOLD}.claude/settings*.json${RESET}. They do not run on the host."
      echo -e "    ${DIM}Those files live in the directory the agent edits, so a command read from one is a command the box can write.${RESET}"
      echo -e "    ${DIM}Copy the ones you want into ${BOLD}~/.claude/settings.json${RESET}${DIM} and they run.${RESET}"
      _ec_pre_notice=1
    fi
  fi

  # Every caller prints a blank line before this function, so the last line on
  # screen when Claude takes over is blank, and the session-end reclaim below
  # (cursor up, erase) eats that blank. An advisory printed HERE became the last
  # line instead, so the reclaim erased it: the amber "Host hooks enabled" line
  # appeared for the length of the session and was gone from the scrollback the
  # moment Claude exited cleanly. Found on the maintainer's Mac, 2026-09-18.
  # One blank line restores the invariant for every notice in this window.
  [[ $_ec_pre_notice -eq 0 ]] || echo ""

  trap _cleanup_session EXIT INT TERM HUP

  # Don't launch the session until the UID remap has landed (see helper above).
  _wait_for_coder_remap "$cname"

  local rc=0
  _ensure_docker_access "$cname"
  # Use `runuser -u coder` rather than `docker exec --user coder` because the
  # latter sets UID/GID but skips initgroups(3), so supplementary groups from
  # /etc/group aren't loaded. This matters for the docker capability, where
  # the entrypoint adds coder to the host docker socket's owning group.
  # Pin node's heap to the box's real memory budget. Node sizes its default
  # heap ceiling from the cgroup limit, so before the limits were right-sized
  # it believed ~8g was available inside a 7.75g VM. 60% of the box limit
  # leaves headroom for non-heap memory (buffers, workers, the shell). A
  # user-supplied NODE_OPTIONS via env passthrough appears LATER on the exec
  # command line and wins: this is a default, not a straitjacket.
  local _heap_env=()
  local _mem_bytes _heap_mb
  _mem_bytes="$(docker inspect "$cname" --format '{{.HostConfig.Memory}}' 2>/dev/null)" || _mem_bytes=""
  if [[ "$_mem_bytes" =~ ^[0-9]+$ ]] && (( _mem_bytes > 0 )); then
    _heap_mb=$(( _mem_bytes * 60 / 100 / 1048576 ))
    (( _heap_mb > 0 )) && _heap_env=(-e "NODE_OPTIONS=--max-old-space-size=${_heap_mb}")
  fi

  # The inner script must exit with CLAUDE's status, not the clip-daemon
  # cleanup's: `wait` on the TERM-trapped daemon reports 0, which used to mask
  # a crashed claude (SIGSEGV=139, SIGABRT=134) as a clean session end, and
  # the rc==0 branch below then ERASED the crash message bash had just printed.
  # Host-side docker errors ('exec failed' during fork lockup, daemon resets)
  # go to a temp file and surface on failure instead of vanishing.
  local _exec_err="/tmp/cleat-exec-err.$$"

  # ── The relaunch loop (5.6) ──────────────────────────────────────────────
  # One iteration is one `docker exec` running claude, plus the account prepare
  # right before it (O3) and, on a relaunch, the T1 reopen line. When claude
  # exits 143 AND terminal 2 left a ticket, this waits out the switch and
  # relaunches `claude --resume <sid>` on the account that switch pinned. An
  # unticketed session (no exec id) runs exactly one iteration and behaves as
  # before. The flag trap covers the gate, prepare, the T line and the drain;
  # the cleanup trap is re-armed right before each exec so a Ctrl-C there ends
  # cleanly with the watchers still torn down once, at the final exit.
  local _ec_note="" _ec_ticket="$CLEAT_RUN_DIR/${cname}/.handoff.${_ec_id}" _ec_used="" _ec_to=""
  local _ec_relaunch=0 _ec_sid _ec_sdir _ec_model _ec_flags="" _EC_PINNED="" _HANDOFF_T1_STATE=""
  local _EC_INT=0 _ec_extra
  local _EC_ARGS=("$@")
  while :; do
    rc=0
    trap '_EC_INT=1' INT TERM HUP
    touch "$_ec_marker" 2>/dev/null || true
    if ! _account_attach_gate "$cname" "${_BOX:-main}" cleat; then _ec_note=switching; break; fi
    _exec_claude_prepare_account "$cname" || true
    if [[ $_ec_relaunch -eq 1 ]]; then
      _handoff_say_t1 "$_ec_to" "$_ec_flags"
      _handoff_drain_typeahead
    fi
    if [[ "$_EC_INT" == "1" ]]; then
      if [[ $_ec_relaunch -eq 1 ]]; then _ec_note=interrupted; else _ec_note=cancelled; fi
      break
    fi
    trap _cleanup_session EXIT INT TERM HUP
    _ec_extra=()
    if [[ -n "$_ec_id" ]]; then _ec_extra=(-e "CLEAT_EXEC_ID=${_ec_id}"); fi
    # The reopen after a switch lands on the same conversation with no question
    # in the way. Never on the first launch, so an ordinary `cleat` keeps Claude
    # Code's own behaviour.
    if [[ $_ec_relaunch -eq 1 ]]; then
      _ec_extra+=(-e "CLAUDE_CODE_RESUME_THRESHOLD_MINUTES=${_HANDOFF_RESUME_THRESHOLD_MIN}")
      _ec_extra+=(-e "CLAUDE_CODE_RESUME_TOKEN_THRESHOLD=${_HANDOFF_RESUME_TOKEN_THRESHOLD}")
    fi
    docker exec -it "${CLAUDE_ENV[@]}" \
      "${_heap_env[@]+"${_heap_env[@]}"}" \
      "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" \
      "${_ec_extra[@]+"${_ec_extra[@]}"}" "$cname" \
      runuser -u coder -- bash -c '
        clip-daemon &
        _MY_CLIP_DAEMON=$!
        for i in 1 2 3 4 5; do [ -S "${CLEAT_CLIP_DIR:-/tmp/cleat-run-$(id -u)}/clip.sock" ] && break; sleep 0.1; done
        claude "$@"
        _CLAUDE_RC=$?
        kill "$_MY_CLIP_DAEMON" 2>/dev/null
        wait "$_MY_CLIP_DAEMON" 2>/dev/null
        exit "$_CLAUDE_RC"
      ' _ "${_EC_ARGS[@]+"${_EC_ARGS[@]}"}" 2>"$_exec_err" || rc=$?

    # No exec id means no relaunch is possible: one exec, exactly as before.
    if [[ -z "$_ec_id" ]]; then break; fi
    # Drop the ticket this relaunch already served, matched on by AND at, once
    # its exec returns. Until then that ticket keeps the reopen pending (5.2).
    if [[ -n "$_ec_used" ]] && _handoff_ticket_read "$_ec_ticket" \
         && [[ "${_HT_BY}:${_HT_AT}" == "$_ec_used" ]]; then
      rm -f "$_ec_ticket" 2>/dev/null || true
    fi
    # A ticket explains an exit only when the exit code is 143. A session the
    # user quit never reopens by itself, and an unticketed 143 reports as today.
    if [[ $rc -ne 143 ]] || ! _handoff_ticket_read "$_ec_ticket"; then break; fi
    _restore_terminal
    _handoff_t1_await "$_ec_ticket"
    case "$_HANDOFF_T1_STATE" in
      ready) : ;;
      interrupted) _ec_note=interrupted; break ;;
      *) _ec_note=unfinished; break ;;
    esac
    _ec_used="${_HT_BY}:${_HT_AT}"
    touch "$_ec_marker" 2>/dev/null || true
    if ! is_running "$cname"; then _ec_note=boxstopped; break; fi
    _ec_sid="$_HT_SID"
    _ec_sdir="$(_sessions_key_dir "${_RESOLVED_PROJECT:-}" "${_BOX:-main}")" || _ec_sdir=""
    if [[ -z "$_ec_sdir" ]] || ! _sessions_path_under_key "$_ec_sdir/$_ec_sid.jsonl" "$_ec_sdir" \
         || [[ ! -f "$_ec_sdir/$_ec_sid.jsonl" || -L "$_ec_sdir/$_ec_sid.jsonl" ]]; then
      _ec_note=unfinished; break
    fi
    # Never --continue: it would open the newest conversation, which right after
    # the SIGTERM is a sibling session, not this one (R-a). Name the sid.
    _EC_ARGS=(--dangerously-skip-permissions --resume "$_ec_sid")
    _ec_model=""
    if ! _resume_model_configured "${_RESOLVED_PROJECT:-}"; then
      _ec_model="$(_resume_model_carry "$_ec_sdir/$_ec_sid.jsonl")"
    fi
    if [[ -n "$_ec_model" ]]; then _EC_ARGS+=(--model "$_ec_model"); fi
    _ec_flags="$(_handoff_tail_flags "$_ec_sdir/$_ec_sid.jsonl")"
    _ec_relaunch=1
  done

  # ── The final exit, once, restore-first (5.6) ────────────────────────────
  # The teardown, harvest and reporting run exactly once, only after the loop
  # ends for good. The order below preserves the pre-loop behaviour: the silent
  # harvest right after the terminal is back, then the clean-exit reclaim and
  # its message, then the busy and held notices (their last line sat above the
  # cursor the reclaim erased, so they stay after it).
  _cleanup_session
  rm -f "$_ec_marker" 2>/dev/null || true
  [[ -n "$_ec_id" ]] && rm -f "$_ec_ticket" 2>/dev/null || true
  trap - EXIT INT TERM HUP
  _restore_terminal

  # Harvest a token the box refreshed for itself. Without this every refresh
  # after a switch is lost and the account is back at /login. A lock that cannot
  # be had writes nothing, said below rather than over Claude's screen. AFTER
  # the terminal is back: a rotated token can wait out a whole bounded profile
  # request on a black-holed route, and it must not do so in raw mode. It prints
  # nothing itself, so it cannot lose a line to the reclaim below.
  #
  # On a switching or cancelled exit no docker exec ran on this box this process
  # (the gate refused before the session, or the user quit during prepare), so
  # there is nothing this session refreshed to harvest. A switch in the other
  # terminal owns the harvest of the outgoing account and is holding the account
  # lock, so calling _account_sync_out here would only return _ACCOUNT_LOCK_BUSY
  # and print a "was not saved" line that contradicts the "Nothing was changed"
  # refusal printed just above.
  local _harvest=0
  case "$_ec_note" in
    switching|cancelled) : ;;
    *) _account_sync_out "$cname" || _harvest=$? ;;
  esac

  # The rc and note lines. `Claude exited with code 143` is hidden only when a
  # ticket gave the exit a note. For a wait that did not reopen, settle out any
  # switch still holding the lock and read the pin, so the T line names where
  # the box really landed (5.3), never the ticket's target.
  case "$_ec_note" in
    "")
      if [[ $rc -eq 0 ]]; then
        # Reclaim claude's leftover trailing line (cursor up, erase it), drop
        # back down, then clear the line success writes on. TTY-gated so no
        # escapes reach a pipe.
        _is_tty && printf '\033[A\033[2K\r\n\033[2K'
        success "Session ended. Resume with: ${BOLD}cleat resume${RESET}"
      elif [[ $rc -ne 130 ]]; then
        warn "Claude exited with code $rc"
        [[ -s "$_exec_err" ]] && error "${DIM}$(cat "$_exec_err")${RESET}"
        _maybe_explain_oom "$cname" "$rc" "${_mem_bytes:-}"
      fi
      ;;
    cancelled|switching) : ;;
    unfinished|interrupted)
      local _ec_pin=""
      _account_settle "$cname" || true
      _ec_pin="$(_box_account_read "$cname")"
      if [[ -n "$_ec_to" && "$_ec_pin" == "$_ec_to" ]]; then
        _handoff_say T-landed "${_BOX:-main}" "$_ec_pin"
      elif [[ "$_ec_note" == "unfinished" ]]; then
        _handoff_say T-unfinished "$_ec_pin"
      else
        _handoff_say T-interrupted "$_ec_pin"
      fi
      ;;
    boxstopped) _handoff_say T-boxstopped ;;
  esac

  # The harvest that could not take the account lock. After the reclaim above,
  # for the same reason as the fork advisory below: printed before it, its last
  # line sat directly above the cursor and the reclaim erased it.
  _maybe_report_account_harvest_busy "$_harvest"
  # And the harvest that refused outright, which would otherwise read as saved.
  _maybe_report_account_harvest_refused "$_harvest" "$cname"
  # The session ended on a login the server says is another account's, so it was
  # held rather than saved over the pinned one. Said every time: the box keeps
  # running on that login until the next switch.
  if [[ $_harvest -eq 2 ]]; then
    _account_held_notice "$cname"
  fi
  # If the host ran out of process slots this session (watcher logged fork
  # errors), explain it once. Placed AFTER the rc==0 reclaim, so the reclaim
  # does not wipe the advisory's last, most actionable line. Independent of rc:
  # the box session usually SUCCEEDS while the host-side watchers could not fork.
  _maybe_explain_fork_exhaustion "$_watcher_log" "$_watcher_log_off"
  # And the destination gate's refusals. Same placement and the same reason.
  _maybe_report_blocked_opens "$_CLIP_DIR/.proxy-log" "$_proxy_log_off"
  # And the hook events the bridge refused. Same rule: only when non-zero.
  _maybe_report_hook_drops "$_hook_drop_log_path" "$_hook_drop_off" "$cname"
  # And a host global config file that was not there when the session began.
  _maybe_report_host_global_config_appeared "$_cfgjson_before"
  rm -f "$_exec_err"
  # The attach gate refused (a switch of this box holds the lock, R-switching
  # already printed): fail like the pre-loop gate did, so the caller stops. Any
  # other ending returns 0, unchanged: the wrapper already propagated claude's
  # own exit status inside the box.
  if [[ "$_ec_note" == "switching" ]]; then
    return 1
  fi
  return 0
}

# When a session dies from memory pressure, name it and say what to do: an
# unexplained exit-137/crash sends users hunting in the wrong place. Two
# signals: the box's cgroup OOM flag (State.OOMKilled, set when its own process
# tree is OOM-killed) or exit 137 (SIGKILL, the kernel OOM-killer's signature
# when it picks Claude itself). The classic trigger is a test runner: jest and
# vitest size their worker pool to the CPU count, and a box sees ALL host cores
# (CPU is unconfigured by default; concept/22), so a 2 GB box can spawn ~one
# node worker per core and blow its ceiling. There is no swap to absorb the
# spike (by design), so the spike is killed, not paged. This is guidance, not a
# fix: the user picks more memory, fewer workers, or a CPU cap. Fail-soft: an
# unreadable inspect just falls back to the exit-code signal.
_maybe_explain_oom() {
  local cname="$1" rc="$2" mem_bytes="${3:-}"
  local oomkilled=""
  oomkilled="$(docker inspect --format '{{.State.OOMKilled}}' "$cname" 2>/dev/null || true)"
  [[ "$oomkilled" == "true" || "$rc" == "137" ]] || return 0
  local mem_note=""
  if [[ "$mem_bytes" =~ ^[0-9]+$ ]] && (( mem_bytes > 0 )); then
    mem_note=" ${DIM}(box limit: $(( mem_bytes / 1073741824 )) GB)${RESET}"
  fi
  echo ""
  warn "${BOLD}Out of memory${RESET}. The box hit its memory ceiling${mem_note} and the kernel killed the process."
  echo -e "    ${DIM}Test runners are the usual cause: jest/vitest start one worker per CPU, and a box${RESET}"
  echo -e "    ${DIM}sees every host core. Pick one:${RESET}"
  echo -e "    ${DIM}•${RESET} More memory: add ${BOLD}[resources]${RESET} then ${BOLD}memory = 8g${RESET} to ${BOLD}.cleat${RESET} ${DIM}(or your global config)${RESET}"
  echo -e "    ${DIM}•${RESET} Fewer workers: ${BOLD}jest --maxWorkers=2${RESET}, ${BOLD}vitest --poolOptions.threads.maxThreads=2${RESET}"
  echo -e "    ${DIM}•${RESET} Cap CPU so runners self-limit: add ${BOLD}cpus = 2${RESET} under ${BOLD}[resources]${RESET}"
}

# During a heavy multi-agent run the HOST (not the box) can exhaust its per-user
# process table, and any host-side fork then fails with EAGAIN. Cleat's background
# watchers hit this and bash writes "fork: Resource temporarily unavailable" to
# the per-box watcher log (redirected off the terminal at the watcher spawns, so
# it no longer corrupts the Claude TUI). This surfaces ONE plain diagnostic when
# that happened THIS session, so the raw bash spam in the log gets a human
# explanation and a fix. It reads only the bytes written after `off` (this
# session's watcher output), so a stale error from a past session never
# re-triggers it. The failing fork is host-side (the box has its own pid pool and
# a working session), so this is guidance for the user's machine, not a box fix.
# Fail-soft: a missing log or `tail`/`grep` hiccup just prints nothing.
# Cap the per-box watcher log at ~1 MB and echo its post-cap byte size. Nothing
# else sweeps this log (it dodges the .watcher.* liveness glob by design), so
# without the cap a host fork storm, which appends many bash retry lines, could
# grow it unbounded across a long-lived box. The echoed size is the session's
# read offset so the end-of-session diagnostic scans only this session's slice.
# Fail-soft: a missing or unreadable log yields 0 (and no truncation).
# Remove whatever sits at a box-writable host path unless it is a regular
# file. The clip dir is mounted read-write, so the box can plant any shape
# there, and each one defeats a different idiom: a symlink is FOLLOWED by `>>`
# and by `[ -f ]`, a FIFO makes `>>` block forever and passes neither `[ -L ]`
# nor `[ -f ]`, a directory or socket fails the append outright. The symlink
# arm runs first and only ever unlinks, and the rm -rf below is bounded to a
# fixed name inside Cleat's own run dir, so nothing outside the mount is ever
# touched. Absent is fine: the caller's `>>` creates a regular file.
_drop_unless_regular() {
  local p="$1"
  if [ -L "$p" ]; then
    rm -f "$p" 2>/dev/null || true
  elif [ -e "$p" ] && [ ! -f "$p" ]; then
    rm -rf "$p" 2>/dev/null || true
  fi
  return 0
}

_cap_watcher_log() {
  local log="$1" sz=0
  # Anything that is not a regular file is never ours (see
  # _drop_unless_regular): `[ -f ]` DEREFERENCES a link, so a planted one would
  # have the truncation below empty whatever host file it names, and a FIFO
  # would block the caller's later `>>` forever.
  _drop_unless_regular "$log"
  [ -f "$log" ] || { echo 0; return 0; }
  # `tr -d [:space:]` strips BSD wc's leading padding (macOS prints "      6",
  # not "6"): without it the ^[0-9]+$ guard below rejects the padded string and
  # forces sz=0, which on macOS would defeat BOTH the cap (never truncates) and
  # the offset (always 0 -> a stale prior-session fork error re-fires the
  # advisory every run). Same normalization the hook bridge already does.
  sz="$(wc -c < "$log" 2>/dev/null | tr -d '[:space:]' || echo 0)"
  [[ "$sz" =~ ^[0-9]+$ ]] || sz=0
  if (( sz > 1048576 )); then
    : > "$log" 2>/dev/null || true
    sz=0
  fi
  echo "$sz"
}

_maybe_explain_fork_exhaustion() {
  local log="$1" off="${2:-0}"
  [ -f "$log" ] || return 0
  tail -c "+$(( off + 1 ))" "$log" 2>/dev/null | grep -q "Resource temporarily unavailable" || return 0
  echo ""
  warn "${BOLD}Your machine ran low on process slots${RESET} during this session ${DIM}(a host limit, not the box)${RESET}."
  echo -e "    ${DIM}A large multi-agent run can spawn thousands of host processes and hit your per-user cap.${RESET}"
  echo -e "    ${DIM}The agent kept working. Only Cleat's background helpers logged the fork errors. To avoid it:${RESET}"
  echo -e "    ${DIM}•${RESET} Run fewer agents at once ${DIM}(dispatch subagents sequentially)${RESET}"
  echo -e "    ${DIM}•${RESET} Raise this shell's limit before launching: ${BOLD}ulimit -u 4096${RESET}"
  echo -e "    ${DIM}•${RESET} macOS per-user cap: ${BOLD}sudo sysctl kern.maxprocperuid=4096${RESET} ${DIM}(default is often ~2784)${RESET}"
}

# Say that the session-end harvest wrote nothing because another cleat command
# held the account lock. $1 is _account_sync_out's status. Called by
# exec_claude only after its reclaim, for the reason given there.
_maybe_report_account_harvest_busy() {
  [[ "${1:-0}" -eq $_ACCOUNT_LOCK_BUSY ]] || return 0
  # The same two causes _account_busy_msg separates, said the same way. A next
  # session end cannot help when the directory itself is the problem, so that
  # one names the directory rather than promising a retry.
  if [[ "${_ACCOUNT_LOCK_UNWRITABLE:-0}" -eq 1 ]]; then
    warn "The login this session refreshed was not saved: Cleat cannot write to the accounts directory."
    echo -e "    ${DIM}It stays in the box. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
    return 0
  fi
  warn "The login this session refreshed was not saved: another cleat command is changing accounts."
  echo -e "    ${DIM}It stays in the box and is saved when the next session ends.${RESET}"
}

# A harvest that refused for a reason the next session end will meet again (1),
# as opposed to a lock it could not take (75), a login held as another account's
# (2) or a server that could not vouch for it right now (3, quiet on purpose: a
# host offline at a session end is not a fault and the next end retries).
#
# Said because silence here reads as saved. A Mac running v1.5.0 before the
# inode fix refused every harvest and printed nothing: `cleat account list` kept
# saying "signed out" while the box was signed in, and the next attach staged
# over the login. Only spoken when the box is pinned and there is something
# staged to save, so a box with nothing to harvest stays quiet.
_maybe_report_account_harvest_refused() {
  local rc="${1:-0}" cname="${2:-}" acct
  [[ "$rc" -eq 1 ]] || return 0
  [[ -n "$cname" ]] || return 0
  acct="$(_box_account_read "$cname")"
  [[ -n "$acct" && "$acct" != "$_ACCOUNT_DEFAULT" ]] || return 0
  [[ -f "$(_account_box_auth_dir "$cname")/.credentials.json" ]] || return 0
  warn "The login this session used was not saved to ${BOLD}${acct}${RESET}."
  echo -e "    ${DIM}It stays in the box. See what the account holds with ${BOLD}cleat account list${RESET}${DIM}.${RESET}"
}

# Report the browser opens the destination gate refused this session. Once, on
# the terminal, after the exec returns, reading a byte window of the proxy log
# from an offset captured in the foreground before the session started. Exactly
# the shape _maybe_explain_fork_exhaustion uses, and for the same reason.
#
# A denial that exists only in a log inside the box's own clip dir is
# undiagnosable from the field. That is the 2026-07-07 silent-deferral
# regression concept/33 records, and the box can rewrite that log besides. So
# every field printed here is sanitized: the URL is box-authored by
# construction, which is the whole point of printing it.
#
# The line carries three things, because each answers a different question: the
# full URL so it can be opened by hand, the bare origin so it is
# copy-pasteable, and the exact command that allows it next time.
#
# Parsed, never searched (concept/41 rule 3). Only a line the watcher itself
# shaped counts, anchored from its first byte, so a URL whose query carries the
# marker text cannot add a refusal or name a host. Every field is taken from
# the FIRST occurrence: `${l##*url=}` took the last, so a login URL with a
# return_url= or origin= parameter printed a truncated URL and allowed a host
# the query chose. The origin is re-derived from the URL rather than read from
# the logged field, so the allow line always names the host of the URL above it.
_maybe_report_blocked_opens() {
  local log="$1" off="${2:-0}" lines n=0 l rest origin url shown=0
  [ -f "$log" ] || return 0
  # A capped open is the other refusal the bridge makes, and it is reported
  # from here so every caller of this report gets both.
  _maybe_report_capped_opens "$log" "$off"
  lines="$(tail -c "+$(( off + 1 ))" "$log" 2>/dev/null | grep "^[[]browser-watcher [0-9][0-9]:[0-9][0-9]:[0-9][0-9][]] ${_BROWSER_BLOCKED_MARK} origin=[^ ]* url=" 2>/dev/null)" || return 0
  [ -n "$lines" ] || return 0
  n="$(printf '%s\n' "$lines" | grep -c . 2>/dev/null || echo 0)"
  n="$(printf '%s' "$n" | tr -d '[:space:]')"
  case "$n" in ''|*[!0-9]*) return 0 ;; esac
  [ "$n" -gt 0 ] || return 0
  echo ""
  if [ "$n" -eq 1 ]; then
    warn "Blocked ${BOLD}1${RESET} browser open from the box ${DIM}(origin not on the allowlist)${RESET}"
  else
    warn "Blocked ${BOLD}${n}${RESET} browser opens from the box ${DIM}(origin not on the allowlist)${RESET}"
  fi
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    [ "$shown" -lt 3 ] || break
    rest="${l#*"] ${_BROWSER_BLOCKED_MARK} origin="}"
    url="${rest#* url=}"
    origin="$(_bridge_url_host "$url" 2>/dev/null)" || origin=""
    url="$(_sanitize_repo_str "$url")"
    echo -e "    ${DIM}${url}${RESET}"
    if [ -z "$origin" ]; then
      echo -e "    ${DIM}Cleat could not parse an origin out of that URL, so there is nothing to allow.${RESET}"
    elif _bridge_host_is_local "$origin"; then
      # `cleat browser allow` refuses these, so printing it would hand the user
      # a command that fails.
      echo -e "    ${DIM}Cleat never opens a loopback or private address, so there is nothing to allow.${RESET}"
    else
      echo -e "    Allow it: ${BOLD}cleat browser allow ${origin}${RESET}"
    fi
    shown=$(( shown + 1 ))
  done <<EOF
$lines
EOF
  if [ "$n" -gt 3 ]; then
    echo -e "    ${DIM}...and $(( n - 3 )) more. Every one is in ${_CLIP_DIR:-the box run dir}/.proxy-log${RESET}"
  fi
  echo -e "    ${DIM}Missing a login worth shipping? ${BOLD}https://github.com/cleatdev/cleat/issues/new${RESET}"
  return 0
}

# Report the opens the rate cap held back this session. Same window, same
# anchored parse and the same sanitizing as the refusal report above, for the
# same reasons. A capped open is a URL the user may be waiting on: a login the
# box started after a burst of other opens gets no tab, and Claude Code 2.1.191+
# never prints a loopback authorize URL, so this line is the only place it shows.
#
# The limits in the heading come from the constants, never from the logged
# field, because the box can write the log. The URL is taken after the FIRST
# "/session url=", which the anchor pins inside the watcher's own prefix.
_maybe_report_capped_opens() {
  local log="$1" off="${2:-0}" lines n=0 l url shown=0
  [ -f "$log" ] || return 0
  lines="$(tail -c "+$(( off + 1 ))" "$log" 2>/dev/null | grep "^[[]browser-watcher [0-9][0-9]:[0-9][0-9]:[0-9][0-9][]] ${_BROWSER_CAPPED_MARK} limit=[0-9]*/min,[0-9]*/session url=" 2>/dev/null)" || return 0
  [ -n "$lines" ] || return 0
  n="$(printf '%s\n' "$lines" | grep -c . 2>/dev/null || echo 0)"
  n="$(printf '%s' "$n" | tr -d '[:space:]')"
  case "$n" in ''|*[!0-9]*) return 0 ;; esac
  [ "$n" -gt 0 ] || return 0
  echo ""
  if [ "$n" -eq 1 ]; then
    warn "Did not open ${BOLD}1${RESET} browser URL from the box ${DIM}(rate cap: ${_BROWSER_RATE_PER_MIN} a minute, ${_BROWSER_RATE_PER_SESSION} a session)${RESET}"
  else
    warn "Did not open ${BOLD}${n}${RESET} browser URLs from the box ${DIM}(rate cap: ${_BROWSER_RATE_PER_MIN} a minute, ${_BROWSER_RATE_PER_SESSION} a session)${RESET}"
  fi
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    [ "$shown" -lt 3 ] || break
    url="${l#*"/session url="}"
    url="$(_sanitize_repo_str "$url")"
    echo -e "    ${DIM}${url}${RESET}"
    shown=$(( shown + 1 ))
  done <<EOF
$lines
EOF
  if [ "$n" -gt 3 ]; then
    echo -e "    ${DIM}...and $(( n - 3 )) more. Every one is in ${_CLIP_DIR:-the box run dir}/.proxy-log${RESET}"
  fi
  echo -e "    ${DIM}Open one by hand if you still need it. A login retried a minute later opens as usual.${RESET}"
  return 0
}

# Report the events the hook bridge refused this session. Same shape and same
# placement as the two advisories beside it: a byte offset captured in the
# foreground before the session, a tail from it afterwards.
#
# Only when the count is non-zero, because concept/21 forbids the nag. And the
# copy never implies wider coverage than there is: the bridge starts from
# exec_claude, not from `cleat shell` or `cleat login`.
#
# The log is per install and sessions run concurrently, so only rows for THIS
# box count: a byte offset alone counted a sibling session's drops as ours.
# And the reason is never assumed. The path sentence is used only when every
# counted row is a path refusal. An oversized line or a malformed one did not
# name a path at all, so those get the neutral wording.
_maybe_report_hook_drops() {
  local log="$1" off="${2:-0}" cname="${3:-}" counts n np
  [ -f "$log" ] || return 0
  counts="$(tail -c "+$(( off + 1 ))" "$log" 2>/dev/null \
    | awk -F '\t' -v m="$_HOOK_DROP_MARK" -v c="$cname" '
        $2 == m && $4 == c { n++; if ($3 == "path") p++ }
        END { printf "%d %d", n, p }' 2>/dev/null)" || return 0
  read -r n np <<< "$counts"
  case "$n" in ''|*[!0-9]*) return 0 ;; esac
  case "$np" in ''|*[!0-9]*) np=0 ;; esac
  [ "$n" -gt 0 ] || return 0
  echo ""
  if [ "$np" -eq "$n" ] && [ "$n" -eq 1 ]; then
    warn "Dropped ${BOLD}1${RESET} hook event from the box ${DIM}(it named a path this machine could not map to its own files)${RESET}"
  elif [ "$np" -eq "$n" ]; then
    warn "Dropped ${BOLD}${n}${RESET} hook events from the box ${DIM}(each named a path this machine could not map to its own files)${RESET}"
  elif [ "$n" -eq 1 ]; then
    warn "Dropped ${BOLD}1${RESET} hook event from the box ${DIM}(it failed validation)${RESET}"
  else
    warn "Dropped ${BOLD}${n}${RESET} hook events from the box ${DIM}(they failed validation)${RESET}"
  fi
  echo -e "    ${DIM}Every one is in ${CLEAT_STATE_DIR}/hook-drops.log${RESET}"
  return 0
}

# ── Cleat's own state: throttles and notice memory ──────────────────────────
# These used to sit beside the script in the install tree, which breaks two
# ways. A Homebrew keg is DELETED and recreated by every `brew upgrade`, so
# every throttle reset and every "don't nag me about v1.5.0" was forgotten on
# each upgrade, and a keg may not be writable at runtime anyway. And switching
# install channels (curl to brew, or back) lost the same state for the same
# reason. The config dir is the SAME path on every channel and survives both,
# so state lives there and the install tree stays effectively read-only.
CLEAT_STATE_DIR="$CLEAT_CONFIG_DIR/state"

# One-shot move from the pre-1.4 location beside the script. Runs before any
# check reads its file, so upgrading into this version does not re-nag about a
# release you already declined or re-show a notice you already read. Entirely
# best-effort: a keg's tree is not writable and a failed move must never fail a
# launch, so every step swallows its error and the worst case is one stale
# notice.
_migrate_state_files() {
  mkdir -p "$CLEAT_STATE_DIR" 2>/dev/null || return 0
  local pair old new root
  # Two sources: this install's own tree, and the well-known script-install
  # location. The second is what makes a CHANNEL SWITCH automatic. Someone
  # moving from a pre-1.4 script install straight to a keg never launches the
  # old install again, so its state would sit orphaned in ~/.cleat and the
  # switch would lose the very memory this relocation exists to preserve.
  # When REPO_DIR already is ~/.cleat the second pass is a no-op, because the
  # destination now exists.
  for root in "$REPO_DIR" "${HOME:-}/.cleat"; do
    for pair in \
      ".update_check:update_check" \
      ".last_seen_version:last_seen_version" \
      ".pressure_check:pressure_check" \
      ".claude_update_check:claude_update_check" \
      ".disk_check:disk_check"; do
      old="$root/${pair%%:*}"
      new="$CLEAT_STATE_DIR/${pair##*:}"
      [[ -f "$old" && ! -f "$new" ]] || continue
      # Copy then unlink, not `mv`: on a read-only install tree the copy still
      # lands and only the cleanup fails, which is the harmless half.
      cp "$old" "$new" 2>/dev/null || true
      # Tidy up ONLY the install actually running. The ~/.cleat pass is a rescue
      # for a channel switch, and that tree can still belong to a live install:
      # consuming its file would surprise anyone merely running a working copy
      # from a checkout, which is every developer of Cleat itself.
      # Unlink only after confirming the copy LANDED, and only for the tree
      # actually being run. Without the -f test, a state dir that cannot be
      # written (root-owned after one `sudo cleat`, or a full disk) swallows the
      # cp and then deletes the original, which destroys the state outright
      # rather than merely failing to move it.
      if [[ "$root" == "$REPO_DIR" && -f "$new" ]]; then
        rm -f "$old" 2>/dev/null || true
      fi
    done
  done
}

# ── Update check (every 10 minutes) ─────────────────────────────────────────
UPDATE_CHECK_FILE="$CLEAT_STATE_DIR/update_check"
# Records the last VERSION whose on-start release highlight was shown (one line).
# Absent or different from VERSION => the highlight shows once on the next launch.
LAST_SEEN_VERSION_FILE="$CLEAT_STATE_DIR/last_seen_version"
UPDATE_CHECK_INTERVAL=600   # 10 minutes; a release cut minutes after a launch
                            # should surface on the next run, not up to a day
                            # later. The lookup is one `git ls-remote --tags`
                            # (refs only, no objects), so this cadence is cheap;
                            # the declined-version field still prevents re-nagging.

# Claude Code update check: separate cadence/cache from the cleat self-update
# check above. The channel defaults to `latest` to match `cleat upgrade-claude`
# (so the on-start prompt and the action it triggers agree); override with
# CLEAT_CLAUDE_CHANNEL (stable|latest|VERSION). Disable the whole on-start
# prompt with CLEAT_NO_CLAUDE_UPDATE_CHECK=1.
# Docker pressure check (bloat → prune offer; overload → notice), throttled
# like the update checks, but daily: image bloat grows by the day, not the
# minute, and the check costs a handful of docker calls.
PRESSURE_CHECK_FILE="$CLEAT_STATE_DIR/pressure_check"
PRESSURE_CHECK_INTERVAL=86400
# Idle-session sweep: on every interactive start, stop OTHER cleat boxes that are
# provably safe to stop (detached, no agent running, idle past the grace window),
# so a day of closed-terminal boxes stops silently reserving Docker VM memory.
# Closing a terminal ends the foreground exec but leaves the container running;
# this reclaims those. Grace defaults to 30 min so a box you stepped away from
# and will resume in a minute is left alone. Override with CLEAT_IDLE_GRACE_MINS;
# disable the whole sweep with CLEAT_NO_IDLE_SWEEP=1. See concept/25.
_IDLE_SWEEP_GRACE_SECS=1800
# Docker Desktop resources advisory (the VM memory/swap/file-sharing tuning the
# `docker` CLI cannot change). A box and a worktree are the same thing here:
# each is one session with its own quarter-of-VM ceiling (4-8g). 16 GiB is a comfortable default
# (a handful of sessions can each spike near their ceiling at once and still fit),
# NOT a hard cap: ceilings aren't reservations, so you can run many more sessions
# than that, and only simultaneous genuinely-heavy memory work across them swaps
# the VM, which is rare and no different from Claude Code outside Docker. The
# target is capped at half the host's RAM (leave the rest for macOS + apps). The
# advisory fires when the VM is below the target; a generous VM never nags, and it
# recurs on the daily check while the VM stays small, then stops once fixed. Host
# RAM unknown → conservative 8 GiB floor (don't over-recommend a VM the machine
# may not be able to back). See _recommended_vm_gb. User-facing copy never names a
# session count (it would read as a limit that isn't real); it says "many".
_PRESSURE_TARGET_VM_GB=16                     # comfortable default VM, not a session cap
_PRESSURE_VM_ADVISORY_BYTES=8589934592        # 8 GiB fallback floor (host RAM unknown)
# Minimum healthy Docker VM swap. Memory can be sized right while swap is left at
# the Docker Desktop default (often 1 GB): too little overflow for a brief spike,
# so a session can freeze instead of paging out. Matches the "Swap ≥ 2 GB" target
# the fix steps already recommend. Keep this value and that copy in sync.
_SWAP_ADVISORY_BYTES=2147483648               # 2 GiB

# Set to 1 by an on-start notice (the Docker pressure block) once it has emitted
# its own trailing blank line, so the release highlight below it knows the gap
# is already open and won't double the blank. When it stays 0 (no notice
# printed, or a non-Docker-Desktop engine where the fix block is skipped), the
# highlight opens the gap itself, guaranteeing exactly one blank line above the
# "New in …" news no matter what preceded it. See _maybe_show_release_highlight.
_ONSTART_GAP_OPEN=0

# Set to 1 by the pressure check when it printed a VM warning (overload or
# undersized) this run, so the positive "Docker tuned" line stays silent and the
# two can never both appear (or contradict). See _maybe_announce_docker_ready.
_VM_ADVISORY_SHOWN=0

# Set to 1 by an on-start advisory ONLY when it surfaced a genuine Docker CONFIG
# error the user must go fix in Docker Desktop settings (an undersized VM memory
# slider, or swap left at the tiny default), never for the transient overload
# notice (which a `cleat stop` resolves without touching Docker's config). When
# set, _maybe_gate_on_docker_config holds the interactive launch for one keypress
# so the warning can't scroll by unread. _DOCKER_GATE_SUMMARY carries the one-line
# reason the gate re-states, so the stopped screen is self-contained. See
# concept/21 (the single documented exception to the "never block" startup rule).
_DOCKER_GATE_PENDING=0
_DOCKER_GATE_SUMMARY=""

CLAUDE_CHECK_FILE="$CLEAT_STATE_DIR/claude_update_check"
CLAUDE_CHECK_INTERVAL=600   # 10 minutes; the lookup is a tiny GET; the only
                            # real per-check cost is one throwaway container to
                            # read the image's version, bounded to once/interval.
CLAUDE_RELEASES_URL="https://downloads.claude.ai/claude-code-releases"

# The tag list is the SAME signal for every install shape, which is what makes
# the on-start offer identical on both channels. A git checkout asks its own
# origin. Anything else (a Homebrew keg, an unpacked tarball) has no repo to
# ask, so it queries the public URL directly: same command, same parsing, same
# cadence, so a brew user learns about a release exactly when a git user does.
latest_remote_tag() {
  local _remote="$REPO_URL"
  [[ -d "$REPO_DIR/.git" ]] && _remote="origin"
  git -C "$REPO_DIR" ls-remote --tags --refs "$_remote" 2>/dev/null \
    | awk '{print $2}' \
    | sed 's|refs/tags/v\{0,1\}||' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -t. -k1,1n -k2,2n -k3,3n \
    | tail -1
}

# Return success only when $REPO_DIR is a git work tree with NO uncommitted
# changes, i.e. a pristine release install onto which `git checkout v<tag>` is
# safe. A dirty tree is a developer/contributor checkout (the maintainer's daily
# state): there `git checkout` would fail on the very file that differs between
# tags (bin/cleat), so offering the auto-update would just nag "Update failed" on
# every launch. Skip it for them; `cleat update` stays available explicitly.
_repo_is_clean() {
  git -C "$REPO_DIR" diff --quiet 2>/dev/null \
    && git -C "$REPO_DIR" diff --cached --quiet 2>/dev/null
}

# Checkout the given release tag and invalidate the update caches. Does NOT pull
# the image or exit: the re-exec'd new CLI handles image/build itself. Returns
# nonzero on any git failure so the caller can continue on the current version.
# Separated from the prompt so tests can stub it.
_apply_cli_update() {
  local target="$1"
  [[ -d "$REPO_DIR/.git" ]] || return 1
  git -C "$REPO_DIR" fetch --tags --force --quiet 2>/dev/null || return 1
  git -C "$REPO_DIR" checkout "v${target}" --quiet 2>/dev/null || return 1
  # Re-check against the fresh checkout next launch (and re-evaluate the bundled
  # Claude Code, since the new release image ships its own).
  rm -f "$UPDATE_CHECK_FILE" "$CLAUDE_CHECK_FILE" 2>/dev/null || true
  return 0
}

# The keg equivalent of _apply_cli_update. Deliberately NOT an exec, unlike
# `cleat update`: the whole point of the on-start offer is that your session
# continues on the new version, so brew runs as a subprocess and _reexec_cli
# takes it from there through the symlink, which now points at the new keg.
#
# Running brew rather than exec'ing it means this script's own file is unlinked
# underneath us mid-run. That is safe: `brew upgrade` removes the old keg
# directory and creates a new one, so the inode this shell is reading stays
# alive on our open descriptor until we exec. It would NOT be safe if brew
# rewrote the file in place, which it does not.
#
# The version argument is deliberately absent. brew installs whatever the tap
# currently has, which can trail a just-cut tag by the length of a formula bump,
# so a no-op upgrade is a real outcome and is treated as success: re-exec, the
# version check re-runs, and the user is told again when the formula lands.
_apply_brew_update() {
  _brew_present || return 1
  brew upgrade cleatdev/tap/cleat || return 1
  # Re-check against the new keg next launch, and re-evaluate the bundled
  # Claude Code, since the new release image ships its own.
  rm -f "$UPDATE_CHECK_FILE" "$CLAUDE_CHECK_FILE" 2>/dev/null || true
  return 0
}

# Re-exec the (now-updated) CLI with the ORIGINAL argv so the new version drives
# the rest of this run. CLEAT_SKIP_CLI_UPDATE stops the new process from
# re-prompting (belt-and-suspenders; the version check already wouldn't fire).
# Isolated so tests can override it: exec replaces the process and can't be run
# under bats.
_reexec_cli() {
  export CLEAT_SKIP_CLI_UPDATE=1
  # `exec` only returns if it FAILED (e.g. $0 no longer resolves). `execfail`
  # lets it return instead of the shell exiting, and `|| true` keeps `set -e`
  # from aborting, so a user who just opted into an update is never stranded
  # with no session. The fallback re-enters main in-process (old in-memory code,
  # but a working session); CLEAT_SKIP_CLI_UPDATE prevents a re-prompt loop.
  shopt -s execfail 2>/dev/null || true
  exec "$0" "${_CLEAT_ORIG_ARGV[@]+"${_CLEAT_ORIG_ARGV[@]}"}" || true
  warn "Could not restart automatically. Continuing in this session."
  main "${_CLEAT_ORIG_ARGV[@]+"${_CLEAT_ORIG_ARGV[@]}"}"
  exit $?
}

# Interactive CLI self-update preflight. TTY-only, throttled, opt-out-able. When
# a newer RELEASED Cleat is available, offer to update and re-exec as that
# version. Runs before any docker work so the new version drives the whole run.
# Declined / non-interactive / offline → silently continue on the current
# version. Disable entirely with CLEAT_NO_UPDATE_CHECK=1.
_maybe_prompt_cli_update() {
  _is_tty || return 0
  [[ "${CLEAT_SKIP_CLI_UPDATE:-}" == "1" ]] && return 0
  [[ "${CLEAT_NO_UPDATE_CHECK:-}" == "1" ]] && return 0
  # Which updater this install actually has. The brew probe MUST come first:
  # the .git test alone does not exclude a keg, because on macOS before 12.3
  # there is no usable `readlink -f`, so REPO_DIR falls back to the Homebrew
  # PREFIX, and on Apple Silicon /opt/homebrew IS Homebrew's own git repo. The
  # .git test would pass there and the offer would fire inside brew's checkout.
  local _channel=""
  if _is_brew_managed "${BASH_SOURCE[0]}"; then
    # No brew on PATH means the offer could not be acted on, so there is
    # nothing worth interrupting a launch for. Silence is the honest answer.
    _brew_present || return 0
    _channel="brew"
  elif [[ -d "$REPO_DIR/.git" ]]; then
    _channel="git"
  else
    # A tarball or a hand-copied script has no updater at all.
    return 0
  fi

  # Don't offer an auto-`git checkout` onto a developer's dirty tree: it would
  # fail every launch (see _repo_is_clean). They can still run `cleat update`.
  # A keg has no working tree to be dirty.
  if [[ "$_channel" == "git" ]]; then
    _repo_is_clean || return 0
  fi

  # Cache layout: "<timestamp> <latest-version> [declined-version]". Field 3 (if
  # present) is the version the user last declined; we don't re-nag for it.
  local now last_check=0 cached_version="" declined_version=""
  now=$(date +%s)
  if [[ -f "$UPDATE_CHECK_FILE" ]]; then
    last_check=$(awk 'NR==1 {print $1}' "$UPDATE_CHECK_FILE" 2>/dev/null || echo 0)
    cached_version=$(awk 'NR==1 {print $2}' "$UPDATE_CHECK_FILE" 2>/dev/null || echo "")
    declined_version=$(awk 'NR==1 {print $3}' "$UPDATE_CHECK_FILE" 2>/dev/null || echo "")
    [[ "$last_check" =~ ^[0-9]+$ ]] || last_check=0
  fi
  # Throttle the network lookup to once per interval; CLEAT_FORCE_UPDATE_CHECK
  # bypasses (tests). Within the window we reuse the cached version, so a known
  # newer release still prompts without hitting the network every start. Preserve
  # the recorded decline across the refresh.
  if [[ -n "${CLEAT_FORCE_UPDATE_CHECK:-}" ]] || (( now - last_check >= UPDATE_CHECK_INTERVAL )); then
    cached_version=$(latest_remote_tag || true)
    echo "$now $cached_version $declined_version" > "$UPDATE_CHECK_FILE" 2>/dev/null || true
  fi

  [[ -n "$cached_version" && "$cached_version" != "$VERSION" ]] || return 0
  # Already declined THIS exact version → stay quiet until an even newer one ships.
  [[ -n "$declined_version" && "$cached_version" == "$declined_version" ]] && return 0
  # Only prompt when the remote release is strictly newer: never nag to
  # downgrade (e.g. running a local prerelease ahead of the latest tag). Compare
  # on the numeric base, stripping any prerelease/build suffix, so the sort's
  # whole-line tiebreak can't mis-rank `X.Y.Z-rc1` against `X.Y.Z`.
  local base_cur="${VERSION%%[-+]*}" base_new="${cached_version%%[-+]*}"
  local newest
  newest=$(printf '%s\n%s\n' "$base_cur" "$base_new" \
    | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
  [[ "$newest" == "$base_new" && "$base_new" != "$base_cur" ]] || return 0

  echo ""
  info "Cleat update available: ${DIM}v${VERSION}${RESET} → ${BOLD}v${cached_version}${RESET}"
  local yn=""
  _ask_yn yn "Upgrade now? ${DIM}(re-runs as the new version)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    local _applied=1
    if [[ "$_channel" == "brew" ]]; then
      _apply_brew_update && _applied=0
    else
      _apply_cli_update "$cached_version" && _applied=0
    fi
    if (( _applied == 0 )); then
      success "Updated to v${cached_version}"
      info "Restarting with the new version…"
      _reexec_cli
    else
      warn "Update failed. Continuing on v${VERSION}."
    fi
  else
    # Record the decline so we don't re-prompt for this version every launch.
    echo "$now $cached_version $cached_version" > "$UPDATE_CHECK_FILE" 2>/dev/null || true
  fi
}

# Non-blocking release highlight. On the first RELEASE_HIGHLIGHT_MAX_SHOWS
# interactive, session-launching runs after VERSION changes, print a short note
# about the release's flagship feature, then go quiet for that version. Bounded
# repetition (not once, not forever): people miss a one-time note, and a
# forever-repeating one trains the eye to skip the startup block where the
# actionable drift/update/security notices live. Purely local (no network →
# CI/offline-safe) and NEVER prompts: the update check is the only thing allowed
# to ask at startup. State is "<version> <shown_count>" in $LAST_SEEN_VERSION_FILE.
# The copy below is the maintainer's editorial "what's new" news: written by
# hand, NOT auto-generated, and its version label is the feature's introduction
# version (a big feature may stay highlighted across several releases). Leave it
# as-is unless you have new news to announce; bump RELEASE_HIGHLIGHT_VERSION at
# tag time to re-surface it. A version mismatch shows nothing: fail-safe.
_maybe_show_release_highlight() {
  _is_tty || return 0
  # Only fire for the exact version this copy was written for.
  [[ "$RELEASE_HIGHLIGHT_VERSION" == "$VERSION" ]] || return 0

  local last_seen="" shown=0
  if [[ -f "$LAST_SEEN_VERSION_FILE" ]]; then
    last_seen=$(awk 'NR==1 {print $1}' "$LAST_SEEN_VERSION_FILE" 2>/dev/null || echo "")
    shown=$(awk 'NR==1 {print $2+0}' "$LAST_SEEN_VERSION_FILE" 2>/dev/null || echo 0)
  fi
  # Already shown the cap for this version → stay quiet.
  [[ "$last_seen" == "$VERSION" && "$shown" -ge "$RELEASE_HIGHLIGHT_MAX_SHOWS" ]] && return 0

  # A fresh version resets the counter; the same version increments it.
  local next=1
  [[ "$last_seen" == "$VERSION" ]] && next=$(( shown + 1 ))

  # Record the bumped count BEFORE printing so a Ctrl-C or write race can never
  # under-count (which would over-show). Brace-wrap so a redirect-open failure's
  # own stderr is suppressed too (plain `echo ... 2>/dev/null` doesn't catch the
  # shell's "Permission denied"). If the bump can't be persisted (read-only
  # install dir, unwritable stale file), the read-back fails and we stay SILENT
  # rather than show forever: "fail to silence, never to a permanent nag."
  { echo "$VERSION $next" > "$LAST_SEEN_VERSION_FILE"; } 2>/dev/null || true
  local confirm=""
  [[ -f "$LAST_SEEN_VERSION_FILE" ]] && confirm=$(awk 'NR==1 {print $1" "($2+0)}' "$LAST_SEEN_VERSION_FILE" 2>/dev/null || echo "")
  [[ "$confirm" == "$VERSION $next" ]] || return 0

  # Exactly one blank line above the news, no matter what preceded it. An
  # on-start notice (the Docker pressure block) sets _ONSTART_GAP_OPEN once it
  # has printed its own trailing blank, then we don't double it. Otherwise
  # (nothing printed, or a non-Docker-Desktop engine where the fix block is
  # skipped) we open the gap ourselves, so "New in …" never sits flush against a
  # warning or the shell prompt. The earlier design leaned on the advisory's
  # trailing blank for this, which vanished whenever the advisory's fix block was
  # gated out, leaving the news crammed against the warn line (observed
  # v0.16.1). We still own our OWN trailing blank below, so the bring-up that
  # follows needs none.
  [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
  info "${BOLD}New in v1.5.0${RESET}. ${CYAN}Accounts${RESET} and ${CYAN}sessions${RESET}."
  echo -e "    ${DIM}Manage a box's conversations one at a time, delete or restore from a trash: ${RESET}${BOLD}cleat session${RESET}${DIM} (Claude Code cannot delete just one).${RESET}"
  echo -e "    ${DIM}Pin a box to a named Claude login, held apart from your others and restorable from a trash of its own: ${RESET}${BOLD}cleat account${RESET}"
  echo -e "    ${DIM}Out of usage mid-run? Run ${RESET}${BOLD}cleat account <name>${RESET}${DIM} in another terminal. The session restarts on the other login and reopens the same conversation. Type ${RESET}${BOLD}continue${RESET}${DIM}.${RESET}"
  # A clickable, version-anchored changelog link. The /changelog page IDs each
  # release `id="vX.Y.Z"` (changelog.astro), so #v1.5.0 deep-links to the 1.5.0
  # release; _hyperlink makes it a real OSC 8 link where supported (clean short
  # text), else a bare clickable URL. Blue + underline reads as a link either
  # way. Keep the anchor version in lockstep with the "New in vX.Y.Z" label above.
  # printf, not `echo -e`: _hyperlink emits real escape bytes, and piping those
  # back through `echo -e` would re-interpret the OSC 8 string-terminator's
  # trailing `\` against ${RESET}'s leading `\033`. %b expands the colour vars;
  # %s passes the already-rendered link through untouched.
  printf '    %bChangelog:%b %b%b%s%b\n' \
    "$DIM" "$RESET" "$BLUE" "$UNDERLINE" \
    "$(_hyperlink "https://cleat.sh/changelog#v1.5.0" "cleat.sh/changelog#v1.5.0")" "$RESET"
  # Trailing blank: the highlight owns its own separation from whatever follows
  # (the bring-up, or the "Docker tuned"/swap line that runs after it), so flag
  # the gap open. Without this, a post-upgrade start with a well-sized VM (pressure
  # check silent, so it never set the flag) doubled the blank: the highlight's
  # trailing blank PLUS the confirmation's own leading blank. Same convention the
  # pressure block follows.
  echo ""
  _ONSTART_GAP_OPEN=1
}

# Fetch the newest released Claude Code version for a channel from the public
# releases endpoint (the same one the official installer reads). Stdout: a bare
# version like `2.1.149`, or empty on any failure. Tests inject a value via
# CLEAT_FAKE_REMOTE_CLAUDE so they never hit the network.
_claude_remote_version() {
  local channel="${1:-latest}"
  if [[ -n "${CLEAT_FAKE_REMOTE_CLAUDE:-}" ]]; then
    printf '%s' "$CLEAT_FAKE_REMOTE_CLAUDE"
    return 0
  fi
  command -v curl >/dev/null 2>&1 || return 0
  local v
  v="$(curl -fsSL "$CLAUDE_RELEASES_URL/$channel" 2>/dev/null)" || return 0
  # Take only the first line and strip surrounding whitespace, then require a
  # clean, fully-anchored semver. This rejects HTML/error pages and stops any
  # trailing or multiline bytes (e.g. ANSI escapes from a compromised/MITM'd
  # endpoint) from reaching the terminal display or the cache file.
  v="$(printf '%s' "$v" | head -n1 | tr -d '[:space:]')"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$ ]] || return 0
  printf '%s' "$v"
}

# On an interactive `cleat` start, check at most once every 10 minutes whether a newer
# Claude Code than the one baked into the image is available, and if so offer
# to upgrade the image before starting. "Yes" runs the durable image-commit
# upgrade (NOT an in-container `claude update`, which would be ephemeral), then
# cmd_run continues and starts a fresh container from the updated image.
# Designed never to block: non-interactive, opted-out, throttled, offline, or
# version-read failures all fall through silently.
_maybe_prompt_claude_update() {
  _is_tty || return 0
  [[ "${CLEAT_NO_CLAUDE_UPDATE_CHECK:-}" == "1" ]] && return 0
  image_exists || return 0

  local now last_check=0
  now="$(date +%s)"
  if [[ -f "$CLAUDE_CHECK_FILE" ]]; then
    last_check="$(awk 'NR==1 {print $1}' "$CLAUDE_CHECK_FILE" 2>/dev/null || echo 0)"
    [[ "$last_check" =~ ^[0-9]+$ ]] || last_check=0
  fi
  # Throttle to once per interval. CLEAT_FORCE_CLAUDE_CHECK bypasses (tests).
  if [[ -z "${CLEAT_FORCE_CLAUDE_CHECK:-}" ]] && (( now - last_check < CLAUDE_CHECK_INTERVAL )); then
    return 0
  fi

  # Resolve and STRICTLY validate the channel before it touches a URL or the
  # in-container shell command: CLEAT_CLAUDE_CHANNEL is user-controlled, so a
  # value like `2.1.0; rm -rf ~` must not slip through to _upgrade_claude_image.
  local channel="${CLEAT_CLAUDE_CHANNEL:-latest}"
  local _semver='^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$'
  case "$channel" in
    stable|latest) ;;
    *) [[ "$channel" =~ $_semver ]] || channel="latest" ;;
  esac

  local remote
  remote="$(_claude_remote_version "$channel")"
  # Record the attempt regardless of outcome so a flaky network can't nag on
  # every single start.
  echo "$now $remote" > "$CLAUDE_CHECK_FILE" 2>/dev/null || true
  [[ -n "$remote" ]] || return 0

  local local_v
  local_v="$(_image_claude_version)"
  [[ -n "$local_v" ]] || return 0
  [[ "$remote" != "$local_v" ]] || return 0
  # Only prompt when the remote version is strictly newer: never nag to
  # downgrade (e.g. when the image already runs a newer build than `stable`).
  # Compare on the numeric base, stripping any prerelease suffix (`-rc.1`), so a
  # pinned-prerelease channel doesn't mis-rank against a plain release.
  local base_local="${local_v%%[-]*}" base_remote="${remote%%[-]*}"
  local newest
  newest="$(printf '%s\n%s\n' "$base_local" "$base_remote" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
  [[ "$newest" == "$base_remote" ]] || return 0

  echo ""
  info "New Claude Code available: ${DIM}${local_v}${RESET} → ${BOLD}${remote}${RESET} ${DIM}(${channel})${RESET}"
  local yn=""
  _ask_yn yn "Update the image before starting? ${DIM}(downloads the new build)${RESET} [Y/n] "
  if [[ -z "$yn" || "$yn" == [yY]* ]]; then
    _upgrade_claude_image "$channel" || warn "Update failed. Starting with the current version."
  fi
  # Close the block with one blank line: this prompt opened with a leading blank
  # (above), so the bring-up that follows (Container started → Auth shared → …)
  # reads as its own contiguous group instead of sitting flush against the
  # "Claude Code upgraded" confirmation. Only reached when the prompt fired (all
  # the no-op early returns are above), so a start with no Claude update prints
  # neither blank.
  echo ""
}

# ── Commands ────────────────────────────────────────────────────────────────
cmd_build() {
  if image_exists; then
    # An image of the wrong architecture (e.g. an amd64 pull cached on an
    # Apple Silicon machine) counts as missing: every box created from it
    # would run emulated. Re-acquire a native one instead.
    if _image_arch_ok; then
      success "Image ready ${RESET}${DIM}(cached)"
      return
    fi
    _warn_image_emulated
  fi
  _do_pull || _do_build
}

_human_bytes() {
  local b="${1:-0}"
  [[ "$b" =~ ^[0-9]+$ ]] || { echo "?"; return; }
  [[ "$b" == "0" ]] && { echo "?"; return; }
  awk -v b="$b" 'BEGIN{
    split("B KB MB GB", u, " "); i=1
    while (b>=1024 && i<4) { b/=1024; i++ }
    printf("%.0f %s", b, u[i])
  }'
}

# Pull the prebuilt image from GHCR for a specific version (default: $VERSION),
# retagging it as $IMAGE_NAME on success. Returns 1 if the remote image isn't
# available so callers can fall back to a local build.
#
# Short-circuits when ${REGISTRY_BASE}:v${target_version} is already on disk:
# the only thing a pull would do in that case is verify cache freshness, and
# a transient registry/network error there shouldn't kick a perfectly good
# cached image out into a 2-5 min local build.
_do_pull() {
  local target_version="${1:-$VERSION}"
  local target_image="${REGISTRY_BASE}:v${target_version}"
  local log rc=0

  # Pin the pull to the daemon's architecture. A single-arch manifest of the
  # WRONG arch then fails loudly ('no matching manifest') and the caller's
  # `_do_pull || _do_build` falls back to a native local build, instead of
  # the pre-multi-arch behavior where docker pulled it anyway with a warning
  # the CLI discarded, and every box silently ran emulated. Empty daemon arch
  # (unreachable, exotic) omits the flag: today's behavior, fail-open.
  local arch platform_args=()
  arch="$(_daemon_arch)"
  [[ -n "$arch" ]] && platform_args=(--platform "linux/${arch}")
  local arch_note="${arch:+, ${arch}}"

  # Cache short-circuit: if the version-tagged prebuilt image is already on
  # disk AND matches the daemon arch, retag it as $IMAGE_NAME and skip the
  # network entirely. An arch-mismatched cache entry (an amd64 image pulled
  # before multi-arch publishing) must NOT short-circuit: fall through to
  # the platform-pinned pull so the native half of the manifest replaces it.
  # A failure to retag (rare: disk full, denied, etc.) must also fall
  # through so we never lie about success.
  if docker image inspect "$target_image" > /dev/null 2>&1 && _image_arch_ok "$target_image"; then
    if docker tag "$target_image" "$IMAGE_NAME" > /dev/null 2>&1; then
      local size_bytes size_human
      size_bytes=$(docker image inspect "$IMAGE_NAME" --format '{{.Size}}' 2>/dev/null || echo 0)
      size_human=$(_human_bytes "$size_bytes")
      success "Image ready ${RESET}${DIM}(cached v${target_version}${arch_note}, ${size_human})"
      return 0
    fi
    warn "Cached prebuilt image found but could not be tagged as ${IMAGE_NAME}; falling through to pull"
  fi

  log="$(mktemp)"

  if ! _is_tty; then
    info "Pulling image from ghcr.io ${DIM}(v${target_version}${arch_note})${RESET}"
    docker pull "${platform_args[@]+"${platform_args[@]}"}" "$target_image" > /dev/null 2>&1 || rc=$?
    if [[ $rc -ne 0 ]]; then
      warn "Prebuilt image unavailable for v${target_version}, building locally"
      rm -f "$log"
      return 1
    fi
    docker tag "$target_image" "$IMAGE_NAME" > /dev/null 2>&1 || true
    success "Image ready ${RESET}${DIM}(pulled v${target_version}${arch_note})"
    # Routine GC: drop superseded prebuilt tags and orphaned builds so each
    # update doesn't accrete another ~1-2 GB. Silent and fail-soft: images
    # still referenced by a container are kept.
    cmd_prune > /dev/null 2>&1 || true
    rm -f "$log"
    return 0
  fi

  # TTY: run docker pull in the background and animate progress by tailing
  # its line-per-event output (non-TTY docker pull writes one line per layer
  # event: "Pulling fs layer", "Downloading", "Extracting", "Pull complete").
  ( docker pull "${platform_args[@]+"${platform_args[@]}"}" "$target_image" > "$log" 2>&1 ) &
  local pull_pid=$!

  local frames
  if _has_unicode; then
    frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  else
    frames=('-' '\' '|' '/')
  fi

  _cursor_hide

  local i=0 total=0 complete=0 status
  while kill -0 "$pull_pid" 2>/dev/null; do
    if [[ -s "$log" ]]; then
      total=$(grep -c 'Pulling fs layer' "$log" 2>/dev/null || true)
      complete=$(grep -c 'Pull complete' "$log" 2>/dev/null || true)
      total="${total:-0}"
      complete="${complete:-0}"
    fi
    if (( total > 0 )); then
      status="${complete}/${total} layers"
    else
      status="connecting…"
    fi
    printf "\r\033[K  ${BLUE}%s${RESET} Pulling ${BOLD}cleat:v%s${RESET} from ghcr.io ${DIM}(%s)${RESET}" \
      "${frames[$i]}" "$target_version" "$status"
    i=$(( (i + 1) % ${#frames[@]} ))
    sleep 0.08
  done

  wait "$pull_pid"
  rc=$?
  _cursor_show

  if [[ $rc -ne 0 ]]; then
    printf "\r\033[K  ${AMBER}!${RESET} Prebuilt image unavailable for v%s, building locally\n" \
      "$target_version"
    rm -f "$log"
    return 1
  fi

  docker tag "$target_image" "$IMAGE_NAME" > /dev/null 2>&1 || true

  local size_bytes size_human
  size_bytes=$(docker image inspect "$IMAGE_NAME" --format '{{.Size}}' 2>/dev/null || echo 0)
  size_human=$(_human_bytes "$size_bytes")

  printf "\r\033[K  ${GREEN}✔${RESET} Image ready ${DIM}(pulled v%s%s, %s)${RESET}\n" \
    "$target_version" "$arch_note" "$size_human"
  # Routine GC: see the non-TTY path above.
  cmd_prune > /dev/null 2>&1 || true
  rm -f "$log"
  return 0
}

_do_build() {
  # A local build needs the docker/ context that ships next to the script. It
  # is not always there: on macOS before 12.3 `readlink -f` does not resolve
  # the invoking symlink, so REPO_DIR falls back to the symlink's own parent,
  # which for a Homebrew keg is the PREFIX rather than the keg. This path is
  # reached at SESSION START, not only from `cleat rebuild`, because every
  # image acquisition is `_do_pull || _do_build`. Without this check a keg user
  # whose pull failed (offline, a registry outage or rate limit, an arch the
  # release did not publish) gets a raw docker error about a context that does
  # not exist, instead of being told the pull is the thing to retry.
  if [[ ! -f "$REPO_DIR/docker/Dockerfile" ]]; then
    error "No local build context: ${BOLD}${REPO_DIR}/docker${RESET} is missing."
    echo -e "    ${DIM}This install can only use the prebuilt image, so the pull is what has to work.${RESET}"
    echo -e "    ${DIM}Retry when the registry is reachable: ${BOLD}cleat build${RESET}"
    if _is_brew_managed "${BASH_SOURCE[0]}"; then
      echo -e "    ${DIM}Still failing? Reinstall the keg: ${BOLD}brew reinstall cleatdev/tap/cleat${RESET}"
    fi
    # exit, not return: every caller is `_do_pull || _do_build`, so returning
    # would let the run continue toward a container with no image.
    exit 1
  fi

  local build_log
  build_log="$(mktemp)"
  spin "Building image..."
  local rc=0
  docker build -f "$REPO_DIR/docker/Dockerfile" -t "$IMAGE_NAME" \
    --label "sh.cleat.version=$VERSION" \
    --label "sh.cleat.image-spec=$_IMAGE_SPEC_VERSION" "$REPO_DIR/docker" >"$build_log" 2>&1 || rc=$?
  spin_stop "$rc" "Image ready" "Image build failed"
  if [[ $rc -ne 0 ]]; then
    echo ""
    echo -e "  ${DIM}Build log:${RESET}"
    tail -20 "$build_log" | sed 's/^/    /'
    rm -f "$build_log"
    exit 1
  fi
  rm -f "$build_log"
  # Routine GC: the build that was just replaced is now a dangling
  # sh.cleat.version image (1.5-2.5 GB). Silent, fail-soft, keeps anything a
  # container still references.
  cmd_prune > /dev/null 2>&1 || true
}

cmd_rebuild() {
  local build_log
  build_log="$(mktemp)"
  spin "Rebuilding image..."
  local rc=0
  docker build --no-cache -f "$REPO_DIR/docker/Dockerfile" -t "$IMAGE_NAME" \
    --label "sh.cleat.version=$VERSION" \
    --label "sh.cleat.image-spec=$_IMAGE_SPEC_VERSION" "$REPO_DIR/docker" >"$build_log" 2>&1 || rc=$?
  spin_stop "$rc" "Image rebuilt" "Image build failed"
  if [[ $rc -ne 0 ]]; then
    echo ""
    echo -e "  ${DIM}Build log:${RESET}"
    tail -20 "$build_log" | sed 's/^/    /'
    rm -f "$build_log"
    exit 1
  fi
  rm -f "$build_log"
  # Routine GC: see _do_build. Drift rebuilds are the main bloat source: a
  # maintainer's image churns daily and every rebuild orphaned the previous.
  cmd_prune > /dev/null 2>&1 || true
}

# Upgrade the Claude Code build bundled inside the shared image.
#
# Claude Code lives at ~/.local/share/claude/versions/<v> in the image and is
# NOT host-mounted, so it's frozen at image build/pull time. This re-runs the
# official installer in a throwaway container from the current image and
# `docker commit`s the result back, durably baking the new version into
# $IMAGE_NAME (fast: only the new binary is downloaded).
#
# The upgrade is local-only: `cleat rebuild`, `cleat update`, and `cleat nuke`
# reset $IMAGE_NAME to a fresh release image (which already bundles a current
# Claude Code) and discard this commit. That's intentional: a CLI release
# supersedes a manual bump. Re-run this if a release happens to bundle an older
# Claude Code than you had.
#
# Usage: cleat upgrade-claude [stable|latest|VERSION]   (default: latest)
cmd_upgrade_claude() {
  local channel="${1:-latest}"

  # Validate strictly. The channel is interpolated into the container's shell
  # command, so anything but `stable`, `latest`, or a bare semver would be a
  # command-injection vector (e.g. `2.1.0; rm -rf ~`). The regex admits an
  # optional prerelease/build suffix (`-rc.1`, `.20240101`) but no shell
  # metacharacters, whitespace, or slashes.
  local _semver='^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$'
  case "$channel" in
    stable|latest) ;;
    *)
      if [[ ! "$channel" =~ $_semver ]]; then
        error "Invalid version: ${BOLD}${channel}${RESET}."
        echo -e "    ${DIM}Use ${BOLD}stable${RESET}${DIM}, ${BOLD}latest${RESET}${DIM}, or a version like ${BOLD}2.1.156${RESET}${DIM}.${RESET}"
        exit 1
      fi
      ;;
  esac

  _upgrade_claude_image "$channel" || exit 1

  # Existing containers were created from the old image and still run the old
  # Claude Code. Recreate the current project's container so the upgrade takes
  # effect immediately (sessions live on the host and are preserved).
  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project")"
  if container_exists "$cname"; then
    if _is_tty; then
      local yn=""
      _ask_yn yn "Recreate ${BOLD}${cname}${RESET} now to use it? [Y/n] "
      if [[ -z "$yn" || "$yn" == [yY]* ]]; then
        if is_running "$cname"; then
          docker stop "$cname" > /dev/null 2>&1 || true
        fi
        docker rm -f "$cname" > /dev/null 2>&1 || true
        _account_wipe_run_dir "${cname}"
        success "Removed ${BOLD}${cname}${RESET}."
        cmd_run "$project"
        return
      fi
    fi
    info "Run ${BOLD}cleat rm && cleat${RESET} to use the new Claude Code in ${BOLD}${cname}${RESET}."
  fi
  echo -e "  ${DIM}Other projects pick up the new Claude Code next time their container is recreated.${RESET}"
}

# Core upgrade: re-install Claude Code into the local image for <channel> and
# commit the result back over the image. The channel MUST be pre-validated by
# the caller (it is interpolated into the in-container shell command). Returns
# 0 on success, 1 on failure: it never exits the process and never recreates
# a container, so the on-start update prompt can update the image in place and
# then let cmd_run continue starting a fresh container from it.
_upgrade_claude_image() {
  local channel="$1"

  # Need an image to upgrade: build or pull one first if missing.
  if ! image_exists; then
    info "No image yet. Preparing one first..."
    _do_pull || _do_build
  fi
  # Defensive: if pull+build still left us without an image, stop here rather
  # than spawning a container against a non-existent reference.
  if ! image_exists; then
    error "No ${BOLD}${IMAGE_NAME}${RESET} image available to upgrade."
    return 1
  fi

  local before old_id
  before="$(_image_claude_version)"
  old_id="$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null || true)"

  # Carry the image's own labels across the commit below.
  #
  # `docker commit` writes a fresh config, so without this the upgraded image
  # loses sh.cleat.image-spec and sh.cleat.version. That is silent and it does
  # not nag: _maybe_prompt_image_rebuild fails OPEN when both are missing, on
  # purpose, because an unlabelled image is assumed hand-built. The cost is the
  # other direction. Once a box has taken one Claude update, a genuine spec bump
  # can never prompt that user to rebuild again, so they quietly stop receiving
  # image changes that matter. Measured on the maintainer's own machine, where
  # the only surviving label was Docker Desktop's.
  local _lbl_spec _lbl_ver
  _lbl_spec="$(_image_spec_version)"
  _lbl_ver="$(_image_cleat_version)"

  local tmp="cleat-claude-upgrade"
  # Self-heal a leftover container from a previously interrupted run.
  docker rm -f "$tmp" > /dev/null 2>&1 || true

  local log
  log="$(mktemp 2>/dev/null)" || log="/tmp/cleat-upgrade.$$"
  : > "$log" 2>/dev/null || true

  # Build the in-container command. Notes on why each piece matters:
  #   set -euo pipefail  (without pipefail, a failed `curl` feeds empty input
  #                        to `bash` which exits 0, so a network failure would
  #                        silently commit an UNCHANGED image. This makes the
  #                        installer download failure abort the whole run.
  #   absolute paths     (HOME is always /home/coder in the image; hardcoding
  #                        avoids any empty-$HOME `rm -rf /...` surprise.
  #   test -x readlink   (verifies the installer actually produced a runnable
  #                        claude binary before we commit it. A broken/partial
  #                        install fails here instead of being baked in.
  # `$channel` is safe to interpolate: validated above.
  local install_cmd
  install_cmd='set -euo pipefail; curl -fsSL https://claude.ai/install.sh | bash -s -- '"$channel"'; rm -rf /home/coder/.claude/downloads; test -x "$(readlink -f /home/coder/.local/bin/claude)"'

  spin "Upgrading Claude Code (${channel})..."
  local rc=0
  # The image ENTRYPOINT remaps UID/GID as root then drops to the coder user.
  # Pass the host UID/GID so the installer writes ~/.local owned by the SAME uid
  # the runtime container will remap coder to. Without this the throwaway defaults
  # to the image-baked uid (1000), baking a 1000-owned ~/.local that a host-uid
  # (e.g. macOS 501) runtime can't write, breaking manual `claude update`.
  docker run --name "$tmp" -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)" "$IMAGE_NAME" bash -c "$install_cmd" > "$log" 2>&1 || rc=$?

  if [[ $rc -eq 0 ]]; then
    # Commit the updated filesystem over the working image. Restore the default
    # CMD: the throwaway container overrode it with the install command, and
    # `docker commit` would otherwise bake that in (breaking `cleat run`, which
    # relies on the image's `["bash"]` CMD to keep the container alive).
    local _commit_changes=(--change 'CMD ["bash"]')
    # Re-stamp only what was actually there: an image that never carried a
    # label must not gain a fabricated one.
    [[ -n "$_lbl_spec" ]] && _commit_changes+=(--change "LABEL sh.cleat.image-spec=${_lbl_spec}")
    [[ -n "$_lbl_ver" ]] && _commit_changes+=(--change "LABEL sh.cleat.version=${_lbl_ver}")
    docker commit "${_commit_changes[@]}" "$tmp" "$IMAGE_NAME" >> "$log" 2>&1 || rc=$?
  fi
  docker rm -f "$tmp" > /dev/null 2>&1 || true

  # Fold the version delta straight into the success line so the result is a
  # single row, "Claude Code upgraded (2.1.156 → 2.1.161)", instead of a green
  # check followed by a separate version line. Read the new version BEFORE
  # spin_stop, and keep the message plain text: spin_stop's TTY path prints it
  # with printf %s, which would NOT interpret embedded color escapes.
  local after="" ok_msg="Claude Code upgraded"
  if [[ $rc -eq 0 ]]; then
    after="$(_image_claude_version)"
    if [[ -n "$before" && -n "$after" && "$before" != "$after" ]]; then
      ok_msg="Claude Code upgraded (${before} → ${after})"
    elif [[ -n "$after" && "$before" == "$after" ]]; then
      ok_msg="Claude Code already at ${after} (no change)"
    elif [[ -n "$after" ]]; then
      ok_msg="Claude Code upgraded (now ${after})"
    fi
  fi
  spin_stop "$rc" "$ok_msg" "Upgrade failed"

  if [[ $rc -ne 0 ]]; then
    echo ""
    echo -e "  ${DIM}Upgrade log:${RESET}"
    tail -20 "$log" 2>/dev/null | sed 's/^/    /'
    rm -f "$log"
    return 1
  fi
  rm -f "$log"

  if [[ -z "$after" ]]; then
    warn "Upgrade committed, but could not read the installed Claude Code version."
  fi

  # Drop the now-orphaned pre-commit layer so repeated upgrades don't stack
  # dangling images. Best-effort and heavily guarded: only when the old id is
  # truly untagged (a version tag like cleat:vX.Y.Z would keep it) and not
  # referenced by any container: `docker rmi` refuses both, harmlessly.
  if [[ -n "$old_id" ]]; then
    local new_id old_tags
    new_id="$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null || true)"
    if [[ "$old_id" != "$new_id" ]]; then
      old_tags="$(docker image inspect "$old_id" --format '{{len .RepoTags}}' 2>/dev/null || echo 1)"
      [[ "$old_tags" == "0" ]] && docker rmi "$old_id" > /dev/null 2>&1 || true
    fi
  fi

  return 0
}

# The Python program behind the unsafe-rm capability's PermissionRequest hook.
# Claude Code keeps a bypass-immune "dangerous rm" prompt alive even under
# --dangerously-skip-permissions (a compiled circuit breaker, upstream WAI, see
# concept/42-unsafe-rm.md). A PermissionRequest hook returning a plain
# {behavior:"allow"} with no updatedInput is the one documented way to answer it,
# and it works on the box's interactive path.
#
# This is a SINGLE SOURCE OF TRUTH: cmd_run injects it into the box's settings
# overlay via jq, and the unit tests run it directly against sample event JSON.
# It runs INSIDE the box (python3 ships in the image). It reads the hook event on
# stdin and answers "allow" when any top-level segment of the Bash command invokes
# rm or rmdir, so chained cleanups are allowed whatever sits beside the rm. A
# removal only inside a substitution (`echo $(rm -rf x)`) does not count. A
# command with no top-level removal gets no answer. It never emits "deny", so a
# command it does not answer leaves the permission flow untouched.
_unsafe_rm_hook_program() {
  cat <<'URM_PY'
import sys, json, re, shlex
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
ti = d.get("tool_input")
cmd = ti.get("command") if isinstance(ti, dict) else None
if not isinstance(cmd, str) or not cmd.strip():
    sys.exit(0)
# Answer only when the command actually invokes a removal. Real cleanups are
# chained (an assignment, a comment, a mkdir, then the rm), so requiring EVERY
# segment to be rm/cd made the cap useless in practice. It also bought little:
# under --dangerously-skip-permissions the agent can already run any non-rm
# command, `curl x | sh` included, with no prompt at all, so restricting what
# may sit BESIDE the rm gates nothing the box did not already allow. What the
# saw_rm requirement still guarantees is that this hook never answers a prompt
# for a command that removes nothing, so it cannot blanket-approve an unrelated
# permission ask. An rm hidden inside a substitution is not a top-level removal
# and does not qualify.
saw_rm = False
for seg in re.split(r"&&|\|\||[;&|\n]", cmd):
    seg = seg.strip()
    if not seg:
        continue
    try:
        # comments=True so a full-line "# note" segment tokenises to nothing and
        # is skipped like a bare assignment. Without it the base command reads as
        # "#" and one comment line disqualifies an entire commented cleanup block.
        toks = shlex.split(seg, comments=True)
    except Exception:
        continue
    i = 0
    while i < len(toks) and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[i]):
        i += 1
    if i >= len(toks):
        continue
    base = toks[i].rsplit("/", 1)[-1]
    if base in ("rm", "rmdir"):
        saw_rm = True
        break
if saw_rm:
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PermissionRequest",
            "decision": {"behavior": "allow"},
        }
    }))
URM_PY
}

# Add the unsafe-rm PermissionRequest hook to an already-written settings overlay
# file. Idempotent enough for the recreate rail (the overlay is rewritten from
# scratch each cmd_run). Fails LOUD and leaves the guard on if jq is missing or
# errors: the safe direction is the prompt staying, never silently-off.
_inject_unsafe_rm_hook() {
  local settings_file="$1"
  if ! command -v jq >/dev/null 2>&1; then
    warn "unsafe-rm: jq not found on the host, cannot install the delete-allow hook. The box's delete-safety prompt stays ON."
    return 0
  fi
  local _prog _out
  _prog="$(_unsafe_rm_hook_program)"
  _out="$(jq --arg prog "$_prog" '
    .hooks.PermissionRequest = ((.hooks.PermissionRequest // []) + [{
      matcher: "Bash",
      hooks: [{ type: "command", command: ("python3 -c " + ($prog | @sh)) }]
    }])
  ' "$settings_file" 2>/dev/null)" || true
  if [[ -n "$_out" ]]; then
    printf '%s\n' "$_out" > "$settings_file"
  else
    warn "unsafe-rm: could not write the delete-allow hook (jq failed). The box's delete-safety prompt stays ON."
  fi
}

cmd_run() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  _RESOLVED_PROJECT="$project"
  local cname
  cname="$(container_name_for "$project" "$box")"

  # Before anything can remove a container. cmd_start and cmd_resume preflight
  # ahead of calling here, but `cleat run <box> --fork` reaches this directly,
  # and the container_exists branch below does a plain `docker rm`. So --fork
  # aimed at an existing PLAIN box used to silently destroy that box's writable
  # layer and rebuild it on a copy, which is worse than the silent no-op the
  # preflight was written to stop. Running it here refuses instead, and puts
  # `run` and `start` on the same answer.
  _fork_preflight "$cname" recreate

  if is_running "$cname"; then
    warn "Container ${BOLD}${cname}${RESET} already running for this project."
    return
  fi

  if container_exists "$cname"; then
    docker rm "$cname" > /dev/null
  fi

  if ! image_exists; then
    _do_pull || _do_build
  elif ! _image_arch_ok; then
    # Wrong-arch image (e.g. an amd64 pull cached on Apple Silicon) counts as
    # missing: a box created from it would run emulated. Re-acquire native.
    _warn_image_emulated
    _do_pull || _do_build
  else
    # No leading blank: the bring-up block (Image ready/rebuilt → Container
    # started → …) stays one contiguous coloured group. Separation from the
    # preceding notices is owned by those notices (the release highlight emits
    # a trailing blank), so a rebuild's "Image rebuilt" flows straight into
    # this line instead of being split by a stray blank. See concept/21.
    success "Image ready ${RESET}${DIM}(cached)"
  fi

  # If the image was built by an older Cleat, offer to rebuild it before we
  # create the container (so the fresh container picks up the new setup).
  _maybe_prompt_image_rebuild "$cname"

  # If a newer Claude Code than the image ships is available, offer to bump it
  # (durably, by committing into the image) before we start the container.
  _maybe_prompt_claude_update

  if [[ ! -d "$project" ]]; then
    error "Project directory does not exist: ${BOLD}${project}${RESET}"
    exit 1
  fi

  # Resolve capabilities and env for this run
  resolve_caps "$project"
  resolve_env_args "$project"

  # ── Forked workspace ──────────────────────────────────────────────────────
  # A fork box mounts its own COPY at /workspace. $project stays the real path
  # everywhere else, so naming, trust, caps and kits are untouched.
  local _workspace="$project"
  local _fork_path=""
  # An explicit --fork ALWAYS ensures a copy exists. Guarding only on "is this
  # already a fork" made an interrupted or failed first run unrecoverable: the
  # marker is written once the copy lands, so a `docker run` that then failed
  # left a marked box with no container, and the next `--fork` refused instead
  # of healing. Refusing is right when the user did NOT ask for a fork (that is
  # the silent re-bind guard below); it is wrong when they typed the flag.
  if [[ "${_FORK_REQUESTED:-false}" == true ]] \
     && { ! _box_is_fork "$cname" || [[ ! -d "$(_fork_dir "$cname")" ]]; }; then
    _fork_path="$(_fork_dir "$cname")"
    # Refuse to fork a directory that already lives under the fork root: a fork
    # of a fork nests copies without bound.
    # BOTH sides resolved the same way. Mixing a physical path with a logical
    # one made these guards no-ops wherever the path crosses a symlink, which
    # on macOS is everything under /tmp and /var/folders.
    local _froot _pp _fr_phys
    _froot="$(_fork_root)"
    _fr_phys="$(_phys_or_best "$_froot")"
    _pp="$(_phys_or_best "$project")"
    case "$_pp/" in
      "$_fr_phys"/*) error "Refusing to fork a fork: ${project/#${HOME}/~}"; exit 1 ;;
    esac
    # And the mirror case: a fork root INSIDE the project, which someone will
    # reach for wanting the copy near the code. The copy would then contain the
    # fork root and recurse. GNU cp happens to catch this ("cannot copy a
    # directory into itself") but BSD cp is a different implementation and the
    # failure mode if it does not is a disk-filling loop, so refuse explicitly
    # rather than relying on the tool. Compared physically so a symlinked
    # project path cannot slip past.
    case "$_fr_phys/" in
      "$_pp"/*) error "Fork root is inside the project: ${_froot/#${HOME}/~}"
                echo -e "    ${DIM}The copy would contain itself. Point ${BOLD}[fork] dir${RESET}${DIM} outside the project.${RESET}"
                exit 1 ;;
    esac
    # Its own spinner phase: the copy can take a moment on a filesystem
    # without copy-on-write, and printing into an already-running spinner
    # leaves a frozen glyph and two messages on one line.
    local _copy_rc=0
    spin "Copying workspace..."
    _fork_copy_tree "$project" "$_fork_path" || _copy_rc=$?
    spin_stop "$_copy_rc" "Workspace copied" "Workspace copy failed"
    if [[ $_copy_rc -ne 0 ]]; then
      rm -rf "$_fork_path"
      error "Could not copy the workspace. The fork was not created."
      # NOT "exclude it with a [fork] exclude line": excludes are pruned AFTER
      # the copy, so they cannot prevent a copy that fails. Pointing at them
      # sent the user to a setting that could never fix what they were seeing.
      echo -e "    ${DIM}Usually an unreadable file in the project, or no space left. Check permissions and free space, then retry.${RESET}"
      exit 1
    fi
    _fork_prune_excludes "$_fork_path" "$project" "$box"
    _fork_mark "$cname"
  fi
  if _box_is_fork "$cname"; then
    _fork_path="$(_fork_dir "$cname")"
    # The marker says this box is a fork. If the copy is gone we must NOT fall
    # back to the live tree: that is the silent re-bind this marker exists to
    # prevent. Refuse and tell the user how to resolve it.
    if [[ ! -d "$_fork_path" ]]; then
      error "This box is a fork but its workspace copy is missing."
      echo -e "    ${DIM}Expected: ${_fork_path/#${HOME}/~}${RESET}"
      echo -e "    ${DIM}Recreate it with ${BOLD}cleat start ${_BOX} --fork${RESET}${DIM}, or drop the fork with ${BOLD}cleat fork rm ${_BOX}${RESET}${DIM}.${RESET}"
      exit 1
    fi
    _workspace="$_fork_path"
  fi


  spin "Starting container..."

  # Clipboard bridge
  local clip_dir="$CLEAT_RUN_DIR/${cname}/clip"
  mkdir -p "$clip_dir"

  # ── Settings overlay ──────────────────────────────────────────────────────
  # When hooks OFF: strip hooks from settings (they'd fail in the container).
  # When hooks ON:  replace hook commands with an event forwarder; the host-side
  #                 bridge reads forwarded events and executes the real commands.
  local settings_overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  rm -rf "$settings_overlay_dir"
  mkdir -p "$settings_overlay_dir"
  local _overlay_ok=false
  if [[ -f "${HOME}/.claude/settings.json" ]] && [[ -s "${HOME}/.claude/settings.json" ]]; then
    if command -v jq &>/dev/null; then
      if cap_is_active hooks; then
        # Replace hook commands with forwarder; preserve event types and matchers
        local _forwarded
        _forwarded="$(jq '
          if .hooks then
            .hooks |= with_entries(.value |= [.[] |
              .hooks = [.hooks[] | select(.type == "command") |
                .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
              ]
            ])
          else . end
        ' "${HOME}/.claude/settings.json" 2>/dev/null)" || true
        if [[ -n "$_forwarded" ]]; then
          echo "$_forwarded" > "$settings_overlay_dir/settings.json"
          _overlay_ok=true
        fi
      else
        local _stripped
        _stripped="$(jq 'del(.hooks)' "${HOME}/.claude/settings.json" 2>/dev/null)" || true
        if [[ -n "$_stripped" ]]; then
          echo "$_stripped" > "$settings_overlay_dir/settings.json"
          _overlay_ok=true
        fi
      fi
    fi
  fi
  if ! $_overlay_ok; then
    echo '{}' > "$settings_overlay_dir/settings.json"
  fi

  # ── unsafe-rm guard capability ─────────────────────────────────────────────
  # Append the delete-allow PermissionRequest hook AFTER the hooks strip/forward
  # above, so it is never turned async (an async hook cannot answer a prompt) and
  # never stripped. Only when the cap is active, which is global/CLI only.
  if cap_is_active unsafe-rm; then
    _inject_unsafe_rm_hook "$settings_overlay_dir/settings.json"
  fi

  # ── Per-project session isolation ──────────────────────────────────────
  # Claude Code stores sessions under ~/.claude/projects/<key>/ where key
  # is derived from the CWD. Inside containers CWD is always /workspace,
  # so all containers write to ~/.claude/projects/-workspace/. We overlay
  # that path with a per-project directory so each container sees only its
  # own sessions. Input history (arrow-up) lives in ~/.claude/history.jsonl.
  # We overlay that too so each project has its own history.
  # The base ~/.claude mount provides auth and global config.
  local project_session_key
  project_session_key="$(_derive_project_session_key "$project" "$box")"
  local project_session_dir="${HOME}/.claude/projects/${project_session_key}"
  mkdir -p "$project_session_dir"
  # Ensure per-project history file exists (Docker needs the source for bind mounts)
  touch "$project_session_dir/history.jsonl"
  # Also ensure host history.jsonl exists (macOS virtiofs rejects nested mounts
  # when the target file is missing inside the parent bind mount's source)
  touch "${HOME}/.claude/history.jsonl"
  # Also ensure the overlay target exists in the base mount (Docker needs it)
  mkdir -p "${HOME}/.claude/projects/-workspace"
  # Also ensure the settings-mask target exists in the base mount. Same
  # VirtioFS constraint as history.jsonl above: on macOS the nested file
  # mount fails when its target is missing inside the parent bind source. A
  # fresh host that never ran native claude has no ~/.claude/settings.json
  # (found 2026-07-10 running the integration suite against a real macOS
  # daemon; every developer machine masked it because the file existed).
  # Write '{}', not an empty file, so native claude still reads valid JSON.
  [[ -f "${HOME}/.claude/settings.json" ]] || echo '{}' > "${HOME}/.claude/settings.json"

  # ── Kit overlay (concept/34) ──────────────────────────────────────────────
  # Read-only masks over the base ~/.claude mount replace what the box sees at
  # ~/.claude/CLAUDE.md, agents, commands and skills with host-generated
  # content (the user's own content + the enabled kit for CLAUDE.md/agents, or
  # a plain pass-through copy). Mounted on EVERY box so enabling, switching, or
  # disabling a kit later is a content regeneration, never a recreate. :ro so
  # the caged agent cannot rewrite its own instructions, and (the hardening
  # property) can no longer write ANY of the host-user-level instruction
  # surfaces through the base mount that native host claude would obey: memory,
  # subagents, slash commands, skills and plugins. skills is the sharpest of
  # them: Claude Code auto-loads whatever sits there as a <name>@skills-dir
  # plugin, with no user action. plugins is self-masked (the host path over
  # itself, no copy) because it is a live runtime tree, 9 MB with a git
  # checkout in it. Read-only at its NORMAL path is deliberate: measured
  # 2026-07-25, claude reads marketplaces and installed plugins fine from a
  # read-only plugins dir, but redirecting the root with
  # CLAUDE_CODE_PLUGIN_CACHE_DIR made it report "No marketplaces configured"
  # and "No plugins installed", so the redirect was dropped. Installing a NEW
  # plugin inside a box fails EROFS by design; install on the host.
  # The box still READS the user's real content
  # (pass-through copy). Project-level /workspace/.claude/* is unaffected
  # (still writable in the repo).
  _generate_kit_overlay "$cname"
  # Mask targets must exist on the host before the nested mounts (VirtioFS);
  # dies with a clear remedy on a broken symlink or a wrong-type target, BEFORE
  # docker run sees it. Explicit rather than left to set -e, which a caller in a
  # conditional would switch off. See _ensure_kit_mask_targets.
  _ensure_kit_mask_targets || exit 1

  # Per-box replacements for the cross-project surfaces. See
  # _generate_home_overlay: a :ro self-mask would block writes but not reads,
  # so these are generated empties, never the host content.
  _generate_home_overlay "$cname" "$_workspace" "$project_session_key"
  local home_overlay="$CLEAT_RUN_DIR/${cname}/home"

  local mount_args=(
    -v "$_workspace":/workspace
    -v "${HOME}/.claude:/home/coder/.claude"
    -v "$settings_overlay_dir/settings.json:/home/coder/.claude/settings.json"
    -v "$home_overlay/projects:/home/coder/.claude/projects:ro"
    -v "${project_session_dir}:/home/coder/.claude/projects/-workspace"
    -v "${project_session_dir}/history.jsonl:/home/coder/.claude/history.jsonl"
    -v "$CLEAT_RUN_DIR/${cname}/kit/CLAUDE.md:/home/coder/.claude/CLAUDE.md:ro"
    -v "$CLEAT_RUN_DIR/${cname}/kit/agents:/home/coder/.claude/agents:ro"
    -v "$CLEAT_RUN_DIR/${cname}/kit/commands:/home/coder/.claude/commands:ro"
    -v "$CLEAT_RUN_DIR/${cname}/kit/skills:/home/coder/.claude/skills:ro"
    -v "$CLEAT_RUN_DIR/${cname}/auth:${_ACCOUNT_BOX_DIR}"
    -v "${HOME}/.claude/plugins:/home/coder/.claude/plugins:ro"
    -v "$clip_dir":/tmp/cleat-clip
  )

  # Per-box private dirs, read-write so Claude Code can use them normally, but
  # backed by this box's own empty directory instead of the shared host one.
  local _pd
  for _pd in $_CLAUDE_PRIVATE_DIRS; do
    mount_args+=(-v "$home_overlay/$_pd:/home/coder/.claude/$_pd")
  done

  # The instruction surfaces, :ro over an empty overlay. This is what stops the
  # box creating a file at the ~/.claude root that a later session or the user's
  # own uncaged Claude Code would read as configuration or as hooks.
  local _id
  for _id in $_CLAUDE_INSTR_DIRS $_CLAUDE_INSTR_FILES; do
    mount_args+=(-v "$home_overlay/instr/$_id:/home/coder/.claude/$_id:ro")
  done

  # ── hooks capability: shared directory for event forwarding to host bridge
  if cap_is_active hooks; then
    local hooks_dir="$CLEAT_RUN_DIR/${cname}/hooks"
    mkdir -p "$hooks_dir"
    mount_args+=(-v "$hooks_dir":/var/log/cleat)
  fi

  # ── Project-level settings overlays ──────────────────────────────────────
  # When hooks ON:  replace hook commands with forwarder (host bridge executes originals)
  # When hooks OFF: strip hooks entirely (prevent container from running host commands)
  # Without an overlay, project .claude/settings*.json files are visible via the
  # workspace bind mount and Claude Code would try to run host commands (like
  # osascript) inside the container where they don't exist.
  # Guard on the WORKSPACE, not the project: for a fork box the nested mount
  # target lives inside the copy, and a copy without .claude would fail the
  # mount on macOS VirtioFS with an opaque "create mountpoint" error.
  if [[ -d "$_workspace/.claude" ]]; then
    local pf
    for pf in "$_workspace/.claude/settings.json" "$_workspace/.claude/settings.local.json"; do
      [[ -f "$pf" ]] || continue
      local _base _overlay_name
      _base="$(basename "$pf")"
      _overlay_name="project-$_base"
      # No jq on the host means we can neither rewrite the hook commands into the
      # forwarder nor strip them, and BOTH arms below used to fall through to a
      # verbatim `cp`. That mounted the user's real host hook commands into the
      # box, where Claude Code then ran them in the container: `osascript` and
      # every other host-only command simply is not there. Meanwhile the host
      # bridge never starts either, because _has_host_hooks needs jq to answer,
      # so the hooks silently ran nowhere at all.
      #
      # docs/cli.md already promises empty settings for a jq-less host, and the
      # resume-side refresh already writes `echo '{}'` in its own else branch, so
      # honour that here on both arms rather than copying. This is the create
      # path, the only one of the three that MOUNTS: resume and shell/claude are
      # both guarded at the block level and skip when jq is absent.
      #
      # Only a file that could define hooks gets the empty settings. One with no
      # `hooks` text anywhere and no `\u` escape (which could spell the key) is
      # passed through as v1.4.3 did, so its permissions, env and model still
      # reach the box. A false positive keeps the empty settings, never a leak.
      if ! command -v jq >/dev/null 2>&1; then
        if LC_ALL=C grep -q -e hooks -e '\\u' "$pf" 2>/dev/null; then
          echo '{}' > "$settings_overlay_dir/$_overlay_name"
          warn "Project .claude/${_base} defines hooks and jq is not installed on the host, so the box gets empty project settings. Install jq to pass the rest through."
        else
          cp "$pf" "$settings_overlay_dir/$_overlay_name"
        fi
      elif cap_is_active hooks; then
        # Replace hook commands with event forwarder
        if [[ -s "$pf" ]] && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
          jq '
            if .hooks then
              .hooks |= with_entries(.value |= [.[] |
                .hooks = [.hooks[] | select(.type == "command") |
                  .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
                ]
              ])
            else . end
          ' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
        else
          cp "$pf" "$settings_overlay_dir/$_overlay_name"
        fi
      else
        # Strip hooks so container can't run host-specific commands
        if [[ -s "$pf" ]] && command -v jq &>/dev/null && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
          jq 'del(.hooks)' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
        else
          cp "$pf" "$settings_overlay_dir/$_overlay_name"
        fi
      fi
      mount_args+=(-v "$settings_overlay_dir/$_overlay_name:/workspace/.claude/$_base")
    done
  fi

  # ── Per-project Claude global-state (.claude.json) isolation ──────────────
  # Build an isolated, persistent per-project ~/.claude.json instead of mounting
  # the shared host file directly. The shared mount let concurrent containers
  # truncate the file (→ "Configuration Error / Unexpected EOF") and leaked
  # trust/MCP approvals across projects. See _build_project_claude_json.
  local project_claude_json="$CLEAT_PROJECTS_DIR/${project_session_key}/claude.json"
  # The container name matters here, not only on the two refresh paths: a box
  # that is CREATED while pinned must not be stamped with the host account's
  # identity either. Without it a `cleat rm` followed by `cleat account <name>`
  # and a start gave the right credential with the wrong name on it, which is
  # what /usage inside the box shows.
  _build_project_claude_json "$project_claude_json" "" "$cname"
  mount_args+=(-v "$project_claude_json:/home/coder/.claude.json")

  # ── git capability: mount gitconfig (read-only) for commit identity
  if cap_is_active git; then
    if [[ -f "${HOME}/.gitconfig" ]]; then
      mount_args+=(-v "${HOME}/.gitconfig:/home/coder/.gitconfig:ro")
    fi
  fi

  # ── ssh capability: mount SSH keys (read-only) and forward agent
  if cap_is_active ssh; then
    if [[ -d "${HOME}/.ssh" ]]; then
      mount_args+=(-v "${HOME}/.ssh:/home/coder/.ssh:ro")
    fi
  fi

  local ssh_args=()
  if cap_is_active ssh && [[ -S "${SSH_AUTH_SOCK:-}" ]]; then
    ssh_args+=(-v "${SSH_AUTH_SOCK}:/tmp/ssh-agent.sock" -e "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
  fi

  # ── gh capability: mount GitHub CLI config (read-write) for token auth
  # Read-write so `gh auth login` inside the container writes tokens back to the
  # host, same model as ~/.claude. Create dir if missing so users can auth from
  # inside the container even without gh installed on the host.
  if cap_is_active gh; then
    mkdir -p "${HOME}/.config/gh"
    mount_args+=(-v "${HOME}/.config/gh:/home/coder/.config/gh")
  fi

  # ── docker capability: mount the host Docker socket so the container can
  # build, run, and manage Docker workloads against the host daemon. Also
  # bind-mount the project at its HOST path (in addition to /workspace) and
  # set workdir there, so $(pwd) returns a host-valid path and bind-mount
  # sources in `docker run -v $(pwd):/app` resolve on the host daemon.
  # Full rationale: concept/15-docker-capability.md.
  local docker_args=()
  if cap_is_active docker; then
    # Bind the Docker socket the box needs, correct for WHERE the daemon runs.
    # A bind SOURCE is resolved by the daemon on the DAEMON's filesystem:
    #  - VM-backed daemon (macOS Docker Desktop / Colima / OrbStack, or Docker
    #    Desktop on Linux): the daemon lives in a Linux VM where its socket is
    #    always /var/run/docker.sock; the host context path (~/.colima/...,
    #    ~/.docker/run/...) is only a forward the VM cannot bind (virtiofs
    #    rejects it, "operation not supported"). Bind the in-VM path. No host
    #    -S guard: the source resolves in-VM, not on the host.
    #  - Host-local daemon (native Linux rootful/rootless, WSL2 in-distro): the
    #    daemon shares the host fs, so bind the REAL host socket (rootless is
    #    /run/user/<uid>/docker.sock), guarded on a live socket because here a
    #    missing SOURCE would make the daemon create a phantom host DIRECTORY.
    #  - Remote (tcp/ssh): no socket to bind, hand the box DOCKER_HOST.
    # DOCKER_HOST wins over the active context (docker's own precedence).
    local _docker_ep _host_dsock
    _docker_ep="${DOCKER_HOST:-$(_docker_context_endpoint)}"
    _host_dsock="$(_resolve_host_docker_sock "$_docker_ep")"
    if [ -n "$_host_dsock" ] && _docker_pool_is_vm 2>/dev/null; then
      mount_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
    elif [ -n "$_host_dsock" ] && _host_sock_is_live "$_host_dsock"; then
      mount_args+=(-v "$_host_dsock:/var/run/docker.sock")
    elif [ -z "$_host_dsock" ] && _endpoint_is_loopback "$_docker_ep" \
         && _host_sock_is_live /var/run/docker.sock; then
      # A LOOPBACK tcp endpoint (dockerd -H tcp://127.0.0.1:2375, a local
      # socket-proxy, Docker Desktop's "expose the daemon on tcp://localhost
      # without TLS" as used from WSL2) is a HOST-LOCAL daemon, not a remote one.
      # Forwarding DOCKER_HOST would point the box at ITS OWN loopback, where
      # nothing listens, so bind the host socket the daemon also serves. Through
      # v1.4.2 this config got the unconditional socket bind and worked; keep it
      # working rather than silently breaking it.
      mount_args+=(-v /var/run/docker.sock:/var/run/docker.sock)
    elif [ -z "$_host_dsock" ] && [ -n "$_docker_ep" ]; then
      docker_args+=(-e "DOCKER_HOST=$_docker_ep")
      # A loopback endpoint with no host socket to fall back on cannot work from
      # inside the box: 127.0.0.1 there is the box itself. Say so plainly.
      if _endpoint_is_loopback "$_docker_ep"; then
        warn "docker cap: DOCKER_HOST is a loopback address ($_docker_ep) and no host socket was found at /var/run/docker.sock. Inside the box that address is the box itself, so its docker client will not reach the host daemon. Point DOCKER_HOST at a unix socket, or expose the daemon on a routable address."
      fi
      # A TLS-secured remote (tcp://…:2376, or DOCKER_TLS_VERIFY set) needs the
      # client certs (DOCKER_CERT_PATH, default ~/.docker) to connect. Cleat does
      # NOT forward them into the cage: those are host credentials and mounting
      # them would leak keys into the box, breaking the core pillar. Warn so the
      # in-box TLS handshake failure is not a silent mystery.
      local _tls=""
      [ -n "${DOCKER_TLS_VERIFY:-}" ] && _tls=1
      case "$_docker_ep" in tcp://*:2376) _tls=1 ;; esac
      if [ -n "$_tls" ]; then
        warn "docker cap: DOCKER_HOST points at a TLS-secured daemon, but Cleat does not forward the client certificates into the cage (they are host credentials). The box's docker client will fail the TLS handshake. Use a unix-socket or SSH docker context for the docker cap."
      fi
    else
      warn "docker cap: no live Docker socket at ${_host_dsock:-the daemon endpoint}. The box's docker client will not reach the host daemon until Docker is running. (cleat reads the engine from DOCKER_HOST and the active docker context.)"
    fi
    # A fork box must expose its COPY at the host path, never the live tree:
    # mounting $project here would hand a fork box the real working directory
    # read-write and point its workdir at it, cancelling the isolation.
    mount_args+=(-v "$_workspace:$_workspace")
    docker_args+=(--workdir "$_workspace" -e "CLEAT_HOST_PROJECT=$_workspace")
    # Session-dir unification: with the docker cap, workdir is the host path
    # (not /workspace), so Claude Code encodes its session directory from
    # that path ('/Users/marcin/proj' → 'projects/-Users-marcin-proj/')
    # instead of the v0.8.0-assumed 'projects/-workspace/'. Overlay the
    # per-project session dir at the host-path-derived location too, so
    # sessions land in the same place regardless of which cap was active
    # when they were created. Slashes become dashes to match Claude's key.
    # Keyed off the WORKSPACE, not the project: for a fork box the container
    # cd's into the copy, so the copy is the path Claude Code encodes. Using
    # $project here mounted the session dir under a key the box never looks at.
    local _host_project_key
    _host_project_key="$(_claude_session_key "$_workspace")"
    mkdir -p "${HOME}/.claude/projects/${_host_project_key}"
    mount_args+=(-v "${project_session_dir}:/home/coder/.claude/projects/${_host_project_key}")
  fi

  # ── Per-box memory ceiling. --memory-swap equal to --memory disables swap
  # for the box: a runaway process OOMs inside its own cgroup instead of
  # dragging the whole VM (and every other session) into swap-thrash.
  local box_memory
  box_memory="$(resolve_box_memory "$project" "$box")"

  # ── Per-box CPU ceiling, only when configured ([resources] cpus). No
  # default: CPU is work-conserving, so an unconfigured box keeps all cores.
  local box_cpus cpu_args=()
  box_cpus="$(resolve_box_cpus "$project" "$box")"
  [[ -n "$box_cpus" ]] && cpu_args=(--cpus "$box_cpus")

  # ── Compute config fingerprint and store as label, prefixed with the storage
  # format version so a later formula change is detectable (see _CONFIG_FP_VERSION).
  local config_hash
  config_hash="v${_CONFIG_FP_VERSION}:$(compute_config_fingerprint "$project")"

  local label_args=(
    --label "sh.cleat.config-hash=$config_hash"
    --label "sh.cleat.version=$VERSION"
    --label "sh.cleat.box=$box"
  )

  # ── Host connectivity: always-on so user-defined hooks and MCP servers work
  local host_args=()
  if ! _is_docker_desktop 2>/dev/null; then
    host_args+=(--add-host "host.docker.internal:host-gateway")
  fi

  # BROWSER points at the in-container open shim. Claude Code 2.1.191+ refuses
  # to invoke any opener on a display-less Linux system unless $BROWSER is set,
  # and its login drops to the manual code-paste flow; with BROWSER set it
  # opens through the shim and keeps the hands-free loopback login, which the
  # host-side callback proxy completes. Passed at create (not only baked into
  # the image) so boxes recreated from an older image get it too. Placed BEFORE
  # the user's [env] args: docker's last -e wins, so a .cleat `BROWSER=` can
  # override the shim.
  local _docker_err="/tmp/cleat-err.$$"
  local run_rc=0
  docker run -d \
    --name "$cname" \
    "${mount_args[@]}" \
    "${ssh_args[@]+"${ssh_args[@]}"}" \
    "${docker_args[@]+"${docker_args[@]}"}" \
    "${host_args[@]+"${host_args[@]}"}" \
    -e "BROWSER=/usr/local/bin/open-bridge" \
    "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" \
    "${label_args[@]}" \
    -e "HOST_UID=$(id -u)" \
    -e "HOST_GID=$(id -g)" \
    -e "HOME=/home/coder" \
    --pids-limit 4096 \
    --memory "$box_memory" \
    --memory-swap "$box_memory" \
    "${cpu_args[@]+"${cpu_args[@]}"}" \
    --init \
    -it \
    "$IMAGE_NAME" > /dev/null 2>"$_docker_err" || run_rc=$?
  spin_stop "$run_rc" "Container started" "Container failed to start"
  if [[ $run_rc -ne 0 ]]; then
    [[ -s "$_docker_err" ]] && error "${DIM}$(cat "$_docker_err")${RESET}"
    # A full store is a common opaque bring-up failure. The disk gate cannot read
    # fill when the box will not start, so this ENOSPC backstop covers it.
    _maybe_explain_enospc "$_docker_err"
    rm -f "$_docker_err"
    # Clean up any partial container state so the next attempt starts fresh
    docker rm -f "$cname" > /dev/null 2>&1 || true
    exit 1
  fi
  rm -f "$_docker_err"

  # A --desc set at creation time (host-side, keyed by cname; never recreates).
  if [[ "${_CLI_DESC_SET:-0}" == "1" ]]; then
    _box_desc_write "$cname" "$_CLI_DESC"
  fi

  # First run of this fresh container: apply [setup] provisioning, if any was
  # approved by the resolve_caps call above. Covers direct `cleat run` and
  # every recreate funnel that ends up here.
  _maybe_run_setup "$cname" "$project" "${_BOX:-main}" || true
}

# Re-create the nested mount targets inside the base ~/.claude bind source
# before `docker start` of a stopped box. The same preparation cmd_run does
# at create, for the same VirtioFS rule: a nested bind whose target has gone
# missing inside the parent bind source fails the start. Targets vanish
# between sessions for ordinary reasons (a host `claude install` removes
# ~/.claude/local, and a user cleans out launch.json), and these are not
# bind sources, so _container_bind_sources_present cannot see them. A pre-kit
# box has no masks, so it gets only the three base targets.
_ensure_host_mount_targets() {
  local cname="$1"
  mkdir -p "${HOME}/.claude/projects/-workspace"
  touch "${HOME}/.claude/history.jsonl"
  [[ -f "${HOME}/.claude/settings.json" ]] || echo '{}' > "${HOME}/.claude/settings.json"
  if _container_has_kit_mounts "$cname"; then
    _ensure_kit_mask_targets || exit 1
  fi
}

# Refresh the settings overlays from the host files (the user may have changed
# hooks between sessions) and re-inject or drop the unsafe-rm hook to match the
# caps resolved for THIS launch. cmd_resume and cmd_start both call it: only
# cmd_run and cmd_resume used to write settings.json, so a plain `cleat` after a
# declined or non-TTY cap drift kept a stale unsafe-rm hook in the overlay while
# the startup output showed no red guard line. Needs ACTIVE_CAPS resolved.
_refresh_settings_overlays() {
  local cname="$1" project="$2"
  local settings_overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  if [[ -d "$settings_overlay_dir" ]] && command -v jq &>/dev/null; then
    # Global settings overlay
    if [[ -f "${HOME}/.claude/settings.json" ]]; then
      if cap_is_active hooks; then
        jq '
          if .hooks then
            .hooks |= with_entries(.value |= [.[] |
              .hooks = [.hooks[] | select(.type == "command") |
                .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
              ]
            ])
          else . end
        ' "${HOME}/.claude/settings.json" > "$settings_overlay_dir/settings.json" 2>/dev/null || true
      else
        jq 'del(.hooks)' "${HOME}/.claude/settings.json" > "$settings_overlay_dir/settings.json" 2>/dev/null || true
      fi
      # This refresh REWRITES settings.json from the host file, which drops the
      # unsafe-rm hook cmd_run injected at create. Without re-injecting here the
      # cap silently stops working after a resume and the delete prompt returns.
      if cap_is_active unsafe-rm && [[ -s "$settings_overlay_dir/settings.json" ]]; then
        _inject_unsafe_rm_hook "$settings_overlay_dir/settings.json"
      fi
    fi
    # Project-level settings overlays (only when .claude/ exists)
    if cap_is_active hooks && [[ -d "$project/.claude" ]]; then
      local pf
      for pf in "$project/.claude/settings.json" "$project/.claude/settings.local.json"; do
        local _base _overlay_name
        _base="$(basename "$pf")"
        _overlay_name="project-$_base"
        if [[ -s "$pf" ]] && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
          jq '
            if .hooks then
              .hooks |= with_entries(.value |= [.[] |
                .hooks = [.hooks[] | select(.type == "command") |
                  .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
                ]
              ])
            else . end
          ' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
        elif [[ -f "$pf" ]]; then
          cp "$pf" "$settings_overlay_dir/$_overlay_name"
        else
          echo '{}' > "$settings_overlay_dir/$_overlay_name"
        fi
      done
    fi
  fi
}

cmd_start() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  _RESOLVED_PROJECT="$project"
  local cname
  cname="$(container_name_for "$project" "$box")"
  _fork_preflight "$cname" recreate

  # Resolve caps early for startup output and drift detection
  resolve_caps "$project"
  resolve_env_args "$project"

  # Config drift (caps/env keys changed since container was created): prompt
  # to recreate before any docker operations. On accept this removes the
  # container so the branches below fall into cmd_run with the new settings.
  _resolve_config_drift "$cname" "$project"

  # Image-version drift: offer to rebuild before any docker operations. On
  # accept it removes the container too, so the branches below recreate it
  # from the freshly-built image.
  _maybe_prompt_image_rebuild "$cname"

  # Reaper drift: a box created without --init wedges on long sessions; offer
  # a recreate (the branches below then recreate it with the current flags).
  _maybe_prompt_init_recreate "$cname"

  # Refresh the kit overlay (the selection or the user's own CLAUDE.md/agents
  # may have changed between sessions). In-place, so it lands for stopped AND
  # running boxes; pre-kit boxes (no mask mounts) are skipped, see concept/34.
  # The instruction-surface copies ride the same refresh.
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
    _generate_instr_overlay "$cname"
  fi
  _maybe_note_missing_kit_masks "$cname"
  _maybe_note_host_global_config

  # Settings overlays follow the caps resolved for this launch, so a declined
  # drift cannot leave a stale unsafe-rm hook behind (see the helper).
  _refresh_settings_overlays "$cname" "$project"

  # Start container if not running (restart stopped ones)
  if ! is_running "$cname"; then
    if container_exists "$cname"; then
      # Detect stale mounts. The container's bind sources are baked in at
      # creation and `docker start` re-mounts them as-is, so if any has moved
      # or vanished the start aborts with an opaque OCI error; recreate
      # instead. Two independent classes: a missing/wrong-type settings overlay
      # (_settings_overlay_intact), and any vanished bind source, most often
      # the macOS SSH agent socket, whose launchd path rotates every reboot
      # (_container_bind_sources_present).
      if ! _settings_overlay_intact "$cname" || ! _container_bind_sources_present "$cname"; then
        info "Recreating container ${DIM}(host paths changed)"
        docker rm -f "$cname" > /dev/null 2>&1 || true
        cmd_run "$project"
      else
        # Nested mount targets first: a vanished one fails `docker start`.
        _ensure_host_mount_targets "$cname"
        # Restarting a stopped container: image already exists
        success "Image ready ${RESET}${DIM}(cached)"
        # Fold host-side changes and logins from other boxes into this box's
        # ~/.claude.json while it is safely stopped (docker start re-resolves
        # the bind source). See _refresh_project_claude_json.
        _refresh_project_claude_json "$project" "$box"
        spin "Starting container..."
        local _docker_err="/tmp/cleat-err.$$"
        local start_rc=0
        docker start "$cname" > /dev/null 2>"$_docker_err" || start_rc=$?
        spin_stop "$start_rc" "Container started" "Container failed to start"
        if [[ $start_rc -ne 0 ]]; then
          [[ -s "$_docker_err" ]] && error "${DIM}$(cat "$_docker_err")${RESET}"
          rm -f "$_docker_err"
          if _is_tty; then
            echo ""
            local yn=""
            _ask_yn yn "Remove container and start fresh? [Y/n] "
            if [[ -z "$yn" || "$yn" == [yY]* ]]; then
              docker rm -f "$cname" > /dev/null 2>&1 || true
              success "Removed ${BOLD}$cname${RESET}."
              cmd_run "$project"
            else
              exit 1
            fi
          else
            error "Try ${BOLD}cleat rm${RESET} then ${BOLD}cleat${RESET} to recreate."
            exit 1
          fi
        fi
        rm -f "$_docker_err" 2>/dev/null
      fi
    else
      cmd_run "$project"
    fi
  else
    success "Image ready ${RESET}${DIM}(cached)"
    success "Container started"
  fi

  _print_auth_line "$(container_name_for "$project" "${_BOX:-main}")"

  # The docker cap breaks the sandbox outright: loud warning. The hooks cap's
  # matching line prints from exec_claude, only when a host hook will run.
  if cap_is_active docker; then
    warn_sandbox "Docker socket mounted. Container can create host-level processes"
  fi

  show_first_run_tip

  # A start that funneled through cmd_run above already ran this; this second
  # call is a silent marker no-op by design (the run-once marker is already
  # written), so every `cleat start` still gets a chance to apply [setup] on a
  # container that was created some other way (e.g. a bare `docker run`).
  _maybe_run_setup "$cname" "$project" "${_BOX:-main}" || true

  success "Claude launched"
  _print_summary_block "$cname" "$project"
  _maybe_gate_on_disk_fill "$cname"
  echo ""
  exec_claude "$cname" --dangerously-skip-permissions
}

cmd_resume() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  _RESOLVED_PROJECT="$project"
  local cname
  cname="$(container_name_for "$project" "$box")"
  _fork_preflight "$cname" recreate

  # Resolve caps for startup output and drift detection
  resolve_caps "$project"
  resolve_env_args "$project"

  # Config drift: prompt to recreate before refreshing overlays. If the user
  # accepts, the container and tmp dirs are gone; the missing-container path
  # below will call cmd_run, which rebuilds the overlay from scratch.
  _resolve_config_drift "$cname" "$project"

  # Image-version drift: offer to rebuild (and recreate) before resuming.
  _maybe_prompt_image_rebuild "$cname"

  # Reaper drift: a box created without --init wedges on long sessions; offer
  # a recreate (the missing-container path below then recreates it).
  _maybe_prompt_init_recreate "$cname"

  # Refresh the kit overlay (selection or the user's own CLAUDE.md/agents may
  # have changed between sessions); pre-kit boxes are skipped, see concept/34.
  # The instruction-surface copies ride the same refresh.
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
    _generate_instr_overlay "$cname"
  fi
  _maybe_note_missing_kit_masks "$cname"
  _maybe_note_host_global_config

  _refresh_settings_overlays "$cname" "$project"

  # Only a box that was already up can hold a live Claude in another terminal.
  # One this command starts or recreates has none, so it skips the probe.
  local _was_running=0
  is_running "$cname" && _was_running=1

  # Start container if stopped
  if ! is_running "$cname"; then
    if container_exists "$cname"; then
      # Detect stale mounts and recreate transparently (sessions live on the
      # host, so the resume below still reopens the conversation). A missing
      # settings overlay (_settings_overlay_intact) or any vanished bind source,
      # most often the macOS SSH agent socket, whose launchd path rotates
      # every reboot (_container_bind_sources_present), would otherwise make
      # `docker start` abort with an opaque OCI error.
      if ! _settings_overlay_intact "$cname" || ! _container_bind_sources_present "$cname"; then
        info "Recreating container ${DIM}(host paths changed)${RESET}"
        docker rm -f "$cname" > /dev/null 2>&1 || true
        cmd_run "$project"
      else
        # Nested mount targets first, as in cmd_start.
        _ensure_host_mount_targets "$cname"
        # Same stopped-container refresh as cmd_start: fold in host changes and
        # logins from other boxes before the bind source is re-resolved.
        _refresh_project_claude_json "$project" "$box"
        local _docker_err="/tmp/cleat-err.$$"
        local resume_rc=0
        docker start "$cname" > /dev/null 2>"$_docker_err" || resume_rc=$?
        if [[ $resume_rc -ne 0 ]]; then
          error "Container failed to start."
          [[ -s "$_docker_err" ]] && error "${DIM}$(cat "$_docker_err")${RESET}"
          rm -f "$_docker_err"
          error "Try ${BOLD}cleat rm${RESET} then ${BOLD}cleat${RESET} to recreate."
          exit 1
        fi
        rm -f "$_docker_err" 2>/dev/null
      fi
    else
      # No container exists (e.g., after `cleat rm`). Session files live on
      # the host at ~/.claude/projects/<key>/, so the resume below will
      # pick up right where Claude left off. Create a fresh container and
      # fall through to the resume flow.
      info "No container for this project. Creating fresh ${DIM}(sessions will resume from host)${RESET}"
      cmd_run "$project"
    fi
  fi

  # The docker cap breaks the sandbox outright: loud warning. The hooks cap's
  # matching line prints from exec_claude, only when a host hook will run.
  if cap_is_active docker; then
    warn_sandbox "Docker socket mounted. Container can create host-level processes"
  fi

  _maybe_run_setup "$cname" "$project" "${_BOX:-main}" || true

  success "Session resumed"
  _print_summary_block "$cname" "$project"
  _maybe_gate_on_disk_fill "$cname"
  echo ""

  # Name the conversation instead of passing --continue (see
  # _resume_pick_session), and carry its 1M context (see _resume_model_carry).
  # Resolved last, after every prompt above, so the live probe is as fresh as
  # it can be. --continue stays the answer when nothing resolves, so a box with
  # no conversation gets Claude Code's own message, as before.
  # The array gets its own `local`: bash 3.2 is the floor, and a compound
  # assignment sharing a `local` with scalar names is the one form of it the
  # file does not already prove on macOS.
  local _sdir _live="" _sid _model
  local _resume_args=(--continue)
  _sdir="$(_sessions_key_dir "$project" "$box")" || _sdir=""
  [[ "$_was_running" == "1" ]] && _live="$(_box_live_session_ids "$cname")"
  # Add the sid of any conversation terminal 1 is reopening after an account
  # switch (5.7): right after the SIGTERM it is the newest transcript, so
  # without this cleat resume here would open it and two processes would append
  # to one file. Skipping it opens that terminal's own conversation instead.
  local _reopening
  _reopening="$(_handoff_reopening_sids "$cname")"
  [[ -n "$_reopening" ]] && _live="${_live}
${_reopening}"
  _sid="$(_resume_pick_session "$_sdir" "$_live")"
  if [[ -n "$_sid" ]]; then
    _resume_args=(--resume "$_sid")
    _model=""
    _resume_model_configured "$project" || _model="$(_resume_model_carry "$_sdir/$_sid.jsonl")"
    [[ -n "$_model" ]] && _resume_args+=(--model "$_model")
  elif [[ -n "$_live" && -n "$(_resume_pick_session "$_sdir" "")" ]]; then
    # Every conversation left is open in another terminal. Reopening one would
    # have two processes append to one transcript, so start a new one.
    _resume_args=()
    info "The latest conversation in this box is open in another terminal. Starting a new one."
  fi
  exec_claude "$cname" --dangerously-skip-permissions "${_resume_args[@]+"${_resume_args[@]}"}"
}

cmd_stop() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  if is_running "$cname"; then
    docker stop "$cname" > /dev/null 2>&1
    success "Session ended. Resume with: ${BOLD}cleat resume${RESET}"
  else
    info "Container not running."
  fi
}

cmd_rm() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  if is_running "$cname"; then
    docker stop "$cname" > /dev/null
  fi
  if container_exists "$cname"; then
    docker rm "$cname" > /dev/null
    # Clean up this container's runtime dir: sessions on the host are
    # intentionally NOT touched; they live at ~/.claude/projects/<key>/ and
    # survive cleat rm.
    _account_wipe_run_dir "${cname}"
    success "Removed ${BOLD}${cname}${RESET}."
    echo -e "    ${DIM}Sessions preserved. Run ${BOLD}cleat resume${RESET}${DIM} to pick up where you left off.${RESET}"
    echo -e "    ${DIM}The box's disk layer is freed. Its image and build cache stay in the shared Docker disk: ${RESET}${BOLD}cleat storage${RESET}${DIM} shows what is left.${RESET}"
  else
    info "No container to remove."
  fi
  # Remove the box's host-side description and kit selection unconditionally:
  # `cleat rm <box>` is the documented removal path even for a box that was
  # only ever describe'd or kitted.
  _box_desc_remove "$cname"
  _box_kit_remove "$cname"
  # A fork's workspace copy is NOT removed here, deliberately. It can hold the
  # only copy of hours of work, and for a project with no git at all there is
  # no cheap "is anything unlanded" check to gate a delete on. Silently
  # destroying it is the exact data loss Cleat exists to prevent. So `cleat rm`
  # frees the container and leaves the workspace, keeping the marker so a later
  # `cleat run <box>` picks the same fork back up.
  if _box_is_fork "$cname"; then
    local _fp
    _fp="$(_fork_dir "$cname")"
    if [[ -d "$_fp" ]]; then
      info "Fork workspace kept: ${BOLD}${_fp/#${HOME}/~}${RESET}"
      echo -e "    ${DIM}Re-running this box reuses it. Remove it yourself when you are done.${RESET}"
    fi
  fi
}

cmd_shell() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"
  _fork_preflight "$cname"

  require_running "$cname"
  _wait_for_coder_remap "$cname"
  resolve_caps "$project"
  # resolve_caps may have just prompted for and approved [setup]; honor it
  # here so entering the box actually provisions (a no-op once the marker is
  # written). Without this the prompt would show but nothing would run.
  _maybe_run_setup "$cname" "$project" "$box" || true
  resolve_env_args "$project"
  _ensure_docker_access "$cname"

  # Browser bridge for shell sessions too. $BROWSER in the box points at the
  # open shim, so a `claude /login` (or gh auth, etc.) run from this shell
  # emits its URL through the bridge file; without a watcher the URL would go
  # nowhere and a loopback login would wait forever on a callback. Same
  # parameters as exec_claude: auto mode defers plain links to this terminal,
  # and an authorize URL at an allowlisted origin opens on the host.
  local _shell_clip_dir="$CLEAT_RUN_DIR/${cname}/clip"
  mkdir -p "$_shell_clip_dir"
  # This shell's byte window of the proxy log, captured before the watcher
  # starts, so a refusal from an earlier session is never reported again.
  local _shell_proxy_off
  _shell_proxy_off="$(_cap_watcher_log "$_shell_clip_dir/.proxy-log")"
  local _shell_open_cmd _shell_bw_pid=""
  _shell_open_cmd="$(_host_open_cmd)"
  if [ -n "$_shell_open_cmd" ]; then
    local _shell_interactive=0
    _is_tty && _shell_interactive=1
    # Terminal-safety redirect (see exec_claude): keep a fork-starved watcher's
    # stderr out of this shell's TUI, in a per-box log instead.
    _cap_watcher_log "$_shell_clip_dir/.watcher-log" >/dev/null
    _browser_watcher "$_shell_clip_dir" "$_shell_open_cmd" "$cname" "$(_browser_bridge_mode)" "$_shell_interactive" >>"$_shell_clip_dir/.watcher-log" 2>&1 &
    _shell_bw_pid=$!
    disown "$_shell_bw_pid" 2>/dev/null || true
  fi

  info "Container ${BOLD}${cname}${RESET}"
  # Claim the box for the idle sweep. A shell session runs bash, which
  # _box_has_live_agent deliberately does NOT count as live (a detached box
  # runs bash too), and cmd_shell never stamped the run dir, so the sweep
  # measured idleness from the last CLAUDE session and stopped the container
  # out from under someone sitting at its prompt. Re-stamping alone would not
  # fix it either: the mtime freezes at attach, so a long shell ages out of the
  # grace window anyway. The marker carries this process's PID so a crashed
  # session cannot claim the box forever.
  mkdir -p "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
  touch "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true
  local _attach_marker="$CLEAT_RUN_DIR/${cname}/.attached.$$"
  # kind=shell: a switch of this box in another terminal reads this marker and
  # refuses a move between the shared login and an account (R-shell-open), because
  # a claude the user starts in this shell keeps whatever login the shell opened
  # with. The filename still carries the pid, so _box_has_attached_session and the
  # idle sweep read it exactly as before (they never read the content).
  printf 'kind=shell\n' > "$_attach_marker" 2>/dev/null || true
  # shellcheck disable=SC2064
  trap "rm -f '$_attach_marker' 2>/dev/null || true" EXIT INT TERM HUP

  # Wait for a switch of this box to finish before the shell reads the pin, the
  # same gate every attach takes. A refusal removes the marker, tears the browser
  # watcher back down and changes nothing.
  if ! _account_attach_gate "$cname" "$box" "cleat shell"; then
    rm -f "$_attach_marker" 2>/dev/null || true
    if [ -n "$_shell_bw_pid" ]; then
      kill "$_shell_bw_pid" 2>/dev/null || true
      wait "$_shell_bw_pid" 2>/dev/null || true
    fi
    _browser_teardown_bridge "$_shell_clip_dir"
    return 1
  fi

  # A shell is a place people run `claude`, so it gets the same store the
  # session would have had.
  _account_apply_exec_env "$cname" || true
  local shell_rc=0
  docker exec -it "${CLAUDE_ENV[@]}" \
    "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" "$cname" \
    runuser -u coder -- bash || shell_rc=$?

  # A shell is a place people run `claude`, so it is also a place people run
  # `/login` or `claude auth login`. Only a harvest carries that login to the
  # account the box is pinned to. Without one it stayed in the box until some
  # later session end happened to pick it up, and the next attach's staging
  # deleted it first. Quiet by design: nothing here is destructive, a login the
  # harvest declines stays staged and `cleat account list` names what is held.
  _account_sync_out "$cname" || true

  rm -f "$_attach_marker" 2>/dev/null || true
  touch "$CLEAT_RUN_DIR/${cname}" 2>/dev/null || true

  if [ -n "$_shell_bw_pid" ]; then
    kill "$_shell_bw_pid" 2>/dev/null || true
    wait "$_shell_bw_pid" 2>/dev/null || true
  fi
  _browser_teardown_bridge "$_shell_clip_dir"

  _restore_terminal
  # The destination gate's refusals, as exec_claude reports them. A login run
  # from this shell goes through the same watcher, and a refusal that lives only
  # in the box's log is the silent failure the report exists to end.
  _CLIP_DIR="$_shell_clip_dir" _maybe_report_blocked_opens "$_shell_clip_dir/.proxy-log" "$_shell_proxy_off"
  return "$shell_rc"
}

cmd_login() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"
  _fork_preflight "$cname"

  require_running "$cname"
  _wait_for_coder_remap "$cname"
  resolve_caps "$project"
  # Honor a just-approved [setup] so the login prompt to approve it is not
  # shown without effect (no-op once the marker is written).
  _maybe_run_setup "$cname" "$project" "$box" || true
  resolve_env_args "$project"
  info "Authenticating with your Anthropic team account..."

  # Start browser bridge so auth URL opens automatically and callback works
  local _login_clip_dir="$CLEAT_RUN_DIR/${cname}/clip"
  local _login_browser_pid=""
  local _login_open_cmd
  _login_open_cmd="$(_host_open_cmd)"
  # This login's byte window of the proxy log (see cmd_shell). A missing log
  # reads as 0, so it is safe before the clip dir exists.
  local _login_proxy_off
  _login_proxy_off="$(_cap_watcher_log "$_login_clip_dir/.proxy-log")"

  if [ -n "$_login_open_cmd" ]; then
    mkdir -p "$_login_clip_dir"
    local _login_bridge_mode
    _login_bridge_mode="$(_browser_bridge_mode)"
    # host_opens_clicks=0: this watcher only ever sees the auth URL
    # `claude auth login` launches programmatically through the open shim,
    # never a link the user
    # clicked, so the terminal will NOT open it and deferral is never correct here.
    # The bridge must open it in auto/always: _is_auth_url matches an authorize
    # URL at an allowlisted origin, the code-paste one included, so both login
    # flows auto-open. Only CLEAT_BROWSER_BRIDGE=off withholds the auto-open
    # (the callback proxy still runs). An unlisted origin is refused and
    # reported below, after the watcher stops.
    # Terminal-safety redirect (see exec_claude): keep a fork-starved watcher's
    # stderr out of the login TUI, in a per-box log instead.
    _cap_watcher_log "$_login_clip_dir/.watcher-log" >/dev/null
    _browser_watcher "$_login_clip_dir" "$_login_open_cmd" "$cname" "$_login_bridge_mode" "0" >>"$_login_clip_dir/.watcher-log" 2>&1 &
    _login_browser_pid=$!
    disown "$_login_browser_pid" 2>/dev/null || true
    if [ "$_login_bridge_mode" = off ]; then
      echo -e "  ${DIM}A URL will appear. Open it in your browser to sign in ${RESET}${DIM}(CLEAT_BROWSER_BRIDGE=off).${RESET}"
    else
      echo -e "  ${DIM}Your browser will open automatically for sign-in.${RESET}"
    fi
  else
    echo -e "  ${DIM}A URL will appear. Open it in your browser to sign in.${RESET}"
  fi
  echo ""

  _ensure_docker_access "$cname"
  # Logging in is the one job whose whole point is to WRITE a credential, so a
  # pinned box that reaches it without the store override writes the new account
  # straight into the shared host login and clobbers it. Which store it lands in
  # is decided HERE, and a pin the box cannot honour falls back to the shared
  # login, so the closing line has to be told which one it was.
  local _login_acct
  _login_acct="$(_box_account_read "$cname")"
  _account_apply_exec_env "$cname" || _login_acct="$_ACCOUNT_DEFAULT"
  # `claude auth login`, never `claude login`. Claude Code has no top-level
  # `login` subcommand, so commander read the word as the first PROMPT of an
  # interactive session. A signed-in box sent it to the model as a real request
  # and kept a conversation called "login". A signed-out one answered "Not
  # logged in". Nobody was ever signed in, and nothing ever errored.
  local login_rc=0
  docker exec -it "${CLAUDE_ENV[@]}" \
    "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}" "$cname" \
    runuser -u coder -- claude auth login || login_rc=$?
  _restore_terminal

  # Cleanup browser bridge
  if [ -n "$_login_browser_pid" ]; then
    kill "$_login_browser_pid" 2>/dev/null || true
    wait "$_login_browser_pid" 2>/dev/null || true
  fi
  _browser_teardown_bridge "$_login_clip_dir"
  # A login whose origin the gate refused must say so here. `cleat login`
  # promised the browser would open, and without this line nothing explains
  # why it did not.
  _CLIP_DIR="$_login_clip_dir" _maybe_report_blocked_opens "$_login_clip_dir/.proxy-log" "$_login_proxy_off"

  # A login into a pinned box lands in that box's staged copy. Only a harvest
  # carries it to the account. Without one the account still read "signed out"
  # and the next attach's staging deleted the login this command just made. This
  # is the call a session end makes, under the same lock and the same identity
  # check, so a login as the wrong person is held rather than written.
  local _login_harvest=0
  _account_sync_out "$cname" || _login_harvest=$?

  [[ $login_rc -eq 0 ]] || return "$login_rc"
  if [[ "$_login_acct" == "$_ACCOUNT_DEFAULT" ]]; then
    success "Auth saved to ~/.claude, the shared login of every box not pinned to an account."
  elif [[ $_login_harvest -eq 0 && "$(_account_auth_state "$_login_acct")" != "signed out" ]]; then
    success "Auth saved to account ${BOLD}${_login_acct}${RESET}."
  elif [[ $_login_harvest -eq 2 ]]; then
    _account_held_notice "$cname" "You signed in as another account"
  elif [[ $_login_harvest -eq $_ACCOUNT_LOCK_BUSY && "${_ACCOUNT_LOCK_UNWRITABLE:-0}" -eq 1 ]]; then
    # Not a concurrent command: the directory cannot take the lock at all, so a
    # later session end cannot save it either. Same split as _account_busy_msg.
    warn "Signed in, but the login was not saved to ${BOLD}${_login_acct}${RESET}: Cleat cannot write to the accounts directory."
    echo -e "    ${DIM}It stays in the box. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
  elif [[ $_login_harvest -eq $_ACCOUNT_LOCK_BUSY ]]; then
    warn "Signed in, but the login was not saved to ${BOLD}${_login_acct}${RESET}: another cleat command is changing accounts."
    echo -e "    ${DIM}It stays in the box and is saved when the next session ends.${RESET}"
  else
    # rc 0 with a signed-out store is the case that matters most: the override is
    # an undocumented Claude Code variable, so a Claude that stops honouring it
    # exits 0 having written somewhere else entirely. Residual, and deliberately
    # not guessed at: a store that already held a login reads as "ok" either way,
    # so that one leg is caught by the account row rather than by this line.
    warn "Signed in, but the login did not reach account ${BOLD}${_login_acct}${RESET}."
    echo -e "    ${DIM}Check it with ${BOLD}cleat account list${RESET}${DIM}.${RESET}"
  fi
  return 0
}

cmd_claude() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  _fork_preflight "$cname"
  require_running "$cname"
  _RESOLVED_PROJECT="$project"
  resolve_caps "$project"
  resolve_env_args "$project"

  # Config drift: prompt to recreate. If accepted the container is gone, so
  # call cmd_run to rebuild it before attaching.
  _resolve_config_drift "$cname" "$project"
  if ! container_exists "$cname"; then
    cmd_run "$project"
  fi
  _maybe_note_missing_kit_masks "$cname"
  _maybe_note_host_global_config
  _maybe_run_setup "$cname" "$project" "$box" || true

  # Refresh project-level settings overlays (hooks may have changed)
  local settings_overlay_dir="$CLEAT_RUN_DIR/${cname}/settings"
  if [[ -d "$settings_overlay_dir" ]] && command -v jq &>/dev/null && cap_is_active hooks && [[ -d "$project/.claude" ]]; then
    local pf
    for pf in "$project/.claude/settings.json" "$project/.claude/settings.local.json"; do
      local _base _overlay_name
      _base="$(basename "$pf")"
      _overlay_name="project-$_base"
      if [[ -s "$pf" ]] && jq -e '.hooks // empty | length > 0' "$pf" >/dev/null 2>&1; then
        jq '
          if .hooks then
            .hooks |= with_entries(.value |= [.[] |
              .hooks = [.hooks[] | select(.type == "command") |
                .command = "cat >> /var/log/cleat/events.jsonl" | .async = true
              ]
            ])
          else . end
        ' "$pf" > "$settings_overlay_dir/$_overlay_name" 2>/dev/null || cp "$pf" "$settings_overlay_dir/$_overlay_name"
      elif [[ -f "$pf" ]]; then
        cp "$pf" "$settings_overlay_dir/$_overlay_name"
      else
        echo '{}' > "$settings_overlay_dir/$_overlay_name"
      fi
    done
  fi

  if cap_is_active docker; then
    warn_sandbox "Docker socket mounted. Container can create host-level processes"
  fi

  success "Claude launched"
  _print_summary_block "$cname" "$project"
  _maybe_gate_on_disk_fill "$cname"
  echo ""
  exec_claude "$cname" --dangerously-skip-permissions
}

cmd_logs() {
  local project box
  project="$(resolve_project "${1:-}")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"
  require_running "$cname"
  docker logs -f "$cname"
}

cmd_ps() {
  echo ""
  echo -e "  ${BOLD}Cleat containers:${RESET}"
  echo ""
  local found=false
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      found=true
      local name status project_path color meta box_label running rest
      name="$(echo "$line" | awk -F'\t' '{print $1}' | xargs)"
      status="$(echo "$line" | awk -F'\t' '{print $2}' | xargs)"

      # Exit 255 is the Docker-restart signature (the VM went away under the
      # box); without the hint it reads as a crash. RestartPolicy is 'no' by
      # design, so a restarted Docker leaves every box stopped.
      [[ "$status" == *"Exited (255)"* ]] && status="${status}. Docker restarted; resume with: cleat resume"

      # One inspect per container yields everything this row renders: the box
      # label, the running state (dot colour) and the /workspace mount source.
      # Field order is box|running|path so a literal '|' in the project path
      # (legal on disk) falls into the trailing field and can't corrupt the
      # parse of the two fixed-charset fields ahead of it.
      meta="$(docker inspect "$name" --format '{{index .Config.Labels "sh.cleat.box"}}|{{.State.Running}}|{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null)"
      box_label="${meta%%|*}"
      rest="${meta#*|}"
      running="${rest%%|*}"
      project_path="${rest#*|}"

      if [[ "$running" == "true" ]]; then color="$GREEN"; else color="$YELLOW"; fi

      # Box column: read from the sh.cleat.box label (concept/20-boxes.md).
      # Containers created before boxes (or the default box) have no label or
      # "main"; either way show nothing extra to keep the default view clean.
      [[ -z "$box_label" || "$box_label" == "<no value>" ]] && box_label="main"

      if [[ "$box_label" != "main" ]]; then
        echo -e "    ${color}●${RESET} ${BOLD}${name}${RESET}  ${DIM}[box: ${box_label}]${RESET}"
      else
        echo -e "    ${color}●${RESET} ${BOLD}${name}${RESET}"
      fi
      echo -e "      ${DIM}${status}${RESET}"
      local box_desc
      box_desc="$(_box_desc_read "$name" | head -n 1)"
      if [[ -n "$box_desc" ]]; then printf '      %b%s%b\n' "$DIM" "$box_desc" "$RESET"; fi
      if [[ -n "$project_path" ]]; then
        echo -e "      ${DIM}${project_path}${RESET}"
      fi
    fi
  done < <(docker ps -a --filter "name=^cleat-" --format "{{.Names}}\t{{.Status}}" 2>/dev/null)

  if ! $found; then
    echo -e "    ${DIM}No containers found.${RESET}"
  fi
  echo ""
  echo -e "  ${DIM}Resume with: cd <project-dir> && cleat resume${RESET}"
  echo ""
}

cmd_stop_all() {
  info "Stopping all Cleat containers..."
  local containers
  containers=$(docker ps -a --filter "name=^cleat-" --format '{{.Names}}' 2>/dev/null)
  if [[ -z "$containers" ]]; then
    info "Nothing to stop."
    return
  fi
  echo "$containers" | while read -r c; do
    docker stop "$c" > /dev/null 2>&1 || true
    docker rm "$c" > /dev/null 2>&1 || true
    echo -e "    ${DIM}removed ${c}${RESET}"
  done
  # Box descriptions are keyed by container name; drop any whose container is now
  # gone (mirrors cmd_clean) so a stale label can't resurrect on box recreate.
  if [[ -d "$CLEAT_BOXES_DIR" ]]; then
    local _bf _bcn
    for _bf in "$CLEAT_BOXES_DIR"/*; do
      [[ -f "$_bf" ]] || continue
      _bcn="$(basename "$_bf")"
      # NEVER prune a fork marker. Stripping the suffix was not enough: `cleat
      # rm <box>` deliberately removes the container and KEEPS the copy, so the
      # marker legitimately outlives the container. Pruning it there re-binds
      # the next run to the LIVE tree, and a later --fork then rm -rf's the copy
      # that `cleat rm` promised to keep. This is the one per-box state file
      # whose whole purpose is to outlive its container.
      case "$_bf" in *.fork) continue ;; esac
      if ! container_exists "$_bcn"; then rm -f "$_bf" 2>/dev/null || true; fi
    done
  fi
  success "All stopped."
}

cmd_status() {
  local project box _arg="${1:-}"
  # The positional is a PROJECT PATH when it names a real directory (the form
  # the smoke tests and scripts use) and a BOX otherwise. resolve_project
  # returns a non-directory unchanged, so without this split `cleat status
  # feat-a` printed a confident, entirely phantom project literally called
  # "feat-a": right-looking output about something that does not exist.
  if [[ -n "$_arg" && ! -d "$_arg" ]]; then
    if ! _validate_box_name "$_arg"; then
      error "Invalid box name: ${BOLD}${_arg}${RESET}"
      echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars. Pass a directory to inspect another project.${RESET}"
      exit 1
    fi
    _BOX="$_arg"
    _arg=""
  fi
  project="$(resolve_project "$_arg")"
  box="${_BOX:-main}"
  local cname
  cname="$(container_name_for "$project" "$box")"

  # Resolve caps for display only: never trigger a trust prompt from
  # a read-only status call.
  resolve_caps "$project" readonly

  echo ""
  echo -e "  ${BOLD}Project:${RESET}   ${project}"
  echo -e "  ${BOLD}Container:${RESET} ${cname}"

  if is_running "$cname"; then
    echo -e "  ${BOLD}Status:${RESET}    ${GREEN}● running${RESET}"
    # Zombie pressure: a pre---init box accumulates unreapable zombies until
    # fork() fails at the pids cap and the session freezes. Surface the count
    # while it's still a warning, not a wedge.
    local _zombies
    _zombies="$(_box_zombie_count "$cname")"
    if [[ "$_zombies" =~ ^[0-9]+$ ]] && (( _zombies > 0 )); then
      echo -e "  ${BOLD}Zombies:${RESET}   ${AMBER}● ${_zombies} unreaped${RESET} ${DIM}(recreate the box to get the --init reaper: cleat rm && cleat)${RESET}"
    fi
  elif container_exists "$cname"; then
    echo -e "  ${BOLD}Status:${RESET}    ${YELLOW}● stopped${RESET}"
  elif ! _docker_cli_present; then
    # Not installed is distinct from not running: hand over the install command,
    # not a "start it" that can't work. Read-only verbs never act, only tell.
    echo -e "  ${BOLD}Status:${RESET}    ${AMBER}● Docker isn't installed${RESET} ${DIM}(install it with: $(_docker_install_hint))${RESET}"
  elif ! _daemon_up; then
    # Don't claim "not created" when the daemon is merely off: is_running and
    # container_exists are both false-negative against a down daemon, and the
    # old line lied after every reboot. Read-only verbs never auto-start;
    # they just tell the truth. Only glue a real command into "start it with:";
    # for kinds with no single command, print the instruction bare.
    local _sk _sh
    _sk="$(_autostart_pick)"
    _sh="$(_autostart_hint "$_sk")"
    if _autostart_hint_is_command "$_sk"; then
      echo -e "  ${BOLD}Status:${RESET}    ${AMBER}● Docker isn't running${RESET} ${DIM}(start it with: ${_sh})${RESET}"
    else
      echo -e "  ${BOLD}Status:${RESET}    ${AMBER}● Docker isn't running${RESET} ${DIM}(${_sh})${RESET}"
    fi
  else
    echo -e "  ${BOLD}Status:${RESET}    ${DIM}○ not created${RESET}"
  fi

  if image_exists; then
    local size iarch darch
    size=$(docker images "$IMAGE_NAME" --format '{{.Size}}' | head -1)
    iarch="$(_image_arch "$IMAGE_NAME")"
    darch="$(_daemon_arch)"
    if [[ -n "$iarch" && -n "$darch" && "$iarch" != "$darch" ]]; then
      # Loud: an emulated image is the documented trigger for node crashes
      # and garbled TTYs, and the next `cleat start` will replace it anyway.
      echo -e "  ${BOLD}Image:${RESET}     ${AMBER}● ${IMAGE_NAME} (${iarch}, EMULATED on ${darch}; next start fetches native)${RESET} ${DIM}(${size})${RESET}"
    elif [[ -n "$iarch" ]]; then
      echo -e "  ${BOLD}Image:${RESET}     ${GREEN}● ${IMAGE_NAME}${RESET} ${DIM}(${iarch}, ${size})${RESET}"
    else
      echo -e "  ${BOLD}Image:${RESET}     ${GREEN}● ${IMAGE_NAME}${RESET} ${DIM}(${size})${RESET}"
    fi
  else
    echo -e "  ${BOLD}Image:${RESET}     ${DIM}○ not built${RESET}"
  fi

  # Deliberately NOT a `find ... -name '*credentials*'`. That glob matched a
  # dead, months-old `credentials.json` sitting in the same directory and
  # reported "logged in" from it. What counts is the store this box actually
  # reads, and whether the thing in it still has a refresh token.
  local _status_acct _status_state _status_cname
  _status_cname="$(container_name_for "$(resolve_project "$PWD")" "$_BOX")"
  _status_acct="$(_box_account_read "$_status_cname")"
  if [[ "$_status_acct" == "$_ACCOUNT_DEFAULT" ]]; then
    # Non-empty is not the same as usable. On invalid_grant the client writes
    # EMPTY tokens back to disk, so the file survives a logout and the old
    # check called that "logged in".
    if [[ -s "${HOME}/.claude/.credentials.json" ]] \
       && _account_cred_plausible "${HOME}/.claude/.credentials.json"; then
      echo -e "  ${BOLD}Auth:${RESET}      ${GREEN}● logged in${RESET} ${DIM}(via ~/.claude)${RESET}"
    else
      echo -e "  ${BOLD}Auth:${RESET}      ${YELLOW}○ not configured${RESET} ${DIM}(cleat login)${RESET}"
    fi
  else
    # A pin the box cannot honour is reported as what the box is really using,
    # with the reason. Saying "logged in (account work2)" for a box running on
    # the shared login is the kind of wrong that costs every other claim.
    local _status_eff=0
    _account_effective "$_status_cname" >/dev/null || _status_eff=$?
    if [[ $_status_eff -ne 0 ]]; then
      printf '  %bAuth:%b      %b○ shared login%b %b(pinned to %s, box needs a recreate)%b\n' \
        "$BOLD" "$RESET" "$YELLOW" "$RESET" "$DIM" "$_status_acct" "$RESET"
    else
      _status_state="$(_account_auth_state "$_status_acct")"
      case "$_status_state" in
        ok) printf '  %bAuth:%b      %b● logged in%b %b(account %s)%b\n' \
              "$BOLD" "$RESET" "$GREEN" "$RESET" "$DIM" "$_status_acct" "$RESET" ;;
        *)  printf '  %bAuth:%b      %b○ %s%b %b(account %s, cleat account)%b\n' \
              "$BOLD" "$RESET" "$YELLOW" "$_status_state" "$RESET" "$DIM" "$_status_acct" "$RESET" ;;
      esac
    fi
  fi

  # Show active capabilities: same categorized renderer as the post-launch
  # summary block; status passes BOLD to match the other status labels.
  if [[ ${#ACTIVE_CAPS[@]} -gt 0 ]]; then
    _print_caps "  " "Caps:" "      " "$BOLD"
  else
    echo -e "  ${BOLD}Caps:${RESET}      ${DIM}none${RESET} ${DIM}(cleat config)${RESET}"
  fi

  # ── Boxes: every sandbox for this project (see concept/20-boxes.md). The
  # detail above is the main box; this lists all boxes (main + named) so you
  # can see what exists here. Boxes are discovered by the INVARIANT project hash
  # plus the sh.cleat.box label and the /workspace mount source, NOT the main
  # container-name prefix (container_name_for re-truncates the dir segment per
  # box, so a long project dir would otherwise HIDE named boxes here, and a
  # sibling project could collide on the prefix and show a phantom box). The
  # `< <(... || true)` form also keeps `set -euo pipefail` from aborting status
  # when the docker daemon is down. See concept/20-boxes.md.
  echo ""
  echo -e "  ${BOLD}Boxes:${RESET}"
  local _main_cname _hash _n _meta _b _rest _running _src
  _main_cname="$(container_name_for "$project" main)"
  _hash="$(echo -n "$project" | _md5 | head -c 8)"
  # Third arg is an OPTIONAL pre-resolved running state ("true"/"false"). The
  # named-box loop already learns this from its one discovery inspect, so it
  # passes it here to skip the is_running + container_exists docker calls. The
  # main row passes nothing and falls back to probing (it may not exist yet).
  _status_box_row() {
    local _bx="$1" _cn="$2" _known="${3:-}"
    if [[ "$_known" == "true" ]]; then
      echo -e "    ${GREEN}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}running${RESET}"
    elif [[ "$_known" == "false" ]]; then
      echo -e "    ${YELLOW}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}stopped${RESET}"
    elif is_running "$_cn"; then
      echo -e "    ${GREEN}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}running${RESET}"
    elif container_exists "$_cn"; then
      echo -e "    ${YELLOW}●${RESET} ${BOLD}${_bx}${RESET} ${DIM}stopped${RESET}"
    elif ! _daemon_up; then
      # Same honesty rule as the Status line above: against a down daemon the
      # probes are blind, so "not created" would lie about every box.
      echo -e "    ${DIM}○ ${_bx}${RESET} ${DIM}unknown (Docker isn't running)${RESET}"
    else
      echo -e "    ${DIM}○ ${_bx}${RESET} ${DIM}not created${RESET}"
    fi
    # First line only: a multi-line description must not break the list layout.
    local _desc
    _desc="$(_box_desc_read "$_cn" | head -n 1)"
    if [[ -n "$_desc" ]]; then printf '        %b%s%b\n' "$DIM" "$_desc" "$RESET"; fi
  }
  _status_box_row "main" "$_main_cname"
  while IFS= read -r _n; do
    [[ -z "$_n" ]] && continue
    # Cheap pre-filter on the invariant hash; the mount-source check below is
    # authoritative (a sibling project could embed this hash in its dir name).
    case "$_n" in *"-${_hash}"*) ;; *) continue ;; esac
    # One inspect per candidate yields label|running|workspace-source. Field
    # order keeps the (possibly '|'-bearing) path trailing so it can't corrupt
    # the parse of the two fixed-charset fields ahead of it.
    _meta="$(docker inspect "$_n" --format '{{index .Config.Labels "sh.cleat.box"}}|{{.State.Running}}|{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null || true)"
    _b="${_meta%%|*}"
    _rest="${_meta#*|}"
    _running="${_rest%%|*}"
    _src="${_rest#*|}"
    if [[ -z "$_b" || "$_b" == "<no value>" ]]; then _b="main"; fi
    # A fork box mounts its own COPY at /workspace, so its mount source is the
    # forks path, not the project path. Match that too, or every fork box
    # silently vanishes from Boxes while still showing up in `cleat ps`.
    [[ "$_src" == "$project" || "$_src" == "$(_fork_dir "$_n")" ]] || continue
    [[ "$_b" == "main" ]] && continue
    # A candidate from `docker ps -a` always exists, so running/stopped is the
    # only distinction: pass the inspect's State.Running and skip re-probing.
    _status_box_row "$_b" "$_n" "$_running"
  done < <(docker ps -a --filter "name=^cleat-" --format '{{.Names}}' 2>/dev/null || true)

  # ── VM memory budget: running containers' limits vs what the VM actually
  # has. Overcommit means the limits can't bind and a runaway process swap-
  # thrashes EVERY session at once (counts all containers: the VM is shared).
  # Trigger AND display in the SAME whole-GB unit (the configured slider via
  # _docker_vm_display_gb), mirroring the on-start overload path: comparing raw
  # bytes against the kernel's MemTotal while PRINTING the rounded slider let the
  # line fire and then print parity ("promised 24 GB of a 24 GB VM") or even an
  # inverted "promised 23 GB of a 24 GB VM" whenever the sum landed in the gap
  # between MemTotal and the slider. One unit for both makes that impossible.
  local _vm_bytes _limit_sum _sum_gb _vm_gb
  _vm_bytes="$(_docker_vm_memory)"
  if [[ "$_vm_bytes" =~ ^[0-9]+$ ]] && (( _vm_bytes > 0 )); then
    _limit_sum="$(_running_memory_limits_sum)"
    if [[ "$_limit_sum" =~ ^[0-9]+$ ]]; then
      _sum_gb=$(( _limit_sum / 1073741824 ))
      _vm_gb="$(_docker_vm_display_gb "$_vm_bytes")"
      if (( _sum_gb > _vm_gb )); then
        echo ""
        # Same engine-aware noun as the on-start overload warning: a native
        # Linux engine has no VM, the pool is the host's RAM. Detected only
        # inside this rare branch so a healthy status pays no extra round-trip.
        if _docker_pool_is_vm 2>/dev/null; then
          echo -e "  ${BOLD}VM memory:${RESET} ${AMBER}● overcommitted${RESET}${DIM}: running containers reserve ${_sum_gb} GB of ceilings on a ${_vm_gb} GB VM${RESET}"
        else
          echo -e "  ${BOLD}Host memory:${RESET} ${AMBER}● overcommitted${RESET}${DIM}: running containers reserve ${_sum_gb} GB of ceilings on a ${_vm_gb} GB host${RESET}"
        fi
      fi
    fi
  fi

  # ── Install: only shown when there is more than one cleat on the machine.
  # Two installs is a state you cannot see from the inside (a bare `cleat`
  # silently resolves to whichever comes first on PATH), so the answer belongs
  # where someone looks when a version or an update makes no sense. A single
  # install prints nothing: this is a warning, not a stat.
  local _installs _count _self_phys
  _installs="$(_find_cleat_installs)"
  _count="$(printf '%s\n' "$_installs" | grep -c . || true)"
  if [[ "$_count" =~ ^[0-9]+$ ]] && (( _count > 1 )); then
    _self_phys="$(_resolve_physical_path "${BASH_SOURCE[0]:-$0}")"
    echo ""
    echo -e "  ${BOLD}Install:${RESET}   ${AMBER}● ${_count} installs found${RESET}${DIM}, PATH order decides which one runs${RESET}"
    _render_install_shadow_list "$_installs" "$_self_phys"
    echo -e "    ${DIM}Remove one: ${BOLD}cleat uninstall${RESET}${DIM}, or ${BOLD}brew uninstall cleatdev/tap/cleat${RESET}${DIM} for the keg.${RESET}"
  fi
  echo ""
}

# ── Prune: cleat-owned image bloat ──────────────────────────────────────────
# Two artifact classes accrete in daily use (see concept/22):
#   1. Dangling images labeled sh.cleat.version: every drift rebuild orphans
#      the previous build (1.5-2.5 GB each, several per day for a maintainer).
#   2. Superseded ghcr.io prebuilt version tags: `cleat update` pulls the new
#      tag but never removed old ones (~1 GB per release; amd64-era tags can
#      never be used natively again on Apple Silicon).
# Boxes (even exited ones) are NEVER touched: a stopped box is a resumable
# session holding /tmp state. Other projects' images and caches are never
# touched. This is the safe middle ground between `clean` and `nuke`.

# ── Shared docker human-size parser ──────────────────────────────────────────
# docker prints sizes as human strings ("36.34GB", "67.95MB", "512kB", "2.5TB",
# "0B"), and `docker system df` appends a " (NN%)" reclaimable suffix. ONE
# hardened converter backs every size/reclaimable number the CLI reports (cleat
# storage, the disk advisory, prune --cache reclaimed bytes, the image-bloat sum
# in _cleat_prunable_stats), so a parse bug can never make the advisory and the
# command that acts on it disagree.
#
# h2b(s) -> BYTES (a double; callers format once). Strips a trailing " (NN%)"
# suffix FIRST. Requires a digit immediately before the unit so a bare "kB"/"TB"
# parses to 0 (never a unit-only value). Units B/kB/KB/MB/GB/TB/PB as 1024-steps
# to match the CLI's existing GiB math. Two load-bearing portability guards:
# LC_ALL=C (BSD awk honors LC_NUMERIC, so a comma locale would truncate "36.34"
# to 36) and printf "%.0f" NOT "%d" (mawk's %d clamps at 2^31-1, so any size
# >= 2GB would silently collapse; %.0f is a double, exact past PB).
_SIZE_AWK='
function h2b(s,   u, n, m) {
  sub(/[ \t]*\([0-9]+%\)[ \t]*$/, "", s)
  if (match(s, /[0-9][0-9.]*(B|kB|KB|MB|GB|TB|PB)/) == 0) return 0
  s = substr(s, RSTART, RLENGTH)
  u = s; sub(/^[0-9.]+/, "", u)
  n = s + 0
  if      (u == "B")               m = 1
  else if (u == "kB" || u == "KB") m = 1024
  else if (u == "MB")              m = 1048576
  else if (u == "GB")              m = 1073741824
  else if (u == "TB")              m = 1099511627776
  else if (u == "PB")              m = 1125899906842624
  else                             m = 0
  return n * m
}'

# Convert ONE docker human-size token to integer bytes. Empty/garbage -> 0.
_human_size_to_bytes() {
  LC_ALL=C awk -v s="${1:-}" "$_SIZE_AWK"'BEGIN { printf "%.0f", h2b(s) }'
}

# Seams for cmd_prune/_cleat_prunable_stats (overridable in tests: the docker
# stub serves one canned `images` response for every query shape).
_dangling_cleat_images() {
  docker images -f dangling=true -f label=sh.cleat.version -q 2>/dev/null || true
}

# Prints "tag<TAB>size" per prebuilt image (size used by the stats helper).
_prebuilt_image_tags() {
  docker images "$REGISTRY_BASE" --format '{{.Repository}}:{{.Tag}}	{{.Size}}' 2>/dev/null || true
}

# Full image IDs (sha256:...) pinned by ANY container, running OR stopped, one
# per line. This is exactly the set `docker rmi` (no -f) refuses to remove: a
# box, even exited, holds its image by ID. A drift rebuild orphans the old build
# into a dangling image, but the stopped box built from it still pins it, and
# Cleat never touches boxes (concept/22), so those pinned images accumulate.
# Empty on a down daemon. Seam (overridable in tests). `docker ps -a -q` uses
# separate tokens so the docker stub's token-bounded ` -a ` detection routes it.
_container_image_ids() {
  local ids=() id
  while IFS= read -r id; do
    [[ -n "$id" ]] && ids+=("$id")
  done < <(docker ps -a -q 2>/dev/null || true)
  [[ ${#ids[@]} -eq 0 ]] && return 0
  docker inspect --format '{{.Image}}' "${ids[@]}" 2>/dev/null || true
}

# Resolve an image ref (dangling short ID or repo:tag) to its full image ID
# (sha256:...). Empty when the ref no longer exists. Seam.
_image_id_of() {
  docker image inspect "$1" --format '{{.Id}}' 2>/dev/null || true
}

# True when image ref $1 is pinned by a container in the newline set $2 of
# container image IDs: `docker rmi` would refuse it, so the prune OFFER must not
# count it (the action, cmd_prune, keeps it and reports it as "kept"). Resolves
# $1 to its full ID, tests whole-line (`-x`) membership with fixed strings
# (`-F`, so a sha256 with no regex metachars matches literally, and a short ID
# can't substring-match a longer one). False when $1 no longer resolves.
_image_referenced_by_container() {
  local iid; iid="$(_image_id_of "$1")"
  [[ -n "$iid" ]] || return 1
  printf '%s\n' "${2:-}" | grep -Fxq -- "$iid"
}

# Count and approximate size (MB) of prunable cleat artifacts: "count<TAB>mb".
# Sizes are docker's human strings (1.72GB / 971MB): close enough to decide
# whether a prune is worth offering. Images a container still references are
# EXCLUDED from both the count and the byte total, because cmd_prune (docker rmi,
# no -f) cannot remove them: counting them made the offer promise a prune that
# then removed nothing ("N stale images" -> "Nothing to prune. N kept"). The 5 GB
# gate now measures removable-only bloat too, so the offer never fires on bytes
# no prune can reclaim.
_cleat_prunable_stats() {
  local referenced; referenced="$(_container_image_ids)"
  {
    local id
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      _image_referenced_by_container "$id" "$referenced" && continue
      # Unsizeable still counts: the artifact exists even if inspect hiccups.
      docker image inspect "$id" --format '{{.Size}}B' 2>/dev/null || echo "0B"
    done < <(_dangling_cleat_images)

    local line tag
    while IFS= read -r line; do
      tag="${line%%	*}"
      [[ -n "$tag" ]] || continue
      [[ "$tag" == "${REGISTRY_BASE}:v${VERSION}" ]] && continue
      _image_referenced_by_container "$tag" "$referenced" && continue
      printf '%s\n' "${line#*	}"
    done < <(_prebuilt_image_tags)
  } | LC_ALL=C awk "$_SIZE_AWK"'
    { n++; b += h2b($0) }
    END { printf "%d\t%.0f", n, int(b / 1048576) }
  '
}

# Reclaim GLOBAL, regenerable Docker build cache (reclaimable-only, never -a).
# Build cache is content-addressed and shared across ALL Docker projects, so it
# cannot be scoped to cleat: the typed --cache flag plus this loud default-No
# confirm are the consent. --yes bypasses the prompt (still prints the
# disclosure). Non-interactive without --yes prints the disclosure and skips.
_prune_build_cache() {
  local assume_yes="${1:-0}"
  echo ""
  warn "${BOLD}cleat prune --cache${RESET} clears the ${BOLD}shared${RESET} Docker build cache used by ${BOLD}all${RESET} Docker projects."
  echo -e "    ${DIM}It is regenerable. Your next build re-creates what it needs.${RESET}"
  if (( ! assume_yes )); then
    if ! _is_interactive; then
      echo -e "    ${DIM}Re-run with ${RESET}${BOLD}--yes${RESET}${DIM} to clear it non-interactively.${RESET}"
      return 0
    fi
    local yn=""
    _ask_yn yn "Clear the shared build cache? [y/N] "
    [[ "$yn" == [yY]* ]] || { info "Left the build cache in place."; return 0; }
  fi
  local out reclaimed
  out="$(docker builder prune -f 2>/dev/null || true)"
  reclaimed="$(printf '%s\n' "$out" | grep -Eo '[0-9][0-9.]*[kKMGTP]?B' | tail -1 || true)"
  if [[ -n "$reclaimed" && "$reclaimed" != "0B" ]]; then
    success "Cleared build cache. Reclaimed ${BOLD}${reclaimed}${RESET}."
  else
    info "No reclaimable build cache."
  fi
}

cmd_prune() {
  local want_cache=0 assume_yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --cache|--build-cache) want_cache=1 ;;
      --yes|-y)              assume_yes=1 ;;
    esac
  done

  local removed=0 failed=0

  # Superseded prebuilt version tags (everything but the current version's).
  local line tag
  while IFS= read -r line; do
    tag="${line%%	*}"
    [[ -z "$tag" ]] && continue
    [[ "$tag" == "${REGISTRY_BASE}:v${VERSION}" ]] && continue
    if docker rmi "$tag" > /dev/null 2>&1; then
      removed=$((removed + 1))
    else
      failed=$((failed + 1))   # in use by a container; leave it
    fi
  done < <(_prebuilt_image_tags)

  # Dangling cleat builds (label-filtered: other projects' dangling images
  # are not ours to delete).
  local id
  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    if docker rmi "$id" > /dev/null 2>&1; then
      removed=$((removed + 1))
    else
      failed=$((failed + 1))
    fi
  done < <(_dangling_cleat_images)

  if (( removed > 0 )); then
    success "Pruned ${removed} stale cleat image$( (( removed != 1 )) && echo s )."
  else
    info "Nothing to prune."
  fi
  if (( failed > 0 )); then
    echo -e "    ${DIM}${failed} kept (still referenced by a container).${RESET}"
  fi

  if (( want_cache )); then
    _prune_build_cache "$assume_yes"
  fi
}

# ── On-start Docker pressure check ──────────────────────────────────────────
# TTY-only, throttled to once per day, entirely local, fail-soft (a down
# daemon yields empty reads and silence). Two independent signals:
#   1. BLOAT: prunable cleat artifacts above ~5 GB → offer `cleat prune`
#      ([Y/n]; the fix is safe and one keypress away: users should never be
#      told to run manual docker cleanup).
#   2. OVERLOAD: running containers' memory limits overcommit the Docker VM
#      → a one-line notice. No auto-fix: resizing the VM or stopping boxes is
#      the user's call. Counts ALL running containers, not just cleat's: the
#      VM is shared, and a neighboring compose stack squeezes cleat boxes
#      just the same.
_PRESSURE_BLOAT_MB_THRESHOLD=5120

# Two-tier disk-fill thresholds, keyed on the shared Docker storage's Use% as a
# box sees it via `df` (cap-relative: a 60 GB Docker Desktop VM and a 1.8 TB one
# trip at the same fullness, never at an absolute GB, because df inside a box
# reports the ONE shared disk). Each tier also requires a low absolute-free
# floor, so a 95%-full 1.8 TB disk that still has 90 GB free never fires: the
# free floor can only ever REMOVE a trigger, never add one. An 80% hard block
# would fire on healthy large disks (80% of 1.8 TB = 360 GB free) and cross the
# never-cripple line, so the gate sits at 95 and 85 is a read-only nudge.
# Tunable in one line each.
_DISK_ADVISORY_PCT=85      # >= this AND free < advisory floor: read-only advisory
_DISK_ADVISORY_FREE_GB=25
_DISK_GATE_PCT=95          # >= this AND free < gate floor: advisory PLUS a keypress hold
_DISK_GATE_FREE_GB=10
# Advisory is daily-throttled with its OWN stamp (the memory check already
# stamps PRESSURE_CHECK_FILE this run, so sharing it would suppress one of them).
# The hard gate is never throttled: it reads fresh every interactive start and
# holds whenever the critical predicate is true, like the undersized-VM advisory.
DISK_CHECK_FILE="$CLEAT_STATE_DIR/disk_check"
DISK_CHECK_INTERVAL=86400

# Count zombie processes inside a running box by reading /proc directly (the
# image ships no `ps`). The comm field in /proc/N/stat may contain spaces, so
# strip through the closing paren before taking the state field. Empty output
# on any failure: callers treat that as "unknown", never as an error.
_box_zombie_count() {
  docker exec "$1" sh -c '
    z=0
    for f in /proc/[0-9]*/stat; do
      s=$(sed "s/^[^)]*) //" "$f" 2>/dev/null | cut -d" " -f1)
      [ "$s" = "Z" ] && z=$((z+1))
    done
    echo "$z"
  ' 2>/dev/null || true
}

# Sum of HostConfig.Memory over all RUNNING containers, in bytes.
_running_memory_limits_sum() {
  local ids=() id sum=0 mem
  while IFS= read -r id; do
    [[ -n "$id" ]] && ids+=("$id")
  done < <(docker ps -q 2>/dev/null || true)
  if [[ ${#ids[@]} -eq 0 ]]; then
    echo 0
    return
  fi
  while IFS= read -r mem; do
    [[ "$mem" =~ ^[0-9]+$ ]] || continue
    sum=$(( sum + mem ))
  done < <(docker inspect --format '{{.HostConfig.Memory}}' "${ids[@]}" 2>/dev/null || true)
  echo "$sum"
}

# Names of RUNNING cleat boxes, one per line (the sh.cleat.version label is on
# every box this CLI creates; non-cleat containers never carry it). Seam for the
# overload message's session count and the idle sweep. Empty on a down daemon.
_running_cleat_boxes() {
  docker ps --filter "label=sh.cleat.version" --format '{{.Names}}' 2>/dev/null || true
}

# Count of running cleat boxes (0 on any failure).
_running_cleat_box_count() {
  local n=0 name
  while IFS= read -r name; do
    [[ -n "$name" ]] && n=$(( n + 1 ))
  done < <(_running_cleat_boxes)
  echo "$n"
}

# Recommended Docker VM size in whole GB: the comfortable-default target
# (_PRESSURE_TARGET_VM_GB, 16 GiB, room for several sessions to each spike near
# their quarter-of-VM ceiling at once, NOT a session cap), but never more than half the
# host's RAM (leave the rest for macOS + apps). Host RAM unknown → just the
# target. Always ≥ 1. Arg: $1 = host RAM bytes (may be empty).
_recommended_vm_gb() {
  local host_bytes="${1:-}" rec="$_PRESSURE_TARGET_VM_GB" half
  if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
    half=$(( host_bytes / 2 / 1073741824 ))
    (( half < rec )) && rec=$half
  fi
  (( rec < 1 )) && rec=1
  echo "$rec"
}

# Print the two concrete Docker-Desktop steps that fix the VM (the one knob the
# `docker` CLI cannot touch). The CALLER prints the lead-in line and guarantees
# this is Docker Desktop AND that growing the VM actually helps (recommended >
# current): on a host already near its safe max we steer to "fewer sessions"
# instead, so this never names a target SMALLER than the VM they already have.
#
# Colour discipline (kept consistent so the block reads as ONE thing, not a
# random mix): every line is a DIM bullet so none starts on a bold word (which
# read as a section break); BOLD marks only what you click or set (the menu
# paths, the memory/swap values, VirtioFS); DIM carries the connective prose.
# No amber in the body, that belongs to the `!` marker alone. No engine
# re-detection here (the caller detects once) and no trailing blank (the
# pressure block owns that, so the gap survives when this block is skipped).
# Args: $1 = host RAM bytes (may be empty), $2 = recommended GB.
_print_docker_vm_fix() {
  local host_bytes="${1:-}" rec_gb="${2:-$_PRESSURE_TARGET_VM_GB}" max_note=""
  if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
    max_note="${DIM}   (max ≈ $(( host_bytes * 3 / 4 / 1073741824 )) GB)${RESET}"
  fi
  # Docker Desktop's WSL2 backend takes memory/swap from .wslconfig, not the
  # Resources slider (which that backend removes). Name the real knob there.
  if _is_wsl; then
    echo -e "    ${DIM}•${RESET} ${DIM}In ${RESET}${BOLD}.wslconfig${RESET}${DIM} (your Windows user folder) under ${RESET}${BOLD}[wsl2]${RESET}${DIM} set ${RESET}${BOLD}memory=${rec_gb}GB${RESET}${DIM} and ${RESET}${BOLD}swap=2GB${RESET}${DIM}, then run ${RESET}${BOLD}wsl --shutdown${RESET}${max_note}"
    return 0
  fi
  echo -e "    ${DIM}•${RESET} ${BOLD}Settings → Resources → Advanced${RESET}${DIM}: set ${RESET}${BOLD}Memory limit ${rec_gb} GB${RESET}${DIM} and ${RESET}${BOLD}Swap ≥ 2 GB${RESET}${DIM}, then Apply & restart${RESET}${max_note}"
  echo -e "    ${DIM}•${RESET} ${DIM}Faster I/O: ${RESET}${BOLD}Settings → General → Virtual Machine Options${RESET}${DIM} → ${RESET}${BOLD}VirtioFS${RESET}"
}

# ── Idle-session sweep ───────────────────────────────────────────────────────
# True when a host-side session has this box open (today: `cleat shell`, which
# the in-container process list cannot distinguish from a detached box). Each
# marker is named for the claiming PID, so one left by a killed session is
# ignored and swept away rather than pinning the box forever.
_box_has_attached_session() {
  local m pid found=1
  for m in "$CLEAT_RUN_DIR/$1"/.attached.*; do
    [[ -f "$m" ]] || continue
    pid="${m##*/.attached.}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    if kill -0 "$pid" 2>/dev/null; then
      found=0
    else
      rm -f "$m" 2>/dev/null || true
    fi
  done
  return $found
}

# True when one process's argv, passed as separate words, is Claude Code. This
# is the one definition of "a Claude process" that every liveness reader shares:
# _box_has_live_agent feeds it the command column of `docker top`, and an in-box
# probe can ship it with `declare -f` and feed it /proc/<pid>/cmdline. It judges
# the EXECUTABLE, never a substring of the line. Claude is:
#   - the launcher by name or path (`claude`, ~/.local/bin/claude), which is how
#     exec_claude, a `cleat shell` user and a scripted `claude -p` all run it
#   - a native versioned binary run directly (.../claude/versions/<v>), which
#     is also what Claude's own background-agent daemon runs as
#   - node running a Claude entry point (an npm install, pre-native images)
# Not Claude: a dev server or MCP server that is merely node, anything whose
# arguments mention .claude/ (plugin MCP servers, Claude's Bash-tool shells)
# and cleat's own `bash -c` wrapper, whose script text names claude. Every live
# Claude has a process row of its own, so judging argv0 misses none of them.
_is_claude_argv() {
  case "${1:-}" in
    claude|*/claude|*/claude/versions/*) return 0 ;;
    node|*/node|nodejs|*/nodejs) ;;
    *) return 1 ;;
  esac
  # node: the FIRST non-option argument decides, and nothing after it. Walked
  # with $# rather than `for w in "$@"`, which bash 3.2 calls unbound when the
  # row is a bare `node` REPL with no arguments at all.
  while [[ $# -gt 1 ]]; do
    shift
    case "$1" in
      -*) ;;
      claude|*/claude|*/claude/versions/*|*/@anthropic-ai/claude-code/*) return 0 ;;
      *) return 1 ;;
    esac
  done
  return 1
}

# True when Claude Code is running inside the box. A DETACHED box (terminal
# closed, the foreground exec gone) runs only docker-init/su/bash, so this is
# false. A box working UNATTENDED keeps its host `docker exec` (and thus the
# claude process) alive, so this is TRUE and the sweep leaves it strictly alone
# (the "leave it running, walk away" promise). `docker top` reads the process
# list from the daemon (the image ships no `ps`), so no exec is needed.
#
# Only the command column is judged, and only by _is_claude_argv. A grep of the
# whole line for claude|node read a leftover Vite or MCP server as a live
# session (refusing `cleat account`, session deletes and the idle sweep) and on
# a Linux host matched a user name in the UID column.
#
# Fails SAFE: any error, empty output or a header with no CMD/COMMAND column is
# treated as "live" → skip.
_box_has_live_agent() {
  # f is assigned empty, never merely declared: bash 3.2 calls ${#f[@]} on a
  # declared-but-never-assigned array unbound under `set -u`.
  local top col=-1 i f=()
  top="$(docker top "$1" 2>/dev/null)" || return 0     # unreadable → assume live (safe)
  [[ -n "$top" ]] || return 0                          # empty → assume live (safe)
  {
    IFS=$' \t' read -r -a f || true
    for (( i = 0; i < ${#f[@]}; i++ )); do
      case "${f[$i]}" in CMD|COMMAND) col=$i ;; esac
    done
    (( col >= 0 )) || return 0                         # unknown layout → assume live (safe)
    while IFS=$' \t' read -r -a f; do
      (( ${#f[@]} > col )) || continue
      _is_claude_argv "${f[@]:$col}" && return 0
    done
  } <<< "$top"
  return 1
}

# Stop cleat boxes that are PROVABLY safe to stop: detached (no live agent) AND
# idle past the grace window. Never stops $1 (the box being launched now) or any
# box with a live agent. A stopped box is preserved on disk; running `cleat` in
# its project brings it right back, so the notice does not nag about resuming.
# Prints ONE summary line when it stops anything. Args: $1 = self cname to skip,
# $2 = grace seconds. Fail-soft; TTY-gating is the caller's job.
_sweep_idle_boxes() {
  local self="${1:-}" grace_secs="${2:-$_IDLE_SWEEP_GRACE_SECS}"
  local now name age mem victims=() freed=0
  now="$(date +%s)"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    [[ "$name" == "$self" ]] && continue
    # Grace gate FIRST (cheap, local, and decisive for cost): the run dir's mtime
    # is re-stamped on attach AND detach (exec_claude / _cleanup_session), so
    # `now - mtime` is the time since this box last had a host session. Skip boxes
    # inside the grace window, and skip an unknown age (0/unreadable) rather than
    # stop on an unknown clock. Running this before the `docker top` round-trip
    # avoids one daemon call per within-grace box AND shrinks the window where a
    # box another terminal just re-attached to (mtime freshly stamped) could be
    # caught during its bring-up, before claude shows up in the process list.
    age="$(_path_mtime "$CLEAT_RUN_DIR/$name")"
    [[ "$age" =~ ^[0-9]+$ ]] && (( age > 0 )) || continue
    (( now - age < grace_secs )) && continue
    # An open `cleat shell` claims the box with a PID-stamped marker. Checked
    # BEFORE the docker round-trip, and separately from the agent gate, because
    # a shell runs bash and a DETACHED box runs bash too, so the process list
    # cannot tell them apart. Host-side, so it costs nothing.
    _box_has_attached_session "$name" && continue
    # Liveness gate: a claude process means the box is attached or working
    # unattended → never touch it. Fail-safe (an unreadable `docker top` = live).
    _box_has_live_agent "$name" && continue
    mem="$(docker inspect --format '{{.HostConfig.Memory}}' "$name" 2>/dev/null)" || mem=0
    [[ "$mem" =~ ^[0-9]+$ ]] && (( mem > 0 )) && freed=$(( freed + mem ))
    victims+=("$name")
  done < <(_running_cleat_boxes)

  [[ ${#victims[@]} -gt 0 ]] || return 0
  docker stop "${victims[@]}" >/dev/null 2>&1 || true
  local n=${#victims[@]} gb=$(( (freed + 536870912) / 1073741824 )) freed_note=""
  (( gb > 0 )) && freed_note=", freed ${gb} GB"
  echo ""
  info "Stopped ${n} idle session$( (( n != 1 )) && printf s )${freed_note}. ${DIM}A detached box keeps its memory ceiling until stopped.${RESET}"
}

# On-start wrapper: TTY-only (never on a pipe or in cron), opt-out via
# CLEAT_NO_IDLE_SWEEP=1, grace override via CLEAT_IDLE_GRACE_MINS. Resolves the
# box being launched from the same [box] positional the dispatch passes, so the
# sweep never stops the session you are starting. Entirely fail-soft.
_maybe_sweep_idle_boxes() {
  _is_tty || return 0
  [[ "${CLEAT_NO_IDLE_SWEEP:-}" == "1" ]] && return 0
  command -v docker >/dev/null 2>&1 || return 0
  # Don't sweep for a malformed invocation that _set_box is about to reject (an
  # extra positional, or an invalid box name): a command that won't run must not
  # stop any box. Let validation error first.
  [[ $# -gt 1 ]] && return 0
  [[ -n "${1:-}" ]] && ! _validate_box_name "$1" 2>/dev/null && return 0
  local grace_secs="$_IDLE_SWEEP_GRACE_SECS"
  [[ "${CLEAT_IDLE_GRACE_MINS:-}" =~ ^[0-9]+$ ]] && grace_secs=$(( CLEAT_IDLE_GRACE_MINS * 60 ))
  local self_project self_box="main" self_cname=""
  self_project="$(resolve_project 2>/dev/null || printf '%s' "$PWD")"
  [[ -n "${1:-}" ]] && self_box="$1"   # already validated above
  self_cname="$(container_name_for "$self_project" "$self_box" 2>/dev/null || true)"
  _sweep_idle_boxes "$self_cname" "$grace_secs"
}

_maybe_check_docker_pressure() {
  _is_tty || return 0

  # Two cadences. The bloat→prune prompt and the OVERLOAD notice are PERIODIC
  # (throttled to once per interval): the first is an interactive prompt, the
  # second a transient runtime condition (a promise > VM compares ceilings, not
  # usage, and is often harmless), so neither should fire on every start. The
  # UNDERSIZED-VM advisory is different: an invalid Docker config (the VM memory
  # slider set too low) must surface on EVERY start until it is fixed, the same
  # way the positive "Docker tuned" line shows on every good start. So the daily
  # stamp gates only the periodic halves; the undersized advisory ignores it.
  local now last=0 bloat_due=true
  now="$(date +%s)"
  if [[ -f "$PRESSURE_CHECK_FILE" ]]; then
    last="$(head -1 "$PRESSURE_CHECK_FILE" 2>/dev/null || echo 0)"
    [[ "$last" =~ ^[0-9]+$ ]] || last=0
  fi
  (( now - last < PRESSURE_CHECK_INTERVAL )) && bloat_due=false

  # Whitespace model: every notice owns ONE blank line ABOVE it. For the first
  # notice that blank separates the section from the update/restart lines above;
  # for a later notice it separates it from the previous one (the prune prompt and
  # the VM advisory can both fire on the daily check, and ran flush together before
  # v0.16.4). The prune notice prints its leading blank only when nothing came
  # before it (`$printed || echo ""`); the VM advisories print theirs always (so
  # the prune→advisory gap is never lost). `printed` also gates a single TRAILING
  # blank after the last notice (owned HERE, not inside the Docker-Desktop fix
  # block, so the gap survives when that block is skipped), which flags
  # _ONSTART_GAP_OPEN so the highlight doesn't add a second.
  local printed=false

  # 1. Bloat → prune prompt (periodic; only on the daily check).
  if $bloat_due; then
    echo "$now" > "$PRESSURE_CHECK_FILE" 2>/dev/null || true
    local stats count mb
    stats="$(_cleat_prunable_stats)"
    count="${stats%%	*}"
    mb="${stats##*	}"
    if [[ "$count" =~ ^[0-9]+$ && "$mb" =~ ^[0-9]+$ ]] && (( mb >= _PRESSURE_BLOAT_MB_THRESHOLD )); then
      $printed || echo ""
      info "Docker is carrying ${BOLD}${count} stale cleat images${RESET} ${DIM}(~$(( (mb + 512) / 1024 )) GB of old builds and superseded pulls)${RESET}"
      printed=true
      local yn=""
      _ask_yn yn "Prune them now? ${DIM}(boxes and other projects are not touched)${RESET} [Y/n] "
      if [[ -z "$yn" || "$yn" == [yY]* ]]; then
        cmd_prune
      fi
    fi
  fi

  # 2. VM memory vs the host + the running sessions. A box and a worktree are
  #    the same thing here: one session, one quarter-of-VM ceiling. Both point at the one
  #    knob the `docker` CLI can't change: the Docker Desktop memory slider.
  local vm_bytes sum host_bytes vm_gb rec_gb is_dd=false pool_vm=false host_note=""
  vm_bytes="$(_docker_vm_memory)"
  if [[ "$vm_bytes" =~ ^[0-9]+$ ]] && (( vm_bytes > 0 )); then
    vm_gb="$(_docker_vm_display_gb "$vm_bytes")"   # prefer the configured slider; fall back to rounding MemTotal
    sum="$(_running_memory_limits_sum)"
    host_bytes="$(_host_total_memory)"
    rec_gb="$(_recommended_vm_gb "$host_bytes")"
    # Detect the engine ONCE: every `docker info` is a round-trip to a daemon
    # that's slow precisely when this fires (under swap), so we never call it
    # again per-branch. pool_vm (what noun the warnings use) derives from the
    # is_dd already in hand instead of _docker_pool_is_vm for the same reason.
    _is_docker_desktop 2>/dev/null && is_dd=true
    if _is_macos || $is_dd; then pool_vm=true; fi
    [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )) \
      && host_note=" of your ${BOLD}$(( host_bytes / 1073741824 )) GB${RESET}"

    # Compare in the SAME whole-GB unit the message prints (vm_gb, the configured
    # slider via _docker_vm_display_gb), not raw MemTotal bytes: a slider that
    # rounds UP relative to MemTotal would otherwise let the trigger fire while the
    # printed "promised X of Y" reads as parity (X == Y) or even inverted, the
    # "shows X but warns it's too small" contradiction _vm_gb_rounded forbids.
    local overloaded=false sum_gb=0
    [[ "$sum" =~ ^[0-9]+$ ]] && sum_gb=$(( sum / 1073741824 ))
    [[ "$sum" =~ ^[0-9]+$ ]] && (( sum_gb > vm_gb )) && overloaded=true

    # 2a. OVERLOAD (periodic): the sessions running RIGHT NOW are promised more
    #     memory than the VM has. Real on any engine, so the warn always fires and
    #     names the real RAM. The follow-up is honest about the host: where the VM
    #     can safely grow (recommended > current) we point at the Docker Desktop
    #     memory slider; where it can't (the VM is already near ~¾ of host RAM,
    #     e.g. a 7 GB VM on an 8 GB Mac) growing it is impossible/harmful, so we
    #     steer to running fewer sessions or lowering a box's own ceiling instead.
    #     Never suggests a VM target below the current. Shown on the daily check
    #     only (it's transient, not a config error worth nagging every start).
    if $overloaded && $bloat_due; then
      echo ""
      # Name the COUNT of running cleat sessions, not just a GB number: "promised
      # 25 GB" next to a 24 GB slider reads like an off-by-one rounding bug, when
      # it's really N boxes each reserving a quarter-of-VM ceiling. The GB clause
      # has a SEPARATE subject ("running containers"), because the sum spans ALL
      # running containers (the VM is shared) while the count is cleat-only: a
      # non-cleat stack must not be mislabeled as cleat sessions. "reserve
      # ceilings" (not "promised") also stops the number reading as a hard
      # reservation or live usage (idle boxes touch a fraction of their ceiling).
      # _s is computed with a standalone `(( )) && _s=s` (set -e safe: a failing
      # non-final command of a top-level &&-list is exempt), NOT inside the
      # assignment, where the substitution's exit 1 on the singular case would
      # abort `cleat start` under `set -euo pipefail`.
      local _n_boxes _who _s=""
      _n_boxes="$(_running_cleat_box_count)"
      if [[ "$_n_boxes" =~ ^[0-9]+$ ]] && (( _n_boxes > 0 )); then
        (( _n_boxes != 1 )) && _s="s"
        _who="${_n_boxes} session${_s} still running"
      else
        _who="Sessions are still running"
      fi
      # Name the pool truthfully: a native Linux engine has no VM, the ceilings
      # overcommit the host's own RAM (host_note would read "N GB of your N GB"
      # there, pure noise, so it stays VM-only).
      if $pool_vm; then
        warn "${_who}; running containers reserve ${sum_gb} GB of memory ceilings but the Docker VM holds only ${vm_gb} GB${host_note}. Under load they swap together and freeze."
      else
        warn "${_who}; running containers reserve ${sum_gb} GB of memory ceilings but the host has only ${vm_gb} GB of RAM. Under load they swap together and freeze."
      fi
      if $is_dd && (( rec_gb > vm_gb )); then
        echo -e "    ${DIM}Closing a terminal does not stop its box. Stop one you are done with, or give Docker more memory (Docker Desktop only):${RESET}"
        _print_docker_vm_fix "$host_bytes" "$rec_gb"
      else
        echo -e "    ${DIM}Closing a terminal does not stop its box. Stop ones you are done with (${RESET}${BOLD}cleat stop${RESET}${DIM}), or lower a box's ceiling with ${RESET}${BOLD}[resources] memory${RESET}${DIM} in .cleat.${RESET}"
      fi
      printed=true
      _VM_ADVISORY_SHOWN=1

    # 2b. UNDERSIZED VM for parallel work: Docker-Desktop-only (a native-Linux
    #     engine's "VM" is the host: nothing to resize). The recommendation is
    #     host-aware (the comfortable-default target, capped at half the host RAM).
    #     This is the invalid CONFIG, so it shows on EVERY start while the VM is
    #     below the target, until it's set right (not throttled: a once-a-day nudge
    #     is too easy to miss, and a smooth run depends on the VM being sized well).
    #     Host RAM unknown → conservative 8 GiB floor so we never over-recommend.
    elif $is_dd; then
      local bad=false
      # Compare in WHOLE rounded GB (vm_gb), never raw bytes: the kernel's
      # MemTotal undershoots the slider, so a byte compare against an exact GiB
      # target false-positives a correctly-sized VM (a 16 GB slider reads ~15.6
      # GiB < 16 GiB). vm_gb already rounds that back to 16. The announce-ready
      # all-clear mirrors this test exactly; keep the two in lockstep.
      if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
        (( vm_gb < rec_gb )) && bad=true
      else
        (( vm_gb < _PRESSURE_VM_ADVISORY_BYTES / 1073741824 )) && bad=true
      fi
      if $bad; then
        echo ""
        warn "Docker VM memory is ${BOLD}${vm_gb} GB${RESET}${host_note}. Tight for parallel sessions."
        echo -e "    ${DIM}Each box reserves a memory ceiling (a quarter of the VM). Give Docker more memory (Docker Desktop only):${RESET}"
        _print_docker_vm_fix "$host_bytes" "$rec_gb"
        printed=true
        _VM_ADVISORY_SHOWN=1
        # A real config error (the slider set too low), not a transient state:
        # arm the gate so the interactive launch stops on it (concept/21).
        _DOCKER_GATE_PENDING=1
        _DOCKER_GATE_SUMMARY="Docker VM memory is ${vm_gb} GB (aim for ${rec_gb} GB)."
      fi
    fi
  fi

  # One blank line separates whatever we printed from the release highlight (or
  # the bring-up) that follows. Flag the open gap so the highlight doesn't add a
  # second blank of its own.
  if $printed; then
    echo ""
    _ONSTART_GAP_OPEN=1
  fi
}

# The every-start, positive counterpart to the pressure advisory: when the Docker
# VM is sized right for parallel work, say so in ONE green line that sits directly
# above the bring-up. Runs on every session-launching start (NOT daily-gated like
# the warning: the reassurance is wanted each time), and is the exact inverse of
# the 2b "undersized" test, so the two are complementary, never both, never
# contradictory: a correctly sized VM shows this, an undersized one shows the
# warning. Costs one `docker info` for MemTotal plus, on Linux only, a second
# single-field read for the engine noun (_docker_pool_is_vm; macOS
# short-circuits); the host read is local.
#
# One twist on top of the inverse: even with memory sized right, swap may be left
# at the Docker Desktop default. So when memory passes but swap reads below the
# target, this prints a focused swap advisory in place of the all-clear (memory is
# good, swap needs a nudge). Swap that can't be read falls through to the all-clear.
#
# Whitespace: one blank ABOVE unless an earlier notice already opened the gap, and
# NEVER a trailing blank, so "Image ready" flows straight on from this line and
# the two read as one contiguous block (the placement the maintainer asked for).
# Silent off a TTY, when the VM size can't be read, or when the VM is undersized
# (don't claim "tuned" when it isn't, and don't fight the warning).
_maybe_announce_docker_ready() {
  _is_tty || return 0
  # Defer to the warning: if the pressure check already flagged the VM (overload or
  # undersized) this run, stay silent so a "tuned" nod and a warning never both
  # appear (the overload case can fire even on an adequately sized VM).
  [[ "${_VM_ADVISORY_SHOWN:-0}" == "1" ]] && return 0
  local vm_bytes vm_gb host_bytes rec_gb
  vm_bytes="$(_docker_vm_memory)"
  [[ "$vm_bytes" =~ ^[0-9]+$ ]] && (( vm_bytes > 0 )) || return 0
  vm_gb="$(_docker_vm_display_gb "$vm_bytes")"   # prefer the configured slider (see _docker_vm_display_gb)
  host_bytes="$(_host_total_memory)"
  rec_gb="$(_recommended_vm_gb "$host_bytes")"
  # Adequately sized? Mirror the 2b "bad" test EXACTLY: compare WHOLE rounded GB
  # (host-aware target when host RAM is known, else the conservative 8 GiB floor)
  # so this and the warning are perfect complements. A byte compare here would
  # disagree with the rounded vm_gb the warning shows (a 16 GB slider reading
  # ~15.6 GiB would stay silent here AND trip the warning there). Anything below
  # the target is "undersized" and stays silent.
  if [[ "$host_bytes" =~ ^[0-9]+$ ]] && (( host_bytes > 0 )); then
    (( vm_gb < rec_gb )) && return 0
  else
    (( vm_gb < _PRESSURE_VM_ADVISORY_BYTES / 1073741824 )) && return 0
  fi

  # Memory is sized right. One more check before the all-clear: swap. The memory
  # slider and the swap slider are separate, so a user who bumps memory (often on
  # our own advice) can leave swap at the Docker Desktop default, too little
  # overflow for a brief spike, so a session freezes instead of paging out. When
  # swap reads below the target, say what's right (memory) AND what still needs a
  # nudge (swap) rather than a blanket "tuned". `docker info` can't report swap,
  # so this reads Docker Desktop's settings file; a value we can't trust returns
  # empty and falls through to the all-clear (never warn on a guess). Same
  # whitespace as the tuned line: one blank above unless a gap is open, none below.
  local swap_bytes
  swap_bytes="$(_docker_vm_swap_bytes)"
  if [[ "$swap_bytes" =~ ^[0-9]+$ ]] && (( swap_bytes < _SWAP_ADVISORY_BYTES )); then
    [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
    # Describe the shortfall honestly. NOT _human_bytes here: it rounds (%.0f), so
    # 1.5 GB would read "2 GB" and contradict the "set Swap ≥ 2 GB" step below, and
    # 0 would render "?". Floored GB never rounds a sub-2 GB value up; sub-GB shows
    # MB; 0 reads as "disabled".
    if (( swap_bytes == 0 )); then
      warn "Docker memory is sized right, but swap is ${BOLD}disabled${RESET}. A memory spike can freeze a session instead of paging out."
      _DOCKER_GATE_SUMMARY="Docker swap is disabled (aim for ≥ 2 GB)."
    else
      local swap_human
      if (( swap_bytes < 1073741824 )); then
        swap_human="$(( swap_bytes / 1048576 )) MB"
      else
        swap_human="$(( swap_bytes / 1073741824 )) GB"
      fi
      warn "Docker memory is sized right, but its swap is only ${BOLD}${swap_human}${RESET}. A memory spike can freeze a session instead of paging out."
      _DOCKER_GATE_SUMMARY="Docker swap is only ${swap_human} (aim for ≥ 2 GB)."
    fi
    echo -e "    ${DIM}Add overflow headroom (Docker Desktop only):${RESET}"
    echo -e "    ${DIM}•${RESET} ${BOLD}Settings → Resources → Advanced${RESET}${DIM}: set ${RESET}${BOLD}Swap ≥ 2 GB${RESET}${DIM}, then Apply & restart${RESET}"
    _VM_ADVISORY_SHOWN=1   # defensive symmetry with the pressure check; no on-start step reads it after this today
    # Swap left at the default is a real config error too (freezes under a spike),
    # so arm the gate to hold the launch on it (concept/21).
    _DOCKER_GATE_PENDING=1
    # We printed content and left NO trailing blank, so the gap above the gate is
    # closed: clear the flag so the gate opens its own single blank (else it would
    # sit flush against this fix line). The undersized path leaves the flag set (a
    # trailing blank is genuinely open above the gate), so the gate skips its blank.
    _ONSTART_GAP_OPEN=0
    return 0
  fi

  [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
  # No session count: "many" is honest (light sessions run dozens), a number reads
  # as a hard cap and isn't true. A box can OOM only if it does genuinely heavy
  # memory work, the same way Claude Code can outside Docker, and that is rare.
  #
  # Name the pool truthfully. VM-backed engines (Docker Desktop anywhere, every
  # macOS backend) keep "tuned" and "VM": a slider exists and it is sized right.
  # A native Linux engine has no VM and no knob was tuned, so it reads "ready"
  # and "RAM". And a small native host (below the 8 GiB advisory floor, which
  # the undersized warning never covers because there is nothing to resize)
  # earns no parallel-headroom claim: four 1 GB ceilings is not "room for
  # many", so the line states the size and stops.
  local pool_vm=false
  _docker_pool_is_vm 2>/dev/null && pool_vm=true
  if $pool_vm; then
    success "Docker tuned for Cleat ${RESET}${DIM}(${vm_gb} GB VM, room for many parallel sessions)${RESET}"
  elif (( vm_gb >= _PRESSURE_VM_ADVISORY_BYTES / 1073741824 )); then
    success "Docker ready for Cleat ${RESET}${DIM}(${vm_gb} GB RAM, room for many parallel sessions)${RESET}"
  else
    success "Docker ready for Cleat ${RESET}${DIM}(${vm_gb} GB RAM available to boxes)${RESET}"
  fi
}

# The one place Cleat deliberately BLOCKS the launch. concept/21's startup rule is
# "never block, never nag", and every other on-start notice honors it. This is the
# single documented exception: when Docker itself is misconfigured (the VM memory
# slider set too low, or swap left at the tiny default), the non-blocking advisory
# that already printed above proved missable in the field. A user ran degraded for
# a long time because the amber warning "just blinked" past on start, then reported
# Cleat as slow. So for a genuine CONFIG error (never the transient overload notice,
# which a `cleat stop` resolves) we hold the launch for one keypress, so the warning
# cannot scroll by unread.
#
# Guardrails that keep this from breaking the "walk away" pillar:
#   - Interactive-only: BOTH stdin and stdout must be a terminal (_is_interactive),
#     so unattended runs (cron, pipes, `</dev/null`, CI) never reach the read.
#   - Escape hatch: CLEAT_NO_DOCKER_GATE=1 keeps the printed advisory but skips the
#     hold, for someone who runs cleat interactively yet has accepted their setup.
#     This knob earns its keep precisely because the behavior it gates is blocking
#     (the env-var philosophy in concept/21 reserves opt-outs for network calls and
#     for blocking prompts, not for cosmetic notices).
#   - Fail-open: a `read` that hits EOF falls through (|| true) instead of hanging,
#     and the function always returns 0 (it runs bare in main's dispatch under the
#     binary's `set -euo pipefail`).
#
# Fires only when an advisory ABOVE armed _DOCKER_GATE_PENDING (undersized VM
# memory in _maybe_check_docker_pressure, or low/disabled swap in
# _maybe_announce_docker_ready). A well-tuned Docker never arms it, so this stays
# silent on every healthy start.
_maybe_gate_on_docker_config() {
  [[ "${_DOCKER_GATE_PENDING:-0}" == "1" ]] || return 0
  # WSL2 memory is elastic (the VM reclaims RAM back to Windows), so a hard hold
  # on an "undersized" WSL VM is more likely a false alarm than a real block. The
  # advisory above already printed (now .wslconfig-correct); skip only the hold.
  _is_wsl && return 0
  _is_interactive || return 0
  [[ "${CLEAT_NO_DOCKER_GATE:-}" == "1" ]] && return 0

  # A prominent, full-width amber banner: the whole point is that this cannot be
  # mistaken for a passing line or scroll by unnoticed. ASCII rule off a UTF-8
  # locale so the box never renders as mojibake.
  local rule
  if _has_unicode; then
    rule="────────────────────────────────────────────────"
  else
    rule="================================================"
  fi
  # One blank above the banner, never two. Same convention as the highlight and
  # the "tuned"/swap line: if the printer above us already left its trailing blank
  # (_ONSTART_GAP_OPEN=1, e.g. the undersized advisory + highlight both do), don't
  # add a second. The swap-advisory path closes the gap (it prints content with no
  # trailing blank and resets the flag), so there we open it ourselves.
  [[ "${_ONSTART_GAP_OPEN:-0}" == "1" ]] || echo ""
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo -e "  ${AMBER}${BOLD}  Docker is not tuned for Cleat${RESET}"
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo ""
  if [[ -n "${_DOCKER_GATE_SUMMARY:-}" ]]; then
    echo -e "  ${AMBER}!${RESET} ${BOLD}${_DOCKER_GATE_SUMMARY}${RESET} ${DIM}Sessions will run slow or freeze under load.${RESET}"
  fi
  echo -e "    ${DIM}Fix Docker with the steps above, then re-run ${RESET}${BOLD}cleat${RESET}${DIM}.${RESET}"
  echo -e "    ${DIM}To skip this stop from now on: ${RESET}${BOLD}CLEAT_NO_DOCKER_GATE=1${RESET}${DIM}.${RESET}"
  echo ""
  echo -en "  ${BLUE}▸${RESET} Press ${BOLD}Enter${RESET} to launch anyway, or ${BOLD}Ctrl-C${RESET} to stop and fix Docker first "
  local _ack=""
  read -r _ack || true
  echo ""
  return 0
}

# ── Disk-fill advisory + gate (cross-OS) ─────────────────────────────────────
# The MECHANISM is engine-agnostic: `df` runs inside the box (always Linux) and
# reads the shared docker storage. Only the guidance COPY branches per backend.

# True when the active docker endpoint is REMOTE (ssh:// or tcp:// to a non-local
# host), where we cannot advise on a local host disk. Local iff empty, a unix
# socket, or a Windows named pipe. Seam.
_docker_endpoint_is_remote() {
  local ep; ep="$(_docker_context_endpoint)"
  case "$ep" in
    ""|unix://*|npipe://*) return 1 ;;
    *) return 0 ;;
  esac
}

# The daemon's data-root (native /var/lib/docker, rootless ~/.local/share/docker,
# etc.), resolved live so the copy names the real path. Falls back to the common
# default. Seam.
_docker_root_dir() {
  local d
  d="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
  [[ -n "$d" ]] && printf '%s' "$d" || printf '/var/lib/docker'
}

# Read the shared Docker storage fill from inside a RUNNING box: prints
# "<use_pct> <avail_kb>" or nothing on any failure. `df -kP /` reports the
# container overlay's backing store, which IS the shared docker storage on every
# engine (the VM disk on VM engines, the host data-root on native Linux).
# `/workspace` would report the HOST disk (a different number) so we use `/`.
# `-kP` forces 1024-byte POSIX blocks and one data row. Fail-soft: a stopped or
# unreadable box, or a down daemon, yields empty output. Seam (test override).
_read_container_disk_use() {
  local cname="$1"
  [[ -n "$cname" ]] || return 0
  docker exec "$cname" df -kP / 2>/dev/null \
    | awk '$NF=="/" { p=$5; gsub(/%/,"",p); print p" "$4 }' || true
}

# The disk-help LEVER branch for the current backend (daemon is UP when this
# runs): desktop | orbstack | colima | wsl | linux-host | generic.
# _is_docker_desktop (a docker info read) wins first so an OrbStack daemon on a
# Mac that also has Docker Desktop installed never inherits the Desktop slider.
# WSL in-distro is its OWN kind (its vhdx grows and does not auto-shrink, unlike
# native Linux where deletes free space immediately). A remote endpoint has no
# local host to advise on -> generic. Seam.
_disk_help_kind() {
  # WSL first: an in-distro or Docker-Desktop-WSL2 store is a vhdx compacted via
  # `wsl`, never a Desktop disk slider, so a WSL2 + Docker Desktop host must NOT
  # inherit the desktop lever (it would name a slider that backend has removed).
  _is_wsl && { echo wsl; return 0; }
  _is_docker_desktop 2>/dev/null && { echo desktop; return 0; }
  if _is_macos; then
    case "$(_autostart_pick 2>/dev/null)" in
      orbstack)        echo orbstack ;;
      colima|colima:*) echo colima ;;
      *)               echo generic ;;
    esac
    return 0
  fi
  _docker_endpoint_is_remote && { echo generic; return 0; }
  echo linux-host
}

# The banner subject phrase for a kind ("<phrase> is 96% full"). Neutral about
# auto-shrink (that differs per engine and lives in the lever).
_disk_subject() {
  case "$1" in
    wsl)        printf 'The WSL distro disk' ;;
    linux-host) printf 'The host disk' ;;
    generic)    printf "Docker's disk" ;;
    *)          printf 'The Docker VM disk' ;;
  esac
}

# One concise, engine-correct lever line (DIM/BOLD formatted), reused by the
# advisory, the gate banner, the ENOSPC backstop and `cleat storage`. Every
# branch stays honest about how THIS backend returns host space. $2 is the left
# indent, defaulting to the 4 spaces the notice blocks use. `cleat storage`
# passes 2 so the lever lines up with the prose line above it in that block.
_disk_lever_short() {
  local i="${2:-    }"
  case "$1" in
    desktop)
      echo -e "${i}${DIM}Docker Desktop: reclaim with ${RESET}${BOLD}cleat prune --cache${RESET}${DIM}, or raise the disk-size slider in ${RESET}${BOLD}Settings → Resources → Advanced${RESET}${DIM}.${RESET}" ;;
    orbstack)
      echo -e "${i}${DIM}OrbStack has no size slider. Free the Mac or run ${RESET}${BOLD}cleat prune --cache${RESET}${DIM}. OrbStack usually returns the space. A restart reclaims it if not.${RESET}" ;;
    colima)
      echo -e "${i}${DIM}Colima: grow the VM disk with ${RESET}${BOLD}colima start --disk <N>${RESET}${DIM} then restart (add ${RESET}${BOLD}-p <profile>${RESET}${DIM} for a named profile), or reclaim with ${RESET}${BOLD}colima ssh -- sudo fstrim -a${RESET}${DIM}.${RESET}" ;;
    wsl)
      echo -e "${i}${DIM}WSL: free space, then shrink the distro disk with ${RESET}${BOLD}wsl --manage ${WSL_DISTRO_NAME:-<distro>} --set-sparse true${RESET}${DIM} (reclaims on a later WSL shutdown).${RESET}" ;;
    linux-host)
      echo -e "${i}${DIM}Linux: ${RESET}${BOLD}cleat prune --cache${RESET}${DIM} frees the host disk immediately, or grow the partition holding ${RESET}${BOLD}$(_docker_root_dir)${RESET}${DIM}.${RESET}" ;;
    *)
      echo -e "${i}${DIM}Free space with ${RESET}${BOLD}cleat prune --cache${RESET}${DIM}. Inspect with ${RESET}${BOLD}docker system df${RESET}${DIM}.${RESET}" ;;
  esac
}

# ENOSPC backstop: when a docker bring-up error is an out-of-space error, name
# the full store and print the engine-correct lever. The disk gate cannot read
# fill when the box will not start, so this covers the "too full to bring up"
# case. Callable and testable in isolation. Fail-soft: no file or no match is
# silent, always returns 0. Arg: $1 = the captured docker stderr file.
_maybe_explain_enospc() {
  local errfile="$1"
  [[ -s "$errfile" ]] || return 0
  grep -qiE 'no space left|ENOSPC' "$errfile" 2>/dev/null || return 0
  local dk; dk="$(_disk_help_kind)"
  echo ""
  warn "$(_disk_subject "$dk") is full, so the box could not start."
  _disk_lever_short "$dk"
}

# Post-bring-up disk-fill check (called from cmd_start/cmd_resume/cmd_claude
# right after _print_summary_block, before exec_claude). Reads the shared Docker
# storage Use%+free from inside the just-started box and, in two tiers, prints a
# read-only advisory (>= _DISK_ADVISORY_PCT AND low free) or a full-width amber
# banner that HOLDS the launch on one keypress (>= _DISK_GATE_PCT AND lower
# free). Cap-relative Use%, so a 60 GB and a 1.8 TB disk trip at the same
# fullness. Fail-soft: off a TTY, on an unreadable fill, or a down daemon it
# stays silent. Always returns 0 (runs bare under set -euo pipefail).
_maybe_gate_on_disk_fill() {
  local cname="$1"
  _is_tty || return 0
  [[ -n "$cname" ]] || return 0

  local read_out pct avail_kb free_gb
  read_out="$(_read_container_disk_use "$cname")"
  pct="${read_out%% *}"
  avail_kb="${read_out##* }"
  [[ "$pct" =~ ^[0-9]+$ && "$avail_kb" =~ ^[0-9]+$ ]] || return 0
  free_gb=$(( avail_kb / 1048576 ))

  # Advisory predicate: high fill AND genuinely low free. The free floor removes
  # the 95%-of-1.8-TB = 90-GB-free false positive (it can only ever REMOVE a
  # trigger). Below the band: silence.
  (( pct >= _DISK_ADVISORY_PCT && free_gb < _DISK_ADVISORY_FREE_GB )) || return 0

  local gate=false
  (( pct >= _DISK_GATE_PCT && free_gb < _DISK_GATE_FREE_GB )) && gate=true

  local kind subject
  kind="$(_disk_help_kind)"
  subject="$(_disk_subject "$kind")"

  # Cleat's OWN reclaimable images only (label-scoped, container-pinned excluded).
  # Honest by construction: never includes build cache or volumes (shared).
  local stats mb reclaim_gb=0
  stats="$(_cleat_prunable_stats)"
  mb="${stats##*	}"
  [[ "$mb" =~ ^[0-9]+$ ]] && reclaim_gb=$(( (mb + 512) / 1024 ))

  if ! $gate; then
    # ADVISORY band: read-only, daily-throttled with its OWN stamp (the memory
    # check already stamped PRESSURE_CHECK_FILE this run).
    local now last=0
    now="$(date +%s)"
    if [[ -f "$DISK_CHECK_FILE" ]]; then
      last="$(head -1 "$DISK_CHECK_FILE" 2>/dev/null || echo 0)"
      [[ "$last" =~ ^[0-9]+$ ]] || last=0
    fi
    (( now - last < DISK_CHECK_INTERVAL )) && return 0
    echo "$now" > "$DISK_CHECK_FILE" 2>/dev/null || true

    echo ""
    warn "${subject} is ${BOLD}${pct}% full${RESET} ${DIM}(${free_gb} GB free)${RESET}. Every Cleat box shares it."
    if (( reclaim_gb >= 1 )); then
      echo -e "    ${DIM}Cleat can reclaim ~${reclaim_gb} GB of stale images: ${RESET}${BOLD}cleat prune${RESET}"
    fi
    echo -e "    ${DIM}What is using the disk: ${RESET}${BOLD}cleat storage${RESET}"
    _disk_lever_short "$kind"
    return 0
  fi

  # HARD band: full-width amber banner + one-keypress hold. The banner IS the
  # escalated advisory (same substance plus the keypress), never printed on top
  # of the compact advisory.
  local rule
  if _has_unicode; then
    rule="────────────────────────────────────────────────"
  else
    rule="================================================"
  fi
  echo ""
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo -e "  ${AMBER}${BOLD}  Docker's disk is almost full${RESET}"
  echo -e "  ${AMBER}${BOLD}${rule}${RESET}"
  echo ""
  echo -e "  ${AMBER}!${RESET} ${BOLD}${subject} is ${pct}% full (${free_gb} GB free).${RESET} Writes across every Cleat box are about to fail."
  echo -e "    ${DIM}Every box shares this one disk, so one full disk stops them all.${RESET}"
  echo ""
  if (( reclaim_gb >= 1 )); then
    echo -e "    ${DIM}Cleat can reclaim ~${reclaim_gb} GB of stale images: ${RESET}${BOLD}cleat prune${RESET}"
  else
    echo -e "    ${DIM}Cleat's own images are not the bulk here. Most of the space is other projects or build cache.${RESET}"
  fi
  echo -e "    ${DIM}What is using the disk: ${RESET}${BOLD}cleat storage${RESET}"
  _disk_lever_short "$kind"
  echo ""

  # The hold: interactive-only and escapable, mirroring the config gate. The box
  # is ALREADY running here (we just read its df), so Ctrl-C does NOT stop it:
  # the copy says so truthfully instead of the config gate's "Ctrl-C to stop".
  if _is_interactive && [[ "${CLEAT_NO_DISK_GATE:-}" != "1" ]]; then
    echo -e "    ${DIM}To skip this stop from now on: ${RESET}${BOLD}CLEAT_NO_DISK_GATE=1${RESET}${DIM}.${RESET}"
    echo -e "    ${DIM}Ctrl-C stops here but leaves the box running. Free disk, then run cleat again.${RESET}"
    echo ""
    echo -en "  ${BLUE}▸${RESET} Press ${BOLD}Enter${RESET} to continue into the session, or ${BOLD}Ctrl-C${RESET} to stop "
    local _ack=""
    read -r _ack || true
  fi
  return 0
}

cmd_clean() {
  # Every prune below asks docker whether a box still exists. With the daemon
  # down every answer is no, so every box description and every run dir (the
  # overlays, the conversations' file history and a staged login) was removed
  # for boxes that still exist.
  if ! _daemon_up; then
    error "Docker is not running, so cleat cannot tell which boxes still exist."
    echo -e "    ${DIM}Start it, then run ${BOLD}cleat clean${RESET}${DIM} again. Nothing was removed.${RESET}"
    return 1
  fi
  cmd_stop_all
  if image_exists; then
    info "Removing image..."
    docker rmi "$IMAGE_NAME" > /dev/null
    success "Image removed."
  else
    info "No image to remove."
  fi

  # Prune orphaned box descriptions (boxes whose container no longer exists).
  if [[ -d "$CLEAT_BOXES_DIR" ]]; then
    local _bf _bcn
    for _bf in "$CLEAT_BOXES_DIR"/*; do
      [[ -f "$_bf" ]] || continue
      _bcn="$(basename "$_bf")"
      # NEVER prune a fork marker. Stripping the suffix was not enough: `cleat
      # rm <box>` deliberately removes the container and KEEPS the copy, so the
      # marker legitimately outlives the container. Pruning it there re-binds
      # the next run to the LIVE tree, and a later --fork then rm -rf's the copy
      # that `cleat rm` promised to keep. This is the one per-box state file
      # whose whole purpose is to outlive its container.
      case "$_bf" in *.fork) continue ;; esac
      if ! container_exists "$_bcn"; then rm -f "$_bf" 2>/dev/null || true; fi
    done
  fi

  # Prune orphaned per-container runtime dirs: overlays for containers that no
  # longer exist (project dir moved/deleted, or the container was removed
  # outside cleat). cmd_stop_all only stops containers, so live ones still
  # exist and their dirs are kept. Kept LAST so its if/fi guard remains
  # cmd_clean's final statement (a trailing false `[[ ]] &&` would exit 1).
  if [[ -d "$CLEAT_RUN_DIR" ]]; then
    local _d _cn _pruned=0
    for _d in "$CLEAT_RUN_DIR"/*/; do
      [[ -d "$_d" ]] || continue
      _cn="$(basename "$_d")"
      if ! container_exists "$_cn"; then
        # Through the harvesting wipe, not a raw rm: an orphaned run dir can
        # still hold the only copy of a token the box refreshed for a named
        # account. This was the one wipe in the file that skipped it.
        _account_wipe_run_dir "$_cn"
        _pruned=$((_pruned + 1))
      fi
    done
    # Use if/fi, not `[[ ]] &&`: a trailing false test would make cmd_clean
    # (the last statement in main) exit 1 on a successful run with 0 orphans.
    if [[ $_pruned -gt 0 ]]; then info "Pruned ${_pruned} orphaned runtime dir(s)."; fi
  fi
}

cmd_nuke() {
  echo ""
  warn "This will remove ${BOLD}ALL${RESET} Cleat containers and images."
  echo -e "  ${DIM}It also clears the shared Docker build cache used by all projects (regenerable).${RESET}"
  echo -e "  ${DIM}Your project files and ~/.claude auth are safe (they live on the host).${RESET}"
  echo ""
  # `|| confirm=""` so a closed or non-terminal stdin is the SAFE answer. Without
  # it read returns non-zero at EOF and strict mode killed the command mid-prompt.
  local confirm=""
  read -rp "  Type 'nuke' to confirm: " confirm || confirm=""
  if [[ "$confirm" != "nuke" ]]; then
    info "Aborted."
    return
  fi
  echo ""

  local containers
  containers=$(docker ps -a --filter "name=^cleat-" --format '{{.Names}}' 2>/dev/null)
  if [[ -n "$containers" ]]; then
    info "Removing containers..."
    echo "$containers" | while read -r c; do
      docker rm -f "$c" > /dev/null 2>&1
      echo -e "    ${DIM}removed ${c}${RESET}"
    done
  fi

  if image_exists; then
    info "Removing image..."
    docker rmi -f "$IMAGE_NAME" > /dev/null 2>&1
  fi

  # Per-container runtime dirs (overlays / clipboard / hook spool) are persistent
  # now, so /tmp rotation won't reclaim them: wipe them explicitly.
  if [[ -d "$CLEAT_RUN_DIR" ]]; then
    info "Removing per-container runtime dirs..."
    # The staged credential a box refreshed in place lives under the run dir,
    # so harvest before the wipe or nuke destroys weeks of refresh token while
    # saying it did not. What the harvest does not take, and any other login in
    # a run dir, is held first. The wipe itself goes through _nuke_wipe_dir,
    # which refuses any directory holding the account store.
    local _rel=0
    _account_release_all || _rel=$?
    if [[ $_rel -eq 0 ]]; then
      _nuke_wipe_dir "$CLEAT_RUN_DIR"
    elif [[ $_rel -eq $_ACCOUNT_LOCK_BUSY ]]; then
      warn "Kept ${CLEAT_RUN_DIR}: another cleat command is changing accounts."
    else
      warn "Kept ${CLEAT_RUN_DIR}: a box there holds a login that could not be saved anywhere else."
    fi
  fi

  # Per-project persistent .claude.json store (trust/MCP approvals): nuke
  # removes everything Cleat-related, so clear it too. (cleat rm preserves it.)
  if [[ -d "$CLEAT_PROJECTS_DIR" ]]; then
    info "Removing per-project Claude state..."
    _nuke_wipe_dir "$CLEAT_PROJECTS_DIR"
  fi

  if [[ -d "$CLEAT_BOXES_DIR" ]]; then
    # A fork marker whose COPY still exists has to survive this. nuke removes
    # containers, images and build cache; it deliberately does NOT remove fork
    # workspaces, because a copy can hold the only version of hours of agent
    # work (the same reason cleat rm keeps it). But the marker lived in this
    # directory, so wiping it left the copy orphaned AND unmarked, and the next
    # `cleat start <box> --fork` then read the box as a brand-new fork,
    # re-copied, and _fork_copy_tree_locked rm -rf'd the surviving copy first.
    # Silent destruction of work by a command that never claimed to touch it.
    local _nk _nc _nkeep=()
    for _nk in "$CLEAT_BOXES_DIR"/*.fork; do
      [[ -f "$_nk" ]] || continue
      _nc="${_nk##*/}"; _nc="${_nc%.fork}"
      [[ -d "$(_fork_dir "$_nc")" ]] && _nkeep+=("$_nc")
    done
    _nuke_wipe_dir "$CLEAT_BOXES_DIR"
    for _nc in "${_nkeep[@]+"${_nkeep[@]}"}"; do
      _fork_mark "$_nc"
    done
    if [[ ${#_nkeep[@]} -gt 0 ]]; then
      info "Kept ${#_nkeep[@]} fork workspace $( [[ ${#_nkeep[@]} -eq 1 ]] && echo copy || echo copies ) and their markers."
      echo -e "    ${DIM}Copies can hold work that was never committed. Remove them with ${BOLD}cleat fork prune${RESET}${DIM}.${RESET}"
    fi
  fi

  if [[ -d "$CLEAT_KITS_DIR" ]]; then
    _nuke_wipe_dir "$CLEAT_KITS_DIR"
  fi

  # Dangling cleat builds only (label-scoped): other projects' dangling images
  # are not ours to delete. Same _dangling_cleat_images seam cmd_prune uses.
  local _did id
  _did="$(_dangling_cleat_images)"
  if [[ -n "$_did" ]]; then
    info "Pruning dangling cleat images..."
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      docker rmi "$id" > /dev/null 2>&1 || true
    done <<< "$_did"
  fi

  info "Pruning build cache ${DIM}(shared across all Docker projects)${RESET}..."
  docker builder prune -f > /dev/null 2>&1 || true

  echo ""
  success "Nuked. All Cleat containers and images are gone from Docker."
  echo -e "  ${DIM}Run ${BOLD}cleat start${RESET}${DIM} to rebuild from scratch.${RESET}"
  echo ""
}

# Format a byte count as GB for display ("12.3 GB", or "36 GB" when >= 10).
_fmt_gb() {
  LC_ALL=C awk -v b="${1:-0}" 'BEGIN { g = b / 1073741824; printf (g >= 10 ? "%.0f GB" : "%.1f GB"), g }'
}

# Fill of the shared docker store as "used_kb total_kb pct", read from a running
# cleat box first, else a one-shot on cleat's OWN image (never a foreign
# container: reading into another project's box crosses the boundary cleat
# defends). Empty when neither is available. Seam (test override).
_storage_fill() {
  local cname
  cname="$(_running_cleat_boxes 2>/dev/null | head -1)"
  if [[ -n "$cname" ]]; then
    docker exec "$cname" df -kP / 2>/dev/null \
      | awk '$NF=="/" { p=$5; gsub(/%/,"",p); print $3" "$2" "p }' || true
    return 0
  fi
  if image_exists 2>/dev/null; then
    docker run --rm --entrypoint df "$IMAGE_NAME" -kP / 2>/dev/null \
      | awk '$NF=="/" { p=$5; gsub(/%/,"",p); print $3" "$2" "p }' || true
  fi
}

# `cleat storage`: a read-only, cross-OS breakdown of the shared Docker store.
# Honest attribution: cleat IMAGES + BOXES are label-scoped (attributable);
# build cache and volumes are shared/other-project (never called "cleat's").
# Never mutates: docker system df is on-demand here, never on the start path.
cmd_storage() {
  if ! _daemon_up; then
    error "Docker is not running."
    echo -e "  ${DIM}Start it, then run ${RESET}${BOLD}cleat storage${RESET}${DIM} again.${RESET}"
    return 1
  fi

  local kind; kind="$(_disk_help_kind)"

  echo ""
  echo -e "  ${BOLD}Docker storage${RESET}   ${DIM}one shared store, used by every container on this host${RESET}"
  echo ""

  # Fill bar (the cap-relative number the field incident proved matters).
  local fill used_kb total_kb pct
  fill="$(_storage_fill)"
  if [[ -n "$fill" ]]; then
    used_kb="${fill%% *}"
    total_kb="$(printf '%s' "$fill" | awk '{print $2}')"
    pct="${fill##* }"
    [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
    [[ "$used_kb" =~ ^[0-9]+$ ]] || used_kb=0
    [[ "$total_kb" =~ ^[0-9]+$ ]] || total_kb=0
    local barw=28 filled empty gl gd bar="" bar2="" i=0 tier
    filled=$(( pct * barw / 100 ))
    (( filled > barw )) && filled=barw
    (( filled < 0 )) && filled=0
    empty=$(( barw - filled ))
    if _has_unicode; then gl="█"; gd="░"; else gl="#"; gd="-"; fi
    while (( i < filled )); do bar="${bar}${gl}"; i=$(( i + 1 )); done
    i=0
    while (( i < empty )); do bar2="${bar2}${gd}"; i=$(( i + 1 )); done
    if   (( pct >= _DISK_GATE_PCT ));     then tier="$RED"
    elif (( pct >= _DISK_ADVISORY_PCT )); then tier="$AMBER"
    else tier="$GREEN"; fi
    echo -e "  ${BLUE}▸${RESET} ${BOLD}Disk${RESET}   ${tier}${bar}${RESET}${DIM}${bar2}${RESET}   ${BOLD}$(_fmt_gb $(( used_kb * 1024 )))${RESET} ${DIM}/ $(_fmt_gb $(( total_kb * 1024 )))${RESET}   ${BOLD}${pct}% full${RESET}"
  else
    echo -e "  ${BLUE}▸${RESET} ${BOLD}Disk${RESET}   ${DIM}(start a box to read live fill: ${RESET}${BOLD}cleat start${RESET}${DIM})${RESET}"
  fi
  echo ""

  # Authoritative per-type totals from docker system df (on-demand, never on
  # start). Value-only fields, so the " (NN%)" reclaimable suffix stays parseable.
  local t s r
  local img_b=0 img_rb=0 con_b=0 con_rb=0 vol_b=0 vol_rb=0 cache_b=0 cache_rb=0
  while IFS="$(printf '\t')" read -r t s r; do
    case "$t" in
      Images)          img_b="$(_human_size_to_bytes "$s")";   img_rb="$(_human_size_to_bytes "$r")" ;;
      Containers)      con_b="$(_human_size_to_bytes "$s")";   con_rb="$(_human_size_to_bytes "$r")" ;;
      "Local Volumes") vol_b="$(_human_size_to_bytes "$s")";   vol_rb="$(_human_size_to_bytes "$r")" ;;
      "Build Cache")   cache_b="$(_human_size_to_bytes "$s")"; cache_rb="$(_human_size_to_bytes "$r")" ;;
    esac
  done < <(docker system df --format "{{.Type}}$(printf '\t'){{.Size}}$(printf '\t'){{.Reclaimable}}" 2>/dev/null)

  echo -e "  ${BOLD}On disk${RESET} ${DIM}(all projects)${RESET}"
  printf "    %-20s %9s   %11s\n" "" "size" "reclaimable"
  printf "    %-20s %9s   %11s\n" "Images"     "$(_fmt_gb "$img_b")"   "$(_fmt_gb "$img_rb")"
  printf "    %-20s %9s   %11s\n" "Containers" "$(_fmt_gb "$con_b")"   "$(_fmt_gb "$con_rb")"
  printf "    %-20s %9s   %11s\n" "Volumes"    "$(_fmt_gb "$vol_b")"   "$(_fmt_gb "$vol_rb")"
  printf "    %-20s %9s   %11s\n" "Build cache (shared)" "$(_fmt_gb "$cache_b")" "$(_fmt_gb "$cache_rb")"
  echo ""

  # Cleat's attributable share: COUNTS (a byte sum of {{.Size}} would double-count
  # shared base layers, so we show counts plus the accurate reclaimable figure).
  local cleat_img_n=0 cleat_box_n=0 id seen=" "
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    case "$seen" in *" $id "*) continue ;; esac
    seen="$seen$id "
    cleat_img_n=$(( cleat_img_n + 1 ))
  done < <(docker images --filter label=sh.cleat.version --format '{{.ID}}' 2>/dev/null)
  local nm
  while IFS= read -r nm; do
    [[ -n "$nm" ]] && cleat_box_n=$(( cleat_box_n + 1 ))
  done < <(docker ps -a --filter label=sh.cleat.version --format '{{.Names}}' 2>/dev/null)

  # Cleat's reclaimable images (accurate, label-scoped, container-pinned excluded).
  local stats mb cleat_reclaim_b=0
  stats="$(_cleat_prunable_stats)"
  mb="${stats##*	}"
  [[ "$mb" =~ ^[0-9]+$ ]] && cleat_reclaim_b=$(( mb * 1048576 ))

  echo -e "  ${BOLD}Cleat's share${RESET}"
  printf "    %-20s %2s image%s, %s box%s\n" "" "$cleat_img_n" "$( (( cleat_img_n != 1 )) && printf s )" "$cleat_box_n" "$( (( cleat_box_n != 1 )) && printf es )"
  echo ""
  echo -e "  ${BOLD}Cleat can reclaim${RESET}"
  echo -e "    ${GREEN}$(_fmt_gb "$cleat_reclaim_b")${RESET}   ${DIM}stale cleat images${RESET}      ${BOLD}cleat prune${RESET}"
  echo -e "    ${DIM}$(_fmt_gb "$cache_rb")${RESET}   ${DIM}shared build cache${RESET}     ${BOLD}cleat prune --cache${RESET} ${DIM}(all projects)${RESET}"
  echo ""
  echo -e "  ${DIM}Other projects hold the rest. Cleat never deletes them. See ${RESET}${BOLD}docker system df${RESET}${DIM}.${RESET}"
  # Same 2-space indent as the line above and no blank between them: these two
  # are one closing paragraph (where the rest went, then how to get space back),
  # not the indented tail of a notice block.
  _disk_lever_short "$kind" "  "
  echo ""
}

# ── Sessions (concept/43-session-management.md) ─────────────────────────────
# Claude Code writes one transcript per conversation and never deletes one on
# demand: the terminal CLI has `claude project purge` (a whole project at once)
# and a `cleanupPeriodDays` sweep that removes by last-modified date, but no way
# to remove ONE. Cleat already owns the directory those transcripts land in
# (_derive_project_session_key, mounted per box at cmd_run), so it is the natural
# place to manage them. `cleat session` lists them with real sizes, renames one
# and moves one to a trash it can restore from.
#
# Two facts shape everything below.
#
# 1. A session is TWO filesystem objects, not one: <uuid>.jsonl and a sibling
#    <uuid>/ directory holding subagent transcripts, workflow state and tool
#    results. Measured on the maintainer's own repo the sidecar is ~5x the
#    transcript (118 MB vs 938 MB for the largest), so a size column or a delete
#    that sees only the .jsonl under-reports by 8x and silently leaves most of
#    the bytes behind. They are always handled as one unit.
#
# 2. The directory is NOT a pure session store. It also holds Claude Code's
#    per-project auto-memory (memory/), cleat's own history.jsonl (created at
#    cmd_run and bind-mounted live into every box of this project), and whatever
#    scratch directories agents made. A `*` glob or a subtractive "everything
#    that is not X" rule would eat the user's memory and orphan a live mount.
#    Every operation is gated on a strict UUID allowlist instead.

# The strict UUID shape, as a `case` glob rather than a regex: bash 3.2 has no
# {n} repetition in its POSIX ERE, and writing it out leaves nothing to a
# locale or a bracket-escape surprise. This is the single highest-value guard in
# the feature: nothing is listed, renamed, trashed or restored whose basename
# does not match it.
_sessions_is_uuid() {
  case "$1" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) return 0 ;;
    *) return 1 ;;
  esac
}

# The host directory holding this project+box's transcripts. The SAME formula
# cmd_run uses to create and mount it, reached through the same two helpers, so
# the two can never drift.
_sessions_key_dir() {
  local project="$1" box="${2:-}"
  local key
  key="$(_derive_project_session_key "$project" "$box")"
  # Defence in depth against a degenerate key: _derive_project_session_key always
  # appends an md5 fragment so it cannot return empty, but the whole feature
  # joins paths onto this and an empty value would aim every later operation at
  # ~/.claude/projects itself.
  [[ -n "$key" ]] || return 1
  printf '%s' "${HOME}/.claude/projects/${key}"
}

# Pull the LAST value of a JSON string key out of a blob.
#
# ERE, not BRE. The obvious BRE form uses \| for alternation, which is a GNU
# extension that silently matches NOTHING on BSD grep, i.e. every title on the
# maintainer's own Mac would read "(no title)" while the Linux CI leg stayed
# green. `grep -a` because a transcript can carry bytes that make grep call the
# file binary and print nothing.
#
# The pattern requires the CLOSING quote, which is also the torn-read guard: the
# host and a running box share this inode, so a fixed-size window can cut a
# record mid-string. A candidate with no closing quote is simply not matched and
# the caller falls through to the next source, which is stronger than trying to
# validate the surrounding record shape.
_sessions_json_str() {
  local blob="$1" key="$2" hit
  hit="$(printf '%s' "$blob" | LC_ALL=C grep -aoE "\"${key}\":\"([^\"\\\\]|\\\\.)*\"" | tail -1)" || hit=""
  [[ -n "$hit" ]] || return 1
  # Strip  "key":"  from the front and the single trailing quote.
  hit="${hit#\"${key}\":\"}"
  hit="${hit%\"}"
  printf '%s' "$hit"
}

# Undo JSON string escapes, left to right.
#
# Left-to-right is required, not stylistic: a global ${v//\\n/ } would turn an
# ESCAPED backslash followed by the letter n into a newline, so `C:\new` renders
# as two lines. \uXXXX becomes '?' because bash 3.2's printf has no \u and
# emitting the six literal characters into a terminal row is the worse of the
# two wrong answers.
_sessions_json_unesc() {
  # Two statements deliberately. `local s="$1" n=${#s}` expands the whole
  # command's words BEFORE any assignment takes effect, so n would be 0.
  local s="$1"
  local out="" i=0 n
  n=${#s}
  local c d
  while [[ $i -lt $n ]]; do
    c="${s:$i:1}"
    if [[ "$c" == "\\" && $((i + 1)) -lt $n ]]; then
      d="${s:$((i + 1)):1}"
      case "$d" in
        n|t)  out="${out} "; i=$((i + 2)) ;;
        r)    i=$((i + 2)) ;;
        u)    out="${out}?"; i=$((i + 6)) ;;
        *)    out="${out}${d}"; i=$((i + 2)) ;;
      esac
    else
      out="${out}${c}"
      i=$((i + 1))
    fi
  done
  printf '%s' "$out"
}

# How many bytes of a transcript to read when resolving its title. Fixed, so a
# 118 MB transcript costs the same as a 2 KB one: measured at 0.007s against the
# real 118 MB file, and 0.226s to scan all 27 sessions including du over 1.3 GB
# of sidecars. Reading whole files instead would make the list unusable.
_SESSIONS_TITLE_WINDOW=65536

# Resolve the label shown for a session, in Claude Code's own precedence order.
#
# A user-set title (/rename, Ctrl+R in the picker, -n at launch) is written as a
# `custom-title` record and ALSO as a <uuid>/custom-title.json sidecar. The
# record wins: on every already-titled session in the maintainer's corpus the
# record sits inside the last 64 KiB, because Claude re-stamps it on each
# session open. That is why a cleat rename writes BOTH and why the sidecar alone
# is not enough (it would be silently shadowed).
#
# `ai-title` is Claude's own generated title and is deliberately ranked below a
# custom one. The head read is last because it is the only one that can pick up
# a title from a session whose tail has scrolled past it.
_sessions_title_for() {
  local sdir="$1" uuid="$2"
  local f="${sdir}/${uuid}.jsonl" tail_blob head_blob v
  if [[ -f "$f" ]]; then
    tail_blob="$(tail -c "$_SESSIONS_TITLE_WINDOW" "$f" 2>/dev/null || true)"
    if v="$(_sessions_json_str "$tail_blob" customTitle)"; then
      _sessions_json_unesc "$v"; return 0
    fi
  fi
  # Windowed like the transcript, and for the same reason: this file is written
  # inside the box, so an unbounded `cat` here is an in-box agent's lever on
  # host memory. A symlinked sidecar is refused outright rather than followed.
  if [[ -f "${sdir}/${uuid}/custom-title.json" ]] && [[ ! -L "${sdir}/${uuid}/custom-title.json" ]]; then
    if v="$(_sessions_json_str "$(head -c "$_SESSIONS_TITLE_WINDOW" "${sdir}/${uuid}/custom-title.json" 2>/dev/null || true)" customTitle)"; then
      _sessions_json_unesc "$v"; return 0
    fi
  fi
  if [[ -n "${tail_blob:-}" ]]; then
    if v="$(_sessions_json_str "$tail_blob" aiTitle)"; then
      _sessions_json_unesc "$v"; return 0
    fi
    if v="$(_sessions_json_str "$tail_blob" lastPrompt)"; then
      _sessions_json_unesc "$v"; return 0
    fi
  fi
  if [[ -f "$f" ]]; then
    head_blob="$(head -c "$_SESSIONS_TITLE_WINDOW" "$f" 2>/dev/null || true)"
    if v="$(_sessions_json_str "$head_blob" aiTitle)"; then
      _sessions_json_unesc "$v"; return 0
    fi
  fi
  printf '%s' "(no title)"
}

# Total apparent bytes a session occupies: transcript + sidecar directory.
# _fork_size_kb is reused verbatim because it is already the one `du -sk` form
# BSD and GNU agree on, already keeps its `|| true` INSIDE the pipeline (a du
# that cannot descend still prints a valid total but exits non-zero, which
# pipefail turned into "0 KB" for real multi-gigabyte trees), and already
# carries the apparent-size caveat this feature has to repeat in its output.
_sessions_size_kb() {
  local sdir="$1" uuid="$2" bytes=0 kb=0 out
  if [[ -f "${sdir}/${uuid}.jsonl" ]]; then
    out="$(wc -c < "${sdir}/${uuid}.jsonl" 2>/dev/null || echo 0)"
    # BSD wc left-pads its output, so take the first field rather than the word.
    set -- $out
    case "${1:-}" in ''|*[!0-9]*) bytes=0 ;; *) bytes="$1" ;; esac
  fi
  kb=$(( bytes / 1024 ))
  if [[ -d "${sdir}/${uuid}" ]]; then
    kb=$(( kb + $(_fork_size_kb "${sdir}/${uuid}") ))
  fi
  printf '%s' "$kb"
}

# One tab-joined row per session: mtime, size in KB, uuid, title. Sorted by the
# caller. Only strict-UUID basenames are considered, which is what keeps
# history.jsonl (same directory, matches *.jsonl, and a LIVE bind source for
# every running box of this project) out of the list.
_sessions_scan() {
  local sdir="$1"
  local f base uuid mt kb title
  [[ -d "$sdir" ]] || return 0
  for f in "$sdir"/*.jsonl; do
    # No nullglob anywhere in this CLI, so an empty directory yields the literal
    # pattern.
    [[ -f "$f" ]] || continue
    base="${f##*/}"
    uuid="${base%.jsonl}"
    _sessions_is_uuid "$uuid" || continue
    mt="$(_path_mtime "$f")"
    kb="$(_sessions_size_kb "$sdir" "$uuid")"
    title="$(_sessions_title_for "$sdir" "$uuid")"
    printf '%s\t%s\t%s\t%s\n' "$mt" "$kb" "$uuid" "$title"
  done
}

# Newest first. `sort -rn` on the leading numeric field; an unreadable stat
# yields mtime 0 from _path_mtime, which sorts last rather than crashing.
_sessions_scan_sorted() {
  _sessions_scan "$1" | sort -t "$(printf '\t')" -k1,1rn
}

# Physical containment, the guard whose absence cost a real host directory on
# 2026-07-31 (see _fork_rm_tree). Modelled on _fork_path_under_root but takes
# the root as a parameter, because that one hardcodes _fork_root.
#
# Both layers are kept and both are load-bearing. The textual test forces the
# target ABSOLUTE and under the root: `cd -P` honours CDPATH for a relative
# argument, so a physical-parent check used alone can be redirected. The
# physical test then resolves '..' and symlinked parents, which the textual one
# cannot. Parent-must-BE-root (not merely under it) is right because a
# transcript and its sidecar both sit exactly one level down.
_sessions_path_under_key() {
  local target="$1" root="$2" base root_p parent_p
  base="${target##*/}"
  # history.jsonl is redundant against the UUID test every caller already ran,
  # and it is asserted anyway: it is cleat's own file, it matches *.jsonl, and
  # it is bind-mounted live into every box of this project, so losing it is the
  # one mistake in this directory that breaks a RUNNING container.
  case "$base" in ''|.|..|history.jsonl) return 1 ;; esac
  case "$target" in "$root"/?*) : ;; *) return 1 ;; esac
  [[ -L "$target" ]] && return 1
  root_p="$(cd -P "$root" 2>/dev/null && pwd -P)" || return 1
  parent_p="$(cd -P "$(dirname "$target")" 2>/dev/null && pwd -P)" || return 1
  [[ "$parent_p" == "$root_p" ]]
}

# Refuse to write in this key dir when the box might still be writing it.
#
# "A delete must never run on a probe that cannot answer" (the rule written
# after the 2026-07-31 fork-prune incident, where a stopped daemon made every
# live box read as an orphan). A down daemon cannot answer whether the box is
# running, so it refuses rather than assuming idle.
#
# Deliberately built on cleat's own tested primitives and NOT on Claude Code's
# ~/.claude/sessions/<pid>.json store. That store is an undocumented internal of
# a pinned third-party binary, its pid is container-namespaced and meaningless
# to a Mac that has no process table for it, and reading it would add a "the
# format moved and we silently fell open" failure mode. _box_has_live_agent
# already fails SAFE: an unreadable or empty `docker top` counts as live.
_sessions_live_gate() {
  local cname="$1" box="$2"
  if ! _daemon_up; then
    error "Docker is not responding, so cleat cannot tell whether ${BOLD}${box}${RESET} is running."
    echo -e "    ${DIM}Start Docker and try again. Listing sessions works without it.${RESET}"
    return 1
  fi
  if container_exists "$cname" && is_running "$cname" && _box_has_live_agent "$cname"; then
    error "Box ${BOLD}${box}${RESET} has a live Claude session."
    echo -e "    ${DIM}Stop it first: ${BOLD}cleat stop ${box}${RESET}${DIM}. Claude keeps appending to the transcript while it runs.${RESET}"
    return 1
  fi
  return 0
}

# ── Resume target: which conversation `cleat resume` reopens, on which model ──
#
# In-box probe, run as the box user. Prints the sessionId of every Claude Code
# process that is ALIVE in this box, one per line. Claude Code registers each
# running process at ~/.claude/sessions/<pid>.json with its sessionId (it
# follows /clear) and its start time (field 22 of /proc/<pid>/stat,
# "procStart"). The file is removed on a clean exit but survives a SIGKILL, an
# OOM or a container stop, and pids restart at 1 after a restart, so a bare
# kill -0 would count a stale file as live. $1 = sessions dir, $2 = proc root:
# parameters so the probe runs in a test without a container or a Linux /proc.
# Plain sed, no jq. The output is box-authored: the host keeps only UUID lines
# and only ever uses them to EXCLUDE a conversation.
_RESUME_LIVE_PROBE='d="$1"; pr="$2"
for f in "$d"/*.json; do
  [ -f "$f" ] && [ ! -L "$f" ] || continue
  p="${f##*/}"; p="${p%.json}"
  case "$p" in ""|*[!0-9]*) continue ;; esac
  [ -r "$pr/$p/stat" ] || continue
  st="$(sed "s/^.*) //" "$pr/$p/stat" 2>/dev/null | cut -d" " -f20)"
  j="$(head -c 16384 "$f" 2>/dev/null)"
  ps="$(printf "%s\n" "$j" | sed -n "s/.*\"procStart\"[[:space:]]*:[[:space:]]*\"\([0-9]*\)\".*/\1/p" | head -n 1)"
  [ -n "$st" ] && [ "$st" = "$ps" ] || continue
  printf "%s\n" "$j" | sed -n "s/.*\"sessionId\"[[:space:]]*:[[:space:]]*\"\([0-9a-f-]*\)\".*/\1/p" | head -n 1
done'

# Seconds the resume live-session probe may take before it counts as no answer.
_RESUME_PROBE_BOUND_S=8

# Session ids held by a live Claude Code process in a RUNNING box, one per
# line. A probe that cannot answer prints nothing, which is today's behaviour
# (nothing excluded), never a refusal.
_box_live_session_ids() {
  local cname="$1" out="" line
  # Bounded through _run_bounded, which falls back to gtimeout and then perl. A
  # stock Mac has no timeout(1), and the bare `timeout 8` form ran the probe
  # unbounded there, so a wedged daemon hung `cleat resume`.
  out="$(_run_bounded "$_RESUME_PROBE_BOUND_S" docker exec "$cname" runuser -u coder -- sh -c "$_RESUME_LIVE_PROBE" _ \
        /home/coder/.claude/sessions /proc 2>/dev/null)" || out=""
  while IFS= read -r line; do
    _sessions_is_uuid "$line" && printf '%s\n' "$line"
  done <<EOF
$out
EOF
  return 0
}

# The head and tail a resume reads: the same 64 KiB Claude Code reads when it
# lists sessions, so the two agree on what counts as a conversation.
_RESUME_WINDOW=65536

# The conversation `cleat resume` reopens: the one Claude Code's own --continue
# would pick, minus any conversation a live process in this box already has
# open. Prints a UUID, or nothing when there is no candidate.
#
# Why not --continue itself: it skips a live conversation only when it is a
# BACKGROUND session. An interactive one open in another terminal is fair game,
# so the resumed process and the live one append to one transcript with
# different histories in memory.
#
# Mirrors Claude Code 2.1.270's --continue: newest transcript by mtime (measured
# in the lab, not the /resume picker's last-message date), skipping one with no
# conversation record ("parentUuid"), a sidechain and a `claude -p` (sdk-*)
# session. $1 = host session dir, $2 = newline-separated live ids.
_resume_pick_session() {
  local sdir="$1" live="$2" tab f uuid mt rows="" head_blob tail_blob
  [[ -d "$sdir" ]] || return 0
  tab="$(printf '\t')"
  for f in "$sdir"/*.jsonl; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    uuid="${f##*/}"; uuid="${uuid%.jsonl}"
    _sessions_is_uuid "$uuid" || continue
    case "$live" in *"$uuid"*) continue ;; esac
    rows="${rows}$(_path_mtime "$f")${tab}${uuid}
"
  done
  [[ -n "$rows" ]] || return 0
  while IFS="$tab" read -r mt uuid; do
    [[ -n "$uuid" ]] || continue
    f="$sdir/$uuid.jsonl"
    head_blob="$(head -c "$_RESUME_WINDOW" "$f" 2>/dev/null || true)"
    case "$head_blob" in *'"isSidechain":true'*|*'"entrypoint":"sdk-'*) continue ;; esac
    tail_blob="$(tail -c "$_RESUME_WINDOW" "$f" 2>/dev/null || true)"
    case "$head_blob$tail_blob" in *'"parentUuid":'*) ;; *) continue ;; esac
    printf '%s' "$uuid"
    return 0
  done <<ROWS
$(printf '%s' "$rows" | sort -t "$tab" -k1,1rn)
ROWS
  return 0
}

# The --model a resumed conversation needs to keep the context window it had,
# or nothing. Claude Code restores a resumed conversation's model from its last
# assistant message, which records the bare id (claude-opus-5), and adds [1m]
# back only when a model is CONFIGURED with [1m]. On the default model nothing
# is configured, so every --continue and --resume came back on the standard
# window. The run that wrote the transcript recorded its usage under the model
# it really ran ("claude-opus-5[1m]" in its cost-state record): that is the
# evidence. Without it nothing is passed, so a conversation that never had 1M
# keeps Claude Code's own restore.
_RESUME_CARRY_WINDOW=1048576
_resume_model_carry() {
  local f="$1" blob line m
  [[ -f "$f" && ! -L "$f" ]] || return 0
  blob="$(tail -c "$_RESUME_CARRY_WINDOW" "$f" 2>/dev/null || true)"
  line="$(printf '%s\n' "$blob" | LC_ALL=C grep -a '"role":"assistant"' \
          | LC_ALL=C grep -av '"isSidechain":true' | LC_ALL=C grep -a '"model":"claude-' | tail -n 1)" || line=""
  [[ -n "$line" ]] || return 0
  m="${line#*\"model\":\"}"; m="${m%%\"*}"
  case "$m" in claude-*) ;; *) return 0 ;; esac
  case "$m" in *[!a-z0-9.-]*) return 0 ;; esac
  case "$blob" in *"\"${m}[1m]\":"*) printf '%s[1m]' "$m"; return 0 ;; esac
  # H7: a conversation too large for the standard window must have run with 1M,
  # even when no [1m] usage key was written. At a usage limit the last assistant
  # record is the synthetic rate-limit error with zero usage, so the [1m] key
  # can be absent from a 1M conversation. The SIZE is the proof: a standard
  # window (200,000 tokens) cannot hold more than that, so a larger last real
  # usage means 1M. Provisional with R-context (O2). See _resume_last_usage_tokens.
  local usage sum
  usage="$(_resume_last_usage_tokens "$f")"
  case "$usage" in
    *"$(printf '\t')"*) sum="${usage##*$(printf '\t')}" ;;
    *) return 0 ;;
  esac
  case "$sum" in ''|*[!0-9]*) return 0 ;; esac
  [[ $sum -gt $_HANDOFF_STD_WINDOW_TOKENS ]] && printf '%s[1m]' "$m"
  return 0
}

# The model and the summed context of the last real assistant turn, `<model>\t
# <sum>`, or nothing. Reads the last `"type":"assistant"` record in the carry
# window that is not a sidechain, not an API-error record and carries a
# `"model":"claude-..."` value (so the synthetic rate-limit record never
# matches). The sum is its input_tokens plus both cache token counts, each key
# taken with its leading quote so input_tokens is not read out of
# cache_read_input_tokens. Nothing when any of the three is absent. H7 reads it
# for the 1M size rule; cmd_resume shares it.
_resume_last_usage_tokens() {
  local f="$1" blob line m rest it cr cc sum tab
  [[ -f "$f" && ! -L "$f" ]] || return 0
  tab="$(printf '\t')"
  blob="$(tail -c "$_RESUME_CARRY_WINDOW" "$f" 2>/dev/null || true)"
  line="$(printf '%s\n' "$blob" \
          | LC_ALL=C grep -a '"type":"assistant"' \
          | LC_ALL=C grep -av '"isSidechain":true' \
          | LC_ALL=C grep -av '"isApiErrorMessage":true' \
          | LC_ALL=C grep -a '"model":"claude-' \
          | tail -n 1)" || line=""
  [[ -n "$line" ]] || return 0
  m="${line#*\"model\":\"}"; m="${m%%\"*}"
  case "$m" in claude-*) ;; *) return 0 ;; esac
  case "$m" in *[!a-z0-9.-]*) return 0 ;; esac
  rest="${line#*\"input_tokens\":}"; [[ "$rest" != "$line" ]] || return 0
  it="${rest%%[!0-9]*}"; [[ -n "$it" ]] || return 0
  rest="${line#*\"cache_read_input_tokens\":}"; [[ "$rest" != "$line" ]] || return 0
  cr="${rest%%[!0-9]*}"; [[ -n "$cr" ]] || return 0
  rest="${line#*\"cache_creation_input_tokens\":}"; [[ "$rest" != "$line" ]] || return 0
  cc="${rest%%[!0-9]*}"; [[ -n "$cc" ]] || return 0
  sum=$(( it + cr + cc ))
  printf '%s%s%s' "$m" "$tab" "$sum"
  return 0
}

# Whether the box has a model CONFIGURED: an env pin (.cleat.env, --env), or a
# "model" or ANTHROPIC_*MODEL entry in the user's or the project's settings.
# Claude Code loses [1m] only when none is. With one configured, its own restore
# is what the user chose (opusplan[1m], for one, switches models by mode and
# must not be pinned), so the carry applies only to the unconfigured default.
# A symlink is never read.
_resume_model_configured() {
  local project="$1" e f blob re='"(model|ANTHROPIC_MODEL|ANTHROPIC_DEFAULT_[A-Z]+_MODEL)"[[:space:]]*:'
  for e in "${_RESOLVED_ENV_ARGS[@]+"${_RESOLVED_ENV_ARGS[@]}"}"; do
    case "$e" in ANTHROPIC_MODEL=*|ANTHROPIC_DEFAULT_*_MODEL=*) return 0 ;; esac
  done
  for f in "${HOME}/.claude/settings.json" "$project/.claude/settings.json" "$project/.claude/settings.local.json"; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    # No pipe into grep -q: under pipefail an early grep exit fails the pipeline.
    blob="$(head -c "$_RESUME_CARRY_WINDOW" "$f" 2>/dev/null || true)"
    [[ "$blob" =~ $re ]] && return 0
  done
  return 1
}

# Every path a delete takes, one per line. Items 1-2 are the session itself;
# 3-5 match Claude Code's own retention sweep; 6-10 are per-session state it
# leaves behind. Each is existence-guarded by the caller and a missing one is
# success, because a delete can race the vendor's own 30-day sweep.
#
# NOTE the two DIFFERENT key derivations, and do not conflate them: the session
# directory is keyed <basename>-<md5_8> by _derive_project_session_key, while
# Claude Code's own /tmp scratch path is keyed by _claude_session_key, its
# encoding of the working directory. Conflating those two is exactly the fork
# bug documented at _claude_session_key.
_sessions_delete_set() {
  local sdir="$1" uuid="$2" project="$3" cname="$4"
  printf '%s\n' "${sdir}/${uuid}.jsonl"
  printf '%s\n' "${sdir}/${uuid}"
  printf '%s\n' "${sdir}/${uuid}.ccr-tip.json"
  printf '%s\n' "${sdir}/${uuid}.precompact.json"
  printf '%s\n' "${sdir}/${uuid}.desktop-released.json"
  # Pre-edit copies of the user's real source files (what /rewind restores from).
  # Per box under _CLAUDE_PRIVATE_DIRS, and on the host for a native session.
  printf '%s\n' "${CLEAT_RUN_DIR}/${cname}/home/file-history/${uuid}"
  printf '%s\n' "${HOME}/.claude/file-history/${uuid}"
  # Hook env files. Per box under _CLAUDE_PRIVATE_DIRS as well, and on the host
  # for a native session.
  printf '%s\n' "${CLEAT_RUN_DIR}/${cname}/home/session-env/${uuid}"
  printf '%s\n' "${HOME}/.claude/session-env/${uuid}"
  printf '%s\n' "/tmp/claude-$(id -u)/$(_claude_session_key "$project")/${uuid}"
}

# Where a deleted session goes. Inside the key dir on purpose: `mv` is then a
# rename on one filesystem, so trashing the 938 MB sidecar copies zero bytes and
# is instant. A copy-based trash would be indefensible at that size.
# The trash directory, refused when it is not a real directory sitting directly
# inside the session dir. It lives in a tree the box mounts read-write, so a
# symlink planted there would relocate a "deleted" session outside the session
# directory while the delete reported success. Every source path is contained;
# the destination has to be too.
_sessions_trash_dir() {
  local d="${1}/.cleat-trash"
  if [[ -L "$d" ]]; then
    return 1
  fi
  if [[ -e "$d" ]] && [[ ! -d "$d" ]]; then
    return 1
  fi
  printf '%s' "$d"
}

_SESSIONS_TRASH_DAYS=30

# Drop trash entries older than _SESSIONS_TRASH_DAYS. Matches only the
# <epoch>-<uuid> naming this feature writes, so nothing else in the directory is
# ever a candidate. Fail-soft: a sweep that cannot read the clock does nothing.
_sessions_trash_sweep() {
  local sdir="$1" tdir now cutoff d base stamp
  tdir="$(_sessions_trash_dir "$sdir")" || return 0
  [[ -d "$tdir" ]] || return 0
  now="$(date +%s 2>/dev/null || echo 0)"
  case "$now" in ''|*[!0-9]*|0) return 0 ;; esac
  cutoff=$(( now - _SESSIONS_TRASH_DAYS * 86400 ))
  for d in "$tdir"/*; do
    [[ -d "$d" ]] || continue
    base="${d##*/}"
    stamp="${base%%-*}"
    case "$stamp" in ''|*[!0-9]*) continue ;; esac
    _sessions_is_uuid "${base#*-}" || continue
    [[ "$stamp" -lt "$cutoff" ]] || continue
    _sessions_path_under_key "$d" "$tdir" || continue
    rm -rf "$d"
  done
}

# Move one session's files into the trash. Returns 1 and touches nothing if the
# transcript fails containment. An individual `mv` that fails is REPORTED and
# left in place; it is never retried as an `rm`.
_sessions_trash() {
  local sdir="$1" uuid="$2" project="$3" cname="$4"
  local tdir dest p base now failed=0
  now="$(date +%s 2>/dev/null || echo 0)"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  # Exit 2 is "the trash itself is unusable", which is a REFUSAL. Exit 1 is
  # "some individual items could not be moved", which is a warning. The caller
  # has to tell them apart or a poisoned trash directory reads as a success.
  tdir="$(_sessions_trash_dir "$sdir")" || return 2
  dest="${tdir}/${now}-${uuid}"
  mkdir -p "$dest" || return 1
  local idx=0 target moved=0
  while IFS= read -r p; do
    idx=$(( idx + 1 ))
    [[ -n "$p" ]] || continue
    [[ -e "$p" ]] || continue
    base="${p##*/}"
    # Only the two objects that live in the key dir get the containment check;
    # the rest are absolute paths this function built from fixed roots.
    case "$p" in
      "$sdir"/*)
        if ! _sessions_path_under_key "$p" "$sdir"; then
          warn "Refusing to move a path outside the session directory: ${p}"
          failed=1
          continue
        fi
        # Items in the key dir keep their real basename, because that is what
        # _sessions_restore looks for when putting them back.
        target="${dest}/${base}" ;;
      *)
        # Everything else is namespaced by its position in the delete set.
        # SIX of the ten paths end in a bare <uuid> (the sidecar, two
        # file-history trees, two session-env dirs and the /tmp scratch), so a flat
        # basename made the first one land as a directory and every later one
        # get moved INSIDE it: the bytes were buried rather than trashed, and
        # restore could never find them again.
        target="${dest}/ext${idx}-${base}" ;;
    esac
    if ! mv "$p" "$target" 2>/dev/null; then
      warn "Left in place ${DIM}(could not move)${RESET}: ${p}"
      failed=1
    else
      moved=$(( moved + 1 ))
    fi
  done < <(_sessions_delete_set "$sdir" "$uuid" "$project" "$cname")
  # Nothing moved means there was nothing there: another terminal deleted this
  # session between the confirm and here. Leaving the empty directory behind
  # would report success, put a row in the trash view that restores nothing,
  # and hold that lie for thirty days. Exit 3 is "there was nothing to move".
  if [[ $moved -eq 0 ]]; then
    rmdir "$dest" 2>/dev/null || true
    return 3
  fi
  return $failed
}

# Put a trashed session back. The reverse of _sessions_trash, under the same
# containment guard, and it refuses to overwrite anything that reappeared.
_sessions_restore() {
  local sdir="$1" uuid="$2"
  local tdir d base found="" p
  tdir="$(_sessions_trash_dir "$sdir")" || return 1
  [[ -d "$tdir" ]] || return 1
  for d in "$tdir"/*-"$uuid"; do
    [[ -d "$d" ]] || continue
    found="$d"
  done
  [[ -n "$found" ]] || return 1
  for p in "$found"/*; do
    [[ -e "$p" ]] || continue
    base="${p##*/}"
    case "$base" in
      "${uuid}.jsonl"|"$uuid"|"${uuid}."*)
        [[ -e "${sdir}/${base}" ]] && continue
        mv "$p" "${sdir}/${base}" 2>/dev/null || true ;;
    esac
  done
  rmdir "$found" 2>/dev/null || true
  [[ -f "${sdir}/${uuid}.jsonl" ]]
}

# One tab-joined row per TRASHED session, in the same four-field shape the live
# scan emits, so the picker can render either list with the same code.
#
# Field 1 is the trash stamp rather than the transcript's mtime, so the age
# column reads as "how long ago I deleted this", which is also how long is left
# before the sweep takes it.
#
# The title comes from _sessions_title_for pointed at the trash ENTRY directory,
# which works because _sessions_trash keeps the real basenames for the two items
# that live in the key dir: <uuid>.jsonl and the <uuid>/ sidecar land inside the
# entry under their own names. Everything else in there is namespaced ext<n>-.
_sessions_trash_scan() {
  local sdir="$1"
  local tdir d base stamp uuid kb title
  tdir="$(_sessions_trash_dir "$sdir")" || return 0
  [[ -d "$tdir" ]] || return 0
  for d in "$tdir"/*; do
    [[ -d "$d" ]] || continue
    base="${d##*/}"
    stamp="${base%%-*}"
    case "$stamp" in ''|*[!0-9]*) continue ;; esac
    uuid="${base#*-}"
    _sessions_is_uuid "$uuid" || continue
    kb="$(_fork_size_kb "$d")"
    case "$kb" in ''|*[!0-9]*) kb=0 ;; esac
    title="$(_sessions_title_for "$d" "$uuid")"
    printf '%s\t%s\t%s\t%s\n' "$stamp" "$kb" "$uuid" "$title"
  done
}

# Most recently deleted first, matching the live list's newest-first order.
_sessions_trash_scan_sorted() {
  _sessions_trash_scan "$1" | sort -t "$(printf '\t')" -k1,1rn
}

# How many sessions are in the trash. Deliberately does NOT size or title them:
# this runs once per list screen only to decide whether to offer the trash at
# all, so it must stay fork-free. Counts exactly what the scan would count.
_sessions_trash_count() {
  local sdir="$1" tdir d base n=0
  tdir="$(_sessions_trash_dir "$sdir")" || { printf '0'; return 0; }
  if [[ -d "$tdir" ]]; then
    for d in "$tdir"/*; do
      [[ -d "$d" ]] || continue
      base="${d##*/}"
      case "${base%%-*}" in ''|*[!0-9]*) continue ;; esac
      _sessions_is_uuid "${base#*-}" || continue
      n=$(( n + 1 ))
    done
  fi
  printf '%s' "$n"
}

# What a title may contain. REJECT rather than escape, deliberately.
#
# bash 3.2 has no JSON encoder and jq is optional in this CLI (every use is
# `command -v jq` guarded), so hand-rolled escaping is the kind of thing that
# looks right and is not. The failure is not a cosmetic one: a title of
#   x"}<newline>{"type":"user","message":{...}}<newline>{"pad":"
# appended naively produces THREE lines that all parse as valid JSON, the middle
# one an arbitrary forged conversation record inside the user's own transcript.
# A whitelist cannot produce that, and it is one `case`.
#
# The subshell pins LC_ALL=C so ' '-'~' is a byte range and not a collation.
# Deliberately NOT a =~ regex: POSIX ERE has no \xNN, and bash strips the
# backslash, so ^[\x20-\x7e]{1,64}$ silently degrades into a class that ACCEPTS
# backslash and REJECTS the space.
_sessions_title_ok() (
  LC_ALL=C
  local t="$1"
  [ -n "$t" ] || return 1
  [ ${#t} -le 64 ] || return 1
  case "$t" in
    *[!\ -~]*) return 1 ;;
    *[\"\\]*)  return 1 ;;
    ' '*|*' ') return 1 ;;
  esac
  return 0
)

# Write a new title. Both stores, in Claude Code's own precedence order.
#
# The transcript record is the one that shows: every already-titled session in
# the maintainer's corpus carries its custom-title record inside the last 64 KiB
# (Claude re-stamps it on each session open), so a sidecar-only write would be
# silently shadowed on all of them. The sidecar is written too so the two never
# disagree, whichever one a future Claude Code reads first.
#
# An `ai-title` record would NOT work: that is Claude's own generated title,
# ranked below a custom one, so it would simply be outranked.
_sessions_rename_write() {
  local sdir="$1" uuid="$2" title="$3"
  local f="${sdir}/${uuid}.jsonl" stamp last tmp
  [[ -f "$f" ]] || return 1

  # Stamp the mtime so it can be put back. `touch -r` is POSIX and identical on
  # BSD and GNU, unlike `date -r` / `date -d`, and it costs nothing next to
  # copying a 118 MB file to preserve its timestamp.
  stamp="${sdir}/.cleat-mtime.$$"
  touch -r "$f" "$stamp" 2>/dev/null || stamp=""

  # A record appended after a file that does not end in a newline would join the
  # last line and corrupt both. Command substitution strips trailing newlines,
  # so an empty result means the file already ends in one.
  last="$(tail -c 1 "$f" 2>/dev/null || true)"
  [[ -n "$last" ]] && printf '\n' >> "$f"

  # Compact, byte-for-byte the shape Claude's own writer emits: no space after
  # any colon. ~90 bytes, far under the 4096-byte pipe buffer, so this is a
  # single atomic write under O_APPEND. Appending a short fixed record is why
  # this never rewrites the file: a rewrite would need transient 2x disk on a
  # machine cleat already gates at 95% full, and it would have a real window in
  # which the transcript is incomplete.
  printf '{"type":"custom-title","customTitle":"%s","sessionId":"%s"}\n' "$title" "$uuid" >> "$f" || return 1

  # Sidecar, written temp-then-rename in the same directory so a reader never
  # sees a partial file.
  mkdir -p "${sdir}/${uuid}" 2>/dev/null || true
  if [[ -d "${sdir}/${uuid}" ]]; then
    tmp="${sdir}/${uuid}/.custom-title.json.$$"
    if printf '{"customTitle":"%s"}\n' "$title" > "$tmp" 2>/dev/null; then
      mv "$tmp" "${sdir}/${uuid}/custom-title.json" 2>/dev/null || rm -f "$tmp"
    else
      rm -f "$tmp" 2>/dev/null || true
    fi
  fi

  # Put the mtime back. REQUIRED, not tidiness: `claude --continue` and the
  # /resume picker both order by transcript mtime, so an unrestored rename of
  # the second-newest session silently changes which conversation the next
  # `cleat resume` continues. Safe to do here only because the live gate above
  # guarantees nothing else is appending; it would be a bug as a general rule.
  if [[ -n "$stamp" ]]; then
    touch -r "$stamp" "$f" 2>/dev/null || true
    rm -f "$stamp" 2>/dev/null || true
  fi
  return 0
}

# Resolve a user-typed id to exactly one session. A full UUID or an unambiguous
# hex prefix of at least 8 characters.
#
# Row NUMBERS are deliberately not accepted. The list is ordered by mtime, so
# `rm 3` would name a different conversation the next time anything touches the
# directory, and that is precisely the mistake this feature must not make cheap.
# Is this the SHAPE of an id, before any directory is consulted? Checked first
# so a typo reports the typo, rather than being masked by "no sessions yet" in a
# project that has none.
#   2 = not hex/dashes, 3 = shorter than the 8-character minimum
_sessions_id_shape() {
  case "$1" in
    ''|*[!0-9a-f-]*) return 2 ;;
  esac
  [[ ${#1} -ge 8 ]] || return 3
  return 0
}

_sessions_resolve_id() {
  local sdir="$1" want="$2"
  local f base uuid matches=() m rc=0
  _sessions_id_shape "$want" || rc=$?
  [[ $rc -eq 0 ]] || return $rc
  for f in "$sdir"/*.jsonl; do
    [[ -f "$f" ]] || continue
    base="${f##*/}"
    uuid="${base%.jsonl}"
    _sessions_is_uuid "$uuid" || continue
    case "$uuid" in
      "$want"*) matches=("${matches[@]+"${matches[@]}"}" "$uuid") ;;
    esac
  done
  case ${#matches[@]} in
    0) return 1 ;;
    1) printf '%s' "${matches[0]}"; return 0 ;;
    *) for m in "${matches[@]}"; do printf '%s\n' "$m"; done; return 4 ;;
  esac
}

# ── The picker's render engine ─────────────────────────────────────────────
# Rebuilt after the first version blinked. Three things caused that, all
# measured on a real pty rather than guessed:
#
#   1. The frame forked ~115 times. Per ROW it ran a `sed -n Np` to fetch the
#      line, a `date` inside the age formatter, and several command
#      substitutions, so a ten-row frame took 28 ms and the user watched it
#      being painted.
#   2. It emitted `\033[2K` BEFORE each line's replacement text, in its own
#      write(). That blanks the whole line and leaves it blank until the text
#      arrives 2.3 ms later, so there was always exactly one empty row on
#      screen for the whole redraw. That IS the blink.
#   3. It used 22 write() calls per frame, which is what let the erase and its
#      replacement be separated in time at all.
#
# So: every row's age, size, short id and sanitized title are computed ONCE at
# load time into parallel indexed arrays (bash 3.2 has no associative arrays),
# the only per-frame work is truncation and the cursor marker, the whole frame
# is assembled into one string, and it goes out in a single printf. Erasing is
# `\033[K` AFTER the text, which clears only the tail of a line that has already
# been overwritten, so no cell is ever blank. `\033[K` is also the more portable
# of the two: it is what terminfo calls `el` in 42 of 43 installed entries,
# while no terminfo entry emits `\033[2K` for anything.
#
# Frame cost after this: 0 forks, 2 writes, ~0.1 ms.

# Parallel row arrays. Filled by _sessions_load_rows, read by _sessions_frame.
_SESS_N=0
_SESS_AGE=(); _SESS_SIZE=(); _SESS_ID=(); _SESS_TITLE=()

# Which list the picker is showing: the live sessions or the trash. One picker
# rather than two, because the two lists have identical geometry and the only
# things that differ are the counter line, the hint line and what Enter does.
# A second picker would be a second copy of the resize, clamp and containment
# logic, which is the half of this file that has actually had bugs.
_SESS_VIEW="live"
# How many sessions are in the trash, so the live list can advertise it. Shown
# only when it is greater than zero: an empty trash is nothing to offer, and
# the first delete is exactly when the user needs to learn the key.
_SESS_TRASH_N=0
# The temp file holding the trash rows, so the one cleanup site in cmd_sessions
# can remove it however the picker ended.
_SESS_TRASHFILE=""
# What the last action actually changed, so the picker can fold the result into
# its cached rows instead of rescanning. A rescan forks `du`, `stat` and `tail`
# once per session, which on a project with a hundred conversations is a visible
# pause between two deletes. That pause is the thing this pass exists to remove.
_SESS_ACTED=""
_SESS_ACTED_TITLE=""

# Geometry, re-measured once per keypress so the viewport follows a resize.
# _SESS_GEOM_DIRTY exists so a caller that holds a frame can force a re-measure;
# the picker re-measures unconditionally and never consults it.
_SESS_ROWS=24; _SESS_COLS=80; _SESS_PAGE=10; _SESS_GEOM_DIRTY=1; _SESS_NARROW=0
# Cursor position (absolute index) and the index of the first visible row.
# Globals rather than locals because the clamp is shared by the key handler and
# the resize path, and both have to agree.
_SESS_CURSOR=0; _SESS_OFFSET=0
# Lines the picker owns besides the scrolling rows: cmd_sessions prints a blank,
# a title and a path and a blank (4), the frame adds a counter, a blank and the
# hint (3), and one line is left for the shell prompt to land on (1). So the
# viewport may be at most (terminal rows - 8) or the block does not fit and the
# cursor-up can no longer reach the frame's origin.
_SESSIONS_CHROME_LINES=8
# Below this the layout cannot be laid out at all: 34 columns of fixed matter
# plus a title worth reading. cmd_sessions refuses the picker under it rather
# than rendering rows that wrap, because a wrapped row makes the block walk
# down the screen one line per keypress.
_SESSIONS_MIN_COLS=40

# Suppress the terminal's own echo for the duration of a raw key loop. Named
# for what it does rather than for `cleat session`, which needed it first:
# `cleat account` uses the same pair, and a second copy of a termios save and
# restore is the last thing this file needs.
#
# Without this, any key byte that arrives while the loop is NOT inside
# `read -rsn1` is echoed by the tty, so holding an arrow key prints `^[[B`
# into the middle of the frame. The old draw left a 28 ms window per keypress
# for that to happen; the rewritten one leaves microseconds, which made it rare
# rather than impossible. Rare corruption of a screen whose Enter key deletes a
# conversation is not good enough.
#
# The saved mode is the WHOLE termios state from `stty -g`, not a bare
# `stty echo` afterwards, so nothing else the user had set is disturbed. Both
# halves are no-ops without a tty, and the restore is wired to every exit path
# AND to INT/TERM/HUP, because a cleat that exits leaving the terminal unable to
# echo what you type is a worse bug than the one being fixed.
#
# It is also IDEMPOTENT, and that is load-bearing rather than tidy. The picker
# re-arms the terminal once per list screen, and a view switch breaks back to it
# without restoring first (nothing was printed, so there is nothing to restore
# for). A second `stty -g` there would save the ALREADY echo-off state as the
# "original", and the user's terminal would be left unable to echo what they
# type after the picker exited. So the saved state is written once and cleared
# only by the restore, which is what pairs them.
_SESS_STTY=""
_tui_echo_off() {
  _is_tty || { _SESS_STTY=""; return 0; }
  if [[ -z "${_SESS_STTY:-}" ]]; then
    _SESS_STTY="$(stty -g 2>/dev/null || true)"
  fi
  stty -echo 2>/dev/null || true
  return 0
}

_tui_echo_restore() {
  _is_tty || return 0
  if [[ -n "${_SESS_STTY:-}" ]]; then
    stty "$_SESS_STTY" 2>/dev/null || stty echo 2>/dev/null || true
  else
    stty echo 2>/dev/null || true
  fi
  _SESS_STTY=""
  return 0
}

# Is the terminal too narrow to lay a session row out? Reads the RAW width, not
# _term_cols, because that one clamps up to a 40-column floor for the renderer's
# benefit and so can never report a narrower terminal.
_sessions_too_narrow() {
  local c
  c="$(_term_size)"
  c="${c#* }"
  case "$c" in ''|*[!0-9]*) c=80 ;; esac
  [[ "$c" -lt "$_SESSIONS_MIN_COLS" ]]
}

# Load the scan's rows into the arrays, doing every per-row computation once.
# ONE `date` for the whole list, not one per row per frame.
_sessions_load_rows() {
  local f="$1" now mt kb id title
  _SESS_N=0
  _SESS_AGE=(); _SESS_SIZE=(); _SESS_ID=(); _SESS_TITLE=()
  [[ -f "$f" ]] || return 0
  now="$(date +%s 2>/dev/null || echo 0)"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  while IFS="$(printf '\t')" read -r mt kb id title; do
    [[ -n "$id" ]] || continue
    case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
    case "$kb" in ''|*[!0-9]*) kb=0 ;; esac
    if [[ "$mt" -gt 0 && "$now" -gt 0 ]]; then
      _SESS_AGE[$_SESS_N]="$(_age_from_delta $(( now - mt )))"
    else
      _SESS_AGE[$_SESS_N]="unknown"
    fi
    _SESS_SIZE[$_SESS_N]="$(_fork_fmt_kb "$kb")"
    _SESS_ID[$_SESS_N]="${id:0:8}"
    _SESS_TITLE[$_SESS_N]="$(_sessions_safe_str "$title")"
    _SESS_N=$(( _SESS_N + 1 ))
  done < "$f"
  return 0
}

# Re-measure the terminal and size the viewport to it.
#
# The viewport is the smaller of what fits and what there is to show, so three
# sessions in a fifty-row window draw three rows rather than three rows and
# forty-odd blanks. Floored at 1 so the frame always has a cursor row.
_sessions_measure() {
  local total="${1:-0}" avail
  _SESS_ROWS="$(_term_rows)"
  _SESS_COLS="$(_term_cols)"
  case "$total" in ''|*[!0-9]*) total=0 ;; esac
  # An empty list still gets a one-row frame rather than a terminal's worth of
  # blanks: the picker is never opened on one, but the draw is reachable from
  # tests and must stay well formed.
  (( total < 1 )) && total=1
  # The launch gate refuses a too-narrow terminal, but a window narrowed MID
  # picker would otherwise keep drawing rows that wrap, and a wrapped row walks
  # the block. _SESS_NARROW lets the loop notice and bail out cleanly.
  if _sessions_too_narrow; then _SESS_NARROW=1; else _SESS_NARROW=0; fi
  avail=$(( _SESS_ROWS - _SESSIONS_CHROME_LINES ))
  (( avail < 1 )) && avail=1
  if [[ "$total" -lt "$avail" ]]; then
    _SESS_PAGE="$total"
  else
    _SESS_PAGE="$avail"
  fi
  (( _SESS_PAGE < 1 )) && _SESS_PAGE=1
  _SESS_GEOM_DIRTY=0
  return 0
}

# Keep the cursor visible and the offset inside the list. Called after every
# move AND after every re-measure, because a resize changes the page size under
# a cursor that was already placed.
#
# This is a safety control, not cosmetics. Without it a window shrink can leave
# the cursor below the last drawn row: the highlight disappears, the user
# presses Enter on a row they cannot see, and the action screen offers to delete
# a conversation they never selected.
_sessions_clamp() {
  local total="$1"
  # Normalise first. Every branch below is a conditional assignment, so a state
  # that matches none of them would be left exactly as it was found, and an
  # unset or non-numeric value would then reach an arithmetic test as an empty
  # string. Cheap, and it keeps the invariant true from any starting state.
  case "$total" in ''|*[!0-9]*) total=0 ;; esac
  case "${_SESS_CURSOR:-}" in ''|*[!0-9-]*) _SESS_CURSOR=0 ;; esac
  case "${_SESS_OFFSET:-}" in ''|*[!0-9-]*) _SESS_OFFSET=0 ;; esac
  [[ "$total" -gt 0 ]] || { _SESS_CURSOR=0; _SESS_OFFSET=0; return 0; }
  (( _SESS_CURSOR < 0 )) && _SESS_CURSOR=0
  (( _SESS_CURSOR > total - 1 )) && _SESS_CURSOR=$(( total - 1 ))
  (( _SESS_OFFSET > _SESS_CURSOR )) && _SESS_OFFSET=$_SESS_CURSOR
  (( _SESS_OFFSET < _SESS_CURSOR - _SESS_PAGE + 1 )) && _SESS_OFFSET=$(( _SESS_CURSOR - _SESS_PAGE + 1 ))
  (( _SESS_OFFSET > total - _SESS_PAGE )) && _SESS_OFFSET=$(( total - _SESS_PAGE ))
  (( _SESS_OFFSET < 0 )) && _SESS_OFFSET=0
  return 0
}

# Build and emit the whole frame in one write. Emits exactly page + 3 lines:
# the rows, the counter, a blank and the hint. Everything is one string so the
# terminal receives a complete frame rather than a progressive repaint.
#
# printf '%b' rather than '%s' because the colour variables in this file hold
# LITERAL backslash escapes (BOLD='\033[1m'), so something has to interpret
# them. That is also exactly why _sessions_safe_str doubles backslashes: a
# title is model-written text, and without the doubling a title containing the
# four characters \033 would become a real escape sequence here.
_sessions_frame() {
  local cursor="$1" offset="$2" page="$3" cols="$4" total="$5"
  local buf="" i n room t line shown meta count
  # Normalise the caller's numbers rather than trusting them. A negative offset
  # reaches an array subscript, which aborts the shell on bash 3.2 and silently
  # renders the wrong rows on bash 5.
  case "$cursor" in ''|*[!0-9-]*) cursor=0 ;; esac
  case "$offset" in ''|*[!0-9-]*) offset=0 ;; esac
  case "$page"   in ''|*[!0-9]*)  page=1 ;; esac
  case "$total"  in ''|*[!0-9]*)  total=0 ;; esac
  (( cursor < 0 )) && cursor=0
  (( offset < 0 )) && offset=0
  (( page < 1 ))   && page=1
  room=$(( cols - 34 ))
  (( room < 1 )) && room=1
  i=0
  while [[ $i -lt $page ]]; do
    n=$(( offset + i ))
    if [[ $n -lt $total ]]; then
      t="${_SESS_TITLE[$n]}"
      # A character is not always a column: CJK paints two. Under a UTF-8
      # locale ${#t} counts characters and would under-budget; under LC_ALL=C
      # it counts bytes and over-budgets, which is already safe. Halve only in
      # the case that can under-count.
      local rm=$room
      case "$t" in
        *[!\ -~]*) if _has_unicode; then rm=$(( room / 2 )); (( rm < 1 )) && rm=1; fi ;;
      esac
      [[ ${#t} -gt $rm ]] && t="${t:0:$(( rm - 1 ))}…"
      # printf -v, not $(printf ...): a command substitution forks, and one fork
      # per row is exactly what this rewrite existed to remove. printf -v into a
      # PLAIN variable is bash 3.2 safe; printf -v into an ARRAY ELEMENT is
      # bash 4.1+ and is the trap to avoid here.
      printf -v meta '%-9.9s %9.9s' "${_SESS_AGE[$n]}" "${_SESS_SIZE[$n]}"
      if [[ $n -eq $cursor ]]; then
        line="  ${CYAN}▸${RESET} ${BOLD}${meta}${RESET} ${DIM}${_SESS_ID[$n]}${RESET}  ${BOLD}${t}${RESET}"
      else
        line="    ${meta} ${DIM}${_SESS_ID[$n]}${RESET}  ${t}"
      fi
      buf="${buf}${line}\033[K\n"
    else
      buf="${buf}\033[K\n"
    fi
    i=$(( i + 1 ))
  done
  # Counter and hint, both view-aware. Built with arithmetic expansion and
  # plain assignment only: a $(helper) here would be one fork per frame, which
  # is exactly what the single-write rewrite removed.
  shown=$(( offset + page ))
  (( shown > total )) && shown=$total
  if [[ "$_SESS_VIEW" == "trash" ]]; then
    if [[ "$total" -le 0 ]]; then
      count="The trash is empty"
    elif [[ "$total" -gt "$page" ]]; then
      count="Trash: $(( offset + 1 ))-${shown} of ${total}, kept ${_SESSIONS_TRASH_DAYS} days"
    elif [[ "$total" -eq 1 ]]; then
      count="Trash: 1 item, kept ${_SESSIONS_TRASH_DAYS} days"
    else
      count="Trash: ${total} items, kept ${_SESSIONS_TRASH_DAYS} days"
    fi
  else
    if [[ "$total" -le 0 ]]; then
      count="No sessions"
    elif [[ "$total" -gt "$page" ]]; then
      count="$(( offset + 1 ))-${shown} of ${total}"
    elif [[ "$total" -eq 1 ]]; then
      count="1 session"
    else
      count="${total} sessions"
    fi
    # The only place the trash is advertised. On the counter line and not the
    # hint line because the hint is already 40 columns wide, which is the
    # picker's own minimum: one more word there and every row of the narrowest
    # supported terminal wraps.
    if [[ "${_SESS_TRASH_N:-0}" -gt 0 ]]; then
      count="${count}    → trash (${_SESS_TRASH_N})"
    fi
  fi
  buf="${buf}    ${DIM}${count}${RESET}\033[K\n"
  buf="${buf}\033[K\n"
  if [[ "$_SESS_VIEW" == "trash" ]]; then
    buf="${buf}  ${DIM}↑/↓ move  ⏎ restore  ← back  q close${RESET}\033[K\n"
  else
    buf="${buf}  ${DIM}↑/↓ move  ⏎ rename or delete  q close${RESET}\033[K\n"
  fi
  printf '%b' "$buf"
  return 0
}

# Load, size and draw in one call, for a caller that holds only the rowfile.
# The picker uses the pieces directly so it can load once and re-measure only
# when the window actually changes.
_sessions_picker_draw() {
  local cursor="${1:-0}" offset="${2:-0}" rowfile="${3:-}"
  _sessions_load_rows "$rowfile"
  [[ "$_SESS_GEOM_DIRTY" == "0" ]] || _sessions_measure "$_SESS_N"
  _sessions_frame "$cursor" "$offset" "$_SESS_PAGE" "$_SESS_COLS" "$_SESS_N"
}

# ── Keeping the cached rows honest without rescanning ──────────────────────
#
# The picker reads its rows from a file written once by _sessions_scan_sorted.
# Staying in the tool after an action means that file is now stale, and the
# obvious fix (rescan) is the wrong one: the scan forks `du`, `stat` and `tail`
# per session, so on a project with a hundred conversations it is a visible
# pause after every single delete, in a screen whose whole purpose is deleting
# several in a row.
#
# So fold the change in instead. This is safe precisely because the CLI is the
# thing that made the change and knows exactly what it was: a delete removes
# that row, a rename replaces its title with the text that was just written and
# leaves the mtime alone (_sessions_rename_write restores it), so the sort order
# cannot move either.

# Drop or retitle the row for one session, according to _SESS_ACTED.
_sessions_row_apply() {
  local rowfile="$1" uuid="$2" tmp rc=0
  [[ -n "$uuid" && -f "$rowfile" ]] || return 0
  case "${_SESS_ACTED:-}" in
    delete|rename) : ;;
    *) return 0 ;;
  esac
  tmp="${rowfile}.new"
  if [[ "$_SESS_ACTED" == "delete" ]]; then
    awk -F'\t' -v u="$uuid" '$3 != u' "$rowfile" > "$tmp" 2>/dev/null || rc=1
  else
    # The title is safe to hand awk -v because _sessions_title_ok already
    # refused anything that is not printable ASCII, which rules out the tab
    # that would split the field and the backslash that awk would re-escape.
    awk -F'\t' -v OFS='\t' -v u="$uuid" -v t="$_SESS_ACTED_TITLE" \
      '$3 == u { $4 = t } { print }' "$rowfile" > "$tmp" 2>/dev/null || rc=1
  fi
  if [[ $rc -ne 0 ]]; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$rowfile" 2>/dev/null || { rm -f "$tmp"; return 1; }
  _SESS_ACTED=""
  _SESS_ACTED_TITLE=""
  return 0
}

# Put a restored session back into the live rows, in its sorted position. One
# session is measured here, not the whole list, which is the point.
_sessions_row_insert() {
  local rowfile="$1" sdir="$2" uuid="$3" mt kb title tmp
  [[ -n "$uuid" && -n "$rowfile" ]] || return 1
  [[ -f "${sdir}/${uuid}.jsonl" ]] || return 1
  mt="$(_path_mtime "${sdir}/${uuid}.jsonl")"
  case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
  kb="$(_sessions_size_kb "$sdir" "$uuid")"
  title="$(_sessions_title_for "$sdir" "$uuid")"
  tmp="${rowfile}.new"
  {
    cat "$rowfile" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\n' "$mt" "$kb" "$uuid" "$title"
  } | sort -t "$(printf '\t')" -k1,1rn > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$rowfile" 2>/dev/null || { rm -f "$tmp"; return 1; }
  return 0
}

# The four lines above the frame. Extracted because the picker reprints them
# after every action that printed a receipt, and the viewport budget
# (_SESSIONS_CHROME_LINES) counts exactly four: print a different number here
# and the frame's last line falls off the bottom of the terminal.
_sessions_header() {
  local sdir="$1" project="$2" box="$3"
  # The path is easily longer than the terminal and a wrapped header silently
  # costs a row, which is the same failure as an over-wide list row. Truncated
  # from the LEFT, because the distinctive part of a path is its tail.
  local _hdr_path="$sdir" _hdr_room
  _hdr_room=$(( $(_term_cols) - 4 ))
  (( _hdr_room < 12 )) && _hdr_room=12
  if [[ ${#_hdr_path} -gt $_hdr_room ]]; then
    _hdr_path="…${_hdr_path:$(( ${#_hdr_path} - _hdr_room + 1 ))}"
  fi
  echo ""
  echo -e "  ${BOLD}Claude sessions${RESET} ${DIM}($(basename "$project")$( [[ "$box" != "main" ]] && printf ' / %s' "$box" ))${RESET}"
  echo -e "  ${DIM}${_hdr_path}${RESET}"
  echo ""
  return 0
}

# The four-row action screen. A separate screen rather than a hotkey inside the
# list, for two reasons. The list's key reader (_read_keypress) collapses every
# printable character except space and q to one token and discards the byte, so
# `d`/`r` hotkeys would mean editing a reader that two mutation entries guard
# and that broke the pickers once already. And an irreversible delete SHOULD
# cost two deliberate returns: no other picker in this file performs one from
# inside a raw key loop.
_SESSIONS_ACTION_LINES=4
# The three lines this screen prints above its menu: a blank, the title and the
# id. The back-out path walks back over them, so the number has to be here
# rather than spelled inline.
_SESSIONS_ACTION_HEAD=3

# Leave the action screen having printed nothing, erasing it on the way out.
#
# The key loop parks the cursor on the first line of _sessions_action_draw, so
# _SESSIONS_ACTION_HEAD lines up is the first line this screen printed, which
# is also the list frame's origin (the picker erases its frame before handing
# over). Erasing from there down and returning leaves the terminal exactly as
# the picker left it, so the list redraws in place with nothing scrolled and no
# "Cancelled" line for an action that never started.
_sessions_action_backout() {
  _cursor_show
  _tui_echo_restore
  trap - INT TERM HUP
  printf '\033[%dA' "$_SESSIONS_ACTION_HEAD"
  printf '\033[J'
  return 0
}

_sessions_action_draw() {
  local cursor="${1:-0}" cols="${2:-80}"
  local i=0 room label desc line
  local labels="Rename Delete Cancel"
  set -- $labels
  # Width-managed for the same reason the list rows are. The widest row here is
  # 57 columns, so on anything narrower every row wrapped into two physical
  # lines while the reposition moved up four LOGICAL ones, and the menu walked
  # down the screen exactly like an over-wide list row does. Found by audit, not
  # in the wild: the list itself renders from 40 columns up, so a reader on a
  # narrow split pane got a good list and then a shredded menu behind Enter.
  room=$(( cols - 14 ))
  (( room < 8 )) && room=8
  printf '\033[K\n'
  while [[ $i -lt 3 ]]; do
    case $i in
      0) label="Rename"; desc="Give this session a name you will recognise" ;;
      1) label="Delete"; desc="Move it to the trash (restorable for ${_SESSIONS_TRASH_DAYS} days)" ;;
      *) label="Cancel"; desc="Leave it alone" ;;
    esac
    [[ ${#desc} -gt $room ]] && desc="${desc:0:$(( room - 1 ))}…"
    if [[ $i -eq $cursor ]]; then
      line="  ${CYAN}▸${RESET} ${BOLD}${label}${RESET}  ${DIM}${desc}${RESET}"
    else
      line="    ${label}  ${DIM}${desc}${RESET}"
    fi
    printf '%b\033[K\n' "$line"
    i=$(( i + 1 ))
  done
  return 0
}

# ── The two actions ────────────────────────────────────────────────────────
# Both are reached from the picker AND from the command line, so both live here
# rather than inside a TUI function: the gates must be identical either way, and
# a gate that only exists on the interactive path is not a gate.

_sessions_do_rename() {
  local sdir="$1" uuid="$2" box="$3" cname="$4" title="$5"
  _SESS_ACTED=""
  _SESS_ACTED_TITLE=""
  _sessions_live_gate "$cname" "$box" || return 1
  # The same containment the delete path runs, and for the same reason. A
  # rename APPENDS to the transcript, and `[[ -f ]]` follows a symlink, so
  # without this a `<uuid>.jsonl` symlink planted from inside the box (that
  # directory is mounted read-write into the container by design) would make
  # the host append a record to whatever it points at, and then restore the
  # victim's mtime so nothing looked disturbed. A write needs the same guard a
  # delete does.
  if ! _sessions_path_under_key "${sdir}/${uuid}.jsonl" "$sdir"; then
    error "Refusing to rename ${BOLD}${uuid:0:8}${RESET}: it does not resolve to a file in this project's session directory."
    return 1
  fi
  if [[ -z "$title" ]]; then
    if ! _is_interactive; then
      error "No title given."
      echo -e "    ${DIM}Re-run with ${BOLD}--title <text>${RESET}${DIM} to rename non-interactively.${RESET}"
      return 1
    fi
    local cur
    cur="$(_sessions_title_for "$sdir" "$uuid")"
    echo -e "  ${DIM}Current: $(_sessions_safe_title "$cur")${RESET}"
    # Plain `read -r`, matching every other prompt in this CLI. `read -e -i` is
    # the obvious way to prefill the old name and it is bash 4.0+, so it would
    # pass every check here and fail on the maintainer's own macOS bash 3.2.
    echo -en "  New name: "
    read -r title || title=""
  fi
  if ! _sessions_title_ok "$title"; then
    error "Not a usable title."
    echo -e "    ${DIM}1-64 characters, printable ASCII, no quotes or backslashes, no leading or trailing space.${RESET}"
    echo -e "    ${DIM}For anything else (emoji, accents) use ${BOLD}/rename${RESET}${DIM} inside the session.${RESET}"
    return 1
  fi
  if _sessions_rename_write "$sdir" "$uuid" "$title"; then
    _SESS_ACTED="rename"
    _SESS_ACTED_TITLE="$title"
    success "Renamed ${DIM}${uuid:0:8}${RESET} to ${BOLD}${title}${RESET}"
    return 0
  fi
  error "Could not write the new title."
  return 1
}

_sessions_do_delete() {
  local sdir="$1" uuid="$2" project="$3" box="$4" cname="$5" assume_yes="${6:-0}"
  local f="${sdir}/${uuid}.jsonl" kb size title mt_before mt_now ans

  _SESS_ACTED=""
  _SESS_ACTED_TITLE=""
  _sessions_live_gate "$cname" "$box" || return 1

  # Containment before anything is shown, so a target that could never be
  # deleted is never described as if it could.
  if ! _sessions_path_under_key "$f" "$sdir"; then
    error "Refusing to delete ${BOLD}${uuid:0:8}${RESET}: it does not resolve to a file in this project's session directory."
    return 1
  fi

  kb="$(_sessions_size_kb "$sdir" "$uuid")"
  size="$(_fork_fmt_kb "$kb")"
  title="$(_sessions_title_for "$sdir" "$uuid")"
  mt_before="$(_path_mtime "$f")"

  warn "This removes session ${BOLD}${uuid:0:8}${RESET} ${DIM}(${size} apparent)${RESET}"
  echo -e "    ${DIM}Title: $(_sessions_safe_title "$title")${RESET}"
  echo -e "    ${DIM}The conversation, its subagent transcripts and its tool results all go.${RESET}"
  echo -e "    ${DIM}It moves to the trash, recoverable for ${_SESSIONS_TRASH_DAYS} days with${RESET}"
  echo -e "    ${DIM}${BOLD}cleat session restore ${uuid:0:8}${RESET}"

  if [[ "$assume_yes" != "1" ]]; then
    # _is_interactive AND a default-No prompt. The pairing is the cmd_uninstall
    # precedent and it is load-bearing: _ask_yn on its own is pipe-satisfiable,
    # so `yes | cleat session rm ...` would answer it.
    if ! _is_interactive; then
      echo ""
      echo -e "    ${DIM}Nothing was deleted. Re-run with ${BOLD}--yes${RESET}${DIM} to do this non-interactively.${RESET}"
      return 0
    fi
    _ask_yn ans "Delete it? [y/N] "
    case "$ans" in
      y|Y|yes|YES) : ;;
      *) info "Kept."; return 0 ;;
    esac
  fi

  # TOCTOU: the user read a list, then thought about it. If the transcript moved
  # in between, something is writing it and the size and title just shown are
  # stale.
  mt_now="$(_path_mtime "$f")"
  if [[ "$mt_now" != "$mt_before" ]]; then
    error "Session ${BOLD}${uuid:0:8}${RESET} changed while you were deciding."
    echo -e "    ${DIM}Something is still writing it. Run ${BOLD}cleat session${RESET}${DIM} again.${RESET}"
    return 1
  fi

  local _trc=0
  _sessions_trash "$sdir" "$uuid" "$project" "$cname" || _trc=$?
  if [[ $_trc -eq 2 ]]; then
    error "Refusing to delete: the trash directory is not a plain directory in the session dir."
    echo -e "    ${DIM}Nothing was moved. Check ${sdir}/.cleat-trash${RESET}"
    return 1
  fi
  if [[ $_trc -eq 3 ]]; then
    error "Session ${BOLD}${uuid:0:8}${RESET} is already gone."
    echo -e "    ${DIM}Another window deleted it. Nothing was moved and nothing was trashed.${RESET}"
    return 1
  fi
  # Anything short of the refusal above moved at least the transcript, so the
  # list the picker is holding is now stale either way.
  _SESS_ACTED="delete"
  if [[ $_trc -eq 0 ]]; then
    success "Moved ${DIM}${uuid:0:8}${RESET} to the trash ${DIM}(${size} apparent)${RESET}"
  else
    warn "Moved ${DIM}${uuid:0:8}${RESET} to the trash, with items left in place ${DIM}(listed above)${RESET}"
  fi
  # Say it, because `df` will not move until the trash is swept and a user who
  # deletes a gigabyte and sees no free space assumes the command lied.
  echo -e "    ${DIM}Disk space comes back when the trash is swept, after ${_SESSIONS_TRASH_DAYS} days.${RESET}"
  echo -e "    ${DIM}Undo: ${BOLD}cleat session restore ${uuid:0:8}${RESET}"
  return 0
}

# Restore from the picker's trash view.
#
# No _sessions_live_gate and no confirm, on purpose. A restore puts files back
# where Claude Code expects them and is undone by deleting again, so it is the
# one action here that costs nothing to get wrong. `cleat session restore <id>`
# takes the same path and has never gated either.
_sessions_do_restore() {
  local sdir="$1" uuid="$2"
  _SESS_ACTED=""
  _SESS_ACTED_TITLE=""
  if _sessions_restore "$sdir" "$uuid"; then
    _SESS_ACTED="restore"
    success "Restored ${DIM}${uuid:0:8}${RESET}"
    return 0
  fi
  error "Could not restore ${BOLD}${uuid:0:8}${RESET}."
  # _sessions_restore refuses to overwrite anything that reappeared under the
  # same name, so "it is already back" is the likeliest reason and the user can
  # check it themselves.
  echo -e "    ${DIM}Nothing was overwritten. Trash: ${sdir}/.cleat-trash${RESET}"
  return 1
}

# ── The picker ─────────────────────────────────────────────────────────────

# Screen 2. Entered only after screen 1 has torn its frame down, matching the
# kit picker's hand-off to _kit_models_tui. Like both existing second screens it
# ends the verb rather than returning to the list.
_sessions_action_tui() {
  local sdir="$1" uuid="$2" project="$3" box="$4" cname="$5"
  local cursor=0 key title size kb
  kb="$(_sessions_size_kb "$sdir" "$uuid")"
  size="$(_fork_fmt_kb "$kb")"
  title="$(_sessions_title_for "$sdir" "$uuid")"
  echo ""
  echo -e "  ${BOLD}$(_sessions_safe_title "$title")${RESET}"
  echo -e "  ${DIM}${uuid}  ${size} apparent${RESET}"

  local block=$(( _SESSIONS_ACTION_LINES ))
  local cols
  cols="$(_term_cols)"
  _tui_echo_off
  trap '_tui_echo_restore; _cursor_show; trap - INT TERM HUP; exit 130' INT TERM HUP
  _cursor_hide
  _sessions_action_draw "$cursor" "$cols"
  echo ""
  echo -e "  ${DIM}↑/↓ move  ⏎ choose  q back${RESET}"
  printf '\033[%dA' "$(( block + 2 ))"

  while true; do
    key="$(_read_keypress)"
    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=$(( cursor - 1 )) ;;
      DOWN) [[ $cursor -lt 2 ]] && cursor=$(( cursor + 1 )) ;;
      ENTER)
        if [[ $cursor -eq 2 ]]; then
          _sessions_action_backout
          return 1
        fi
        _cursor_show
        _tui_echo_restore
        trap - INT TERM HUP
        printf '\033[%dB' "$(( block + 2 ))"
        printf '\033[2K'
        echo ""
        # `|| true` on both: a refused rename or a poisoned trash returns 1, and
        # under the binary's `set -e` that would end the whole verb right after
        # printing the reason. The caller has to get control back to redraw the
        # list, which is the entire point of this pass.
        case "$cursor" in
          0) _sessions_do_rename "$sdir" "$uuid" "$box" "$cname" "" || true ;;
          *) _sessions_do_delete "$sdir" "$uuid" "$project" "$box" "$cname" 0 || true ;;
        esac
        return 0 ;;
      QUIT|ESC)
        _sessions_action_backout
        return 1 ;;
    esac
    _sessions_action_draw "$cursor" "$cols"
    printf '\033[%dA' "$block"
  done
}

_sessions_picker_tui() {
  local sdir="$1" project="$2" box="$3" cname="$4" rowfile="$5" total="$6"
  local key line uuid block prev_block cur
  local view="live" trash_stale=1 acted=0
  local live_cursor=0 live_offset=0 trash_cursor=0 trash_offset=0

  _SESS_CURSOR=0
  _SESS_OFFSET=0
  _SESS_GEOM_DIRTY=1
  _SESS_TRASHFILE=""

  # Two loops. The OUTER one is one list screen: it materialises the rows for
  # the current view, arms the terminal, draws the frame and hands over to the
  # key loop. Every action and every view switch breaks back to it, which is
  # what keeps the user inside the tool instead of ending the verb on the first
  # rename. The INNER one is the key loop, and it owns the frame it drew.
  while true; do
    if [[ "$view" == "trash" ]]; then
      if [[ -z "$_SESS_TRASHFILE" ]]; then
        _SESS_TRASHFILE="$(mktemp "${TMPDIR:-/tmp}/cleat-trash.XXXXXX" 2>/dev/null)" || _SESS_TRASHFILE=""
      fi
      # No temp file means no trash list. Say so and stay on the live list
      # rather than drawing an empty trash, which would read as "nothing was
      # deleted" when the truth is "this could not be read".
      if [[ -z "$_SESS_TRASHFILE" ]]; then
        warn "Could not create a temporary file for the trash list."
        view="live"
        continue
      fi
      if [[ "$trash_stale" == "1" ]]; then
        _sessions_trash_scan_sorted "$sdir" > "$_SESS_TRASHFILE" 2>/dev/null || true
        trash_stale=0
      fi
      cur="$_SESS_TRASHFILE"
    else
      cur="$rowfile"
    fi
    _SESS_VIEW="$view"
    _SESS_TRASH_N="$(_sessions_trash_count "$sdir")"

    # Echo off BEFORE the row load, not after: loading runs a `du` over every
    # session's sidecar and is the one slow moment in the picker, so it is
    # exactly when an impatient keypress would be echoed into the output.
    #
    # The restore trap goes up in the SAME breath, before anything can fail. The
    # window between them is not theoretical: the load shells out to `du` and
    # `date`, and under `set -e` a failing pipeline in there would exit the CLI
    # with the terminal still unable to echo. EXIT covers that and the signals
    # cover a Ctrl-C during the slow part, which is exactly when an impatient
    # user presses it.
    _tui_echo_off
    trap '_tui_echo_restore; _cursor_show' EXIT
    trap '_tui_echo_restore; _cursor_show; trap - INT TERM HUP EXIT; exit 130' INT TERM HUP

    _sessions_load_rows "$cur"
    total="$_SESS_N"

    # An empty LIVE list means the last session was just deleted. Show the trash
    # instead of dropping out of the tool: the trash is the only place the thing
    # they just deleted can be got back from, and being thrown to a shell prompt
    # with an "undo" command to retype is the unfriendliness this pass is about.
    if [[ "$view" == "live" && "$total" -le 0 ]]; then
      _tui_echo_restore
      _cursor_show
      trap - INT TERM HUP EXIT
      if [[ "${_SESS_TRASH_N:-0}" -gt 0 ]]; then
        info "No sessions left. Showing the trash."
        view="trash"
        continue
      fi
      info "No sessions left in this project."
      return 0
    fi

    # Resize is handled by re-measuring once per keypress, and deliberately NOT
    # by a SIGWINCH trap.
    #
    # A trap looks like the right answer and buys nothing. SIGWINCH does not
    # interrupt a blocked `read` (bash retries on EINTR, and the command
    # substitution subshell does not run the inherited handler anyway), so bash
    # defers the trap until the reader returns, which is exactly the moment this
    # loop re-measures regardless. It would add signal-disposition behaviour that
    # differs across platforms to the critical path in exchange for nothing.
    #
    # It is also load-bearing that nothing here tries to be cleverer by giving
    # the reader a timeout. `_read_keypress` prints ENTER for an empty read, and
    # ENTER opens the rename/delete screen, so a timeout would make an idle
    # terminal offer to delete a conversation on its own. (`read -t` is bash 4
    # anyway.)
    #
    # The honest behaviour, stated in the docs: resize the window, press any key,
    # the list reflows. One `stty size` per keypress is about 0.4 ms.
    _sessions_measure "$total"
    # The same refusal the key loop makes, checked here too: the window can be
    # narrowed while a rename prompt is waiting for a line of input, and the
    # first frame after that would otherwise be a wrapped one. A wrapped row
    # walks the block down the screen and there is no recovering the origin.
    if [[ "$_SESS_NARROW" == "1" ]]; then
      _tui_echo_restore
      _cursor_show
      trap - INT TERM HUP EXIT
      echo ""
      info "Window too narrow for the session list."
      echo -e "    ${DIM}Widen it and run ${BOLD}cleat session${RESET}${DIM} again.${RESET}"
      return 0
    fi
    _sessions_clamp "$total"
    block=$(( _SESS_PAGE + 3 ))
    prev_block=$block

    _cursor_hide
    _sessions_frame "$_SESS_CURSOR" "$_SESS_OFFSET" "$_SESS_PAGE" "$_SESS_COLS" "$total"
    printf '\033[%dA' "$block"

    while true; do
      key="$(_read_keypress)"

      _sessions_measure "$total"
      # Narrowed below the layout's minimum mid-session: leave the picker rather
      # than draw rows that wrap, because a wrapped row walks the block down the
      # screen one row per keypress and there is no recovering the origin.
      if [[ "$_SESS_NARROW" == "1" ]]; then
        _cursor_show
        _tui_echo_restore
        trap - INT TERM HUP EXIT
        printf '\033[%dB' "$block"
        printf '\033[2K'
        echo ""
        info "Window too narrow for the session list."
        echo -e "    ${DIM}Widen it and run ${BOLD}cleat session${RESET}${DIM} again.${RESET}"
        return 0
      fi

      case "$key" in
        UP)   _SESS_CURSOR=$(( _SESS_CURSOR - 1 )) ;;
        DOWN) _SESS_CURSOR=$(( _SESS_CURSOR + 1 )) ;;
        RIGHT)
          # The cursor is parked on the frame's ORIGIN at the top of every pass
          # of this loop, so erasing from here down and breaking redraws the
          # other view in exactly this space. Nothing scrolls, the header above
          # is untouched and no second copy of the list is left behind. Only
          # relative movement is used, which stays correct even if the terminal
          # scrolled under us.
          if [[ "$view" == "live" ]]; then
            live_cursor=$_SESS_CURSOR
            live_offset=$_SESS_OFFSET
            view="trash"
            _SESS_CURSOR=$trash_cursor
            _SESS_OFFSET=$trash_offset
            printf '\033[J'
            break
          fi ;;
        LEFT)
          if [[ "$view" == "trash" ]]; then
            trash_cursor=$_SESS_CURSOR
            trash_offset=$_SESS_OFFSET
            view="live"
            _SESS_CURSOR=$live_cursor
            _SESS_OFFSET=$live_offset
            printf '\033[J'
            break
          fi ;;
        ENTER)
          line="$(sed -n "$(( _SESS_CURSOR + 1 ))p" "$cur" 2>/dev/null || true)"
          # Third tab-separated field. A cursor that names no row must never
          # reach an action with an empty id. Redraw and stay put rather than
          # ending the verb: pressing Enter on an empty trash is an ordinary
          # thing to do and must not close anything.
          uuid="$(printf '%s' "$line" | awk -F'\t' '{print $3}')"
          if ! _sessions_is_uuid "$uuid"; then
            _sessions_frame "$_SESS_CURSOR" "$_SESS_OFFSET" "$_SESS_PAGE" "$_SESS_COLS" "$total"
            printf '\033[%dA' "$block"
            continue
          fi
          _cursor_show
          _tui_echo_restore
          trap - INT TERM HUP EXIT
          # Hand the screen over by erasing the frame from its origin down. The
          # action screen then draws in the space the list occupied, which is
          # what lets a backed-out menu put the list straight back.
          printf '\033[J'
          if [[ "$view" == "trash" ]]; then
            echo ""
            _sessions_do_restore "$sdir" "$uuid" || true
            acted=1
            trash_stale=1
            if [[ "${_SESS_ACTED:-}" == "restore" ]]; then
              _sessions_row_insert "$rowfile" "$sdir" "$uuid" || true
            fi
            _SESS_ACTED=""
            _sessions_header "$sdir" "$project" "$box"
          else
            # 0 means it ran something and printed a receipt, so the list
            # belongs UNDER that receipt. 1 means the user backed out without
            # printing anything, and the menu has already erased itself and left
            # the cursor on the frame's origin, so the redraw lands in place.
            if _sessions_action_tui "$sdir" "$uuid" "$project" "$box" "$cname"; then
              acted=1
              [[ "${_SESS_ACTED:-}" == "delete" ]] && trash_stale=1
              _sessions_row_apply "$cur" "$uuid" || true
              _sessions_header "$sdir" "$project" "$box"
            fi
          fi
          break ;;
        QUIT|ESC)
          _cursor_show
          _tui_echo_restore
          trap - INT TERM HUP EXIT
          printf '\033[%dB' "$block"
          printf '\033[2K'
          echo ""
          # "Cancelled" is only true if nothing happened. After a rename or a
          # delete the receipts have already said what this run did.
          if [[ "$acted" != "1" ]]; then
            info "Cancelled."
          fi
          return 0 ;;
      esac

      # Clamp AFTER the move and after any re-measure, so a shrunk window can
      # never leave the cursor on a row that is no longer drawn.
      _sessions_clamp "$total"
      block=$(( _SESS_PAGE + 3 ))

      _sessions_frame "$_SESS_CURSOR" "$_SESS_OFFSET" "$_SESS_PAGE" "$_SESS_COLS" "$total"
      # A frame that shrank leaves the taller previous frame's tail on screen.
      # The cursor is sitting exactly on that leftover, so erase from here down.
      # Only on an actual shrink, because erase-to-end-of-screen is the one
      # sequence here that CAN show a blank region for a moment.
      if [[ "$block" -lt "$prev_block" ]]; then
        printf '\033[J'
      fi
      prev_block=$block
      printf '\033[%dA' "$block"
    done
  done
}

# Non-TTY listing. Not a REPL: the picker's only action is to open the action
# screen, and the confirm contract that matters non-interactively lives on
# `rm` and `rename` themselves. `cleat fork`'s bare list is the same precedent,
# the read-only listing that doubles as the dry run for its destructive sibling.
#
# This is also the fallback when the terminal is too narrow to lay the picker
# out. A list you can read beats a picker whose rows wrap, because a wrapped
# row makes the block walk down the screen one line per keypress.
_sessions_picker_text() {
  local rowfile="$1" total="${2:-0}" sdir="${3:-}"
  local i=0 tn=0
  _sessions_load_rows "$rowfile"
  total="$_SESS_N"
  while [[ $i -lt $_SESS_N ]]; do
    echo -e "    $(printf '%-9.9s %9.9s' "${_SESS_AGE[$i]}" "${_SESS_SIZE[$i]}") ${DIM}${_SESS_ID[$i]}${RESET}  ${_SESS_TITLE[$i]}"
    i=$(( i + 1 ))
  done
  echo ""
  if [[ "$total" -eq 1 ]]; then
    echo -e "  ${DIM}1 session. Act on it with ${BOLD}cleat session rename <id>${RESET}${DIM} or ${BOLD}cleat session rm <id>${RESET}${DIM}.${RESET}"
  else
    echo -e "  ${DIM}${total} sessions. Act on one with ${BOLD}cleat session rename <id>${RESET}${DIM} or ${BOLD}cleat session rm <id>${RESET}${DIM}.${RESET}"
  fi
  # The picker advertises the trash on its counter line. Without this the
  # non-TTY path is the one place a deleted session could be invisible.
  if [[ -n "$sdir" ]]; then
    tn="$(_sessions_trash_count "$sdir")"
    case "$tn" in ''|*[!0-9]*) tn=0 ;; esac
    if [[ "$tn" -gt 0 ]]; then
      echo -e "  ${DIM}${tn} in the trash. See them with ${BOLD}cleat session trash${RESET}${DIM}.${RESET}"
    fi
  fi
  return 0
}

# ── Named Claude auth contexts (`cleat account`) ────────────────────────────
#
# One Max account has a five-hour window. A maintainer with two of them should
# not have to re-run /login in a browser every time one runs out. So a box can
# be PINNED to a named account, and switching is one command.
#
# The whole feature rests on one Claude Code env var:
#
#   CLAUDE_SECURESTORAGE_CONFIG_DIR   relocates the CREDENTIAL STORE and nothing
#                                     else. Verified against `claude auth status
#                                     --json` on 2.1.267: pointed at an empty
#                                     directory it reports loggedIn:false while
#                                     projectsDirectory stays ~/.claude/projects.
#
# That is what makes this auth-scope-only, which is the requirement: the same
# conversations, the same project history and the same settings on both
# accounts, so you can hit a limit mid-conversation and carry on.
# CLAUDE_CONFIG_DIR is the wrong lever and is rejected in concept/44: it moves
# the conversations too.
#
# The var is UNDOCUMENTED (no --help text, no release-note string, only code and
# an internal allowlist), so nothing here trusts it blindly. The `default`
# sentinel sets no variable at all and is byte-identical to the behaviour before
# this feature existed, which is what every box gets until the verb is run.
CLEAT_ACCOUNTS_DIR="$CLEAT_CONFIG_DIR/accounts"
CLEAT_BOX_ACCOUNTS_DIR="$CLEAT_CONFIG_DIR/box-accounts"
# "Whatever was there before": the shared ~/.claude store, no env var, no mount
# use. A real directory may also be named `default`, which is fine: it is only a
# sentinel for the PIN.
_ACCOUNT_DEFAULT="default"
# Where the staged credential is mounted inside the box. A fresh path on
# purpose, NOT nested inside the ~/.claude bind, so the VirtioFS nested-mount
# rule (a nested target must already exist inside the parent bind source) does
# not apply to it.
_ACCOUNT_BOX_DIR="/home/coder/.cleat-auth"
_ACCOUNTS_TRASH_DAYS=30
# Don't poll the usage endpoint more than once a minute per account.
_ACCOUNT_USAGE_THROTTLE=60

# Box rules, not session-title rules, and the difference matters. A title may be
# any printable ASCII; an account name becomes a DIRECTORY on a case-insensitive
# APFS host and a path inside a case-sensitive container, so `Work` and `work`
# would be one file on the Mac and two in the box. A dot makes a `.json` suffix
# ambiguous and a leading dash is argv injection.
#
# The subcommand words are refused as names too. They are reserved before the
# switch form is parsed, so an account called `rm` could be created and then
# never selected again.
_validate_account_name() {
  local n="$1"
  local _acct_re='^[a-z0-9][a-z0-9_-]{0,30}$'
  [[ "$n" =~ $_acct_re ]] || return 1
  case "$n" in
    list|rename|rm|delete|restore|trash|held|adopt|off|help) return 1 ;;
    # The sentinel. A real directory of this name could be pinned and then
    # never staged, because every staging path treats the name as "no account".
    "$_ACCOUNT_DEFAULT") return 1 ;;
  esac
  return 0
}

_account_dir()       { printf '%s' "$CLEAT_ACCOUNTS_DIR/$1"; }
_account_cred_path() { printf '%s' "$CLEAT_ACCOUNTS_DIR/$1/.credentials.json"; }
# Named `meta`, not `meta.json`, because it is NOT json: see _account_meta_set.
_account_meta_path() { printf '%s' "$CLEAT_ACCOUNTS_DIR/$1/meta"; }
_account_exists()    { [[ -d "$CLEAT_ACCOUNTS_DIR/$1" && ! -L "$CLEAT_ACCOUNTS_DIR/$1" ]]; }

# Refuse a store that is not a plain directory sitting directly inside the
# accounts dir. Same shape as _sessions_trash_dir and for the same reason: the
# thing being written is a credential, and a symlink would relocate it while the
# write reported success. Claude Code's own store opens with O_NOFOLLOW and maps
# the error to "no credentials", which presents as a login screen with no
# explanation, so a symlink here is silent in both directions.
_account_dir_ok() {
  local d="$CLEAT_ACCOUNTS_DIR/$1"
  [[ -L "$d" ]] && return 1
  [[ -e "$d" ]] && [[ ! -d "$d" ]] && return 1
  return 0
}

_account_ensure_dir() {
  local acct="$1" d
  _account_dir_ok "$acct" || return 1
  # The PARENT too. `mkdir -p a/b` creates `a` at the host umask, which is 0755
  # on a default install, so locking only the leaf left the directory listing
  # every account name world-readable.
  mkdir -p "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || return 1
  chmod 700 "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || true
  d="$CLEAT_ACCOUNTS_DIR/$acct"
  mkdir -p "$d" 2>/dev/null || return 1
  chmod 700 "$d" 2>/dev/null || true
  return 0
}

# Every stored account, one per line. A name that would not validate today is
# skipped rather than listed, so a hand-made directory cannot become a row the
# picker will then refuse to act on.
_account_list() {
  local d base
  [[ -d "$CLEAT_ACCOUNTS_DIR" ]] || return 0
  for d in "$CLEAT_ACCOUNTS_DIR"/*; do
    [[ -d "$d" ]] || continue
    [[ -L "$d" ]] && continue
    base="${d##*/}"
    _validate_account_name "$base" || continue
    printf '%s\n' "$base"
  done
}

# ── The per-box pin ─────────────────────────────────────────────────────────
# One file per container name holding one account name, copying _box_kit_* down
# to why it is its own directory rather than a suffixed file in boxes/: the
# globs there must never iterate anything but a box description.

_box_account_file() { printf '%s' "$CLEAT_BOX_ACCOUNTS_DIR/$1"; }

_box_account_read() {
  local f v
  f="$(_box_account_file "$1")"
  if [[ -f "$f" ]]; then
    v="$(head -n1 "$f" 2>/dev/null | tr -d '\r\n' || true)"
    if _validate_account_name "$v"; then
      printf '%s' "$v"
      return 0
    fi
  fi
  printf '%s' "$_ACCOUNT_DEFAULT"
}

# Temp and rename, never a truncating write. The attach, status and the launch
# summary read the pin WITHOUT the account lock, and an empty pin reads as the
# shared login, so a switch caught between truncate and write launched a pinned
# box on the shared login. mv also replaces a symlink at the pin path rather
# than writing through it. The temp name starts with a dot so no glob over this
# directory mistakes a leftover for a box.
#
# The directory is 0700 for the same reason the accounts directory is. At the
# host umask it listed every container name and the account it is pinned to.
# $3 is the box's per-project session key, written on a SECOND line. Every
# existing reader takes line one only, so the key is invisible to all of them.
#
# The key is there for the paths that know a box only by its container name.
# `cleat account rm` unpins boxes in other projects, and a container name
# cannot be turned back into its per-project claude.json: the name truncates
# the directory segment and the project path is recorded nowhere else. Without
# it the remove dropped the pin and left the removed account's email in the
# box. `_newest_sibling_identity` reads it too, to tell a pinned box's file
# from a shared-login one.
_box_account_write() {
  local cname="$1" acct="$2" key="${3:-}" f tmp
  mkdir -p "$CLEAT_BOX_ACCOUNTS_DIR" 2>/dev/null || return 1
  chmod 700 "$CLEAT_BOX_ACCOUNTS_DIR" 2>/dev/null || true
  f="$(_box_account_file "$cname")"
  # mv onto a directory would move the temp INTO it and report success.
  [[ -d "$f" && ! -L "$f" ]] && return 1
  tmp="$(mktemp "$CLEAT_BOX_ACCOUNTS_DIR/.pin.XXXXXX" 2>/dev/null)" || return 1
  printf '%s\n' "$acct" > "$tmp" || { rm -f "$tmp" 2>/dev/null; return 1; }
  if _account_session_key_ok "$key"; then
    printf '%s\n' "$key" >> "$tmp" || { rm -f "$tmp" 2>/dev/null; return 1; }
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$f" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  return 0
}

# A per-project session key is ONE path segment under $CLEAT_PROJECTS_DIR:
# _derive_project_session_key only ever emits [a-z0-9-] plus a validated box
# suffix. The pin file is hand-editable, so anything else is refused before it
# is joined into a path. This is what stops a hand-written `../outside` on line
# two from reaching a file outside the projects store.
_account_session_key_ok() {
  local _key_re='^[a-z0-9_-]+$'
  [[ "${1:-}" =~ $_key_re ]]
}

# The key recorded with the pin, or nothing (exit 1) for a pin written before
# keys were recorded, or one whose second line fails the check above.
_box_account_key() {
  local f v
  f="$(_box_account_file "$1")"
  [[ -f "$f" ]] || return 1
  v="$(sed -n '2p' "$f" 2>/dev/null | tr -d '\r\n' || true)"
  _account_session_key_ok "$v" || return 1
  printf '%s' "$v"
}

# Every per-project key whose box is pinned to a NAMED account, as ":a:b:".
# Colon-delimited because a key can never contain one, so a membership test is
# one glob and no fork per candidate.
_pinned_project_keys() {
  local f base k out=":"
  if [[ -d "$CLEAT_BOX_ACCOUNTS_DIR" ]]; then
    for f in "$CLEAT_BOX_ACCOUNTS_DIR"/*; do
      [[ -f "$f" ]] || continue
      base="${f##*/}"
      [[ "$(_box_account_read "$base")" == "$_ACCOUNT_DEFAULT" ]] && continue
      k="$(_box_account_key "$base")" || continue
      out="${out}${k}:"
    done
  fi
  printf '%s' "$out"
}

_box_account_remove() { rm -f "$(_box_account_file "$1")" 2>/dev/null || true; }

# Every box pinned to this account, so a remove can say what it would strand.
_account_pinned_boxes() {
  local acct="$1" f base
  [[ -d "$CLEAT_BOX_ACCOUNTS_DIR" ]] || return 0
  for f in "$CLEAT_BOX_ACCOUNTS_DIR"/*; do
    [[ -f "$f" ]] || continue
    base="${f##*/}"
    [[ "$(_box_account_read "$base")" == "$acct" ]] || continue
    printf '%s\n' "$base"
  done
}

# ── The account lock ────────────────────────────────────────────────────────
#
# Every read-decide-write of a pin, a store or a staged credential runs under
# ONE host lock. Without it two terminals interleaved. An attach that had read
# pin a staged a's credential after a switch pinned b and staged b (5 in 100
# natural runs). A session-end harvest wrote b's credential into a's store. An
# attach that read the pin between a rename's move and its pin rewrite found no
# store and deleted the staged login.
#
# One lock rather than one per box, because rename and remove rewrite every
# box's pin and two boxes pinned to one account share its store. With a single
# lock no ordering between locks can invert. Holds are short: file operations
# plus at most one bounded profile request per harvest. Prompts and the usage
# poll never run under it. Identity invalidation and docker stay outside it with
# one exception, the live switch (_account_handoff), which holds the lock from
# its re-check through the reopen tickets so the box's login cannot change under
# the stop. Under it that switch runs a bounded re-probe (_handoff_probe, 8 s),
# the terminate exec (_handoff_docker_exec, bounded 22 s) and the identity drop
# (_account_switch_identity, whose running-box check asks docker). A `_locked`
# suffix means the caller already holds it, and those bodies call only other
# `_locked` bodies. It is reentrant within one shell, so a body that calls a
# locking wrapper by mistake nests instead of waiting on itself until the
# timeout and then skipping its write without a word.
#
# The primitive is test/lib/testlock.sh's with its TOCTOU-fixed steal, changed
# in three ways. It waits instead of refusing. A directory with no owner record
# yet (mkdir comes first, the record a moment later) is honoured for a grace
# period rather than stolen at once or honoured forever. And a record older than
# an age bound is stale whatever its pid says, so a pid recycled after a reboot
# cannot wedge every account command.
#
# A timeout returns _ACCOUNT_LOCK_BUSY and NEVER falls through to an unlocked
# write or delete. The attach starts on what is staged, a session end keeps the
# staged file, a wipe keeps auth/, nuke keeps the run dirs and a verb prints the
# busy message. A lock left by a crash just before macOS renames the host (a
# network change moves $HOSTNAME) reads as another machine's and is honoured
# until the age bound, which fails safe.
_ACCOUNT_LOCK_DEPTH=0
_ACCOUNT_LOCK_WAIT_S=20
_ACCOUNT_LOCK_GRACE_S=10
_ACCOUNT_LOCK_STALE_S=300
_ACCOUNT_LOCK_BUSY=75
# The exact record this shell wrote, so a release removes only its own lock.
_ACCOUNT_LOCK_OWNER=""
# Did the last attempt fail because the directory cannot take a lock at all,
# rather than because another command holds one? Read only by the message.
_ACCOUNT_LOCK_UNWRITABLE=0

_account_lock_path() { printf '%s' "$CLEAT_ACCOUNTS_DIR/.lock"; }

# One poll while another command holds the lock. A function so a test can
# observe a waiter instead of timing one.
_account_lock_pause() { sleep 0.1; }

# The real clock, never _CLEAT_NOW_S. The record is compared with directory
# mtimes, which are real.
_account_lock_now() { date +%s 2>/dev/null || echo 0; }

# Is the lock held by this owner record provably abandoned? Anything uncertain
# answers no.
_account_lock_is_stale() {
  local owner="$1" now mtime age o_host o_pid o_at
  local re='^host (.+) pid ([1-9][0-9]{0,9}) at ([1-9][0-9]{0,14})$'
  now="$(_account_lock_now)"
  case "$now" in ''|*[!0-9]*|0) return 1 ;; esac
  if [[ ! "$owner" =~ $re ]]; then
    # mkdir precedes the record write, so a record-less lock is usually a
    # winner a moment from writing it. One that stays record-less was killed in
    # that moment.
    mtime="$(_path_mtime "$(_account_lock_path)")"
    case "$mtime" in ''|*[!0-9]*|0) return 1 ;; esac
    age=$(( now - mtime ))
    if [[ $age -gt $_ACCOUNT_LOCK_GRACE_S ]]; then return 0; fi
    return 1
  fi
  o_host="${BASH_REMATCH[1]}"
  o_pid="${BASH_REMATCH[2]}"
  o_at="${BASH_REMATCH[3]}"
  age=$(( now - o_at ))
  # A clock that stepped backwards is never a reason to take a live lock.
  if [[ $age -lt 0 ]]; then return 1; fi
  if [[ $age -gt $_ACCOUNT_LOCK_STALE_S ]]; then return 0; fi
  # Another machine sharing this directory cannot be probed, so age decides.
  [[ "$o_host" == "${HOSTNAME:-unknown}" ]] || return 1
  kill -0 "$o_pid" 2>/dev/null && return 1
  # kill -0 also fails with EPERM for a live process of another user.
  ps -p "$o_pid" >/dev/null 2>&1 && return 1
  return 0
}

_account_lock() {
  local lock owner captured aside polls=0 max unmade=0
  if [[ $_ACCOUNT_LOCK_DEPTH -gt 0 ]]; then
    _ACCOUNT_LOCK_DEPTH=$(( _ACCOUNT_LOCK_DEPTH + 1 ))
    return 0
  fi
  _ACCOUNT_LOCK_UNWRITABLE=0
  mkdir -p "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || { _ACCOUNT_LOCK_UNWRITABLE=1; return "$_ACCOUNT_LOCK_BUSY"; }
  chmod 700 "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || true
  lock="$(_account_lock_path)"
  max=$(( _ACCOUNT_LOCK_WAIT_S * 10 ))
  while :; do
    if [[ -L "$lock" ]] || { [[ -e "$lock" ]] && [[ ! -d "$lock" ]]; }; then
      # This CLI only ever makes a directory here, so anything else was planted.
      # It is never followed, cleared or waited on.
      return "$_ACCOUNT_LOCK_BUSY"
    fi
    if mkdir "$lock" 2>/dev/null; then
      _ACCOUNT_LOCK_OWNER="host ${HOSTNAME:-unknown} pid $$ at $(_account_lock_now)"
      ( umask 077; printf '%s\n' "$_ACCOUNT_LOCK_OWNER" > "$lock/owner" ) 2>/dev/null || true
      _ACCOUNT_LOCK_DEPTH=1
      return 0
    fi
    # A lock that cannot be MADE is not a lock somebody else is holding. mkdir
    # fails with EEXIST while another command holds it, and with EACCES, EROFS
    # or ENOSPC when the accounts directory cannot take a directory at all: a
    # sudo run that left it root-owned, a read-only mount, a full disk. Waiting
    # the whole timeout out on those is twenty seconds of frozen terminal per
    # call, at every attach and again at every session end, and the line at the
    # end of it names the wrong cause and asks for a retry that can never work.
    # So the path is looked at. Nothing there means the failure was not EEXIST,
    # and the wait is over before it starts. A release that landed between the
    # mkdir and this look leaves nothing there either, so the make is retried
    # once, without a pause, before the directory is called unwritable.
    if [[ ! -e "$lock" && ! -L "$lock" ]]; then
      if [[ $unmade -eq 0 ]]; then
        unmade=1
        continue
      fi
      _ACCOUNT_LOCK_UNWRITABLE=1
      return "$_ACCOUNT_LOCK_BUSY"
    fi
    owner=""
    IFS= read -r owner 2>/dev/null < "$lock/owner" || true
    if [[ -d "$lock" && ! -L "$lock" ]] && _account_lock_is_stale "$owner"; then
      # Claim the right to clear it with a rename only one process can win,
      # then check that what was moved aside is still the record judged stale.
      # If another taker cleared it and made a fresh lock in between, that
      # fresh lock goes back.
      aside="${lock}.stale.$$"
      rm -rf "$aside" 2>/dev/null || true
      if mv "$lock" "$aside" 2>/dev/null; then
        captured=""
        IFS= read -r captured 2>/dev/null < "$aside/owner" || true
        if [[ "$captured" == "$owner" ]]; then
          rm -rf "$aside" 2>/dev/null || true
          continue
        fi
        if [[ ! -e "$lock" && ! -L "$lock" ]]; then
          mv "$aside" "$lock" 2>/dev/null || true
        fi
        rm -rf "$aside" 2>/dev/null || true
      fi
    fi
    if [[ $polls -ge $max ]]; then return "$_ACCOUNT_LOCK_BUSY"; fi
    polls=$(( polls + 1 ))
    _account_lock_pause
  done
}

# Only ever our own lock. After an age-bound steal the directory may be another
# command's, and removing that one would let two commands in at once.
_account_unlock() {
  local lock owner=""
  [[ $_ACCOUNT_LOCK_DEPTH -gt 0 ]] || return 0
  _ACCOUNT_LOCK_DEPTH=$(( _ACCOUNT_LOCK_DEPTH - 1 ))
  [[ $_ACCOUNT_LOCK_DEPTH -eq 0 ]] || return 0
  lock="$(_account_lock_path)"
  [[ -d "$lock" && ! -L "$lock" ]] || return 0
  IFS= read -r owner 2>/dev/null < "$lock/owner" || true
  [[ -n "$_ACCOUNT_LOCK_OWNER" && "$owner" == "$_ACCOUNT_LOCK_OWNER" ]] || return 0
  rm -rf "$lock" 2>/dev/null || true
  return 0
}

# True only while this shell still holds the account lock: the on-disk owner
# record equals the one _account_lock wrote, the same test _account_unlock uses.
# The live switch reads this after the terminate exec, because that exec can
# outrun P2's wait and an age-bound steal could have handed the lock to another
# command meanwhile. It must never write the store or the pin once it reads
# false. A record-less or stolen lock reads false.
_account_lock_owned() {
  local lock owner=""
  [[ -n "$_ACCOUNT_LOCK_OWNER" ]] || return 1
  lock="$(_account_lock_path)"
  [[ -d "$lock" && ! -L "$lock" ]] || return 1
  IFS= read -r owner 2>/dev/null < "$lock/owner" || true
  [[ "$owner" == "$_ACCOUNT_LOCK_OWNER" ]] || return 1
  return 0
}

# Take the account lock and release it at once, nothing in between. It is the
# attach side's way to wait out a switch: if a switch holds the lock this blocks
# up to P2's wait, then either the lock frees (return 0, the caller reads the pin
# the switch left) or the wait runs out (return _ACCOUNT_LOCK_BUSY, the caller's
# gate decides). A box that never used accounts has no accounts dir and skips the
# lock, so the gate is a true no-op there.
_account_settle() {
  [[ -d "$CLEAT_ACCOUNTS_DIR" ]] || return 0
  _account_lock || return $?
  _account_unlock
  return 0
}

# Run FUNCTION ARGS under the lock and return its status, or _ACCOUNT_LOCK_BUSY
# without running it.
_account_with_lock() {
  local rc=0
  _account_lock || return "$_ACCOUNT_LOCK_BUSY"
  "$@" || rc=$?
  _account_unlock
  return "$rc"
}

_account_busy_msg() {
  if [[ "${_ACCOUNT_LOCK_UNWRITABLE:-0}" -eq 1 ]]; then
    error "Cleat cannot write to the accounts directory."
    echo -e "    ${DIM}Nothing was changed. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
    return 0
  fi
  error "Another cleat command is changing accounts right now."
  echo -e "    ${DIM}Nothing was changed. Try again in a moment.${RESET}"
}

# ── Credential files ────────────────────────────────────────────────────────

# A credential file is a few hundred bytes. Anything larger is not one, and the
# only path that reads an UNTRUSTED one is the harvest out of a directory the
# box mounts read-write, where the next step is a `cat` and a shell variable.
_ACCOUNT_CRED_MAX_BYTES=65536

# ── Live account switch: constants ──────────────────────────────────────────
# The restart-and-resume handoff. None is read from the environment. Times are
# whole seconds because the in-box verb counts seconds; token counts are
# Claude Code 2.1.270's standard-window figures. See concept/44.
_HANDOFF_PROBE_TIMEOUT_S=8         # bound on the read-only probe of the box
_HANDOFF_EXEC_TIMEOUT_S=22         # bound on the terminate exec (lock + kill wait, +start)
_HANDOFF_T1_WAIT_S=60             # terminal 1's wait for the switch to finish
_HANDOFF_STARTING_MAX_S=120       # a live-but-unprobed Claude younger than this is "starting"
_HANDOFF_READY_MAX_AGE_S=120      # the one ticket age bound
_HANDOFF_CONFIRM_WAIT_S=20        # terminal 2's wait for the reopen to confirm
_HANDOFF_OUT_MAX_BYTES=65536      # cap on the terminate exec's captured output
_HANDOFF_STD_WINDOW_TOKENS=200000 # the standard context window
_HANDOFF_VERIFIED_CLAUDE="2.1.270" # the Claude Code the handoff was checked against, space-separated
_HANDOFF_COMPACT_BUFFER_TOKENS=13000 # auto-compact fires this far below the window
# Claude Code's resume-from-summary dialog, on the handoff reopen only. It fires
# when a flag is on, the last message is older than
# CLAUDE_CODE_RESUME_THRESHOLD_MINUTES (default 70) AND the conversation is past
# CLAUDE_CODE_RESUME_TOKEN_THRESHOLD (default 100000). That is exactly the
# at-limit case, and a typed `continue` then picks one of its options. Either
# variable alone suppresses it (measured on 2.1.270 with the flag seeded), so
# both are set: a rename of one still leaves the reopen transparent.
_HANDOFF_RESUME_THRESHOLD_MIN=5256000        # ten years
_HANDOFF_RESUME_TOKEN_THRESHOLD=2000000000   # past any real context window
_HB_LOCK_WAIT_S=8                 # the in-box verb's wait for Claude's refresh lock
_HB_KILL_WAIT_S=8                 # the in-box verb's wait for a signalled Claude to exit
_HB_CLAUDE_LOCK_STALE_S=60        # Claude's own proper-lockfile stale bound, shipped into the box

# The three seams the switch shells out through. Each is one line so a test can
# override it with a fast or a deterministic stand-in, and every caller runs it
# with `|| true` so an override that returns non-zero never trips strict mode.
# The in-box verb's own waits are arguments, never these, so nothing here ships
# into the box.
_handoff_now() { date +%s; }
_handoff_exec_pause() { sleep 0.1; }
_handoff_t1_pause() { sleep 0.1; }

_account_cred_sane_size() {
  local sz
  [[ -f "$1" ]] || return 1
  sz="$(wc -c < "$1" 2>/dev/null || true)"
  # BSD wc left-pads, so take the first field rather than the word.
  set -- $sz
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  [[ "$1" -le "$_ACCOUNT_CRED_MAX_BYTES" ]]
}

# One field of the Claude login in a credential file: claudeAiOauth.KEY and
# nothing else. Every reader of a credential goes through these two.
#
# The file also holds mcpOAuth, one entry per MCP server, each with its OWN
# accessToken, refreshToken and expiresAt. The old readers searched the whole
# blob and took the first match with jq and the last without it. Claude writes
# mcpOAuth BEFORE claudeAiOauth when the MCP login came first, so on a host with
# jq the usage poll sent the MCP server's bearer to api.anthropic.com. Without
# jq a blanked login beside a live MCP entry read as plausible and was harvested
# over the account's only good credential. This is one path with no jq, so both
# hosts give the same answer. A login it cannot isolate reads as empty, which
# every caller treats as signed out: never harvested, never polled.
#
# Capped at the credential size: the staged copy is in a directory the box can
# write. A missing file reads as empty.
_account_cred_str() {
  _json_flat_str "$(head -c "$_ACCOUNT_CRED_MAX_BYTES" "$1" 2>/dev/null | _json_flat_object claudeAiOauth)" "$2"
}

_account_cred_num() {
  _json_flat_num "$(head -c "$_ACCOUNT_CRED_MAX_BYTES" "$1" 2>/dev/null | _json_flat_object claudeAiOauth)" "$2"
}

# A bearer that may go into a curl config: base64url plus the few characters an
# OAuth token uses. Nothing else passes. The token comes from a store harvested out
# of a directory the box mounts read-write. The curl config takes one directive
# per line. A newline starts a new one. A quote or a backslash changes where the
# header value ends. A box that planted any of them could turn a usage poll
# into a host file write (output =) or read (upload-file =). The letters are
# spelled out because an A-Z range can match outside ASCII under a UTF-8
# collation.
_account_token_ok() {
  case "$1" in
    ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._~+/=-]*) return 1 ;;
  esac
  return 0
}

# Does this blob actually look like a Claude credential, rather than merely
# like JSON? Only ever asked of a file the box could have written.
#
# Without this a box could drop {"x":1,"claudeAiOauth":{"expiresAt":<huge>}}
# into its own auth directory and the harvest would accept it as "newer",
# overwriting the host's real refresh token with something that contains no
# token at all. There is no trash on that path and no undo: the account is
# simply signed out and the weeks of refresh life are gone.
#
# Both tokens are the Claude login's own. An MCP server's tokens beside a
# blanked login do not make it plausible.
_account_cred_plausible() {
  local at rt
  at="$(_account_cred_str "$1" accessToken 2>/dev/null || true)"
  rt="$(_account_cred_str "$1" refreshToken 2>/dev/null || true)"
  [[ -n "$at" && -n "$rt" ]]
}

# Epoch MILLISECONDS the Claude login in this file expires (claudeAiOauth only,
# never an MCP server's token beside it), or 0. Reuses _oauth_expires_at, the
# parser _seed_macos_credentials already trusts. Capped at the credential size
# because the staged copy lives in a directory the box can write. Its expiry is
# read before any size check.
_account_cred_expiry() {
  local f="$1" v
  [[ -s "$f" ]] || { printf '0'; return 0; }
  v="$(head -c "$_ACCOUNT_CRED_MAX_BYTES" "$f" 2>/dev/null | _oauth_expires_at || true)"
  case "$v" in ''|*[!0-9]*) v=0 ;; esac
  printf '%s' "$v"
}

# The keys of a Claude Code credential store that belong to the ACCOUNT. Exactly
# the set Claude Code 2.1.270 deletes when a /login replaces the account while it
# keeps every MCP and plugin secret (performLogout with preserveNonAnthropicAuth).
# Everything else in the file (mcpOAuth, mcpOAuthClientConfig, mcpXaaIdp,
# pluginSecrets, coworkRemoteDevice) belongs to the box that wrote it. Copying
# the whole file erased an MCP server login at the next attach, so Claude called
# the server with no bearer, and it carried one box's MCP tokens into the store
# and on to every box pinned to the same account.
# Re-check this list on every Claude Code bump (grep the bundle for
# `delete n.claudeAiOauth`).
_ACCOUNT_SCOPED_KEYS="claudeAiOauth organizationUuid trustedDeviceToken enterpriseGateway designOauth"

# One JSON object split into its top-level members, each copied verbatim. awk
# and not jq, on every host: a host with jq and one without must write the same
# bytes, and a second implementation would be a second answer. POSIX awk only
# (split, substr, index, sub, `(i,j) in A`), checked on mawk, gawk and the BWK
# awk macOS ships.
#
# Input is BASE, a line holding only \001, then SRC. Output is every member of
# BASE whose key is not account-scoped, then every member of SRC whose key is.
# Anything the splitter does not fully understand fails the split rather than
# being guessed at: a backslash in a top-level key, a repeated key, unbalanced
# brackets, bytes after a value or after the object, a value that starts after
# stray bytes and a bare word that is not true, false, null or a number. A SRC
# that fails exits 1. A BASE that fails contributes nothing.
_ACCOUNT_MERGE_AWK='
function skip(s, i, L) {
  while (i <= L && index(" \t\r\n", substr(s, i, 1)) > 0) i++
  return i
}
function members(s, p,    L, i, c, ks, key, vs, d, q, e, n, val, done) {
  L = length(s); n = 0
  i = skip(s, 1, L)
  if (substr(s, i, 1) != "{") return 0
  i = skip(s, i + 1, L)
  if (substr(s, i, 1) == "}") { N[p] = 0; return skip(s, i + 1, L) > L }
  while (1) {
    if (substr(s, i, 1) != "\"") return 0
    ks = ++i
    while (i <= L && (c = substr(s, i, 1)) != "\"") { if (c == "\\") return 0; i++ }
    if (i > L) return 0
    key = substr(s, ks, i - ks)
    if ((p, key) in SEEN) return 0
    SEEN[p, key] = 1
    i = skip(s, i + 1, L)
    if (substr(s, i, 1) != ":") return 0
    i = skip(s, i + 1, L)
    vs = i; d = 0; q = 0; e = 0; done = 0
    for (; i <= L; i++) {
      c = substr(s, i, 1)
      if (q) { if (e) e = 0; else if (c == "\\") e = 1; else if (c == "\"") { q = 0; if (d == 0) done = 1 } continue }
      if (d == 0 && (c == "," || c == "}")) break
      if (done && index(" \t\r\n", c) == 0) return 0
      if (d == 0 && i != vs && (c == "\"" || c == "{" || c == "[")) return 0
      if (c == "\"") q = 1
      else if (c == "{" || c == "[") d++
      else if (c == "}" || c == "]") { if (d == 0) return 0; if (--d == 0) done = 1 }
    }
    if (i > L) return 0
    val = substr(s, vs, i - vs)
    sub(/[ \t\r\n]+$/, "", val)
    if (!done && val !~ /^(true|false|null|-?[0-9][0-9.eE+-]*)$/) return 0
    n++; K[p, n] = key; M[p, n] = "\"" key "\":" val
    if (c == "}") { N[p] = n; return skip(s, i + 1, L) > L }
    i = skip(s, i + 1, L)
  }
}
BEGIN { nk = split(keys, a, " "); for (j = 1; j <= nk; j++) ACCT[a[j]] = 1; part = 1 }
part == 1 && $0 == "\001" { part = 2; next }
{ buf[part] = buf[part] $0 "\n" }
END {
  if (!members(buf[2], 2)) { if (have_src) exit 1; N[2] = 0 }
  if (!members(buf[1], 1)) N[1] = 0
  out = ""
  for (j = 1; j <= N[1]; j++) if (!(K[1, j] in ACCT)) out = out (out == "" ? "" : ",") M[1, j]
  for (j = 1; j <= N[2]; j++) if (K[2, j] in ACCT) out = out (out == "" ? "" : ",") M[2, j]
  printf "{%s}\n", out
}'

# Print one credential object: the box's own members of BASE and the account's
# members of SRC. Either may be "". So `merge "" store` is the shape a stored
# account may have, `merge staged store` stages an account without touching
# what the box signed into for itself and `merge staged ""` signs the box out of
# the account and nothing else. Returns 1 when SRC is given and cannot be split.
#
# Both are host-private (a store, or a snapshot taken by _account_snapshot_cred,
# which already did the read-once and -ef checks on the box's bytes), so a link
# is simply refused. Capped at the credential size. NUL is dropped because awks
# disagree on it, and \001 in BASE because it is the separator. Tokens travel on
# stdin, never on argv.
_account_cred_merge() {
  local base="$1" src="$2" have_src=1
  if [[ -z "$src" ]]; then
    src=/dev/null
    have_src=0
  fi
  [[ -n "$base" ]] || base=/dev/null
  [[ -L "$base" || -L "$src" ]] && return 1
  [[ "$src" == /dev/null || -f "$src" ]] || return 1
  [[ "$base" == /dev/null || -f "$base" ]] || base=/dev/null
  { head -c "$_ACCOUNT_CRED_MAX_BYTES" "$base" 2>/dev/null | LC_ALL=C tr -d '\000\001'
    printf '\n\001\n'
    head -c "$_ACCOUNT_CRED_MAX_BYTES" "$src" 2>/dev/null | LC_ALL=C tr -d '\000'
  } | LC_ALL=C awk -v keys="$_ACCOUNT_SCOPED_KEYS" -v have_src="$have_src" "$_ACCOUNT_MERGE_AWK"
}

# The Claude login in a credential file exactly as every reader sees it (the
# flat claudeAiOauth object), or nothing. Two files hold the same login when
# this prints the same text for both.
_account_cred_login() {
  [[ -n "$1" ]] || return 0
  head -c "$_ACCOUNT_CRED_MAX_BYTES" "$1" 2>/dev/null | _json_flat_object claudeAiOauth || true
}

# Write a credential into place at 0600, atomically, refusing anything that is
# not a JSON object. The umask subshell is the point: a plain `cp` would leave a
# live OAuth token readable at the host's default umask for the length of the
# copy. Lifted from _seed_macos_credentials, which had to solve this first.
#
# What is written is _account_cred_merge BASE SRC: the account's keys of SRC
# over the box's own keys of BASE. With no BASE that is the account's keys alone,
# which is what every store write is, so a store an older build filled with a
# box's MCP tokens loses them at its next harvest. An empty SRC means "no
# account keys".
_account_write_file_0600() {
  local src="$1" dest="$2" base="${3:-}" tmp ok=false
  [[ -L "$dest" ]] && return 1
  # A directory there would take the temp file INTO it, report success and
  # leave the box with no credential at all.
  [[ -d "$dest" ]] && return 1
  # A source the BOX can write is capped before it is read, because the next
  # thing that happens to it is a `cat` into a host file and, later, a shell
  # variable. A credential is under 4 KB.
  [[ -z "$src" ]] || _account_cred_sane_size "$src" || return 1
  # mktemp, not "$dest.tmp.$$". The old name was guessable and unguarded, and
  # half the destinations live in a directory the box mounts read-write, so a
  # planted symlink there would have redirected a live credential to any host
  # file the user can write. mktemp refuses an existing path (symlink or FIFO
  # included) and creates at 0600 on both BSD and GNU.
  tmp="$(mktemp "${dest}.tmp.XXXXXX" 2>/dev/null)" || return 1
  # By key, never the whole file. See _account_cred_merge.
  ( umask 077; _account_cred_merge "$base" "$src" > "$tmp" ) 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  # A store takes exactly the login every reader found in the source. The
  # readers find claudeAiOauth at any depth and the merge copies top-level keys
  # only, so a login a box nested inside another key read as plausible and
  # projected to {}: a harvest of the same grant wrote a store with no login
  # over the account's only copy.
  if [[ -n "$src" && -z "$base" && "$(_account_cred_login "$tmp")" != "$(_account_cred_login "$src")" ]]; then
    rm -f "$tmp" 2>/dev/null
    return 1
  fi
  if command -v jq &>/dev/null; then
    jq -e 'type=="object"' "$tmp" >/dev/null 2>&1 && ok=true
  else
    _looks_like_json_object "$tmp" && ok=true
  fi
  if ! $ok; then
    rm -f "$tmp" 2>/dev/null
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$dest" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  return 0
}

# Writes into a store that exists and never creates one. A harvest decides early
# and writes late, and a `cleat account rm` or a rename in another terminal can
# move the store away in between. A mkdir -p here put the account back under its
# old name, empty or refilled, and `restore` then refused. Past this check
# nothing creates a directory: mktemp, the redirect and mv all fail when the
# store has gone. The decline returns 1, so the wipe that asked keeps the staged
# file. The one place that creates a store is the explicit switch to a new name.
_account_write_cred() {
  local acct="$1" src="$2" gone
  _account_exists "$acct" || return 1
  # The generation this write replaces, fingerprinted before it goes (see
  # _account_seen_add). A box still staged on it is behind this account, not on
  # another account's login, and must not be quarantined for that at its next
  # attach.
  gone="$(_account_rt_fingerprint "$(_account_cred_str "$(_account_cred_path "$acct")" refreshToken 2>/dev/null || true)" 2>/dev/null || true)"
  _account_write_file_0600 "$src" "$(_account_cred_path "$acct")" || return 1
  [[ -z "$gone" ]] || _account_seen_add "$acct" "$gone" || true
  return 0
}

# A held login is kept as the exact bytes it was found in, MCP logins and all.
# The dedupe compares those bytes, and an adopt takes the account's keys out of
# them later. DEST is a new file in a new entry directory under the host-only
# accounts tree, so there is nothing to merge with and no link to race. The
# checks are the ones _account_cred_keepable makes, so what it calls keepable
# can always be kept.
_account_copy_whole_0600() {
  local src="$1" dest="$2"
  [[ -f "$src" && ! -L "$src" ]] || return 1
  [[ ! -e "$dest" && ! -L "$dest" ]] || return 1
  _account_cred_sane_size "$src" || return 1
  if command -v jq &>/dev/null; then
    jq -e 'type=="object"' "$src" >/dev/null 2>&1 || return 1
  else
    _looks_like_json_object "$src" || return 1
  fi
  ( umask 077; cat "$src" > "$dest" ) 2>/dev/null || { rm -f "$dest" 2>/dev/null; return 1; }
  chmod 600 "$dest" 2>/dev/null || true
  return 0
}

# Does descriptor FD still hold the file PATH names? The check runs after the
# open, so a path that is no symlink now and carries this descriptor's inode is
# this descriptor's file. A swap after it cannot reach an open descriptor.
#
# Inode, never `-ef`. `-ef` compares device AND inode, and on macOS /dev/fd/N is
# a devfs node whose device is devfs rather than the file's, so `-ef` never
# matched there: every account harvest on a Mac refused, and a pinned login was
# never saved to its account. `ls -L` dereferences, which is what makes one
# reader answer alike on Linux (/dev/fd/N is a symlink) and macOS (a device
# node). Inode alone is enough because the only writer of the directory this
# guards is the box, through a bind mount into the host filesystem the path is
# already on, so it cannot present a same-inode file from anywhere else.
_fd_holds_path() {
  local fd="$1" path="$2" a b
  [[ ! -L "$path" ]] || return 1
  [[ -f "/dev/fd/$fd" ]] || return 1
  a="$(ls -Ldi "$path" 2>/dev/null | awk '{print $1}')"
  b="$(ls -Ldi "/dev/fd/$fd" 2>/dev/null | awk '{print $1}')"
  case "$a" in ''|*[!0-9]*) return 1 ;; esac
  [[ "$a" == "$b" ]]
}

# ONE read of a credential file the box can rewrite at any moment, into a
# host-private copy. Prints the copy's path, or returns 1. The caller removes
# the copy.
#
# Every decision about box-written bytes (the expiry, the plausibility, the
# write) is made on this copy and never on the path again. Reading the path
# three times let bytes that landed after the checks reach the store unchecked:
# Claude blanking both tokens on invalid_grant, or a symlink the box swapped in,
# which had the host-side copy read any host file the user can read into the
# account store and the next attach hand it back into the box.
#
# The file is opened once. A symlink swapped in before the open and left there
# fails the second -L. One swapped in and swapped back to a regular file fails
# the inode check, because the descriptor holds a different file. The copy lives
# in the host-only accounts directory, never under the run directory the box
# mounts. A FIFO swapped in between the check and the open blocks the reader
# until it is killed. The lock's age bound then lets the next command in.
_account_snapshot_cred() {
  local src="$1" tmp
  [[ -f "$src" && ! -L "$src" ]] || return 1
  mkdir -p "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || return 1
  chmod 700 "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || true
  tmp="$(mktemp "$CLEAT_ACCOUNTS_DIR/.snap.XXXXXX" 2>/dev/null)" || return 1
  if ! ( exec 3<"$src" || exit 1
         _fd_holds_path 3 "$src" || exit 1
         umask 077
         head -c $(( _ACCOUNT_CRED_MAX_BYTES + 1 )) <&3 > "$tmp" ) 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  if ! _account_cred_sane_size "$tmp"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  printf '%s' "$tmp"
}

# Would a hold (_account_copy_whole_0600) take this host-private copy, and is it
# a Claude login rather than junk? It must accept exactly what that writer
# accepts, or a hold fails on content and the command that asked refuses for
# good over a file nothing could ever save.
_account_cred_keepable() {
  _account_cred_plausible "$1" || return 1
  if command -v jq &>/dev/null; then
    jq -e 'type=="object"' "$1" >/dev/null 2>&1
  else
    _looks_like_json_object "$1"
  fi
}

# A host-private copy of FILE when it holds a login worth keeping. Prints the
# copy's path (the caller removes it). Returns 1 when there is nothing worth
# keeping (absent, a link, a pipe, oversized, no tokens, not a JSON object) and
# 2 when a login is there but could not be copied.
#
# The cheap bounded read comes first, so a box with nothing in it never creates
# the accounts directory. The decision is then made again on the copy.
_account_keepable_snapshot() {
  local f="$1" snap
  [[ -f "$f" && ! -L "$f" ]] || return 1
  _account_cred_sane_size "$f" || return 1
  _account_cred_plausible "$f" || return 1
  snap="$(_account_snapshot_cred "$f")" || return 2
  if ! _account_cred_keepable "$snap"; then
    rm -f "$snap" 2>/dev/null || true
    return 1
  fi
  printf '%s' "$snap"
}

# ── Held logins ─────────────────────────────────────────────────────────────
#
# A login a box had that no account store took. Every command that deletes or
# replaces a staged credential used to trust the harvest's exit code, and the
# harvest returned 0 both when the store already held the login and when it
# simply declined a file that was not newer. So `cleat rm`, both switches,
# `cleat account rm` and nuke deleted a /login made inside the box as someone
# else, a refresh whose store write failed and a refresh misread as older,
# leaving no copy anywhere. Whatever the harvest does not take is copied here
# first, and a command that cannot copy it deletes nothing.
#
# .held/<epoch>-XXXXXX/ holds .credentials.json and meta (acct, box, reason,
# uuid, who, org). It lives under the accounts directory, which is host-only,
# never mounted into a box and refused by every wipe. No credential copy is ever
# kept under the run directory: every wipe removes it, and its auth/ is the
# box's own read-write mount. The id is the directory name mktemp made, so
# nothing has to be parsed out of an account or container name. Entries are
# swept on the trash clock.
#
# Reasons: unsaved (the pinned store has a different login), left-in-box (a
# login a wipe or a switch found where no harvest looks), other-account,
# replaced-by-adopt, replaced-by-harvest (a store with no verified owner, at its
# first verified harvest) and journal.
_ACCOUNT_HELD_ID=""

_account_held_dir() {
  local d="$CLEAT_ACCOUNTS_DIR/.held"
  [[ -L "$d" ]] && return 1
  [[ -e "$d" ]] && [[ ! -d "$d" ]] && return 1
  printf '%s' "$d"
}

# An id is exactly what _account_hold makes: a plain epoch (no leading zero,
# which bash arithmetic would read as octal) and mktemp's six characters.
_account_held_id_ok() {
  local re='^[1-9][0-9]{0,14}-[A-Za-z0-9]{6}$'
  [[ "$1" =~ $re ]]
}

# An entry that is a real directory with a credential in it. Prints its path.
_account_held_entry() {
  local hdir d
  _account_held_id_ok "$1" || return 1
  hdir="$(_account_held_dir)" || return 1
  d="$hdir/$1"
  [[ -d "$d" && ! -L "$d" ]] || return 1
  [[ -f "$d/.credentials.json" && ! -L "$d/.credentials.json" ]] || return 1
  printf '%s' "$d"
}

# Copy SRC into a new held entry. SRC must be host-private: a snapshot or a
# store file, never a path the box can write. Returns 0 when it is kept (a new
# entry, or the same bytes from the same box already are, which leaves
# _ACCOUNT_HELD_ID empty) and 1 when it could not be.
_account_hold() {
  local src="$1" acct="$2" cname="$3" reason="$4" uuid="${5:-}" who="${6:-}" org="${7:-}"
  local hdir d now entry older="" nexp="" dexp nl=$'\n'
  _ACCOUNT_HELD_ID=""
  [[ -f "$src" && ! -L "$src" ]] || return 1
  _account_cred_sane_size "$src" || return 1
  hdir="$(_account_held_dir)" || return 1
  mkdir -p "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || return 1
  chmod 700 "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || true
  mkdir -p "$hdir" 2>/dev/null || return 1
  chmod 700 "$hdir" 2>/dev/null || true
  # A command retried after a refusal must not stack copies of one file.
  for d in "$hdir"/*; do
    _account_held_entry "${d##*/}" >/dev/null || continue
    [[ "$(_account_meta_get_at "$d" box 2>/dev/null || true)" == "$cname" ]] || continue
    cmp -s "$d/.credentials.json" "$src" 2>/dev/null && return 0
    # Nor copies of one verified login a box keeps refreshing. Claude refreshes
    # about every eight hours. Every session end on a box running as another
    # account holds the new generation. One entry per box, account and reason
    # stays, the one with the newest expiry. A login no server vouched for has
    # no uuid and only ever folds into identical bytes (above).
    [[ -n "$uuid" && -n "$cname" ]] || continue
    [[ "$(_account_meta_get_at "$d" reason 2>/dev/null || true)" == "$reason" ]] || continue
    [[ "$(_account_meta_get_at "$d" uuid 2>/dev/null || true)" == "$uuid" ]] || continue
    [[ -n "$nexp" ]] || nexp="$(_account_cred_expiry "$src")"
    dexp="$(_account_cred_expiry "$d/.credentials.json")"
    [[ "$dexp" -lt "$nexp" ]] || return 0
    older="${older}${d}${nl}"
  done
  now="$(date +%s 2>/dev/null || true)"
  case "$now" in ''|0*|*[!0-9]*) return 1 ;; esac
  entry="$(mktemp -d "$hdir/${now}-XXXXXX" 2>/dev/null)" || return 1
  chmod 700 "$entry" 2>/dev/null || true
  if ! _account_copy_whole_0600 "$src" "$entry/.credentials.json" \
     || ! ( umask 077
            printf 'acct\t%s\nbox\t%s\nreason\t%s\nuuid\t%s\nwho\t%s\norg\t%s\n' \
              "$(_account_meta_clean "$acct")" "$(_account_meta_clean "$cname")" \
              "$(_account_meta_clean "$reason")" "$(_account_meta_clean "$uuid")" \
              "$(_account_meta_clean "$who")" "$(_account_meta_clean "$org")" > "$entry/meta"
          ) 2>/dev/null; then
    rm -rf "$entry" 2>/dev/null || true
    return 1
  fi
  chmod 600 "$entry/meta" 2>/dev/null || true
  _ACCOUNT_HELD_ID="${entry##*/}"
  # The older generations go only once the newer one is safely kept.
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    rm -rf "$d" 2>/dev/null || true
  done <<< "$older"
  return 0
}

# The same, saying so. A login set aside in silence is as good as lost to the
# person who has to find it.
_account_hold_box() {
  local acct="$2" cname="$3" reason="$4"
  _account_hold "$1" "$acct" "$cname" "$reason" || return 1
  [[ -n "$_ACCOUNT_HELD_ID" ]] || return 0
  if [[ -n "$acct" && "$reason" == "unsaved" ]]; then
    warn "Kept a login from ${BOLD}${cname}${RESET} that account ${BOLD}${acct}${RESET} does not have."
  else
    warn "Kept a login left behind in ${BOLD}${cname}${RESET}."
  fi
  echo -e "    ${DIM}Nothing was deleted. It is held as ${BOLD}${_ACCOUNT_HELD_ID}${RESET}${DIM} (see ${BOLD}cleat account held${RESET}${DIM}).${RESET}"
  echo -e "    ${DIM}Save it with ${BOLD}cleat account adopt ${_ACCOUNT_HELD_ID} <name>${RESET}${DIM}.${RESET}"
  return 0
}

# The notice for a harvest that held a login as another account's. Names who the
# server says it belongs to, the entry and how to save it. The newest such entry
# for this box is the one this harvest held or matched.
#
# $2 is the opening clause, so the caller says how the login got here. A session
# end and a `cleat login` are the two callers and neither sentence fits the
# other: the login verb has not ended a session, it has just signed someone in.
_account_held_notice() {
  local cname="$1" lead="${2:-This session ended on a login for another account}"
  local stamp id acct box reason who
  local f_id="" f_acct="" f_who=""
  while IFS="$(printf '\t')" read -r stamp id acct box reason who; do
    [[ -z "$f_id" && "$box" == "$cname" && "$reason" == "other-account" ]] || continue
    f_id="$id"
    f_acct="$acct"
    f_who="$who"
  done < <(_account_held_scan)
  if [[ -z "$f_id" ]]; then
    warn "${lead}. It was not saved."
    echo -e "    ${DIM}See it with ${BOLD}cleat account held${RESET}${DIM}.${RESET}"
    return 0
  fi
  if [[ "$f_acct" != "-" ]]; then
    warn "${lead}, so it was not saved to ${BOLD}$(_sessions_safe_str "$f_acct")${RESET}."
  else
    warn "${lead}. It was not saved."
  fi
  if [[ "$f_who" != "-" ]]; then
    echo -e "    ${DIM}Anthropic says it is $(_sessions_safe_str "$f_who"). It is held as ${BOLD}${f_id}${RESET}${DIM}.${RESET}"
  else
    echo -e "    ${DIM}It is held as ${BOLD}${f_id}${RESET}${DIM}.${RESET}"
  fi
  echo -e "    ${DIM}Save it with ${BOLD}cleat account adopt ${f_id} <name>${RESET}${DIM}.${RESET}"
  return 0
}

# Every held login, one `stamp<TAB>id<TAB>acct<TAB>box<TAB>reason<TAB>who` line
# each, newest first. An empty value is written as `-`, because a tab is IFS
# whitespace and `read` would fold two of them into one.
_account_held_scan() {
  local hdir d id acct box reason who
  hdir="$(_account_held_dir)" || return 0
  [[ -d "$hdir" ]] || return 0
  for d in "$hdir"/*; do
    id="${d##*/}"
    _account_held_entry "$id" >/dev/null || continue
    acct="$(_account_meta_get_at "$d" acct 2>/dev/null || true)"
    box="$(_account_meta_get_at "$d" box 2>/dev/null || true)"
    reason="$(_account_meta_get_at "$d" reason 2>/dev/null || true)"
    who="$(_account_meta_get_at "$d" who 2>/dev/null || true)"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${id%%-*}" "$id" \
      "${acct:--}" "${box:--}" "${reason:--}" "${who:--}"
  done | sort -t "$(printf '\t')" -k1,1rn -k2,2
  return 0
}

# How many. Fork-free like _account_trash_count: it runs once per list screen.
_account_held_count() {
  local hdir d n=0
  hdir="$(_account_held_dir)" || { printf '0'; return 0; }
  if [[ -d "$hdir" ]]; then
    for d in "$hdir"/*; do
      [[ -d "$d" && ! -L "$d" ]] || continue
      _account_held_id_ok "${d##*/}" || continue
      [[ -f "$d/.credentials.json" && ! -L "$d/.credentials.json" ]] || continue
      n=$(( n + 1 ))
    done
  fi
  printf '%s' "$n"
  return 0
}

# Is this exact file already held for this box with this reason?
_account_held_has() {
  local cname="$1" snap="$2" reason="$3" hdir d
  hdir="$(_account_held_dir)" || return 1
  [[ -d "$hdir" ]] || return 1
  for d in "$hdir"/*; do
    _account_held_entry "${d##*/}" >/dev/null || continue
    [[ "$(_account_meta_get_at "$d" box 2>/dev/null || true)" == "$cname" ]] || continue
    [[ "$(_account_meta_get_at "$d" reason 2>/dev/null || true)" == "$reason" ]] || continue
    cmp -s "$d/.credentials.json" "$snap" 2>/dev/null && return 0
  done
  return 1
}

# ── Staging into a box ──────────────────────────────────────────────────────

_account_box_auth_dir() { printf '%s' "$CLEAT_RUN_DIR/$1/auth"; }

# Sign a box's staged credential out of its account and nothing else: the
# account's keys go, the box's own members (the MCP server logins it signed into
# for itself) stay. The unpin, `cleat account rm` and `cleat account adopt` all
# end a box's use of a login this way, the same shape the switch to an account
# with no login writes. They used to delete the whole file, which signed the box
# out of every MCP server too. Whatever cannot be read once into a host-private
# copy (a link, a pipe, past the size cap), or cannot be written back, is
# removed outright as before: the account's login must not stay staged. A file
# left with nothing in it goes. Runs under the account lock.
_account_strip_staged() {
  local box_cred snap=""
  box_cred="$(_account_box_auth_dir "$1")/.credentials.json"
  if [[ -f "$box_cred" && ! -L "$box_cred" ]] && snap="$(_account_snapshot_cred "$box_cred")"; then
    if [[ "$(_account_cred_merge "$snap" "" 2>/dev/null || true)" != "{}" ]] \
       && _account_write_file_0600 "" "$box_cred" "$snap"; then
      rm -f "$snap" 2>/dev/null || true
      return 0
    fi
    rm -f "$snap" 2>/dev/null || true
  fi
  rm -f "$box_cred" 2>/dev/null || true
  return 0
}

# Every place that removes a box's run dir goes through here. The staged
# credential lives in that dir, and Claude Code refreshes it in place about
# every eight hours, so a wipe that does not harvest first throws away a token
# the account has no other copy of and lands the user back on /login.
#
# A harvest that declines is not "nothing to lose". Status 3 is a login the
# store does not have, which is held before the delete. Status 1 on a real
# login (a failed write of a newer token, or a store that is gone) keeps auth/
# for the next session end or a restore. Status 1 on junk deletes it, or the
# directory survived every `cleat clean`, which reported pruning it each time.
# Any other login in the directory is held first too, and a wipe that cannot
# keep one deletes nothing.
_account_wipe_run_dir() {
  local cname="$1" rc=0 pin keep_auth=0 snap src=0
  [[ -n "$cname" ]] || return 0
  # A box that was never pinned has no store to harvest into and takes no lock.
  # A login left in it (a staged file orphaned by a crash, or a journal) is
  # still held before the delete.
  pin="$(_box_account_file "$cname")"
  if [[ ! -e "$pin" && ! -L "$pin" ]]; then
    if ! _account_hold_run_extras "$cname"; then
      warn "Kept ${BOLD}${cname}${RESET}'s runtime dir: it holds a login that could not be saved anywhere else."
      return 0
    fi
    rm -rf "${CLEAT_RUN_DIR:?}/${cname}" 2>/dev/null || true
    return 0
  fi
  # Harvest and delete under one hold. A lock that cannot be had is a declined
  # harvest, so the staged file stays. Any other login in the directory is held
  # first, which needs no lock (exactly as for a box that is not pinned), and one
  # that cannot be kept keeps the whole directory.
  if ! _account_lock; then
    if [[ "${_ACCOUNT_LOCK_UNWRITABLE:-0}" -eq 1 ]]; then
      warn "Kept the staged login for ${BOLD}${cname}${RESET}: Cleat cannot write to the accounts directory."
      echo -e "    ${DIM}Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
    else
      warn "Kept the staged login for ${BOLD}${cname}${RESET}: another cleat command is changing accounts."
    fi
    _account_hold_run_extras "$cname" || return 0
    _account_wipe_keep_auth "$cname"
    return 0
  fi
  _account_sync_out_locked "$cname" || rc=$?
  case "$rc" in
    0|2) : ;;
    3)
      # A login the store does not have. Held, or the auth dir stays.
      _account_hold_staged_locked "$cname" || keep_auth=1
      ;;
    *)
      # Refused or failed. A real login stays in place for the next session end
      # to retry. Junk goes.
      snap="$(_account_keepable_snapshot "$(_account_box_auth_dir "$cname")/.credentials.json")" || src=$?
      if [[ $src -eq 0 ]]; then
        rm -f "$snap" 2>/dev/null || true
        keep_auth=1
      elif [[ $src -ne 1 ]]; then
        keep_auth=1
      fi
      ;;
  esac
  if ! _account_hold_run_extras "$cname"; then
    _account_unlock
    warn "Kept ${BOLD}${cname}${RESET}'s runtime dir: it holds a login that could not be saved anywhere else."
    return 0
  fi
  if [[ $keep_auth -eq 1 ]]; then
    # Wipe everything EXCEPT the auth directory, which is what the recreate
    # needs cleared, and leave that one file for the next attach to stage from
    # or the next session end to retry.
    _account_wipe_keep_auth "$cname"
    _account_unlock
    return 0
  fi
  rm -rf "${CLEAT_RUN_DIR:?}/${cname}" 2>/dev/null || true
  _account_unlock
  return 0
}

# Wipe a box's run dir except its auth directory.
_account_wipe_keep_auth() {
  local cname="$1" auth _e
  auth="$(_account_box_auth_dir "$cname")"
  for _e in "${CLEAT_RUN_DIR:?}/${cname}"/*; do
    [[ -e "$_e" ]] || continue
    [[ "$_e" == "$auth" ]] && continue
    rm -rf "$_e" 2>/dev/null || true
  done
  return 0
}

# Hold every OTHER login in a box's run dir before a wipe removes it. Returns 0
# when nothing is left that could not be kept, 1 when a copy failed.
#
# A wipe knew about one file, the staged credential of a pinned box. A staged
# file an unpinned box was left with, a temp file from an interrupted write and
# any rollback journal all went with the directory. The run dir root and auth/
# are both looked at, dotfiles included, because every name a journal is likely
# to get starts with a dot and a bare glob skips it. auth/ is the box's own
# read-write mount, so a link there can point at any host file: links and
# anything that is not a regular file are never read (_account_keepable_snapshot
# refuses them). A pinned box's staged file is the harvest's, and a copy of the
# pinned store's own login (same refresh token) is not worth a held entry.
#
# Every current caller runs after the container is gone, so no box process is
# racing these checks. Each copy is still decided on a snapshot.
_account_hold_run_extras() {
  local cname="$1" rd auth acct label owned srt="" f snap src rc=0
  [[ -n "$cname" ]] || return 0
  rd="$CLEAT_RUN_DIR/$cname"
  [[ -d "$rd" && ! -L "$rd" ]] || return 0
  auth="$rd/auth"
  owned="$auth/.credentials.json"
  acct="$(_box_account_read "$cname")"
  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    # No harvest ever looks at an unpinned box's staged file.
    label=""
    owned=""
  else
    label="$acct"
    srt="$(_account_cred_str "$(_account_cred_path "$acct")" refreshToken 2>/dev/null || true)"
  fi
  for f in "$rd"/* "$rd"/.[!.]* "$auth"/* "$auth"/.[!.]*; do
    # auth/ itself swapped for a link is never read through.
    [[ "${f%/*}" == "$auth" && -L "$auth" ]] && continue
    [[ -n "$owned" && "$f" == "$owned" ]] && continue
    # A link, a pipe, a directory or an unmatched pattern is refused there
    # without a read.
    src=0
    snap="$(_account_keepable_snapshot "$f")" || src=$?
    if [[ $src -eq 1 ]]; then continue; fi
    if [[ $src -ne 0 ]]; then rc=1; continue; fi
    if [[ -n "$srt" && "$(_account_cred_str "$snap" refreshToken 2>/dev/null || true)" == "$srt" ]]; then
      rm -f "$snap" 2>/dev/null || true
      continue
    fi
    _account_hold_box "$snap" "$label" "$cname" left-in-box || rc=1
    rm -f "$snap" 2>/dev/null || true
  done
  return "$rc"
}

# Hold a box's staged credential. Returns 0 when it is kept or holds nothing
# worth keeping, 1 when a login could not be kept.
_account_hold_staged_locked() {
  local cname="$1" acct reason=unsaved snap src=0 rc=0
  acct="$(_box_account_read "$cname")"
  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    acct=""
    reason=left-in-box
  fi
  snap="$(_account_keepable_snapshot "$(_account_box_auth_dir "$cname")/.credentials.json")" || src=$?
  if [[ $src -eq 1 ]]; then return 0; fi
  if [[ $src -ne 0 ]]; then return 1; fi
  _account_hold_box "$snap" "$acct" "$cname" "$reason" || rc=1
  rm -f "$snap" 2>/dev/null || true
  return "$rc"
}

# The one step before ANY delete or replace of a staged credential (both
# switches, remove, nuke). Harvest it, and hold whatever the harvest did not
# take: a login the store does not have (3), a refused or failed write of a
# real login (1), or a login staged in a box that is not pinned at all, which
# no harvest looks at. Returns 1 only when a real login could not be kept, and
# the caller then deletes nothing.
_account_release_staged_locked() {
  local cname="$1" rc=0
  if [[ "$(_box_account_read "$cname")" != "$_ACCOUNT_DEFAULT" ]]; then
    _account_sync_out_locked "$cname" || rc=$?
    case "$rc" in 0|2) return 0 ;; esac
  fi
  _account_hold_staged_locked "$cname"
}

# Refuse to remove a directory that IS, or that contains, the named-account
# store. Every state wipe in this file goes through it.
#
# `cmd_nuke` prints "your project files and ~/.claude auth are safe" and then
# removes four state directories. Today the accounts tree is merely a SIBLING
# of all four, so the promise holds by directory layout and by nothing else:
# there is no guard to break, which also means there is nothing a mutation can
# prove. One future edit that widens a wipe to $CLEAT_CONFIG_DIR, or that moves
# the store under one of the four, destroys weeks of refresh token while the
# message on screen says it did not. The failure is silent and unrecoverable,
# which is exactly the shape that earns a real check.
_account_store_is_under() {
  local dir="$1" d
  [[ -n "$dir" ]] || return 1
  # Trailing slashes normalised so "$CLEAT_CONFIG_DIR/" and "$CLEAT_CONFIG_DIR"
  # answer the same.
  dir="${dir%/}"
  for d in "$CLEAT_ACCOUNTS_DIR" "$CLEAT_BOX_ACCOUNTS_DIR"; do
    d="${d%/}"
    [[ "$d" == "$dir" ]] && return 0
    [[ "$d" == "$dir"/* ]] && return 0
  done
  return 1
}

_nuke_wipe_dir() {
  local dir="$1"
  [[ -n "$dir" ]] || return 0
  [[ -d "$dir" ]] || return 0
  if _account_store_is_under "$dir"; then
    warn "Refusing to remove ${BOLD}${dir}${RESET}: your named Claude logins live in there."
    echo -e "    ${DIM}Nothing was removed from it. Remove one with ${BOLD}cleat account rm <name>${RESET}${DIM}.${RESET}"
    return 1
  fi
  rm -rf "$dir" 2>/dev/null || true
  return 0
}

# The same, for nuke, which takes the whole run directory. Every pinned box is
# released and every run dir's other logins are held. Returns 1 when a login
# could not be kept and _ACCOUNT_LOCK_BUSY when the lock cannot be had, and the
# caller keeps the dirs on either. With nothing pinned there is no store to
# harvest into, so like an unpinned wipe it takes no lock.
_account_release_all() {
  [[ -d "$CLEAT_BOX_ACCOUNTS_DIR" ]] || { _account_hold_all_run_extras; return $?; }
  _account_with_lock _account_release_all_locked
}

_account_release_all_locked() {
  local f base rc=0
  for f in "$CLEAT_BOX_ACCOUNTS_DIR"/*; do
    [[ -f "$f" ]] || continue
    base="${f##*/}"
    _account_release_staged_locked "$base" || rc=1
  done
  _account_hold_all_run_extras || rc=1
  return "$rc"
}

# Not only the pinned boxes: an unpinned box's run dir can hold a login too.
_account_hold_all_run_extras() {
  local d rc=0
  [[ -d "$CLEAT_RUN_DIR" && ! -L "$CLEAT_RUN_DIR" ]] || return 0
  for d in "$CLEAT_RUN_DIR"/*; do
    [[ -d "$d" && ! -L "$d" ]] || continue
    _account_hold_run_extras "${d##*/}" || rc=1
  done
  return "$rc"
}

# Stage the pinned account's login into the box's own auth directory, by key:
# the account's keys (_ACCOUNT_SCOPED_KEYS) are replaced and everything else the
# box signed into for itself (an MCP server, a plugin secret) stays. An account
# with no login stages nothing at an attach, so the box keeps whatever it holds,
# which may be a /login made inside the box that no session end has harvested
# yet. A pin to a store that is gone stages nothing and touches nothing.
#
# Copy, never symlink, and never a bind of the file itself: a bind-mounted FILE
# breaks the moment the host replaces it by rename, which is how every safe
# write in this CLI is done.
#
# An unpinned box is decided without the lock because nothing is touched. A pin
# that appears a moment later is a switch that simply came after this attach,
# and that switch stages for itself.
#
# `force` is the switch. The incoming account always wins, whatever the staged
# expiry says, because newest-wins is only valid WITHIN one account. Across a
# switch the staged file belongs to the account being LEFT and is usually the
# fresher of the two (the box refreshed it minutes ago, the account being
# switched to has been parked for hours). Declining would leave the old login
# under the new pin, and the next detach would harvest it INTO the new account's
# store. The switch has already harvested or held that login under the same hold
# of the lock. Only the account's keys are replaced, with one rename in the auth
# directory. Nothing is ever removed first: a removal before the rename left the
# box with no credential file for about 25 ms, and a Claude the live gate missed
# answered "Not logged in" into that moment.
#
# _ACCOUNT_STAGE_UNKEPT is set to 1 when the staging stopped because the login
# it would have replaced could not be kept, so the attach can say so.
_ACCOUNT_STAGE_UNKEPT=0
_account_sync_in() {
  _ACCOUNT_STAGE_UNKEPT=0
  [[ "$(_box_account_read "$1")" != "$_ACCOUNT_DEFAULT" ]] || return 0
  _account_with_lock _account_sync_in_locked "$1"
}

_account_sync_in_locked() {
  local cname="$1" mode="${2:-}" acct dir store_cred box_cred be se snap="" bobj sobj rc=0
  _ACCOUNT_STAGE_UNKEPT=0
  # Read again under the lock. The pin read before it may already be stale.
  acct="$(_box_account_read "$cname")"
  [[ "$acct" != "$_ACCOUNT_DEFAULT" ]] || return 0
  # A store that is gone (removed by hand, or trashed or renamed away while this
  # pin was read) is not something to stage from, and a symlink is not a store.
  # The staged login stays untouched, and `cleat account restore` reconnects it.
  _account_exists "$acct" || return 0
  dir="$(_account_box_auth_dir "$cname")"
  [[ -L "$dir" ]] && return 1
  mkdir -p "$dir" 2>/dev/null || return 1
  chmod 700 "$dir" 2>/dev/null || true
  store_cred="$(_account_cred_path "$acct")"
  box_cred="${dir}/.credentials.json"
  sobj="$(_account_cred_login "$store_cred")"
  if [[ -z "$sobj" && "$mode" != force ]]; then
    # Never delete here. With no login in the store, a staged file is the ONLY
    # copy of a login made inside this box that nothing has harvested yet: a
    # second terminal attached, or a login that arrived between two harvests.
    # Removing it lost the login and signed out the Claude still running on it
    # ("Not logged in"). Harvest it through
    # the one gated path instead, and stage nothing back: the bytes are already
    # in place, and a rewrite would replace the file under a live session.
    if [[ -f "$box_cred" ]]; then
      _account_sync_out_locked "$cname" || true
    fi
    return 0
  fi
  # The box's file is read once, into a host-private copy. The staged expiry,
  # the hold and the box's own keys that the merge keeps all come from that copy.
  # An attach does not overwrite blind what it cannot copy (a symlink, a pipe, a
  # directory, past the size cap). A switch replaces it: a link or a pipe the box
  # planted is not a login and the writer refuses to rename over a link, so it is
  # removed first. Claude opens its store without following links, so a link
  # already read as signed out and removing it opens no gap. Anything else is
  # renamed over with nothing of it kept, which past the size cap includes the
  # box's own MCP logins.
  if [[ -e "$box_cred" || -L "$box_cred" ]]; then
    if ! snap="$(_account_snapshot_cred "$box_cred")"; then
      snap=""
      [[ "$mode" == force ]] || return 1
      if [[ -L "$box_cred" || ( -e "$box_cred" && ! -f "$box_cred" && ! -d "$box_cred" ) ]]; then
        rm -f "$box_cred" 2>/dev/null || true
      fi
    fi
  fi
  if [[ -z "$sobj" ]]; then
    # A switch to an account with no login signs the box out of the account it
    # leaves and of nothing else. A file left with nothing in it goes.
    if [[ "$(_account_cred_merge "$snap" "" 2>/dev/null || true)" != "{}" ]]; then
      _account_write_file_0600 "" "$box_cred" "$snap" || rc=1
    else
      rm -f "$box_cred" 2>/dev/null || true
    fi
    [[ -z "$snap" ]] || rm -f "$snap" 2>/dev/null || true
    return "$rc"
  fi
  if [[ -n "$snap" && "$mode" != force ]]; then
    # Newest wins, keyed on expiresAt rather than mtime: every refresh pushes it
    # about eight hours forward, and it survives a clock or filesystem-timestamp
    # oddity in a way mtime does not. Same comparison _seed_macos_credentials
    # makes for the same reason. An equal expiry stages only a different login.
    # The same login already in place is left alone, because a rewrite moves
    # the file under any session running in the box and gains nothing.
    bobj="$(_account_cred_login "$snap")"
    be="$(_json_flat_num "$bobj" expiresAt 2>/dev/null || true)"
    se="$(_json_flat_num "$sobj" expiresAt 2>/dev/null || true)"
    case "$be" in ''|*[!0-9]*) be=0 ;; esac
    case "$se" in ''|*[!0-9]*) se=0 ;; esac
    # Identity first, expiry second. "Newest wins" alone handed a pinned box to
    # a stranger: a /login made inside the box as someone else refreshes to an
    # expiry hours past whatever the store holds, so the attach kept it, printed
    # that the pin had taken and the session ran, and billed, as the other
    # account. The harvest has always refused that login on the way OUT. It is
    # the same question on the way IN, so it is the same answer that decides.
    # Found on a real Mac, 2026-09-19.
    local _held_by_harvest=0 _hrc=0
    if [[ "$se" -gt "$be" ]] || { [[ "$se" -eq "$be" ]] && [[ "$bobj" != "$sobj" ]]; }; then
      : # The store is ahead. Hold what the box has, below, then stage.
    elif _account_staged_absorbed "$snap" "$store_cred"; then
      # The store's own grant, refreshed in the box. Nothing to decide, and a
      # rewrite would move the file under a session already reading it.
      rm -f "$snap" 2>/dev/null
      return 0
    else
      # Newer, but not provably this account's. The gated harvest asks the
      # server whose it is: 0 writes it (this account refreshed it, and the
      # store is now current), 2 holds a stranger's, 3 cannot say right now.
      _account_harvest_from "$acct" "$cname" "$snap" || _hrc=$?
      if [[ $_hrc -eq 0 ]]; then
        rm -f "$snap" 2>/dev/null
        return 0
      fi
      [[ $_hrc -eq 2 ]] && _held_by_harvest=1
      # 2 and 3 both stage the account's own login over it: the pin is what the
      # user asked for, and a login the server would not vouch for is not it.
      sobj="$(_account_cred_login "$store_cred")"
      [[ -n "$sobj" ]] || { rm -f "$snap" 2>/dev/null; return 0; }
    fi
    # Not newer is not the same login. A /login made in the box as someone else,
    # while a sibling box on this account saved a fresher refresh, is overwritten
    # here, so it is held first. Nothing is staged over a login that could not be
    # kept, and the box starts on what it has. A generation of this account's own
    # grant that the store has moved past is only this box falling behind a
    # sibling on the same account, so it is staged over without a word.
    if [[ $_held_by_harvest -eq 0 ]] && _account_cred_keepable "$snap" \
       && ! _account_staged_absorbed "$snap" "$store_cred" \
       && ! _account_staged_superseded "$acct" "$snap"; then
      if ! _account_hold_box "$snap" "$acct" "$cname" unsaved; then
        rm -f "$snap" 2>/dev/null || true
        _ACCOUNT_STAGE_UNKEPT=1
        return 1
      fi
    fi
  fi
  # The box is about to run as a different login than the one it last had, so
  # the identity Claude cached in this box's claude.json (oauthAccount, and the
  # organisation it sends with it) is the wrong account's now. A switch flags
  # that for the launch to drop. An attach moved only the credential, so Claude
  # kept showing the old name: on a real Mac (2026-09-20) /status named the
  # account whose login had just been held while the box ran on the pinned one.
  [[ "$(_account_cred_login "$snap")" == "$sobj" ]] || _ACCOUNT_STAGED_NEW_LOGIN=1
  _account_write_file_0600 "$store_cred" "$box_cred" "$snap" || rc=1
  [[ -z "$snap" ]] || rm -f "$snap" 2>/dev/null || true
  return "$rc"
}

# Harvest a token the box refreshed for itself back into the store. Without
# this every refresh after a switch is lost and the account is back at /login,
# which is the exact pain this feature removes. Runs at session end, at the top
# of every `cleat account`, BEFORE anything wipes the run directory, and at an
# attach while the account store is still empty (see _account_sync_in).
#
# Returns 0 harvested, nothing staged or the store already holds this login.
# 1 refused or failed: the staged file is left. 3 unsaved: a login the store
# does not hold and this harvest will not write. A caller that deletes or
# replaces the staged file goes through _account_release_staged_locked, which
# holds it. _ACCOUNT_LOCK_BUSY comes from the wrapper when the lock cannot be
# had. (2, held as another account's login, is reserved for the identity check.)
_account_sync_out() {
  [[ "$(_box_account_read "$1")" != "$_ACCOUNT_DEFAULT" ]] || return 0
  _account_with_lock _account_sync_out_locked "$1"
}

_account_sync_out_locked() {
  local cname="$1" acct box_cred snap rc=0
  acct="$(_box_account_read "$cname")"
  [[ "$acct" != "$_ACCOUNT_DEFAULT" ]] || return 0
  box_cred="$(_account_box_auth_dir "$cname")/.credentials.json"
  [[ -f "$box_cred" ]] || return 0
  [[ -L "$box_cred" ]] && return 1
  # A pin to a store that is gone declines and never creates one. The staged
  # file stays for `cleat account restore` to reconnect.
  _account_exists "$acct" || return 1
  snap="$(_account_snapshot_cred "$box_cred")" || return 1
  _account_harvest_from "$acct" "$cname" "$snap" || rc=$?
  rm -f "$snap" 2>/dev/null || true
  return "$rc"
}

# Every harvest decision, made on a host-private snapshot of the staged file
# (see _account_snapshot_cred), never on the box's path. CNAME is the box it
# came from. Statuses are _account_sync_out's.
#
# "Newer" only says the file was refreshed. It does not say whose login it is.
# Neither the credential nor the store names an account. The staged file sits in
# a directory the box writes: a /login as someone else inside a pinned box, or a
# switch that raced an attach, leaves another account's login there. Harvesting
# on "newer" alone wrote that login over the account's only credential, with no
# trash. The list kept the old name while usage went out on the other bearer.
# The next switch relabelled the account. So a newer login is written only when
# it is provably the same account:
#   1. the same refresh token as the store (the same grant, no request), or
#   2. GET /api/oauth/profile names the account uuid recorded for this store, or
#   3. no uuid is recorded yet (the first verified harvest) and the email the
#      server gives is not a different one than the account already shows. The
#      login it replaces is held first (replaced-by-harvest), because nothing
#      ever proved whose that one was either.
# A login proven to be another account's is held (2) and never written. One the
# server cannot vouch for right now (offline, expired, revoked, an answer this
# reader does not know) is left where it is (3). The identity check never
# refreshes a token, so the usage rule that a parked token is never refreshed
# still holds. A 401 reads as "cannot tell", never as "someone else".
_account_harvest_from() {
  local acct="$1" cname="$2" snap="$3" store_cred be se now_ms
  local ident uuid who org rec known
  store_cred="$(_account_cred_path "$acct")"
  # The source of this file is a directory the box mounts read-write. A blob
  # with no tokens in it has nothing to harvest and nothing to keep.
  _account_cred_plausible "$snap" || return 1
  be="$(_account_cred_expiry "$snap")"
  se="$(_account_cred_expiry "$store_cred")"
  # Not newer. Nothing to do only when the store holds this same login. Any
  # other login (a /login as someone else behind a sibling's fresher refresh,
  # or a refresh misread as older) is unsaved, and a deleter must keep it.
  if [[ "$be" -le "$se" ]]; then
    _account_staged_absorbed "$snap" "$store_cred" && return 0
    # A generation this account has already moved past is not a login it does
    # not have. There is nothing to write and nothing for a deleter to keep.
    _account_staged_superseded "$acct" "$snap" && return 0
    return 3
  fi
  # "Newer" is not enough to earn an overwrite of the host's only copy. An
  # expiry further out than any real access token is refused.
  now_ms=$(( ${_CLEAT_NOW_S:-$(date +%s)} * 1000 ))
  [[ "$be" -le $(( now_ms + 7776000000 )) ]] || return 1
  # The same grant refreshed. Both refresh tokens are the Claude login's own
  # (claudeAiOauth), never an MCP server's entry the two files share.
  if _account_staged_absorbed "$snap" "$store_cred"; then
    _account_write_cred "$acct" "$snap" || return 1
    return 0
  fi
  # Bytes already proven to be another account's are not asked about again.
  _account_held_has "$cname" "$snap" other-account && return 2
  ident="$(_account_cred_identity "$snap")" || return 3
  IFS="$(printf '\t')" read -r uuid who org <<< "$ident"
  [[ -n "$uuid" && -n "$who" ]] || return 3
  rec="$(_account_meta_get "$acct" uuid 2>/dev/null || true)"
  if [[ -n "$rec" ]]; then
    if [[ "$uuid" != "$rec" ]]; then
      _account_hold "$snap" "$acct" "$cname" other-account "$uuid" "$who" "$org" || return 1
      return 2
    fi
  else
    # Trust on first use, but not over a name the account already shows. The
    # recorded email may predate this check. A stranger's login is exactly what
    # a first harvest must not adopt.
    known="$(_account_meta_get "$acct" who 2>/dev/null || true)"
    if [[ -n "$known" ]] && ! _account_same_email "$known" "$who"; then
      _account_hold "$snap" "$acct" "$cname" other-account "$uuid" "$who" "$org" || return 1
      return 2
    fi
    # Nor is the login it writes over proven to be anyone's. A store with no
    # uuid (saved before this check, adopted from an entry nobody verified, or
    # one whose first recording failed) has only ever been taken on trust, and
    # the email the account shows may be missing or itself unverified. Without
    # a uuid there is nothing to hold a stranger's login against. So the store's
    # own login is held first, and nothing is written when it cannot be kept.
    # Once the uuid is recorded below, this branch is never reached again.
    if _account_cred_keepable "$store_cred"; then
      _account_hold "$store_cred" "$acct" "" replaced-by-harvest "" "$known" \
        "$(_account_meta_get "$acct" org 2>/dev/null || true)" || return 1
    fi
  fi
  _account_write_cred "$acct" "$snap" || return 1
  # The server's answer for the login just written is the only source of who
  # the account is. An organisation it did not give is cleared, never kept from
  # an older record.
  _account_meta_set "$acct" uuid "$uuid" || true
  _account_meta_set "$acct" who "$who" || true
  _account_meta_set "$acct" org "$org" || true
  return 0
}

# Case-insensitive email comparison without ${v,,}, which bash 3.2 lacks.
_account_same_email() {
  local a b
  a="$(printf '%s' "$1" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')"
  b="$(printf '%s' "$2" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')"
  [[ "$a" == "$b" ]]
}

# ── Whose login is this ─────────────────────────────────────────────────────
#
# GET /api/oauth/profile with the login's own access token answers with the
# account it belongs to. It is the request Claude Code makes after /login. The
# shape read here is Claude's own check of the answer: account.uuid and
# account.email strings, organization.uuid. Nothing on disk can answer this. The
# credential blob names no account. claude.json's oauthAccount is written by the
# box.
_ACCOUNT_PROFILE_URL="https://api.anthropic.com/api/oauth/profile"

# The request, with the status code on the last line. max-time is 3, the usage
# poll's bound, chosen for the same reason: this one runs at a session end, so
# every second of it is a second the user waits after Claude has already gone,
# and it holds the account lock while it waits.
_account_profile_curl() {
  local tok="$1"
  printf 'silent\nmax-time = 3\nheader = "Authorization: Bearer %s"\nurl = "%s"\nwrite-out = "\\n%%{http_code}"\n' \
    "$tok" "$_ACCOUNT_PROFILE_URL" | _account_curl | LC_ALL=C tr -d '\000'
}

# uuid<TAB>email<TAB>org out of a profile body, or return 1.
#
# The flat reader on every host, never jq, so a host with jq and one without
# agree by construction. The account object must be flat and the only "account"
# key in the body. uuid and email must each appear once inside it. A key
# is only ever matched where a real key can be (a quote inside a string is
# always escaped), so a full_name crafted to contain "uuid" forges nothing. The
# uuid is held to a plain alphabet because it is compared and stored. The
# organisation object carries empty objects of its own (cc_onboarding_flags),
# which are folded to null first so the flat reader can isolate it. An
# organisation it still cannot read leaves org empty and costs nothing else.
_account_profile_parse() {
  local body="$1" acct orgobj uuid email org="" re='^[A-Za-z0-9-]{8,64}$'
  # Capped by expansion, not head -c: a head that stops reading SIGPIPEs the
  # printf. Under the CLI's pipefail that aborts the session end.
  body="$(printf '%s' "${body:0:$_ACCOUNT_CRED_MAX_BYTES}" | LC_ALL=C tr '\000\r\n' '   ')"
  acct="$(printf '%s' "$body" | _json_flat_object account)"
  [[ -n "$acct" ]] || return 1
  uuid="$(_json_flat_str "$acct" uuid)" || return 1
  [[ "$uuid" =~ $re ]] || return 1
  email="$(_json_flat_str "$acct" email)" || return 1
  email="$(_account_meta_clean "$email")"
  [[ -n "$email" ]] || return 1
  orgobj="$(printf '%s' "$body" | LC_ALL=C sed 's/:[[:space:]]*[{][[:space:]]*[}]/:null/g' | _json_flat_object organization)"
  if [[ -n "$orgobj" ]]; then
    org="$(_json_flat_str "$orgobj" name 2>/dev/null || true)"
    org="$(_account_meta_clean "$org")"
  fi
  printf '%s\t%s\t%s' "$uuid" "$email" "$org"
}

# Who the Claude login in FILE (host-private) belongs to: uuid<TAB>email<TAB>org
# and status 0, or status 3 when it cannot be told right now. No curl, an access
# token that is empty or unsafe in a curl config, one that has expired, any
# answer but 200 (offline 000, 401 expired or revoked, 403 no profile scope,
# 429, 5xx) and a body of a shape this reader does not know all read as 3. Only
# a token still alive on its own is sent, so nothing here ever refreshes one.
_account_cred_identity() {
  local f="$1" tok exp now_ms out code body nl=$'\n'
  command -v curl &>/dev/null || return 3
  tok="$(_account_cred_str "$f" accessToken 2>/dev/null)" || return 3
  _account_token_ok "$tok" || return 3
  exp="$(_account_cred_num "$f" expiresAt 2>/dev/null)" || return 3
  now_ms=$(( ${_CLEAT_NOW_S:-$(date +%s)} * 1000 ))
  [[ "$exp" -gt "$now_ms" ]] || return 3
  out="$(_account_profile_curl "$tok")"
  [[ "$out" == *"$nl"* ]] || return 3
  code="${out##*$nl}"
  [[ "$code" == "200" ]] || return 3
  body="${out%$nl*}"
  _account_profile_parse "$body" || return 3
}

# Does the store already hold the login in this snapshot? The same refresh
# token is the same grant: a refresh that did not rotate it changes nothing the
# store needs. An empty store token matches nothing.
_account_staged_absorbed() {
  local srt brt
  srt="$(_account_cred_str "$2" refreshToken 2>/dev/null || true)"
  brt="$(_account_cred_str "$1" refreshToken 2>/dev/null || true)"
  [[ -n "$srt" && "$brt" == "$srt" ]]
}

# ── Generations of one grant ────────────────────────────────────────────────
#
# Claude rotates the refresh token on nearly every refresh, so two boxes pinned
# to ONE account drift apart: box A refreshes, its harvest advances the store,
# and the file box B still has staged is an older generation of that same
# login. Holding it was wrong twice over. Every attach of the box that fell
# behind warned about "a login this account does not have", kept one more copy
# of a live refresh token (a copy nothing folded together, the dedupe needing a
# uuid the staged path never has) and offered to adopt it as a second account.
# So the store remembers the logins it has held, and a generation it has
# already moved past is replaced in silence. Anything it does not recognise is
# still held: another account's login is what that quarantine is for.
#
# Fingerprints, never tokens. meta is a host-only 0600 file, but a digest that
# cannot be spent is the right thing to keep in a file whose whole job is to be
# read. Fixed width and a fixed count, so the value stays well inside the clamp
# _account_meta_clean puts on it.
_ACCOUNT_SEEN_MAX=8
_ACCOUNT_SEEN_WIDTH=16

_account_rt_fingerprint() {
  local rt="$1" fp
  [[ -n "$rt" ]] || return 1
  fp="$(printf '%s' "$rt" | _md5 2>/dev/null || true)"
  # md5sum prints "<digest>  -", md5 -q prints the digest alone and the cksum
  # fallback a number. The first field is the digest in all three.
  set -- $fp
  fp="${1:-}"
  case "$fp" in ''|*[!0-9A-Fa-f]*) return 1 ;; esac
  printf '%s' "${fp:0:$_ACCOUNT_SEEN_WIDTH}"
}

_account_seen_has() {
  local cur
  [[ -n "$2" ]] || return 1
  cur=" $(_account_meta_get "$1" seen_rt 2>/dev/null || true) "
  case "$cur" in *" $2 "*) return 0 ;; esac
  return 1
}

# Remember one, newest first, oldest off the end.
_account_seen_add() {
  local acct="$1" fp="$2" cur out t n=1
  [[ -n "$fp" ]] || return 0
  cur="$(_account_meta_get "$acct" seen_rt 2>/dev/null || true)"
  out="$fp"
  # Walked with parameter expansion rather than word splitting, so nothing the
  # file holds is ever glob-expanded against the working directory.
  while [[ -n "$cur" && $n -lt $_ACCOUNT_SEEN_MAX ]]; do
    t="${cur%% *}"
    case "$cur" in *' '*) cur="${cur#* }" ;; *) cur="" ;; esac
    [[ -n "$t" && "$t" != "$fp" ]] || continue
    out="$out $t"
    n=$(( n + 1 ))
  done
  _account_meta_set "$acct" seen_rt "$out"
}

# Is the login in this snapshot a generation of the account's own grant that
# the store has already moved past?
_account_staged_superseded() {
  local fp
  fp="$(_account_rt_fingerprint "$(_account_cred_str "$2" refreshToken 2>/dev/null || true)" 2>/dev/null || true)"
  _account_seen_has "$1" "$fp"
}

# ── Account metadata ────────────────────────────────────────────────────────
#
# A flat `key<TAB>value` file, deliberately NOT JSON. Nothing but this CLI reads
# it, jq is optional everywhere in this file, and hand-rolled JSON escaping is
# the kind of thing that looks right and is not. The session-title whitelist
# exists for exactly that reason. Values are stripped of control bytes and
# clamped, so a line can only ever be one key and one value.
_account_meta_clean() {
  local v
  v="$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' || true)"
  printf '%s' "${v:0:160}"
}

# By DIRECTORY rather than by name, because a removed account's meta file is
# under `.trash/<stamp>-<name>/` and the trash view has to describe it there.
_account_meta_get_at() {
  local f="$1/meta" kk vv
  [[ -f "$f" ]] || return 1
  while IFS="$(printf '\t')" read -r kk vv; do
    [[ "$kk" == "$2" ]] || continue
    [[ -n "$vv" ]] || return 1
    printf '%s' "$vv"
    return 0
  done < "$f"
  return 1
}

_account_meta_get() {
  _account_meta_get_at "$CLEAT_ACCOUNTS_DIR/$1" "$2"
}

_account_meta_set() {
  local acct="$1" key="$2" val="$3" f tmp kk vv wrote=0
  # Never creates the store, for the reason _account_write_cred gives. The usage
  # poll records its numbers after a network wait of up to three seconds.
  _account_exists "$acct" || return 1
  f="$(_account_meta_path "$acct")"
  [[ -L "$f" ]] && return 1
  val="$(_account_meta_clean "$val")"
  tmp="${f}.tmp.$$"
  (
    umask 077
    if [[ -f "$f" ]]; then
      while IFS="$(printf '\t')" read -r kk vv; do
        [[ -n "$kk" ]] || continue
        if [[ "$kk" == "$key" ]]; then
          printf '%s\t%s\n' "$key" "$val"
          wrote=1
        else
          printf '%s\t%s\n' "$kk" "$vv"
        fi
      done < "$f"
    fi
    [[ $wrote -eq 1 ]] || printf '%s\t%s\n' "$key" "$val"
  ) > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  chmod 600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$f" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  return 0
}

# Record what the account's own credential says and when it was last used: the
# plan (claudeAiOauth.subscriptionType) and last_used. Nothing else.
#
# The email and the organisation are NOT read here. They used to come out of
# the box's per-project claude.json, which holds whichever identity Claude last
# ran as, in a file the box itself writes. A /login as someone else inside a
# pinned box, a box pinned and never started, or a switch that raced an attach
# stamped one account with another's email. The switch then printed it as fact.
# The only places `who`, `org` and `uuid` are written now are a harvest the
# server vouched for (_account_harvest_from) and an adopt of a held login.
_account_capture_meta() {
  local acct="$1" cred v now
  [[ "$acct" != "$_ACCOUNT_DEFAULT" ]] || return 0
  _account_exists "$acct" || return 0
  cred="$(_account_cred_path "$acct")"
  if [[ -s "$cred" ]]; then
    if v="$(_account_cred_str "$cred" subscriptionType)" && [[ -n "$v" ]]; then
      _account_meta_set "$acct" plan "$v" || true
    fi
  fi
  now="$(date +%s 2>/dev/null || echo 0)"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  _account_meta_set "$acct" last_used "$now" || true
  return 0
}

# ── What the row can honestly say about the credential ──────────────────────
#
# Three states and no guessing. `refreshTokenExpiresAt` is OPTIONAL in the blob
# (a 2026-05 credential on the maintainer's own machine has no such field), so
# its absence renders as "ok" rather than as an invented expiry. An account that
# hit invalid_grant writes EMPTY tokens back to disk, which is why a present
# file is not the same as a working account. Both fields are the Claude login's
# own. A live MCP server entry beside a blanked login still reads signed out.
_account_auth_state() {
  local acct="$1" cred rt now_ms rte
  cred="$(_account_cred_path "$acct")"
  if [[ ! -s "$cred" ]]; then
    printf 'signed out'
    return 0
  fi
  rt="$(_account_cred_str "$cred" refreshToken 2>/dev/null || true)"
  if [[ -z "$rt" ]]; then
    printf 'signed out'
    return 0
  fi
  now_ms=$(( ${_CLEAT_NOW_S:-$(date +%s)} * 1000 ))
  rte="$(_account_cred_num "$cred" refreshTokenExpiresAt)" || rte=0
  if [[ "$rte" -gt 0 ]] && [[ "$rte" -le "$now_ms" ]]; then
    printf 're-login'
    return 0
  fi
  printf 'ok'
}

# ── Usage, and the three things it must never do ────────────────────────────
#
# `GET /api/oauth/usage?skip_spend=1` answers with only a bearer header, with no
# claude process and no session, and it writes nothing. So a stored account's
# five-hour and seven-day utilisation IS obtainable. It degrades, though: an
# access token lives about eight hours, and the account parked because it hit
# its limit usually has a dead one by the time its reset time is interesting.
# So there are two tiers, live and snapshot, and the snapshot carries its own
# timestamp. resets_at is an absolute future instant, so it stays TRUE while the
# percentage goes stale.
#
# Three rules, each of which would be a real defect:
#
#   1. Never refresh a parked token to draw a bar. The refresh response MAY
#      carry a rotated refresh token, so polling for display could revoke a
#      credential the maintainer's Keychain still holds.
#   2. Never label claudeAiOauth.expiresAt as usage. It is the ~8 h OAuth token
#      lifetime, not the five-hour rate-limit window.
#   3. Never read another account's numbers out of ~/.claude.json. Its
#      cachedUsageUtilization is a SINGLE slot keyed to one accountUuid and
#      Claude Code deletes it on the first read under a different account.
#
# skip_spend=1 is not optional either: without it the response carries real
# billing figures, which have no business in a picker.
_ACCOUNT_USAGE_URL="https://api.anthropic.com/api/oauth/usage?skip_spend=1"

# Every request this file sends to Anthropic goes through here. The curl config,
# the bearer included, arrives on stdin, so a token never reaches argv and
# cannot appear in `ps` output on a shared host. A failed request prints nothing
# or a partial answer. Every caller reads that as "cannot tell".
_account_curl() { curl --config - 2>/dev/null || true; }

_account_usage_curl() {
  local tok="$1"
  printf 'silent\nshow-error\nmax-time = 3\nheader = "Authorization: Bearer %s"\nurl = "%s"\n' \
    "$tok" "$_ACCOUNT_USAGE_URL" | _account_curl
}

# The bearer for one account: claudeAiOauth.accessToken, never an MCP server's
# token from the same file. Only a token that is safe in a curl config.
_account_access_token() {
  local tok
  tok="$(_account_cred_str "$(_account_cred_path "$1")" accessToken)" || return 1
  _account_token_ok "$tok" || return 1
  printf '%s' "$tok"
}

# Refresh the stored snapshot for one account. Returns 1 and prints nothing
# whenever it declines, which is most of the time: no curl, no jq, no live
# token, or polled too recently.
_account_usage_fetch() {
  local acct="$1" now tok resp at exp
  command -v curl &>/dev/null || return 1
  command -v jq &>/dev/null || return 1
  now="${_CLEAT_NOW_S:-$(date +%s)}"
  case "$now" in ''|*[!0-9]*) return 1 ;; esac
  at="$(_account_meta_get "$acct" usage_at 2>/dev/null || true)"
  case "$at" in ''|*[!0-9]*) at=0 ;; esac
  [[ $(( now - at )) -ge $_ACCOUNT_USAGE_THROTTLE ]] || return 1
  # Rule 1: only ever poll with a token that is still alive on its own.
  exp="$(_account_cred_expiry "$(_account_cred_path "$acct")")"
  [[ "$exp" -gt $(( now * 1000 )) ]] || return 1
  tok="$(_account_access_token "$acct")" || return 1
  [[ -n "$tok" ]] || return 1
  resp="$(_account_usage_curl "$tok")"
  [[ -n "$resp" ]] || return 1
  printf '%s' "$resp" | jq -e 'type=="object" and has("five_hour")' >/dev/null 2>&1 || return 1
  local fu fr wu wr
  fu="$(printf '%s' "$resp" | jq -r '.five_hour.utilization // empty' 2>/dev/null || true)"
  fr="$(printf '%s' "$resp" | jq -r '.five_hour.resets_at // empty' 2>/dev/null || true)"
  wu="$(printf '%s' "$resp" | jq -r '.seven_day.utilization // empty' 2>/dev/null || true)"
  wr="$(printf '%s' "$resp" | jq -r '.seven_day.resets_at // empty' 2>/dev/null || true)"
  case "$fu" in ''|*[!0-9]*) fu="" ;; esac
  case "$wu" in ''|*[!0-9]*) wu="" ;; esac
  [[ -n "$fu" || -n "$wu" ]] || return 1
  _account_meta_set "$acct" usage_five "$fu" || true
  _account_meta_set "$acct" usage_week "$wu" || true
  _account_meta_set "$acct" usage_five_resets "$(_account_epoch_from_iso "$fr")" || true
  _account_meta_set "$acct" usage_week_resets "$(_account_epoch_from_iso "$wr")" || true
  _account_meta_set "$acct" usage_at "$now" || true
  return 0
}

# An ISO-8601 instant to epoch seconds, or 0. `date -d` is GNU and `date -j -f`
# is BSD, so both are tried and neither is trusted: the caller renders nothing
# rather than a wrong time when both fail.
_account_epoch_from_iso() {
  local s="$1" out=""
  [[ -n "$s" ]] || { printf '0'; return 0; }
  s="${s%%.*}"
  s="${s%Z}"
  s="${s%+00:00}"
  # BSD FIRST. On macOS `date -d` sets the daylight-saving flag rather than
  # parsing a date, so the GNU form can SUCCEED there and hand back the current
  # time, which would render a reset instant that has already passed as one
  # hours away. The BSD form is a no-op on GNU (it has no -j), so trying it
  # first is safe in the other direction.
  out="$(date -u -j -f '%Y-%m-%dT%H:%M:%S' "$s" +%s 2>/dev/null || true)"
  if [[ -z "$out" ]]; then
    out="$(date -u -d "${s}Z" +%s 2>/dev/null || true)"
  fi
  case "$out" in ''|*[!0-9]*) out=0 ;; esac
  printf '%s' "$out"
}

# One short line for the picker's detail pane. Live numbers when the snapshot is
# fresh, the snapshot with its age when it is not, and "window reset" once the
# reset instant has passed, because at that point the percentage is known to be
# wrong while the reset is known to be true.
_account_usage_render() {
  local acct="$1" now fu wu fr wr at out=""
  now="${_CLEAT_NOW_S:-$(date +%s)}"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  at="$(_account_meta_get "$acct" usage_at 2>/dev/null || true)"
  case "$at" in ''|*[!0-9]*) at=0 ;; esac
  [[ "$at" -gt 0 ]] || return 1
  fu="$(_account_meta_get "$acct" usage_five 2>/dev/null || true)"
  wu="$(_account_meta_get "$acct" usage_week 2>/dev/null || true)"
  fr="$(_account_meta_get "$acct" usage_five_resets 2>/dev/null || true)"
  wr="$(_account_meta_get "$acct" usage_week_resets 2>/dev/null || true)"
  case "$fr" in ''|*[!0-9]*) fr=0 ;; esac
  case "$wr" in ''|*[!0-9]*) wr=0 ;; esac
  if [[ -n "$fu" ]]; then
    if [[ "$fr" -gt 0 && "$fr" -le "$now" ]]; then
      out="5h window reset"
    else
      out="5h ${fu}%"
      if [[ "$fr" -gt 0 ]]; then
        local _c
        _c="$(_account_clock "$fr" 2>/dev/null || true)"
        [[ -n "$_c" ]] && out="${out} until ${_c}"
      fi
    fi
  fi
  if [[ -n "$wu" ]]; then
    local w
    if [[ "$wr" -gt 0 && "$wr" -le "$now" ]]; then
      w="7d window reset"
    else
      w="7d ${wu}%"
    fi
    if [[ -n "$out" ]]; then out="${out} · ${w}"; else out="$w"; fi
  fi
  [[ -n "$out" ]] || return 1
  # The age is part of the claim, not decoration: these numbers are a snapshot
  # unless they were taken this minute.
  # Plain text, no escapes: the caller stores this in a row array and clamps it
  # by length, and a stored escape sequence would be counted as characters.
  #
  # The staleness marker goes in FRONT as well as behind. The detail pane
  # clamps from the right, so a trailing "(as of 3h ago)" was the first thing
  # cut on a narrow terminal and an hours-old percentage was then shown as if
  # it were current. That is the one invented figure this feature must never
  # print, so the word that makes it a snapshot has to survive the clamp.
  if [[ $(( now - at )) -gt $_ACCOUNT_USAGE_THROTTLE ]]; then
    out="last known ${out} (as of $(_age_from_delta $(( now - at ))))"
  fi
  printf '%s' "$out"
}

# BSD `date -r <epoch>` and GNU `date -d @<epoch>`. GNU's -r takes a FILE, so
# on Linux the first form fails cleanly and the second answers; on macOS the
# first answers. Neither can silently return the wrong instant the way the
# ISO parser could.
_account_clock() {
  local e="$1" out
  out="$(date -r "$e" +%H:%M 2>/dev/null || true)"
  [[ -n "$out" ]] || out="$(date -d "@$e" +%H:%M 2>/dev/null || true)"
  case "$out" in ''|*[!0-9:]*) return 1 ;; esac
  printf '%s' "$out"
}

# ── Removing an account ─────────────────────────────────────────────────────
#
# Never an unlink. What is being removed is a refresh token with weeks of life
# in it, and the way it gets removed is a typo in a picker. Same trash shape as
# `cleat session`, same 30 days, same exit codes: 2 means the trash itself is
# unusable and nothing was touched, 1 means something was left in place, 0 means
# it moved.
_account_trash_dir() {
  local d="$CLEAT_ACCOUNTS_DIR/.trash"
  [[ -L "$d" ]] && return 1
  [[ -e "$d" ]] && [[ ! -d "$d" ]] && return 1
  printf '%s' "$d"
}

# Held logins go on the same clock. The id is the epoch it was held at.
_account_trash_sweep() {
  local tdir hdir now cutoff d base stamp
  now="$(date +%s 2>/dev/null || echo 0)"
  case "$now" in ''|*[!0-9]*|0) return 0 ;; esac
  cutoff=$(( now - _ACCOUNTS_TRASH_DAYS * 86400 ))
  tdir="$(_account_trash_dir)" || tdir=""
  if [[ -n "$tdir" && -d "$tdir" ]]; then
    for d in "$tdir"/*; do
      [[ -d "$d" ]] || continue
      [[ -L "$d" ]] && continue
      base="${d##*/}"
      stamp="${base%%-*}"
      case "$stamp" in ''|*[!0-9]*) continue ;; esac
      _validate_account_name "${base#*-}" || continue
      [[ "$stamp" -lt "$cutoff" ]] || continue
      rm -rf "$d"
    done
  fi
  hdir="$(_account_held_dir)" || hdir=""
  if [[ -n "$hdir" && -d "$hdir" ]]; then
    for d in "$hdir"/*; do
      [[ -d "$d" && ! -L "$d" ]] || continue
      base="${d##*/}"
      _account_held_id_ok "$base" || continue
      [[ "${base%%-*}" -lt "$cutoff" ]] || continue
      rm -rf "$d"
    done
  fi
  return 0
}

_account_trash() {
  local acct="$1" tdir dest now
  _account_exists "$acct" || return 1
  _account_dir_ok "$acct" || return 2
  tdir="$(_account_trash_dir)" || return 2
  mkdir -p "$tdir" 2>/dev/null || return 2
  chmod 700 "$tdir" 2>/dev/null || true
  now="$(date +%s 2>/dev/null || echo 0)"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  dest="${tdir}/${now}-${acct}"
  [[ -e "$dest" ]] && return 1
  mv "$CLEAT_ACCOUNTS_DIR/$acct" "$dest" 2>/dev/null || return 1
  return 0
}

_account_restore() { _account_with_lock _account_restore_locked "$@"; }

_account_restore_locked() {
  local acct="$1" tdir d base stamp found=""
  # A glob must never decide identity here. `"$tdir"/*-"$acct"` matched
  # `<stamp>-my-work` when restoring `work`, because a dash is legal inside an
  # account name, so restoring one account could resurrect a DIFFERENT one
  # under the wrong name and strand the real one in the trash forever. Split on
  # the stamp and compare the remainder exactly, the way the sweep does.
  _validate_account_name "$acct" || return 1
  tdir="$(_account_trash_dir)" || return 1
  [[ -d "$tdir" ]] || return 1
  for d in "$tdir"/*; do
    [[ -d "$d" ]] || continue
    [[ -L "$d" ]] && continue
    base="${d##*/}"
    stamp="${base%%-*}"
    case "$stamp" in ''|*[!0-9]*) continue ;; esac
    [[ "${base#*-}" == "$acct" ]] || continue
    found="$d"
  done
  [[ -n "$found" ]] || return 1
  # Refuse to overwrite an account that came back under the same name, the way
  # the session restore does.
  [[ -e "$CLEAT_ACCOUNTS_DIR/$acct" ]] && return 1
  mkdir -p "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || return 1
  chmod 700 "$CLEAT_ACCOUNTS_DIR" 2>/dev/null || true
  mv "$found" "$CLEAT_ACCOUNTS_DIR/$acct" 2>/dev/null || return 1
  return 0
}

# Every removed account, one `<stamp>\t<name>` line each. The same identity
# discipline as _account_restore, and for the same reason: a dash is legal
# inside an account name, so `*-work` also matches `<stamp>-my-work`. Split on
# the stamp and validate the remainder, never let a glob decide which directory
# is which account.
_account_trash_scan() {
  local tdir d base stamp name
  tdir="$(_account_trash_dir)" || return 0
  [[ -d "$tdir" ]] || return 0
  for d in "$tdir"/*; do
    [[ -d "$d" ]] || continue
    [[ -L "$d" ]] && continue
    base="${d##*/}"
    stamp="${base%%-*}"
    case "$stamp" in ''|*[!0-9]*) continue ;; esac
    name="${base#*-}"
    _validate_account_name "$name" || continue
    printf '%s\t%s\n' "$stamp" "$name"
  done
  return 0
}

# Most recently removed first, matching the live list's own order.
_account_trash_scan_sorted() {
  _account_trash_scan | sort -t "$(printf '\t')" -k1,1rn
}

# How many accounts are in the trash. Deliberately does NOT read a meta file:
# this runs once per list screen only to decide whether to advertise the trash,
# so it stays fork-free. Counts exactly what the scan would count.
_account_trash_count() {
  local tdir d base stamp n=0
  tdir="$(_account_trash_dir)" || { printf '0'; return 0; }
  if [[ -d "$tdir" ]]; then
    for d in "$tdir"/*; do
      [[ -d "$d" ]] || continue
      [[ -L "$d" ]] && continue
      base="${d##*/}"
      stamp="${base%%-*}"
      case "$stamp" in ''|*[!0-9]*) continue ;; esac
      _validate_account_name "${base#*-}" || continue
      n=$(( n + 1 ))
    done
  fi
  printf '%s' "$n"
  return 0
}

# Rename is a directory move plus a pin rewrite. The pins have to follow, or
# every box pinned to the old name silently falls back to the shared store at
# its next attach, which reads as "cleat logged me out". The move and the pin
# rewrite are one hold of the account lock, or an attach that read the old pin
# between them found no store and deleted the staged login.
_account_rename() { _account_with_lock _account_rename_locked "$@"; }

_account_rename_locked() {
  local old="$1" new="$2" b
  _account_exists "$old" || return 1
  _account_dir_ok "$old" || return 1
  _account_dir_ok "$new" || return 1
  [[ -e "$CLEAT_ACCOUNTS_DIR/$new" ]] && return 1
  mv "$CLEAT_ACCOUNTS_DIR/$old" "$CLEAT_ACCOUNTS_DIR/$new" 2>/dev/null || return 1
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    # The key rides along, or a renamed account could no longer be removed
    # cleanly: the remove finds each box's claude.json through it.
    _box_account_write "$b" "$new" "$(_box_account_key "$b" || true)" || true
  done < <(_account_pinned_boxes "$old")
  return 0
}

# ── The actions ─────────────────────────────────────────────────────────────
# Reached from the picker AND from the command line, so they live here rather
# than inside a TUI function: a gate that only exists on the interactive path is
# not a gate.

# Is this box able to carry a pinned account at all? A box created before this
# feature has no auth mount, and without this check `/login` would create the
# credential store inside the container's own filesystem, where `cleat rm`
# destroys it with no warning.
#
# Returns 0 ready, 1 needs a recreate, 2 could not tell (no container, or no
# daemon). Two is not a failure: the mount is created by the next `docker run`,
# so a box that does not exist yet is fine.
# The launch summary's auth line. "shared" is the truth for a box on ~/.claude
# and a lie for a pinned one, which reads a store of its own, and the line sits
# directly above the summary block that names the account, so the two
# contradicted each other. Printed as DATA (%s), like the Kit and Account rows,
# because the pin file is hand-editable.
_print_auth_line() {
  local acct
  # The account IN EFFECT, not the pin. A box that predates the account mount
  # keeps its pin but runs on the shared login (the exec warns so), and reading
  # the pin here printed a green "Auth from account" for a login it was not on.
  acct="$(_account_effective "${1:-}" 2>/dev/null)" || acct="$_ACCOUNT_DEFAULT"
  if [[ -n "${1:-}" && "$acct" != "$_ACCOUNT_DEFAULT" ]]; then
    printf '  %b✔%b Auth from account %b%s%b\n' "$GREEN" "$RESET" "$BLUE" "$acct" "$RESET"
  else
    success "Auth shared"
  fi
  return 0
}

# True when a Claude Code process is running inside the box right now. The same
# three terms as the switch's live gate (the note there says why each one is
# needed), kept in one place for the checks that have to run at write time.
# An unreadable `docker top` on a running box counts as live.
#
# This is the one probe seam: when the per-session pid file lands, only this
# function changes.
_box_claude_live() {
  _daemon_up && container_exists "$1" && is_running "$1" && _box_has_live_agent "$1"
}

# Drop the identity block from the box's per-project ~/.claude.json the moment
# the pin moves.
#
# Claude Code shows the account email from `oauthAccount` in that file and from
# nowhere else: the credential blob carries no identity at all and the access
# token is opaque, so disk is the only source. A COMPLETE oauthAccount also
# freezes it, because `profileFetchedAt` lives INSIDE that object and the
# refetch only runs when the key is absent.
#
# The file is rebuilt on create and on a stopped-box start, and that is not
# enough. A RUNNING box is never rebuilt (the bind pins the inode, which is why
# _refresh_project_claude_json refuses to touch one) and the attached heal
# returns early whenever hasCompletedOnboarding is true, which the builder
# always sets. So without this a switch left the previous account name on
# screen while the requests went to the new one.
#
# Written IN PLACE through _write_in_place, never temp-and-mv: an atomic rename
# swaps the inode out from under a running container. Same writer the attached
# heal uses. Returns 3, having written nothing, when a Claude is running in the
# box: see _account_invalidate_identity_key.
_account_invalidate_identity() {
  local project="$1" box="$2" cname="${3:-}" key
  [[ -n "$project" ]] || return 0
  key="$(_derive_project_session_key "$project" "$box")" || return 0
  [[ -n "$cname" ]] || cname="$(container_name_for "$project" "$box")"
  _account_invalidate_identity_key "$key" "$cname"
}

# The same, for a caller that knows the box only by the key recorded with its
# pin (_box_account_key). `cleat account rm` unpins boxes in other projects and
# has no project path for any of them. Split out rather than duplicated, so
# every unpin reaches the file through one edit.
#
# Returns 3, having written nothing, when a Claude is running in the box. The
# check is here rather than only at the top of the switch because a usage poll
# with a three second timeout sits between the two. Deleting oauthAccount under
# a running Claude Code makes it refuse every later save of that file (its
# cache still holds the account while each re-read does not), so the edit waits
# and the caller says what to run.
_account_invalidate_identity_key() {
  local key="$1" cname="${2:-}" f
  _account_session_key_ok "$key" || return 0
  f="$CLEAT_PROJECTS_DIR/${key}/claude.json"
  if [[ -n "$cname" ]] && _box_claude_live "$cname"; then
    return 3
  fi
  # A host with no jq borrows the box's, which needs the box running. When it
  # is not, the file is flagged and the next launch clears it before Claude
  # reads it (_claude_json_clear_stale_identity). A host with jq never flags.
  if ! _claude_json_drop_identity "$f" "$cname"; then
    : > "${f}.identity-stale" 2>/dev/null || true
  else
    # The drop finished, so an H9 flag a switch wrote before the pin moved has
    # done its job. Clear it, or the next launch would rebuild identity again for
    # no reason. A deferred drop (the branch above) keeps the flag for that retry.
    rm -f "${f}.identity-stale" 2>/dev/null || true
  fi
  return 0
}

# Delete the identity keys from one per-project claude.json, in place.
#
# The host's jq when the host has one. When it does not, the BOX's own jq does
# the transform: the image ships it, and here it is a pure stdin-to-stdout
# filter, so the host still makes the only write and keeps the symlink refusal.
# What comes back is trusted no further than what the box could already write
# into its own mounted file, and it is written only while it still looks like a
# JSON object.
#
# Returns 0 when the file carries no identity afterwards, or never carried one.
# Returns 1 when it could not be removed: no jq on the host and no running box
# to borrow one from, or a filter that failed. The caller flags the file and
# the next launch finishes the job (_claude_json_clear_stale_identity).
_claude_json_drop_identity() {
  local f="$1" cname="${2:-}" tmp rc=0
  local prog='del(.oauthAccount) | del(.cachedUsageUtilization)'
  [[ -f "$f" && -s "$f" ]] || return 0
  [[ -L "$f" ]] && return 0
  tmp="${f}.acct.$$"
  if command -v jq &>/dev/null; then
    if ! { jq "$prog" "$f" > "$tmp" 2>/dev/null \
           && [[ -s "$tmp" ]] && jq -e 'type=="object"' "$tmp" >/dev/null 2>&1; }; then
      rm -f "$tmp" 2>/dev/null
      return 1
    fi
  else
    # Nothing to delete is an answer, and a cheap one: a jq-less host whose
    # file is already clean asks the box nothing and leaves no flag behind.
    grep -qE '"(oauthAccount|cachedUsageUtilization)"' "$f" 2>/dev/null || return 0
    { [[ -n "$cname" ]] && _daemon_up && is_running "$cname"; } || return 1
    if ! { docker exec -i "$cname" jq "$prog" < "$f" > "$tmp" 2>/dev/null \
           && _looks_like_json_object "$tmp"; }; then
      rm -f "$tmp" 2>/dev/null
      return 1
    fi
  fi
  _write_in_place "$tmp" "$f" || rc=1
  rm -f "$tmp" 2>/dev/null
  return $rc
}

# The launch half of an identity change the host could not finish by itself:
# no jq on the host, and no running box to borrow one from at the time. The
# flag is written by _account_invalidate_identity_key and by the no-jq branch
# of the builder. It sits next to the file on the HOST only, because the box
# mounts the file and never its directory, and `cleat nuke` takes it with the
# projects dir. It needs no lock: the write is idempotent and the clear is
# re-checked before every launch.
#
# Never edits under a live agent. A config write racing the in-place copy puts
# the old name straight back, and a delete under a running Claude Code makes it
# refuse its own later saves of that file. The next launch tries again.
_claude_json_clear_stale_identity() {
  local cname="$1" f="$2" box="${3:-main}"
  [[ -e "${f}.identity-stale" ]] || return 0
  if ! _box_has_live_agent "$cname" && _claude_json_drop_identity "$f" "$cname"; then
    rm -f "${f}.identity-stale" 2>/dev/null || true
    return 0
  fi
  warn "${BOLD}${box}${RESET} still carries another account's name."
  echo -e "    ${DIM}Claude may show it and send that account's organisation until it is cleared.${RESET}"
  if command -v jq &>/dev/null; then
    echo -e "    ${DIM}Cleat tries again before the next launch.${RESET}"
  else
    echo -e "    ${DIM}Cleat tries again before the next launch. Installing jq on the host avoids this.${RESET}"
  fi
  return 0
}

# The pin AS THE BOX WILL ACTUALLY SEE IT. Returns the account name only when
# the box can really use it, and the sentinel when it cannot.
#
# A box created before the auth mount keeps its pin (it has to outlive the
# `cleat rm` that fixes it), and the attach path falls back to the shared
# login. So anything that REPORTS the account has to ask the same question the
# attach does, or it says the box is on an account it is not using: `cleat
# status` claimed "logged in (account work2)" for a box running on the shared
# login, and the launch summary printed an Account row three lines above the
# warning that the box cannot use it.
#
# Exit 2 from the probe is "cannot tell" (no daemon, no container yet), and
# that is NOT a failure: a box that does not exist yet gets the mount from the
# next `docker run`. Only a definite "this container has no mount" demotes.
_account_effective() {
  local cname="$1" acct ready=0
  acct="$(_box_account_read "$cname")"
  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    printf '%s' "$_ACCOUNT_DEFAULT"
    return 0
  fi
  _account_box_ready "$cname" || ready=$?
  if [[ $ready -eq 1 ]]; then
    printf '%s' "$_ACCOUNT_DEFAULT"
    return 1
  fi
  printf '%s' "$acct"
  return 0
}

_account_box_ready() {
  local cname="$1"
  _daemon_up || return 2
  container_exists "$cname" || return 2
  # `docker inspect`, not `docker exec`. exec needs a RUNNING container, so a
  # merely stopped box answered "no mount" and every switch against one was
  # refused with a recreate instruction it did not need. inspect reads the
  # container's own mount table and works stopped. Same shape as
  # _container_has_kit_mounts.
  docker inspect "$cname" --format '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null \
    | grep -qx "$_ACCOUNT_BOX_DIR" || return 1
  return 0
}

# The per-exec half of the feature, shared by every path that runs `claude`
# inside a box. Appends to CLAUDE_ENV, which is a plain `-e` array, so this is
# recreate-free and applies per `docker exec`.
#
# It is a function rather than four inline lines because `cleat login` needs it
# too: without it, /login on a pinned box wrote the new credential into the
# SHARED host store and clobbered the primary login, which is the opposite of
# what the verb promises.
#
# Returns 1 when the pin cannot be honoured, having said why. The caller
# continues on the shared login rather than pointing Claude at a path that does
# not exist in the container, where /login would create the store inside the
# container's own filesystem and `cleat rm` would destroy it with no warning.
_account_apply_exec_env() {
  local cname="$1" acct ready=0
  acct="$(_box_account_read "$cname")"
  [[ "$acct" != "$_ACCOUNT_DEFAULT" ]] || return 0
  _account_box_ready "$cname" || ready=$?
  if [[ $ready -eq 1 ]]; then
    # The recreate hint names the BOX. A bare `cleat rm` removes main, so on any
    # named box the old hint sent the user to remove a different box than the
    # one that needs recreating.
    warn "Box ${BOLD}${_BOX:-main}${RESET} (${cname}) has no account mount, so it cannot use ${BOLD}${acct}${RESET} yet."
    echo -e "    ${DIM}Recreate it once: ${BOLD}cleat rm ${_BOX:-main}${RESET}${DIM} then start it again. This session uses your shared login.${RESET}"
    return 1
  fi
  # A lock that cannot be had writes nothing. The box starts on whatever is
  # already staged, which is the login it last ran with, and still gets the env
  # var so that login is the one it reads.
  local _si=0
  _ACCOUNT_STAGED_NEW_LOGIN=0
  _account_sync_in "$cname" || _si=$?
  # A staged login that is not the one the box last ran on takes the cached
  # identity with it. The launch clears the flag a few lines later, before
  # Claude reads the file (_refresh_attached_claude_json).
  [[ ${_ACCOUNT_STAGED_NEW_LOGIN:-0} -eq 0 ]] \
    || _handoff_flag_identity_stale "${_RESOLVED_PROJECT:-}" "${_BOX:-main}"
  if [[ $_si -eq $_ACCOUNT_LOCK_BUSY && "${_ACCOUNT_LOCK_UNWRITABLE:-0}" -eq 1 ]]; then
    warn "Cleat cannot write to the accounts directory, so ${BOLD}${cname}${RESET} starts with the login it already has."
    echo -e "    ${DIM}Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
  elif [[ $_si -eq $_ACCOUNT_LOCK_BUSY ]]; then
    warn "Another cleat command is changing accounts, so ${BOLD}${cname}${RESET} starts with the login it already has."
  elif [[ $_si -ne 0 && $_ACCOUNT_STAGE_UNKEPT -eq 1 ]]; then
    # Not staged over a login the store does not have, because it could not be
    # kept first. Said every time, or the box runs as someone else in silence
    # until the accounts dir is writable again.
    warn "${BOLD}${cname}${RESET} starts with the login it already has: it could not be kept before staging ${BOLD}${acct}${RESET}."
    echo -e "    ${DIM}Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
  fi
  # A box starting on this account is a use of it. Only the switch stamped
  # last_used, so an account a box ran on all day still showed the hour of the
  # last switch: a session that ended a minute ago read "last used 22h ago".
  # Only when the staging took, because a box that kept the login it already
  # had may be running as someone else entirely.
  [[ $_si -ne 0 ]] || _account_capture_meta "$acct" || true
  CLAUDE_ENV+=(-e "CLAUDE_SECURESTORAGE_CONFIG_DIR=${_ACCOUNT_BOX_DIR}")
  return 0
}


# ── Live switch: the half that runs inside the box ─────────────────────────
# These _hb_* functions are the ONLY code cleat runs inside a box during a live
# account switch. They are shipped as text (declare -f, see _handoff_box_script)
# and run under `bash -c` with `runuser -u coder`, stdin closed. They print a
# strict tab-separated grammar on stdout and never a byte of any credential, an
# environ value beyond the words the grammar maps, or a session-file string
# other than a validated session id. They reference no host global: paths and
# waits arrive as arguments. probe is read-only. terminate signals only the
# targets it was handed, never with SIGKILL, and only ever touches Claude's
# refresh lock it took itself. Both are portable to bash 3.2; terminate uses
# GNU `stat -c` and `touch -c`, which the box always has.

# state <starttime>: read <PROC>/<PID>/stat and print `live <starttime>`,
# `exited` (state Z or X) or `gone` (no such process or unreadable). <PROC>/<PID>
# may be a symlink (proc views in the tests), so this never refuses one. The
# comm field is in parens and can hold spaces or parens, so the fields are taken
# from after the LAST ") ": state is then word 1 and the start time word 20
# (field 22 of the whole line).
_hb_proc_state() {
  local proc="$1" pid="$2" raw rest state start
  raw="$(head -c 4096 "$proc/$pid/stat" 2>/dev/null)" || { printf 'gone'; return 0; }
  [[ -n "$raw" ]] || { printf 'gone'; return 0; }
  rest="${raw##*) }"
  [[ "$rest" != "$raw" ]] || { printf 'gone'; return 0; }
  set -- $rest
  state="${1:-}"
  start="${20:-}"
  case "$state" in
    Z|X) printf 'exited'; return 0 ;;
  esac
  case "$start" in
    ''|*[!0-9]*) printf 'gone'; return 0 ;;
  esac
  printf 'live %s' "$start"
  return 0
}

# `<count> <value>` of NAME= in <PROC>/<PID>/environ (NUL-separated), or the bare
# word `unreadable`. A directory at the environ path, or a path that cannot be
# read, is `unreadable`, never a count of 0. When NAME appears more than once the
# count says so and the caller decides; the last value is kept but the caller of
# a duplicated key never reads it.
_hb_env_value() {
  local proc="$1" pid="$2" name="$3" f w cnt=0 val=""
  f="$proc/$pid/environ"
  if [[ -d "$f" ]] || [[ ! -r "$f" ]]; then printf 'unreadable'; return 0; fi
  while IFS= read -r -d '' w || [[ -n "$w" ]]; do
    case "$w" in
      "$name="*) cnt=$(( cnt + 1 )); val="${w#*=}" ;;
    esac
  done < "$f"
  printf '%s %s' "$cnt" "$val"
  return 0
}

# The CLEAT_EXEC_ID of a process, mapped to the grammar: a 12-32 hex id, or
# `none` (absent), `many` (two or more), `bad` (one that is not hex) or
# `unreadable` (the environ could not be read). An unreadable environ is never
# `none`: a switch must not treat "cannot tell" as "no session marker".
_hb_execid() {
  local proc="$1" pid="$2" raw cnt val
  local re_hex='^[0-9a-f]{12,32}$'
  raw="$(_hb_env_value "$proc" "$pid" CLEAT_EXEC_ID)"
  if [[ "$raw" == unreadable ]]; then printf 'unreadable'; return 0; fi
  cnt="${raw%% *}"; val="${raw#* }"
  case "$cnt" in
    0) printf 'none'; return 0 ;;
    1) if [[ "$val" =~ $re_hex ]]; then printf '%s' "$val"; else printf 'bad'; fi; return 0 ;;
    *) printf 'many'; return 0 ;;
  esac
}

# One `claude` record for a live session file, or return 1 (the file is stale,
# nothing printed). Live means <PROC>/<PID>/stat is `live` AND its start time
# equals the file's procStart string: a pid reused after a container restart is
# a different process with a different start time, so the old file is skipped.
# status, waitingFor, kind and sessionId are read only after that, each mapped
# to a fixed word (an unknown one fails to `unknown`/`other`/`none`).
_hb_session_record() {
  local home="$1" proc="$2" pid="$3" f="$4"
  local st start blob ps status waiting kind sid execid store sraw scnt sval
  local re_uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  st="$(_hb_proc_state "$proc" "$pid")"
  case "$st" in
    live\ *) start="${st#live }" ;;
    *) return 1 ;;
  esac
  blob="$(head -c 262144 "$f" 2>/dev/null)"
  ps="$(_json_flat_str "$blob" procStart 2>/dev/null || true)"
  [[ -n "$ps" && "$ps" == "$start" ]] || return 1
  status="$(_json_flat_str "$blob" status 2>/dev/null || true)"
  case "$status" in
    busy|shell|idle|waiting) ;;
    *) status=unknown ;;
  esac
  waiting="$(_json_flat_str "$blob" waitingFor 2>/dev/null || true)"
  case "$waiting" in
    "permission prompt") waiting=permission-prompt ;;
    "input needed") waiting=input-needed ;;
    "worker request") waiting=worker-request ;;
    "dialog open") waiting=dialog-open ;;
    "sandbox request") waiting=sandbox-request ;;
    "") waiting=none ;;
    *) waiting=other ;;
  esac
  kind="$(_json_flat_str "$blob" kind 2>/dev/null || true)"
  case "$kind" in
    interactive|bg|daemon|daemon-worker) ;;
    *) kind=unknown ;;
  esac
  sid="$(_json_flat_str "$blob" sessionId 2>/dev/null || true)"
  [[ "$sid" =~ $re_uuid ]] || sid=none
  execid="$(_hb_execid "$proc" "$pid")"
  sraw="$(_hb_env_value "$proc" "$pid" CLAUDE_SECURESTORAGE_CONFIG_DIR)"
  if [[ "$sraw" == unreadable ]]; then
    store=unreadable
  else
    scnt="${sraw%% *}"; sval="${sraw#* }"
    case "$scnt" in
      0) store=default ;;
      1) if [[ "$sval" == "$home/.cleat-auth" ]]; then store=named; else store=other; fi ;;
      *) store=other ;;
    esac
  fi
  printf 'claude\t%s %s %s %s %s %s %s %s\n' \
    "$pid" "$start" "$status" "$waiting" "$kind" "$execid" "$store" "$sid"
  return 0
}

# Walk <PROC>/<digits>. Print `orphan <pid>` for a process _is_claude_argv
# accepts whose pid is not in SKIPPIDS (the caller skips every pid it already
# accounted for as a live session or a target), and `shell <execid>` for a
# process one of whose argv words holds a `/shell-snapshots/` PATH (Claude
# sources one into every tool/bash shell). Empty cmdlines and skipped pids are
# ignored. The executable decides: a `claude` word in an argument (a ripgrep
# pattern, a dev server) is never a session, which _is_claude_argv enforces.
#
# The path slashes are not decoration. The match used to be the bare word, and
# this probe is shipped to the box AS TEXT ON ARGV, so the probe's own bash
# carried `shell-snapshots` in its command line, matched itself and reported a
# background shell on every run. Every live switch refused with "background
# shell commands running in another terminal" on a box that had none. The
# headline feature was unusable and only a real box showed it (2026-09-20).
# The caller also skips this shell and its parent, so a later mention of the
# path inside the shipped text cannot bring the self-match back.
_hb_scan() {
  local home="$1" proc="$2" skip="$3"
  local d pid w words execid found_shell
  for d in "$proc"/[0-9]*; do
    [[ -e "$d" || -L "$d" ]] || continue
    pid="${d##*/}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    case " $skip " in *" $pid "*) continue ;; esac
    [[ -r "$d/cmdline" ]] || continue
    words=()
    while IFS= read -r -d '' w || [[ -n "$w" ]]; do
      words+=("$w")
    done < "$d/cmdline"
    [[ ${#words[@]} -gt 0 ]] || continue
    if _is_claude_argv "${words[@]}"; then
      printf 'orphan\t%s\n' "$pid"
    fi
    found_shell=0
    for w in "${words[@]}"; do
      case "$w" in
        */shell-snapshots/*) found_shell=1; break ;;
      esac
    done
    if [[ $found_shell -eq 1 ]]; then
      execid="$(_hb_execid "$proc" "$pid")"
      printf 'shell\t%s\n' "$execid"
    fi
  done
  return 0
}

# Argument validation for both verbs, kept in one place so a bad call is refused
# before either verb touches the box. probe wants two absolute directories.
# terminate wants HOME PROC STORE LOCKWAIT KILLWAIT N and then exactly 5N more,
# each target a pid, a procstart, a UUID sid, a hex execid and an EXPECT word.
_hb_args_ok() {
  local verb="$1"; shift
  local re_uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  local re_pid='^[1-9][0-9]{0,9}$'
  local re_ps='^[0-9]{1,20}$'
  local re_hex='^[0-9a-f]{12,32}$'
  local re_wait='^[0-9]{1,2}$'
  local re_n='^[1-9]$'
  case "$verb" in
    probe)
      [[ $# -eq 2 ]] || return 1
      [[ "$1" == /* && -d "$1" ]] || return 1
      [[ "$2" == /* && -d "$2" ]] || return 1
      return 0
      ;;
    terminate)
      [[ $# -ge 6 ]] || return 1
      local home="$1" proc="$2" store="$3" lockwait="$4" killwait="$5" n="$6"
      shift 6
      [[ "$home" == /* && -d "$home" ]] || return 1
      [[ "$proc" == /* && -d "$proc" ]] || return 1
      case "$store" in named|default) ;; *) return 1 ;; esac
      [[ "$lockwait" =~ $re_wait ]] || return 1
      [[ "$killwait" =~ $re_wait ]] || return 1
      [[ "$n" =~ $re_n ]] || return 1
      [[ $# -eq $(( 5 * n )) ]] || return 1
      while [[ $# -ge 5 ]]; do
        [[ "$1" =~ $re_pid ]] || return 1
        [[ "$2" =~ $re_ps ]] || return 1
        [[ "$3" =~ $re_uuid ]] || return 1
        [[ "$4" =~ $re_hex ]] || return 1
        case "$5" in idle|limitq|now) ;; *) return 1 ;; esac
        shift 5
      done
      return 0
      ;;
    *) return 1 ;;
  esac
}

# probe HOME PROC: report every live session and every stray Claude/shell. Read
# only. Output: `hb 1`, `args ok|bad`, one `claude` per live session, `orphan`
# and `shell` lines for the rest, `end ok`.
_hb_probe() {
  trap '' PIPE
  set -u
  export LC_ALL=C
  printf 'hb\t1\n'
  if _hb_args_ok probe "$@"; then
    printf 'args\tok\n'
  else
    printf 'args\tbad\n'
    printf 'end\tabort\n'
    return 0
  fi
  local home="$1" proc="$2" f base pid livepids=""
  for f in "$home"/.claude/sessions/[0-9]*.json; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    base="${f##*/}"; pid="${base%.json}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    if _hb_session_record "$home" "$proc" "$pid" "$f"; then
      livepids="$livepids $pid"
    fi
  done
  # This shell and whatever launched it: see _hb_scan's note on the self-match.
  _hb_scan "$home" "$proc" "$livepids $$ ${PPID:-}"
  printf 'end\tok\n'
  return 0
}

# Take Claude's own refresh lock (a proper-lockfile directory). Poll every 0.1s
# up to WAIT seconds. A symlink or non-directory at the path stops at once (a
# lock cleat must not fight). An existing dir older than STALE is Claude's own
# to reclaim: re-read its mtime and, only if it is STILL that old, rmdir it
# non-recursively and retry the mkdir. A younger, touched dir (Claude holding
# and refreshing every 2s) is never removed. Sets _HB_OWN_LOCK on success.
_hb_lock_take() {
  local lock="$1" wait="$2" stale="$3" start now mt
  start=$SECONDS
  while :; do
    if [[ -L "$lock" ]]; then return 1; fi
    if [[ -e "$lock" && ! -d "$lock" ]]; then return 1; fi
    if mkdir "$lock" 2>/dev/null; then
      _HB_OWN_LOCK="$lock"
      return 0
    fi
    if [[ -d "$lock" ]]; then
      now="$(date +%s)"
      mt="$(stat -c %Y "$lock" 2>/dev/null || echo 0)"
      case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
      if [[ $(( now - mt )) -gt $stale ]]; then
        mt="$(stat -c %Y "$lock" 2>/dev/null || echo 0)"
        case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
        now="$(date +%s)"
        if [[ $(( now - mt )) -gt $stale ]]; then
          rmdir "$lock" 2>/dev/null || true
          if mkdir "$lock" 2>/dev/null; then _HB_OWN_LOCK="$lock"; return 0; fi
        fi
      fi
    fi
    if [[ $(( SECONDS - start )) -ge $wait ]]; then return 1; fi
    sleep 0.1
  done
}

# Release only a lock this run created. Run from the EXIT/TERM/INT/HUP traps and
# again at a clean finish. Never touches a lock dir the run did not make (that
# would be Claude's, and proper-lockfile aborts a refresh whose lock mtime it
# did not write).
_hb_cleanup() {
  if [[ -n "${_HB_OWN_LOCK:-}" ]]; then
    rmdir "$_HB_OWN_LOCK" 2>/dev/null || true
    _HB_OWN_LOCK=""
  fi
}

# Under the lock, re-verify every target still matches its snapshot and that no
# new session, orphan or unexpected shell appeared. Reads the _HBT_* target
# arrays, sets _HBT_LIVE[i] to 1 (still there) or 0 (already gone), and returns
# 0 (nothing changed) or 1 (something changed). A live process whose session
# file vanished, a mismatched start time, sid or exec id, or a status the
# target's EXPECT does not allow all count as changed. A gone target is recorded
# and is NOT a failure. Then the outside scan runs with every target skipped:
# any orphan or any shell that does not belong to a `now` target is a change.
_hb_recheck() {
  local home="$1" proc="$2"
  local i pid ps sid execid expect f st start blob fsid fexec status waiting
  local skip="" changed=0 scanout typ rest ok j
  i=0
  while [[ $i -lt $_HBT_N ]]; do
    pid="${_HBT_PID[$i]}"; ps="${_HBT_PS[$i]}"; sid="${_HBT_SID[$i]}"
    execid="${_HBT_EXEC[$i]}"; expect="${_HBT_EXPECT[$i]}"
    f="$home/.claude/sessions/$pid.json"
    st="$(_hb_proc_state "$proc" "$pid")"
    case "$st" in
      live\ *) start="${st#live }" ;;
      *) _HBT_LIVE[$i]=0; skip="$skip $pid"; i=$(( i + 1 )); continue ;;
    esac
    [[ -f "$f" && ! -L "$f" ]] || changed=1
    [[ "$start" == "$ps" ]] || changed=1
    blob="$(head -c 262144 "$f" 2>/dev/null)"
    fsid="$(_json_flat_str "$blob" sessionId 2>/dev/null || true)"
    [[ "$fsid" == "$sid" ]] || changed=1
    fexec="$(_hb_execid "$proc" "$pid")"
    [[ "$fexec" == "$execid" ]] || changed=1
    status="$(_json_flat_str "$blob" status 2>/dev/null || true)"
    case "$status" in busy|shell|idle|waiting) ;; *) status=unknown ;; esac
    waiting="$(_json_flat_str "$blob" waitingFor 2>/dev/null || true)"
    case "$expect" in
      idle) [[ "$status" == idle ]] || changed=1 ;;
      limitq)
        case "$status" in
          idle) ;;
          waiting) [[ "$waiting" == "dialog open" ]] || changed=1 ;;
          *) changed=1 ;;
        esac
        ;;
      now) case "$status" in idle|busy|waiting) ;; *) changed=1 ;; esac ;;
    esac
    _HBT_LIVE[$i]=1; skip="$skip $pid"; i=$(( i + 1 ))
  done
  scanout="$(_hb_scan "$home" "$proc" "$skip")"
  while IFS=$'\t' read -r typ rest; do
    case "$typ" in
      orphan) changed=1 ;;
      shell)
        ok=0; j=0
        while [[ $j -lt $_HBT_N ]]; do
          if [[ "${_HBT_EXPECT[$j]}" == now && "${_HBT_EXEC[$j]}" == "$rest" ]]; then ok=1; break; fi
          j=$(( j + 1 ))
        done
        [[ $ok -eq 1 ]] || changed=1
        ;;
    esac
  done <<HB_RECHECK_SCAN
$scanout
HB_RECHECK_SCAN
  [[ $changed -eq 0 ]]
}

# terminate HOME PROC STORE LOCKWAIT KILLWAIT N [PID PROCSTART SID EXECID EXPECT]...
# Stop exactly the target sessions while holding Claude's refresh lock for their
# store, so no token refresh of that store can start or be discarded across the
# signal. SIGTERM only, never SIGKILL. Output order: hb, args, lock, recheck,
# one pid per target, scan, end.
_hb_terminate() {
  trap '' PIPE
  set -u
  export LC_ALL=C
  printf 'hb\t1\n'
  if _hb_args_ok terminate "$@"; then
    printf 'args\tok\n'
  else
    printf 'args\tbad\n'
    printf 'end\tabort\n'
    return 0
  fi
  local home="$1" proc="$2" store="$3" lockwait="$4" killwait="$5" n="$6"
  shift 6
  _HBT_N="$n"
  _HBT_PID=(); _HBT_PS=(); _HBT_SID=(); _HBT_EXEC=(); _HBT_EXPECT=(); _HBT_LIVE=()
  local i=0
  while [[ $# -ge 5 ]]; do
    _HBT_PID[$i]="$1"; _HBT_PS[$i]="$2"; _HBT_SID[$i]="$3"; _HBT_EXEC[$i]="$4"; _HBT_EXPECT[$i]="$5"
    _HBT_LIVE[$i]=1
    shift 5; i=$(( i + 1 ))
  done

  _HB_OWN_LOCK=""
  trap _hb_cleanup EXIT
  trap '_hb_cleanup; exit 143' TERM
  trap '_hb_cleanup; exit 130' INT
  trap '_hb_cleanup; exit 129' HUP

  local lock
  if [[ "$store" == named ]]; then
    lock="$home/.cleat-auth/.oauth_refresh.lock"
  else
    lock="$home/.claude/.oauth_refresh.lock"
  fi
  if _hb_lock_take "$lock" "$lockwait" "$_HB_CLAUDE_LOCK_STALE_S"; then
    printf 'lock\tok\n'
  else
    printf 'lock\ttimeout\n'
    printf 'end\tabort\n'
    return 0
  fi

  if _hb_recheck "$home" "$proc"; then
    printf 'recheck\tok\n'
  else
    printf 'recheck\tchanged\n'
    printf 'end\tabort\n'
    return 0
  fi

  local i2 all_gone=1 result=()
  i2=0
  while [[ $i2 -lt $_HBT_N ]]; do
    if [[ "${_HBT_LIVE[$i2]}" == 1 ]]; then all_gone=0; result[$i2]=alive; else result[$i2]=gone; fi
    i2=$(( i2 + 1 ))
  done

  if [[ $all_gone -eq 0 ]]; then
    i2=0
    while [[ $i2 -lt $_HBT_N ]]; do
      if [[ "${_HBT_LIVE[$i2]}" == 1 ]]; then
        kill -TERM "${_HBT_PID[$i2]}" 2>/dev/null || true
      fi
      i2=$(( i2 + 1 ))
    done
    local kstart lastsec nowsec st2 start2 remaining
    kstart=$SECONDS; lastsec=$SECONDS
    remaining=1
    while [[ $remaining -eq 1 ]]; do
      remaining=0
      i2=0
      while [[ $i2 -lt $_HBT_N ]]; do
        if [[ "${result[$i2]}" == alive ]]; then
          st2="$(_hb_proc_state "$proc" "${_HBT_PID[$i2]}")"
          case "$st2" in
            exited|gone) result[$i2]=exited ;;
            live\ *)
              start2="${st2#live }"
              if [[ "$start2" != "${_HBT_PS[$i2]}" ]]; then result[$i2]=exited; else remaining=1; fi
              ;;
          esac
        fi
        i2=$(( i2 + 1 ))
      done
      [[ $remaining -eq 1 ]] || break
      if [[ $(( SECONDS - kstart )) -ge $killwait ]]; then break; fi
      nowsec=$SECONDS
      if [[ "$nowsec" != "$lastsec" ]]; then
        touch -c -- "$_HB_OWN_LOCK" 2>/dev/null || true
        lastsec=$nowsec
      fi
      sleep 0.02
    done
  fi

  local any_alive=0
  i2=0
  while [[ $i2 -lt $_HBT_N ]]; do
    printf 'pid\t%s %s\n' "${_HBT_PID[$i2]}" "${result[$i2]}"
    [[ "${result[$i2]}" == alive ]] && any_alive=1
    i2=$(( i2 + 1 ))
  done
  if [[ $any_alive -eq 1 ]]; then
    printf 'end\tabort\n'
    return 0
  fi

  local fscan fchanged=0 ftyp frest f base pid st start blob ps
  fscan="$(_hb_scan "$home" "$proc" "")"
  while IFS=$'\t' read -r ftyp frest; do
    case "$ftyp" in
      orphan) fchanged=1 ;;
    esac
  done <<HB_FINAL_SCAN
$fscan
HB_FINAL_SCAN
  for f in "$home"/.claude/sessions/[0-9]*.json; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    base="${f##*/}"; pid="${base%.json}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    st="$(_hb_proc_state "$proc" "$pid")"
    case "$st" in live\ *) start="${st#live }" ;; *) continue ;; esac
    blob="$(head -c 262144 "$f" 2>/dev/null)"
    ps="$(_json_flat_str "$blob" procStart 2>/dev/null || true)"
    [[ "$ps" == "$start" ]] && fchanged=1
  done
  if [[ $fchanged -eq 1 ]]; then
    printf 'scan\tchanged\n'
    printf 'end\tabort\n'
    return 0
  fi

  rmdir "$_HB_OWN_LOCK" 2>/dev/null || true
  _HB_OWN_LOCK=""
  printf 'scan\tok\n'
  printf 'end\tok\n'
  return 0
}

# The entry point the shipped closure calls with the box's argv (the first word
# is the verb). An unknown verb prints the abort grammar so the host rejects it
# rather than reading a truncated success.
_hb_main() {
  local verb="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "$verb" in
    probe)     _hb_probe "$@" ;;
    terminate) _hb_terminate "$@" ;;
    *)
      printf 'hb\t1\n'
      printf 'args\tbad\n'
      printf 'end\tabort\n'
      ;;
  esac
}

# ── Live switch: terminal 2 ────────────────────────────────────────────────
# The half that runs on the host in the terminal that typed `cleat account`.
# (M1 ships only the bounded exec; the rest of terminal 2 lands with the switch
# body.)

# Render the in-box half as a self-contained script: the stale-bound constant,
# then every function the verbs reach, then the entry-point call. Returns
# non-zero when any listed name is unset, so a caller never ships a half script.
# References no host global, so it runs the same under `env -i`.
_handoff_box_script() {
  declare -p _HB_CLAUDE_LOCK_STALE_S || return 1
  declare -f _json_flat_str _sessions_json_unesc _is_claude_argv \
             _hb_main _hb_args_ok _hb_probe _hb_terminate _hb_proc_state \
             _hb_scan _hb_env_value _hb_execid _hb_session_record _hb_recheck \
             _hb_lock_take _hb_cleanup || return 1
  printf '%s\n' '_hb_main "$@"'
}

# Run one box verb bounded on every host, including the ones with no timeout(1).
# The docker client runs as a background job; a poll loop stops it when it
# outlives BOUND seconds or writes more than _HANDOFF_OUT_MAX_BYTES to OUT. Only
# the docker CLIENT is ever SIGKILLed here, never anything inside the box. The
# captured output goes to OUT; the caller reads at most _HANDOFF_OUT_MAX_BYTES
# of it after this returns. rc 124 means the bound stopped it.
_handoff_docker_exec() {
  local cname="$1" bound="$2" out="$3" script dpid rc=0 start n=0 size stopped=0
  shift 3
  script="$(_handoff_box_script)" || return 70
  : > "$out" || return 70
  docker exec "$cname" runuser -u coder -- bash -c "$script" cleat-hb "$@" \
    </dev/null >"$out" 2>/dev/null 3>&- &
  dpid=$!
  start=$SECONDS
  while kill -0 "$dpid" 2>/dev/null; do
    n=$(( n + 1 ))
    if [[ $(( SECONDS - start )) -ge $bound ]]; then stopped=1; break; fi
    if [[ $(( n % 10 )) -eq 0 ]]; then
      size="$(wc -c <"$out" 2>/dev/null | tr -d '[:space:]')"
      case "$size" in ''|*[!0-9]*) size=0 ;; esac
      if [[ $size -gt $_HANDOFF_OUT_MAX_BYTES ]]; then stopped=1; break; fi
    fi
    _handoff_exec_pause || true
  done
  if [[ $stopped -eq 1 ]]; then
    kill -TERM "$dpid" 2>/dev/null || true
    n=0
    while kill -0 "$dpid" 2>/dev/null && [[ $n -lt 20 ]]; do _handoff_exec_pause || true; n=$(( n + 1 )); done
    kill -KILL "$dpid" 2>/dev/null || true
  fi
  wait "$dpid" 2>/dev/null || rc=$?
  if [[ $stopped -eq 1 ]]; then rc=124; fi
  return "$rc"
}

# Every refusal to change the login under a live Claude session says this.
#
# The reason is NOT that Claude Code notices the swap and undoes it. The old
# refusal said so ("noticed and undone", "disarms its auth watcher and writes
# its own token back"), from a 2.1.267 read that was never run. On 2.1.270 the
# store's mtime change only clears caches, and the next request goes out with
# whatever token is there. Claude writes nothing back (77 lab runs). The guard
# stays for what a running session keeps from its start:
# - the store PATH, fixed per exec by CLAUDE_SECURESTORAGE_CONFIG_DIR. A session
#   started on the shared login never sees a switch. One sent back to the
#   shared login keeps reading the box store, which the unpin empties, so it is
#   signed out.
# - the account identity. A bare swap moves only the bearer. The account uuid,
#   the /status email and the org header stay on the old account.
# - a turn already running, which finishes on the old token.
# - a refresh saved in the same instant as the swap, which can put the old token
#   back for the next harvest to file under the new name.
# A fresh start takes all of it. That is the path the guard leaves open.
# Print one piece of live-switch copy by id, colours through the shared helpers,
# so every user-visible refusal and status of the handoff lives in one place and
# the golden-file test can diff it. This milestone defines the ids the offline
# switch, the attach gate and the account-rm refusal use. Terminal 2 adds the
# rest of the catalogue here (section 3.2 of the handover, concept/44).
_handoff_say() {
  local id="$1"; shift
  case "$id" in
    R-switching)
      # $1 box, $2 the command to retry (cleat | cleat shell)
      error "${BOLD}${1}${RESET} is switching accounts in another terminal."
      echo -e "    ${DIM}Nothing was changed. Run ${BOLD}${2}${RESET}${DIM} again in a moment.${RESET}"
      ;;
    R-starting)
      error "A Claude session is starting in ${BOLD}${1}${RESET} in another terminal."
      echo -e "    ${DIM}Nothing was changed. Run this again once it is up.${RESET}"
      ;;
    R-shell-open)
      error "${BOLD}${1}${RESET} has a cleat shell open in another terminal."
      echo -e "    ${DIM}A claude started there keeps the login the shell opened with. Exit it, then run this again.${RESET}"
      echo -e "    ${DIM}Nothing was changed.${RESET}"
      ;;
    R-reopening)
      error "${BOLD}${1}${RESET} is still reopening a session from an earlier switch."
      echo -e "    ${DIM}Nothing was changed. Run this again in a moment.${RESET}"
      ;;
    T0)
      # $1 the account the other terminal is switching to (or the default sentinel)
      info "The other terminal is switching this box to $(_handoff_acct_phrase "$1"). This conversation reopens here when that finishes."
      echo -e "    ${DIM}Wait here before you type. Ctrl-C stops waiting.${RESET}"
      ;;
    T-unfinished)
      # $1 the pin the box really landed on
      warn "The account switch did not finish. This box is on $(_handoff_acct_phrase "$1")."
      echo -e "    ${DIM}Resume with: ${BOLD}cleat resume${RESET}"
      ;;
    T-interrupted)
      # $1 the pin the box really landed on
      warn "Stopped waiting for the account switch. This box is on $(_handoff_acct_phrase "$1")."
      echo -e "    ${DIM}Resume with: ${BOLD}cleat resume${RESET}"
      ;;
    T-landed)
      # $1 box, $2 the pin it landed on
      warn "${BOLD}${1}${RESET} is now on $(_handoff_acct_phrase "$2"). This conversation did not reopen."
      echo -e "    ${DIM}Resume with: ${BOLD}cleat resume${RESET}"
      ;;
    T-boxstopped)
      warn "The box stopped during the account switch."
      echo -e "    ${DIM}Resume with: ${BOLD}cleat resume${RESET}"
      ;;
  esac
}

# ── Live handoff: terminal 2 host helpers ──────────────────────────────────
# Everything the terminal that typed `cleat account <b>` runs to hand a live
# session over: probe the box, classify what it found against section 3.2 of
# the handover, disclose what is lost, ask, then under the account lock stop the
# session in the box (the ONE docker call the lock allows), move the login the
# offline switch's way and leave a ticket the other terminal reopens from. The
# copy printers keep every user-visible line in one place so the golden-file
# test can diff them and the site mockups can copy them.

# The account name as it reads bare in a sentence ("b", "your shared login"),
# and its possessive ("b's", "that login's"). _handoff_acct_phrase (defined with
# the T lines) gives the "account b" form the result headers use.
_handoff_acct_bare() {
  if [[ "$1" == "$_ACCOUNT_DEFAULT" ]]; then printf 'your shared login'; else printf '%s' "$1"; fi
}
_handoff_acct_poss() {
  if [[ "$1" == "$_ACCOUNT_DEFAULT" ]]; then printf 'that login'\''s'; else printf '%s'\''s' "$1"; fi
}

# A pause between the two staged-file verifies, a seam a test overrides to run
# without real time.
_handoff_settle_pause() { sleep 0.1 2>/dev/null || true; }

# The settings-file half of _resume_model_configured, split out so terminal 2
# can ask "is a model set" without resolve_env_args (which needs resolve_caps,
# which may prompt). True when any settings file this project reads names a
# model. The env half stays in _resume_model_configured.
_resume_model_in_settings() {
  local project="$1" f blob re='"(model|ANTHROPIC_MODEL|ANTHROPIC_DEFAULT_[A-Z]+_MODEL)"[[:space:]]*:'
  for f in "${HOME}/.claude/settings.json" "$project/.claude/settings.json" "$project/.claude/settings.local.json"; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    blob="$(head -c "$_RESUME_CARRY_WINDOW" "$f" 2>/dev/null || true)"
    [[ "$blob" =~ $re ]] && return 0
  done
  return 1
}

# The conversation size of a transcript: the token sum of its last real
# assistant turn, or nothing when it cannot be read. Reuses the tested
# _resume_last_usage_tokens (model TAB tokens), taking the token count.
_handoff_context_tokens() {
  local f="$1" out
  out="$(_resume_last_usage_tokens "$f" 2>/dev/null || true)"
  case "$out" in
    *"$(printf '\t')"*) printf '%s' "${out#*$'\t'}" ;;
    *) return 1 ;;
  esac
}

# The last permission-mode record's value, printed only when it is one cleat
# knows. Feeds D9. Nothing for bypassPermissions, an absent record or anything
# unrecognised (D9 is silent then).
_handoff_last_permission_mode() {
  local f="$1"
  [[ -f "$f" && ! -L "$f" ]] || return 0
  tail -c 1048576 "$f" 2>/dev/null | LC_ALL=C awk '
    /"type":"permission-mode"/ {
      if (match($0, /"permissionMode":"[^"]*"/)) {
        v = substr($0, RSTART+18, RLENGTH-19)
        last = v
      }
    }
    END {
      if (last=="plan"||last=="acceptEdits"||last=="default"||last=="auto"||last=="dontAsk"||last=="bypassPermissions") print last
    }
  '
}

# Print the exec id of every live kind=claude marker that no probe record and no
# live ticket explains and whose marker is younger than the starting bound: a
# session coming up in another terminal that the probe cannot see yet (row 8a).
# Reads _HO_EXEC (the probe's ids). A cmd_shell marker (empty exec) is never
# printed.
_handoff_marker_orphans() {
  local cname="$1" rd m pid mt age now e skip tf
  now="$(_handoff_now)"; case "$now" in ''|*[!0-9]*) now="$(date +%s)" ;; esac
  rd="$CLEAT_RUN_DIR/$cname"
  for m in "$rd"/.attached.*; do
    [[ -e "$m" ]] || continue
    pid="${m##*/.attached.}"
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    _handoff_marker_read "$m" || continue
    [[ "$_HM_KIND" == claude && -n "$_HM_EXEC" ]] || continue
    skip=0
    for e in ${_HO_EXEC[@]+"${_HO_EXEC[@]}"}; do
      [[ "$e" == "$_HM_EXEC" ]] && { skip=1; break; }
    done
    [[ $skip -eq 1 ]] && continue
    tf="$rd/.handoff.$_HM_EXEC"
    _handoff_ticket_read "$tf" && continue
    mt="$(_path_mtime "$m")"; age=$(( now - mt ))
    [[ $age -ge 0 && $age -le $_HANDOFF_STARTING_MAX_S ]] || continue
    printf '%s\n' "$_HM_EXEC"
  done
}

# Run the in-box read-only probe (bound), parse it into the _HO_* arrays. rc 1
# when the exec failed, timed out or any line failed the grammar (the caller
# turns that into R5).
_handoff_probe() {
  local cname="$1" out rc=0 prc=0
  out="$(mktemp "${TMPDIR:-/tmp}/cleat-hprobe.XXXXXX" 2>/dev/null)" || return 1
  _handoff_docker_exec "$cname" "$_HANDOFF_PROBE_TIMEOUT_S" "$out" probe /home/coder /proc || rc=$?
  if [[ $rc -ne 0 ]]; then rm -f "$out" 2>/dev/null || true; return 1; fi
  _handoff_parse_probe "$out" || prc=$?
  rm -f "$out" 2>/dev/null || true
  return "$prc"
}

# Parse a probe capture. Sets _HO_PID _HO_PS _HO_STATUS _HO_WAIT _HO_KIND
# _HO_EXEC _HO_STORE _HO_SID (indexed, one per live session), _HO_ORPHANS (pids)
# and _HO_SHELLS (exec ids). Refuses (rc 1) on args bad, an aborted end, a
# malformed line or a missing hb/args/end.
_handoff_parse_probe() {
  local out="$1" typ rest hb=0 argsok=0 endok=0 n
  _HO_PID=(); _HO_PS=(); _HO_STATUS=(); _HO_WAIT=(); _HO_KIND=(); _HO_EXEC=(); _HO_STORE=(); _HO_SID=(); _HO_VER=()
  _HO_ORPHANS=""; _HO_SHELLS=""
  [[ -f "$out" ]] || return 1
  while IFS="$(printf '\t')" read -r typ rest || [[ -n "$typ" ]]; do
    [[ -z "$typ" && -z "$rest" ]] && continue
    case "$typ" in
      hb) [[ "$rest" == 1 ]] && hb=1 ;;
      args) [[ "$rest" == ok ]] && argsok=1; [[ "$rest" == bad ]] && return 1 ;;
      end) [[ "$rest" == ok ]] && endok=1; [[ "$rest" == abort ]] && return 1 ;;
      claude)
        set -- $rest
        [[ $# -eq 8 ]] || return 1
        n=${#_HO_PID[@]}
        _HO_PID[$n]="$1"; _HO_PS[$n]="$2"; _HO_STATUS[$n]="$3"; _HO_WAIT[$n]="$4"
        _HO_KIND[$n]="$5"; _HO_EXEC[$n]="$6"; _HO_STORE[$n]="$7"; _HO_SID[$n]="$8"; _HO_VER[$n]=""
        ;;
      orphan) _HO_ORPHANS="$_HO_ORPHANS $rest" ;;
      shell)  _HO_SHELLS="$_HO_SHELLS $rest" ;;
      *) return 1 ;;
    esac
  done < "$out"
  [[ $hb -eq 1 && $argsok -eq 1 && $endok -eq 1 ]] || return 1
  return 0
}

# Parse a terminate capture. Sets _PT_ARGS _PT_LOCK _PT_RECHECK _PT_SCAN _PT_END
# and the space-delimited pid sets _PT_EXITED _PT_ALIVE _PT_GONE plus
# _PT_ANY_ALIVE. rc 1 when the exec was refused or garbled (no hb, no end).
_parse_terminate() {
  local out="$1" typ rest hb=0 p st
  _PT_ARGS=""; _PT_LOCK=""; _PT_RECHECK=""; _PT_SCAN=""; _PT_END=""
  _PT_EXITED=" "; _PT_ALIVE=" "; _PT_GONE=" "; _PT_ANY_ALIVE=0
  [[ -f "$out" ]] || return 1
  while IFS="$(printf '\t')" read -r typ rest || [[ -n "$typ" ]]; do
    [[ -z "$typ" && -z "$rest" ]] && continue
    case "$typ" in
      hb) [[ "$rest" == 1 ]] && hb=1 ;;
      args) _PT_ARGS="$rest" ;;
      lock) _PT_LOCK="$rest" ;;
      recheck) _PT_RECHECK="$rest" ;;
      scan) _PT_SCAN="$rest" ;;
      end) _PT_END="$rest" ;;
      pid)
        set -- $rest; p="$1"; st="${2:-}"
        case "$st" in
          exited) _PT_EXITED="$_PT_EXITED$p " ;;
          alive)  _PT_ALIVE="$_PT_ALIVE$p "; _PT_ANY_ALIVE=1 ;;
          gone)   _PT_GONE="$_PT_GONE$p " ;;
        esac
        ;;
      *) return 1 ;;
    esac
  done < "$out"
  [[ $hb -eq 1 && ( "$_PT_ARGS" == ok || "$_PT_ARGS" == bad ) && -n "$_PT_END" ]] || return 1
  return 0
}

# A stable signature of the probe's live sessions, so a re-probe under the lock
# can prove nothing about them changed while the question was open.
_handoff_probe_signature() {
  local i=0
  while [[ $i -lt ${#_HO_PID[@]} ]]; do
    printf '%s|%s|%s|%s|%s|%s\n' \
      "${_HO_PID[$i]}" "${_HO_PS[$i]}" "${_HO_SID[$i]}" "${_HO_EXEC[$i]}" "${_HO_STORE[$i]}" "${_HO_STATUS[$i]}"
    i=$(( i + 1 ))
  done
  printf 'orphans:%s shells:%s\n' "$_HO_ORPHANS" "$_HO_SHELLS"
}

# True when SID has a real, non-symlink transcript under the project+box key
# dir. Row 15 leans on it: a session cleat cannot resume is refused.
_handoff_sid_has_transcript() {
  local sdir="$1" sid="$2"
  [[ -n "$sdir" ]] || return 1
  _sessions_path_under_key "$sdir/$sid.jsonl" "$sdir" || return 1
  [[ -f "$sdir/$sid.jsonl" && ! -L "$sdir/$sid.jsonl" ]]
}

# True when a shell line (a background command or monitor the probe reported) is
# acceptable to restart. A shell line is only acceptable when it belongs to a
# busy target that --now is restarting: its exec id equals that target's, so
# stopping the session stops the command and the box recheck's now exemption
# already covers it. A line tied to an idle target, an unreadable, many or bad
# id, or no target at all is not acceptable and must refuse. Reads the classify
# globals _HO_STATUS and _HO_EXEC. rc 0 acceptable, 1 refuse.
_handoff_shell_line_ok() {
  local sline="$1" now="$2" n="$3" i=0
  [[ "$now" == 1 ]] || return 1
  while [[ $i -lt $n ]]; do
    [[ "${_HO_STATUS[$i]}" == busy && "$sline" == "${_HO_EXEC[$i]}" ]] && return 0
    i=$(( i + 1 ))
  done
  return 1
}

# Apply rows 8a to 22 of the decision table to the parsed probe. Sets
# _HO_VERDICT (ok, quiet, or a refusal id), _HO_N and, when ok, the per-target
# _HO_EXPECT, _HO_LIMIT, _HO_AUTOCONT, _HO_MODE arrays and _HO_TARGET_PLAN. Fails
# closed: anything it does not recognise is a refusal, never a switch.
_handoff_classify() {
  local cname="$1" now="$2" project="$3" acct="$4"
  local i j N="${#_HO_PID[@]}" sdir pinstore tfile L A sid state sline
  _HO_VERDICT=ok; _HO_N=0
  _HO_EXPECT=(); _HO_LIMIT=(); _HO_AUTOCONT=(); _HO_MODE=(); _HO_TARGET_PLAN=""
  # Row 8a: a live marker with no probe record and no ticket is a session still
  # coming up, which the probe cannot see yet.
  if [[ -n "$(_handoff_marker_orphans "$cname")" ]]; then _HO_VERDICT=R22; return 0; fi
  # Row 8: a quiet box (a live non-claude process only).
  if [[ $N -eq 0 && -z "${_HO_ORPHANS// }" && -z "${_HO_SHELLS// }" ]]; then _HO_VERDICT=quiet; _HO_N=0; return 0; fi
  # Row 9: any orphan claude process.
  [[ -n "${_HO_ORPHANS// }" ]] && { _HO_VERDICT=R4; return 0; }
  # Row 10: a kind other than interactive.
  i=0; while [[ $i -lt $N ]]; do [[ "${_HO_KIND[$i]}" == interactive ]] || { _HO_VERDICT=R4; return 0; }; i=$(( i + 1 )); done
  # Row 11: an exec id cleat cannot tie to one live session.
  i=0; while [[ $i -lt $N ]]; do
    case "${_HO_EXEC[$i]}" in none|many|unreadable|bad) _HO_VERDICT=R4; return 0 ;; esac
    _handoff_id_ok "${_HO_EXEC[$i]}" || { _HO_VERDICT=R4; return 0; }
    i=$(( i + 1 ))
  done
  # Row 12: two records sharing one exec id.
  i=0; while [[ $i -lt $N ]]; do j=$(( i + 1 )); while [[ $j -lt $N ]]; do [[ "${_HO_EXEC[$i]}" == "${_HO_EXEC[$j]}" ]] && { _HO_VERDICT=R4; return 0; }; j=$(( j + 1 )); done; i=$(( i + 1 )); done
  # Row 13: an exec id with no live attach marker.
  i=0; while [[ $i -lt $N ]]; do _handoff_marker_live_for_exec "$cname" "${_HO_EXEC[$i]}" || { _HO_VERDICT=R4; return 0; }; i=$(( i + 1 )); done
  # Row 14: a store that does not match the pin.
  pinstore=default; [[ "$(_box_account_read "$cname")" != "$_ACCOUNT_DEFAULT" ]] && pinstore=named
  i=0; while [[ $i -lt $N ]]; do [[ "${_HO_STORE[$i]}" == "$pinstore" ]] || { _HO_VERDICT=R4; return 0; }; i=$(( i + 1 )); done
  # Row 15: a sid that is not a UUID with a real transcript in this project.
  sdir="$(_sessions_key_dir "$project" "${_BOX:-main}")" || sdir=""
  i=0; while [[ $i -lt $N ]]; do
    sid="${_HO_SID[$i]}"
    { [[ "$sid" != none ]] && _sessions_is_uuid "$sid"; } || { _HO_VERDICT=R4; return 0; }
    _handoff_sid_has_transcript "$sdir" "$sid" || { _HO_VERDICT=R4; return 0; }
    i=$(( i + 1 ))
  done
  # Row 16: a status cleat does not know (fail closed on anything unexpected).
  i=0; while [[ $i -lt $N ]]; do
    case "${_HO_STATUS[$i]}" in busy|shell|idle|waiting) : ;; *) _HO_VERDICT=R5; return 0 ;; esac
    i=$(( i + 1 ))
  done
  # Per-target limit, auto-continue and last permission mode, read from the
  # transcript before any kill. Rows 18 to 22 below read these.
  i=0; while [[ $i -lt $N ]]; do
    tfile="$sdir/${_HO_SID[$i]}.jsonl"
    set -- $(_handoff_tail_flags "$tfile"); L="${1:-0}"; A="${2:-0}"
    _HO_LIMIT[$i]="$L"; _HO_AUTOCONT[$i]="$A"
    _HO_MODE[$i]="$(_handoff_last_permission_mode "$tfile")"
    i=$(( i + 1 ))
  done
  # Row 19: a turn in flight, without --now. Evaluated before the shell row so a
  # busy session offers --now (R-busy) instead of the shell refusal, and so a
  # busy target's own background command can be let through by --now below.
  if [[ "$now" != 1 ]]; then
    i=0; while [[ $i -lt $N ]]; do [[ "${_HO_STATUS[$i]}" == busy ]] && { _HO_VERDICT=R1; return 0; }; i=$(( i + 1 )); done
  fi
  # A background shell command or monitor. A shell status is never busy so it
  # always refuses. A shell line (a background command's process) is let through
  # only when it belongs to a busy target that --now is restarting, so stopping
  # the session stops the command and the box recheck's now exemption covers it.
  # Any other shell line refuses. Without --now row 19 already took every busy
  # target, so every shell line refuses here.
  # Row 18: background shell (a shell line, then a shell status).
  for sline in $_HO_SHELLS; do _handoff_shell_line_ok "$sline" "$now" "$N" || { _HO_VERDICT=R3; return 0; }; done
  i=0; while [[ $i -lt $N ]]; do [[ "${_HO_STATUS[$i]}" == shell ]] && { _HO_VERDICT=R3; return 0; }; i=$(( i + 1 )); done
  # Row 20: a question that is not the usage-limit dialog, without --now. The
  # limit question is dialog-open with the transcript confirming a rate limit.
  if [[ "$now" != 1 ]]; then
    i=0; while [[ $i -lt $N ]]; do
      if [[ "${_HO_STATUS[$i]}" == waiting ]]; then
        local lq=no
        [[ "${_HO_WAIT[$i]}" == dialog-open && "${_HO_LIMIT[$i]}" == 1 ]] && lq=yes
        if [[ "$lq" == yes ]]; then :; else
          if [[ "${_HO_WAIT[$i]}" == permission-prompt ]]; then _HO_VERDICT=R2p; else _HO_VERDICT=R2q; fi
          return 0
        fi
      fi
      i=$(( i + 1 ))
    done
  fi
  # Row 21: a named target with no working login.
  if [[ "$acct" != "$_ACCOUNT_DEFAULT" ]]; then
    if ! _account_exists "$acct"; then _HO_VERDICT=R6; return 0; fi
    state="$(_account_auth_state "$acct")"
    if [[ "$state" == "signed out" || "$state" == "re-login" ]]; then _HO_VERDICT=R6; return 0; fi
  fi
  # Row 22 (R-context): a conversation in the compaction band with no sign of
  # 1M context. The band's floor is one auto-compact buffer below the standard
  # window (STD_WINDOW - COMPACT_BUFFER = 187000), the size at which reopening
  # in the standard window would compact the conversation into a summary. A last
  # real usage at or above the floor with an empty model carry means cleat cannot
  # prove 1M ran, so it refuses. A size above the window is already covered: H7
  # gives _resume_model_carry a non-empty <model>[1m], so the guard below is
  # false and the reopen carries 1M instead of refusing.
  local ctx_floor=$(( _HANDOFF_STD_WINDOW_TOKENS - _HANDOFF_COMPACT_BUFFER_TOKENS ))
  i=0; while [[ $i -lt $N ]]; do
    tfile="$sdir/${_HO_SID[$i]}.jsonl"
    if ! _resume_model_in_settings "$project" && [[ -z "$(_resume_model_carry "$tfile")" ]]; then
      local ctx; ctx="$(_handoff_context_tokens "$tfile" 2>/dev/null || true)"
      if [[ -n "$ctx" ]]; then case "$ctx" in *[!0-9]*) : ;; *) [[ "$ctx" -ge $ctx_floor ]] && { _HO_VERDICT=R7; return 0; } ;; esac; fi
    fi
    i=$(( i + 1 ))
  done
  # Per-target expect for the terminate exec.
  i=0; while [[ $i -lt $N ]]; do
    if [[ "${_HO_STATUS[$i]}" == waiting && "${_HO_WAIT[$i]}" == dialog-open && "${_HO_LIMIT[$i]}" == 1 ]]; then _HO_EXPECT[$i]=limitq
    elif [[ "$now" == 1 && ( "${_HO_STATUS[$i]}" == busy || "${_HO_STATUS[$i]}" == waiting ) ]]; then _HO_EXPECT[$i]=now
    else _HO_EXPECT[$i]=idle; fi
    i=$(( i + 1 ))
  done
  if [[ "$acct" != "$_ACCOUNT_DEFAULT" ]]; then
    _HO_TARGET_PLAN="$(_account_cred_str "$(_account_cred_path "$acct")" subscriptionType 2>/dev/null || true)"
  fi
  _HO_VERDICT=ok; _HO_N=$N
}

# The staged login the switch just wrote, verified on the host's own disk: a
# named target must leave a claudeAiOauth object staged, the shared login must
# leave none. rc 1 on a mismatch or a file that exists but cannot be read.
_handoff_verify_staged() {
  local cname="$1" acct="$2" staged obj
  staged="$(_account_box_auth_dir "$cname")/.credentials.json"
  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    [[ ! -e "$staged" ]] && return 0
    [[ -f "$staged" && ! -L "$staged" ]] || return 1
    obj="$(head -c "$_ACCOUNT_CRED_MAX_BYTES" "$staged" 2>/dev/null | _json_flat_object claudeAiOauth)"
    [[ -z "$obj" ]]
    return $?
  fi
  [[ -f "$staged" && ! -L "$staged" ]] || return 1
  obj="$(head -c "$_ACCOUNT_CRED_MAX_BYTES" "$staged" 2>/dev/null | _json_flat_object claudeAiOauth)"
  [[ -n "$obj" ]]
}

# Write a ready ticket for every target the terminate exec reported as EXITED
# or still ALIVE. An exited target reopens on TO. A survivor (still alive after
# the kill wait) reopens too (4.4 row 27): its ticket is written so its own
# terminal 1 reopens it on TO once it finally stops, within the ticket age
# bound. A gone or never-signalled target ended on its own or was never touched,
# so its ticket is removed: neither reopens. On every branch that reaches here
# except a landed switch the survivor set is empty (row 27 returns first), so TO
# is the old login and only the exited targets have a ticket to write.
# TO is the account the relaunch should read the pin for.
_handoff_write_ready() {
  local cname="$1" toacct="$2" i=0
  while [[ $i -lt ${#_HO_PID[@]} ]]; do
    case "$_PT_EXITED$_PT_ALIVE" in
      *" ${_HO_PID[$i]} "*) _handoff_ticket_write "$cname" "${_HO_EXEC[$i]}" ready "${_HO_SID[$i]}" "$toacct" || true ;;
      *) rm -f "$CLEAT_RUN_DIR/$cname/.handoff.${_HO_EXEC[$i]}" 2>/dev/null || true ;;
    esac
    i=$(( i + 1 ))
  done
}

# Remove the tickets this run wrote, by exec id.
_handoff_tickets_remove() {
  local cname="$1"; shift
  local rd="$CLEAT_RUN_DIR/$cname" e
  for e in "$@"; do
    _handoff_id_ok "$e" && rm -f "$rd/.handoff.$e" 2>/dev/null || true
  done
}

# The confirm question and its yes rule. Without --now an empty answer is yes
# ([Y/n]); with --now the default flips to no ([y/N]). EOF (_ask_yn returns n)
# is always no.
_handoff_question_prompt() {
  local n="$1" now="$2" q d
  if [[ $n -ge 3 ]]; then q="Hand all ${n} over?"; elif [[ $n -eq 2 ]]; then q="Hand both over?"; else q="Hand over?"; fi
  if [[ "$now" == 1 ]]; then d="[y/N] "; else d="[Y/n] "; fi
  printf '%s %s' "$q" "$d"
}
_handoff_yn_yes() {
  local reply="$1" now="$2"
  case "$reply" in [Yy]|[Yy][Ee][Ss]) return 0 ;; esac
  [[ -z "$reply" && "$now" != 1 ]] && return 0
  return 1
}

# ── Live handoff: the copy catalogue (section 3.2) ──────────────────────────

# The disclosure (D1 to D10). Printed whenever N >= 1, before anything changes,
# with or without --yes and with or without a terminal. Reads the _HO_* arrays
# the classify set. BOX ACCT.
_handoff_say_disclosure() {
  local box="$1" acct="$2" n="${_HO_N:-0}" i state bare poss
  bare="$(_handoff_acct_bare "$acct")"; poss="$(_handoff_acct_poss "$acct")"
  _HANDOFF_DISCLOSED=1
  # D1 / D1m
  if [[ $n -ge 2 ]]; then
    warn "${BOLD}${box}${RESET} has ${n} live Claude sessions in other terminals."
  else
    if [[ "${_HO_LIMIT[0]:-0}" == 1 ]]; then state="at its usage limit"
    else case "${_HO_STATUS[0]:-idle}" in
        busy) state="in the middle of a turn" ;;
        waiting) state="waiting for an answer" ;;
        *) state="idle" ;;
      esac
    fi
    warn "${BOLD}${box}${RESET} has a live Claude session in another terminal (${state})."
  fi
  # D2 / D2m
  if [[ $n -ge 3 ]]; then
    echo -e "    ${DIM}Handing all ${n} over to ${bare} restarts each in its own terminal and reopens its own conversation.${RESET}"
  elif [[ $n -eq 2 ]]; then
    echo -e "    ${DIM}Handing both over to ${bare} restarts each in its own terminal and reopens its own conversation.${RESET}"
  else
    echo -e "    ${DIM}Handing it over to ${bare} restarts it there and reopens the same conversation.${RESET}"
  fi
  # D3
  if [[ $n -ge 2 ]]; then
    echo -e "    ${DIM}Anything typed in them but not sent is lost.${RESET}"
  else
    echo -e "    ${DIM}Anything typed there but not sent is lost.${RESET}"
  fi
  # D4
  if [[ $n -ge 2 ]]; then
    echo -e "    ${DIM}Any background agent or monitor they run in this box stops with them.${RESET}"
  else
    echo -e "    ${DIM}Any background agent or monitor it runs in this box stops with it.${RESET}"
  fi
  # D5 / D6, only with --now
  if [[ "${_HO_NOW_FLAG:-0}" == 1 ]]; then
    local any_busy=0 any_perm=0 any_q=0
    i=0; while [[ $i -lt $n ]]; do
      case "${_HO_STATUS[$i]:-}" in
        busy) any_busy=1 ;;
        waiting)
          if [[ "${_HO_LIMIT[$i]:-0}" != 1 ]]; then
            if [[ "${_HO_WAIT[$i]:-}" == permission-prompt ]]; then any_perm=1; else any_q=1; fi
          fi
          ;;
      esac
      i=$(( i + 1 ))
    done
    [[ $any_busy -eq 1 ]] && echo -e "    ${DIM}Its reply so far and any running tool are lost. It can start a turn by itself when it reopens.${RESET}"
    [[ $any_perm -eq 1 ]] && echo -e "    ${DIM}The tool it is asking about does not run.${RESET}"
    [[ $any_q -eq 1 ]] && echo -e "    ${DIM}The question it is showing closes unanswered.${RESET}"
  fi
  # D7
  if [[ $n -ge 2 ]]; then
    echo -e "    ${DIM}The first reply on ${bare} in each may read its whole conversation again without a prompt cache. That can use a large share of ${poss} usage.${RESET}"
  else
    echo -e "    ${DIM}The first reply on ${bare} may read the whole conversation again without a prompt cache. That can use a large share of ${poss} usage.${RESET}"
  fi
  # D8
  if [[ "$_HO_TARGET_PLAN" == pro ]]; then
    echo -e "    ${DIM}${bare} is on a Pro plan. cleat cannot tell whether that plan keeps 1M context.${RESET}"
  fi
  # D9: per session, its last permission mode
  i=0; while [[ $i -lt $n ]]; do
    case "${_HO_MODE[$i]:-}" in
      plan|acceptEdits|auto|dontAsk) echo -e "    ${DIM}It was in ${_HO_MODE[$i]} mode. Check its mode there after it reopens.${RESET}" ;;
    esac
    i=$(( i + 1 ))
  done
  # D10: a Claude Code version cleat has not checked this handoff against
  i=0; while [[ $i -lt $n ]]; do
    local v="${_HO_VER[$i]:-}"
    if [[ -n "$v" ]]; then
      case " $_HANDOFF_VERIFIED_CLAUDE " in
        *" $v "*) : ;;
        *) echo -e "    ${DIM}cleat has checked this handoff with Claude Code ${_HANDOFF_VERIFIED_CLAUDE}. This box runs ${v}.${RESET}" ;;
      esac
    fi
    i=$(( i + 1 ))
  done
}

# A refusal by id. ID BOX X, where X is the account the line names (the target
# for R1 to R7, R15, R16, R18, R22, the old pin for R12). R4, R5, R5i and R17
# print through _account_live_refusal at the call site.
_handoff_say_refusal() {
  local id="$1" box="$2" x="${3:-}"
  case "$id" in
    R1)
      error "${BOLD}${box}${RESET} is in the middle of a turn in another terminal."
      echo -e "    ${DIM}Wait for it to finish, then run this again. To restart it now, add --now: its reply so far and any running tool are lost.${RESET}"
      echo -e "    ${DIM}Nothing was changed.${RESET}"
      ;;
    R2p)
      error "${BOLD}${box}${RESET} is waiting for an answer in another terminal."
      echo -e "    ${DIM}Answer it there, then run this again. To restart it now, add --now: the tool it is asking about does not run.${RESET}"
      echo -e "    ${DIM}Nothing was changed.${RESET}"
      ;;
    R2q)
      error "${BOLD}${box}${RESET} is waiting for an answer in another terminal."
      echo -e "    ${DIM}Answer it there, then run this again. To restart it now, add --now: the question there closes unanswered.${RESET}"
      echo -e "    ${DIM}Nothing was changed.${RESET}"
      ;;
    R3)
      error "${BOLD}${box}${RESET} has background shell commands running in another terminal."
      echo -e "    ${DIM}A restart would stop them and start a new turn on $(_handoff_acct_bare "$x") by itself. Let them finish, then run this again.${RESET}"
      echo -e "    ${DIM}Nothing was changed.${RESET}"
      ;;
    R6)
      error "${BOLD}${x}${RESET} has no working login, so the session in the other terminal would reopen signed out."
      echo -e "    ${DIM}Exit it there. Then run ${BOLD}cleat account ${x}${RESET}${DIM}, ${BOLD}cleat login${RESET}${DIM} and ${BOLD}cleat resume${RESET}${DIM}.${RESET}"
      echo -e "    ${DIM}Nothing was changed.${RESET}"
      ;;
    R7)
      error "${BOLD}${box}${RESET}'s conversation is larger than a standard context window."
      echo -e "    ${DIM}cleat found no sign it ran with 1M context, so it would reopen without it and could compact or fail.${RESET}"
      echo -e "    ${DIM}Set the model it ran on, with [1m], in ${BOLD}~/.claude/settings.json${RESET}${DIM} and run this again. Nothing was changed.${RESET}"
      ;;
    R9)
      error "The Claude session in ${BOLD}${box}${RESET} changed while you were answering."
      echo -e "    ${DIM}Nothing was changed. Run this again to see what it is doing now.${RESET}"
      ;;
    R11)
      error "Claude Code in ${BOLD}${box}${RESET} is still refreshing its login."
      echo -e "    ${DIM}Nothing was changed. Try again in a moment.${RESET}"
      ;;
    R12)
      error "The Claude session in ${BOLD}${box}${RESET} did not stop within ${_HB_KILL_WAIT_S} seconds, so ${BOLD}${box}${RESET} stays on $(_handoff_acct_phrase "$x")."
      echo -e "    ${DIM}It reopens there on $(_handoff_acct_bare "$x") once it stops. Nothing was switched.${RESET}"
      ;;
    R13)
      error "A Claude session started in ${BOLD}${box}${RESET} during the switch."
      echo -e "    ${DIM}Nothing was changed. Run this again.${RESET}"
      ;;
    R14)
      error "${BOLD}${box}${RESET} still holds a login from an earlier switch that could not be saved."
      echo -e "    ${DIM}Nothing was changed. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
      ;;
    R15)
      info "${BOLD}${box}${RESET} is already on $(_handoff_acct_phrase "$x")."
      ;;
    R16)
      error "cleat could not read the login stored as ${BOLD}${x}${RESET}."
      echo -e "    ${DIM}Nothing was changed. Check it with ${BOLD}cleat account list${RESET}${DIM}.${RESET}"
      ;;
    R18)
      error "${BOLD}${box}${RESET} is still reopening a session from an earlier switch."
      echo -e "    ${DIM}Nothing was changed. Run this again in a moment.${RESET}"
      ;;
    R19)
      error "An earlier account switch in ${BOLD}${box}${RESET} is still finishing."
      echo -e "    ${DIM}Nothing was changed. Run this again in a minute.${RESET}"
      ;;
    R20)
      error "The clock in ${BOLD}${box}${RESET} is behind this computer's clock, so cleat cannot time the switch safely."
      echo -e "    ${DIM}Nothing was changed. Restart Docker, then run this again.${RESET}"
      ;;
    R21)
      error "The switch in ${BOLD}${box}${RESET} took too long to start."
      echo -e "    ${DIM}Nothing was changed. Try again in a moment.${RESET}"
      ;;
    R22)
      error "A Claude session is starting in ${BOLD}${box}${RESET} in another terminal."
      echo -e "    ${DIM}Nothing was changed. Run this again once it is up.${RESET}"
      ;;
  esac
}

# A result line by id. ID BOX X (X is the target for S1/S3, the old pin for Q2).
_handoff_say_result() {
  local id="$1" box="$2" x="${3:-}" n="${4:-1}"
  case "$id" in
    S1)  success "${BOLD}${box}${RESET} is now on account ${BOLD}${x}${RESET}" ;;
    S1d) success "${BOLD}${box}${RESET} is back on your shared login ${DIM}(~/.claude)${RESET}" ;;
    S3)  echo -e "    ${DIM}The session in the other terminal is reopening on $(_handoff_acct_bare "$x").${RESET}" ;;
    S3m) echo -e "    ${DIM}The ${n} sessions in other terminals are reopening on $(_handoff_acct_bare "$x").${RESET}" ;;
    S4r) echo -e "    ${DIM}It has no login yet. Run ${BOLD}cleat login${RESET}${DIM} to sign in. It is remembered under this name.${RESET}" ;;
    Q2)  info "Kept. ${BOLD}${box}${RESET} stays on $(_handoff_acct_phrase "$x")." ;;
  esac
}

# A warning after the signal, by id. The targets were stopped, so these are not
# refusals. ID BOX OLD [ACCT|HELDID].
_handoff_say_warn() {
  local id="$1" box="$2" old="${3:-}" extra="${4:-}"
  case "$id" in
    W1)
      warn "A new Claude session started in ${BOLD}${box}${RESET} during the switch, so ${BOLD}${box}${RESET} stays on $(_handoff_acct_phrase "$old")."
      echo -e "    ${DIM}The session in the other terminal is reopening on $(_handoff_acct_bare "$old").${RESET}"
      ;;
    W2)
      error "cleat could not confirm the new login in ${BOLD}${box}${RESET}, so it stays on $(_handoff_acct_phrase "$old")."
      echo -e "    ${DIM}The session in the other terminal is reopening on $(_handoff_acct_bare "$old").${RESET}"
      ;;
    W3)
      warn "The switch in ${BOLD}${box}${RESET} did not report back. The new login is in place, so ${BOLD}${box}${RESET} is now on account ${BOLD}${extra}${RESET}."
      ;;
    W4)
      error "The switch in ${BOLD}${box}${RESET} did not report back. ${BOLD}${box}${RESET} stays on $(_handoff_acct_phrase "$old")."
      ;;
    W34second)
      echo -e "    ${DIM}The session in the other terminal did not reopen. Run ${BOLD}cleat resume${RESET}${DIM} there.${RESET}"
      ;;
    W5)
      warn "The login ${BOLD}${old}${RESET} had in ${BOLD}${box}${RESET} could not be saved."
      echo -e "    ${DIM}It stays in ${box}'s auth folder until the next session there ends. The box can read it until then.${RESET}"
      ;;
    W6)
      warn "${BOLD}${box}${RESET} could not clear account ${BOLD}${old}${RESET}'s name before the restart."
      echo -e "    ${DIM}The session in the other terminal tries again before it reopens and warns there if that fails too.${RESET}"
      ;;
    W7)
      warn "The switch in ${BOLD}${box}${RESET} ran out of time, so ${BOLD}${box}${RESET} stays on $(_handoff_acct_phrase "$old")."
      echo -e "    ${DIM}The session in the other terminal is reopening on $(_handoff_acct_bare "$old").${RESET}"
      ;;
    W10)
      warn "Another cleat command took over while ${BOLD}${box}${RESET} was switching."
      echo -e "    ${DIM}cleat left the switch for the next session start to finish. See where ${box} is with ${BOLD}cleat account list${RESET}${DIM}.${RESET}"
      ;;
    W11)
      warn "The login ${BOLD}${old}${RESET} had in ${BOLD}${box}${RESET} could not be checked, so cleat kept it aside as held login ${BOLD}${extra}${RESET}."
      echo -e "    ${DIM}See it with ${BOLD}cleat account held${RESET}${DIM}. Bring it back with ${BOLD}cleat account adopt ${extra} ${old}${RESET}${DIM}.${RESET}"
      ;;
  esac
}

# A confirmation line by id, printed once the other terminal has reopened (or
# not). ID ACCT [N] [C|OLD]. The confirmation wait that drives these lands in a
# later milestone; the copy lives here now for the golden file and the mockups.
_handoff_say_confirm() {
  local id="$1" acct="${2:-}" n="${3:-1}" c="${4:-0}"
  local bare; bare="$(_handoff_acct_bare "$acct")"
  case "$id" in
    C1)  echo -e "    ${DIM}It reopened on ${bare}. Type continue there.${RESET}" ;;
    C1b) echo -e "    ${DIM}It reopened on ${bare}.${RESET}" ;;
    C2)  echo -e "    ${DIM}The usage limit lines there are from before the restart. Nothing is scheduled.${RESET}" ;;
    C2b) echo -e "    ${DIM}The usage limit lines there are from before the restart.${RESET}" ;;
    C3)  echo -e "    ${DIM}It reopened on ${bare} and is showing a question first. Answer it there before you type anything.${RESET}" ;;
    C4)  echo -e "    ${DIM}It reopened on ${bare} and started a turn by itself. Check it there before you type.${RESET}" ;;
    C5)  echo -e "    ${DIM}All ${n} reopened on ${bare}. Type continue in each.${RESET}" ;;
    C6)  echo -e "    ${DIM}${c} of ${n} reopened on ${bare}. Check the other terminals.${RESET}" ;;
    C7)  warn "The other terminal has not reopened the session after ${_HANDOFF_CONFIRM_WAIT_S} seconds. Check it there." ;;
    C8)  echo -e "    ${DIM}The session in the other terminal had already ended. Resume it there with ${BOLD}cleat resume${RESET}${DIM}.${RESET}" ;;
    C9)  echo -e "    ${DIM}Stopped waiting. Check the other terminal.${RESET}" ;;
    W6b)
      warn "The reopened session may still show account ${BOLD}${c}${RESET}'s name."
      echo -e "    ${DIM}Claude Code may send that account's organization until it is cleared. cleat tries again before the next launch.${RESET}"
      ;;
  esac
}

# The live switch's Ctrl-C trap: record the signal, never ignore it. One line of
# its own so a test runs exactly this. See the comment where _account_handoff
# sets it.
_handoff_int_flag_trap() { trap '_HO_INT=1' INT; }

# ── Live handoff: terminal 2 ────────────────────────────────────────────────
# _account_handoff ACCT BOX CNAME PROJECT ASSUME_YES NOW: hand a running box's
# live Claude session over to ACCT by restart and resume. Called by
# _account_do_switch when the box is up, mounted and has a live agent. Every
# refusal changes nothing and returns 1 (R15 returns 0). On a landed switch it
# moves the pin the offline switch's way, leaves a ready ticket the other
# terminal reopens from and returns 0.
_account_handoff() {
  local acct="$1" box="$2" cname="$3" project="$4" assume_yes="${5:-0}" now="${6:-0}"
  local old key i N execids="" sig_before old2 swrc=0
  old="$(_box_account_read "$cname")"
  key="$(_derive_project_session_key "$project" "$box" 2>/dev/null || true)"

  # Row 4: already on the target.
  if [[ "$acct" == "$old" ]]; then _handoff_say_refusal R15 "$box" "$acct"; return 0; fi
  _HO_SID=()
  # Row 6/7: probe.
  if ! _handoff_probe "$cname"; then
    _account_live_refusal "cleat could not tell what the Claude session in ${BOLD}${box}${RESET} is doing."
    return 1
  fi
  # Row 5: a ticket of this box is still reopening. Checked AFTER the probe: a
  # ready ticket whose session is already back in the probe's live set has
  # finished reopening, and with the live set still empty every such ticket read
  # as pending, so a second switch within the ticket's age window was refused.
  if _handoff_tickets_pending "$cname"; then _handoff_say_refusal R18 "$box" "$acct"; return 1; fi
  # Rows 8a to 22.
  _HO_NOW_FLAG="$now"; _HANDOFF_DISCLOSED=0
  _handoff_classify "$cname" "$now" "$project" "$acct"
  case "$_HO_VERDICT" in
    R1|R2p|R2q|R7|R22|R6) _handoff_say_refusal "$_HO_VERDICT" "$box" "$acct"; return 1 ;;
    R3) _handoff_say_refusal R3 "$box" "$acct"; return 1 ;;
    R4)
      _account_live_refusal "${BOLD}${box}${RESET} has a Claude session that cleat cannot reopen."
      echo -e "    ${DIM}Sessions started by hand in cleat shell, by an older cleat, by cleat login or without a terminal are not restarted for you.${RESET}"
      return 1 ;;
    R5)
      _account_live_refusal "cleat could not tell what the Claude session in ${BOLD}${box}${RESET} is doing."
      return 1 ;;
    ok|quiet) : ;;
    *) _account_live_refusal "cleat could not tell what the Claude session in ${BOLD}${box}${RESET} is doing."; return 1 ;;
  esac
  N="$_HO_N"
  sig_before="$(_handoff_probe_signature)"

  # Disclose what is lost, then ask. Both before anything changes (row 23 to 25).
  if [[ $N -ge 1 ]]; then
    _handoff_say_disclosure "$box" "$acct"
    if [[ "$assume_yes" != 1 ]]; then
      if ! _is_interactive; then
        if [[ $N -ge 2 ]]; then
          echo -e "    ${DIM}Nothing was changed. Re-run with ${BOLD}--yes${RESET}${DIM} to hand them over without a question.${RESET}"
        else
          echo -e "    ${DIM}Nothing was changed. Re-run with ${BOLD}--yes${RESET}${DIM} to hand it over without a question.${RESET}"
        fi
        return 1
      fi
      local _ans=""
      _ask_yn _ans "$(_handoff_question_prompt "$N" "$now")"
      if ! _handoff_yn_yes "$_ans" "$now"; then _handoff_say_result Q2 "$box" "$old"; return 0; fi
    fi
  fi

  # From here a Ctrl-C does not abandon the switch: the shell records it and
  # carries on, so a half-finished switch never leaves the box's Claude stopped
  # with the pin unmoved. A FLAG trap, never an ignore. An ignored INT is
  # inherited by every child and makes a blocking open unkillable, and the
  # `[[ -f && ! -L ]]` guards in front of the credential reads are
  # check-then-open: a FIFO the box swaps in after the check still blocks
  # _account_snapshot_cred, under the account lock. A trapped signal resets to
  # the default in children, so a Ctrl-C kills that blocked read and the switch
  # reaches its existing failure path. The terminate exec runs as an async job,
  # which a non-interactive shell starts with INT ignored under either trap.
  # INT only, so every `trap - INT` below restores exactly what this set.
  _HO_INT=0
  _handoff_int_flag_trap

  local rc_lock=0
  _account_lock || rc_lock=$?
  if [[ $rc_lock -ne 0 ]]; then trap - INT; _account_busy_msg; return 1; fi

  # Row 28: re-read the pin, so a switch that landed while the question was open
  # is never overwritten. Then re-check for a reopen already in flight.
  old2="$(_box_account_read "$cname")"
  if [[ "$old2" != "$old" ]]; then _account_unlock; trap - INT; _handoff_say_refusal R9 "$box" "$acct"; return 1; fi
  if _handoff_tickets_pending "$cname"; then _account_unlock; trap - INT; _handoff_say_refusal R18 "$box" "$acct"; return 1; fi

  # Rows 29 to 30: re-probe under the lock and prove the sessions are unchanged.
  if ! _handoff_probe "$cname"; then _account_unlock; trap - INT; _handoff_say_refusal R5 "$box" "$acct"; return 1; fi
  _handoff_classify "$cname" "$now" "$project" "$acct"
  if [[ "$_HO_VERDICT" != ok && "$_HO_VERDICT" != quiet ]] || [[ "$(_handoff_probe_signature)" != "$sig_before" ]]; then
    _account_unlock; trap - INT; _handoff_say_refusal R9 "$box" "$acct"; return 1
  fi
  N="$_HO_N"

  # 4.3 row 19, under the lock and BEFORE the terminate exec: a cleat shell open
  # in another terminal during a move between the shared login and a named
  # account. A claude typed in that shell keeps the login the shell opened with,
  # so a restart would leave the box half switched. Refuse here rather than stop
  # the live session first and hit the same check inside _account_switch_locked
  # only after the terminate. classify cannot see this: its marker check reads
  # kind=claude markers, and a cleat shell marker is kind=shell.
  if { { [[ "$old" == "$_ACCOUNT_DEFAULT" ]] && [[ "$acct" != "$_ACCOUNT_DEFAULT" ]]; } \
       || { [[ "$old" != "$_ACCOUNT_DEFAULT" ]] && [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; }; } \
     && _handoff_shell_open "$cname"; then
    _account_unlock; trap - INT; _handoff_say R-shell-open "$box"; return 1
  fi

  # A quiet box (a live non-claude process only): no session to stop, so the
  # offline switch body does the whole move.
  if [[ $N -eq 0 ]]; then
    _account_unlock
    trap - INT
    _HANDOFF_SWITCH_EXECIDS=""
    _account_switch_locked "$acct" "$box" "$cname" "$project" || return 1
    _account_switch_meta "$acct" "$box" "$cname" "$project" "$_SWITCH_CURRENT"
    _account_switch_identity "$acct" "$box" "$cname" "$project" "$_SWITCH_CURRENT"
    if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then _handoff_say_result S1d "$box"; else _handoff_say_result S1 "$box" "$acct"; fi
    return 0
  fi

  # Rows 32 to 34: write a requested ticket per target BEFORE the signalling
  # exec, so the other terminal reads "switching" and never relaunches on the
  # login this switch is about to replace. Then confirm the lock is still ours.
  _handoff_tickets_sweep "$cname"
  i=0; while [[ $i -lt $N ]]; do
    _handoff_ticket_write "$cname" "${_HO_EXEC[$i]}" requested "${_HO_SID[$i]}" "$acct" || true
    execids="$execids ${_HO_EXEC[$i]}"
    i=$(( i + 1 ))
  done
  if ! _account_lock_owned; then
    _handoff_tickets_remove "$cname" $execids
    _account_unlock; trap - INT; _handoff_say_warn W10 "$box"; return 1
  fi

  # Row 35: stop the box's session. The single docker call the lock permits.
  local store=default; [[ "$old" != "$_ACCOUNT_DEFAULT" ]] && store=named
  local termout; termout="$(mktemp "${TMPDIR:-/tmp}/cleat-hterm.XXXXXX" 2>/dev/null)" || {
    _handoff_tickets_remove "$cname" $execids; _account_unlock; trap - INT
    _handoff_say_refusal R5 "$box" "$acct"; return 1; }
  local targv=() trc=0
  i=0; while [[ $i -lt $N ]]; do
    targv+=( "${_HO_PID[$i]}" "${_HO_PS[$i]}" "${_HO_SID[$i]}" "${_HO_EXEC[$i]}" "${_HO_EXPECT[$i]}" )
    i=$(( i + 1 ))
  done
  _handoff_docker_exec "$cname" "$_HANDOFF_EXEC_TIMEOUT_S" "$termout" \
    terminate /home/coder /proc "$store" "$_HB_LOCK_WAIT_S" "$_HB_KILL_WAIT_S" "$N" "${targv[@]}" || trc=$?

  # An age-bound steal could have handed the lock to another command during a
  # slow exec, so re-confirm before any write.
  if ! _account_lock_owned; then
    rm -f "$termout" 2>/dev/null || true
    _handoff_tickets_remove "$cname" $execids
    _account_unlock; trap - INT; _handoff_say_warn W10 "$box"; return 1
  fi
  local perc=0
  _parse_terminate "$termout" || perc=$?
  rm -f "$termout" 2>/dev/null || true

  # A failed, timed-out or garbled exec staged nothing, so the box stays on old.
  if [[ $trc -ne 0 || $perc -ne 0 ]]; then
    _handoff_tickets_remove "$cname" $execids
    _account_unlock; trap - INT
    _handoff_say_warn W4 "$box" "$old"; _handoff_say_warn W34second "$box"
    return 1
  fi
  case "$_PT_ARGS" in bad) _handoff_tickets_remove "$cname" $execids; _account_unlock; trap - INT; _handoff_say_refusal R5 "$box" "$acct"; return 1 ;; esac
  case "$_PT_LOCK" in timeout) _handoff_tickets_remove "$cname" $execids; _account_unlock; trap - INT; _handoff_say_refusal R11 "$box"; return 1 ;; esac
  case "$_PT_RECHECK" in changed) _handoff_tickets_remove "$cname" $execids; _account_unlock; trap - INT; _handoff_say_refusal R9 "$box" "$acct"; return 1 ;; esac
  # A survivor: nothing was stopped for it, so the pin never moves. Every exited
  # target and the survivor itself get a ready ticket for the old login (4.4 row
  # 27), so each reopens there, the survivor once it finally stops within the
  # ticket age bound.
  if [[ "$_PT_ANY_ALIVE" == 1 ]]; then
    _handoff_write_ready "$cname" "$old"
    _account_unlock; trap - INT
    _handoff_say_refusal R12 "$box" "$old"
    return 1
  fi
  if [[ "$_PT_SCAN" == changed ]]; then
    _handoff_write_ready "$cname" "$old"
    _account_unlock; trap - INT
    _handoff_say_warn W1 "$box" "$old"
    return 1
  fi
  if [[ "$_PT_END" != ok ]]; then
    _handoff_tickets_remove "$cname" $execids
    _account_unlock; trap - INT
    _handoff_say_warn W4 "$box" "$old"; _handoff_say_warn W34second "$box"
    return 1
  fi

  # Every target stopped cleanly: move the login the offline switch's way, with
  # this run's exec ids passed so its starting-marker guard skips our own live
  # attach markers.
  _HANDOFF_SWITCH_EXECIDS="$execids"
  _account_switch_locked "$acct" "$box" "$cname" "$project" || swrc=$?
  _HANDOFF_SWITCH_EXECIDS=""
  if [[ $swrc -ne 0 ]]; then
    _handoff_write_ready "$cname" "$old"
    _account_unlock; trap - INT
    return 1
  fi
  if ! _account_lock_owned; then _account_unlock; trap - INT; _handoff_say_warn W10 "$box"; return 1; fi
  _account_switch_identity "$acct" "$box" "$cname" "$project" "$_SWITCH_CURRENT"
  local _id_rc=$_SWITCH_ID_RC

  # Host-verify the staged login, settle, verify again. A revert rolls back.
  if ! _handoff_verify_staged "$cname" "$acct"; then
    _handoff_settle_pause
    if ! _handoff_verify_staged "$cname" "$acct"; then
      _account_release_staged_locked "$cname" 2>/dev/null || true
      if [[ "$old" == "$_ACCOUNT_DEFAULT" ]]; then _box_account_remove "$cname"; else _box_account_write "$cname" "$old" "$key" || true; fi
      _handoff_write_ready "$cname" "$old"
      _account_unlock; trap - INT
      _handoff_say_warn W2 "$box" "$old"
      return 1
    fi
  fi

  # Ready tickets, written AFTER the pin moved and BEFORE the meta capture: only
  # the sessions that exited reopen. They reopen on the new login.
  _handoff_write_ready "$cname" "$acct"
  _account_unlock
  trap - INT

  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    _handoff_say_result S1d "$box"
  else
    _handoff_say_result S1 "$box" "$acct"
    local who=""
    if [[ "$_SWITCH_FRESH" == 1 || "$(_account_auth_state "$acct")" == "signed out" ]]; then
      _handoff_say_result S4r "$box"
    else
      who="$(_account_meta_get "$acct" who 2>/dev/null || true)"
      [[ -n "$who" ]] && echo -e "    ${DIM}$(_sessions_safe_title "$who")${RESET}"
    fi
  fi
  [[ $_id_rc -eq 3 ]] && _handoff_say_warn W6 "$box" "$old"
  if [[ $N -ge 2 ]]; then _handoff_say_result S3m "$box" "$acct" "$N"; else _handoff_say_result S3 "$box" "$acct"; fi

  _account_capture_meta "$acct" || true
  [[ "$old" != "$_ACCOUNT_DEFAULT" ]] && { _account_usage_fetch "$old" >/dev/null 2>&1 || true; }
  return 0
}

_account_live_refusal() {
  error "$1"
  echo -e "    ${DIM}Exit it first. Claude Code only takes a login change in full when it starts.${RESET}"
}

# Set by the three phase functions below for the steps the gate runs after the
# lock is dropped: the account left (empty on the shared branch), whether the
# target store was created here, and the identity-drop return (3 means a live
# Claude was left to finish the drop itself).
_SWITCH_CURRENT=""
_SWITCH_FRESH=0
_SWITCH_ID_RC=0

# The file operations of a switch, run as one hold of the account lock. It is
# the seam the live switch reuses: after it has stopped the box's Claude
# session, the handoff stages the new login through this same body. It harvests
# whatever the box refreshed for the account it is leaving, then either moves
# the pin and stages the incoming login (named) or unpins and drops the staged
# file (shared login). Prints its own error and returns 1 on any failure, having
# released the lock. On success it sets _SWITCH_CURRENT (the account left, empty
# for the shared branch) and _SWITCH_FRESH (1 when the target store was created
# here). Nothing that reads the network, a project file or docker runs here: the
# gate does that after the unlock.
_account_switch_locked() {
  local acct="$1" box="$2" cname="$3" project="$4" current fresh=0 stage_mode=""
  _SWITCH_CURRENT=""
  _SWITCH_FRESH=0
  # From the pin read to the staging is one hold of the account lock. An attach
  # or a session end in another terminal waits for it and then reads the pin
  # again, instead of staging or harvesting against the account this switch is
  # leaving. Every error return below releases it first.
  if ! _account_lock; then
    _account_busy_msg
    return 1
  fi
  # 4.3 rows 18 and 19, under this lock. A session coming up in another terminal
  # (R-starting) or a cleat shell open across a move between the shared login and
  # an account (R-shell-open) would each take only part of the login change, so
  # the switch refuses and changes nothing. The live handoff runs these ahead of
  # its terminate exec too; here they guard the offline switch, which has no
  # probe records, so any live claude marker counts as starting.
  # _HANDOFF_SWITCH_EXECIDS is empty offline and holds the live path's probe ids.
  current="$(_box_account_read "$cname")"
  if [[ -n "$(_handoff_starting_markers "$cname" ${_HANDOFF_SWITCH_EXECIDS:-})" ]]; then
    _account_unlock
    _handoff_say R-starting "$box"
    return 1
  fi
  if { { [[ "$current" == "$_ACCOUNT_DEFAULT" ]] && [[ "$acct" != "$_ACCOUNT_DEFAULT" ]]; } \
       || { [[ "$current" != "$_ACCOUNT_DEFAULT" ]] && [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; }; } \
     && _handoff_shell_open "$cname"; then
    _account_unlock
    _handoff_say R-shell-open "$box"
    return 1
  fi
  # H9: flag the box's identity stale BEFORE the pin moves, so a relaunch that
  # reads the new pin can never read the old account name. Batch 11 clears the
  # flag once identity is rebuilt (or _account_switch_identity does, after a
  # drop that returns 0). A live drop returns 3 and leaves the flag for the box.
  _handoff_flag_identity_stale "$project" "$box"
  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    # The unpin deletes the staged file, so whatever the harvest does not take
    # is held first, and a login that cannot be kept stops the switch.
    if ! _account_release_staged_locked "$cname"; then
      _account_unlock
      error "Could not keep the login ${BOLD}${box}${RESET} holds."
      echo -e "    ${DIM}Nothing was switched. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
      return 1
    fi
    _box_account_remove "$cname"
    _account_strip_staged "$cname"
    _account_unlock
    return 0
  fi
  current="$(_box_account_read "$cname")"
  _SWITCH_CURRENT="$current"
  # Harvest whatever the box refreshed for the account it is leaving, BEFORE
  # anything is repointed. Skipping this loses every refresh since the switch in.
  # When the pin moves, the account's keys in the staged file are replaced below,
  # so whatever the harvest does not take is held first (a login made in the box
  # as someone else, a failed store write, or a login staged in a box that was
  # never pinned). A login that cannot be kept stops the switch before anything
  # moves. Nothing but a mkdir runs between this and the pin write, so it is the
  # last harvest before the rename. The plan and usage reads come after the
  # unlock.
  if [[ "$current" == "$acct" ]]; then
    _account_sync_out_locked "$cname" || true
  elif ! _account_release_staged_locked "$cname"; then
    _account_unlock
    error "Could not keep the login ${BOLD}${box}${RESET} holds."
    echo -e "    ${DIM}Nothing was switched. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
    return 1
  fi

  # Whenever the pin actually moves, the incoming account always wins. Only its
  # keys are replaced, by one rename, so the box's own MCP logins stay and there
  # is never a moment with no credential file. See _account_sync_in_locked. The
  # staging this replaced removed the staged file first: that erased the box's
  # MCP logins and left about 25 ms in which a Claude the live gate missed read
  # "Not logged in".
  if [[ "$current" != "$acct" ]]; then
    stage_mode=force
  fi
  if ! _account_exists "$acct"; then
    _account_ensure_dir "$acct" || { _account_unlock; error "Could not create the account store."; return 1; }
    fresh=1
  fi
  _SWITCH_FRESH=$fresh
  _box_account_write "$cname" "$acct" "$(_derive_project_session_key "$project" "$box")" \
    || { _account_unlock; error "Could not pin the account to this box."; return 1; }
  if ! _account_sync_in_locked "$cname" "$stage_mode"; then
    # Nothing was removed, so the staged file still holds the login of the
    # account being left. The pin goes back with it, or the next detach
    # harvests that login INTO the account this switch was going to.
    if [[ "$current" == "$_ACCOUNT_DEFAULT" ]]; then
      _box_account_remove "$cname"
    else
      _box_account_write "$cname" "$current" "$(_derive_project_session_key "$project" "$box")" || true
    fi
    _account_unlock
    # Re-selecting the account a box is already on stages over a login the
    # store does not have only once it is held.
    if [[ $_ACCOUNT_STAGE_UNKEPT -eq 1 ]]; then
      error "Could not keep the login ${BOLD}${box}${RESET} holds."
      echo -e "    ${DIM}Nothing was switched. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
    else
      error "Could not stage the credential for this box."
    fi
    return 1
  fi
  _account_unlock
  return 0
}

# The plan and last_used for both accounts, plus the outgoing account's usage.
# Runs AFTER the unlock: it reads the network and the usage poll in particular
# can take three seconds. Sitting between the harvest and the staging, it left a
# window where a refresh the box saved was deleted without being harvested.
# Neither capture reads the box's project file: a file the box writes cannot say
# whose login it is, so it once named a brand-new account with the maintainer's
# primary email (found on a real Mac, 2026-09-12) and stamped each incoming
# account with the previous login's. Who an account is comes only from a harvest
# the server vouched for.
_account_switch_meta() {
  local acct="$1" box="$2" cname="$3" project="$4" current="$5"
  _account_capture_meta "$current" || true
  _account_capture_meta "$acct" || true
  if [[ "$current" != "$_ACCOUNT_DEFAULT" ]]; then
    _account_usage_fetch "$current" >/dev/null 2>&1 || true
  fi
}

# Drop the account name the box is carrying in its per-project claude.json, so
# the box rebuilds identity for the account just pinned. The start rebuild does
# not reach a running box and the attached heal cannot fix identity, so the
# switch does it itself. The offline switch runs it after the unlock, because it
# edits a file a running box binds. The live switch (_account_handoff) runs it
# before its unlock, while it still holds the lock through the reopen tickets.
# Sets _SWITCH_ID_RC to 3 when a Claude was live and the drop was left for the
# box to finish, else 0.
_account_switch_identity() {
  local acct="$1" box="$2" cname="$3" project="$4" current="$5"
  local _id_rc=0
  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    # This branch always invalidates: the unpin empties the box store, so the
    # name it shows has to be dropped whatever it was.
    _account_invalidate_identity "$project" "$box" "$cname" || _id_rc=$?
    _SWITCH_ID_RC=$_id_rc
    return 0
  fi
  [[ "$current" != "$acct" ]] && { _account_invalidate_identity "$project" "$box" "$cname" || _id_rc=$?; }
  _SWITCH_ID_RC=$_id_rc
}

_account_do_switch() {
  local acct="$1" box="$2" cname="$3" project="$4" assume_yes="${5:-0}" now="${6:-0}"
  if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
    # A running box with the account mount and a live session is handed over by
    # restart and resume (_account_handoff), which stops the session, unpins,
    # then leaves the other terminal to reopen. Without the mount the switch
    # cannot take effect, so a live session there is refused as before: a bare
    # unpin would empty the box store and sign the running session out.
    if _daemon_up && container_exists "$cname" && is_running "$cname" && _box_has_live_agent "$cname"; then
      if _account_box_ready "$cname"; then
        _account_handoff "$acct" "$box" "$cname" "$project" "$assume_yes" "$now"
        return $?
      fi
      _account_live_refusal "${BOLD}${box}${RESET} has a live Claude session."
      return 1
    fi
    # The harvest, the unpin and the delete are one hold of the account lock.
    # The identity drop edits a file a running box binds, so it comes after.
    _account_switch_locked "$acct" "$box" "$cname" "$project" || return 1
    _account_switch_identity "$acct" "$box" "$cname" "$project" "$_SWITCH_CURRENT"
    local _id_rc=$_SWITCH_ID_RC
    success "${BOLD}${box}${RESET} is back on your shared login ${DIM}(~/.claude)${RESET}"
    if [[ $_id_rc -eq 3 ]]; then
      # This branch always invalidates, so running it again finishes the job.
      warn "A Claude session started in ${BOLD}${box}${RESET} during the switch, so the account name it shows was left as it was."
      echo -e "    ${DIM}Exit that session and run ${BOLD}cleat account default ${box}${RESET}${DIM} again.${RESET}"
    fi
    echo -e "    ${DIM}Conversations are unchanged. Resuming one started on the other account keeps${RESET}"
    echo -e "    ${DIM}the local transcript and ${BOLD}--resume${RESET}${DIM}. Its server-side history stops being${RESET}"
    echo -e "    ${DIM}backfilled from here on.${RESET}"
    return 0
  fi
  if ! _validate_account_name "$acct"; then
    error "Invalid account name: ${BOLD}${acct}${RESET}"
    echo -e "    ${DIM}Lowercase letters, digits, dash and underscore. Up to 31 characters, starting with a letter or a digit.${RESET}"
    echo -e "    ${DIM}Reserved: list, rename, rm, delete, restore, trash, held, adopt, off, help and default.${RESET}"
    echo -e "    ${DIM}${BOLD}default${RESET}${DIM} is the sentinel for your shared login: ${BOLD}cleat account default${RESET}${DIM} unpins a box.${RESET}"
    return 1
  fi
  # Refused under a live agent. Not because Claude Code undoes the swap (it does
  # not, see _account_live_refusal) but because a running session only takes
  # part of a login change and nothing tells the user which part.
  # Three terms, and every one of them is load-bearing. _box_has_live_agent
  # answers "live" whenever it cannot read docker, which is the safe default
  # where it is used and the wrong one here twice over. With the daemon DOWN no
  # box is running, and this verb is deliberately outside the preflight
  # allowlist so it has to work there. And `docker top` fails on a STOPPED
  # container while `container_exists` (docker ps -a) is true for one, so
  # without is_running every stopped box read as live. That is the normal
  # steady state: the idle sweep stops boxes by itself. The session gate has
  # carried is_running since the day it was written.
  #
  # A running box WITH the account mount is not refused: it is handed over by
  # restart and resume. _account_handoff stops the session in the box, moves the
  # login this same body would, and leaves the other terminal to reopen it.
  # Without the mount a live session is still refused (the pin cannot take
  # effect until a recreate anyway).
  if _daemon_up && container_exists "$cname" && is_running "$cname" && _box_has_live_agent "$cname"; then
    if _account_box_ready "$cname"; then
      _account_handoff "$acct" "$box" "$cname" "$project" "$assume_yes" "$now"
      return $?
    fi
    _account_live_refusal "${BOLD}${box}${RESET} has a live Claude session."
    return 1
  fi

  # One hold of the account lock from the pin read through the staging, then the
  # network reads (meta and usage) and the identity drop, both after the unlock.
  # See _account_switch_locked, _account_switch_meta and _account_switch_identity.
  _account_switch_locked "$acct" "$box" "$cname" "$project" || return 1
  local current="$_SWITCH_CURRENT" fresh="$_SWITCH_FRESH" ready=0
  _account_switch_meta "$acct" "$box" "$cname" "$project" "$current"
  _account_switch_identity "$acct" "$box" "$cname" "$project" "$current"
  local _id_rc=$_SWITCH_ID_RC

  # The pin is DELIBERATELY left in place on this refusal. It has to outlive
  # `cleat rm`, which is exactly the remedy printed below, and the attach path
  # refuses independently (_account_apply_exec_env) so a box with no mount can
  # never be pointed at a store it does not have.
  _account_box_ready "$cname" || ready=$?
  if [[ $ready -eq 1 ]]; then
    warn "${BOLD}${box}${RESET} predates the account mount, so the switch cannot take effect yet."
    echo -e "    ${DIM}Pinned anyway. Recreate the box once: ${BOLD}cleat rm ${box}${RESET}${DIM} then ${BOLD}cleat start ${box}${RESET}${DIM}, and it takes effect.${RESET}"
    echo -e "    ${DIM}Conversations, trust and env are on the host and survive. Anything installed${RESET}"
    echo -e "    ${DIM}INSIDE the box does not, so put it in ${BOLD}[setup]${RESET}${DIM} first if you have any.${RESET}"
    return 1
  fi

  success "${BOLD}${box}${RESET} is now on account ${BOLD}${acct}${RESET}"
  if [[ $_id_rc -eq 3 ]]; then
    # Re-running this switch would NOT finish the job: the pin already reads
    # the new account, so the invalidate is skipped. A stopped box is rebuilt
    # at its next start and a pinned rebuild drops the name, so the stop is
    # what reaches the file safely.
    warn "A Claude session started in ${BOLD}${box}${RESET} during the switch, so the account name it shows was left as it was."
    echo -e "    ${DIM}Exit that session and run ${BOLD}cleat stop ${box}${RESET}${DIM}. Its next start shows ${BOLD}${acct}${RESET}${DIM}.${RESET}"
  fi
  if [[ $fresh -eq 1 || "$(_account_auth_state "$acct")" == "signed out" ]]; then
    echo -e "    ${DIM}It has no login yet. Start the box and run ${BOLD}/login${RESET}${DIM} once. It is remembered under this name.${RESET}"
  else
    local who
    who="$(_account_meta_get "$acct" who 2>/dev/null || true)"
    [[ -n "$who" ]] && echo -e "    ${DIM}$(_sessions_safe_title "$who")${RESET}"
  fi
  # Said once, here, because it is silent when it happens and it surprises
  # people later. Claude Code ties a conversation to the account that started it.
  echo -e "    ${DIM}Conversations are shared. Resuming one started on another account keeps the${RESET}"
  echo -e "    ${DIM}local transcript and ${BOLD}--resume${RESET}${DIM}. Its server-side history stops being${RESET}"
  echo -e "    ${DIM}backfilled from here on.${RESET}"
  return 0
}

_account_do_rename() {
  local old="$1" new="$2"
  if ! _account_exists "$old"; then
    error "No account named ${BOLD}${old}${RESET}."
    return 1
  fi
  if ! _validate_account_name "$new"; then
    error "Invalid account name: ${BOLD}${new}${RESET}"
    echo -e "    ${DIM}Lowercase letters, digits, dash and underscore. Up to 31 characters, starting with a letter or a digit.${RESET}"
    return 1
  fi
  if _account_exists "$new"; then
    error "There is already an account named ${BOLD}${new}${RESET}."
    return 1
  fi
  local rc=0
  _account_rename "$old" "$new" || rc=$?
  if [[ $rc -eq 0 ]]; then
    success "Renamed ${DIM}${old}${RESET} to ${BOLD}${new}${RESET}"
    echo -e "    ${DIM}Every box pinned to it follows.${RESET}"
    return 0
  fi
  if [[ $rc -eq $_ACCOUNT_LOCK_BUSY ]]; then
    _account_busy_msg
    return 1
  fi
  error "Could not rename ${BOLD}${old}${RESET}."
  return 1
}

# Refuse when any box pinned to ACCT has a live Claude session, having said
# why. It asks docker, so it never runs under the account lock.
_account_remove_live_gate() {
  local acct="$1" b
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    if _daemon_up && container_exists "$b" && is_running "$b" && _box_has_live_agent "$b"; then
      _account_live_refusal "A box pinned to ${BOLD}${acct}${RESET} has a live Claude session."
      return 1
    fi
  done <<< "$(_account_pinned_boxes "$acct")"
  return 0
}

_account_do_remove() {
  local acct="$1" assume_yes="${2:-0}" ans pinned b live=0
  if ! _account_exists "$acct"; then
    error "No account named ${BOLD}${acct}${RESET}."
    return 1
  fi
  _account_remove_live_gate "$acct" || return 1
  pinned="$(_account_pinned_boxes "$acct")"
  [[ -n "$pinned" ]] && live=1

  # A box mid-handoff still has a ticket its own terminal will consume to reopen
  # the conversation on this account. Removing the account now would unpin it out
  # from under that reopen, so refuse while any pinned box is still reopening. rm
  # has no probe, so a ready ticket with a live marker counts as pending whatever
  # its sid (5.2). Changes nothing.
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    if _handoff_tickets_pending "$b"; then
      _handoff_say R-reopening "$b"
      return 1
    fi
  done <<< "$pinned"

  warn "This removes the login stored as ${BOLD}${acct}${RESET}"
  local who
  who="$(_account_meta_get "$acct" who 2>/dev/null || true)"
  [[ -n "$who" ]] && echo -e "    ${DIM}$(_sessions_safe_title "$who")${RESET}"
  if [[ $live -eq 1 ]]; then
    echo -e "    ${DIM}Boxes pinned to it go back to your shared login:${RESET}"
    while IFS= read -r b; do
      [[ -n "$b" ]] && echo -e "      ${DIM}${b}${RESET}"
    done <<< "$pinned"
  fi
  echo -e "    ${DIM}It moves to the trash, recoverable for ${_ACCOUNTS_TRASH_DAYS} days with${RESET}"
  echo -e "    ${DIM}${BOLD}cleat account restore ${acct}${RESET}"

  if [[ "$assume_yes" != "1" ]]; then
    if ! _is_interactive; then
      echo ""
      echo -e "    ${DIM}Nothing was removed. Re-run with ${BOLD}--yes${RESET}${DIM} to do this non-interactively.${RESET}"
      return 0
    fi
    _ask_yn ans "Remove it? [y/N] "
    case "$ans" in
      y|Y|yes|YES) : ;;
      *) info "Kept."; return 0 ;;
    esac
  fi

  # The question can stay on screen for as long as the user likes, and a session
  # started meanwhile would be signed out by the delete below. Ask again now,
  # over the boxes pinned now, before the lock (docker never runs under it).
  _account_remove_live_gate "$acct" || return 1

  # The prompt is over, so the lock can be held. Everything read before it is
  # read again: another terminal may have pinned a box to this account, renamed
  # it or removed it while the question was on screen.
  if ! _account_lock; then
    _account_busy_msg
    return 1
  fi
  if ! _account_exists "$acct"; then
    _account_unlock
    error "No account named ${BOLD}${acct}${RESET}."
    return 1
  fi
  pinned="$(_account_pinned_boxes "$acct")"

  # A cleat shell open on a pinned box: a claude started there keeps the login the
  # shell opened with, so the unpin below would leave that box half moved. The
  # switch refuses the same move (R-shell-open), and so does this, under the lock
  # and over the boxes pinned now, before anything is harvested or moved.
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    if _handoff_shell_open "$b"; then
      _account_unlock
      _handoff_say R-shell-open "$b"
      return 1
    fi
  done <<< "$pinned"

  # Harvest what every pinned box refreshed for itself BEFORE the store moves.
  # Afterwards the store path is gone, so a harvest from there is declined
  # (_account_write_cred never creates a store) and the refresh stays behind. A
  # session ended by SIGHUP never ran the session-end harvest, so this is the
  # last chance. The staged files are deleted below, so what the harvest does
  # not take is held, and a login that cannot be kept stops the remove.
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    if ! _account_release_staged_locked "$b"; then
      _account_unlock
      error "Could not keep the login ${BOLD}${b}${RESET} holds for ${BOLD}${acct}${RESET}."
      echo -e "    ${DIM}Nothing was removed. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
      return 1
    fi
  done <<< "$pinned"

  local rc=0
  _account_trash "$acct" || rc=$?
  if [[ $rc -eq 2 ]]; then
    _account_unlock
    error "Refusing to remove: the account trash is not a plain directory."
    echo -e "    ${DIM}Nothing was moved. Check ${CLEAT_ACCOUNTS_DIR}/.trash${RESET}"
    return 1
  fi
  if [[ $rc -ne 0 ]]; then
    _account_unlock
    error "Could not remove ${BOLD}${acct}${RESET}."
    return 1
  fi
  local unpinned="" key tab
  tab="$(printf '\t')"
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    # Read BEFORE the pin file goes, because that is where the key lives. The
    # edit itself asks docker, so it waits until the lock is released.
    key="$(_box_account_key "$b" || true)"
    unpinned="${unpinned}${b}${tab}${key}
"
    _box_account_remove "$b"
    _account_strip_staged "$b"
  done <<< "$pinned"
  _account_unlock
  # The pin moved, so the name each box carries is the removed account's, the
  # same as after a switch back to the shared login. A detached box that is
  # still running is never rebuilt, and on a host whose own ~/.claude.json has
  # no oauthAccount even a restart keeps that name and the sibling scan hands
  # it to boxes in other projects. A pin written before keys were recorded has
  # no key, and that box is fixed by its next switch.
  while IFS="$tab" read -r b key; do
    [[ -n "$b" ]] || continue
    if [[ -n "$key" ]]; then
      _account_invalidate_identity_key "$key" "$b" || true
    fi
  done <<< "$unpinned"
  success "Removed ${BOLD}${acct}${RESET} ${DIM}(recoverable for ${_ACCOUNTS_TRASH_DAYS} days)${RESET}"
  return 0
}

_account_do_restore() {
  local acct="$1"
  if _account_exists "$acct"; then
    error "There is already an account named ${BOLD}${acct}${RESET}."
    echo -e "    ${DIM}Nothing was overwritten.${RESET}"
    return 1
  fi
  local rc=0
  _account_restore "$acct" || rc=$?
  if [[ $rc -eq 0 ]]; then
    success "Restored ${BOLD}${acct}${RESET}"
    echo -e "    ${DIM}Pin a box to it with ${BOLD}cleat account ${acct}${RESET}"
    return 0
  fi
  if [[ $rc -eq $_ACCOUNT_LOCK_BUSY ]]; then
    _account_busy_msg
    return 1
  fi
  error "No removed account named ${BOLD}${acct}${RESET}."
  echo -e "    ${DIM}Trash: ${CLEAT_ACCOUNTS_DIR}/.trash${RESET}"
  return 1
}

# `cleat account adopt <id> <name>`: save a held login as an account, the one
# command that recovers what a wipe, a switch or a remove set aside. The name
# is always explicit. A new name creates that account. An existing one is an
# exchange: the login the store had is held first (replaced-by-adopt), so adopt
# never deletes a login either. The entry goes only after the write.
#
# A box pinned to the name still has the old login staged. That copy is usually
# newer than the one adopted. Swapping only the store file let the next session
# end, attach or `cleat account` write it straight back. The adopted login then
# existed nowhere, because its entry was already gone. So every pinned box is
# released first, the way a switch releases it: its refresh reaches the store
# (and so the copy held as replaced-by-adopt) or it is held itself. Its staged
# copy goes only after the write, so the next attach stages the adopted login.
# The caller refuses a live session on any of those boxes before the lock.
#
# A login the server verified as one person is never saved over an account the
# server verified as another. Both uuids are only ever written from its answer,
# so two known and different ones are two accounts. The adopt refuses (4).
# Replacing an account with a different person's login is `cleat account rm`
# first, then the adopt. An entry or an account with no uuid proves nothing
# either way and is the user's call.
#
# Returns 0 saved, 1 no usable entry or name, 2 a write failed, 3 a pinned box
# holds a login that could not be kept (named in _ACCOUNT_ADOPT_BOX), 4 the
# login belongs to a different account than the name, or _ACCOUNT_LOCK_BUSY.
# Nothing is written or deleted on any status but 0.
_ACCOUNT_ADOPT_REPLACED=""
_ACCOUNT_ADOPT_BOX=""
_account_adopt() { _account_with_lock _account_adopt_locked "$@"; }

_account_adopt_locked() {
  local id="$1" name="$2" entry cred store created=0 k v pinned="" b huuid auuid
  _ACCOUNT_ADOPT_REPLACED=""
  _ACCOUNT_ADOPT_BOX=""
  _validate_account_name "$name" || return 1
  entry="$(_account_held_entry "$id")" || return 1
  cred="$entry/.credentials.json"
  _account_cred_keepable "$cred" || return 1
  huuid="$(_account_meta_get_at "$entry" uuid 2>/dev/null || true)"
  if _account_exists "$name"; then
    auuid="$(_account_meta_get "$name" uuid 2>/dev/null || true)"
    if [[ -n "$huuid" && -n "$auuid" && "$huuid" != "$auuid" ]]; then
      return 4
    fi
  fi
  pinned="$(_account_pinned_boxes "$name")"
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    if ! _account_release_staged_locked "$b"; then
      _ACCOUNT_ADOPT_BOX="$b"
      return 3
    fi
  done <<< "$pinned"
  if _account_exists "$name"; then
    store="$(_account_cred_path "$name")"
    [[ -L "$store" ]] && return 2
    # Held under the identity it was saved with, which is about to be replaced.
    if [[ -f "$store" ]] && _account_cred_plausible "$store"; then
      _account_hold "$store" "$name" "" replaced-by-adopt \
        "$(_account_meta_get "$name" uuid 2>/dev/null || true)" \
        "$(_account_meta_get "$name" who 2>/dev/null || true)" \
        "$(_account_meta_get "$name" org 2>/dev/null || true)" || return 2
      _ACCOUNT_ADOPT_REPLACED="replaced"
    fi
  else
    _account_ensure_dir "$name" || return 2
    created=1
  fi
  if ! _account_write_cred "$name" "$cred"; then
    if [[ $created -eq 1 ]]; then
      rmdir "$(_account_dir "$name")" 2>/dev/null || true
    fi
    return 2
  fi
  while IFS= read -r b; do
    [[ -n "$b" ]] || continue
    _account_strip_staged "$b"
  done <<< "$pinned"
  # The identity is the adopted login's when the server vouched for it (the
  # entry carries a uuid). One the entry does not carry is then cleared, never
  # left naming the login that was replaced. An entry nobody verified proves
  # nothing about whose it is, so it leaves an existing account's identity as
  # it was. Clearing it reopened the first-use harvest on an account that had
  # already been verified: with no uuid to compare, a /login as someone else in
  # a pinned box was written over the adopted login. A wrong-person adopt now
  # costs a held entry at its first rotated harvest, never a login.
  if [[ -n "$huuid" || $created -eq 1 ]]; then
    for k in uuid who org; do
      v="$(_account_meta_get_at "$entry" "$k" 2>/dev/null || true)"
      if [[ -n "$v" || $created -eq 0 ]]; then
        _account_meta_set "$name" "$k" "$v" || true
      fi
    done
  fi
  rm -rf "$entry" 2>/dev/null || true
  return 0
}

_account_do_adopt() {
  local id="$1" name="$2" existed=0 rc=0
  if ! _account_held_id_ok "$id"; then
    error "Not a held login id: ${BOLD}$(_sessions_safe_str "$id")${RESET}"
    echo -e "    ${DIM}Run ${BOLD}cleat account held${RESET}${DIM} to see them.${RESET}"
    return 1
  fi
  if ! _validate_account_name "$name"; then
    error "Invalid account name: ${BOLD}$(_sessions_safe_str "$name")${RESET}"
    echo -e "    ${DIM}Lowercase letters, digits, dash and underscore. Up to 31 characters, starting with a letter or a digit.${RESET}"
    return 1
  fi
  _account_exists "$name" && existed=1
  # A running session on a box pinned to the name would lose its staged login
  # under it. Asked before the lock, because it asks docker.
  _account_remove_live_gate "$name" || return 1
  _account_adopt "$id" "$name" || rc=$?
  case "$rc" in
    0)
      if [[ $existed -eq 1 ]]; then
        success "Saved held login ${BOLD}${id}${RESET} into ${BOLD}${name}${RESET}"
      else
        success "Saved held login ${BOLD}${id}${RESET} as the new account ${BOLD}${name}${RESET}"
      fi
      if [[ -n "$_ACCOUNT_ADOPT_REPLACED" ]]; then
        echo -e "    ${DIM}The login ${name} had is held now. See it with ${BOLD}cleat account held${RESET}${DIM}.${RESET}"
      fi
      echo -e "    ${DIM}Pin a box to it with ${BOLD}cleat account ${name}${RESET}"
      return 0 ;;
    "$_ACCOUNT_LOCK_BUSY")
      _account_busy_msg
      return 1 ;;
    1)
      error "No held login ${BOLD}${id}${RESET} that can be saved."
      echo -e "    ${DIM}Run ${BOLD}cleat account held${RESET}${DIM} to see them.${RESET}"
      return 1 ;;
    3)
      error "Could not keep the login ${BOLD}${_ACCOUNT_ADOPT_BOX}${RESET} holds for ${BOLD}${name}${RESET}."
      echo -e "    ${DIM}Nothing was saved. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
      return 1 ;;
    4)
      local hwho awho
      hwho="$(_account_meta_get_at "$(_account_held_dir)/$id" who 2>/dev/null || true)"
      awho="$(_account_meta_get "$name" who 2>/dev/null || true)"
      error "Held login ${BOLD}${id}${RESET} belongs to a different account than ${BOLD}${name}${RESET}."
      if [[ -n "$hwho" && -n "$awho" ]]; then
        echo -e "    ${DIM}Anthropic says it is $(_sessions_safe_str "$hwho"). ${name} is $(_sessions_safe_str "$awho").${RESET}"
      fi
      echo -e "    ${DIM}Nothing was saved. Save it under a new name with ${BOLD}cleat account adopt ${id} <new-name>${RESET}${DIM}.${RESET}"
      echo -e "    ${DIM}To replace ${name} with it, remove ${name} first with ${BOLD}cleat account rm ${name}${RESET}${DIM}.${RESET}"
      return 1 ;;
    *)
      error "Could not save held login ${BOLD}${id}${RESET} as ${BOLD}${name}${RESET}."
      echo -e "    ${DIM}The held login is still there. Check that ${CLEAT_ACCOUNTS_DIR} is writable.${RESET}"
      return 1 ;;
  esac
}

# ── The picker ──────────────────────────────────────────────────────────────
#
# Structure lifted from `cleat session`, which is the one picker in this file
# that has been through a rendering-bug round: rows precomputed into parallel
# indexed arrays, the whole frame emitted in ONE printf, `\033[K` after the text
# rather than `\033[2K` before it, echo suppressed with the full termios state
# saved, and the restore wired to EXIT and to INT/TERM/HUP.
#
# Unlike the session list this one is short (two to five rows), so the frame
# carries a fixed two-line detail pane under the rows, the way the kit picker
# does. That is where the usage goes, and it is precomputed too: a `date` per
# frame is exactly the kind of per-frame fork the session rewrite removed.
_ACCT_N=0
_ACCT_NAME=(); _ACCT_AUTH=(); _ACCT_WHO=(); _ACCT_MARK=()
_ACCT_D1=(); _ACCT_D2=()
_ACCT_CURSOR=0; _ACCT_OFFSET=0; _ACCT_PAGE=5; _ACCT_COLS=80; _ACCT_ROWS=24; _ACCT_NARROW=0
# How many of the rows are STORED accounts. Row zero is always the shared
# login, so _ACCT_N is never zero and cannot answer "is there anything here".
_ACCT_STORED=0
# Which list the frame is drawing, "live" or "trash", and how many accounts are
# in the trash. Both are globals for the same reason the session picker's are:
# the frame takes its arguments positionally and adding two more to every call
# site buys nothing over a value set once per list screen.
_ACCT_VIEW="live"
_ACCT_TRASH_N=0
# How many held logins, for the counter line. Precomputed per list screen.
_ACCT_HELD_N=0
# header (4) + the frame's four non-row lines + one for the shell prompt.
_ACCOUNTS_CHROME_LINES=9
# 4 of marker, 13 of name, 10 of state and something left for an email.
_ACCOUNTS_MIN_COLS=44

_accounts_too_narrow() {
  local c
  c="$(_term_size)"
  c="${c#* }"
  case "$c" in ''|*[!0-9]*) c=80 ;; esac
  [[ "$c" -lt "$_ACCOUNTS_MIN_COLS" ]]
}

# Build every column for every account, once. Everything here that shells out
# happens in this function and nowhere near a frame.
_accounts_load_rows() {
  local active="$1" name who org plan auth last usage d1 d2 now
  _ACCT_N=0
  _ACCT_NAME=(); _ACCT_AUTH=(); _ACCT_WHO=(); _ACCT_MARK=()
  _ACCT_D1=(); _ACCT_D2=()
  now="${_CLEAT_NOW_S:-$(date +%s)}"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  # Row zero is always the shared ~/.claude login. Without it the picker is a
  # one-way door: you could switch to a named account and never get back.
  _ACCT_NAME[0]="$_ACCOUNT_DEFAULT"
  _ACCT_AUTH[0]="shared"
  _ACCT_WHO[0]="your own ~/.claude login"
  if [[ "$active" == "$_ACCOUNT_DEFAULT" ]]; then _ACCT_MARK[0]=1; else _ACCT_MARK[0]=0; fi
  _ACCT_D1[0]="what every box uses until you pin it to a named account"
  _ACCT_D2[0]="cannot be renamed or removed"
  _ACCT_N=1
  _ACCT_STORED=0
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    who="$(_account_meta_get "$name" who 2>/dev/null || true)"
    org="$(_account_meta_get "$name" org 2>/dev/null || true)"
    plan="$(_account_meta_get "$name" plan 2>/dev/null || true)"
    last="$(_account_meta_get "$name" last_used 2>/dev/null || true)"
    auth="$(_account_auth_state "$name")"
    [[ -n "$who" ]] || who="not used yet"
    # _sessions_safe_str, not _sanitize_repo_str. Both strip C0, but the repo
    # one also strips 0x80-0x9f, which are UTF-8 CONTINUATION bytes: it turns a
    # non-ASCII email or organisation name into mojibake. The session one was
    # written for exactly this case, a single row of model-adjacent text.
    _ACCT_NAME[$_ACCT_N]="$(_sessions_safe_str "$name")"
    _ACCT_AUTH[$_ACCT_N]="$auth"
    _ACCT_WHO[$_ACCT_N]="$(_sessions_safe_str "$who")"
    if [[ "$name" == "$active" ]]; then _ACCT_MARK[$_ACCT_N]=1; else _ACCT_MARK[$_ACCT_N]=0; fi

    # Every precomputed string is PLAIN text. Colour is applied by the frame,
    # because a stored escape sequence would be counted by ${#s} and the width
    # clamp would then truncate a row in the middle of an escape.
    d1=""
    [[ -n "$plan" ]] && d1="$(_sessions_safe_str "$plan")"
    if [[ -n "$org" ]]; then
      if [[ -n "$d1" ]]; then d1="${d1} · $(_sessions_safe_str "$org")"; else d1="$(_sessions_safe_str "$org")"; fi
    fi
    usage="$(_account_usage_render "$name" 2>/dev/null || true)"
    if [[ -n "$usage" ]]; then
      if [[ -n "$d1" ]]; then d1="${d1} · ${usage}"; else d1="$usage"; fi
    fi
    [[ -n "$d1" ]] || d1="no usage recorded for this account"

    d2=""
    case "$last" in
      ''|*[!0-9]*) d2="never used in a box" ;;
      # _age_from_delta returns "3h ago" and "just now", the word already in
      # it, so appending another one printed "3h ago ago". It also clamps a
      # negative delta, so a clock that moved backwards needs no branch here.
      *) d2="last used $(_age_from_delta $(( now - last )))" ;;
    esac
    _ACCT_D1[$_ACCT_N]="$d1"
    _ACCT_D2[$_ACCT_N]="$d2"
    _ACCT_N=$(( _ACCT_N + 1 ))
    _ACCT_STORED=$(( _ACCT_STORED + 1 ))
  done < <(_account_list)
  return 0
}

# The same parallel arrays from the trash, so the frame renderer is the one
# renderer. A removed account keeps its meta file, so it can still say whose
# login it was, which is the whole point of being able to see the trash before
# restoring from it.
_accounts_load_trash_rows() {
  local stamp name who plan org d1 d2 now tdir dir
  _ACCT_N=0
  _ACCT_NAME=(); _ACCT_AUTH=(); _ACCT_WHO=(); _ACCT_MARK=()
  _ACCT_D1=(); _ACCT_D2=()
  _ACCT_STORED=0
  now="${_CLEAT_NOW_S:-$(date +%s)}"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  tdir="$(_account_trash_dir)" || tdir=""
  [[ -n "$tdir" ]] || return 0
  while IFS="$(printf '\t')" read -r stamp name; do
    [[ -n "$name" ]] || continue
    dir="${tdir}/${stamp}-${name}"
    who="$(_account_meta_get_at "$dir" who 2>/dev/null || true)"
    plan="$(_account_meta_get_at "$dir" plan 2>/dev/null || true)"
    org="$(_account_meta_get_at "$dir" org 2>/dev/null || true)"
    [[ -n "$who" ]] || who="no login was recorded"
    _ACCT_NAME[$_ACCT_N]="$(_sessions_safe_str "$name")"
    # Not an auth state: the stored blob is not consulted here. A removed
    # account is described by what it WAS, and reading its credential to draw a
    # word would be the one thing the trash exists to avoid doing by accident.
    _ACCT_AUTH[$_ACCT_N]="removed"
    _ACCT_WHO[$_ACCT_N]="$(_sessions_safe_str "$who")"
    # Nothing in the trash can be the active account, so no row is ever marked.
    _ACCT_MARK[$_ACCT_N]=0
    d1=""
    [[ -n "$plan" ]] && d1="$(_sessions_safe_str "$plan")"
    if [[ -n "$org" ]]; then
      if [[ -n "$d1" ]]; then d1="${d1} · $(_sessions_safe_str "$org")"; else d1="$(_sessions_safe_str "$org")"; fi
    fi
    # No usage line. The figures are a snapshot of a live account's window and
    # a removed one has no window worth showing.
    [[ -n "$d1" ]] || d1="nothing was recorded about this account"
    _ACCT_D1[$_ACCT_N]="$d1"
    case "$stamp" in
      ''|*[!0-9]*) d2="removed, kept ${_ACCOUNTS_TRASH_DAYS} days" ;;
      *) d2="removed $(_age_from_delta $(( now - stamp ))), kept ${_ACCOUNTS_TRASH_DAYS} days" ;;
    esac
    _ACCT_D2[$_ACCT_N]="$d2"
    _ACCT_N=$(( _ACCT_N + 1 ))
  done < <(_account_trash_scan_sorted)
  # Every row here is a stored account, unlike the live list where row zero is
  # the sentinel. Keeping the two in step means nothing has to special-case it.
  _ACCT_STORED="$_ACCT_N"
  return 0
}

_accounts_measure() {
  local total="${1:-0}" avail
  _ACCT_ROWS="$(_term_rows)"
  _ACCT_COLS="$(_term_cols)"
  case "$total" in ''|*[!0-9]*) total=0 ;; esac
  (( total < 1 )) && total=1
  if _accounts_too_narrow; then _ACCT_NARROW=1; else _ACCT_NARROW=0; fi
  avail=$(( _ACCT_ROWS - _ACCOUNTS_CHROME_LINES ))
  (( avail < 1 )) && avail=1
  if [[ "$total" -lt "$avail" ]]; then _ACCT_PAGE="$total"; else _ACCT_PAGE="$avail"; fi
  (( _ACCT_PAGE < 1 )) && _ACCT_PAGE=1
  return 0
}

_accounts_clamp() {
  local total="$1"
  case "$total" in ''|*[!0-9]*) total=0 ;; esac
  case "${_ACCT_CURSOR:-}" in ''|*[!0-9-]*) _ACCT_CURSOR=0 ;; esac
  case "${_ACCT_OFFSET:-}" in ''|*[!0-9-]*) _ACCT_OFFSET=0 ;; esac
  [[ "$total" -gt 0 ]] || { _ACCT_CURSOR=0; _ACCT_OFFSET=0; return 0; }
  (( _ACCT_CURSOR < 0 )) && _ACCT_CURSOR=0
  (( _ACCT_CURSOR > total - 1 )) && _ACCT_CURSOR=$(( total - 1 ))
  (( _ACCT_OFFSET > _ACCT_CURSOR )) && _ACCT_OFFSET=$_ACCT_CURSOR
  (( _ACCT_OFFSET < _ACCT_CURSOR - _ACCT_PAGE + 1 )) && _ACCT_OFFSET=$(( _ACCT_CURSOR - _ACCT_PAGE + 1 ))
  (( _ACCT_OFFSET > total - _ACCT_PAGE )) && _ACCT_OFFSET=$(( total - _ACCT_PAGE ))
  (( _ACCT_OFFSET < 0 )) && _ACCT_OFFSET=0
  return 0
}

# page + 4 lines, ALWAYS: the rows, a blank, two detail lines and the hint.
# There is no counter line: with two to five accounts the count is the list.
# A constant count is what the cursor-up reposition depends on, so any edit
# here has to keep the arithmetic in _accounts_picker_tui (page + 4) true.
_accounts_frame() {
  local cursor="$1" offset="$2" page="$3" cols="$4" total="$5"
  local buf="" i n room w a line meta d1 d2 count
  case "$cursor" in ''|*[!0-9-]*) cursor=0 ;; esac
  case "$offset" in ''|*[!0-9-]*) offset=0 ;; esac
  case "$page"   in ''|*[!0-9]*)  page=1 ;; esac
  case "$total"  in ''|*[!0-9]*)  total=0 ;; esac
  (( cursor < 0 )) && cursor=0
  (( offset < 0 )) && offset=0
  (( page < 1 ))   && page=1
  room=$(( cols - 30 ))
  (( room < 1 )) && room=1
  i=0
  while [[ $i -lt $page ]]; do
    n=$(( offset + i ))
    if [[ $n -lt $total ]]; then
      w="${_ACCT_WHO[$n]}"
      # Byte length over-budgets a multibyte string under LC_ALL=C, which is
      # safe. Halve only in the case that can under-count, exactly as the
      # session frame does.
      local rm=$room
      case "$w" in
        *[!\ -~]*) if _has_unicode; then rm=$(( room / 2 )); (( rm < 1 )) && rm=1; fi ;;
      esac
      [[ ${#w} -gt $rm ]] && w="${w:0:$(( rm - 1 ))}…"
      # The name column is built in two forms rather than with one %-13.13s.
      # Account names are validated ASCII, so length is column count, and a
      # silent cut would show a name that creates a NEW empty account if it is
      # retyped. `%-13s` pads and never truncates, so the short branch is
      # exact, and the long branch is already 13 columns wide with the ellipsis
      # carrying the last one.
      local nm="${_ACCT_NAME[$n]}"
      if [[ ${#nm} -gt 13 ]]; then
        printf -v meta '%s %-10.10s' "${nm:0:12}…" "${_ACCT_AUTH[$n]}"
      else
        printf -v meta '%-13s %-10.10s' "$nm" "${_ACCT_AUTH[$n]}"
      fi
      if [[ "${_ACCT_MARK[$n]}" == "1" ]]; then a="${GREEN}•${RESET}"; else a=" "; fi
      if [[ $n -eq $cursor ]]; then
        line="  ${CYAN}▸${RESET}${a} ${BOLD}${meta}${RESET} ${w}"
      else
        line="   ${a} ${meta} ${DIM}${w}${RESET}"
      fi
      buf="${buf}${line}\033[K\n"
    else
      buf="${buf}\033[K\n"
    fi
    i=$(( i + 1 ))
  done
  # The detail pane describes the HIGHLIGHTED row and is two lines whether or
  # not it has anything to say, because a pane that changes height moves the
  # counter and the reposition walks.
  d1=""; d2=""
  if [[ $cursor -lt $total ]]; then
    d1="${_ACCT_D1[$cursor]}"
    d2="${_ACCT_D2[$cursor]}"
  fi
  local droom=$(( cols - 5 ))
  (( droom < 1 )) && droom=1
  # The same wide-character budget the rows get. An organisation name in CJK
  # paints two columns per character, so a pane clamped by character count
  # would wrap, and a wrapped line inside the frame walks the whole block down
  # the screen one row per keypress.
  local d1room=$droom d2room=$droom
  case "$d1" in *[!\ -~]*) if _has_unicode; then d1room=$(( droom / 2 )); (( d1room < 1 )) && d1room=1; fi ;; esac
  case "$d2" in *[!\ -~]*) if _has_unicode; then d2room=$(( droom / 2 )); (( d2room < 1 )) && d2room=1; fi ;; esac
  [[ ${#d1} -gt $d1room ]] && d1="${d1:0:$(( d1room - 1 ))}…"
  [[ ${#d2} -gt $d2room ]] && d2="${d2:0:$(( d2room - 1 ))}…"
  # The line between the rows and the detail pane used to be a bare spacer. It
  # is the counter now, and it is where the trash gets advertised. NOT the hint
  # line: that is already 37 columns against a 44-column minimum, so one more
  # word there wraps the narrowest supported terminal, and a wrapped line walks
  # the whole block one row down the screen per keypress. The height does not
  # change either way, which is what the cursor-up reposition depends on.
  count=""
  if [[ "$_ACCT_VIEW" == "trash" ]]; then
    if [[ "$total" -le 0 ]]; then
      count="The trash is empty"
    elif [[ "$total" -eq 1 ]]; then
      count="Trash: 1 account, kept ${_ACCOUNTS_TRASH_DAYS} days"
    else
      count="Trash: ${total} accounts, kept ${_ACCOUNTS_TRASH_DAYS} days"
    fi
  elif [[ "${_ACCT_TRASH_N:-0}" -gt 0 ]]; then
    count="→ trash (${_ACCT_TRASH_N})"
  fi
  # Held logins have no view of their own, so the line names the command.
  if [[ "$_ACCT_VIEW" != "trash" && "${_ACCT_HELD_N:-0}" -gt 0 ]]; then
    if [[ -n "$count" ]]; then count="${count}   "; fi
    count="${count}held (${_ACCT_HELD_N}): cleat account held"
  fi
  [[ ${#count} -gt $droom ]] && count="${count:0:$(( droom - 1 ))}…"
  buf="${buf}    ${DIM}${count}${RESET}\033[K\n"
  buf="${buf}    ${DIM}${d1}${RESET}\033[K\n"
  buf="${buf}    ${DIM}${d2}${RESET}\033[K\n"
  if [[ "$_ACCT_VIEW" == "trash" ]]; then
    buf="${buf}  ${DIM}↑/↓ move  ⏎ restore  ← back  q close${RESET}\033[K\n"
  else
    buf="${buf}  ${DIM}↑/↓ move  ⏎ switch or edit  q close${RESET}\033[K\n"
  fi
  printf '%b' "$buf"
  return 0
}

# ── The picker loop ─────────────────────────────────────────────────────────
#
# Same two-loop shape as `cleat session`: the outer pass is one list screen,
# every action breaks back to it, so switching an account and then renaming
# another is one run rather than three.
_ACCOUNTS_ACTION_LINES=5
_ACCOUNTS_ACTION_HEAD=3

_accounts_action_draw() {
  local cursor="${1:-0}" cols="${2:-80}" active="${3:-0}"
  local i=0 room label desc line
  room=$(( cols - 14 ))
  (( room < 8 )) && room=8
  printf '\033[K\n'
  while [[ $i -lt 4 ]]; do
    case $i in
      0) label="Use here"; desc="Pin this box to this account" ;;
      1) label="Rename  "; desc="Give it a name you will recognise" ;;
      2) label="Remove  "; desc="Move it to the trash (restorable for ${_ACCOUNTS_TRASH_DAYS} days)" ;;
      *) label="Cancel  "; desc="Leave it alone" ;;
    esac
    [[ ${#desc} -gt $room ]] && desc="${desc:0:$(( room - 1 ))}…"
    if [[ $i -eq $cursor ]]; then
      line="  ${CYAN}▸${RESET} ${BOLD}${label}${RESET}  ${DIM}${desc}${RESET}"
    else
      line="    ${label}  ${DIM}${desc}${RESET}"
    fi
    printf '%b\033[K\n' "$line"
    i=$(( i + 1 ))
  done
  return 0
}

_accounts_action_backout() {
  _cursor_show
  _tui_echo_restore
  trap - INT TERM HUP
  printf '\033[%dA' "$_ACCOUNTS_ACTION_HEAD"
  printf '\033[J'
  return 0
}

# 0 = ran something and printed a receipt, 1 = backed out having printed
# nothing. Exactly the contract _sessions_action_tui carries, for the same
# reason: the caller redraws under the receipt or in place.
_accounts_action_tui() {
  local acct="$1" box="$2" cname="$3" project="$4"
  local cursor=0 key cols who
  who="$(_account_meta_get "$acct" who 2>/dev/null || true)"
  cols="$(_term_cols)"
  # _sessions_safe_title, for the clamp as much as for the sanitising: it cuts
  # to the terminal width. The back-out walks up a FIXED three lines, so an
  # email longer than the terminal would wrap into two physical lines, the
  # walk-up would land one line low, and the redrawn list would be written over
  # the menu it was meant to replace.
  who="$(_sessions_safe_title "$who")"
  echo ""
  echo -e "  ${BOLD}${acct}${RESET}"
  if [[ -n "$who" ]]; then
    echo -e "  ${DIM}${who}${RESET}"
  else
    echo -e "  ${DIM}no login recorded yet${RESET}"
  fi
  _tui_echo_off
  trap '_tui_echo_restore; _cursor_show; trap - INT TERM HUP; exit 130' INT TERM HUP
  _cursor_hide
  _accounts_action_draw "$cursor" "$cols"
  echo ""
  echo -e "  ${DIM}↑/↓ move  ⏎ choose  q back${RESET}"
  printf '\033[%dA' "$(( _ACCOUNTS_ACTION_LINES + 2 ))"

  while true; do
    key="$(_read_keypress)"
    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=$(( cursor - 1 )) ;;
      DOWN) [[ $cursor -lt 3 ]] && cursor=$(( cursor + 1 )) ;;
      ENTER)
        if [[ $cursor -eq 3 ]]; then
          _accounts_action_backout
          return 1
        fi
        _cursor_show
        _tui_echo_restore
        trap - INT TERM HUP
        printf '\033[%dB' "$(( _ACCOUNTS_ACTION_LINES + 2 ))"
        printf '\033[2K'
        echo ""
        case "$cursor" in
          0) _account_do_switch "$acct" "$box" "$cname" "$project" 0 0 || true ;;
          1|2)
            if [[ "$acct" == "$_ACCOUNT_DEFAULT" ]]; then
              info "Your shared login is not a stored account, so there is nothing to rename or remove."
              return 0
            fi
            _accounts_action_dispatch "$cursor" "$acct" ;;
        esac
        return 0 ;;
      QUIT|ESC)
        _accounts_action_backout
        return 1 ;;
    esac
    _accounts_action_draw "$cursor" "$cols"
    printf '\033[%dA' "$_ACCOUNTS_ACTION_LINES"
  done
}

# The two stored-account actions, split out so the sentinel row can refuse them
# in one place rather than inside a case arm.
_accounts_action_dispatch() {
  local cursor="$1" acct="$2"
  local newname=""
  case "$cursor" in
    1)
      if _is_interactive; then
        echo -en "  New name: "
        read -r newname || newname=""
      fi
      if [[ -z "$newname" ]]; then
        info "Kept."
      else
        _account_do_rename "$acct" "$newname" || true
      fi ;;
    *) _account_do_remove "$acct" 0 || true ;;
  esac
  return 0
}

_accounts_header() {
  local box="$1"
  local p="$CLEAT_ACCOUNTS_DIR" room
  room=$(( $(_term_cols) - 4 ))
  (( room < 12 )) && room=12
  if [[ ${#p} -gt $room ]]; then
    p="…${p:$(( ${#p} - room + 1 ))}"
  fi
  echo ""
  echo -e "  ${BOLD}Claude accounts${RESET} ${DIM}(box ${box})${RESET}"
  echo -e "  ${DIM}${p}${RESET}"
  echo ""
  return 0
}

_accounts_picker_tui() {
  local box="$1" cname="$2" project="$3"
  local key block prev_block total active acted=0
  # Each view remembers where its own cursor was, so crossing to the trash and
  # back does not reset the live list to the top.
  local view="live" live_cursor=0 live_offset=0 trash_cursor=0 trash_offset=0
  # Set when the trash was opened because the live list had nothing left in it.
  # Going back would land on the same empty list, which would bounce straight
  # here again and print the same line one row further down the screen on every
  # press. So LEFT does nothing until a restore gives it somewhere to go.
  local trash_forced=0

  _ACCT_CURSOR=0
  _ACCT_OFFSET=0

  while true; do
    active="$(_box_account_read "$cname")"
    _tui_echo_off
    trap '_tui_echo_restore; _cursor_show' EXIT
    trap '_tui_echo_restore; _cursor_show; trap - INT TERM HUP EXIT; exit 130' INT TERM HUP

    _ACCT_VIEW="$view"
    _ACCT_TRASH_N="$(_account_trash_count)"
    _ACCT_HELD_N="$(_account_held_count)"
    if [[ "$view" == "trash" ]]; then
      _accounts_load_trash_rows
    else
      _accounts_load_rows "$active"
    fi
    total="$_ACCT_N"
    # Row zero is the shared login, so a picker of ONLY that row is a picker
    # with nothing to pick. Say how to make the first account instead.
    if [[ "$view" == "live" ]] && [[ "$_ACCT_STORED" -le 0 || "$total" -le 0 ]]; then
      _tui_echo_restore
      _cursor_show
      trap - INT TERM HUP EXIT
      # Unless the account they just removed is sitting in the trash. That is
      # the only place it can be got back from, so show it rather than dropping
      # to a shell prompt with a command to retype.
      if [[ "${_ACCT_TRASH_N:-0}" -gt 0 ]]; then
        info "No named accounts left. Showing the trash."
        view="trash"
        trash_forced=1
        _ACCT_CURSOR=0
        _ACCT_OFFSET=0
        continue
      fi
      _accounts_empty_note "$box"
      return 0
    fi

    _accounts_measure "$total"
    if [[ "$_ACCT_NARROW" == "1" ]]; then
      _tui_echo_restore
      _cursor_show
      trap - INT TERM HUP EXIT
      echo ""
      info "Window too narrow for the account list."
      echo -e "    ${DIM}Widen it and run ${BOLD}cleat account${RESET}${DIM} again.${RESET}"
      return 0
    fi
    _accounts_clamp "$total"
    block=$(( _ACCT_PAGE + 4 ))
    prev_block=$block

    _cursor_hide
    _accounts_frame "$_ACCT_CURSOR" "$_ACCT_OFFSET" "$_ACCT_PAGE" "$_ACCT_COLS" "$total"
    printf '\033[%dA' "$block"

    while true; do
      key="$(_read_keypress)"
      _accounts_measure "$total"
      if [[ "$_ACCT_NARROW" == "1" ]]; then
        _cursor_show
        _tui_echo_restore
        trap - INT TERM HUP EXIT
        printf '\033[%dB' "$block"
        printf '\033[2K'
        echo ""
        info "Window too narrow for the account list."
        echo -e "    ${DIM}Widen it and run ${BOLD}cleat account${RESET}${DIM} again.${RESET}"
        return 0
      fi
      case "$key" in
        UP)   _ACCT_CURSOR=$(( _ACCT_CURSOR - 1 )) ;;
        DOWN) _ACCT_CURSOR=$(( _ACCT_CURSOR + 1 )) ;;
        RIGHT)
          # The cursor is parked on the frame's ORIGIN at the top of every pass
          # of this loop, so erasing from here down and breaking redraws the
          # other view in exactly this space. Nothing scrolls, the header above
          # is untouched and no second copy of the list is left behind.
          if [[ "$view" == "live" ]]; then
            live_cursor=$_ACCT_CURSOR
            live_offset=$_ACCT_OFFSET
            view="trash"
            _ACCT_CURSOR=$trash_cursor
            _ACCT_OFFSET=$trash_offset
            printf '\033[J'
            break
          fi ;;
        LEFT)
          if [[ "$view" == "trash" && "$trash_forced" != "1" ]]; then
            trash_cursor=$_ACCT_CURSOR
            trash_offset=$_ACCT_OFFSET
            view="live"
            _ACCT_CURSOR=$live_cursor
            _ACCT_OFFSET=$live_offset
            printf '\033[J'
            break
          fi ;;
        ENTER)
          local pick=""
          [[ $_ACCT_CURSOR -lt $total ]] && pick="${_ACCT_NAME[$_ACCT_CURSOR]}"
          if [[ "$view" == "trash" ]]; then
            # An empty trash has no row under the cursor. Pressing Enter there
            # is an ordinary thing to do and must not end the verb, so redraw
            # and stay put. There is no sentinel row to allow through here.
            if ! _validate_account_name "$pick"; then
              _accounts_frame "$_ACCT_CURSOR" "$_ACCT_OFFSET" "$_ACCT_PAGE" "$_ACCT_COLS" "$total"
              printf '\033[%dA' "$block"
              continue
            fi
            _cursor_show
            _tui_echo_restore
            trap - INT TERM HUP EXIT
            printf '\033[J'
            echo ""
            # Restore is one step with no menu, exactly like the session trash:
            # there is only one thing to do to something that is already gone.
            if _account_do_restore "$pick"; then
              trash_forced=0
            fi
            acted=1
            _accounts_header "$box"
            break
          fi
          # The sentinel is a real row here and deliberately NOT a valid stored
          # account name, so it has to be allowed through by name.
          if [[ "$pick" != "$_ACCOUNT_DEFAULT" ]] && ! _validate_account_name "$pick"; then
            _accounts_frame "$_ACCT_CURSOR" "$_ACCT_OFFSET" "$_ACCT_PAGE" "$_ACCT_COLS" "$total"
            printf '\033[%dA' "$block"
            continue
          fi
          _cursor_show
          _tui_echo_restore
          trap - INT TERM HUP EXIT
          printf '\033[J'
          if _accounts_action_tui "$pick" "$box" "$cname" "$project"; then
            acted=1
            _accounts_header "$box"
          fi
          break ;;
        QUIT|ESC)
          _cursor_show
          _tui_echo_restore
          trap - INT TERM HUP EXIT
          printf '\033[%dB' "$block"
          printf '\033[2K'
          echo ""
          if [[ "$acted" != "1" ]]; then
            info "Cancelled."
          fi
          return 0 ;;
      esac
      _accounts_clamp "$total"
      block=$(( _ACCT_PAGE + 4 ))
      _accounts_frame "$_ACCT_CURSOR" "$_ACCT_OFFSET" "$_ACCT_PAGE" "$_ACCT_COLS" "$total"
      if [[ "$block" -lt "$prev_block" ]]; then
        printf '\033[J'
      fi
      prev_block=$block
      printf '\033[%dA' "$block"
    done
  done
}

# There is nothing to pick from until the first account exists, and the shortest
# path from here to a working second account is one command, so print it.
_accounts_empty_note() {
  local box="$1"
  info "No named accounts yet."
  echo -e "    ${DIM}Make one with ${BOLD}cleat account <name>${RESET}${DIM}, then start the box and run ${BOLD}/login${RESET}${DIM}.${RESET}"
  echo -e "    ${DIM}Until then every box uses your shared login at ~/.claude.${RESET}"
  return 0
}

_accounts_picker_text() {
  local box="$1" cname="$2"
  local active i=0 tn=0
  active="$(_box_account_read "$cname")"
  _accounts_load_rows "$active"
  tn="$(_account_trash_count)"
  case "$tn" in ''|*[!0-9]*) tn=0 ;; esac
  if [[ "$_ACCT_STORED" -le 0 ]]; then
    _accounts_empty_note "$box"
    # Without this an account removed a minute ago is invisible on every path
    # that is not the picker, which includes every non-TTY caller.
    if [[ "$tn" -gt 0 ]]; then
      echo -e "    ${DIM}${tn} in the trash. See them with ${BOLD}cleat account trash${RESET}${DIM}.${RESET}"
    fi
    _account_held_line "    "
    return 0
  fi
  echo ""
  echo -e "  ${BOLD}Claude accounts${RESET} ${DIM}(box ${box})${RESET}"
  echo ""
  while [[ $i -lt $_ACCT_N ]]; do
    local mark=" "
    [[ "${_ACCT_MARK[$i]}" == "1" ]] && mark="${GREEN}•${RESET}"
    echo -e "   ${mark} $(printf '%-13s %-10.10s' "${_ACCT_NAME[$i]}" "${_ACCT_AUTH[$i]}") ${DIM}${_ACCT_WHO[$i]}${RESET}"
    echo -e "      ${DIM}${_ACCT_D1[$i]}${RESET}"
    echo -e "      ${DIM}${_ACCT_D2[$i]}${RESET}"
    i=$(( i + 1 ))
  done
  echo ""
  echo -e "  ${DIM}Switch with ${BOLD}cleat account <name> [box]${RESET}${DIM}. Back to your shared login with ${BOLD}cleat account default${RESET}${DIM}.${RESET}"
  echo -e "  ${DIM}Rename or remove with ${BOLD}cleat account rename${RESET}${DIM} and ${BOLD}cleat account rm${RESET}${DIM}.${RESET}"
  # The picker advertises the trash on its counter line and opens it with →.
  # This is the same pointer for every caller that does not get the picker.
  if [[ "$tn" -gt 0 ]]; then
    echo -e "  ${DIM}${tn} in the trash. See them with ${BOLD}cleat account trash${RESET}${DIM}.${RESET}"
  fi
  _account_held_line "  "
  if ! command -v jq &>/dev/null; then
    echo -e "  ${DIM}Usage figures need ${BOLD}jq${RESET}${DIM} on the host, which is not installed, so they are not shown.${RESET}"
  fi
  return 0
}

# `cleat account trash`. The picker reaches the same list with →, so this is
# for a pipe, a narrow terminal and anyone who would rather type it.
_accounts_trash_text() {
  local i=0
  _accounts_load_trash_rows
  if [[ "$_ACCT_N" -le 0 ]]; then
    info "The account trash is empty."
    echo -e "    ${DIM}Removed accounts are kept for ${_ACCOUNTS_TRASH_DAYS} days.${RESET}"
    return 0
  fi
  echo ""
  echo -e "  ${BOLD}Removed accounts${RESET} ${DIM}(kept ${_ACCOUNTS_TRASH_DAYS} days)${RESET}"
  echo ""
  while [[ $i -lt $_ACCT_N ]]; do
    echo -e "     $(printf '%-13s %-10.10s' "${_ACCT_NAME[$i]}" "${_ACCT_AUTH[$i]}") ${DIM}${_ACCT_WHO[$i]}${RESET}"
    echo -e "      ${DIM}${_ACCT_D2[$i]}${RESET}"
    i=$(( i + 1 ))
  done
  echo ""
  echo -e "  ${DIM}Bring one back with ${BOLD}cleat account restore <name>${RESET}${DIM}.${RESET}"
  return 0
}

# The pointer every plain list prints when something is held. $1 is the indent.
_account_held_line() {
  local hn
  hn="$(_account_held_count)"
  case "$hn" in ''|*[!0-9]*) hn=0 ;; esac
  if [[ "$hn" -eq 1 ]]; then
    echo -e "${1}${DIM}1 held login. See it with ${BOLD}cleat account held${RESET}${DIM}.${RESET}"
  elif [[ "$hn" -gt 1 ]]; then
    echo -e "${1}${DIM}${hn} held logins. See them with ${BOLD}cleat account held${RESET}${DIM}.${RESET}"
  fi
  return 0
}

# `cleat account held`. Each row says where the login was headed, which box it
# came from, why it was held and how to save it.
_accounts_held_text() {
  local stamp id acct box reason who now n=0 where why
  now="${_CLEAT_NOW_S:-$(date +%s)}"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  while IFS="$(printf '\t')" read -r stamp id acct box reason who; do
    [[ -n "$id" ]] || continue
    if [[ $n -eq 0 ]]; then
      echo ""
      echo -e "  ${BOLD}Held logins${RESET} ${DIM}(kept ${_ACCOUNTS_TRASH_DAYS} days)${RESET}"
      echo ""
    fi
    n=$(( n + 1 ))
    if [[ "$box" != "-" && "$acct" != "-" ]]; then
      where="from box $(_sessions_safe_str "$box"), for account $(_sessions_safe_str "$acct")"
    elif [[ "$box" != "-" ]]; then
      where="from box $(_sessions_safe_str "$box"), which was not pinned to an account"
    else
      where="from account $(_sessions_safe_str "$acct")"
    fi
    case "$reason" in
      unsaved)           why="its account did not save it" ;;
      left-in-box)       why="found in the box's runtime dir" ;;
      other-account)     why="it belongs to another account" ;;
      replaced-by-adopt) why="replaced by cleat account adopt" ;;
      replaced-by-harvest) why="replaced by the first login Anthropic verified for its account" ;;
      journal)           why="set aside during a switch" ;;
      *)                 why="$(_sessions_safe_str "$reason")" ;;
    esac
    echo -e "   ${BOLD}${id}${RESET}  ${DIM}held $(_age_from_delta $(( now - stamp )))${RESET}"
    echo -e "      ${DIM}${where}${RESET}"
    echo -e "      ${DIM}${why}${RESET}"
    if [[ "$who" != "-" ]]; then
      echo -e "      ${DIM}$(_sessions_safe_str "$who")${RESET}"
    fi
  done < <(_account_held_scan)
  if [[ $n -eq 0 ]]; then
    info "No held logins."
    echo -e "    ${DIM}A login a box had that no account saved is kept here instead of deleted, for ${_ACCOUNTS_TRASH_DAYS} days.${RESET}"
    return 0
  fi
  echo ""
  echo -e "  ${DIM}Save one with ${BOLD}cleat account adopt <id> <name>${RESET}${DIM}. A new name creates that account.${RESET}"
  return 0
}

# Refresh what the list can honestly show, for every account whose own access
# token is still alive. Cheap in practice: the throttle and the liveness gate
# make it a no-op for a parked account, which is most of them, and the parked
# ones are exactly the ones that must NEVER be polled (a refresh could rotate
# their refresh token).
_accounts_refresh_usage() {
  local n
  command -v curl &>/dev/null || return 0
  command -v jq &>/dev/null || return 0
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    _account_usage_fetch "$n" >/dev/null 2>&1 || true
  done < <(_account_list)
  return 0
}

# `cleat account [list|rename|rm|restore|trash|held|adopt] [<name>] [box] [flags]`
#
# The subcommand word is reserved FIRST, then flags, then the name, and only
# what is left goes to _set_box. `cmd_fork` carries the scar that made this the
# house rule: _set_box takes exactly one positional and validates it as a box
# name, so handing it anything else fails with a confusing message.
cmd_account() {
  local sub="switch" name="" newname="" assume_yes=0 now=0
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat account                    Interactive picker for this project's default box"
      echo "       cleat account <name> [box]       Pin a box to a named login, creating it if new"
      echo "                                        A live session in that box restarts on it and reopens its conversation"
      echo "       cleat account <name> --yes       Restart a live session without asking (anything typed there but not sent is lost)"
      echo "       cleat account <name> --now       Restart it even mid-turn or at a question (its reply so far is lost)"
      echo "       cleat account default [box]      Unpin a box, back to your shared ~/.claude login"
      echo "       cleat account list [box]         Plain list, marking the pinned one"
      echo "       cleat account rename <old> <new> Rename a stored login"
      echo "       cleat account rm <name> [--yes]  Move it to the trash"
      echo "       cleat account restore <name>     Bring a removed one back"
      echo "       cleat account trash              List removed accounts"
      echo "       cleat account held               List logins kept aside instead of deleted"
      echo "       cleat account adopt <id> <name>  Save a held login as an account"
      return 0 ;;
    list)            sub="list"; shift ;;
    rename)          sub="rename"; shift ;;
    rm|delete)       sub="rm"; shift ;;
    restore)         sub="restore"; shift ;;
    trash)           sub="trash"; shift ;;
    held)            sub="held"; shift ;;
    adopt)           sub="adopt"; shift ;;
  esac

  local rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes=1; shift ;;
      --now) now=1; shift ;;
      -*)
        error "Unknown flag: ${BOLD}${1}${RESET}"
        echo -e "    ${DIM}cleat account takes --yes and --now.${RESET}"
        return 1 ;;
      *) rest=("${rest[@]+"${rest[@]}"}" "$1"); shift ;;
    esac
  done

  # --now restarts a live session mid-turn. It only means anything for a switch.
  if [[ $now -eq 1 && "$sub" != "switch" ]]; then
    error "--now only applies when switching a box."
    return 1
  fi

  case "$sub" in
    rename)
      name="${rest[0]:-}"
      newname="${rest[1]:-}"
      if [[ -z "$name" || -z "$newname" ]]; then
        error "Which one, and to what? ${DIM}cleat account rename <old> <new>${RESET}"
        return 1
      fi
      rest=("${rest[@]:2}") ;;
    adopt)
      name="${rest[0]:-}"
      newname="${rest[1]:-}"
      if [[ -z "$name" ]]; then
        error "Which one? ${DIM}cleat account adopt <id> <name>${RESET}"
        echo -e "    ${DIM}Run ${BOLD}cleat account held${RESET}${DIM} to see them.${RESET}"
        return 1
      fi
      if [[ -z "$newname" ]]; then
        error "Save it as which account? ${DIM}cleat account adopt <id> <name>${RESET}"
        return 1
      fi
      rest=("${rest[@]:2}") ;;
    rm|restore)
      name="${rest[0]:-}"
      if [[ -z "$name" ]]; then
        error "Which account? ${DIM}cleat account ${sub} <name>${RESET}"
        echo -e "    ${DIM}Run ${BOLD}cleat account list${RESET}${DIM} to see them.${RESET}"
        return 1
      fi
      rest=("${rest[@]:1}") ;;
    switch)
      # Bare `cleat account` is the picker, exactly like bare `cleat kit`.
      if [[ ${#rest[@]} -gt 0 ]]; then
        name="${rest[0]}"
        rest=("${rest[@]:1}")
      fi ;;
  esac

  _set_box "${rest[@]+"${rest[@]}"}"

  local project cname
  project="$(resolve_project "$PWD")"
  cname="$(container_name_for "$project" "$_BOX")"

  # Housekeeping on every run, so the trash cannot grow without bound.
  _account_trash_sweep
  # And harvest anything the box refreshed for itself, before this run reads or
  # writes a single stored credential. A lock that cannot be had stops every
  # verb that changes something, rather than letting it wait a second time.
  # The three read-only views still draw.
  local _harvest=0
  _account_sync_out "$cname" || _harvest=$?
  if [[ $_harvest -eq $_ACCOUNT_LOCK_BUSY && "$sub" != "list" && "$sub" != "trash" && "$sub" != "held" ]]; then
    _account_busy_msg
    return 1
  fi

  case "$sub" in
    rename)  _account_do_rename "$name" "$newname"; return $? ;;
    rm)      _account_do_remove "$name" "$assume_yes"; return $? ;;
    restore) _account_do_restore "$name"; return $? ;;
    list)    _accounts_refresh_usage; _accounts_picker_text "$_BOX" "$cname"; return 0 ;;
    trash)   _accounts_trash_text; return 0 ;;
    held)    _accounts_held_text; return 0 ;;
    adopt)   _account_do_adopt "$name" "$newname"; return $? ;;
  esac

  if [[ -n "$name" ]]; then
    _account_do_switch "$name" "$_BOX" "$cname" "$project" "$assume_yes" "$now"
    return $?
  fi

  _accounts_refresh_usage
  if [[ -t 0 ]] && [[ -t 1 ]] && ! _accounts_too_narrow; then
    _accounts_header "$_BOX"
    _accounts_picker_tui "$_BOX" "$cname" "$project"
  else
    _accounts_picker_text "$_BOX" "$cname"
  fi
  return 0
}

# `cleat session [list|rename|rm|restore|trash] [<id>] [box] [flags]`
#
# The subcommand word is reserved FIRST, then the flags, then <id>, and only
# what is left goes to _set_box. That order matters: _set_box accepts exactly
# one positional and validates it as a box name (max 31 chars), so handing it a
# 36-character UUID would fail with a confusing "Invalid box name". Routing the
# remainder through it anyway is what gives this verb the same box validation
# and the same stray-argument refusal as every other box-aware verb. cmd_fork
# carries the scar that made this the house rule.
cmd_sessions() {
  local sub="list" id="" title="" assume_yes=0 want_title=0
  case "${1:-}" in
    list|ls)   sub="list"; shift ;;
    rename|mv) sub="rename"; shift ;;
    rm|delete) sub="rm"; shift ;;
    restore)   sub="restore"; shift ;;
    trash)     sub="trash"; shift ;;
  esac

  local rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes=1; shift ;;
      --title)
        want_title=1
        title="${2:-}"
        if [[ $# -lt 2 ]]; then
          error "${BOLD}--title${RESET} needs a value."
          return 1
        fi
        shift 2 ;;
      --title=*) want_title=1; title="${1#--title=}"; shift ;;
      -*)
        error "Unknown flag: ${BOLD}${1}${RESET}"
        echo -e "    ${DIM}cleat session takes --title <text> and --yes.${RESET}"
        return 1 ;;
      *) rest=("${rest[@]+"${rest[@]}"}" "$1"); shift ;;
    esac
  done

  if [[ "$sub" != "list" && "$sub" != "trash" ]]; then
    id="${rest[0]:-}"
    if [[ -z "$id" ]]; then
      error "Which session? ${DIM}cleat session ${sub} <id>${RESET}"
      echo -e "    ${DIM}Run ${BOLD}cleat session${RESET}${DIM} to see the ids.${RESET}"
      return 1
    fi
    rest=("${rest[@]:1}")
  fi

  # A box positional is still validated by _set_box, which exits on a bad name.
  _set_box "${rest[@]+"${rest[@]}"}"

  # Shape-check the id BEFORE anything touches the filesystem, so a typo is
  # reported as a typo even in a project that has no sessions yet, and so a
  # malformed id never reaches a path join.
  if [[ "$sub" != "list" && "$sub" != "trash" ]]; then
    local _shape=0
    _sessions_id_shape "$id" || _shape=$?
    case $_shape in
      2) error "Not a session id: ${BOLD}${id}${RESET} ${DIM}(ids are hex and dashes)${RESET}"; return 1 ;;
      3) error "Too short: ${BOLD}${id}${RESET}"
         echo -e "    ${DIM}Use at least 8 characters so it can only mean one session.${RESET}"
         return 1 ;;
    esac
  fi

  local project sdir cname
  project="$(resolve_project "$PWD")"
  sdir="$(_sessions_key_dir "$project" "$_BOX")" || { error "Could not derive this project's session directory."; return 1; }
  cname="$(container_name_for "$project" "$_BOX")"

  # Housekeeping on every run, so the trash cannot grow without bound whether or
  # not the user ever thinks about it.
  _sessions_trash_sweep "$sdir"

  case "$sub" in
    restore)
      local ruuid rc
      local _rrc=0
      ruuid="$(_sessions_restore_resolve "$sdir" "$id")" || _rrc=$?
      if [[ $_rrc -eq 4 ]]; then
        error "Ambiguous: ${BOLD}${id}${RESET} matches more than one trashed session."
        printf '%s\n' "$ruuid" | while IFS= read -r m; do
          [[ -n "$m" ]] && echo -e "    ${DIM}${m}${RESET}"
        done
        return 1
      fi
      if [[ $_rrc -ne 0 || -z "$ruuid" ]]; then
        error "No trashed session in this project matching ${BOLD}${id}${RESET}."
        echo -e "    ${DIM}Trash: ${sdir}/.cleat-trash${RESET}"
        return 1
      fi
      if _sessions_restore "$sdir" "$ruuid"; then
        success "Restored ${DIM}${ruuid:0:8}${RESET}"
        return 0
      fi
      error "Could not restore ${BOLD}${ruuid:0:8}${RESET}."
      return 1 ;;
    trash)
      # A plain listing, not a picker. The picker's trash view is reached with
      # the arrow key from the live list; this is the non-interactive way to
      # read the same thing and, more to the point, to get the ids that
      # `cleat session restore` takes.
      local tfile ti=0
      tfile="$(mktemp "${TMPDIR:-/tmp}/cleat-trash.XXXXXX" 2>/dev/null)" || {
        error "Could not create a temporary file."
        return 1
      }
      _sessions_trash_scan_sorted "$sdir" > "$tfile" 2>/dev/null || true
      _sessions_load_rows "$tfile"
      rm -f "$tfile"
      if [[ "$_SESS_N" -eq 0 ]]; then
        info "The trash is empty."
        echo -e "    ${DIM}Deleted sessions land in ${sdir}/.cleat-trash${RESET}"
        return 0
      fi
      echo ""
      echo -e "  ${BOLD}Trashed sessions${RESET} ${DIM}($(basename "$project")$( [[ "$_BOX" != "main" ]] && printf ' / %s' "$_BOX" ))${RESET}"
      echo ""
      while [[ $ti -lt $_SESS_N ]]; do
        echo -e "    $(printf '%-9.9s %9.9s' "${_SESS_AGE[$ti]}" "${_SESS_SIZE[$ti]}") ${DIM}${_SESS_ID[$ti]}${RESET}  ${_SESS_TITLE[$ti]}"
        ti=$(( ti + 1 ))
      done
      echo ""
      echo -e "  ${DIM}The age column is how long ago it was deleted. Swept after ${_SESSIONS_TRASH_DAYS} days.${RESET}"
      echo -e "  ${DIM}Put one back with ${BOLD}cleat session restore <id>${RESET}${DIM}.${RESET}"
      return 0 ;;
  esac

  if [[ ! -d "$sdir" ]]; then
    info "No sessions for this project yet."
    # Naming the directory is not a debug detail, it is the whole diagnostic.
    # The key is hashed from the path as typed, so on a case-insensitive Mac
    # ~/Workspaces/cleat and ~/workspaces/cleat reach the same directory and
    # hash to two different keys. Without this line that reads as data loss.
    echo -e "    ${DIM}Looked in ${sdir}${RESET}"
    return 0
  fi

  case "$sub" in
    rename|rm)
      # `|| rc=$?` and NOT `; rc=$?`. Under the binary's `set -e` a plain
      # assignment whose command substitution exits non-zero terminates the
      # shell right there, so the next line never runs and every rejected id
      # exited silently with the helper's status instead of printing why.
      local resolved="" rc=0
      resolved="$(_sessions_resolve_id "$sdir" "$id")" || rc=$?
      case $rc in
        0) : ;;
        2) error "Not a session id: ${BOLD}${id}${RESET} ${DIM}(ids are hex and dashes)${RESET}"; return 1 ;;
        3) error "Too short: ${BOLD}${id}${RESET}"
           echo -e "    ${DIM}Use at least 8 characters so it can only mean one session.${RESET}"
           return 1 ;;
        4) error "Ambiguous: ${BOLD}${id}${RESET} matches more than one session."
           printf '%s\n' "$resolved" | while IFS= read -r m; do
             [[ -n "$m" ]] && echo -e "    ${DIM}${m}${RESET}"
           done
           return 1 ;;
        *) error "No session in this project matching ${BOLD}${id}${RESET}."
           echo -e "    ${DIM}Looked in ${sdir}${RESET}"
           return 1 ;;
      esac
      if [[ "$sub" == "rename" ]]; then
        [[ $want_title -eq 1 && -z "$title" ]] && { error "${BOLD}--title${RESET} needs a value."; return 1; }
        _sessions_do_rename "$sdir" "$resolved" "$_BOX" "$cname" "$title"
        return $?
      fi
      _sessions_do_delete "$sdir" "$resolved" "$project" "$_BOX" "$cname" "$assume_yes"
      return $? ;;
  esac

  # ── list ──
  local rowfile total
  rowfile="$(mktemp "${TMPDIR:-/tmp}/cleat-sessions.XXXXXX" 2>/dev/null)" || {
    error "Could not create a temporary file."
    return 1
  }
  _sessions_scan_sorted "$sdir" > "$rowfile" 2>/dev/null || true
  total="$(awk 'END {print NR}' "$rowfile" 2>/dev/null || echo 0)"
  case "$total" in ''|*[!0-9]*) total=0 ;; esac

  if [[ "$total" -eq 0 ]]; then
    rm -f "$rowfile"
    info "No sessions for this project yet."
    echo -e "    ${DIM}Looked in ${sdir}${RESET}"
    return 0
  fi

  # The header is part of the picker's vertical budget (_SESSIONS_CHROME_LINES
  # counts it as four lines), which is why it is a function: the picker reprints
  # the same four lines after every action that left a receipt on the screen.
  _sessions_header "$sdir" "$project" "$_BOX"

  # The picker needs a terminal AND enough width to lay a row out. Below the
  # minimum every row would wrap into two physical lines while the redraw moves
  # up one, which walks the block down the screen a line per keypress. A plain
  # list is the honest answer there, not a broken picker.
  #
  # The width half is its own function so it can be tested: the tty half is two
  # fd tests that no sourced test can make true, so a test driving the whole
  # condition would pass for the wrong reason and pin nothing.
  if [[ -t 0 ]] && [[ -t 1 ]] && ! _sessions_too_narrow; then
    _sessions_picker_tui "$sdir" "$project" "$_BOX" "$cname" "$rowfile" "$total"
  else
    _sessions_picker_text "$rowfile" "$total" "$sdir"
  fi
  rm -f "$rowfile"
  # The picker materialises the trash list lazily, so this is the one cleanup
  # site for it however the picker ended.
  [[ -n "${_SESS_TRASHFILE:-}" ]] && rm -f "$_SESS_TRASHFILE"
  _SESS_TRASHFILE=""
  return 0
}

# Resolve a prefix against the TRASH rather than the live directory, so
# `cleat session restore <id>` takes the same short id the delete printed.
_sessions_restore_resolve() {
  local sdir="$1" want="$2" tdir d base uuid matches=() 
  case "$want" in ''|*[!0-9a-f-]*) return 1 ;; esac
  [[ ${#want} -ge 8 ]] || return 1
  tdir="$(_sessions_trash_dir "$sdir")" || return 1
  [[ -d "$tdir" ]] || return 1
  for d in "$tdir"/*; do
    [[ -d "$d" ]] || continue
    base="${d##*/}"
    uuid="${base#*-}"
    _sessions_is_uuid "$uuid" || continue
    case "$uuid" in
      "$want"*) matches=("${matches[@]+"${matches[@]}"}" "$uuid") ;;
    esac
  done
  # Refuse an ambiguous prefix rather than restoring the first match. Every
  # other id resolution in this feature does, and a restore that silently picks
  # one of two conversations is the same class of mistake as a delete that does.
  case ${#matches[@]} in
    0) return 1 ;;
    1) printf '%s' "${matches[0]}"; return 0 ;;
    *) for d in "${matches[@]}"; do printf '%s\n' "$d"; done; return 4 ;;
  esac
}

cmd_install() {
  local target="/usr/local/bin" force=""
  [[ "${1:-}" == "--force" ]] && force=1
  local script_path
  script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

  # Homebrew already linked a keg into the prefix, so there is nothing to add.
  if _is_brew_managed "${BASH_SOURCE[0]}"; then
    error "Installed via Homebrew: brew already links cleat into your PATH."
    echo -e "    ${DIM}Nothing to install. Update with: brew upgrade cleatdev/tap/cleat${RESET}"
    echo -e "    ${DIM}To switch to the script install: ${BOLD}brew uninstall cleatdev/tap/cleat${RESET}${DIM}, then run the installer.${RESET}"
    exit 1
  fi

  # $target is BOTH this command's destination and Homebrew's own bin on an
  # Intel Mac. Replacing brew's symlink there points the name at a tree brew
  # does not track, so the next `brew upgrade` fights over the same path.
  if _is_brew_managed "$target/cleat"; then
    error "$target/cleat belongs to Homebrew: refusing to replace it."
    echo -e "    ${DIM}To switch, remove that one first, then re-run this:${RESET}"
    echo -e "      ${BOLD}brew uninstall cleatdev/tap/cleat${RESET}"
    echo -e "      ${BOLD}cleat install${RESET}"
    echo -e "    ${DIM}Your config, boxes, trust and sessions are untouched by either step.${RESET}"
    exit 1
  fi

  # One install per machine: refuse a second cleat at any other bin path.
  _refuse_other_installs "$target/cleat" "$force" || exit 1

  info "Installing CLI symlink..."

  if [[ -w "$target" ]]; then
    ln -sf "$script_path" "$target/cleat"
  else
    sudo ln -sf "$script_path" "$target/cleat"
  fi

  success "Installed! You can now use ${BOLD}cleat${RESET} from anywhere."
  echo ""
  echo -e "  ${DIM}Try it:${RESET}"
  echo -e "    ${BOLD}cd ~/some-project && cleat start${RESET}"
  echo ""
}

cmd_uninstall() {
  local target="/usr/local/bin"

  # A keg is brew's to remove. Deleting the prefix symlink by hand leaves brew
  # believing cleat is still installed while the command is gone from PATH, and
  # only `brew link` puts it back. So hand it to brew, but ASK first: on a git
  # install this command drops a PATH symlink and leaves the clone alone, while
  # `brew uninstall` deletes the whole keg. That is more than the verb promises,
  # so it is consent-first and terminal-only. A decline, a redirected stdin, a
  # non-TTY or a brew that is off PATH all fall through to printing the command.
  if _is_brew_managed "${BASH_SOURCE[0]}"; then
    # _is_interactive, NOT _is_tty: the answer is read from stdin, so stdout
    # being a terminal proves nothing. With `[[ -t 1 ]]` alone, `yes | cleat
    # uninstall` opens the gate and the pipe answers the prompt, deleting a keg
    # with no human in the loop. A ttyless test harness cannot tell the two
    # apart (both false when stdout is not a tty), so no unit test catches a
    # regression here: this comment is the guard.
    if _is_interactive && _brew_present; then
      warn "Homebrew owns this install."
      echo -e "    ${DIM}brew uninstall removes the whole keg, not just the symlink on your PATH.${RESET}"
      local _byn=""
      _ask_yn _byn "Run brew uninstall cleatdev/tap/cleat now? [y/N] "
      case "$_byn" in
        [yY]|[yY][eE][sS]) _brew_delegate uninstall cleatdev/tap/cleat || true ;;
      esac
      info "Skipped. Uninstall later with: ${BOLD}brew uninstall cleatdev/tap/cleat${RESET}"
      exit 1
    fi
    error "Installed via Homebrew: cleat uninstall does not manage this install."
    echo -e "    ${DIM}Uninstall with: brew uninstall cleatdev/tap/cleat${RESET}"
    exit 1
  fi

  # The cross case: a git-installed cleat asked to clear a path Homebrew owns.
  # On an Intel Mac $target IS brew's bin, so the rm below would take brew's
  # symlink with it.
  if _is_brew_managed "$target/cleat"; then
    error "$target/cleat belongs to Homebrew: refusing to remove it."
    echo -e "    ${DIM}Uninstall that one with: brew uninstall cleatdev/tap/cleat${RESET}"
    exit 1
  fi

  info "Removing CLI symlinks..."
  if [[ -w "$target" ]]; then
    rm -f "$target/cleat"
  else
    sudo rm -f "$target/cleat"
  fi
  success "Uninstalled."
}

# ── cleat config ────────────────────────────────────────────────────────────
_cap_description() {
  case "$1" in
    git)    echo "Mount ~/.gitconfig (read-only) for commit identity" ;;
    ssh)    echo "Mount ~/.ssh (read-only) and forward SSH agent" ;;
    env)    echo "Load env vars from ~/.config/cleat/env and .cleat.env" ;;
    hooks)  echo "Run the hooks in ~/.claude/settings.json on the host" ;;
    gh)     echo "GitHub CLI auth (persists across rm/nuke/rebuild)" ;;
    docker) echo "Host Docker socket (breaks sandbox) to test Docker apps" ;;
    unsafe-rm) echo "Run rm without the delete-safety prompt (global/CLI only, disarms a guard)" ;;
    *)      echo "(unknown capability)" ;;
  esac
}

_scaffold_cleat_env() {
  local project="${1:-$PWD}"
  local env_file="$project/.cleat.env"
  [[ -f "$env_file" ]] && return 0
  cat > "$env_file" << 'ENVEOF'
# .cleat.env: project environment variables for Cleat
# Loaded when the "env" capability is enabled.
# Add to .gitignore: do not commit secrets.
#
# KEY=VALUE  set explicitly
# KEY        inherit from host environment
#
# Example:
# GH_TOKEN
# DATABASE_URL=postgres://localhost:5432/myapp
ENVEOF
  success "Created ${DIM}${env_file}${RESET} (add to .gitignore)"
}

# ── .cleat editor (capabilities + resources) ───────────────────────────────
#
# `cleat config` opens ONE flat list that edits both [caps] (SPACE toggles) and
# [resources] memory/cpus (←/→ cycles a preset ring). In GLOBAL scope a final
# "generate" row also stamps the selections into this project's ./.cleat, so the
# per-project config never has to be hand-written. It follows the `cleat kit`
# editor's shape (arrow-key TUI + a text fallback for non-TTY).

# Preset rings for the resource rows. Index 0 is the "unset" sentinel (default /
# all) so a previously-set value can be CLEARED by cycling back to it. 2g is
# deliberately absent from the memory ring: the VM-derived default floors at 4g,
# so offering 2g would read as a DOWNGRADE of "default". A hand-set custom value
# (e.g. 16g, 1.5) that is not a ring stop stays reachable (see _config_cycle_value).
#
# These two are the STATIC FALLBACK rings, used verbatim when the machine cannot
# be sized. The live editor builds its rings from the real machine instead (see
# _config_mem_choices / _config_cpu_choices) so it never offers a value this
# Docker cannot honour. It also stops hiding headroom this Docker really has.
_CONFIG_MEM_CHOICES=(default 4g 6g 8g)
_CONFIG_CPU_CHOICES=(all 1 2 4 8)

# The ceiling resolve_box_memory clamps a PROJECT-supplied value to. A .cleat
# ships with the repo, so an untrusted project must not be able to re-introduce
# VM-wide overcommit. Kept in whole GB for the ring and the notes. This MUST stay
# in sync with the 8589934592 byte comparisons in resolve_box_memory and
# _configured_box_memory; `config: project ring stops at the runtime clamp`
# in config.bats fails if the two ever drift.
_PROJECT_MEM_CAP_GB=8

# The Docker VM's memory in whole GB, empty when it cannot be sized. The single
# seam the memory ring AND its warnings both read, so the top of the ring and
# the "that is your whole VM" warning can never disagree (the same
# one-helper-for-display-and-threshold rule _docker_vm_display_gb exists for).
_config_vm_gb() {
  local b g
  b="$(_docker_vm_memory)"
  [[ "$b" =~ ^[0-9]+$ ]] && (( b > 0 )) || return 0
  g="$(_docker_vm_display_gb "$b")"
  if [[ "$g" =~ ^[0-9]+$ ]] && (( g > 0 )); then
    printf '%s' "$g"
  fi
  return 0
}

# The memory ring for a scope, space separated. GLOBAL scope climbs in real
# stops up to the Docker VM's own size: someone who runs one box at a time may
# legitimately want all of it. Capping the picker at 8g hid headroom on a
# 24 GB VM. PROJECT scope stops at the runtime clamp, so the picker can never
# offer a repo-shipped value the box would silently not get. Unknown VM size
# falls back to the static ring (never invent headroom we cannot verify).
_config_mem_choices() {
  local scope="${1:-global}" vm_gb g out
  out="${_CONFIG_MEM_CHOICES[*]}"
  if [[ "$scope" == "project" ]]; then
    printf '%s' "$out"
    return 0
  fi
  vm_gb="$(_config_vm_gb)"
  if ! [[ "$vm_gb" =~ ^[0-9]+$ ]] || (( vm_gb <= _PROJECT_MEM_CAP_GB )); then
    printf '%s' "$out"
    return 0
  fi
  for g in 12 16 24 32 48 64 96 128 192 256; do
    (( g < vm_gb )) || break
    out="$out ${g}g"
  done
  printf '%s %sg' "$out" "$vm_gb"
}

# The cpu ring, space separated, built from the daemon's REAL core count. A
# --cpus above NCPU is a dockerd error, so a ring stop the machine cannot honour
# is a trap. Equally, a fixed ring ending at 8 hid 16 cores on a big machine.
# The ring always ends on the exact core count (a hard cap at every core, which
# is not the same as `all`: `all` writes no --cpus at all). Unknown core count
# falls back to the static ring.
_config_cpu_choices() {
  local ncpu n out
  ncpu="$(_daemon_ncpu)"
  if ! [[ "$ncpu" =~ ^[0-9]+$ ]] || (( ncpu < 1 )); then
    printf '%s' "${_CONFIG_CPU_CHOICES[*]}"
    return 0
  fi
  out="all"
  for n in 1 2 4 8 16 32 64 128; do
    (( n < ncpu )) || break
    out="$out $n"
  done
  printf '%s %s' "$out" "$ncpu"
}

# The graduated note for a chosen memory ceiling. Emits EXACTLY two lines (both
# empty below the first tier) so the picker's redraw math stays a constant: a
# note that wrapped or changed height would desync every cursor-up in the TUI.
# Keep each line under ~74 visible columns for the same reason.
#
# Three tiers, because more RAM reads as free until it is not. A cgroup limit is
# a ceiling, not a reservation, so a big number is harmless right up until a box
# actually grows into it. The tiers are relative to the VM, the only number that
# decides whether one box can starve the daemon. The top tier is the honest
# one. $1 = the value, $2 = the VM size in GB (empty when unknown).
_config_mem_note() {
  local v="$1" vm_gb="${2:-}" gb
  case "$v" in ""|default) printf '\n\n'; return 0 ;; esac
  if ! _valid_memory_value "$v"; then printf '\n\n'; return 0; fi
  gb=$(( $(_mem_to_bytes "$v") / 1073741824 ))

  # The whole-VM tier is tested BEFORE the 8 GB floor, because it must agree
  # with _config_mem_warn_block, which has no floor. A Docker Desktop VM left at
  # its 8 GB default makes 8g BOTH the ring's top stop and the entire VM: with
  # the floor first the picker said nothing and then ENTER printed the full amber
  # block. The floor still guards the two milder tiers, so a 4g ceiling on a
  # small VM stays quiet (it is the derived default there, not a choice).
  if [[ "$vm_gb" =~ ^[0-9]+$ ]] && (( vm_gb >= 1 )) && (( gb >= vm_gb )); then
    printf 'warning: %s GB is the whole Docker VM. A box that grows into it\n' "$gb"
    printf '         starves the daemon, so Linux OOM-kills inside the VM.\n'
    return 0
  fi
  if (( gb <= _PROJECT_MEM_CAP_GB )); then printf '\n\n'; return 0; fi

  if ! [[ "$vm_gb" =~ ^[0-9]+$ ]] || (( vm_gb < 1 )); then
    printf 'note: above %s GB. A ceiling is not a reservation, so this only\n' "$_PROJECT_MEM_CAP_GB"
    printf '      bites when a box really grows into it.\n'
    return 0
  fi
  if (( gb * 2 >= vm_gb )); then
    printf 'note: over half the %s GB Docker VM. Two boxes at this ceiling can\n' "$vm_gb"
    printf '      oversubscribe it, so run one at a time.\n'
    return 0
  fi
  printf 'note: above %s GB of the %s GB VM. A ceiling is not a reservation,\n' "$_PROJECT_MEM_CAP_GB" "$vm_gb"
  printf '      so this only bites when a box really grows into it.\n'
}

# The full paragraph behind the top tier, printed once on SAVE (and by the
# direct-mode setter) rather than in the picker, where two lines is all the
# redraw can afford. This is the "why is that dangerous" the short note cannot
# hold. Prints nothing below the top tier.
_config_mem_warn_block() {
  local v="$1" vm_gb="${2:-}" gb
  case "$v" in ""|default) return 0 ;; esac
  _valid_memory_value "$v" || return 0
  [[ "$vm_gb" =~ ^[0-9]+$ ]] && (( vm_gb > 0 )) || return 0
  gb=$(( $(_mem_to_bytes "$v") / 1073741824 ))
  (( gb >= vm_gb )) || return 0
  echo ""
  warn "A ${gb} GB ceiling is the entire Docker VM."
  echo -e "    ${DIM}Docker gives the box a ceiling, not a reservation, so this is fine${RESET}"
  echo -e "    ${DIM}until an agent really uses it. When one does, nothing is left for${RESET}"
  echo -e "    ${DIM}the daemon or the VM's own kernel. The Linux OOM killer inside${RESET}"
  echo -e "    ${DIM}the VM then starts killing processes. That can take out a working${RESET}"
  echo -e "    ${DIM}agent mid-write or wedge Docker until you restart it. Leave the VM${RESET}"
  echo -e "    ${DIM}a couple of GB of headroom. Run one box at a time at this size.${RESET}"
}

# Cycle a resource value through its ring. $1 = next|prev, $2 = current value,
# $3 = custom pin (a hand-set value not in the ring; pass "" when none), $4.. =
# ring choices. Mirrors _kit_next_model/_kit_prev_model but wraps with modulo and
# folds the custom pin in ONCE (deduped against the choices so a preset value
# passed as custom does not double-append). ALWAYS ends on `echo`, never a bare
# test/arithmetic, so a strict-mode `$(...)` caller is never killed.
_config_cycle_value() {
  local dir="$1" current="$2" custom="$3"
  shift 3
  local ring=("$@")
  if [[ -n "$custom" ]]; then
    local _dup=false _c
    for _c in "$@"; do [[ "$_c" == "$custom" ]] && _dup=true; done
    $_dup || ring+=("$custom")
  fi
  local m=${#ring[@]} i
  for ((i = 0; i < m; i++)); do
    if [[ "${ring[$i]}" == "$current" ]]; then
      if [[ "$dir" == "prev" ]]; then
        echo "${ring[$(((i - 1 + m) % m))]}"
      else
        echo "${ring[$(((i + 1) % m))]}"
      fi
      return 0
    fi
  done
  # current is not on the ring (e.g. a value cleared out from under us): land on
  # the first stop so a keypress always moves somewhere sane.
  echo "${ring[0]}"
}

# Map a cursor position to the row it addresses. Echoes cap:<name> | mem | cpus |
# gen. The nav order is: caps 0..N-1, then memory, then cpus, then (global scope
# only) the generate row. This is the ONLY place that turns a cursor into a
# KNOWN_CAPS index, so no key handler ever indexes KNOWN_CAPS with a cursor that
# might land on a resource/generate row (that read is a set -u crash in the real
# binary, not a silent no-op).
_config_row_kind() {
  local cur="$1" ncaps=${#KNOWN_CAPS[@]}
  if (( cur < ncaps )); then
    echo "cap:${KNOWN_CAPS[$cur]}"
  elif (( cur == ncaps )); then
    echo "mem"
  elif (( cur == ncaps + 1 )); then
    echo "cpus"
  else
    echo "gen"
  fi
}

# Draw the whole editor block: a "Capabilities" group, the cap rows, a blank, a
# "Resources" group, the memory + cpus rows, and (when show_gen=1) a blank plus
# the generate row. It always emits the SAME number of physical lines for a given
# scope (deterministic), which is what lets the TUI's cursor-up/down math be a
# single scope-derived constant. Every row is one physical line; keep labels short
# so an 80-column terminal never wraps a row (a wrap desyncs the redraw). New
# params are read with `${n:-}` defaults so both the 2-arg draw tests and the real
# strict-mode binary are safe.
_config_picker_draw() {
  local cursor="$1"
  local toggled="$2"
  local mem="${3:-default}"
  local cpus="${4:-all}"
  local show_gen="${5:-0}"
  local gen_on="${6:-0}"
  local vm_gb="${7:-}"
  local ncaps=${#KNOWN_CAPS[@]}
  local i=0 cap marker

  printf '\033[2K'
  echo -e "  ${DIM}Capabilities${RESET} ${DIM}(space toggles host access)${RESET}"
  while [[ $i -lt $ncaps ]]; do
    cap="${KNOWN_CAPS[$i]}"
    marker="${DIM}·${RESET}"
    case ",${toggled}," in *,"$cap",*) marker="${GREEN}✔${RESET}" ;; esac
    printf '\033[2K'
    if [[ $i -eq $cursor ]]; then
      echo -e "  ${CYAN}▸${RESET} [${marker}] ${BOLD}${cap}${RESET}  $(_cap_description "$cap")"
    else
      echo -e "    [${marker}] ${cap}  ${DIM}$(_cap_description "$cap")${RESET}"
    fi
    i=$((i + 1))
  done

  printf '\033[2K'; echo ""
  printf '\033[2K'
  echo -e "  ${DIM}Resources${RESET} ${DIM}(←/→ changes the value)${RESET}"
  printf '\033[2K'
  if [[ $cursor -eq $ncaps ]]; then
    echo -e "  ${CYAN}▸${RESET} memory  ${BOLD}‹ ${mem} ›${RESET}  ${DIM}(per-box RAM ceiling)${RESET}"
  else
    echo -e "    memory  ${mem}  ${DIM}(per-box RAM ceiling)${RESET}"
  fi
  printf '\033[2K'
  if [[ $cursor -eq $((ncaps + 1)) ]]; then
    echo -e "  ${CYAN}▸${RESET} cpus    ${BOLD}‹ ${cpus} ›${RESET}  ${DIM}(core limit; all = no cap)${RESET}"
  else
    echo -e "    cpus    ${cpus}  ${DIM}(core limit; all = no cap)${RESET}"
  fi

  if [[ "$show_gen" == "1" ]]; then
    printf '\033[2K'; echo ""
    marker="${DIM}·${RESET}"
    [[ "$gen_on" == "1" ]] && marker="${GREEN}✔${RESET}"
    printf '\033[2K'
    if [[ $cursor -eq $((ncaps + 2)) ]]; then
      echo -e "  ${CYAN}▸${RESET} [${marker}] ${BOLD}Also write these to this project's .cleat${RESET}"
    else
      echo -e "    [${marker}] ${DIM}Also write these to this project's .cleat${RESET}"
    fi
  fi

  # The memory note area: ALWAYS exactly two lines, blank below the first tier.
  # Reserved rather than conditional because the TUI repositions by a constant
  # number of lines, so a note that appeared and vanished would desync the whole
  # redraw. Amber at the top tier, dim below it.
  local note_line note_i=0
  while IFS= read -r note_line; do
    note_i=$((note_i + 1))
    [[ $note_i -le 2 ]] || break
    printf '\033[2K'
    case "$note_line" in
      warning:*) echo -e "  ${AMBER}${note_line}${RESET}" ;;
      "")        echo "" ;;
      *)         echo -e "  ${DIM}${note_line}${RESET}" ;;
    esac
  done < <(_config_mem_note "$mem" "$vm_gb")
  while [[ $note_i -lt 2 ]]; do
    note_i=$((note_i + 1))
    printf '\033[2K'; echo ""
  done
}

# Read the scope file's memory into a (display-value, custom-pin) pair. Empty
# becomes the sentinel; a value not on the ring becomes the reachable custom pin.
# Printed as "<display>\t<custom>" for the caller to split. `|| true` because a
# strict-mode caller assigns this bare and a file read must never abort the editor.
_config_load_resource() {
  local file="$1" key="$2" unset_label="$3" ring="${4:-}" _lbox="${5:-}"
  # $5 is the BOX. Its OWN declared value, never the inherited one: the picker
  # writes back whatever it loaded, so loading the project's number would either
  # freeze it into the box's section or silently clear the box's own ceiling.
  # Read from exactly the section the WRITER will target, via the one shared
  # resolver. Reading "box.$_lbox.resources" unconditionally broke box `main`,
  # whose writer targets the bare [resources]: the load found nothing, the
  # picker showed "default", and saving wrote an empty section, DELETING the
  # project's [resources]. Found by the portability review against a real pty.
  local v _lsec
  _lsec="$(_config_section_for "$file" "$_lbox" resources)"
  v="$(_read_section_from_file "$file" "$_lsec" "$key" || true)"
  local choices
  # $4 is the live ring when the caller built one from this machine. Without it
  # we fall back to the static ring, which keeps every direct 3-arg caller (and
  # the 3-arg tests) reading exactly as before.
  if [[ -n "$ring" ]]; then
    choices=" $ring "
  elif [[ "$key" == "memory" ]]; then choices=" ${_CONFIG_MEM_CHOICES[*]} "; else choices=" ${_CONFIG_CPU_CHOICES[*]} "; fi
  if [[ -z "$v" ]]; then
    printf '%s\t%s\n' "$unset_label" ""
  else
    case "$choices" in
      *" $v "*) printf '%s\t%s\n' "$v" "" ;;
      *)        printf '%s\t%s\n' "$v" "$v" ;;
    esac
  fi
}

# Persist the editor state to the scope file (caps + resources, both section
# preserving), then, in global scope with the generate row on, offer to stamp a
# project ./.cleat. project is resolved ONCE by cmd_config and threaded through so
# the scope label and any write target can never diverge.
_config_editor_save() {
  local config_file="$1" scope="$2" project="$3" toggled="$4" mem="$5" cpus="$6" show_gen="$7" gen_on="$8" vm_gb="${9:-}"
  # $10 is the BOX. Without it the interactive picker wrote a box's edit into
  # the project-wide [caps]/[resources], granting it to EVERY box, while the
  # same edit through --enable/--disable correctly scoped. Two review passes
  # caught it independently.
  local _ebox="${10:-}"
  local _esec_caps _esec_res
  _esec_caps="$(_config_section_for "$config_file" "$_ebox" caps)"
  _esec_res="$(_config_section_for "$config_file" "$_ebox" resources)"

  local final_caps=() cap
  for cap in "${KNOWN_CAPS[@]}"; do
    # A project-scope save never writes unsafe-rm, which resolve_caps strips from
    # a project .cleat. Same rule as `cleat config --project --enable unsafe-rm`.
    if [[ "$cap" == unsafe-rm && "$scope" == project ]]; then
      case ",${toggled}," in
        *,"$cap",*) warn "Not saving ${BOLD}unsafe-rm${RESET} to ${config_file}: it is accepted only from your global config or ${BOLD}--cap${RESET}." ;;
      esac
      continue
    fi
    case ",${toggled}," in *,"$cap",*) final_caps+=("$cap") ;; esac
  done
  local mem_w="$mem" cpu_w="$cpus"
  case "$mem_w" in default|all) mem_w="" ;; esac
  case "$cpu_w" in default|all) cpu_w="" ;; esac

  _config_write_caps_scoped "$config_file" "$_esec_caps" "$_ebox" "${final_caps[@]+"${final_caps[@]}"}"
  _WRITE_RES_SECTION="$_esec_res" _write_resources_to_file "$config_file" "$mem_w" "$cpu_w"
  _config_note_sections_version "$config_file"
  if [[ -n "$_ebox" ]]; then
    success "Saved to ${config_file} ${DIM}(box ${_ebox})${RESET}"
  else
    success "Saved to ${config_file}"
  fi
  # The two-line picker note is a nudge. This is the full reason, printed once,
  # only when the ceiling reaches the whole VM.
  _config_mem_warn_block "$mem_w" "$vm_gb"

  case ",${toggled}," in
    *,env,*)
      if [[ -n "$project" && ! -f "${project}/.cleat.env" ]]; then
        echo ""
        local yn=""
        _ask_yn yn "Create .cleat.env in ${project}? [Y/n] "
        if [[ -z "$yn" || "$yn" == [yY]* ]]; then
          _scaffold_cleat_env "$project"
        fi
      fi
      ;;
  esac

  if [[ "$show_gen" == "1" && "$gen_on" == "1" ]]; then
    _config_generate_project "$project" "$mem_w" "$cpu_w" "${final_caps[@]+"${final_caps[@]}"}"
  fi
}

_config_picker_tui() {
  local config_file="$1"
  local scope="$2"
  local project="${3:-}"

  echo ""
  echo -e "  ${BOLD}Cleat config${RESET} ${DIM}(capabilities + resources)${RESET}"
  echo ""
  local scope_label
  if [[ "$scope" == "project" ]]; then
    scope_label="project (${config_file})"
  else
    scope_label="global (${config_file})"
  fi
  echo -e "  ${DIM}Scope: ${scope_label}${RESET}"

  # Rings are built ONCE from the real machine (VM memory, daemon core count) and
  # threaded through every cycle below, so the picker offers exactly what this
  # Docker can honour. Both fall back to the static rings when the machine cannot
  # be sized, so a down daemon degrades to the old behaviour instead of an error.
  local mem_ring cpu_ring vm_gb
  mem_ring="$(_config_mem_choices "$scope")"
  cpu_ring="$(_config_cpu_choices)"
  vm_gb="$(_config_vm_gb)"

  # Project scope stops at the runtime clamp, so say why rather than let the ring
  # look arbitrarily short next to a global editor that climbs to the VM size.
  if [[ "$scope" == "project" ]]; then
    echo -e "  ${DIM}A project .cleat caps memory at ${_PROJECT_MEM_CAP_GB} GB. Raise it in the global config.${RESET}"
  fi

  local toggled="" cap
  while IFS= read -r cap; do
    [[ -n "$cap" ]] && toggled="${toggled:+${toggled},}${cap}"
  done < <(_read_caps_from_file "$config_file" "$_box_scope")

  local mem mem_custom cpus cpu_custom _pair
  _pair="$(_config_load_resource "$config_file" memory default "$mem_ring" "$_box_scope")"
  mem="${_pair%%$'\t'*}"; mem_custom="${_pair#*$'\t'}"
  _pair="$(_config_load_resource "$config_file" cpus all "$cpu_ring" "$_box_scope")"
  cpus="${_pair%%$'\t'*}"; cpu_custom="${_pair#*$'\t'}"

  local show_gen=0 gen_on=0
  [[ "$scope" == "global" && -n "$project" ]] && show_gen=1

  local ncaps=${#KNOWN_CAPS[@]}
  # nav_rows: the rows the cursor ranges over. draw_lines: the physical lines the
  # block draws (incl. the two group headers, the blank separators and the
  # always-two-line memory note area). BOTH are scope-derived and computed ONCE
  # so every reposition below uses one constant.
  local nav_rows=$((ncaps + 2)) draw_lines=$((ncaps + 7))
  if [[ "$show_gen" == "1" ]]; then
    nav_rows=$((nav_rows + 1))
    draw_lines=$((draw_lines + 2))
  fi

  if [[ "$show_gen" == "1" ]]; then
    echo -e "  ${DIM}The last row writes ./.cleat so every clone runs in the same cage.${RESET}"
  fi
  echo ""

  local cursor=0
  _cursor_hide

  _config_picker_draw "$cursor" "$toggled" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb"
  echo ""
  echo -e "  ${DIM}↑/↓ move  space toggle  ←/→ change  ⏎ save  q cancel${RESET}"
  printf '\033[%dA' "$((draw_lines + 2))"

  while true; do
    local key kind
    key="$(_read_keypress)"
    kind="$(_config_row_kind "$cursor")"

    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=$((cursor - 1)) ;;
      DOWN) [[ $cursor -lt $((nav_rows - 1)) ]] && cursor=$((cursor + 1)) ;;
      SPACE)
        case "$kind" in
          cap:*)
            local current_cap="${kind#cap:}"
            case ",${toggled}," in
              *,"$current_cap",*)
                local _new="" _c
                for _c in $(echo "$toggled" | tr ',' ' '); do
                  [[ "$_c" == "$current_cap" ]] && continue
                  _new="${_new:+${_new},}${_c}"
                done
                toggled="$_new" ;;
              *) toggled="${toggled:+${toggled},}${current_cap}" ;;
            esac ;;
          mem)  mem="$(_config_cycle_value next "$mem" "$mem_custom" $mem_ring)" ;;
          cpus) cpus="$(_config_cycle_value next "$cpus" "$cpu_custom" $cpu_ring)" ;;
          gen)  [[ "$gen_on" == "1" ]] && gen_on=0 || gen_on=1 ;;
        esac ;;
      RIGHT)
        case "$kind" in
          mem)  mem="$(_config_cycle_value next "$mem" "$mem_custom" $mem_ring)" ;;
          cpus) cpus="$(_config_cycle_value next "$cpus" "$cpu_custom" $cpu_ring)" ;;
        esac ;;
      LEFT)
        case "$kind" in
          mem)  mem="$(_config_cycle_value prev "$mem" "$mem_custom" $mem_ring)" ;;
          cpus) cpus="$(_config_cycle_value prev "$cpus" "$cpu_custom" $cpu_ring)" ;;
        esac ;;
      ENTER)
        _cursor_show
        printf '\033[%dB' "$((draw_lines + 2))"
        printf '\033[2K'
        echo ""
        _config_editor_save "$config_file" "$scope" "$project" "$toggled" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb" "$_box_scope"
        return ;;
      QUIT|ESC)
        _cursor_show
        printf '\033[%dB' "$((draw_lines + 2))"
        printf '\033[2K'
        echo ""
        info "Cancelled."
        return ;;
    esac

    _config_picker_draw "$cursor" "$toggled" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb"
    printf '\033[%dA' "$draw_lines"
  done
}

# Write a project ./.cleat from the editor's selections. Fixed args FIRST so the
# variadic caps can be recovered in bash 3.2 (`shift 3; caps=("$@")`). When the
# file is FRESH we lay down a short header comment first (readers skip `#` lines),
# then the section-preserving caps + resources writers keep it as preamble. When
# it already exists we never touch the header: the writers replace only [caps] and
# [resources] and leave [setup] and any other section byte-for-byte.
_generate_project_cleat() {
  local project="$1" memory="$2" cpus="$3"
  shift 3
  local caps=("$@")
  local file="${project}/.cleat"
  local fresh=0
  [[ -f "$file" ]] || fresh=1

  if [[ $fresh -eq 1 ]]; then
    mkdir -p "$project"
    {
      echo "# .cleat: Cleat project config. Commit it so every clone runs in the same cage."
      echo "# Written by 'cleat config'. Edit freely or re-run the editor."
      echo "# [caps] grant host access (off by default). [resources] cap the box."
      echo "# Docs: https://cleat.sh/docs"
      echo ""
    } > "$file"
  fi

  _write_caps_to_file "$file" "${caps[@]+"${caps[@]}"}"
  _write_resources_to_file "$file" "$memory" "$cpus"
}

# Confirm and stamp the selections into ./.cleat (global-scope generate row). This
# is an outward-facing write of a file the user is told to commit and share, so it
# is gated behind an explicit default-DENY confirm that spells out exactly which
# caps land in it (docker called out in amber: it hands over the host once trusted).
# We never auto-trust and never offer `cleat trust` here: trust is a separate,
# next-run ritual (and cmd_trust would also approve any pre-existing [setup]).
_config_generate_project() {
  local project="$1" memory="$2" cpus="$3"
  shift 3
  # Never unsafe-rm: resolve_caps strips it from a project .cleat, so stamping it
  # into the committed file would promise a cap no clone ever gets.
  local caps=() _gc
  for _gc in "$@"; do
    case "$_gc" in unsafe-rm) ;; *) caps+=("$_gc") ;; esac
  done
  local target="${project}/.cleat"

  case "$project" in
    ""|"/"|"$HOME")
      warn "Not writing .cleat in ${project:-this location} ${DIM}(run cleat config from a project directory)${RESET}"
      return 0 ;;
  esac
  if [[ ${#caps[@]} -eq 0 && -z "$memory" && -z "$cpus" ]]; then
    info "Nothing to write to .cleat ${DIM}(no capabilities enabled and resources at default)${RESET}"
    return 0
  fi

  # The global editor's memory ring climbs to the VM size, but resolve_box_memory
  # clamps a PROJECT value back down, so writing the bigger number into .cleat
  # would promise a ceiling the box never gets. Clamp here and say so, rather
  # than stamp a figure the runtime quietly overrides.
  local mem_clamped=0
  if [[ -n "$memory" ]] && _valid_memory_value "$memory" && (( $(_mem_to_bytes "$memory") > 8589934592 )); then
    memory="${_PROJECT_MEM_CAP_GB}g"
    mem_clamped=1
  fi

  echo ""
  echo -e "  ${BOLD}Write ${target}${RESET}"
  echo -e "  ${DIM}This file is committed and shared. Every clone runs in the same cage.${RESET}"
  echo ""
  if [[ ${#caps[@]} -gt 0 ]]; then
    echo -e "  ${DIM}Capabilities (host access):${RESET}"
    local c
    for c in "${caps[@]}"; do
      if [[ "$c" == "docker" ]]; then
        echo -e "    ${AMBER}!${RESET} ${BOLD}docker${RESET} ${DIM}(mounts the host Docker socket: full host control once trusted)${RESET}"
      else
        echo -e "    ${GREEN}✔${RESET} ${c}"
      fi
    done
  else
    echo -e "  ${DIM}Capabilities: none${RESET}"
  fi
  local res=""
  [[ -n "$memory" ]] && res="memory = ${memory}"
  [[ -n "$cpus" ]] && res="${res:+${res}    }cpus = ${cpus}"
  [[ -n "$res" ]] && echo -e "  ${DIM}Resources: ${res}${RESET}"
  if [[ $mem_clamped -eq 1 ]]; then
    echo -e "  ${DIM}Memory written as ${_PROJECT_MEM_CAP_GB}g: a project .cleat is capped there. Your global setting keeps its larger value.${RESET}"
  fi
  if [[ -f "$target" ]]; then
    echo -e "  ${DIM}${target} exists: its [caps] and [resources] are replaced, other sections kept.${RESET}"
  fi
  echo ""
  local yn=""
  _ask_yn yn "Write this .cleat? ${DIM}[y/N]${RESET} "
  if [[ "$yn" == [yY]* ]]; then
    _generate_project_cleat "$project" "$memory" "$cpus" "${caps[@]+"${caps[@]}"}"
    success "Wrote ${target}"
    info "Its capabilities apply after you approve it on the next run ${DIM}(or cleat trust)${RESET}"
  else
    info "Skipped .cleat"
  fi
}

# Trim leading/trailing whitespace then a single leading '=' then whitespace, so a
# resource keyword accepts `memory 4g`, `memory=4g`, and `memory = 4g` (users mirror
# the file, which writes `memory = 8g`). Echoes the bare value.
_config_kw_value() {
  local rest="$1"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  rest="${rest#=}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  rest="${rest%"${rest##*[![:space:]]}"}"
  echo "$rest"
}

_config_picker_text() {
  local config_file="$1"
  local scope="$2"
  local project="${3:-}"

  echo ""
  echo -e "  ${BOLD}Cleat config${RESET} ${DIM}(capabilities + resources)${RESET}"
  echo ""
  local scope_label
  if [[ "$scope" == "project" ]]; then
    scope_label="project (${config_file})"
  else
    scope_label="global (${config_file})"
  fi
  echo -e "  ${DIM}Scope: ${scope_label}${RESET}"
  echo ""

  local _active="" cap
  while IFS= read -r cap; do
    [[ -n "$cap" ]] && _active="${_active:+${_active},}${cap}"
  done < <(_read_caps_from_file "$config_file" "$_box_scope")

  local mem cpus _pair vm_gb
  _pair="$(_config_load_resource "$config_file" memory default "" "$_box_scope")"; mem="${_pair%%$'\t'*}"
  _pair="$(_config_load_resource "$config_file" cpus all "" "$_box_scope")"; cpus="${_pair%%$'\t'*}"
  # Text mode types a value instead of cycling a ring, so it can name any size
  # at all. It therefore needs the VM size just as much as the TUI does, or a
  # piped `memory 64g` saves a whole-VM ceiling in silence.
  vm_gb="$(_config_vm_gb)"

  local show_gen=0 gen_on=0
  [[ "$scope" == "global" && -n "$project" ]] && show_gen=1
  if [[ "$scope" == "project" ]]; then
    echo -e "  ${DIM}A project .cleat caps memory at ${_PROJECT_MEM_CAP_GB} GB. Raise it in the global config.${RESET}"
  fi

  for cap in "${KNOWN_CAPS[@]}"; do
    local marker="${DIM}·${RESET}"
    case ",${_active}," in *,"$cap",*) marker="${GREEN}✔${RESET}" ;; esac
    echo -e "    [${marker}] ${BOLD}${cap}${RESET}     $(_cap_description "$cap")"
  done
  echo ""
  echo -e "  ${DIM}Resources: memory=${mem}  cpus=${cpus}${RESET}"

  echo ""
  echo -e "  ${DIM}Capabilities: type a name to flip. Resources: \"memory 4g\", \"cpus 2\"${RESET}"
  if [[ "$show_gen" == "1" ]]; then
    echo -e "  ${DIM}\"project\" writes ./.cleat too. \"done\" to save, \"q\" to cancel${RESET}"
  else
    echo -e "  ${DIM}\"done\" to save, \"q\" to cancel${RESET}"
  fi

  while true; do
    echo -n "  > "
    local input
    read -r input || { echo ""; info "Cancelled."; return 0; }
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"

    case "$input" in
      done)
        _config_editor_save "$config_file" "$scope" "$project" "$_active" "$mem" "$cpus" "$show_gen" "$gen_on" "$vm_gb" "$_box_scope"
        return
        ;;
      q|quit)
        info "Cancelled."
        return
        ;;
      memory|memory[!a-zA-Z0-9]*)
        local _v; _v="$(_config_kw_value "${input#memory}")"
        case "$_v" in
          ""|default) mem="default"; success "memory set to default" ;;
          *)
            if _valid_memory_value "$_v"; then
              mem="$_v"; success "memory set to ${_v}"
            else
              warn "Not a memory value: ${BOLD}${_v}${RESET} ${DIM}(use e.g. 4g, 4096m, or \"default\")${RESET}"
            fi ;;
        esac
        ;;
      cpus|cpus[!a-zA-Z0-9]*)
        local _v; _v="$(_config_kw_value "${input#cpus}")"
        case "$_v" in
          ""|all) cpus="all"; success "cpus set to all (no cap)" ;;
          *)
            if _valid_cpus_value "$_v"; then
              cpus="$_v"; success "cpus set to ${_v}"
            else
              warn "Not a cpus value: ${BOLD}${_v}${RESET} ${DIM}(use e.g. 2, 1.5, or \"all\")${RESET}"
            fi ;;
        esac
        ;;
      project|generate)
        if [[ "$show_gen" == "1" ]]; then
          [[ "$gen_on" == "1" ]] && gen_on=0 || gen_on=1
          [[ "$gen_on" == "1" ]] && success "will also write ./.cleat" || info "will not write ./.cleat"
        else
          warn "\"project\" only applies to the global config ${DIM}(project scope already writes .cleat)${RESET}"
        fi
        ;;
      *)
        local found=false known
        for known in "${KNOWN_CAPS[@]}"; do
          if [[ "$known" == "$input" ]]; then
            found=true
            case ",${_active}," in
              *,"$input",*)
                local _new_active="" _c
                for _c in $(echo "$_active" | tr ',' ' '); do
                  [[ "$_c" == "$input" ]] && continue
                  _new_active="${_new_active:+${_new_active},}${_c}"
                done
                _active="$_new_active"
                success "${input} disabled"
                ;;
              *)
                _active="${_active:+${_active},}${input}"
                success "${input} enabled"
                ;;
            esac
            break
          fi
        done
        if ! $found; then
          warn "Unknown capability: ${input}. Available: ${KNOWN_CAPS[*]}"
        fi
        ;;
    esac
  done
}

cmd_config() {
  local scope="global"
  local action=""
  local cap_name=""
  local box=""
  # `__MISSING__` distinguishes "flag with no value token" (an error) from an
  # explicit empty value (`--memory ""` / `--memory default`), which CLEARS the key.
  local res_key="" res_val="__MISSING__"

  # Parse config subcommand flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)  scope="project"; shift ;;
      --enable)
        action="enable"
        if [[ $# -lt 2 ]]; then cap_name=""; shift; else cap_name="$2"; shift 2; fi
        ;;
      --disable)
        action="disable"
        if [[ $# -lt 2 ]]; then cap_name=""; shift; else cap_name="$2"; shift 2; fi
        ;;
      --memory)
        action="resource"; res_key="memory"
        if [[ $# -lt 2 ]]; then res_val="__MISSING__"; shift; else res_val="$2"; shift 2; fi
        ;;
      --cpus)
        action="resource"; res_key="cpus"
        if [[ $# -lt 2 ]]; then res_val="__MISSING__"; shift; else res_val="$2"; shift 2; fi
        ;;
      --list)     action="list"; shift ;;
      --*)
        error "Unknown config option: $1"
        exit 1
        ;;
      *)
        # A bareword positional is a box name → operate on that box's project
        # cap file (.cleat.<box>). "main" maps to the base .cleat.
        if [[ -n "$box" ]]; then
          error "Unexpected argument: ${BOLD}$1${RESET}"
          exit 1
        fi
        if ! _validate_box_name "$1"; then
          error "Invalid box name: ${BOLD}$1${RESET}"
          echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
          exit 1
        fi
        box="$1"; scope="project"; shift
        ;;
    esac
  done

  # pwd resolved ONCE so the scope label, the config target, and any generated
  # ./.cleat all agree (matches the historical `$(pwd)/.cleat` behavior).
  local project; project="$(pwd)"
  local config_file
  if [[ -n "$box" && "$box" != "main" ]]; then
    # One file per project. A named box edits its own SECTIONS inside .cleat
    # rather than getting a whole separate file, which is what retired the
    # strip-the-box footgun: writing [box.B.resources] cannot remove [caps] or
    # [setup], because there is no whole-file replacement to trigger.
    config_file="${project}/.cleat"
    _warn_legacy_box_file "$project" "$box"
  elif [[ "$scope" == "project" ]]; then
    config_file="${project}/.cleat"
  else
    config_file="$CLEAT_GLOBAL_CONFIG"
  fi
  # The sections this invocation writes. Empty box = the bare [caps]/[resources].
  local _sec_caps _sec_res _box_scope=""
  [[ -n "$box" ]] && _box_scope="$box"
  _sec_caps="$(_config_section_for "$config_file" "$_box_scope" caps)"
  _sec_res="$(_config_section_for "$config_file" "$_box_scope" resources)"

  # ── Direct mode: --list
  if [[ "$action" == "list" ]]; then
    echo ""
    echo -e "  ${BOLD}Capabilities${RESET}"
    echo ""
    # Read current caps
    local _active_list=""
    local cap
    while IFS= read -r cap; do
      [[ -n "$cap" ]] && _active_list="${_active_list:+${_active_list},}${cap}"
    done < <(_read_caps_from_file "$CLEAT_GLOBAL_CONFIG")
    # Also read project caps if available (box-aware: .cleat.<box> else .cleat)
    local _proj_caps_file
    _proj_caps_file="$(_project_caps_file "$project")"
    if [[ -f "$_proj_caps_file" ]]; then
      while IFS= read -r cap; do
        [[ -n "$cap" ]] && case ",${_active_list}," in *,"$cap",*) ;; *) _active_list="${_active_list:+${_active_list},}${cap}" ;; esac
      done < <(_read_caps_from_file "$_proj_caps_file" "${box:-main}")
    fi

    for cap in "${KNOWN_CAPS[@]}"; do
      local marker="${DIM}·${RESET}"
      case ",${_active_list}," in *,"$cap",*) marker="${GREEN}✔${RESET}" ;; esac
      echo -e "    [${marker}] ${BOLD}${cap}${RESET}  ${DIM}$(_cap_description "$cap")${RESET}"
    done
    echo ""
    # Resources declared in THIS scope's file (empty reads as the effective default).
    # `|| true` keeps a strict-mode caller safe on a bare command-substitution assign.
    local _lm _lc _lmsrc="" _lcsrc="" _lcapsrc=""
    _lm="$(_read_resource_from_file "$config_file" memory "$_box_scope" || true)"
    _lc="$(_read_resource_from_file "$config_file" cpus "$_box_scope" || true)"
    # Which of these the BOX declares and which it inherits. A box view that
    # shows only values cannot be told apart from the project's own, and the
    # difference decides whether a later project edit reaches this box.
    if [[ -n "$_box_scope" ]]; then
      _cleat_section_present "$config_file" "box.${_box_scope}.caps" \
        && _lcapsrc=" ${DIM}(declared by ${_box_scope})${RESET}" \
        || _lcapsrc=" ${DIM}(inherited from the project)${RESET}"
      [[ -n "$(_read_section_from_file "$config_file" "box.${_box_scope}.resources" memory)" ]] \
        && _lmsrc=" ${DIM}(declared)${RESET}" || _lmsrc=" ${DIM}(inherited)${RESET}"
      [[ -n "$(_read_section_from_file "$config_file" "box.${_box_scope}.resources" cpus)" ]] \
        && _lcsrc=" ${DIM}(declared)${RESET}" || _lcsrc=" ${DIM}(inherited)${RESET}"
    fi
    echo -e "  ${BOLD}Resources${RESET}"
    if [[ -n "$_lm" ]]; then echo -e "    memory  ${_lm}${_lmsrc}"; else echo -e "    memory  ${DIM}default${RESET}"; fi
    if [[ -n "$_lc" ]]; then echo -e "    cpus    ${_lc}${_lcsrc}"; else echo -e "    cpus    ${DIM}all (no cap)${RESET}"; fi
    echo ""
    if [[ -n "$_box_scope" ]]; then
      echo -e "  ${DIM}Config: ${config_file}${RESET}  ${BOLD}box ${_box_scope}${RESET}${_lcapsrc}"
    else
      echo -e "  ${DIM}Config: ${config_file}${RESET}"
    fi
    echo ""
    return
  fi

  # ── Direct mode: --memory / --cpus
  if [[ "$action" == "resource" ]]; then
    if [[ "$res_val" == "__MISSING__" ]]; then
      error "Missing value. Usage: cleat config --${res_key} <value>"
      echo -e "    ${DIM}Clear it with: cleat config --${res_key} default${RESET}"
      exit 1
    fi
    # Sentinels and empty clear the key; anything else must validate.
    local write_val="$res_val"
    case "$res_val" in ""|default|all) write_val="" ;; esac
    if [[ -n "$write_val" ]]; then
      if [[ "$res_key" == "memory" ]] && ! _valid_memory_value "$write_val"; then
        error "Invalid memory value: ${BOLD}${write_val}${RESET} ${DIM}(use e.g. 2g, 4096m)${RESET}"; exit 1
      fi
      if [[ "$res_key" == "cpus" ]] && ! _valid_cpus_value "$write_val"; then
        error "Invalid cpus value: ${BOLD}${write_val}${RESET} ${DIM}(use e.g. 2, 1.5)${RESET}"; exit 1
      fi
    fi
    # Preserve the OTHER key: read both, replace the one being set, write both.
    # Read the box's OWN declared values, never the inherited ones: pulling the
    # project's memory into the box's section on a --cpus edit would silently
    # freeze that box against future project changes.
    local cur_mem cur_cpus
    cur_mem="$(_read_section_from_file "$config_file" "$_sec_res" memory || true)"
    cur_cpus="$(_read_section_from_file "$config_file" "$_sec_res" cpus || true)"
    if [[ "$res_key" == "memory" ]]; then cur_mem="$write_val"; else cur_cpus="$write_val"; fi
    _WRITE_RES_SECTION="$_sec_res" _write_resources_to_file "$config_file" "$cur_mem" "$cur_cpus"
    _config_note_sections_version "$config_file"
    if [[ -n "$write_val" ]]; then
      success "${res_key} set to ${write_val} ${DIM}(${config_file})${RESET}"
    else
      success "${res_key} cleared, using default ${DIM}(${config_file})${RESET}"
    fi
    # Direct mode skips the picker, so the same truths are printed here: a
    # project value above the clamp, a ceiling that reaches the whole VM, or a
    # core count this daemon would reject.
    if [[ -n "$write_val" && "$res_key" == "memory" ]]; then
      if [[ "$scope" == "project" ]] && (( $(_mem_to_bytes "$write_val") > 8589934592 )); then
        warn "A project .cleat caps memory at ${_PROJECT_MEM_CAP_GB} GB. The box will run at ${_PROJECT_MEM_CAP_GB}g."
        echo -e "    ${DIM}Set a larger ceiling in the global config instead: ${RESET}${BOLD}cleat config --memory ${write_val}${RESET}"
      else
        _config_mem_warn_block "$write_val" "$(_config_vm_gb)"
      fi
    fi
    if [[ -n "$write_val" && "$res_key" == "cpus" ]]; then
      local _ncpu; _ncpu="$(_daemon_ncpu)"
      if [[ "$_ncpu" =~ ^[0-9]+$ ]] && (( _ncpu > 0 )) && \
         awk -v v="$write_val" -v n="$_ncpu" 'BEGIN { exit !(v > n) }'; then
        warn "This Docker reports ${_ncpu} cores. Docker rejects a --cpus above that."
        echo -e "    ${DIM}The box will run at ${_ncpu} cores from a project .cleat, or fail to start from the global config.${RESET}"
      fi
    fi
    return
  fi

  # ── Direct mode: --enable / --disable
  if [[ -n "$action" ]]; then
    if [[ -z "$cap_name" ]]; then
      error "Missing capability name. Usage: cleat config --${action} <name>"
      exit 1
    fi

    # Validate capability name
    local valid=false
    for known in "${KNOWN_CAPS[@]}"; do
      [[ "$known" == "$cap_name" ]] && valid=true
    done
    if ! $valid; then
      error "Unknown capability: ${BOLD}${cap_name}${RESET}"
      echo -e "    ${DIM}Available: ${KNOWN_CAPS[*]}${RESET}"
      exit 1
    fi

    # resolve_caps strips unsafe-rm from every project .cleat (the caged agent can
    # write that file), so writing it there reported success for a cap that never
    # applies. Refuse before anything is written. --box also sets scope=project.
    if [[ "$action" == "enable" && "$cap_name" == "unsafe-rm" && "$scope" == "project" ]]; then
      error "unsafe-rm is accepted only from your global config or --cap."
      echo -e "    ${DIM}Enable it globally instead: ${RESET}${BOLD}cleat config --enable unsafe-rm${RESET}"
      exit 1
    fi

    # Read current caps
    local current_caps=()
    while IFS= read -r cap; do
      [[ -n "$cap" ]] && current_caps+=("$cap")
    done < <(_read_caps_from_file "$config_file" "$_box_scope")

    if [[ "$action" == "enable" ]]; then
      # Check if already enabled
      local already=false
      for cap in "${current_caps[@]+"${current_caps[@]}"}"; do
        [[ "$cap" == "$cap_name" ]] && already=true
      done
      if ! $already; then
        current_caps+=("$cap_name")
      fi
      _config_write_caps_scoped "$config_file" "$_sec_caps" "$_box_scope" "${current_caps[@]}"
      success "${cap_name} enabled"
      echo -e "    ${DIM}$(_cap_description "$cap_name")${RESET}"

      # Scaffold .cleat.env when enabling env capability
      if [[ "$cap_name" == "env" ]]; then
        _scaffold_cleat_env "$project"
      fi
    else
      # Disable: remove from list
      local new_caps=()
      for cap in "${current_caps[@]+"${current_caps[@]}"}"; do
        [[ "$cap" != "$cap_name" ]] && new_caps+=("$cap")
      done
      _config_write_caps_scoped "$config_file" "$_sec_caps" "$_box_scope" "${new_caps[@]+"${new_caps[@]}"}"
      success "${cap_name} disabled"
    fi
    return
  fi

  # ── Interactive mode (no flags)
  if [[ -t 0 ]] && [[ -t 1 ]]; then
    _config_picker_tui "$config_file" "$scope" "$project"
  else
    _config_picker_text "$config_file" "$scope" "$project"
  fi
}

# ── Workspace trust subcommands ────────────────────────────────────────────
#
# `cleat trust [path] [box]`   : record approval for a project's .cleat (or a
#                                box's .cleat.<box>) caps and [setup]
# `cleat trust --list`         : list all trusted projects and boxes
# `cleat untrust [path] [box]` : remove approval for a project (or a box)
#
# Normally users will be prompted automatically on first run. These
# subcommands exist for scripting, manual approval, and inspection.

# Resolve the (project, box) a trust/untrust verb targets from its
# positionals. Prints "<project><TAB><box>" on stdout for the caller to split;
# ALL diagnostics go to stderr (this runs inside $(...)) and a bad target
# returns 1 so the caller can `|| exit 1`.
#
# Grammar, backward compatible with the historical lone-[path] form:
#   (none)          current dir, main box
#   <box>           current dir, that box   (a lone valid box name, no '/')
#   <path>          that path, main box     (a token containing '/')
#   <path> <box>    that path, that box     (path first, then box)
#
# Whether the one-arg token is a box or a path is decided PURELY by syntax: a
# token containing '/' is a path, otherwise a valid box name is that box. This
# is deliberately NOT a filesystem check (`-d`): a `-d` test would be
# time-dependent, so `cleat trust web` could record box "web" today and
# `cleat untrust web` could silently resolve to the ./web directory tomorrow
# (once a build created it) and fail to revoke the box, leaving a stale
# approval live. Syntax-only keeps trust and untrust symmetric. To trust the
# project in a bare-named subdirectory, give it a path shape: `cleat trust
# ./web` or `cleat trust . web` for that subdir's box.
_trust_target() {
  local proj box="main" a1="${1:-}" n=$#
  if [[ $n -gt 2 ]]; then
    error "Unexpected argument: ${BOLD}${3:-}${RESET}" >&2
    echo -e "    ${DIM}Usage: cleat trust [path] [box]${RESET}" >&2
    return 1
  fi
  if [[ $n -eq 2 ]]; then
    proj="$(resolve_project "$a1")"
    box="$2"
  elif [[ $n -eq 1 ]]; then
    if [[ "$a1" == */* ]]; then
      proj="$(resolve_project "$a1")"
    elif _validate_box_name "$a1"; then
      proj="$(resolve_project "")"
      box="$a1"
    else
      # Neither a path shape nor a valid box name: treat as a path so the
      # caller's "no .cleat file" error still names what the user typed.
      proj="$(resolve_project "$a1")"
    fi
  else
    proj="$(resolve_project "")"
  fi
  if [[ "$box" != "main" ]] && ! _validate_box_name "$box"; then
    error "Invalid box name: ${BOLD}${box}${RESET}" >&2
    echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}" >&2
    return 1
  fi
  # Mirror _trust_record's control-char refusal here, before the tab-delimited
  # print: a project path with an embedded tab/newline/CR would otherwise split
  # wrong in the caller and slip past that guard (it only sees the truncated
  # project column).
  case "$proj" in
    *$'\t'*|*$'\n'*|*$'\r'*)
      error "Refusing to trust a project path containing control characters" >&2
      return 1 ;;
  esac
  printf '%s\t%s\n' "$proj" "$box"
}

cmd_trust() {
  # Flag parsing
  local list_mode=0
  local -a pos_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list) list_mode=1; shift ;;
      --help|-h)
        echo "Usage: cleat trust [path] [box]   Record trust for a project's .cleat"
        echo "       cleat trust [box]           Trust a box of the current project"
        echo "       cleat trust --list          List all trusted projects and boxes"
        return 0 ;;
      *) pos_args+=("$1"); shift ;;
    esac
  done

  if [[ $list_mode -eq 1 ]]; then
    if [[ ! -f "$CLEAT_TRUST_FILE" ]]; then
      info "No trusted projects."
      return 0
    fi
    local count
    count="$(_trust_list | wc -l | tr -d ' ')"
    if [[ "$count" -eq 0 ]]; then
      info "No trusted projects."
      return 0
    fi
    echo -e "  ${BOLD}Trusted projects${RESET} ${DIM}(${count})${RESET}"
    echo ""
    _trust_list | while IFS=$'\t' read -r p b; do
      [[ -z "$p" ]] && continue
      [[ -z "$b" ]] && b="main"
      local marker="${GREEN}●${RESET}"
      # Indicate if the box's cap file has changed since approval
      local _cf _stored _cur
      _cf="$(_project_caps_file "$p")"
      _stored="$(_trust_lookup "$p" "$b")"
      _cur="$(_hash_cleat_caps "$_cf" "$b")"
      if [[ -f "$_cf" && -n "$_cur" && "$_stored" != "$_cur" ]]; then
        marker="${YELLOW}●${RESET}"
      fi
      if [[ "$b" == "main" ]]; then
        echo -e "    ${marker} ${p}"
      else
        echo -e "    ${marker} ${p}  ${DIM}[${b}]${RESET}"
      fi
    done
    echo ""
    echo -e "  ${DIM}${GREEN}●${DIM} trusted at current caps   ${YELLOW}●${DIM} .cleat changed since approval${RESET}"
    return 0
  fi

  # Record trust for a specific (project, box). Default: current dir, main box.
  local _t project box
  _t="$(_trust_target "${pos_args[@]+"${pos_args[@]}"}")" || exit 1
  project="${_t%%$'\t'*}"
  box="${_t#*$'\t'}"
  _BOX="$box"
  # A named box uses .cleat.<box> when present, else falls back to .cleat: the
  # same file resolve_caps would prompt for at `cleat run <box>`, so trusting
  # here records the byte-identical trust row (see _project_caps_file).
  local caps_file caps_base
  caps_file="$(_project_caps_file "$project")"
  caps_base="$(basename "$caps_file")"
  if [[ ! -f "$caps_file" ]]; then
    error "No ${caps_base} file found in ${BOLD}${project}${RESET}"
    echo -e "    ${DIM}Nothing to trust. This box has no capability config.${RESET}"
    exit 1
  fi
  local hash
  hash="$(_hash_cleat_caps "$caps_file" "$box")"
  # An explicit `cleat trust` approves the whole file the user is looking
  # at: caps and [setup] both, separate consent classes (concept/16). A
  # caps-less file with a [setup] section is still approvable: setup trust
  # records as a 4th trust-file column, "-" standing in for the caps hash.
  local setup_payload setup_rc=0
  setup_payload="$(_build_setup_payload "$project" "$box")" || setup_rc=$?
  if [[ $setup_rc -ne 0 ]]; then
    # _build_setup_payload already warned about the specific bad directive.
    warn "Project [setup] is invalid, not approved ${DIM}(see the warning above)${RESET}"
    setup_payload=""
  fi
  if [[ -z "$hash" && -z "$setup_payload" ]]; then
    error "Project ${caps_base} has no capabilities or setup commands to trust"
    exit 1
  fi
  local setup_hash="" setup_count=""
  if [[ -n "$setup_payload" ]]; then
    setup_hash="$(_setup_payload_hash "$setup_payload")"
    setup_count="$(_read_setup_from_file "$caps_file" "$box" | wc -l | tr -d ' ')"
    _trust_record "$project" "$hash" "$box" "$setup_hash" || exit 1
  elif ! _trust_record "$project" "$hash" "$box"; then
    exit 1
  fi
  if [[ "$box" == "main" ]]; then
    success "Trusted ${BOLD}${project}${RESET}"
  else
    success "Trusted ${BOLD}${project}${RESET} ${DIM}[${box}]${RESET}"
  fi
  if [[ -n "$hash" ]]; then
    local caps
    caps="$(_read_caps_from_file "$caps_file" "$box" | _canonical_caps)"
    echo -e "    ${DIM}Approved caps: $(_sanitize_repo_str "$caps")${RESET}"
  fi
  if [[ -n "$setup_payload" ]]; then
    echo -e "    ${DIM}Approved setup: ${setup_count} command(s)${RESET}"
  fi
}

cmd_untrust() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat untrust [path] [box]   Remove trust for a project"
      echo "       cleat untrust [box]           Untrust a box of the current project"
      return 0 ;;
  esac
  local -a pos_args=()
  while [[ $# -gt 0 ]]; do pos_args+=("$1"); shift; done
  local _t project box
  _t="$(_trust_target "${pos_args[@]+"${pos_args[@]}"}")" || exit 1
  project="${_t%%$'\t'*}"
  box="${_t#*$'\t'}"
  _BOX="$box"
  # A trust row (any column) counts as trusted: a setup-only row has "-" in the
  # caps column, which _trust_lookup returns non-empty, so it's detected here.
  local had
  had="$(_trust_lookup "$project" "$box")"
  _trust_remove "$project" "$box"
  local suffix=""
  [[ "$box" != "main" ]] && suffix=" ${DIM}[${box}]${RESET}"
  if [[ -n "$had" ]]; then
    success "Removed trust for ${BOLD}${project}${RESET}${suffix}"
  else
    info "${project}${suffix} was not trusted"
  fi
}

# ── Box descriptions ────────────────────────────────────────────────────────
#
# `cleat describe`             : show the main box's description
# `cleat describe <box>`       : show that box's description
# `cleat describe <box> text`  : set/update it (no docker calls; never recreates)
#
# The description is host-side metadata (see concept/20-boxes.md), so updating
# it never restarts or recreates the container: the writable layer (e.g. an
# `az login`) is untouched.
cmd_describe() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat describe [box] [text]"
      echo "       cleat describe <box>          Show a box's description"
      echo "       cleat describe <box> \"text\"   Set/update it (no container restart)"
      return 0 ;;
  esac

  local box="main"
  if [[ $# -gt 0 ]]; then
    if ! _validate_box_name "$1"; then
      error "Invalid box name: ${BOLD}$1${RESET}"
      echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
      exit 1
    fi
    box="$1"; shift
  fi

  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"

  if [[ $# -gt 0 ]]; then
    # Set/update: remaining args are the description, joined and stored as data.
    _box_desc_write "$cname" "$*"
    success "Description set for box ${BOLD}${box}${RESET}"
    # Print the description as DATA (%s), never through echo -e, which would
    # interpret backslash escapes / ANSI in user text. Colors use %b.
    printf '    %b%s%b\n' "$DIM" "$*" "$RESET"
  else
    local cur
    cur="$(_box_desc_read "$cname")"
    if [[ -n "$cur" ]]; then
      printf '  %b%s%b  %s\n' "$BOLD" "$box" "$RESET" "$cur"
    else
      info "No description set for box ${BOLD}${box}${RESET}."
      echo -e "    ${DIM}Set one with: cleat describe ${box} \"...\"${RESET}"
    fi
  fi
}

# ── `cleat fork`: manage the workspace copies ───────────────────────────────
#
# The copies were write-only state before this: created by `--fork`, deliberately
# KEPT by `cleat rm` because a copy may hold the only version of hours of agent
# work, and after that reachable only by knowing that they live under
# $CLEAT_FORKS_DIR named after the container. There was no way to see how much
# disk they held, and no way to get a FRESH copy at all: `cleat rm` keeps the
# copy, so re-running the box reuses it and a changed `[fork] exclude` could
# never take effect. A real host run hit exactly that (2026-07-29).
#
# `fork` is a VERB here while `--fork` stays a FLAG on start/run. They do not
# collide because the flag is parsed globally and this verb owns its own
# positionals. The subcommand names are RESERVED: `cleat fork feat-a` is an
# error, not a guess, because guessing between "show me box feat-a's copy" and
# "run subcommand feat-a" is how a delete lands on the wrong thing.

# Apparent size of a directory in KB. `du -sk` is the one form BSD and GNU
# agree on (-h differs, --block-size is GNU-only, and BSD needs -k to escape
# 512-byte blocks). NOT clone-aware: on APFS a copy-on-write fork shares blocks
# with the project, so this over-reports what deleting it would actually free.
# Callers must label it as apparent size, never as reclaimable disk.
_fork_size_kb() {
  local d="$1" out
  [[ -d "$d" ]] || { printf '%s' 0; return 0; }
  # `|| true` INSIDE the pipeline, never after it. du exits non-zero when it
  # cannot descend into a subdirectory but STILL prints a valid grand total,
  # and under the CLI's `set -o pipefail` that non-zero failed the whole
  # substitution, so one unreadable directory made a real multi-gigabyte copy
  # report "0 KB apparent" in fork list, fork rm and fork prune.
  out="$( { du -sk "$d" 2>/dev/null || true; } | tail -1 )" || out=""
  # macOS wc/du pad their output, so take the first field rather than a cut.
  set -- $out
  case "${1:-}" in
    ''|*[!0-9]*) printf '%s' 0 ;;
    *)           printf '%s' "$1" ;;
  esac
}

_fork_fmt_kb() {
  local kb="$1"
  if   [[ "$kb" -ge 1048576 ]]; then printf '%s GB' "$(( (kb + 524288) / 1048576 ))"
  elif [[ "$kb" -ge 1024 ]];    then printf '%s MB' "$(( (kb + 512) / 1024 ))"
  else                               printf '%s KB' "$kb"
  fi
}

# Every copy under the fork root, one absolute path per line, sorted. Guarded
# for a missing root and for a non-glob match (nullglob is not set anywhere in
# this script, so an unmatched glob arrives as a literal).
_fork_all_dirs() {
  local root d
  root="$(_fork_root)"
  [[ -d "$root" ]] || return 0
  for d in "$root"/*; do
    [[ -d "$d" ]] || continue
    # Only directories named like a cleat container. Every copy is named by
    # container_name_for, which always emits "cleat-...", so this loses
    # nothing real. Without it prune treated ANY directory one level under the
    # fork root as an orphan copy and deleted it, which is harmless under the
    # default root and severe under a hand-set `[fork] dir` pointing at a
    # directory that holds anything else. The root is user-settable, so this
    # list must not assume it owns everything under it.
    case "${d##*/}" in
      cleat-?*) : ;;
      *) continue ;;
    esac
    printf '%s\n' "$d"
  done
}

_fork_print_list() {
  local root dirs total_kb=0 n=0 d cname kb age state
  # Read-only, so a down daemon still prints the list. What it must NOT do is
  # label every row "no box" and then point at prune, which is the delete: the
  # box probe is a false negative against a stopped daemon (see prune).
  local _daemon=1
  _daemon_up || _daemon=0
  root="$(_fork_root)"
  dirs="$(_fork_all_dirs)"
  if [[ -z "$dirs" ]]; then
    info "No fork workspaces."
    echo -e "    ${DIM}Create one with ${BOLD}cleat start <box> --fork${RESET}${DIM}.${RESET}"
    return 0
  fi
  echo -e "  ${BOLD}Fork workspaces${RESET} ${DIM}in ${root/#${HOME}/~}${RESET}"
  echo
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    cname="${d##*/}"
    kb="$(_fork_size_kb "$d")"
    total_kb=$(( total_kb + kb ))
    n=$(( n + 1 ))
    age="$(_fork_age_human "$d")"
    if [[ "$_daemon" -eq 0 ]]; then
      state="${DIM}box unknown${RESET}"
    elif container_exists "$cname"; then
      state="${DIM}box exists${RESET}"
    else
      state="${AMBER}no box${RESET}"
    fi
    printf '    %-46s %8s  %-10s %b\n' \
      "$cname" "$(_fork_fmt_kb "$kb")" "${age:-just now}" "$state"
  done <<< "$dirs"
  echo
  echo -e "    ${DIM}$n $( [[ $n -eq 1 ]] && echo copy || echo copies ), $(_fork_fmt_kb "$total_kb") apparent.${RESET}"
  echo -e "    ${DIM}Apparent, not reclaimable: a copy-on-write copy shares blocks with the project until something changes.${RESET}"
  if [[ "$_daemon" -eq 0 ]]; then
    echo -e "    ${AMBER}Docker is not running${RESET}${DIM}, so whether a copy still has a box is unknown. Start it for the real state.${RESET}"
  else
    echo -e "    ${DIM}Rows marked ${RESET}${AMBER}no box${RESET}${DIM} have no container left. ${BOLD}cleat fork prune${RESET}${DIM} clears those.${RESET}"
  fi
}

cmd_fork() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat fork start [box]          Create a fork box and launch Claude in it"
      echo "       cleat fork run [box]            Create it without launching Claude"
      echo "       cleat fork                      List every workspace copy, with size and age"
      echo "       cleat fork list                 Same, for scripts"
      echo "       cleat fork path [box]           Print this box's copy path"
      echo "       cleat fork rm [box]             Delete this box's copy and its fork marker"
      echo "       cleat fork prune                Delete copies whose container is gone"
      echo "       cleat fork refresh [box]        Re-copy from the live project"
      echo ""
      echo "cleat fork start <box> is the same as cleat start <box> --fork."
      return 0 ;;
  esac

  local sub="${1:-}"
  if [[ -z "$sub" || "$sub" == "list" ]]; then
    _fork_print_list
    return 0
  fi
  shift

  case "$sub" in
    start|run)
      # `cleat fork start <box>` == `cleat start <box> --fork`, discoverable from
      # the noun people actually reach for. BOTH verbs exist on purpose: `run` is
      # create-only, so shipping only `fork run` would hand someone a box and
      # drop them back at their shell when they meant to work in it. That exact
      # confusion showed up in a host test run.
      #
      # Routed through _set_box rather than parsing the box here, so the name
      # validation and the stray-argument refusal are the same code every other
      # box-aware verb uses. Global flags (--cap, --env, --memory) were already
      # parsed before dispatch, so they compose with this unchanged.
      _set_box "$@"
      _FORK_REQUESTED=true
      if [[ "$sub" == "start" ]]; then
        cmd_start
      else
        cmd_run
      fi
      return $? ;;

    path|rm|refresh)
      local project box cname _fp
      # Routed through _set_box, exactly like start|run above and like every
      # other box-aware verb. This branch used to read the positional directly,
      # which made cmd_fork the ONLY box-aware verb in the CLI that never
      # validated the name, and the only one that then rm -rf's a path built
      # from it: container_name_for appends the name verbatim and _fork_dir
      # appends that to the fork root, so `cleat fork rm 'x/../../../Documents'`
      # walked the delete out of the fork root and took a real host directory
      # with it. _set_box also restores the stray-argument refusal, which two
      # destructive verbs were silently swallowing.
      _set_box "$@"
      box="$_BOX"
      project="$(resolve_project "")"
      cname="$(container_name_for "$project" "$box")"
      _fp="$(_fork_dir "$cname")"

      if [[ "$sub" == "path" ]]; then
        # Bare path on stdout, nothing else: this exists so that
        # `cd "$(cleat fork path feat-a)"` works. Missing copy is a non-zero
        # exit with the message on stderr, so a subshell gets an empty string
        # rather than a diagnostic it would then cd into.
        if [[ ! -d "$_fp" ]]; then
          error "No fork workspace for box ${BOLD}${box}${RESET}." >&2
          return 1
        fi
        printf '%s\n' "$_fp"
        return 0
      fi

      if [[ ! -d "$_fp" ]]; then
        # `rm` is also how you DROP a fork whose copy is already gone, and it
        # had to become that because both documented exits were closed. The
        # marker outlives the copy on purpose, but a marker with no copy makes
        # every later `cleat start <box>` refuse; that refusal said "drop the
        # fork with cleat rm <box>", which deliberately KEEPS the marker, and
        # coming here instead hit this bare refusal because the directory was
        # missing. The box was unstartable with no working way out in any
        # message. Clearing the marker is exactly what the user asked for.
        if [[ "$sub" == "rm" ]] && _box_is_fork "$cname"; then
          _fork_unmark "$cname"
          success "Fork marker cleared for box ${BOLD}${box}${RESET}."
          echo -e "    ${DIM}Its workspace copy was already gone. ${BOLD}cleat start ${box}${RESET}${DIM} now works on the project itself again.${RESET}"
          return 0
        fi
        error "No fork workspace for box ${BOLD}${box}${RESET}."
        echo -e "    ${DIM}Expected: ${_fp/#${HOME}/~}${RESET}"
        return 1
      fi
      # Both remaining verbs replace or delete the copy, and the container has
      # it bind-mounted at /workspace. Pulling it out from under a live box
      # gives the agent a half tree with no warning, so refuse instead.
      if container_exists "$cname"; then
        error "Box ${BOLD}${box}${RESET} still exists."
        echo -e "    ${DIM}Its container has this copy mounted. Remove the box first: ${BOLD}cleat rm ${box}${RESET}${DIM}.${RESET}"
        return 1
      fi

      local _kb _ans
      _kb="$(_fork_size_kb "$_fp")"
      if [[ "$sub" == "rm" ]]; then
        warn "This deletes ${BOLD}${_fp/#${HOME}/~}${RESET} ${DIM}($(_fork_fmt_kb "$_kb") apparent)${RESET}"
        echo -e "    ${DIM}Anything the agent did in that copy and did not commit or push is gone.${RESET}"
        _ask_yn _ans "Delete it? [y/N] "
        case "$_ans" in
          y|Y|yes|YES) ;;
          *) info "Kept."; return 0 ;;
        esac
        _fork_rm_tree "$_fp" || return 1
        _fork_unmark "$cname"
        success "Fork workspace deleted."
        echo -e "    ${DIM}Box ${BOLD}${box}${RESET}${DIM} is no longer a fork. ${BOLD}cleat start ${box} --fork${RESET}${DIM} makes a new copy.${RESET}"
        return 0
      fi

      # refresh
      warn "This replaces ${BOLD}${_fp/#${HOME}/~}${RESET} with a fresh copy of ${BOLD}${project/#${HOME}/~}${RESET}"
      echo -e "    ${DIM}Anything the agent did in the current copy and did not commit or push is gone.${RESET}"
      _ask_yn _ans "Replace it? [y/N] "
      case "$_ans" in
        y|Y|yes|YES) ;;
        *) info "Kept."; return 0 ;;
      esac
      local _rc=0
      spin "Copying workspace..."
      _fork_copy_tree "$project" "$_fp" || _rc=$?
      spin_stop "$_rc" "Workspace copied" "Workspace copy failed"
      [[ "$_rc" -eq 0 ]] || return 1
      _fork_prune_excludes "$_fp" "$project" "$box"
      _fork_mark "$cname"
      echo -e "    ${DIM}Next ${BOLD}cleat start ${box} --fork${RESET}${DIM} uses it.${RESET}"
      return 0 ;;

    prune)
      # container_exists is `docker ps -a | grep -q`, which is FALSE when the
      # daemon is merely stopped, not only when the box is gone. cmd_status
      # already guards on exactly this ("the old line lied after every
      # reboot"); this verb, written later, did not, so on a laptop that had
      # not started Docker yet every live box read as an orphan and prune
      # deleted EVERY workspace copy on the machine, uncommitted agent work
      # included, and with --yes it did so without asking. A delete must never
      # run on a probe that cannot answer. Found 2026-07-31.
      if ! _daemon_up; then
        error "Docker is not running."
        echo -e "    ${DIM}Every box would look gone, so this would delete every copy. Start Docker, then run ${BOLD}cleat fork prune${RESET}${DIM} again.${RESET}"
        return 1
      fi
      local assume_yes=0 a
      for a in "$@"; do case "$a" in --yes|-y) assume_yes=1 ;; esac; done

      # Interrupted copies. _fork_copy_tree_locked stages into
      # $root/.tmp.<pid> and renames, so a copy killed part way (Ctrl-C, OOM,
      # a reboot) strands a partial tree that _fork_all_dirs cannot see: its
      # glob skips dotfiles. It was invisible to `cleat fork`, uncounted by
      # prune and never reclaimed, so a large project could leak its whole
      # size on every interruption with nothing on screen to explain the disk.
      # Only sweep one whose owning PID is gone, so a CONCURRENT copy is never
      # pulled out from under itself; PID reuse can only make us skip a
      # removal, never take a live one. No confirmation: a staging tree is
      # incomplete by construction and was never a workspace.
      local _root_dir _tmp _pid _partial=0 _partial_kb=0
      _root_dir="$(_fork_root)"
      for _tmp in "$_root_dir"/.tmp.*; do
        [[ -d "$_tmp" ]] || continue
        _pid="${_tmp##*/.tmp.}"
        case "$_pid" in ''|*[!0-9]*) continue ;; esac
        kill -0 "$_pid" 2>/dev/null && continue
        _partial_kb=$(( _partial_kb + $(_fork_size_kb "$_tmp") ))
        _fork_rm_tree "$_tmp" && _partial=$(( _partial + 1 ))
      done
      if [[ "$_partial" -gt 0 ]]; then
        success "Removed $_partial interrupted $( [[ $_partial -eq 1 ]] && echo copy || echo copies ), $(_fork_fmt_kb "$_partial_kb")."
        echo -e "    ${DIM}Staging trees left by a fork copy that was interrupted. Nothing listed them until now.${RESET}"
      fi

      local dirs d cname orphans="" count=0 kb total=0
      dirs="$(_fork_all_dirs)"
      while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        cname="${d##*/}"
        container_exists "$cname" && continue
        kb="$(_fork_size_kb "$d")"
        total=$(( total + kb ))
        count=$(( count + 1 ))
        orphans="${orphans}${d}"$'\n'
      done <<< "$dirs"
      # Stale markers: a fork marker whose copy AND container are both already
      # gone. A marker outlives its box on purpose (cleat rm keeps it so
      # re-running reuses the copy), but nothing ever cleaned one whose copy was
      # deleted by hand, and a stale one is NOT inert: it makes the next box of
      # that name a fork with a missing copy, so `cleat start` refuses. Reported
      # from a host run 2026-07-31, where markers from earlier runs survived an
      # `rm -rf` of the forks directory. Counted BEFORE the early return below,
      # because "no orphan copies" is exactly the state stale markers live in.
      local _mk _mc stale=0 stale_list=""
      if [[ -d "$CLEAT_BOXES_DIR" ]]; then
        for _mk in "$CLEAT_BOXES_DIR"/*.fork; do
          [[ -f "$_mk" ]] || continue
          _mc="${_mk##*/}"; _mc="${_mc%.fork}"
          [[ -d "$(_fork_dir "$_mc")" ]] && continue
          container_exists "$_mc" && continue
          stale=$(( stale + 1 ))
          stale_list="${stale_list}${_mk}"$'\n'
        done
      fi
      if [[ "$count" -eq 0 && "$stale" -eq 0 ]]; then
        [[ "$_partial" -gt 0 ]] && return 0
        info "Nothing to prune. Every fork workspace still has a box."
        return 0
      fi
      if [[ "$count" -eq 0 ]]; then
        # Markers only. Nothing is at risk here, so no confirmation: there is no
        # copy and no container, just a leftover flag that would misroute the
        # next box of that name.
        while IFS= read -r _mk; do
          [[ -n "$_mk" ]] || continue
          rm -f "$_mk"
        done <<< "$stale_list"
        success "Cleared $stale stale fork $( [[ $stale -eq 1 ]] && echo marker || echo markers )."
        echo -e "    ${DIM}No copies to remove. A marker with no copy and no box would have made the next box of that name refuse to start.${RESET}"
        return 0
      fi
      warn "$count fork $( [[ $count -eq 1 ]] && echo workspace || echo workspaces ) with no container, $(_fork_fmt_kb "$total") apparent:"
      while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        echo -e "    ${DIM}${d/#${HOME}/~}${RESET}"
      done <<< "$orphans"
      echo -e "    ${DIM}A copy outlives its box on purpose: it may hold the only version of the work.${RESET}"
      if [[ "$assume_yes" -ne 1 ]]; then
        local _ans2
        _ask_yn _ans2 "Delete all of them? [y/N] "
        case "$_ans2" in
          y|Y|yes|YES) ;;
          *) info "Kept."; return 0 ;;
        esac
      fi
      local removed=0
      while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        if _fork_rm_tree "$d"; then
          _fork_unmark "${d##*/}"
          removed=$(( removed + 1 ))
        fi
      done <<< "$orphans"
      while IFS= read -r _mk; do
        [[ -n "$_mk" ]] || continue
        rm -f "$_mk"
      done <<< "$stale_list"
      success "Removed $removed fork $( [[ $removed -eq 1 ]] && echo workspace || echo workspaces )."
      [[ "$stale" -gt 0 ]] && echo -e "    ${DIM}Also cleared $stale stale fork $( [[ $stale -eq 1 ]] && echo marker || echo markers ) with no copy and no box.${RESET}"
      return 0 ;;

    *)
      error "Unknown subcommand ${BOLD}${sub}${RESET} for ${BOLD}cleat fork${RESET}."
      echo -e "    ${DIM}Try ${BOLD}cleat fork --help${RESET}${DIM}. To fork a box named ${BOLD}${sub}${RESET}${DIM}: ${BOLD}cleat fork start ${sub}${RESET}${DIM}.${RESET}"
      exit 1 ;;
  esac
}

# `cleat kit`: enable/disable/inspect curated Claude pre-configurations per
# box. Two positionals (`kit <name> [box]`), so like `describe` it parses
# inside cmd_kit and never routes through _set_box (which rejects a second
# positional). Reserved words (off/list/show) resolve before the kit registry.
# See concept/34-kits.md.
cmd_kit() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: cleat kit                       Interactive picker: kit, then models"
      echo "       cleat kit list                  Plain library + this project's selections"
      echo "       cleat kit <name> [box]          Enable a kit for a box (default: main)"
      echo "       cleat kit off [box]             Disable (back to your own config)"
      echo "       cleat kit show <name>           Print everything a kit injects"
      return 0 ;;
  esac

  local sub="${1:-}"
  # Bare `cleat kit` is interactive, exactly like bare `cleat config`: the
  # arrow-key TUI on a terminal, the typed text mode otherwise. The plain
  # listing stays available as `cleat kit list` (and for scripts).
  if [[ -z "$sub" ]]; then
    if [[ -t 0 ]] && [[ -t 1 ]]; then
      _kit_picker_tui
    else
      _kit_picker_text
    fi
    return 0
  fi
  if [[ "$sub" == "list" ]]; then
    _kit_print_library
    return 0
  fi
  shift

  case "$sub" in
    show)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        error "Usage: ${BOLD}cleat kit show <name>${RESET}"
        echo -e "    ${DIM}Available kits: ${KNOWN_KITS[*]}${RESET}"
        exit 1
      fi
      if ! _kit_known "$name"; then
        error "Unknown kit: ${BOLD}${name}${RESET}"
        echo -e "    ${DIM}Available kits: ${KNOWN_KITS[*]}${RESET}"
        exit 1
      fi
      _kit_show "$name"
      ;;
    off)
      _kit_disable "${1:-main}"
      ;;
    *)
      if ! _kit_known "$sub"; then
        error "Unknown kit: ${BOLD}${sub}${RESET}"
        echo -e "    ${DIM}Available kits: ${KNOWN_KITS[*]}${RESET}"
        echo -e "    ${DIM}Run ${BOLD}cleat kit${RESET}${DIM} for descriptions.${RESET}"
        exit 1
      fi
      _kit_enable "$sub" "${1:-main}"
      ;;
  esac
}

_kit_require_box() {
  if ! _validate_box_name "$1"; then
    error "Invalid box name: ${BOLD}$1${RESET}"
    echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
    exit 1
  fi
}

# Boxes created before the kit feature lack the mask mounts (bind mounts are
# baked at create): offer the rebuild instead of silently "enabling" a kit the
# box would ignore. Declining changes nothing. Shared by the direct grammar
# and the interactive picker. Returns 0 = continue to the normal apply,
# 1 = handled here (rebuild accepted or declined), caller stops either way.
_kit_prekit_offer() {
  local kit="$1" box="$2" cname="$3"
  if container_exists "$cname" && ! _container_has_kit_mounts "$cname"; then
    echo ""
    info "This box was created before kits existed and needs a rebuild to gain"
    echo -e "    the kit mount points. ${DIM}Your project, auth, and sessions are safe;${RESET}"
    echo -e "    ${DIM}ad-hoc installs inside the box are not.${RESET}"
    echo ""
    local yn=""
    _ask_yn yn "Rebuild now? [y/N] "
    if [[ "$yn" == [yY]* ]]; then
      docker rm -f "$cname" > /dev/null 2>&1 || true
      _account_wipe_run_dir "${cname}"
      _box_kit_write "$cname" "$kit"
      success "Kit ${BOLD}${kit}${RESET} enabled for box ${BOLD}${box}${RESET}."
      echo -e "    ${DIM}Next ${BOLD}cleat${RESET}${DIM} rebuilds the box with the kit active.${RESET}"
    else
      info "Kept as is. Nothing changed."
    fi
    return 1
  fi
  return 0
}

# Post-consent apply, shared by the direct grammar (after its [Y/n]) and the
# interactive picker (where selecting IS the consent): collision heads-up,
# selection write, in-place overlay refresh, success + next-session note.
_kit_apply() {
  local kit="$1" box="$2" cname="$3"

  # Collision heads-up, checked by agent NAME (what Claude dispatches by), not
  # filename: the overlay generation prefers a same-named user agent
  # (concept/34), so tell the user which agent Claude will actually use.
  # mktemp -d, not a predictable $$ path, so nothing can pre-plant the staging
  # tree on a shared host.
  local _ck_tmp _ck_f _kn
  _ck_tmp="$(mktemp -d "${TMPDIR:-/tmp}/cleat-kit-check.XXXXXX")" || _ck_tmp=""
  if [[ -n "$_ck_tmp" ]]; then
    # Names the user's agents already claim.
    local _un=" " _uf _unn
    if [[ -d "${HOME}/.claude/agents" ]]; then
      for _uf in "${HOME}/.claude/agents"/*; do
        [[ -f "$_uf" ]] || continue
        _unn="$(_agent_name "$_uf")"
        [[ -n "$_unn" ]] && _un="${_un}${_unn} "
      done
    fi
    _kit_emit "$kit" "$_ck_tmp"
    for _ck_f in "$_ck_tmp/agents"/*; do
      [[ -f "$_ck_f" ]] || continue
      _kn="$(_agent_name "$_ck_f")"
      if [[ -n "$_kn" && "$_un" == *" $_kn "* ]]; then
        warn "You already have an agent named ${BOLD}${_kn}${RESET}. Yours wins."
        echo -e "    ${DIM}The kit's ${_kn} is skipped, so dispatch to that name uses your agent.${RESET}"
        echo -e "    ${DIM}The kit's policy now steers your agent: its model and tools apply, not the kit's.${RESET}"
      fi
    done
    rm -rf "$_ck_tmp"
  fi

  _box_kit_write "$cname" "$kit"

  # Refresh the overlay now when the box already has the mounts (in-place, so
  # it lands even for a running box; a currently-attached session already read
  # its config, hence "next session").
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
  fi

  success "Kit ${BOLD}${kit}${RESET} enabled for box ${BOLD}${box}${RESET}."
  if container_exists "$cname" && is_running "$cname" && _box_has_live_agent "$cname"; then
    echo -e "    ${DIM}A session is live in this box. The kit applies from the next session.${RESET}"
  else
    echo -e "    ${DIM}Takes effect next session: ${BOLD}cleat${RESET}"
  fi
  _kit_post_enable_hint "$kit"
}

_kit_enable() {
  local kit="$1" box="$2"
  _kit_require_box "$box"
  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"

  _kit_prekit_offer "$kit" "$box" "$cname" || return 0

  echo ""
  echo -e "  ${BOLD}Enable kit ${kit} for box ${box}?${RESET}"
  echo ""
  _kit_description "$kit" | fold -s -w 66 | sed 's/^/  /'
  echo ""
  _kit_reference_line "$kit"
  echo ""
  echo -e "  This kit adds, ${BOLD}inside the box only${RESET}:"
  _kit_confirm_lines "$kit"
  echo ""
  echo -e "  ${DIM}Your host ~/.claude and this repo are not touched.${RESET}"
  echo ""
  local yn=""
  _ask_yn yn "Enable? [Y/n] "
  if [[ -n "$yn" && "$yn" != [yY]* ]]; then
    info "Cancelled."
    return 0
  fi

  _kit_apply "$kit" "$box" "$cname"
}

_kit_disable() {
  local box="$1"
  _kit_require_box "$box"
  local project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"

  local cur
  cur="$(_box_kit_read "$cname")"
  if [[ -z "$cur" ]]; then
    info "No kit enabled for box ${BOLD}${box}${RESET}."
    return 0
  fi
  _box_kit_remove "$cname"
  if container_exists "$cname" && _container_has_kit_mounts "$cname"; then
    _generate_kit_overlay "$cname"
  fi
  # $cur comes from the hand-editable selection file: print it as data.
  printf '  %b✔ Kit %b%s%b disabled for box %b%s%b.%b\n' "$GREEN" "$BOLD" "$cur" "$RESET$GREEN" "$BOLD" "$box" "$RESET$GREEN" "$RESET"
  echo -e "    ${DIM}Back to your own config next session.${RESET}"
}

_kit_print_library() {
  local project base
  project="$(resolve_project)"
  base="$(container_name_for "$project" "main")"

  echo ""
  echo -e "  ${BOLD}Cleat Kits${RESET} ${DIM}(curated Claude pre-configurations, per box)${RESET}"
  echo ""
  local k
  for k in "${KNOWN_KITS[@]}"; do
    echo -e "  ${GREEN}${k}${RESET}"
    _kit_description "$k" | fold -s -w 62 | sed 's/^/    /'
  done

  # This project's current selections (any box).
  local _kf _bname _blabel _kname _shown=false
  if [[ -d "$CLEAT_KITS_DIR" ]]; then
    for _kf in "$CLEAT_KITS_DIR"/*; do
      [[ -f "$_kf" ]] || continue
      _bname="$(basename "$_kf")"
      case "$_bname" in
        "$base")   _blabel="main" ;;
        "$base"-*) _blabel="${_bname#${base}-}" ;;
        *) continue ;;
      esac
      _kname="$(cat "$_kf")"
      if ! $_shown; then
        echo ""
        echo -e "  ${DIM}This project:${RESET}"
        _shown=true
      fi
      # Selection files are hand-editable: print their content as data.
      printf '    %s: %b%s%b\n' "$_blabel" "$BLUE" "$_kname" "$RESET"
    done
  fi

  echo ""
  echo -e "  ${DIM}Enable:  ${BOLD}cleat kit <name> [box]${RESET}${DIM}    Disable: ${BOLD}cleat kit off [box]${RESET}"
  echo -e "  ${DIM}Inspect: ${BOLD}cleat kit show <name>${RESET}"
  echo -e "  ${DIM}Models:  set ${BOLD}worker_model${RESET}${DIM} / ${BOLD}scout_model${RESET}${DIM} under ${BOLD}[kits]${RESET}${DIM} in ~/.config/cleat/config${RESET}"
}

# Write the [kits] model overrides to a config file, preserving everything
# outside the [kits] section (same shape as _write_caps_to_file). Defaults are
# OMITTED so an untouched setup keeps a clean config: when both roles are the
# default alias, no [kits] section is written at all.
_write_kits_to_file() {
  local file="$1" worker="$2" scout="$3"
  mkdir -p "$(dirname "$file")"

  local preserved="" in_kits=false line _h
  if [[ -f "$file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      line="${line#$'\xef\xbb\xbf'}"   # UTF-8 BOM, same hygiene as the readers
      # Trimmed header match, same parity fix as _write_caps_to_file.
      _h="${line#"${line%%[![:space:]]*}"}"
      _h="${_h%"${_h##*[![:space:]]}"}"
      if [[ "$_h" == "[kits]" ]]; then
        in_kits=true
        continue
      fi
      if $in_kits; then
        if [[ "$_h" == "["*"]" ]]; then
          in_kits=false
          preserved+="$line"$'\n'
        fi
        continue
      fi
      preserved+="$line"$'\n'
    done < "$file"
  fi

  # Explicit ifs, never `[[ ]] && echo`: a false test as the block's last
  # list would make this function return 1 and kill the strict-mode caller
  # (found live: the text picker died silently on "done" with default models).
  {
    if [[ -n "$preserved" ]]; then
      printf '%s' "$preserved"
    fi
    if [[ "$worker" != "$_KIT_DEFAULT_MODEL" || "$scout" != "$_KIT_DEFAULT_MODEL" ]]; then
      echo "[kits]"
      if [[ "$worker" != "$_KIT_DEFAULT_MODEL" ]]; then
        echo "worker_model = $worker"
      fi
      if [[ "$scout" != "$_KIT_DEFAULT_MODEL" ]]; then
        echo "scout_model = $scout"
      fi
    fi
  } > "$file.cleat-tmp.$$" && mv -f "$file.cleat-tmp.$$" "$file" || {
    rm -f "$file.cleat-tmp.$$" 2>/dev/null || true
    error "Could not write ${file/#${HOME}/~}"
    return 1
  }
}

# Next model in the picker cycle for a role. The cycle is _KIT_MODEL_CHOICES;
# a custom value from a hand-edited config (a pinned ID like claude-sonnet-5)
# is kept reachable by cycling back to it after the last stock choice.
_kit_next_model() {
  local current="$1" custom="$2"
  local n=${#_KIT_MODEL_CHOICES[@]} i
  for ((i = 0; i < n; i++)); do
    if [[ "${_KIT_MODEL_CHOICES[$i]}" == "$current" ]]; then
      if [[ $((i + 1)) -lt $n ]]; then
        echo "${_KIT_MODEL_CHOICES[$((i + 1))]}"
      elif [[ -n "$custom" ]]; then
        echo "$custom"
      else
        echo "${_KIT_MODEL_CHOICES[0]}"
      fi
      return 0
    fi
  done
  # current IS the custom value (or unknown): wrap to the first stock choice.
  echo "${_KIT_MODEL_CHOICES[0]}"
}

# Previous model in the picker cycle: the exact reverse of _kit_next_model's
# ring (stock choices, then the custom pin if one exists).
_kit_prev_model() {
  local current="$1" custom="$2"
  local n=${#_KIT_MODEL_CHOICES[@]} i
  for ((i = 0; i < n; i++)); do
    if [[ "${_KIT_MODEL_CHOICES[$i]}" == "$current" ]]; then
      if [[ $i -gt 0 ]]; then
        echo "${_KIT_MODEL_CHOICES[$((i - 1))]}"
      elif [[ -n "$custom" ]]; then
        echo "$custom"
      else
        echo "${_KIT_MODEL_CHOICES[$((n - 1))]}"
      fi
      return 0
    fi
  done
  # current IS the custom value (or unknown): wrap to the last stock choice.
  echo "${_KIT_MODEL_CHOICES[$((n - 1))]}"
}

# ── Interactive kit picker (mirrors _config_picker_tui / _config_picker_text) ─

# Screen 1 rows: every known kit + "none". Radio marker on the current
# selection, cursor pointer like the caps picker.
_kit_picker_draw() {
  local cursor="$1" selected="$2"
  local rows=("${KNOWN_KITS[@]}" "none")
  local i=0 label marker
  while [[ $i -lt ${#rows[@]} ]]; do
    local row="${rows[$i]}"
    if [[ "$row" == "none" ]]; then
      label="none  ${DIM}(your own config, no kit)${RESET}"
      [[ -z "$selected" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
    else
      label="${BOLD}${row}${RESET}"
      [[ "$selected" == "$row" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
    fi
    printf '\033[2K'
    if [[ $i -eq $cursor ]]; then
      echo -e "  ${CYAN}▸${RESET} ${marker} ${label}"
    else
      echo -e "    ${marker} ${label}"
    fi
    i=$((i + 1))
  done
  # Detail pane: what the cursored kit actually is, so nobody has to enable
  # one to find out. Fixed height (_KIT_PANE_LINES) keeps the redraw math
  # constant; short content pads with cleared blanks.
  printf '\033[2K'
  echo ""
  local pane_text
  if [[ "${rows[$cursor]}" == "none" ]]; then
    pane_text="Your own Claude config, exactly as you set it up. Kits merge on top and never replace it; switch back here any time."
  else
    pane_text="$(_kit_description "${rows[$cursor]}")"
  fi
  local printed=0 line
  while IFS= read -r line; do
    [[ $printed -ge $_KIT_PANE_LINES ]] && break
    printf '\033[2K'
    echo -e "    ${DIM}${line}${RESET}"
    printed=$((printed + 1))
  done << PANE_EOF
$(echo "$pane_text" | fold -s -w 60)
PANE_EOF
  while [[ $printed -lt $_KIT_PANE_LINES ]]; do
    printf '\033[2K'
    echo ""
    printed=$((printed + 1))
  done
}

# Screen 2 rows: worker + scout with their effective models.
_kit_models_draw() {
  local cursor="$1" worker="$2" scout="$3"
  # Chevrons on the active row advertise that ←/→ cycles the model.
  printf '\033[2K'
  if [[ $cursor -eq 0 ]]; then
    echo -e "  ${CYAN}▸${RESET} worker  ${BOLD}‹ ${worker} ›${RESET}  ${DIM}(executes implementation chunks)${RESET}"
  else
    echo -e "    worker  ${worker}  ${DIM}(executes implementation chunks)${RESET}"
  fi
  printf '\033[2K'
  if [[ $cursor -eq 1 ]]; then
    echo -e "  ${CYAN}▸${RESET} scout   ${BOLD}‹ ${scout} ›${RESET}  ${DIM}(read-only exploration)${RESET}"
  else
    echo -e "    scout   ${scout}  ${DIM}(read-only exploration)${RESET}"
  fi
}

# Screen 2: pick the models, save on ⏎ (writes [kits] to the GLOBAL config,
# then applies the kit to the box). q/ESC cancels with nothing written.
_kit_models_tui() {
  local kit="$1" box="$2" cname="$3"
  local worker scout worker_custom="" scout_custom=""
  worker="$(_kit_agent_model worker "$_KIT_DEFAULT_MODEL")"
  scout="$(_kit_agent_model scout "$_KIT_DEFAULT_MODEL")"
  # A hand-pinned custom ID stays reachable in the cycle.
  case " ${_KIT_MODEL_CHOICES[*]} " in
    *" $worker "*) ;;
    *) worker_custom="$worker" ;;
  esac
  case " ${_KIT_MODEL_CHOICES[*]} " in
    *" $scout "*) ;;
    *) scout_custom="$scout" ;;
  esac

  echo ""
  echo -e "  ${BOLD}Kit ${kit}${RESET} ${DIM}· agent models (global, all kitted boxes)${RESET}"
  echo -e "  ${DIM}planner = your session's model, not changed by the kit${RESET}"
  echo ""

  local cursor=0
  _cursor_hide
  _kit_models_draw "$cursor" "$worker" "$scout"
  echo ""
  echo -e "  ${DIM}↑/↓ navigate  ←/→ change model  ⏎ enable kit  q cancel${RESET}"
  printf '\033[%dA' 4

  while true; do
    local key
    key="$(_read_keypress)"
    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=0 ;;
      DOWN) [[ $cursor -lt 1 ]] && cursor=1 ;;
      RIGHT|SPACE)
        if [[ $cursor -eq 0 ]]; then
          worker="$(_kit_next_model "$worker" "$worker_custom")"
        else
          scout="$(_kit_next_model "$scout" "$scout_custom")"
        fi
        ;;
      LEFT)
        if [[ $cursor -eq 0 ]]; then
          worker="$(_kit_prev_model "$worker" "$worker_custom")"
        else
          scout="$(_kit_prev_model "$scout" "$scout_custom")"
        fi
        ;;
      ENTER)
        _cursor_show
        printf '\033[%dB' 4
        printf '\033[2K'
        echo ""
        _write_kits_to_file "$CLEAT_GLOBAL_CONFIG" "$worker" "$scout"
        _kit_apply "$kit" "$box" "$cname"
        return 0
        ;;
      QUIT|ESC)
        _cursor_show
        printf '\033[%dB' 4
        printf '\033[2K'
        echo ""
        info "Cancelled."
        return 0
        ;;
    esac
    _kit_models_draw "$cursor" "$worker" "$scout"
    printf '\033[%dA' 2
  done
}

# Screen 1: pick a kit (or none) for the default box, then fall through to
# the models screen. ⏎ selects, q/ESC cancels.
_kit_picker_tui() {
  local box="main" project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"
  local selected
  selected="$(_box_kit_read "$cname")"

  echo ""
  echo -e "  ${BOLD}Cleat Kits${RESET} ${DIM}(curated Claude pre-configurations)${RESET}"
  echo -e "  ${DIM}Box: ${box} ${DIM}· other boxes: ${BOLD}cleat kit <name> <box>${RESET}"
  echo ""

  local rows=$(( ${#KNOWN_KITS[@]} + 1 ))
  # The redraw block is the rows plus the detail pane (and its separator).
  local block=$(( rows + 1 + _KIT_PANE_LINES ))
  local cursor=0
  _cursor_hide
  _kit_picker_draw "$cursor" "$selected"
  echo ""
  echo -e "  ${DIM}↑/↓ navigate  ⏎/→ select  q cancel${RESET}"
  printf '\033[%dA' "$((block + 2))"

  while true; do
    local key
    key="$(_read_keypress)"
    case "$key" in
      UP)   [[ $cursor -gt 0 ]] && cursor=$((cursor - 1)) ;;
      DOWN) [[ $cursor -lt $((rows - 1)) ]] && cursor=$((cursor + 1)) ;;
      ENTER|RIGHT)
        _cursor_show
        printf '\033[%dB' "$((block + 2))"
        printf '\033[2K'
        if [[ $cursor -eq $((rows - 1)) ]]; then
          echo ""
          _kit_disable "$box"
          return 0
        fi
        local kit="${KNOWN_KITS[$cursor]}"
        _kit_prekit_offer "$kit" "$box" "$cname" || return 0
        _kit_models_tui "$kit" "$box" "$cname"
        return 0
        ;;
      QUIT|ESC)
        _cursor_show
        printf '\033[%dB' "$((block + 2))"
        printf '\033[2K'
        echo ""
        info "Cancelled."
        return 0
        ;;
    esac
    _kit_picker_draw "$cursor" "$selected"
    printf '\033[%dA' "$block"
  done
}

# Text-mode fallback for non-TTY (mirrors _config_picker_text): type a kit
# name (or "none"), worker=<model> / scout=<model>, "done" to save + enable,
# "q" to cancel. EOF cancels.
_kit_picker_text() {
  local box="main" project cname
  project="$(resolve_project)"
  cname="$(container_name_for "$project" "$box")"
  local selected worker scout
  selected="$(_box_kit_read "$cname")"
  worker="$(_kit_agent_model worker "$_KIT_DEFAULT_MODEL")"
  scout="$(_kit_agent_model scout "$_KIT_DEFAULT_MODEL")"

  echo ""
  echo -e "  ${BOLD}Cleat Kits${RESET} ${DIM}(box: ${box})${RESET}"
  echo ""
  local k marker
  for k in "${KNOWN_KITS[@]}"; do
    [[ "$selected" == "$k" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
    echo -e "    ${marker} ${BOLD}${k}${RESET}"
    _kit_description "$k" | fold -s -w 60 | sed "s/^/      /" | while IFS= read -r _dl; do
      echo -e "${DIM}${_dl}${RESET}"
    done
  done
  [[ -z "$selected" ]] && marker="${GREEN}●${RESET}" || marker="${DIM}○${RESET}"
  echo -e "    ${marker} none ${DIM}(your own config, no kit)${RESET}"
  echo ""
  echo -e "  ${DIM}models: worker=${worker} scout=${scout} (global, all kitted boxes; planner = your session's model)${RESET}"
  echo ""
  echo -e "  ${DIM}Select: a kit name or \"none\"; worker=<model> / scout=<model>;${RESET}"
  echo -e "  ${DIM}\"done\" to save, \"q\" to cancel${RESET}"

  local choice="$selected"
  while true; do
    echo -n "  > "
    local input
    read -r input || { echo ""; info "Cancelled."; return 0; }
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"

    case "$input" in
      done)
        _write_kits_to_file "$CLEAT_GLOBAL_CONFIG" "$worker" "$scout"
        if [[ -z "$choice" ]]; then
          if [[ -n "$selected" ]]; then
            _kit_disable "$box"
          else
            info "No kit enabled. Models saved."
          fi
        else
          _kit_prekit_offer "$choice" "$box" "$cname" || return 0
          _kit_apply "$choice" "$box" "$cname"
        fi
        return 0
        ;;
      q|Q)
        info "Cancelled."
        return 0
        ;;
      none)
        choice=""
        echo -e "    ${DIM}selection: none${RESET}"
        ;;
      worker=*|scout=*)
        local _role="${input%%=*}" _val="${input#*=}"
        if [[ -n "$_val" && "$_val" =~ ^[A-Za-z0-9._-]+$ ]]; then
          [[ "$_role" == "worker" ]] && worker="$_val" || scout="$_val"
          echo -e "    ${DIM}${_role} model: ${_val}${RESET}"
        else
          warn "Not a model token (letters, digits, '.', '_', '-'): ${BOLD}${_val}${RESET}"
        fi
        ;;
      *)
        if _kit_known "$input"; then
          choice="$input"
          echo -e "    ${DIM}selection: ${input}${RESET}"
        else
          warn "Unknown kit: ${BOLD}${input}${RESET} ${DIM}(available: ${KNOWN_KITS[*]}, or \"none\")${RESET}"
        fi
        ;;
    esac
  done
}

_kit_show() {
  local kit="$1"
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/cleat-kit-show.XXXXXX")" || { error "Could not create a temp dir."; return 1; }
  _kit_emit "$kit" "$tmp"
  echo ""
  echo -e "  ${BOLD}Kit: ${kit}${RESET}"
  echo ""
  _kit_description "$kit" | fold -s -w 66 | sed 's/^/  /'
  echo ""
  echo -e "  ${DIM}── CLAUDE.md fragment (appended after your own content) ──${RESET}"
  sed 's/^/  /' "$tmp/CLAUDE.md"
  local f
  for f in "$tmp/agents"/*; do
    [[ -f "$f" ]] || continue
    echo ""
    echo -e "  ${DIM}── agents/$(basename "$f") ──${RESET}"
    sed 's/^/  /' "$f"
  done
  rm -rf "$tmp"
  if [[ "$kit" == "plan-big-execute-small" ]]; then
    echo ""
    echo -e "  ${DIM}Adapted from Anthropic's coordinator-pattern cookbook:${RESET}"
    echo "  https://github.com/anthropics/claude-cookbooks/blob/main/managed_agents/CMA_plan_big_execute_small.ipynb"
    echo ""
    echo -e "  ${DIM}Verify it is routing: after a heavy session, /usage should show the${RESET}"
    echo -e "  ${DIM}bulk of tokens on the worker model. Only your session model there${RESET}"
    echo -e "  ${DIM}means delegation is not happening.${RESET}"
  fi
}

# `cleat setup [box] [--show]`: run a project's [setup] provisioning outside
# the normal session-start flow (see _maybe_run_setup), or inspect it without
# running anything. Box is a bareword positional exactly like cmd_config's,
# parsed alongside --show so either can come first.
cmd_setup() {
  local box="" show=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --show) show=1; shift ;;
      --help|-h)
        echo "Usage: cleat setup [box]           Run this project's [setup] provisioning now"
        echo "       cleat setup [box] --show     Preview the payload, trust & marker state"
        return 0 ;;
      --*)
        error "Unknown setup option: $1"
        exit 1 ;;
      *)
        if [[ -n "$box" ]]; then
          error "Unexpected argument: ${BOLD}$1${RESET}"
          exit 1
        fi
        if ! _validate_box_name "$1"; then
          error "Invalid box name: ${BOLD}$1${RESET}"
          echo -e "    ${DIM}Box names: lowercase letters, digits, '-' or '_'; max 31 chars.${RESET}"
          exit 1
        fi
        box="$1"; shift
        ;;
    esac
  done
  _BOX="${box:-main}"
  box="$_BOX"

  local project cname caps_file
  project="$(resolve_project "")"
  cname="$(container_name_for "$project" "$box")"
  _RESOLVED_PROJECT="$project"
  caps_file="$(_project_caps_file "$project")"

  if [[ $show -eq 1 ]]; then
    # A pure inspection command: never prompts, never records trust.
    resolve_caps "$project" readonly
  else
    resolve_caps "$project"
  fi

  if [[ "${_SETUP_DECLARED:-0}" != "1" ]]; then
    # _SETUP_DECLARED stays 0 both when the section is absent and when a
    # `script` directive is invalid: tell those apart here so the explicit
    # verb doesn't claim "no section" over a broken one. --show resolves in
    # readonly mode, which silences the builder, so rebuild loudly here to
    # surface the specific directive error the user needs.
    if [[ -n "$(_read_setup_from_file "$caps_file" "$box")" ]]; then
      _build_setup_payload "$project" "$box" >/dev/null || true
      error "Project [setup] is invalid"
      exit 1
    fi
    info "No [setup] section in $(basename "$caps_file")"
    exit 0
  fi

  if [[ $show -eq 1 ]]; then
    # readonly resolve_caps leaves _SETUP_TRUSTED at 0 for unapproved
    # content, so trust state for display is derived directly from the
    # trust store, not the resolved-caps decision.
    local payload hash stored trust_state marker_state count
    payload="$(_build_setup_payload "$project" "$box")" || payload=""
    hash="$(_setup_payload_hash "$payload")"
    stored="$(_trust_lookup_setup "$project" "$box")"
    if [[ -n "$stored" && "$stored" == "$hash" ]]; then
      trust_state="approved"
    else
      trust_state="pending approval"
    fi
    if is_running "$cname"; then
      local marker
      marker="$(docker exec "$cname" cat /home/coder/.cleat-setup-applied 2>/dev/null || true)"
      if [[ "$marker" == "$hash" ]]; then
        marker_state="applied"
      else
        marker_state="not applied"
      fi
    else
      marker_state="unknown (box not running)"
    fi
    count="$(_read_setup_from_file "$caps_file" "$box" | wc -l | tr -d ' ')"

    echo ""
    echo -e "  ${BOLD}Source:${RESET}   ${caps_file}"
    echo -e "  ${BOLD}Commands:${RESET} ${count}"
    echo -e "  ${BOLD}Hash:${RESET}     ${hash}"
    echo -e "  ${BOLD}Trust:${RESET}    ${trust_state}"
    echo -e "  ${BOLD}Marker:${RESET}   ${marker_state}"
    echo ""
    if [[ -t 1 ]]; then
      local line
      while IFS= read -r line; do
        echo -e "  ${DIM}$(_sanitize_repo_str "$line")${RESET}"
      done <<< "$payload"
    else
      printf '%s\n' "$payload"
    fi
    exit 0
  fi

  # Run mode: the box must already be running (provisioning execs into it).
  require_running "$cname"

  if [[ "${_SETUP_TRUSTED:-0}" != "1" ]]; then
    error "Project [setup] is not approved"
    echo -e "    ${DIM}Re-run interactively to approve it, or set CLEAT_TRUST_SETUP=1 to approve non-interactively.${RESET}"
    exit 1
  fi

  _maybe_run_setup "$cname" "$project" "$box" 1
  exit "${_SETUP_LAST_RC:-0}"
}

# ── Version & Update ──────────────────────────────────────────────────────
cmd_version() {
  echo -e "  ${BOLD}cleat${RESET} ${DIM}v${VERSION}${RESET}"
}

cmd_update() {
  # A Homebrew keg has no .git, so without this the generic branch below would
  # tell a brew user to re-install with the curl script. That advice destroys
  # their install: install.sh clones to ~/.cleat and symlinks over
  # /usr/local/bin/cleat, which on an Intel Mac IS Homebrew's own bin, leaving
  # a forked copy and a stale, formula-orphaned keg. Refuse instead, and hand
  # the update back to brew. The image side needs nothing here: the next
  # session start re-checks it against the new version.
  if _is_brew_managed "${BASH_SOURCE[0]}"; then
    # Run the upgrade rather than describe it: `cleat update` on a git install
    # updates without asking, so a keg gets the same treatment through brew.
    # The image side still needs nothing here.
    if ! _brew_delegate upgrade cleatdev/tap/cleat; then
      error "Installed via Homebrew: cleat update does not manage this install."
      echo -e "    ${DIM}Update with: brew upgrade cleatdev/tap/cleat${RESET}"
    fi
    # Terminal either way. A successful delegation never reaches this (exec
    # replaced the process), so the exit exists to make the branch incapable of
    # falling through into the git updater below, which inside a keg would
    # fetch and check out tags in whatever repository REPO_DIR resolved to.
    exit 1
  fi

  info "Checking for updates..."

  if [[ ! -d "$REPO_DIR/.git" ]]; then
    error "Cannot auto-update: not a git installation."
    echo -e "    ${DIM}Re-install with: curl -fsSL https://raw.githubusercontent.com/cleatdev/cleat/main/install.sh | bash${RESET}"
    exit 1
  fi

  git -C "$REPO_DIR" fetch --tags --force --quiet 2>/dev/null || {
    error "Failed to fetch updates. Check your internet connection."
    exit 1
  }

  local remote_version
  remote_version=$(latest_remote_tag)

  if [[ -z "$remote_version" ]]; then
    error "Could not determine remote version. No tags found."
    exit 1
  fi

  if [[ "$VERSION" == "$remote_version" ]]; then
    success "Already on the latest version (v${VERSION})."
    return
  fi

  info "Updating v${VERSION} -> v${remote_version}..."
  git -C "$REPO_DIR" checkout "v${remote_version}" --quiet 2>/dev/null || {
    error "Failed to checkout v${remote_version}."
    exit 1
  }
  success "Updated to v${remote_version}."

  rm -f "$UPDATE_CHECK_FILE" 2>/dev/null || true
  # The new release image bundles its own Claude Code, so invalidate the
  # Claude update-check cache to re-check against the fresh image next start.
  rm -f "$CLAUDE_CHECK_FILE" 2>/dev/null || true

  # Pull the prebuilt image matching the new version. _do_pull prints its own
  # progress/result; on failure the user can rebuild locally.
  if ! _do_pull "$remote_version"; then
    echo ""
    echo -e "  ${DIM}To update the container image locally:${RESET}"
    echo -e "    ${BOLD}cleat rebuild${RESET}"
  fi
  echo ""
}

# ── Help ────────────────────────────────────────────────────────────────────
cmd_help() {
  header
  echo -e "  ${BOLD}USAGE${RESET}"
  echo -e "    cleat ${DIM}<command> [box] [options]${RESET}"
  echo -e "    ${DIM}Always operates on the current directory. [box] is a named sandbox${RESET}"
