#!/usr/bin/env bash
# The egress relay inside a caged box (EGRESS-SPEC.md 8.6, concept/46).
#
# A caged box has no network. Its tools reach the outside through
# http://127.0.0.1:3128, and this relay carries each connection to the gateway's
# unix socket on the read-only volume at /run/cleat-egress. The relay decides
# nothing: the gateway enforces the policy, and a box that kills this relay has
# only cut itself off.
#
# No argument: the supervisor. The entrypoint starts it as coder in a caged box
# only. It keeps socat listening, starts it again about a second after it
# dies, and sends heartbeats so the host can tell the relay is alive (a health
# signal with no security weight). One supervisor per box, by a lock.
#
# --beat: one heartbeat, no lock. cleat egress restart uses it so the gateway's
# last_shim_seen is fresh at once.
#
# --again and --beats are the supervisor's own. --again is the supervisor
# started again in place. --beats is the heartbeat loop of one relay, from its
# start: the supervisor starts every loop as "--beats <relay> 0".
#
# It never writes under /run/cleat-egress, and it never runs as root.

LOG=/tmp/cleat-egress-shim.log
LOCK=/tmp/cleat-egress-shim.lock
SOCK=/run/cleat-egress/proxy.sock

# A CONNECT for the gateway's reserved target, which answers without dialling.
# Never with the Cleat-Selftest header: the gateway counts a heartbeat only
# without it, so a host-side selftest can never make a dead relay look alive.
_shim_heartbeat() {
  printf 'CONNECT cleat-gateway.invalid:443 HTTP/1.1\r\nHost: cleat-gateway.invalid:443\r\n\r\n' \
    | timeout 3 socat - TCP:127.0.0.1:3128 >/dev/null 2>&1 || return 0
  return 0
}

_shim_stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# bash ends a script once a fork has failed for about fifteen seconds (a box
# out of pids). Nothing would start it again. The heartbeat loop would end
# while its relay is up. The supervisor would end with no relay at all. So each
# shell here starts itself again in place from its EXIT trap. exec needs no new
# process and keeps fd 9, the lock. -a keeps argv[0] as plain bash, so the
# command line still starts "bash /usr/local/bin/cleat-egress-shim" and a
# person looking for the relay still finds it. A stop signal still ends it.
#
# An end can also come within seconds. bash never retries a fork that fails
# for want of memory. A child that exits while bash waits to retry a fork also
# cuts the retry short. So the fourth quick end in a row is the last one
# rather than a spin. Each shell counts its own ends, on a clock of its own.
# A supervisor that stays down fails every request until restart --shim. A
# heartbeat loop that stays down leaves requests working but status stale
# until its relay or the box restarts: its supervisor is alive and keeps the
# lock, so restart --shim only sends one heartbeat.
#
# Each trap starts with a no-op: after a fork gives up, bash 5.2 reads the
# first command a trap runs as status 127.
_shim_quick=0
_shim_again() {                          # <mode> [relay]
  if [ "$SECONDS" -lt 5 ]; then _shim_quick=$((_shim_quick + 1)); else _shim_quick=0; fi
  [ "$_shim_quick" -le 3 ] || return 0
  exec -a bash "$BASH" "$0" "$@" "$_shim_quick"
}

# Beats every second for the first ten after a (re)start, so a gate waiting for
# the first one is not kept waiting, then every thirty. Stops with its relay.
# It runs in a shell of its own (--beats), so it sets that shell's traps.
_shim_beats() {
  relay="$1"
  local n=0
  trap ': ; kill -0 "$relay" 2>/dev/null && _shim_again --beats "$relay"' EXIT
  trap 'trap - EXIT; exit 0' TERM HUP INT
  while kill -0 "$relay" 2>/dev/null; do
    _shim_heartbeat
    if [ "$n" -lt 10 ]; then
      n=$((n + 1))
      sleep 1 & wait $!
    else
      sleep 30 & wait $!
    fi
  done
}

if [ "${1:-}" = --beat ]; then
  _shim_heartbeat
  exit 0
fi

if [ "${1:-}" = --beats ]; then
  case "${2:-}" in ''|*[!0-9]*) exit 1 ;; esac
  case "${3:-}" in [0-9]) _shim_quick="$3" ;; esac
  _shim_beats "$2"
  exit 0
fi

if [ "${1:-}" = --again ]; then
  # Started again in place: fd 9 still holds the lock. Taking it again would
  # need a fork.
  { : >&9; } 2>/dev/null || exit 1
  case "${2:-}" in [0-9]) _shim_quick="$2" ;; esac
  echo "supervisor started again in place"
else
  exec 9>>"$LOCK" || exit 1
  flock -n 9 || exit 0
  exec </dev/null >>"$LOG" 2>&1
fi

# The relay is stopped and reaped before the loop, so the next supervisor can
# bind the port and the loop never beats for a relay that is gone.
relay=""
beats=""
_shim_down() {
  if [ -n "$relay" ]; then kill "$relay" 2>/dev/null; wait "$relay" 2>/dev/null; fi
  if [ -n "$beats" ]; then kill "$beats" 2>/dev/null; wait "$beats" 2>/dev/null; fi
  _shim_again --again
}
trap ': ; _shim_down' EXIT
trap 'trap - EXIT; exit 0' TERM HUP INT

while :; do
  # socat logs one line per failed connection while the gateway is down, so
  # the log is capped rather than left to grow for the life of the box.
  if [ "$(wc -c < "$LOG" 2>/dev/null | tr -d ' ')" -gt 1048576 ] 2>/dev/null; then
    : > "$LOG"
  fi
  # Both children close fd 9. A relay that kept the lock would outlive a dead
  # supervisor and make every later start exit as already running, with
  # nothing supervising.
  socat -T 900 "TCP-LISTEN:3128,fork,max-children=128,backlog=256,reuseaddr,bind=127.0.0.1" \
    "UNIX-CONNECT:$SOCK" 9>&- &
  relay=$!
  echo "$(_shim_stamp) relay started pid=$relay"
  # The heartbeat loop is a shell started afresh, never a bare fork of this
  # one. A fork would carry this shell's quick ends and clock, so after quick
  # restarts here its own first end would be its last. It would also read
  # --again, like this shell, until it restarted itself.
  exec -a bash "$BASH" "$0" --beats "$relay" 0 9>&- &
  beats=$!
  rc=0
  wait "$relay" || rc=$?
  relay=""
  echo "$(_shim_stamp) relay exited rc=$rc"
  kill "$beats" 2>/dev/null || true
  wait "$beats" 2>/dev/null || true
  beats=""
  sleep 1
done
